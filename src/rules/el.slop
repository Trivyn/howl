;; ============================================================
;; v0 completion rules  —  SPEC.md §6.4  (CR1–CR7)
;;
;; Each rule is a pure function from (context, incoming Derived, axiom)
;; to a list of outgoing Addressed messages. A rule reads only the
;; context it is given and EMITS rather than mutates — that is the
;; ownership invariant (§6.6) which makes context parallelism safe and
;; the per-rule faithfulness contracts statable.
;;
;;   CR1  B ∈ S(X), B ⊑ A                     ⟹ A ∈ S(X)
;;   CR2  B₁,B₂ ∈ S(X), B₁ ⊓ B₂ ⊑ A           ⟹ A ∈ S(X)
;;   CR3  B ∈ S(X), B ⊑ ∃r.A                  ⟹ (X,A) ∈ R(r)
;;   CR4  (X,Y) ∈ R(r), B ∈ S(Y), ∃r.B ⊑ A    ⟹ A ∈ S(X)
;;   CR5  (X,Y) ∈ R(r), ⊥ ∈ S(Y)              ⟹ ⊥ ∈ S(X)
;;   CR6  (X,Y) ∈ R(r), r ⊑ s                 ⟹ (X,Y) ∈ R(s)
;;   CR7  (X,Y) ∈ R(r), (Y,Z) ∈ R(s), r∘s ⊑ t ⟹ (X,Z) ∈ R(t)
;;
;; THESE LOCAL NUMBERS ARE HOWL'S, NOT THE PAPER'S. In the cited 2005
;; calculus, role hierarchy and role composition are CR10 and CR11;
;; its CR6 is nominal propagation and CR7–CR9 are concrete domains,
;; none of which v0 has. Cross-referencing "CR6" against the proof
;; sends you to the wrong rule.
;;
;;   HOWL CR1–CR5  =  published CR1–CR5
;;   HOWL CR6      =  published CR10   (role hierarchy)
;;   HOWL CR7      =  published CR11   (role composition)
;;
;; RANGES ADD NO RULE. They are eliminated during normalization by the
;; published construction (§5.2), so the rule set is exactly the cited
;; CEL formulation. Domain adds none either: domain(r) ⊑ A desugars to
;; ∃r.⊤ ⊑ A and is handled by CR4. The range/composition admissibility
;; condition is a PRECONDITION of that elimination, which is why it
;; lives in the gate rather than here.
;;
;; DELTA TRIGGERS: EVERY RULE FIRES ON EVERY PREMISE (§6.4). Semi-naive
;; evaluation is complete only if a multi-premise rule is re-triggered
;; by EACH premise independently. CR4 joins (X,Y) ∈ R(r) with B ∈ S(Y);
;; a handler that fires only on new subsumers never revisits the pair
;; when the edge arrives second, and WHICH order occurs is a scheduling
;; artifact — so a missing handler is an incompleteness bug and a
;; determinism bug at once. The trigger table is therefore part of the
;; calculus, not an implementation detail:
;;
;;   Rule | on derived-sub b        | on derived-pred (r,x)   | on derived-succ (r,y)
;;   -----|-------------------------|-------------------------|----------------------
;;   CR1  | scan axioms B ⊑ A       | —                       | —
;;   CR2  | scan S(X) for the OTHER | —                       | —
;;        |   conjunct of B₁⊓B₂ ⊑ A |                         |
;;   CR3  | scan axioms B ⊑ ∃r.A    | —                       | —
;;   CR4  | scan stored preds(r)    | scan stored S(Y)        | —
;;   CR5  | if b = ⊥, scan preds    | if ⊥ ∈ S(Y), emit to x  | —
;;   CR6  | —                       | scan axioms r ⊑ s       | scan axioms r ⊑ s
;;   CR7  | —                       | scan succs (second leg) | scan preds (first leg)
;;
;; CR2 and CR7 are SELF-JOINS, so same-round co-arrival is their main
;; path rather than a corner case — which is exactly why the driver's
;; round snapshot must be Sₙ = Sₙ₋₁ ∪ Δₙ and not Sₙ₋₁ (§6.4).
;;
;; ============================================================
;; TWO IMPLEMENTATION FACTS THAT SHAPE EVERY RULE BODY BELOW.
;;
;; 1. EACH RULE OWNS ITS RESULT LIST. A `(List T)` is a VALUE STRUCT
;;    {len, cap, data}, so pushing into a list received as a parameter
;;    writes through the shared `data` buffer while leaving the
;;    caller's `len` untouched — the element is written and invisible.
;;    So no rule takes an accumulator; each builds a local `mut result`
;;    and returns it, and the dispatcher copies elements across.
;;
;; 2. EDGES ARE EMITTED VIA `emit-edge`, EXPANDED INLINE. The helper
;;    returns an `EdgePair` — a record, so "both halves exist" is a type
;;    guarantee and each half's destination is a proven postcondition —
;;    and the rule pushes both halves onto its own list. Emitting only
;;    the successor is the tempting version of this bug precisely
;;    because it looks complete from the deriving context and fails only
;;    in the CONSUMING rules (CR4/CR5 read `preds`, CR7 reads both
;;    sides), so the symptom is under-derivation with no error.
;;
;; ============================================================
;; OWED — THE TWO FAITHFULNESS DIRECTIONS, PER RULE (§7).
;;
;; Each rule below carries STRUCTURAL contracts: how many messages it
;; may emit, where they are addressed, and which `Derived` shape they
;; carry. Those are real constraints — they fail if a rule emits to the
;; wrong context, emits an edge half without its partner, or emits a
;; subsumer where an edge belongs.
;;
;; What is NOT yet stated is the full pair §7 requires:
;;
;;   (a) nothing unlicensed is emitted
;;   (b) nothing licensed is omitted
;;
;; and (b) is the one that matters most, because SOUNDNESS ALONE IS
;; SATISFIED BY EMITTING NOTHING — a disabled engine passes it while
;; deriving nothing at all. Both are transcription rather than design:
;; CR1–CR7 are fully specified in the published CEL formulation, so
;; every premise and conclusion is given. The blocker is expressibility,
;; and it is concrete: stating them needs (i) per-variant ACCESSORS on
;; `NormAxiom` usable inside a contract, since a contract cannot
;; `match`, and (ii) a `preds-of`-style function returning a Set for the
;; premise `(X,Y) ∈ R(r)`, where `map-get` returns an `Option` that a
;; contract equally cannot destructure. GROWL states its equivalents
;; only because RDF gives it total accessors — `triple-subject` is
;; defined for every triple, whereas `sub-some-lhs-role` is not defined
;; for a `role-chain`.
;;
;; Their shape, taking CR4 as the worked example, follows GROWL's
;; VERIFIED idiom (`rules/eq.slop:280-293`) rather than SPEC §6.4's
;; sketch — the sketch uses `list-has`, which is not a contract builtin,
;; and `implies`, which does not translate inside `@property`. The
;; working forms are `list-contains` and a negated-premise disjunction:
;;
;;   (@property soundness
;;     (forall (m $result)
;;       (exists (x (preds-of ctx r))
;;         (and (= ax (sub-some-lhs r b a))
;;              (= m (addressed x (derived-sub a)))))))
;;
;;   (@property completeness
;;     (forall (x (preds-of ctx r))
;;       (or (not (= ax (sub-some-lhs r b a)))
;;           (list-contains $result (addressed x (derived-sub a))))))
;;
;; Until the accessors exist, direction (b) is discharged EMPIRICALLY by
;; the fixtures in test.slop — the §3.1 litmus for CR1–CR4, the polarity
;; guard, the same-round co-arrival case for CR4's two-sided trigger,
;; and the ⊥-propagation case for CR5. No vacuous `@post` stands in
;; meanwhile: `(list-len $result) >= 0` is true of every possible
;; implementation and would only make the verification summary look
;; fuller than it is.
;; ============================================================

(module el
  (@doc "v0 EL completion rules CR1-CR7 (M1)")

  (import rdf (IRI))
  (import types (Node RoleId NormAxiom Derived Addressed LogicalEdge EdgePair Context
                 node-bottom node-eq role-eq emit-edge make-context addressed-eq))

  (export
    apply-el-rules
    cr-sub-name-on-sub
    cr-and-on-sub
    cr-some-rhs-on-sub
    cr-exists-lhs-on-sub
    cr-exists-lhs-on-pred
    cr-bottom-on-sub
    cr-bottom-on-pred
    cr-role-incl-on-pred
    cr-role-incl-on-succ
    cr-chain-on-pred
    cr-chain-on-succ)

  ;; ============================================================
  ;; Fixtures for the @example blocks below
  ;;
  ;; §7 wants a faithfulness contract PAIR on every rule, and the `@property`
  ;; form those need is currently unusable: quantified over a push-built
  ;; `$result` it fails outright AND makes any sibling `@post` fail
  ;; (slop-lang/slop#69). `@example` is the obvious substitute.
  ;;
  ;; These EXECUTE as of slop 0.2.1 (`make example`). Under 0.1.2 they did not:
  ;; an example was run only when every argument was a scalar literal, so any
  ;; fixture call was reported `SKIP (wildcard args)` and then COUNTED AS A
  ;; PASS — a green line over zero assertions (slop-lang/slop#71, fixed; skips
  ;; are now reported as `unrunnable` and excluded from the pass count).
  ;;
  ;; One syntax trap worth knowing, because it fails confusingly. The expected
  ;; value of a list-returning example is SPLAT as literal elements, so it is
  ;; `(list <elem> …)` with NO type argument, and `(list)` for empty. Writing
  ;; `(list Addressed)` — which in ordinary code is the valid empty-list-of-
  ;; Addressed literal — makes the harness treat the TYPE NAME as an element
  ;; and emit `{types_Addressed}`, failing to compile. Likewise an expected
  ;; value built by a call is splat into its own arguments.
  ;; ============================================================

  (fn ex-x () (@intent "The context root used by the examples")
    (@spec (() -> Node)) (@pure)
    (union-new Node class-node (record-new IRI (value "http://example.org/X"))))

  (fn ex-a () (@intent "A conclusion node") (@spec (() -> Node)) (@pure)
    (union-new Node class-node (record-new IRI (value "http://example.org/A"))))

  (fn ex-b () (@intent "An incoming subsumer") (@spec (() -> Node)) (@pure)
    (union-new Node class-node (record-new IRI (value "http://example.org/B"))))

  (fn ex-c () (@intent "A second conjunct") (@spec (() -> Node)) (@pure)
    (union-new Node class-node (record-new IRI (value "http://example.org/C"))))

  (fn ex-r () (@intent "The role used by the examples") (@spec (() -> RoleId)) (@pure)
    (union-new RoleId named-role (record-new IRI (value "http://example.org/r"))))

  (fn ex-ctx ((arena Arena))
    (@intent "Context X with S(X) = {B, C} and no edges")
    (@spec ((Arena) -> Context))
    (@alloc arena)
    (let ((ctx (make-context arena (ex-x)))
          (b (ex-b)) (c (ex-c)))
      (do (set-put (. ctx subsumers) b)
          (set-put (. ctx subsumers) c)
          ctx)))

  (fn ex-ctx-bottom ((arena Arena))
    (@intent "Context X whose S(X) contains ⊥ — an unsatisfiable context")
    (@spec ((Arena) -> Context))
    (@alloc arena)
    (let ((ctx (make-context arena (ex-x)))
          (bot (node-bottom)))
      (do (set-put (. ctx subsumers) bot) ctx)))

  ;; ============================================================
  ;; CR1 — B ∈ S(X), B ⊑ A ⟹ A ∈ S(X)
  ;; ============================================================

  (fn cr-sub-name-on-sub ((arena Arena) (ctx Context) (b Node) (ax NormAxiom))
    (@intent "EL completion CR1: told subsumption closes S(X) upward")
    (@spec ((Arena Context Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    ;; CR1's premise (B ∈ S(X)) is the DRIVER's obligation, not this
    ;; function's: the rule fires because `b` was delivered to this
    ;; context this round. Stating it as a @post would assert something
    ;; the body never establishes — the unprovable-claim error §7 warns
    ;; about. It is not stated as a @pre either, because `set-has` on the
    ;; snapshot is exactly the fact the driver guarantees by delivery.
    ;;
    ;; At most one conclusion: one axiom in, one subsumer out.
    (@post {(list-len $result) <= 1})
    (@example
      ;; B ∈ S(X) and the axiom B ⊑ A, so A joins S(X).
      :eq addressed-eq
      (arena (ex-ctx arena) (ex-b) (union-new NormAxiom sub-name (ex-b) (ex-a)))
      -> (list (record-new Addressed (to (ex-x))
                 (what (union-new Derived derived-sub (ex-a))))))
    (@example
      ;; The axiom is about a DIFFERENT subsumer, so CR1 does not fire.
      :eq addressed-eq
      (arena (ex-ctx arena) (ex-b) (union-new NormAxiom sub-name (ex-c) (ex-a)))
      -> (list))
    ;; CR1 concludes only about its OWN context. A message addressed
    ;; anywhere else would be a rule reaching outside the context it was
    ;; given, breaking the §6.6 ownership invariant.
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((sub-name b2 a)
            (when (node-eq b b2)
              (list-push result
                (record-new Addressed
                  (to   (. ctx root))
                  (what (union-new Derived derived-sub a))))))
          ((sub-and _ _ _)      (do))
          ((sub-some-rhs _ _ _) (do))
          ((sub-some-lhs _ _ _) (do))
          ((sub-role _ _)       (do))
          ((role-chain _ _ _)   (do)))
        result)))

  ;; ============================================================
  ;; CR2 — B₁,B₂ ∈ S(X), B₁ ⊓ B₂ ⊑ A ⟹ A ∈ S(X)
  ;;
  ;; A SELF-JOIN, so it must fire from EITHER conjunct: the incoming `b`
  ;; may be B₁ with B₂ already stored, or B₂ with B₁ already stored.
  ;; Testing only one side loses every conclusion whose conjuncts happen
  ;; to arrive in the other order — and which order occurs is a
  ;; scheduling artifact, so the bug is nondeterministic as well as
  ;; incomplete. `(. ctx subsumers)` is Sₙ = Sₙ₋₁ ∪ Δₙ, which is what
  ;; makes the same-round Δₙ × Δₙ case reachable at all (§6.4).
  ;; ============================================================

  (fn cr-and-on-sub ((arena Arena) (ctx Context) (b Node) (ax NormAxiom))
    (@intent "EL completion CR2: conjunction, fired from either conjunct")
    (@spec ((Arena Context Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    (@post {(list-len $result) <= 1})
    (@example
      ;; B arrives; C is ALREADY stored; the axiom is B ⊓ C ⊑ A. Fires.
      :eq addressed-eq
      (arena (ex-ctx arena) (ex-b) (union-new NormAxiom sub-and (ex-b) (ex-c) (ex-a)))
      -> (list (record-new Addressed (to (ex-x))
                 (what (union-new Derived derived-sub (ex-a))))))
    (@example
      ;; THE SELF-JOIN'S OTHER SIDE. Same axiom, but C is the arriving conjunct
      ;; and B is the stored one. A rule that only tested the first conjunct
      ;; would return empty here and lose every conclusion whose conjuncts
      ;; happen to arrive in the other order — a bug that is also nondeterministic,
      ;; since which order occurs is a scheduling artifact.
      :eq addressed-eq
      (arena (ex-ctx arena) (ex-c) (union-new NormAxiom sub-and (ex-b) (ex-c) (ex-a)))
      -> (list (record-new Addressed (to (ex-x))
                 (what (union-new Derived derived-sub (ex-a))))))
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((sub-and a1 a2 a)
            ;; Nested `if` rather than a flat `(or (and ...) (and ...))`
            ;; condition: `or`/`and` make the enclosing value opaque to
            ;; the WP checker, and the two arms must not both fire when
            ;; a1 = a2 = b (harmless in a set-valued delta, but it would
            ;; break the length bound above).
            (let ((mut fire false))
              (do
                (if (node-eq b a1)
                  (when (set-has (. ctx subsumers) a2) (set! fire true))
                  (when (node-eq b a2)
                    (when (set-has (. ctx subsumers) a1) (set! fire true))))
                ;; ONE push site, reached through a flag rather than two
                ;; exclusive branches that each push. Semantically
                ;; identical; the difference is that the checker can then
                ;; discharge `<= 1`, whereas with two syntactic pushes it
                ;; must assume both could fire and returns a 2-element
                ;; counterexample.
                (when fire
                  (list-push result
                    (record-new Addressed
                      (to (. ctx root)) (what (union-new Derived derived-sub a))))))))
          ((sub-name _ _)       (do))
          ((sub-some-rhs _ _ _) (do))
          ((sub-some-lhs _ _ _) (do))
          ((sub-role _ _)       (do))
          ((role-chain _ _ _)   (do)))
        result)))

  ;; ============================================================
  ;; CR3 — B ∈ S(X), B ⊑ ∃r.A ⟹ (X,A) ∈ R(r)
  ;; ============================================================

  (fn cr-some-rhs-on-sub ((arena Arena) (ctx Context) (b Node) (ax NormAxiom))
    (@intent "EL completion CR3: existential in superclass position derives an edge")
    (@spec ((Arena Context Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    ;; TWO messages, never one: an edge is one logical fact stored as a
    ;; successor at X and a predecessor at A. The bound is `<= 2` and
    ;; the both-halves guarantee comes from `emit-edge`'s EdgePair.
    (@post {(list-len $result) <= 2})
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((sub-some-rhs b2 r a)
            (when (node-eq b b2)
              (let ((pair (emit-edge arena
                            (record-new LogicalEdge
                              (from (. ctx root)) (role r) (to a)))))
                (do
                  (list-push result (. pair succ-half))
                  (list-push result (. pair pred-half))))))
          ((sub-name _ _)       (do))
          ((sub-and _ _ _)      (do))
          ((sub-some-lhs _ _ _) (do))
          ((sub-role _ _)       (do))
          ((role-chain _ _ _)   (do)))
        result)))

  ;; ============================================================
  ;; CR4 — (X,Y) ∈ R(r), B ∈ S(Y), ∃r.B ⊑ A ⟹ A ∈ S(X)
  ;;
  ;; TWO HANDLERS, and both are mandatory. The rule runs in context Y —
  ;; the context owning the premise B ∈ S(Y) — and emits to each
  ;; PREDECESSOR X, which is why `preds` is stored at all.
  ;; ============================================================

  (fn cr-exists-lhs-on-sub ((arena Arena) (ctx Context) (b Node) (ax NormAxiom))
    (@intent "EL completion CR4, new-subsumer direction: scan the stored predecessors")
    (@spec ((Arena Context Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    ;; Unlike CR1–CR3 this rule emits OUTWARD, to every predecessor, so
    ;; there is no own-context property to state. What is structurally
    ;; true is that every conclusion is a subsumer assertion — CR4 never
    ;; concludes an edge.
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((sub-some-lhs r b2 a)
            (when (node-eq b b2)
              (match (map-get (. ctx preds) r)
                ((some xs)
                  (for-each (x xs)
                    (list-push result
                      (record-new Addressed
                        (to x) (what (union-new Derived derived-sub a))))))
                ((none) (do)))))
          ((sub-name _ _)       (do))
          ((sub-and _ _ _)      (do))
          ((sub-some-rhs _ _ _) (do))
          ((sub-role _ _)       (do))
          ((role-chain _ _ _)   (do)))
        result)))

  (fn cr-exists-lhs-on-pred ((arena Arena) (ctx Context) (r RoleId) (x Node) (ax NormAxiom))
    (@intent "EL completion CR4, new-edge direction: scan the stored subsumers")
    (@spec ((Arena Context RoleId Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    ;; THE COMPANION HANDLER. Omitting it loses every conclusion whose
    ;; edge happens to arrive AFTER its subsumer — silently, and
    ;; permanently, since in the next round neither premise is in the
    ;; delta any more. This is the case `test-same-round-co-arrival`
    ;; exists to pin.
    (@post {(list-len $result) <= 1})
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((sub-some-lhs r2 b a)
            (when (role-eq r r2)
              (when (set-has (. ctx subsumers) b)
                (list-push result
                  (record-new Addressed
                    (to x) (what (union-new Derived derived-sub a)))))))
          ((sub-name _ _)       (do))
          ((sub-and _ _ _)      (do))
          ((sub-some-rhs _ _ _) (do))
          ((sub-role _ _)       (do))
          ((role-chain _ _ _)   (do)))
        result)))

  ;; ============================================================
  ;; CR5 — (X,Y) ∈ R(r), ⊥ ∈ S(Y) ⟹ ⊥ ∈ S(X)
  ;;
  ;; AXIOM-INDEPENDENT: unsatisfiability propagates backwards along any
  ;; edge, with no axiom premise. Both handlers are therefore invoked
  ;; ONCE per incoming message by the dispatcher, outside its axiom
  ;; loop — firing them per axiom would emit |axioms| copies of every
  ;; conclusion. Harmless in a set-valued delta, but pure waste.
  ;; ============================================================

  (fn cr-bottom-on-sub ((arena Arena) (ctx Context) (b Node))
    (@intent "EL completion CR5, new-⊥ direction: tell every predecessor")
    (@spec ((Arena Context Node) -> (List Addressed)))
    (@alloc arena)
    (let ((mut result (list-new arena Addressed))
          (bottom (node-bottom)))
      (do
        (when (node-eq b bottom)
          ;; Every role, not just one: a context is unsatisfiable
          ;; regardless of WHICH role reaches it.
          (for-each ((r xs) (. ctx preds))
            (for-each (x xs)
              (list-push result
                (record-new Addressed
                  (to x) (what (union-new Derived derived-sub bottom)))))))
        result)))

  (fn cr-bottom-on-pred ((arena Arena) (ctx Context) (x Node))
    (@intent "EL completion CR5, new-edge direction: tell the arriving predecessor")
    (@spec ((Arena Context Node) -> (List Addressed)))
    (@alloc arena)
    (@post {(list-len $result) <= 1})
    (@example
      ;; ⊥ ∈ S(X) and a new predecessor B arrives, so B is unsatisfiable too.
      :eq addressed-eq
      (arena (ex-ctx-bottom arena) (ex-b))
      -> (list (record-new Addressed (to (ex-b))
                 (what (union-new Derived derived-sub (node-bottom))))))
    (@example
      ;; S(X) has no ⊥, so nothing propagates backwards.
      :eq addressed-eq
      (arena (ex-ctx arena) (ex-b))
      -> (list))
    (let ((mut result (list-new arena Addressed))
          (bottom (node-bottom)))
      (do
        (when (set-has (. ctx subsumers) bottom)
          (list-push result
            (record-new Addressed
              (to x) (what (union-new Derived derived-sub bottom)))))
        result)))

  ;; ============================================================
  ;; CR6 — (X,Y) ∈ R(r), r ⊑ s ⟹ (X,Y) ∈ R(s)
  ;;
  ;; Fires from BOTH stored halves, because either half may be the one
  ;; that just arrived. Each handler reconstructs the same logical edge
  ;; from its own vantage point and re-emits it under the super-role.
  ;; ============================================================

  (fn cr-role-incl-on-pred ((arena Arena) (ctx Context) (r RoleId) (x Node) (ax NormAxiom))
    (@intent "EL completion CR6, predecessor-half direction: role inclusion")
    (@spec ((Arena Context RoleId Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    (@post {(list-len $result) <= 2})
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((sub-role r2 s)
            (when (role-eq r r2)
              ;; Incoming (derived-pred r x) at context Y IS the edge
              ;; (x, r, Y) — so the super-role edge is (x, s, Y).
              (let ((pair (emit-edge arena
                            (record-new LogicalEdge
                              (from x) (role s) (to (. ctx root))))))
                (do
                  (list-push result (. pair succ-half))
                  (list-push result (. pair pred-half))))))
          ((sub-name _ _)       (do))
          ((sub-and _ _ _)      (do))
          ((sub-some-rhs _ _ _) (do))
          ((sub-some-lhs _ _ _) (do))
          ((role-chain _ _ _)   (do)))
        result)))

  (fn cr-role-incl-on-succ ((arena Arena) (ctx Context) (r RoleId) (y Node) (ax NormAxiom))
    (@intent "EL completion CR6, successor-half direction: role inclusion")
    (@spec ((Arena Context RoleId Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    (@post {(list-len $result) <= 2})
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((sub-role r2 s)
            (when (role-eq r r2)
              ;; Incoming (derived-succ r y) at context X IS the edge
              ;; (X, r, y) — so the super-role edge is (X, s, y).
              (let ((pair (emit-edge arena
                            (record-new LogicalEdge
                              (from (. ctx root)) (role s) (to y)))))
                (do
                  (list-push result (. pair succ-half))
                  (list-push result (. pair pred-half))))))
          ((sub-name _ _)       (do))
          ((sub-and _ _ _)      (do))
          ((sub-some-rhs _ _ _) (do))
          ((sub-some-lhs _ _ _) (do))
          ((role-chain _ _ _)   (do)))
        result)))

  ;; ============================================================
  ;; CR7 — (X,Y) ∈ R(r), (Y,Z) ∈ R(s), r∘s ⊑ t ⟹ (X,Z) ∈ R(t)
  ;;
  ;; The other SELF-JOIN, and the one whose two handlers are easiest to
  ;; confuse: the rule runs in the MIDDLE context Y, joining an incoming
  ;; edge on one side against stored edges on the other. Which side is
  ;; which is decided by the incoming half, not by the axiom.
  ;; ============================================================

  (fn cr-chain-on-pred ((arena Arena) (ctx Context) (r RoleId) (x Node) (ax NormAxiom))
    (@intent "EL completion CR7: new FIRST leg (x,r,Y), scan stored second legs")
    (@spec ((Arena Context RoleId Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((role-chain r2 s t)
            (when (role-eq r r2)
              ;; Y = ctx.root is the join point: the arriving edge is
              ;; (x, r, Y), and every stored s-successor z of Y completes
              ;; the chain to (x, t, z).
              (match (map-get (. ctx succs) s)
                ((some zs)
                  (for-each (z zs)
                    (let ((pair (emit-edge arena
                                  (record-new LogicalEdge
                                    (from x) (role t) (to z)))))
                      (do
                        (list-push result (. pair succ-half))
                        (list-push result (. pair pred-half))))))
                ((none) (do)))))
          ((sub-name _ _)       (do))
          ((sub-and _ _ _)      (do))
          ((sub-some-rhs _ _ _) (do))
          ((sub-some-lhs _ _ _) (do))
          ((sub-role _ _)       (do)))
        result)))

  (fn cr-chain-on-succ ((arena Arena) (ctx Context) (s RoleId) (z Node) (ax NormAxiom))
    (@intent "EL completion CR7: new SECOND leg (Y,s,z), scan stored first legs")
    (@spec ((Arena Context RoleId Node NormAxiom) -> (List Addressed)))
    (@alloc arena)
    (let ((mut result (list-new arena Addressed)))
      (do
        (match ax
          ((role-chain r s2 t)
            (when (role-eq s s2)
              ;; Mirror image: the arriving edge is (Y, s, z), and every
              ;; stored r-predecessor x of Y completes (x, t, z).
              (match (map-get (. ctx preds) r)
                ((some xs)
                  (for-each (x xs)
                    (let ((pair (emit-edge arena
                                  (record-new LogicalEdge
                                    (from x) (role t) (to z)))))
                      (do
                        (list-push result (. pair succ-half))
                        (list-push result (. pair pred-half))))))
                ((none) (do)))))
          ((sub-name _ _)       (do))
          ((sub-and _ _ _)      (do))
          ((sub-some-rhs _ _ _) (do))
          ((sub-some-lhs _ _ _) (do))
          ((sub-role _ _)       (do)))
        result)))

  ;; ============================================================
  ;; Rule dispatch
  ;; ============================================================

  ;; THERE IS DELIBERATELY NO append-onto-an-accumulator HELPER.
  ;; Passing the dispatcher's result list to each rule so it can append
  ;; is the obvious way to write the dispatch below, and it cannot work:
  ;; a `(List T)` is a VALUE STRUCT, so the callee receives a copy whose
  ;; `len` the caller never sees, and `list-push` also needs an `arena`
  ;; the callee has no reason to take. The collection is therefore
  ;; written out at each call site, against the dispatcher's own local.
  ;;
  ;; The first attempt compiled to `use of undeclared identifier
  ;; 'arena'`, which is the lucky failure — had the helper taken an
  ;; arena it would have compiled and silently dropped every message
  ;; past the shared buffer's initial length.

  (fn apply-el-rules ((arena Arena) (ctx Context) (incoming Derived) (axioms (List NormAxiom)))
    (@intent "Apply every v0 completion rule triggered by one incoming Derived fact")
    (@spec ((Arena Context Derived (List NormAxiom)) -> (List Addressed)))
    (@alloc arena)
    ;; DISPATCH COVERAGE is the driver-level obligation §7 names: this
    ;; function must invoke every rule against every axiom, in every
    ;; trigger-table direction in the header. Without it a disabled
    ;; engine satisfies every per-rule contract vacuously — which is the
    ;; reason the table is transcribed above the code rather than left
    ;; to be inferred from it.
    ;;
    ;; `ctx` is always the ROUND SNAPSHOT Sₙ = Sₙ₋₁ ∪ Δₙ, never a live
    ;; mutating view — the store absorbed Δₙ at the previous barrier —
    ;; so `subsumers` and `preds` already include this round's arrivals,
    ;; which is what makes the Δₙ × Δₙ joins reachable from here.
    (let ((mut out (list-new arena Addressed)))
      (do
        (match incoming
          ;; ---- a new subsumer arrived: CR1, CR2, CR3, CR4, CR5 ----
          ((derived-sub b)
            (do
              (for-each (ax axioms)
                (do
                  (for-each (m (cr-sub-name-on-sub   arena ctx b ax)) (list-push out m))
                  (for-each (m (cr-and-on-sub        arena ctx b ax)) (list-push out m))
                  (for-each (m (cr-some-rhs-on-sub   arena ctx b ax)) (list-push out m))
                  (for-each (m (cr-exists-lhs-on-sub arena ctx b ax)) (list-push out m))))
              ;; CR5 takes no axiom premise — fired once, not per axiom.
              (for-each (m (cr-bottom-on-sub arena ctx b)) (list-push out m))))
          ;; ---- a new predecessor edge arrived: CR4, CR5, CR6, CR7 ----
          ((derived-pred r x)
            (do
              (for-each (ax axioms)
                (do
                  (for-each (m (cr-exists-lhs-on-pred arena ctx r x ax)) (list-push out m))
                  (for-each (m (cr-role-incl-on-pred  arena ctx r x ax)) (list-push out m))
                  (for-each (m (cr-chain-on-pred      arena ctx r x ax)) (list-push out m))))
              (for-each (m (cr-bottom-on-pred arena ctx x)) (list-push out m))))
          ;; ---- a new successor edge arrived: CR6, CR7 ----
          ;;
          ;; No CR4/CR5 handler here, and that is the trigger table, not
          ;; an omission: both conclude about a PREDECESSOR of the
          ;; context they run in, so a new successor at X gives X nothing
          ;; to say — the corresponding predecessor half arrives at the
          ;; other endpoint in the same round and fires there.
          ((derived-succ r y)
            (for-each (ax axioms)
              (do
                (for-each (m (cr-role-incl-on-succ arena ctx r y ax)) (list-push out m))
                (for-each (m (cr-chain-on-succ     arena ctx r y ax)) (list-push out m))))))
        out))))
