;; ============================================================
;; The el++ premise index  —  SPEC §5.4, the counterpart of premise.slop
;;
;; For an arriving fact, the normal-form axioms whose EDB atom can join
;; it, looked up once per fact. Every Fig. 3 rule with an EDB atom joins
;; that atom with an IDB fact on exactly one term: a class name for an
;; inst premise, a role for a triple or self premise. So two maps cover
;; every rule:
;;
;;   on-term   y  →  the axioms with an inst(·, y) premise
;;     subClass(y, z)            (5)
;;     subEx(v, y, z)            (7) and (8), on the inst side
;;     supEx(y, v, z, x′)        (9) and (10); a role assertion v(a, b)
;;                               is filed under {a}
;;     supSelf(y, v)             (12)
;;
;;   on-role   v  →  the axioms with a triple(·, v, ·) or self(·, v) premise
;;     subSelf(v, z)             (11)
;;     subRole(v, w)             (13) and (14)
;;     subRChain(v, ·, w) and subRChain(·, v, w)    (15)-(18), filed under
;;                               each role, once if equal (transitivity)
;;     supProd(v, ⊤, D)          (23)-(26)
;;
;; and two two-level maps for the joins whose stored side is a set of
;; classes (premise.slop's Partners), so the dispatcher walks whichever of
;; the bucket's keys and the element's classes is smaller:
;;
;;   and-pairs   y → z → subConj(y, z, ·) and subConj(z, y, ·)    (6), filed
;;                                         under each conjunct, once if equal
;;   ex-by-role  v → y → subEx(v, y, ·)    (7) on a triple, (8) on a self
;;
;; WHY FILTERING LOSES NOTHING. The dispatcher (kscsat.slop) offers an
;; axiom from a bucket to the rules its variant names, and each rule's
;; own first test is the equality on the bucket's key, so an axiom filed
;; elsewhere is one the rule would have rejected. Where an axiom sits in
;; a bucket under one of two positions (subConj, subRChain), the
;; dispatcher tries both positions and each rule decides. A partner walk
;; offers an axiom only when the element holds its other side, which the
;; rule's own test then checks again.
;;
;; `individuals` is NI, for rule (1): every individual an axiom names, in
;; first-mention order, each once.
;;
;; Built once, read-only after, so parallel runs may share it.
;; ============================================================

(module kscpremise
  (@doc "Premise index over el++ normal-form axioms, one lookup per arriving fact (SPEC §5.4)")

  (import rdf (IRI))
  (import types (RoleId KName KTerm KscAxiom role-eq kname-eq kterm-eq name-term nominal-term))

  (export
    KList KPartners RoleList KscIndex build-ksc-index term-bucket role-bucket and-partners ex-partners
    role-sups role-subs role-under)

  ;; A record around the list, for premise.slop's AxList reason: a Map of
  ;; records makes "read it, push, write it back" explicit.
  (type KList (record
    (items (List KscAxiom))))

  ;; One side of a join, keyed by the term the OTHER side must hold
  ;; (premise.slop's Partners, for el++). `count` is the number of keys,
  ;; so the dispatcher can walk whichever side of the intersection is
  ;; smaller - the stored facts or the bucket - at no cost to decide.
  (type KPartners (record
    (by-other (Map KTerm KList))
    (count    Int)))

  ;; A record around a role list, for KList's reason.
  (type RoleList (record
    (items (List RoleId))))

  ;; e ⊑* v with e ≠ v, as one key of `below`.
  (type RolePair (record
    (sub RoleId)
    (sup RoleId)))

  (type KscIndex (record
    (sups        (Map RoleId RoleList))   ; K7: e → sup*(e), e itself included
    (subs        (Map RoleId RoleList))   ; K7: v → sub*(v), v itself included
    (below       (Set RolePair))          ; K7: every e ⊑* v with e ≠ v
    (on-term     (Map KTerm KList))
    (on-role     (Map RoleId KList))
    (and-pairs   (Map KTerm KPartners))   ; conjunct y → the other conjunct → subConj axioms
    (ex-by-role  (Map RoleId KPartners))  ; role v → the filler → subEx axioms
    (individuals (List IRI))))

  (fn k-pushed ((arena Arena) (found (Option KList)) (ax KscAxiom))
    (@intent "The bucket a lookup found, with one more axiom — or a new bucket")
    (@spec ((Arena (Option KList) KscAxiom) -> KList))
    (@alloc arena)
    ;; As premise.slop's `pushed`: the caller writes the result back.
    (let ((mut items (match found
                       ((some l) (. l items))
                       ((none)   (list-new arena KscAxiom)))))
      (do
        (list-push items ax)
        (record-new KList (items items)))))

  (fn k-partnered ((arena Arena) (m (Map KTerm KPartners)) (key KTerm) (other KTerm) (ax KscAxiom))
    (@intent "File ax under key, then under the term its other side must hold")
    (@spec ((Arena (Map KTerm KPartners) KTerm KTerm KscAxiom) -> Bool))
    (@alloc arena)
    (let ((p (match (map-get m key)
               ((some q) q)
               ((none)   (record-new KPartners (by-other (map-new arena KTerm KList)) (count 0)))))
          (prior (map-get (. p by-other) other))
          (l (k-pushed arena prior ax)))
      (do
        (map-put (. p by-other) other l)
        (map-put m key (record-new KPartners
                         (by-other (. p by-other))
                         (count (match prior ((some _) (. p count)) ((none) (+ (. p count) 1))))))
        true)))

  (fn r-partnered ((arena Arena) (m (Map RoleId KPartners)) (key RoleId) (other KTerm) (ax KscAxiom))
    (@intent "File ax under the role key, then under the filler its other side must hold")
    (@spec ((Arena (Map RoleId KPartners) RoleId KTerm KscAxiom) -> Bool))
    (@alloc arena)
    (let ((p (match (map-get m key)
               ((some q) q)
               ((none)   (record-new KPartners (by-other (map-new arena KTerm KList)) (count 0)))))
          (prior (map-get (. p by-other) other))
          (l (k-pushed arena prior ax)))
      (do
        (map-put (. p by-other) other l)
        (map-put m key (record-new KPartners
                         (by-other (. p by-other))
                         (count (match prior ((some _) (. p count)) ((none) (+ (. p count) 1))))))
        true)))

  (fn file-term ((arena Arena) (m (Map KTerm KList)) (y KTerm) (ax KscAxiom))
    (@intent "File ax under the class term y")
    (@spec ((Arena (Map KTerm KList) KTerm KscAxiom) -> Bool))
    (@alloc arena)
    (let ((l (k-pushed arena (map-get m y) ax)))
      (do (map-put m y l) true)))

  (fn file-role ((arena Arena) (m (Map RoleId KList)) (v RoleId) (ax KscAxiom))
    (@intent "File ax under the role v")
    (@spec ((Arena (Map RoleId KList) RoleId KscAxiom) -> Bool))
    (@alloc arena)
    (let ((l (k-pushed arena (map-get m v) ax)))
      (do (map-put m v l) true)))

  (fn first-mention ((arena Arena) (seen (Set IRI)) (a IRI))
    (@intent "Is this a's first mention? Marks it seen")
    (@spec ((Arena (Set IRI) IRI) -> Bool))
    (@alloc arena)
    (if (set-has seen a)
      false
      (do (set-put seen a) true)))

  (fn term-individual ((t KTerm))
    (@intent "The individual a term names, if it is a nominal")
    (@spec ((KTerm) -> (Option IRI)))
    (@pure)
    (match t
      ((k-nominal a) (some a))
      ((k-name _)    (none))))

  (fn build-ksc-index ((arena Arena) (axioms (List KscAxiom)))
    (@intent "File every el++ normal-form axiom under the key its rules join on")
    (@spec ((Arena (List KscAxiom)) -> KscIndex))
    (@alloc arena)
    ;; Filed in list order, so every bucket is in the normaliser's
    ;; canonical order; nothing depends on it, but it keeps the index a
    ;; function of the input.
    (let ((up      (map-new arena RoleId RoleList))
          (down    (map-new arena RoleId RoleList))
          (sups    (map-new arena RoleId RoleList))
          (subs    (map-new arena RoleId RoleList))
          (below   (set-new arena RolePair))
          (on-term (map-new arena KTerm KList))
          (on-role (map-new arena RoleId KList))
          (and-pairs (map-new arena KTerm KPartners))
          (ex-by-role (map-new arena RoleId KPartners))
          (seen    (set-new arena IRI))
          (mut nis (list-new arena IRI)))
      (do
        (for-each (ax axioms)
          (match ax
            ((k-sub y z)
              (do
                (file-term arena on-term y ax)
                (match (term-individual y) ((some a) (when (first-mention arena seen a) (list-push nis a))) ((none) (do)))
                (match (term-individual z) ((some a) (when (first-mention arena seen a) (list-push nis a))) ((none) (do)))))
            ;; subConj and subEx's triple/self side go to the two-level
            ;; partner maps, not the flat buckets: a general class takes
            ;; part in thousands of conjunctions, and a role heads
            ;; thousands of ∃v.A ⊑ C (premise.slop: 77M rule calls for 131k
            ;; conclusions on GO, before el split them the same way).
            ((k-and a b _)
              (do
                (k-partnered arena and-pairs (name-term a) (name-term b) ax)
                (when (not (kname-eq a b))
                  (k-partnered arena and-pairs (name-term b) (name-term a) ax))))
            ((k-some-lhs v a _)
              (do
                (file-term arena on-term (name-term a) ax)
                (r-partnered arena ex-by-role v (name-term a) ax)))
            ((k-some-rhs a _ _ _)
              (file-term arena on-term (name-term a) ax))
            ((k-self-lhs v _)
              (file-role arena on-role v ax))
            ((k-self-rhs a _)
              (file-term arena on-term (name-term a) ax))
            ((k-role v w)
              (do
                (file-role arena on-role v ax)
                (let ((u (role-pushed arena (map-get up v) w))
                      (d (role-pushed arena (map-get down w) v)))
                  (do (map-put up v u) (map-put down w d)))))
            ((k-chain u v _)
              (do
                (file-role arena on-role u ax)
                (when (not (role-eq u v))
                  (file-role arena on-role v ax))))
            ((k-range v _)
              (file-role arena on-role v ax))
            ((k-role-assert a _ b)
              (do
                (file-term arena on-term (nominal-term a) ax)
                (when (first-mention arena seen a) (list-push nis a))
                (when (first-mention arena seen b) (list-push nis b))))))
        ;; K7's closure, over every role a subRole axiom names; any other
        ;; role is its own closure (role-sups, role-subs).
        (for-each (ax axioms)
          (match ax
            ((k-role v w)
              (do
                (when (not (map-has sups v)) (map-put sups v (role-walk arena up v)))
                (when (not (map-has sups w)) (map-put sups w (role-walk arena up w)))
                (when (not (map-has subs v)) (map-put subs v (role-walk arena down v)))
                (when (not (map-has subs w)) (map-put subs w (role-walk arena down w)))))
            ((k-sub _ _)            (do))
            ((k-and _ _ _)          (do))
            ((k-some-lhs _ _ _)     (do))
            ((k-some-rhs _ _ _ _)   (do))
            ((k-self-lhs _ _)       (do))
            ((k-self-rhs _ _)       (do))
            ((k-chain _ _ _)        (do))
            ((k-range _ _)          (do))
            ((k-role-assert _ _ _)  (do))))
        (for-each ((v l) subs)
          (for-each (e (. l items))
            (when (not (role-eq e v))
              (set-put below (record-new RolePair (sub e) (sup v))))))
        (record-new KscIndex
          (sups        sups)
          (subs        subs)
          (below       below)
          (on-term     on-term)
          (on-role     on-role)
          (and-pairs   and-pairs)
          (ex-by-role  ex-by-role)
          (individuals nis)))))

  (fn term-bucket ((idx KscIndex) (y KTerm))
    (@intent "The axioms with an inst(·, y) premise")
    (@spec ((KscIndex KTerm) -> (Option KList)))
    (@pure)
    (map-get (. idx on-term) y))

  (fn role-bucket ((idx KscIndex) (v RoleId))
    (@intent "The axioms with a triple(·, v, ·) or self(·, v) premise")
    (@spec ((KscIndex RoleId) -> (Option KList)))
    (@pure)
    (map-get (. idx on-role) v))

  (fn and-partners ((idx KscIndex) (y KTerm))
    (@intent "The subConj axioms with y as one conjunct, keyed by the other")
    (@spec ((KscIndex KTerm) -> (Option KPartners)))
    (@pure)
    (map-get (. idx and-pairs) y))

  (fn ex-partners ((idx KscIndex) (v RoleId))
    (@intent "The subEx axioms ∃v.A ⊑ C, keyed by their filler A")
    (@spec ((KscIndex RoleId) -> (Option KPartners)))
    (@pure)
    (map-get (. idx ex-by-role) v))

  ;; ============================================================
  ;; K7 (SPEC §5.4): the told role hierarchy, closed. A triple is stored
  ;; under the role it was derived with and read under every role above
  ;; it; `sups` and `subs` are those two directions of `⊑*`, each list
  ;; holding the role itself first. A breadth-first walk with a visited
  ;; set, because equivalent properties make the hierarchy cyclic
  ;; (premise.slop's role-closure, for el's L6).
  ;; ============================================================

  (fn role-pushed ((arena Arena) (found (Option RoleList)) (r RoleId))
    (@intent "The role list a lookup found, with one more role — or a new list")
    (@spec ((Arena (Option RoleList) RoleId) -> RoleList))
    (@alloc arena)
    (let ((mut items (match found
                       ((some l) (. l items))
                       ((none)   (list-new arena RoleId)))))
      (do
        (list-push items r)
        (record-new RoleList (items items)))))

  (fn role-walk ((arena Arena) (edges (Map RoleId RoleList)) (r RoleId))
    (@intent "r and every role reachable from it along edges, each once, r first")
    (@spec ((Arena (Map RoleId RoleList) RoleId) -> RoleList))
    (@alloc arena)
    (let ((mut out (list-new arena RoleId))
          (seen (set-new arena RoleId))
          (mut i 0))
      (do
        (set-put seen r)
        (list-push out r)
        (while (< i (cast Int (list-len out)))
          (do
            (match (list-get out i)
              ((some q)
                (match (map-get edges q)
                  ((some l)
                    (for-each (s (. l items))
                      (when (not (set-has seen s))
                        (do (set-put seen s) (list-push out s)))))
                  ((none) (do))))
              ((none) (do)))
            (set! i (+ i 1))))
        (record-new RoleList (items out)))))

  (fn role-sups ((arena Arena) (idx KscIndex) (e RoleId))
    (@intent "sup*(e): e and every role above it in the told hierarchy")
    (@spec ((Arena KscIndex RoleId) -> (List RoleId)))
    (@alloc arena)
    (match (map-get (. idx sups) e)
      ((some l) (. l items))
      ((none)   (let ((mut out (list-new arena RoleId))) (do (list-push out e) out)))))

  (fn role-subs ((arena Arena) (idx KscIndex) (v RoleId))
    (@intent "sub*(v): v and every role below it in the told hierarchy")
    (@spec ((Arena KscIndex RoleId) -> (List RoleId)))
    (@alloc arena)
    (match (map-get (. idx subs) v)
      ((some l) (. l items))
      ((none)   (let ((mut out (list-new arena RoleId))) (do (list-push out v) out)))))

  (fn role-under ((idx KscIndex) (e RoleId) (v RoleId))
    (@intent "e ∈ sub*(v): e is v or below it in the told hierarchy")
    (@spec ((KscIndex RoleId RoleId) -> Bool))
    (if (role-eq e v) true (set-has (. idx below) (record-new RolePair (sub e) (sup v)))))
)
