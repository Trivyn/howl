;; ============================================================
;; sriq's indexed commit  —  SPEC.md §5.5 S6 step 3, slice 9b (D5)
;;
;; commit-min (sriqsubsume) takes each candidate in turn: skip it if it is
;; ∈̂ W, else delete what it subsumes and insert it. It scans W for both,
;; and copies W at every insert, so a round's arena grows with inserts
;; times |W|. Its result is min(W ∪ C) whatever the order (R1), so it can
;; be computed in one pass instead. With W a min set:
;;   C₁ = the distinct candidates that are not tautologies and not ∈̂ W;
;;   C₂ = the members of C₁ that no other member of C₁ subsumes;
;;   W′ = the members of W that no member of C₂ subsumes.
;; min(W ∪ C) = W′ ∪ C₂, and C₂ is what W lacked: Δ. A candidate C₁ drops
;; is subsumed by one C₂ keeps (subsumption is a preorder, and C₁ is
;; finite), so checking C₂ against W suffices.
;;
;; "Does some x of X subsume c?" goes through an index: each x is filed
;; under one literal, its least body literal, or its least head literal
;; when its body is empty. If x ⊆ c, that literal is in c on the same
;; side, so probing c's literals finds every such x; subsumes confirms
;; each. The empty clause subsumes everything; it is kept aside, by
;; position, so that a query can skip it like any other.
;; ============================================================

(module sriqindex
  (@doc "sriq's indexed commit: min(W ∪ C) in one pass, with subsumption queries through a literal index (SPEC 5.5 S6,
         D5)")

  (import types (Lit Clause lit-cmp))
  (import sriqclauses (clause-cmp clause-eq))
  (import sriqsubsume (Committed subsumes tautology))
  (import canon (sort-range))

  (export SubIndex sub-index some-subsumes commit-indexed)

  ;; One clause filed under one literal: side 0 is the body, 1 the head.
  (type Entry (record
    (side Int)
    (lit  Lit)
    (i    Int)))

  (type SubIndex (record
    (xs      (List Clause))
    (entries (List Entry))     ; sorted by side, then literal
    (empty   Int)))            ; xs's empty clause, by position, or -1

  (fn entry-cmp ((a Entry) (b Entry))
    (@intent "By side, then literal")
    (@spec ((Entry Entry) -> Int))
    (@pure)
    (cond ((< (. a side) (. b side)) -1) ((> (. a side) (. b side)) 1) (else (lit-cmp (. a lit) (. b lit)))))

  (fn key-cmp ((e Entry) (side Int) (l Lit))
    (@intent "e against the key (side, l)")
    (@spec ((Entry Int Lit) -> Int))
    (@pure)
    (cond ((< (. e side) side) -1) ((> (. e side) side) 1) (else (lit-cmp (. e lit) l))))

  (fn entry-at ((es (List Entry)) (k Int) (fallback Entry))
    (@intent "Element k")
    (@spec (((List Entry) Int Entry) -> Entry))
    (@pure)
    (match (list-get es k) ((some e) e) ((none) fallback)))

  (fn key-of ((c Clause) (i Int))
    (@intent "The entry c is filed under: its least body literal, else its least head literal; none for the empty
              clause")
    (@spec ((Clause Int) -> (Option Entry)))
    (@pure)
    (match (list-get (. c body) 0)
      ((some l) (some (record-new Entry (side 0) (lit l) (i i))))
      ((none) (match (list-get (. c head) 0)
                ((some l) (some (record-new Entry (side 1) (lit l) (i i))))
                ((none) (none))))))

  (fn sub-index ((arena Arena) (xs (List Clause)))
    (@intent "xs filed by key literal, sorted. xs holds at most one empty clause (a min set, or a list without repeats),
              which is kept aside by position")
    (@spec ((Arena (List Clause)) -> SubIndex))
    (@alloc arena)
    (let ((mut raw (list-new arena Entry)) (mut empty -1) (mut i 0))
      (do (for-each (c xs)
            (do (match (key-of c i) ((some e) (list-push raw e)) ((none) (set! empty i)))
                (set! i (+ i 1))))
          (record-new SubIndex (xs xs) (entries (sorted-entries arena raw)) (empty empty)))))

  (fn sorted-entries ((arena Arena) (raw (List Entry)))
    (@intent "raw sorted by side, then literal")
    (@spec ((Arena (List Entry)) -> (List Entry)))
    (@alloc arena)
    (match (list-get raw 0)
      ((none) raw)
      ((some e0)
        (let ((idx (sort-range arena (cast Int (list-len raw))
                     (fn ((a Int) (b Int)) (entry-cmp (entry-at raw a e0) (entry-at raw b e0)))))
              (mut out (list-new arena Entry)))
          (do (for-each (k idx) (list-push out (entry-at raw k e0))) out)))))

  (fn lower-bound ((es (List Entry)) (side Int) (l Lit) (fallback Entry))
    (@intent "The first position whose entry is not below (side, l)")
    (@spec (((List Entry) Int Lit Entry) -> Int))
    (@pure)
    (let ((mut lo 0) (mut hi (cast Int (list-len es))))
      (do (while (< lo hi)
            (let ((mid (/ (+ lo hi) 2)))
              (if (< (key-cmp (entry-at es mid fallback) side l) 0) (set! lo (+ mid 1)) (set! hi mid))))
          lo)))

  (fn probe ((ix SubIndex) (side Int) (l Lit) (c Clause) (skip Int))
    (@intent "Does a clause filed under (side, l), other than number skip, subsume c?")
    (@spec ((SubIndex Int Lit Clause Int) -> Bool))
    (@pure)
    (match (list-get (. ix entries) 0)
      ((none) false)
      ((some e0)
        (let ((es (. ix entries)) (mut k (lower-bound (. ix entries) side l e0)) (mut found false) (mut going true))
          (do (while (and going (not found) (< k (cast Int (list-len es))))
                (let ((e (entry-at es k e0)))
                  (do (set! going (== (key-cmp e side l) 0))
                      (set! found (and going (hit ix e c skip)))
                      (set! k (+ k 1)))))
              found)))))

  (fn hit ((ix SubIndex) (e Entry) (c Clause) (skip Int))
    (@intent "Does entry e's clause, unless it is number skip, subsume c?")
    (@spec ((SubIndex Entry Clause Int) -> Bool))
    (@pure)
    (and (!= (. e i) skip) (x-subsumes ix (. e i) c)))

  (fn x-subsumes ((ix SubIndex) (i Int) (c Clause))
    (@intent "Does clause i of the index subsume c?")
    (@spec ((SubIndex Int Clause) -> Bool))
    (@pure)
    (match (list-get (. ix xs) i) ((some x) (subsumes x c)) ((none) false)))

  (fn some-subsumes ((ix SubIndex) (c Clause) (skip Int))
    (@intent "Does some clause of the index, other than number skip, subsume c? (skip below 0 skips none)")
    (@spec ((SubIndex Clause Int) -> Bool))
    (@pure)
    (let ((mut found (and (>= (. ix empty) 0) (!= (. ix empty) skip))))
      (do (for-each (l (. c body)) (when (and (not found) (probe ix 0 l c skip)) (set! found true)))
          (for-each (l (. c head)) (when (and (not found) (probe ix 1 l c skip)) (set! found true)))
          found)))

  (fn distinct ((arena Arena) (cs (List Clause)))
    (@intent "cs in content order, each clause once")
    (@spec ((Arena (List Clause)) -> (List Clause)))
    (@alloc arena)
    (match (list-get cs 0)
      ((none) cs)
      ((some c0)
        (let ((idx (sort-range arena (cast Int (list-len cs))
                     (fn ((a Int) (b Int)) (clause-cmp (clause-of cs a c0) (clause-of cs b c0)))))
              (mut out (list-new arena Clause)) (mut have false) (mut last c0))
          (do (for-each (k idx)
                (let ((c (clause-of cs k c0)))
                  (when (not (and have (clause-eq c last)))
                    (do (list-push out c) (set! last c) (set! have true)))))
              out)))))

  (fn clause-of ((cs (List Clause)) (k Int) (fallback Clause))
    (@intent "Element k")
    (@spec (((List Clause) Int Clause) -> Clause))
    (@pure)
    (match (list-get cs k) ((some c) c) ((none) fallback)))

  (fn merged ((arena Arena) (a (List Clause)) (b (List Clause)))
    (@intent "a and b, both in content order, merged in content order")
    (@spec ((Arena (List Clause) (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)) (mut j 0))
      (do (for-each (x a)
            (do (while (match (list-get b j) ((some y) (< (clause-cmp y x) 0)) ((none) false))
                  (do (match (list-get b j) ((some y) (list-push out y)) ((none) (set! j j)))
                      (set! j (+ j 1))))
                (list-push out x)))
          (while (< j (cast Int (list-len b)))
            (do (match (list-get b j) ((some y) (list-push out y)) ((none) (set! j j)))
                (set! j (+ j 1))))
          out)))

  (fn commit-indexed ((arena Arena) (ws (List Clause)) (cs (List Clause)))
    (@intent "min(W ∪ C) for a min set W (content order) and candidates C, as commit-min gives it, in one pass: its set
              in content order, and what W lacked")
    (@spec ((Arena (List Clause) (List Clause)) -> Committed))
    (@alloc arena)
    (let ((wix (sub-index arena ws))
          (mut c1 (list-new arena Clause)))
      (do (for-each (c (distinct arena cs))
            (when (not (or (tautology c) (some-subsumes wix c -1))) (list-push c1 c)))
          (let ((c1ix (sub-index arena c1)) (mut c2 (list-new arena Clause)) (mut i 0))
            (do (for-each (c c1)
                  (do (when (not (some-subsumes c1ix c i)) (list-push c2 c))
                      (set! i (+ i 1))))
                (let ((c2ix (sub-index arena c2)) (mut kept (list-new arena Clause)))
                  (do (for-each (w ws) (when (not (some-subsumes c2ix w -1)) (list-push kept w)))
                      (record-new Committed (set (merged arena kept c2)) (added c2)))))))))

)
