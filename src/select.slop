;; ============================================================
;; Profile selection and calculus dispatch  —  SPEC.md §5.1
;;
;; THE LADDER. One rung per named logic, each complete for exactly
;; that logic and never registered under a wider label:
;;   el          ELH⊥R+ + domain/range + ABox (§5.2)    PTIME     implemented
;;   el++        the OWL 2 EL object fragment (§5.4)     PTIME     implemented
;;   sriq        the SRIQ object fragment + ABox (§5.5)  2ExpTime  specified
;; el ⊂ el++ and el ⊂ sriq; el++ and sriq are incomparable (nominals
;; against inverses, unions and counting). The declaration order of
;; `Profile` is the fixed tie-break order.
;;
;; `horn-sriq` WAS DROPPED (§5, 2026-10-08): on sriq's calculus it would
;; run at the same cost, so it would only be a stricter gate. Its enum
;; slot stays, so 0.1.0's C and Rust ABI is not renumbered, and a request
;; for it is refused for good (`profile-dropped`), its message naming
;; sriq.
;;
;; THE DEFAULT IS `explicit el`, not `auto` (types.slop,
;; default-config): a default run keeps one cost class and one theory
;; across upgrades. `auto` is an opt-in.
;;
;; AN EXPLICIT REQUEST IS HONOURED EXACTLY OR REFUSED. A request for a
;; rung that is not built yet is `Fault::unavailable`, never quietly
;; run as `el`: that would classify a strictly smaller theory than the
;; caller asked for and report it under the wrong name.
;;
;; `auto` IS WHOLE-ONTOLOGY MEMBERSHIP IN A SINGLE IMPLEMENTED PROFILE
;; — NEVER A UNION. Pick the cheapest implemented profile that
;; contains EVERY construct in the ontology. If none does, the run is
;; partial, and WHICH profile it runs under is fixed by rule rather
;; than left open: the one leaving the fewest logical axioms omitted,
;; ties broken by the declaration order. Without that rule two
;; conforming implementations classify different sub-theories of the
;; same input and return different findings — both sound, neither
;; reproducible, and §6.8 violated ACROSS IMPLEMENTATIONS rather than
;; across runs. With `el` and `el++` implemented that is `choose-auto`:
;; `el` when nothing is out of `el`'s profile, since it comes first and
;; `el ⊂ el++`; otherwise the rung with fewer logical axioms out of
;; profile, a tie going to `el`. `auto` therefore depends on the
;; ontology, so `select-profile` leaves it unresolved and `prepare`
;; resolves it from the two gates' counts (howl.slop, auto-profile).
;;
;; THE GATE TESTS MEMBERSHIP IN HOWL'S IMPLEMENTED LANGUAGE, NOT IN
;; OWL 2 EL. The two are not the same set, and testing the wrong one is
;; precisely how an incomplete run gets reported as a complete one.
;;
;; Choosing a profile weaker than the ontology needs makes HOWL
;; incomplete for it and, critically for validation, able to MISS AN
;; INCOHERENCE. So an out-of-profile construct is never cosmetic: it
;; records the axiom in coverage.omitted, which no command may report
;; as coherent. It may still report INCOHERENT from that same run — a
;; derived contradiction is definitive whatever the coverage.
;; ============================================================

(module select
  (@doc "Profile selection: the ladder's names, resolution, and what is implemented")

  (import types (Profile ProfileSelection))

  (export
    select-profile
    choose-auto
    profile-implemented
    profile-dropped
    unavailable-message
    profile-name
    parse-profile)

  (fn select-profile ((selection ProfileSelection))
    (@intent "The calculus an explicit request asks for; none for auto, which depends on the ontology")
    (@spec ((ProfileSelection) -> (Option Profile)))
    (@pure)
    ;; An EXPLICIT request resolves to exactly itself; whether it can
    ;; run is `profile-implemented`'s question, asked separately so a
    ;; refusal names what was asked for. `auto` is resolved per ontology
    ;; by `choose-auto`.
    (@post (match selection
             ((auto)       (match $result ((none) true) ((some _) false)))
             ((explicit p) (match $result ((some q) {q == p}) ((none) false)))))
    (match selection
      ((auto)       (none))
      ((explicit p) (some p))))

  (fn choose-auto ((out-of-el (Int 0 ..)) (out-of-el-plus-plus (Int 0 ..)))
    (@intent "§5.1's auto rule over el and el++, from how many logical axioms each leaves out of profile")
    (@spec (((Int 0 ..) (Int 0 ..)) -> Profile))
    (@pure)
    ;; The cheapest rung containing the whole ontology, else the one
    ;; omitting the fewest logical axioms, ties by declaration order. `el`
    ;; is first, so it wins whenever it omits nothing and on every tie.
    (@post (implies {out-of-el == 0} {$result == 'profile-el}))
    (@post (implies {out-of-el-plus-plus < out-of-el} {$result == 'profile-el-plus-plus}))
    (@post (implies {out-of-el <= out-of-el-plus-plus} {$result == 'profile-el}))
    (@example (0 0) -> 'profile-el)
    (@example (2 0) -> 'profile-el-plus-plus)
    (@example (2 1) -> 'profile-el-plus-plus)
    (@example (1 1) -> 'profile-el)
    (if (< out-of-el-plus-plus out-of-el) 'profile-el-plus-plus 'profile-el))

  (fn profile-implemented ((p Profile))
    (@intent "Whether a calculus for this rung is built")
    (@spec ((Profile) -> Bool))
    (@pure)
    ;; Pinned so that wiring a rung in is a deliberate, visible edit:
    ;; the postcondition and the match change together.
    (@post {$result == (or (p == 'profile-el) (p == 'profile-el-plus-plus))})
    (match p
      ('profile-el           true)
      ('profile-el-plus-plus true)
      ('profile-horn-sriq    false)
      ('profile-sriq         false)))

  (fn profile-dropped ((p Profile))
    (@intent "Whether a rung was dropped from the ladder, so a request for it is refused for good")
    (@spec ((Profile) -> Bool))
    (@pure)
    ;; Only horn-sriq (§5). A dropped rung is never implemented, so its
    ;; refusal says what replaces it rather than "not implemented yet".
    (@post {$result == (p == 'profile-horn-sriq)})
    (match p
      ('profile-el           false)
      ('profile-el-plus-plus false)
      ('profile-horn-sriq    true)
      ('profile-sriq         false)))

  (fn unavailable-message ((arena Arena) (p Profile))
    (@intent "Why an explicit request for this rung is refused: dropped, or not built yet (§5.1, §9)")
    (@spec ((Arena Profile) -> String))
    (@alloc arena)
    ;; The one source of the refusal's text, so the CLI and the C API
    ;; (`howl_run_fault_message`) say the same. The Rust crate's `Fault`
    ;; display mirrors it, and tests on both sides pin both texts.
    (let ((named (string-concat arena "profile " (profile-name p))))
      (if (profile-dropped p)
        (string-concat arena named " was dropped; sriq covers its language")
        (string-concat arena named " is not implemented yet (implemented: el, el++)"))))

  (fn profile-name ((p Profile))
    (@intent "A rung's name, as the CLI flag and the report spell it")
    (@spec ((Profile) -> String))
    (@pure)
    (match p
      ('profile-el           "el")
      ('profile-el-plus-plus "el++")
      ('profile-horn-sriq    "horn-sriq")
      ('profile-sriq         "sriq")))

  (fn parse-profile ((s String))
    (@intent "The rung a name denotes, the inverse of profile-name")
    (@spec ((String) -> (Option Profile)))
    (@pure)
    (cond
      ((string-eq s "el")        (some 'profile-el))
      ((string-eq s "el++")      (some 'profile-el-plus-plus))
      ((string-eq s "horn-sriq") (some 'profile-horn-sriq))
      ((string-eq s "sriq")      (some 'profile-sriq))
      (else                      none))))
