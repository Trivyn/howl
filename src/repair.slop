;; Mapping-relative conflict enumeration and verified minimal repairs.
;; The oracle receives sorted indices of REMOVED input mapping axioms.
(module repair
  (import types (Verdict Fault Omission Termination cancel-requested))
  (import canon (sort-range omission-cmp))
  (export Check Checked SearchOptions MappingSet Candidate CandidateReason Phase SearchCounts SearchResult
          default-search-options search has-index subset indices set-add remove-index set-cmp candidate-reason-text)

  (type Check (record (verdict Verdict) (complete Bool) (omissions (List Omission)) (termination Termination)))
  (type Checked (union (checked Check) (check-fault Fault)))
  (type SearchOptions (record (conflict-calls Int) (conflict-nodes Int) (hitting-nodes Int)
                             (verification-calls Int) (cancel I64)))
  (type MappingSet (record (items (List Int))))
  (type CandidateReason (enum candidate-budget candidate-unknown))
  (type Candidate (record (removed (List Int)) (reason CandidateReason)))

  (fn candidate-reason-text ((reason CandidateReason))
    (@spec ((CandidateReason) -> String))
    (@pure)
    (match reason ('candidate-budget "verification-budget") ('candidate-unknown "inconclusive-classification")))
  (type Phase (record (exhausted Bool) (capped Bool) (unresolved Bool)))
  (type SearchCounts (record (preflight-calls Int) (conflict-calls Int) (conflict-nodes Int)
                            (hitting-nodes Int) (verification-calls Int) (cache-hits Int)))
  (type SearchResult (record
    (verified (List MappingSet)) (candidates (List Candidate)) (conflicts (List MappingSet))
    (conflict-phase Phase) (hitting-phase Phase) (verification-phase Phase)
    (omissions (List Omission)) (counts SearchCounts)
    (already-coherent Bool) (unrepairable Bool) (complete Bool)))
  (type Cached (record (removed (List Int)) (answer Check)))
  (type SearchState (record
    (cache (List Cached)) (omissions (List Omission)) (counts SearchCounts)
    (fault (Option Fault)) (conflict-phase Phase) (hitting-phase Phase) (verification-phase Phase)))

  (fn default-search-options ()
    (@spec (() -> SearchOptions))
    (@post {(. $result conflict-calls) == 128})
    (@post {(. $result verification-calls) == 128})
    (record-new SearchOptions (conflict-calls 128) (conflict-nodes 100000)
      (hitting-nodes 100000) (verification-calls 128) (cancel 0)))

  (fn has-index ((xs (List Int)) (x Int))
    (@spec (((List Int) Int) -> Bool))
    (@pure)
    (@post (== $result (exists (v xs) (== v x))))
    (let ((mut found false))
      (do (for-each (v xs)
            (@loop-invariant (== found (exists (v2 (list-visited xs)) (== v2 x))))
            (when (== v x) (set! found true))) found)))

  (fn subset ((xs (List Int)) (ys (List Int)))
    (@spec (((List Int) (List Int)) -> Bool))
    (@pure)
    (let ((mut yes true))
      (do (for-each (x xs)
            (when (not (has-index ys x)) (set! yes false))) yes)))

  (fn index-at ((xs (List Int)) (i Int))
    (@spec (((List Int) Int) -> Int))
    (@pure)
    (match (list-get xs i) ((some x) x) ((none) -1)))

  (fn indices ((arena Arena) (n Int))
    (@spec ((Arena Int) -> (List Int)))
    (@pre {(n >= 0)})
    (@alloc arena)
    (let ((mut xs (list-new arena Int)) (mut i 0))
      (do (while (< i n) (do (list-push xs i) (set! i (+ i 1)))) xs)))

  (fn set-add ((arena Arena) (xs (List Int)) (x Int))
    (@spec ((Arena (List Int) Int) -> (List Int)))
    (@alloc arena)
    ;; Input sorted and unique; insert once, preserving that invariant.
    (let ((mut out (list-new arena Int)) (mut placed false))
      (do
        (for-each (v xs)
          (do (when (and (not placed) (<= x v)) (do (list-push out x) (set! placed true)))
              (when (!= v x) (list-push out v))))
        (when (not placed) (list-push out x)) out)))

  (fn remove-index ((arena Arena) (xs (List Int)) (x Int))
    (@spec ((Arena (List Int) Int) -> (List Int)))
    (@alloc arena)
    (@post {(list-len $result) <= (list-len xs)})
    (@post (forall (v $result) (!= v x)))
    (let ((mut out (list-new arena Int)))
      (do (for-each (v xs)
            (@loop-invariant (and (forall (v2 out) (!= v2 x))
                                 (<= (list-len out) (list-len (list-visited xs)))))
            (when (!= v x) (list-push out v))) out)))

  (fn difference ((arena Arena) (xs (List Int)) (ys (List Int)))
    (@spec ((Arena (List Int) (List Int)) -> (List Int)))
    (@alloc arena)
    (let ((mut out (list-new arena Int)))
      (do (for-each (v xs) (when (not (has-index ys v)) (list-push out v))) out)))

  (fn set-cmp ((xs (List Int)) (ys (List Int)))
    (@spec (((List Int) (List Int)) -> Int))
    (@pure)
    (let ((mut cmp 0) (mut i 0))
      (do
        (if (!= (list-len xs) (list-len ys))
          (set! cmp (if (< (list-len xs) (list-len ys)) -1 1))
          (while (and (== cmp 0) (< i (list-len xs)))
            (do (let ((a (index-at xs i)) (b (index-at ys i)))
                  (when (!= a b) (set! cmp (if (< a b) -1 1))))
                (set! i (+ i 1))))) cmp)))

  (fn set-at ((arena Arena) (xs (List MappingSet)) (i Int))
    (@spec ((Arena (List MappingSet) Int) -> (List Int)))
    (@alloc arena)
    (match (list-get xs i) ((some x) (. x items)) ((none) (list-new arena Int))))

  (fn known-set ((xs (List MappingSet)) (items (List Int)))
    (@spec (((List MappingSet) (List Int)) -> Bool))
    (@pure)
    (let ((mut yes false))
      (do (for-each (x xs) (when (== (set-cmp (. x items) items) 0) (set! yes true))) yes)))

  (fn keep-set ((xs (Ptr (List MappingSet))) (items (List Int)))
    (@spec (((Ptr (List MappingSet)) (List Int)) -> Unit))
    (when (not (known-set (deref xs) items)) (list-push (deref xs) (record-new MappingSet (items items)))))

  (fn sorted-sets ((arena Arena) (xs (List MappingSet)))
    (@spec ((Arena (List MappingSet)) -> (List MappingSet)))
    (@alloc arena)
    (let ((order (sort-range arena (list-len xs)
                   (fn ((i Int) (j Int)) (set-cmp (set-at arena xs i) (set-at arena xs j)))))
          (mut out (list-new arena MappingSet)) (mut previous (Option MappingSet) (none)))
      ;; Equal sets are adjacent once sorted: keep the first of each run.
      (do (for-each (i order)
            (let ((x (record-new MappingSet (items (set-at arena xs i)))))
              (when (match previous ((none) true) ((some p) (!= (set-cmp (. p items) (. x items)) 0)))
                (do (list-push out x) (set! previous (some x))))))
          out)))

  (fn set-key ((arena Arena) (xs (List Int)))
    (@spec ((Arena (List Int)) -> String))
    (@alloc arena)
    ;; Hash key of a sorted index list: equal keys exactly for equal sets.
    ;; Text "i,j,k," sized first, then written into one allocation, so
    ;; space and time are linear in the set (concatenation is quadratic).
    (let ((mut key String ""))
      (do
        (c-inline "{ char d[24]; size_t n = 0, k = 0;\n for (size_t i = 0; i < xs.len; i++) n += (size_t)snprintf(d, sizeof d, \"%lld,\", (long long)xs.data[i]);\n char *buf = (char*)slop_arena_alloc(arena, n + 1);\n for (size_t i = 0; i < xs.len; i++) k += (size_t)snprintf(buf + k, n + 1 - k, \"%lld,\", (long long)xs.data[i]);\n key = (slop_string){n, buf}; }")
        key)))

  (fn fresh ((arena Arena) (seen (Set String)) (items (List Int)))
    (@spec ((Arena (Set String) (List Int)) -> Bool))
    (@alloc arena)
    ;; True, recording ITEMS, when no equal set was seen before.
    (let ((key (set-key arena items)) (mut yes false))
      (do (when (not (set-has seen key)) (do (set-put seen key) (set! yes true))) yes)))

  (fn empty-phase ()
    (@spec (() -> Phase))
    (record-new Phase (exhausted false) (capped false) (unresolved false)))

  (fn phase-complete ((p Phase))
    (@spec ((Phase) -> Bool))
    (@pure)
    (@post {$result == ((. p exhausted) and (not (. p capped)) and (not (. p unresolved)))})
    (and (. p exhausted) (not (. p capped)) (not (. p unresolved))))

  (fn stopped ((st (Ptr SearchState)) (options SearchOptions))
    (@spec (((Ptr SearchState) SearchOptions) -> Bool))
    (do
      (when (cancel-requested (. options cancel))
        (set! (. (deref st) fault) (some (union-new Fault cancelled))))
      (match (. (deref st) fault) ((some _) true) ((none) false))))

  (fn good ((c Check))
    (@spec ((Check) -> Bool))
    (@pure)
    (@post {$result == ((. c complete) and ((. c verdict) == 'verdict-coherent))})
    (and (. c complete) (== (. c verdict) 'verdict-coherent)))

  (fn bad ((c Check))
    (@spec ((Check) -> Bool))
    (@pure)
    (@post {$result == ((. c verdict) == 'verdict-incoherent)})
    (== (. c verdict) 'verdict-incoherent))

  (fn ask ((arena Arena) (st (Ptr SearchState)) (options SearchOptions) (phase Int) (removed (List Int))
           (check (Fn ((List Int)) Checked)))
    (@spec ((Arena (Ptr SearchState) SearchOptions Int (List Int) (Fn ((List Int)) Checked)) -> (Option Check)))
    (@alloc arena)
    ;; phase 0: background; 1: conflicts; 2: verification. Cache checks
    ;; observe cancellation too. The oracle must own returned data.
    (let ((mut answer (Option Check) (none)))
      (do
        (when (not (stopped st options))
          (do
            (for-each (entry (. (deref st) cache))
              (when (== (set-cmp removed (. entry removed)) 0) (set! answer (some (. entry answer)))))
            (match answer
              ((some _)
                (set! (. (. (deref st) counts) cache-hits) (+ (. (. (deref st) counts) cache-hits) 1)))
              ((none)
                (let ((capped (or (and (== phase 1) (>= (. (. (deref st) counts) conflict-calls) (. options conflict-calls)))
                                  (and (== phase 2) (>= (. (. (deref st) counts) verification-calls) (. options verification-calls))))))
                  (if capped
                    (if (== phase 1) (set! (. (. (deref st) conflict-phase) capped) true)
                                      (set! (. (. (deref st) verification-phase) capped) true))
                    (do
                      (cond
                        ((== phase 0) (set! (. (. (deref st) counts) preflight-calls) (+ (. (. (deref st) counts) preflight-calls) 1)))
                        ((== phase 1) (set! (. (. (deref st) counts) conflict-calls) (+ (. (. (deref st) counts) conflict-calls) 1)))
                        (else (set! (. (. (deref st) counts) verification-calls) (+ (. (. (deref st) counts) verification-calls) 1))))
                      (let ((reply Checked (check removed)))
                       (match reply
                        ((check-fault f)
                          (let ((held (Option Fault) (some f))) (set! (. (deref st) fault) held)))
                        ((checked c)
                          (do (list-push (. (deref st) cache) (record-new Cached (removed removed) (answer c)))
                              (let ((oms (List Omission) (. c omissions)))
                                (for-each (o oms) (list-push (. (deref st) omissions) o)))
                              (set! answer (some c)))))))))))))
        (when (stopped st options) (set! answer (none))) answer)))

  (fn find-conflict ((known (List MappingSet)) (retained (List Int)))
    (@spec (((List MappingSet) (List Int)) -> (Option MappingSet)))
    (@pure)
    (let ((mut found (Option MappingSet) (none)))
      (do (for-each (c known)
            (match found ((some _) (do)) ((none) (when (subset (. c items) retained) (set! found (some c))))))
          found)))

  (fn shrink ((arena Arena) (st (Ptr SearchState)) (options SearchOptions) (all (List Int)) (retained (List Int))
              (check (Fn ((List Int)) Checked)))
    (@spec ((Arena (Ptr SearchState) SearchOptions (List Int) (List Int) (Fn ((List Int)) Checked)) -> (Option MappingSet)))
    (@alloc arena)
    ;; Delete deterministic blocks, halving their size down to singletons.
    ;; A failed singleton deletion is a complete coherent oracle answer;
    ;; later deletions preserve coherence by monotonicity.
    (let ((mut cur retained) (mut width (list-len retained)) (mut valid true))
      (do
        (while (and valid (> width 0) (not (stopped st options)))
          (do
            (let ((mut pos 0))
              (while (and valid (< pos (list-len cur)) (not (stopped st options)))
                (let ((mut trial (list-new arena Int)) (mut i 0))
                  (do
                    (for-each (x cur)
                      (do (when (or (< i pos) (>= i (+ pos width))) (list-push trial x)) (set! i (+ i 1))))
                    (match (ask arena st options 1 (difference arena all trial) check)
                      ((none) (set! valid false))
                      ((some c)
                        (cond
                          ((bad c) (set! cur trial))
                          ((good c) (set! pos (+ pos width)))
                          (else (do (set! valid false) (set! (. (. (deref st) conflict-phase) unresolved) true))))))))))
            (set! width (if (== width 1) 0 (/ (+ width 1) 2)))))
        (when valid
          (match (ask arena st options 1 (difference arena all cur) check)
            ((none) (set! valid false))
            ((some final)
              (when (not (and (. final complete) (bad final)))
                (do (set! valid false) (set! (. (. (deref st) conflict-phase) unresolved) true))))))
        (if valid (some (record-new MappingSet (items cur))) (none)))))

  ;; The exclusion queue is a binary min-heap under set-cmp, the canonical
  ;; order: cardinality, then lexicographic index order. Queued sets are
  ;; distinct, so the order is strict and pops follow it exactly.
  (fn heap-push ((arena Arena) (queue (Ptr (List MappingSet))) (items (List Int)))
    (@spec ((Arena (Ptr (List MappingSet)) (List Int)) -> Unit))
    (@alloc arena)
    (let ((mut i (list-len (deref queue))) (mut moving true))
      (do
        (list-push (deref queue) (record-new MappingSet (items items)))
        (while (and moving (> i 0))
          (let ((parent (/ (- i 1) 2)))
            (let ((up (set-at arena (deref queue) parent)))
              (if (< (set-cmp items up) 0)
                (do (when (list-set (deref queue) i (record-new MappingSet (items up))) (do)) (set! i parent))
                (set! moving false)))))
        (when (list-set (deref queue) i (record-new MappingSet (items items))) (do)))))

  (fn heap-pop ((arena Arena) (queue (Ptr (List MappingSet))))
    (@spec ((Arena (Ptr (List MappingSet))) -> (List Int)))
    (@alloc arena)
    ;; Remove and return the least set; the last entry sifts down from the root.
    (let ((least (set-at arena (deref queue) 0)))
      (do
        (match (list-pop (deref queue))
          ((none) (do))
          ((some last)
            (let ((n (list-len (deref queue))) (mut i 0) (mut moving (> (list-len (deref queue)) 0)))
              (do
                (while moving
                  (let ((mut child (+ (* 2 i) 1)))
                    (if (>= child n)
                      (set! moving false)
                      (do
                        (when (and (< (+ child 1) n)
                                   (< (set-cmp (set-at arena (deref queue) (+ child 1)) (set-at arena (deref queue) child)) 0))
                          (set! child (+ child 1)))
                        (if (< (set-cmp (set-at arena (deref queue) child) (. last items)) 0)
                          (do (when (list-set (deref queue) i (record-new MappingSet (items (set-at arena (deref queue) child)))) (do))
                              (set! i child))
                          (set! moving false))))))
                (when (< i n) (when (list-set (deref queue) i last) (do)))))))
        least)))

  (fn enumerate-conflicts ((arena Arena) (st (Ptr SearchState)) (options SearchOptions) (all (List Int))
                           (check (Fn ((List Int)) Checked)))
    (@spec ((Arena (Ptr SearchState) SearchOptions (List Int) (Fn ((List Int)) Checked)) -> (List MappingSet)))
    (@alloc arena)
    ;; SEEN holds every set ever queued, so each is expanded at most once.
    (let ((mut known (list-new arena MappingSet)) (mut queue (list-new arena MappingSet))
          (seen (set-new arena String)) (empty (list-new arena Int)))
      (do
        (when (fresh arena seen empty) (heap-push arena (addr queue) empty))
        (while (and (> (list-len queue) 0) (not (. (. (deref st) conflict-phase) capped)) (not (stopped st options)))
         (do
          (let ((excluded (heap-pop arena (addr queue))))
            (do
              (let ((retained (difference arena all excluded)) (mut conflict (Option MappingSet) (none)))
                (do
                  (set! conflict (find-conflict known retained))
                  (match conflict
                    ((some _) (do))
                    ((none)
                      (match (ask arena st options 1 excluded check)
                        ((none) (do))
                        ((some c)
                          (cond
                            ((good c) (do))
                            ((bad c) (set! conflict (shrink arena st options all retained check)))
                            (else (set! (. (. (deref st) conflict-phase) unresolved) true)))))))
                  (match conflict
                    ((none) (do))
                    ((some c)
                      (do
                        (keep-set (addr known) (. c items))
                        (let ((members (List Int) (. c items)))
                         (for-each (x members)
                          (when (not (stopped st options))
                            (if (>= (. (. (deref st) counts) conflict-nodes) (. options conflict-nodes))
                              (set! (. (. (deref st) conflict-phase) capped) true)
                              (do
                                (set! (. (. (deref st) counts) conflict-nodes) (+ (. (. (deref st) counts) conflict-nodes) 1))
                                (let ((child (set-add arena excluded x)))
                                  (when (fresh arena seen child) (heap-push arena (addr queue) child)))))))))))))))))
        (set! (. (. (deref st) conflict-phase) exhausted) (== (list-len queue) 0))
        (sorted-sets arena known))))

  (fn intersects ((a (List Int)) (b (List Int)))
    (@spec (((List Int) (List Int)) -> Bool))
    (@pure)
    (let ((mut yes false))
      (do (for-each (x a) (when (has-index b x) (set! yes true))) yes)))

  (fn unhit ((conflicts (List MappingSet)) (removed (List Int)))
    (@spec (((List MappingSet) (List Int)) -> (Option MappingSet)))
    (@pure)
    (let ((mut found (Option MappingSet) (none)))
      (do (for-each (c conflicts)
            (match found ((some _) (do)) ((none) (when (not (intersects (. c items) removed)) (set! found (some c))))))
          found)))

  (fn minimal-hit ((conflicts (List MappingSet)) (removed (List Int)))
    (@spec (((List MappingSet) (List Int)) -> Bool))
    (@pure)
    ;; Every removed member must be the sole hit of some conflict.
    (let ((mut minimal true))
      (do
        (for-each (x removed)
          (let ((mut witness false))
            (do
              (for-each (c conflicts)
                (when (has-index (. c items) x)
                  (let ((mut count 0))
                    (do (for-each (y removed) (when (has-index (. c items) y) (set! count (+ count 1))))
                        (when (== count 1) (set! witness true))))))
              (when (not witness) (set! minimal false))))) minimal)))

  (fn enumerate-hits ((arena Arena) (st (Ptr SearchState)) (options SearchOptions) (conflicts (List MappingSet)))
    (@spec ((Arena (Ptr SearchState) SearchOptions (List MappingSet)) -> (List MappingSet)))
    (@alloc arena)
    ;; Stack indices give an iterative DFS without native stack growth.
    ;; SEEN deduplicates NODES, so each node is popped at most once.
    (let ((mut nodes (list-new arena MappingSet)) (mut stack (list-new arena Int))
          (mut found (list-new arena MappingSet)) (mut top 0) (seen (set-new arena String))
          (empty (list-new arena Int)))
      (do
        (when (fresh arena seen empty) (list-push nodes (record-new MappingSet (items empty))))
        (list-push stack 0) (set! top 1)
        (while (and (> top 0) (not (. (. (deref st) hitting-phase) capped)) (not (stopped st options)))
          (do
            (set! top (- top 1))
            ;; A superset of a found transversal is itself a transversal and,
            ;; never popped before, a proper superset: minimal-hit rejects it.
            ;; So FOUND needs neither a superset scan nor a duplicate check.
            (let ((candidate (set-at arena nodes (index-at stack top))))
              (match (unhit conflicts candidate)
                ((none) (when (minimal-hit conflicts candidate)
                          (list-push found (record-new MappingSet (items candidate)))))
                ((some c)
                  (let ((mut i (- (list-len (. c items)) 1)))
                    (while (and (>= i 0) (not (. (. (deref st) hitting-phase) capped)) (not (stopped st options)))
                      (do
                        (if (>= (. (. (deref st) counts) hitting-nodes) (. options hitting-nodes))
                          (set! (. (. (deref st) hitting-phase) capped) true)
                          (do
                            (set! (. (. (deref st) counts) hitting-nodes) (+ (. (. (deref st) counts) hitting-nodes) 1))
                            (let ((child (set-add arena candidate (index-at (. c items) i))))
                              (when (fresh arena seen child)
                                (do
                                  (list-push nodes (record-new MappingSet (items child)))
                                  (if (< top (list-len stack)) (when (list-set stack top (- (list-len nodes) 1)) (do))
                                                              (list-push stack (- (list-len nodes) 1)))
                                  (set! top (+ top 1)))))))
                        (set! i (- i 1))))))))))
        (set! (. (. (deref st) hitting-phase) exhausted) (== top 0))
        (sorted-sets arena found))))

  (fn keep-candidate ((arena Arena) (out (Ptr (List Candidate))) (seen (Set String)) (removed (List Int))
                      (reason CandidateReason))
    (@spec ((Arena (Ptr (List Candidate)) (Set String) (List Int) CandidateReason) -> Unit))
    (@alloc arena)
    ;; SEEN holds the removal sets already in OUT; the first reason wins.
    (when (fresh arena seen removed) (list-push (deref out) (record-new Candidate (removed removed) (reason reason)))))

  (fn verify-candidate ((arena Arena) (st (Ptr SearchState)) (options SearchOptions) (removed (List Int))
                        (verified (Ptr (List MappingSet))) (candidates (Ptr (List Candidate)))
                        (seen (Set String)) (check (Fn ((List Int)) Checked)))
    (@spec ((Arena (Ptr SearchState) SearchOptions (List Int) (Ptr (List MappingSet)) (Ptr (List Candidate))
            (Set String) (Fn ((List Int)) Checked)) -> Unit))
    (@alloc arena)
    (match (ask arena st options 2 removed check)
      ((none) (keep-candidate arena candidates seen removed 'candidate-budget))
      ((some initial)
        (cond
          ((good initial)
            (let ((mut cur removed) (mut certain true) (mut reason 'candidate-unknown))
              (do
                (for-each (x removed)
                  (when (and certain (not (stopped st options)))
                    (let ((trial (remove-index arena cur x)))
                      (match (ask arena st options 2 trial check)
                        ((none) (do (set! certain false) (set! reason 'candidate-budget)))
                        ((some c)
                          (cond
                            ((good c) (set! cur trial))
                            ((and (. c complete) (bad c)) (do))
                            (else (do (set! certain false) (set! (. (. (deref st) verification-phase) unresolved) true)))))))))
                (if certain (keep-set verified cur) (keep-candidate arena candidates seen cur reason)))))
          ((bad initial) (do))
          (else (do (keep-candidate arena candidates seen removed 'candidate-unknown)
                    (set! (. (. (deref st) verification-phase) unresolved) true)))))))

  (fn sorted-omissions ((arena Arena) (xs (List Omission)))
    (@spec ((Arena (List Omission)) -> (List Omission)))
    (@alloc arena)
    (let ((mut out (list-new arena Omission)) (mut previous (Option Omission) (none)))
      (do
        (for-each (i (sort-range arena (list-len xs)
                      (fn ((a Int) (b Int))
                        (match (list-get xs a)
                          ((some x) (match (list-get xs b) ((some y) (omission-cmp x y)) ((none) 0)))
                          ((none) 0)))))
          (match (list-get xs i)
            ((none) (do))
            ((some x)
              (when (match previous ((none) true) ((some p) (!= (omission-cmp p x) 0)))
                (do (list-push out x) (set! previous (some x))))))) out)))

  (fn sorted-candidates ((arena Arena) (xs (List Candidate)) (verified (List MappingSet)))
    (@spec ((Arena (List Candidate) (List MappingSet)) -> (List Candidate)))
    (@alloc arena)
    (let ((mut out (list-new arena Candidate)))
      (do
        (for-each (i (sort-range arena (list-len xs)
                      (fn ((a Int) (b Int))
                        (match (list-get xs a)
                          ((some x) (match (list-get xs b) ((some y) (set-cmp (. x removed) (. y removed))) ((none) 0)))
                          ((none) 0)))))
          (match (list-get xs i)
            ((none) (do))
            ((some c) (when (not (known-set verified (. c removed))) (list-push out c))))) out)))

  (fn search ((arena Arena) (n Int) (initial Check) (options SearchOptions)
              (check (Fn ((List Int)) Checked)))
    (@spec ((Arena Int Check SearchOptions (Fn ((List Int)) Checked)) -> (Result SearchResult Fault)))
    (@pre {(n >= 0)})
    (@pre {(. options conflict-calls) >= 0})
    (@pre {(. options conflict-nodes) >= 0})
    (@pre {(. options hitting-nodes) >= 0})
    (@pre {(. options verification-calls) >= 0})
    (@alloc arena)
    (let ((all (indices arena n)) (empty (list-new arena Int))
          (st (cast (Ptr SearchState) (arena-alloc arena (sizeof SearchState))))
          (mut verified (list-new arena MappingSet)) (mut candidates (list-new arena Candidate))
          (candidate-keys (set-new arena String))
          (mut conflicts (list-new arena MappingSet)) (mut already false) (mut unrepairable false)
          (mut shortcut false))
      (do
        (set! (deref st) (record-new SearchState
          (cache (list-new arena Cached)) (omissions (list-new arena Omission)) (fault (none))
          (counts (record-new SearchCounts (preflight-calls 1) (conflict-calls 0) (conflict-nodes 0)
                    (hitting-nodes 0) (verification-calls 0) (cache-hits 0)))
          (conflict-phase (empty-phase)) (hitting-phase (empty-phase)) (verification-phase (empty-phase))))
        (list-push (. (deref st) cache) (record-new Cached (removed empty) (answer initial)))
        (for-each (o (. initial omissions)) (list-push (. (deref st) omissions) o))
        (if (good initial)
          (do (set! already true) (set! shortcut true))
          (match (ask arena st options 0 all check)
            ((none) (do))
            ((some background)
              (if (bad background)
                (do (set! unrepairable true) (set! shortcut true)
                    (when (not (. background complete)) (set! (. (. (deref st) conflict-phase) unresolved) true)))
                (do
                  (set! conflicts (enumerate-conflicts arena st options all check))
                  (let ((hits (enumerate-hits arena st options conflicts)))
                    (do
                      ;; The fallback owns the first verification opportunity.
                      (when (and (not (phase-complete (. (deref st) conflict-phase))) (good background))
                        (verify-candidate arena st options all (addr verified) (addr candidates) candidate-keys check))
                      (for-each (h hits)
                        (when (not (stopped st options))
                          (verify-candidate arena st options (. h items) (addr verified) (addr candidates) candidate-keys check)))
                      (set! (. (. (deref st) verification-phase) exhausted)
                        (and (not (. (. (deref st) verification-phase) capped))
                             (not (. (. (deref st) verification-phase) unresolved)))))))))))
        (when shortcut
          (do (set! (. (. (deref st) conflict-phase) exhausted) true)
              (set! (. (. (deref st) hitting-phase) exhausted) true)
              (set! (. (. (deref st) verification-phase) exhausted) true)))
        (stopped st options)
        (match (. (deref st) fault)
          ((some f) (error f))
          ((none)
            (ok (record-new SearchResult
              (verified (sorted-sets arena verified)) (candidates (sorted-candidates arena candidates verified))
              (conflicts conflicts) (conflict-phase (. (deref st) conflict-phase))
              (hitting-phase (. (deref st) hitting-phase)) (verification-phase (. (deref st) verification-phase))
              (omissions (sorted-omissions arena (. (deref st) omissions))) (counts (. (deref st) counts))
              (already-coherent already) (unrepairable unrepairable)
              (complete (and (phase-complete (. (deref st) conflict-phase))
                             (phase-complete (. (deref st) hitting-phase))
                             (phase-complete (. (deref st) verification-phase))
                             (== (list-len (. (deref st) omissions)) 0))))))))))
)
