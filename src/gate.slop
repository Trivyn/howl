;; ============================================================
;; Front end stage 1b–2: sugar expansion and the profile gate
;;                                                    SPEC.md §5.2, §6.3
;;
;; SUGAR IS EXPANDED BEFORE THE GATES RUN, because both RBox gates read
;; the TOLD ROLE HIERARCHY and two sugar forms contribute to it:
;; `TransitiveObjectProperty(r)` is `r ∘ r ⊑ r`, a chain the regularity
;; gate must see, and `EquivalentObjectProperties` is a set of role
;; inclusions the range condition reaches through. Gate first and both
;; gates answer questions about an RBox that is missing axioms the
;; document states.
;;
;; THE STAR IS BUILT AROUND THE CANONICALLY LEAST OPERAND, not around
;; the first one written. `EquivalentClasses(A B C)` becomes 2(n−1)
;; inclusions through one hub, and which operand is the hub decides
;; which inclusions exist. Picking the first-written hub makes the
;; normal form — and therefore fresh-node ids, saturation size, and a
;; capped run's report — a function of serialization order, which §6.8
;; forbids. `concept-cmp` decides it instead.
;;
;; A STAR, NOT ALL PAIRS. n(n−1) inclusions would also be correct and
;; is what the naive reading gives; the star is 2(n−1) and entails the
;; same closure through transitivity of ⊑. On an ontology with large
;; equivalence classes that is the difference between linear and
;; quadratic blowup before saturation even starts.
;;
;; TWO CONDITIONS, NOT ONE. §5.2's table classifies axiom FORMS;
;; ELH⊥R+ also restricts the OPERANDS those forms carry. An axiom is
;; accepted only if `disposition` says d-in-profile AND
;; `axiom-in-profile` says its concepts and roles are in the fragment.
;; Checking the form alone accepts `SubClassOf(A, ObjectUnionOf(B,C))`.
;; ============================================================

(module gate
  (@doc "Sugar expansion and the §5.2 three-category gate (M0)")

  (import rdf (IRI))
  (import vocab (OWL_TOP_OBJECT_PROPERTY OWL_BOTTOM_OBJECT_PROPERTY))
  (import types (Omission Fault InputRef AxiomRef Node RoleId EntityKind
                 MissingDeclaration Profile))
  (import owl2 (RawAxiom RawConcept RawChain Signature RawDisjointUnion
                disposition axiom-in-profile is-el-plus-plus is-sriq
                concept-in-profile concepts-in-profile role-in-profile
                concept-cmp sort-concepts concept-at
                render-axiom render-role
                signature-has-class signature-has-object-property))
  (import canon (role-cmp sort-omissions sort-range iri-cmp sort-axiom-refs string-cmp str-at))
  (import owl2 (render-axiom))

  (export
    GateResult RboxVerdict
    axiom-input-ref
    expand-sugar expand-negation drop-top-role-tautologies
    non-simple-roles self-roles-simple
    gate-axioms
    collect-rbox-roles role-idx
    told-closure check-regularity
    RangeEntry collect-ranges chain-range-ok
    EntityRef collect-entity-refs missing-declarations)

  (type GateResult (record
    (accepted  (List RawAxiom))    ; in profile, sugar already expanded, canonically sorted
    (omissions (List Omission))    ; canonically sorted
    (signature Signature)))

  (fn axiom-input-ref ((arena Arena) (ax RawAxiom))
    (@intent "The canonical identity of an axiom, for an omission")
    (@spec ((Arena RawAxiom) -> InputRef))
    (@alloc arena)
    ;; `source` is none here: the decoder receives one flat triple list
    ;; and never sees document boundaries (§8.5 A1). The CLI populates
    ;; it when it knows which file an axiom came from; through the
    ;; frozen port the identity degrades to canonical text alone.
    (let ((no-source (Option IRI) (none)))
      (union-new InputRef owl-axiom
        (record-new AxiomRef
          (source no-source)
          (text   (render-axiom arena ax))))))

  (fn least-role ((rs (List RoleId)))
    (@intent "The canonically least role — the hub of an equivalence star")
    (@spec (((List RoleId)) -> (Option RoleId)))
    (@pure)
    (let ((mut best (Option RoleId) (none)))
      (do
        (for-each (r rs)
          (match best
            ((none)   (set! best (some r)))
            ((some b) (when (< (role-cmp r b) 0) (set! best (some r))))))
        best)))

  (fn expand-sugar ((arena Arena) (axs (List RawAxiom)))
    (@intent "Rewrite the four sugar forms the RBox gates depend on")
    (@spec ((Arena (List RawAxiom)) -> (List RawAxiom)))
    (@alloc arena)
    ;; Everything is pushed into ONE local list rather than through
    ;; helper functions that append. A `(List T)` is a value struct and
    ;; `list-push` reallocates, so a helper that pushed into a passed-in
    ;; list would grow its own copy and lose it on return — the hazard
    ;; canon.slop's merge documents from the other side, where
    ;; `list-set` is safe precisely because it never reallocates.
    (let ((mut out (list-new arena RawAxiom)))
      (do
        (for-each (ax axs)
          (match ax
            ;; TransitiveObjectProperty(r)  ⇒  r ∘ r ⊑ r
            ((ra-transitive-property r)
              (let ((mut steps (list-new arena RoleId)))
                (do
                  (list-push steps r)
                  (list-push steps r)
                  (list-push out (union-new RawAxiom ra-property-chain
                                   (record-new RawChain (steps steps) (super r)))))))

            ;; EquivalentObjectProperties(r₀ … rₙ) ⇒ a star through the least.
            ;; One naming an ObjectInverseOf is kept whole: no rung built so
            ;; far admits it, so it is omitted as written, one axiom. Its
            ;; star could split it in pieces, or, when its members coincide,
            ;; into nothing at all.
            ((ra-equivalent-properties rs)
              (if (roles-have-inverse rs)
                (list-push out ax)
                (match (least-role rs)
                  ((none) (do))
                  ((some hub)
                    (for-each (r rs)
                      (when (!= (role-cmp r hub) 0)
                        (do
                          (list-push out (union-new RawAxiom ra-sub-object-property hub r))
                          (list-push out (union-new RawAxiom ra-sub-object-property r hub)))))))))

            ;; EquivalentClasses(C₀ … Cₙ) ⇒ a star through the least
            ((ra-equivalent-classes cs)
              (let ((sorted (sort-concepts arena cs))
                    (n (cast Int (list-len cs))))
                (when (> n 0)
                  (let ((hub (concept-at sorted 0))
                        (mut i 1))
                    (while (< i n)
                      (let ((c (concept-at sorted i)))
                        (do
                          (list-push out (union-new RawAxiom ra-sub-class-of
                                           (box-c arena hub) (box-c arena c)))
                          (list-push out (union-new RawAxiom ra-sub-class-of
                                           (box-c arena c) (box-c arena hub)))
                          (set! i (+ i 1)))))))))

            ;; DisjointClasses(C₁ … Cₙ) ⇒ every pair i<j, canonically ordered
            ((ra-disjoint-classes cs)
              (let ((n (cast Int (list-len cs))))
                (if (<= n 2)
                  (list-push out ax)
                  ;; n(n−1)/2 pairs — 3 classes give 3 pairs, not 6 and
                  ;; not 1. Sorting first is what makes the pair list a
                  ;; function of content rather than of write order.
                  (let ((sorted (sort-concepts arena cs))
                        (mut i 0))
                    (while (< i n)
                      (let ((mut j (+ i 1)))
                        (do
                          (while (< j n)
                            (let ((mut pair (list-new arena RawConcept)))
                              (do
                                (list-push pair (concept-at sorted i))
                                (list-push pair (concept-at sorted j))
                                (list-push out (union-new RawAxiom ra-disjoint-classes pair))
                                (set! j (+ j 1)))))
                          (set! i (+ i 1)))))))))

            (_ (list-push out ax))))
        out)))

  ;; ============================================================
  ;; Negation in positive positions (§5.2; SPEC §5.3 L0)
  ;;
  ;; ¬E as the whole filler, or a top-level conjunct, of a superclass,
  ;; domain or range says only that something is EMPTY, and emptiness
  ;; is ⊥ on the right of an EL GCI:
  ;;
  ;;   C ⊑ P ⊓ ¬E       ⇒  C ⊑ P,       C ⊓ E ⊑ ⊥
  ;;   dom(r) ⊑ P ⊓ ¬E  ⇒  dom(r) ⊑ P,  ∃r.⊤ ⊓ E ⊑ ⊥
  ;;   ran(r) ⊑ P ⊓ ¬E  ⇒  ran(r) ⊑ P,  ∃r.E ⊑ ⊥
  ;;
  ;; No fresh names, so the rewritten theory has the SAME models (L0),
  ;; not merely a conservative extension — nothing downstream can tell
  ;; which one it was handed.
  ;;
  ;; IT RUNS BEFORE EVERY GATE CONDITION, and that placement is the
  ;; point. The range/composition condition must judge the rewritten
  ;; theory, where a negative range is a GCI that range elimination
  ;; never touches and so demands nothing of a chain's last role.
  ;; Rewritten after the gate, `ran(t) = A ⊓ ¬B` would still impose
  ;; `A ⊓ ¬B` on every chain into t.
  ;;
  ;; WHOLE AXIOMS OR NOTHING. An axiom is rewritten only when every
  ;; piece lands in the fragment; otherwise it passes through and is
  ;; omitted as written, so an omission always shows the user's own
  ;; axiom rather than a fragment of it.
  ;; ============================================================

  (type NegSplit (record
    (pos (List RawConcept))     ; P's conjuncts, in written order
    (neg (List RawConcept))))   ; the E of each ¬E conjunct

  (fn has-negated-conjunct ((c RawConcept))
    (@intent "Is ¬E the whole concept or one of its top-level conjuncts?")
    (@spec ((RawConcept) -> Bool))
    (@pure)
    ;; The cheap test that keeps every other axiom allocation-free: GO
    ;; has ~70,000 subclass axioms and none of them is negated.
    (match c
      ((rc-not _)  true)
      ((rc-and cs)
        (let ((mut found false))
          (do
            (for-each (x cs)
              (match x
                ((rc-not _) (set! found true))
                (_          (do))))
            found)))
      (_ false)))

  (fn conjuncts ((arena Arena) (c RawConcept))
    (@intent "A fresh list of c's top-level conjuncts: c itself unless it is a conjunction")
    (@spec ((Arena RawConcept) -> (List RawConcept)))
    (@alloc arena)
    ;; Always a COPY. Callers push onto the result, and pushing onto an
    ;; rc-and's own list would write into the axiom it came from.
    (let ((mut out (list-new arena RawConcept)))
      (do
        (match c
          ((rc-and cs) (for-each (x cs) (list-push out x)))
          (_           (list-push out c)))
        out)))

  (fn negation-split ((arena Arena) (c RawConcept))
    (@intent "Split a positive-position concept into P's conjuncts and the negated operands")
    (@spec ((Arena RawConcept) -> NegSplit))
    (@alloc arena)
    (let ((mut pos (list-new arena RawConcept))
          (mut neg (list-new arena RawConcept)))
      (do
        (for-each (x (conjuncts arena c))
          (match x
            ((rc-not e) (list-push neg (deref e)))
            (_          (list-push pos x))))
        (record-new NegSplit (pos pos) (neg neg)))))

  (fn split-rewritable ((p Profile) (s NegSplit))
    (@intent "Is there a negation, with every piece inside the rung's language?")
    (@spec ((Profile NegSplit) -> Bool))
    (@pure)
    (and (> (list-len (. s neg)) 0)
         (concepts-in-profile p (. s pos))
         (concepts-in-profile p (. s neg))))

  (fn conjunction ((cs (List RawConcept)))
    (@intent "The conjunction of a non-empty list: its one member, or an rc-and")
    (@spec (((List RawConcept)) -> RawConcept))
    (@pure)
    (@pre {(list-len cs) > 0})
    (if (== (list-len cs) 1)
      (concept-at cs 0)
      (union-new RawConcept rc-and cs)))

  (fn with-conjunct ((arena Arena) (c RawConcept) (e RawConcept))
    (@intent "c ⊓ e, with c's own conjuncts spliced in rather than nested")
    (@spec ((Arena RawConcept RawConcept) -> RawConcept))
    (@alloc arena)
    (let ((mut cs (conjuncts arena c)))
      (do
        (list-push cs e)
        (union-new RawConcept rc-and cs))))

  (fn empty-axiom ((arena Arena) (c RawConcept))
    (@intent "c ⊑ ⊥")
    (@spec ((Arena RawConcept) -> RawAxiom))
    (@alloc arena)
    (union-new RawAxiom ra-sub-class-of
      (box-c arena c) (box-c arena (union-new RawConcept rc-nothing))))

  (fn expand-negation ((arena Arena) (p Profile) (axs (List RawAxiom)))
    (@intent "Rewrite ¬E in a superclass, domain or range into ⊥ GCIs (§5.2)")
    (@spec ((Arena Profile (List RawAxiom)) -> (List RawAxiom)))
    (@alloc arena)
    ;; One local list, as in expand-sugar and for its reason.
    (let ((mut out (list-new arena RawAxiom)))
      (do
        (for-each (ax axs)
          (match ax
            ;; C ⊑ P ⊓ ¬E  ⇒  C ⊑ P,  C ⊓ E ⊑ ⊥
            ((ra-sub-class-of l r)
              (if (not (has-negated-conjunct (deref r)))
                (list-push out ax)
                (let ((s (negation-split arena (deref r))))
                  (if (not (and (concept-in-profile p (deref l)) (split-rewritable p s)))
                    (list-push out ax)
                    (do
                      (when (> (list-len (. s pos)) 0)
                        (list-push out (union-new RawAxiom ra-sub-class-of
                                         l (box-c arena (conjunction (. s pos))))))
                      (for-each (e (. s neg))
                        (list-push out (empty-axiom arena
                                         (with-conjunct arena (deref l) e)))))))))

            ;; dom(r) ⊑ P ⊓ ¬E  ⇒  dom(r) ⊑ P,  ∃r.⊤ ⊓ E ⊑ ⊥
            ((ra-object-property-domain r c)
              (if (not (has-negated-conjunct (deref c)))
                (list-push out ax)
                (let ((s (negation-split arena (deref c))))
                  (if (not (and (role-in-profile p r) (split-rewritable p s)))
                    (list-push out ax)
                    (let ((some-r (union-new RawConcept rc-some r
                                    (box-c arena (union-new RawConcept rc-thing)))))
                      (do
                        (when (> (list-len (. s pos)) 0)
                          (list-push out (union-new RawAxiom ra-object-property-domain
                                           r (box-c arena (conjunction (. s pos))))))
                        (for-each (e (. s neg))
                          (list-push out (empty-axiom arena
                                           (with-conjunct arena some-r e))))))))))

            ;; ran(r) ⊑ P ⊓ ¬E  ⇒  ran(r) ⊑ P,  ∃r.E ⊑ ⊥
            ((ra-object-property-range r c)
              (if (not (has-negated-conjunct (deref c)))
                (list-push out ax)
                (let ((s (negation-split arena (deref c))))
                  (if (not (and (role-in-profile p r) (split-rewritable p s)))
                    (list-push out ax)
                    (do
                      (when (> (list-len (. s pos)) 0)
                        (list-push out (union-new RawAxiom ra-object-property-range
                                         r (box-c arena (conjunction (. s pos))))))
                      (for-each (e (. s neg))
                        (list-push out (empty-axiom arena
                                         (union-new RawConcept rc-some r (box-c arena e))))))))))

            (_ (list-push out ax))))
        out)))

  ;; ============================================================
  ;; el++'s whole-RBox conditions (§5.4)
  ;; ============================================================

  (fn is-top-role ((r RoleId))
    (@intent "Is this owl:topObjectProperty?")
    (@spec ((RoleId) -> Bool))
    (@pure)
    (match r
      ((named-role i)   (== (string-cmp (. i value) OWL_TOP_OBJECT_PROPERTY) 0))
      ((fresh-role _)   false)
      ((inverse-role _) false)))

  (fn is-inverse-role ((r RoleId))
    (@intent "Is this an ObjectInverseOf?")
    (@spec ((RoleId) -> Bool))
    (@pure)
    (match r
      ((inverse-role _) true)
      ((named-role _)   false)
      ((fresh-role _)   false)))

  (fn roles-have-inverse ((rs (List RoleId)))
    (@intent "Does any role in this list invert a property?")
    (@spec (((List RoleId)) -> Bool))
    (@pure)
    (let ((mut found false))
      (do
        (for-each (r rs)
          (when (is-inverse-role r) (set! found true)))
        found)))

  (fn axiom-has-inverse ((ax RawAxiom))
    (@intent "Does this RBox, domain or range axiom name an ObjectInverseOf?")
    (@spec ((RawAxiom) -> Bool))
    (@pure)
    (match ax
      ((ra-sub-object-property a b)    (or (is-inverse-role a) (is-inverse-role b)))
      ((ra-property-chain ch)          (or (roles-have-inverse (. ch steps))
                                           (is-inverse-role (. ch super))))
      ((ra-equivalent-properties rs)   (roles-have-inverse rs))
      ((ra-transitive-property r)      (is-inverse-role r))
      ((ra-object-property-domain r _) (is-inverse-role r))
      ((ra-object-property-range r _)  (is-inverse-role r))
      (_ false)))

  (fn named-roles-only ((arena Arena) (axs (List RawAxiom)))
    (@intent "The axioms naming no ObjectInverseOf: what el's and el++'s RBox conditions read")
    (@spec ((Arena (List RawAxiom)) -> (List RawAxiom)))
    (@alloc arena)
    ;; An axiom with an inverse is out of profile in every rung built so
    ;; far, and the per-axiom check omits it. Its roles must not reach the
    ;; collective RBox conditions either. Before inverses were
    ;; represented, such an axiom was an opaque fragment those conditions
    ;; never saw; letting RO's ten inverse-step chains into §11.2's check
    ;; now would change el's answer on RBoxes it has already judged.
    (let ((mut out (list-new arena RawAxiom)))
      (do
        (for-each (ax axs)
          (when (not (axiom-has-inverse ax)) (list-push out ax)))
        out)))

  (fn into-top-role ((ax RawAxiom))
    (@intent "Is this an inclusion whose super-role is owl:topObjectProperty?")
    (@spec ((RawAxiom) -> Bool))
    (@pure)
    (match ax
      ((ra-sub-object-property _ sup) (is-top-role sup))
      ((ra-property-chain ch)         (is-top-role (. ch super)))
      (_ false)))

  (fn drop-top-role-tautologies ((arena Arena) (p Profile) (axs (List RawAxiom)))
    (@intent "Under el++, drop inclusions into the universal role: they hold in every interpretation")
    (@spec ((Arena Profile (List RawAxiom)) -> (List RawAxiom)))
    (@alloc arena)
    ;; §5.4 K0: the Direct Semantics fixes U to Δ × Δ, so `R ⊑ U` and
    ;; every chain into U are tautologies, and dropping them removes
    ;; nothing. They are neither accepted nor omitted: a tautology is not
    ;; a gap. Every other use of U stays out of profile (role-in-profile).
    ;; Under every other rung nothing is dropped, so `el` is unchanged.
    ;; sriq drops them too (§5.5's table), an inverse sub-role included.
    (if (not (or (is-el-plus-plus p) (is-sriq p)))
      axs
      (let ((mut out (list-new arena RawAxiom)))
        (do
          ;; Under el++, only an inclusion of el++'s own roles: one naming
          ;; an ObjectInverseOf is outside its language, and is omitted as
          ;; written rather than dropped.
          (for-each (ax axs)
            (when (not (and (into-top-role ax)
                            (or (is-sriq p) (not (axiom-has-inverse ax)))))
              (list-push out ax)))
          out))))

  (fn role-listed ((rs (List RoleId)) (r RoleId))
    (@intent "Is r in this list?")
    (@spec (((List RoleId) RoleId) -> Bool))
    (@pure)
    (let ((mut found false))
      (do
        (for-each (x rs) (when (== (role-cmp x r) 0) (set! found true)))
        found)))

  (fn non-simple-roles ((arena Arena) (axs (List RawAxiom)))
    (@intent "The roles OWL 2 §11.1 calls non-simple, over the expanded RBox")
    (@spec ((Arena (List RawAxiom)) -> (List RoleId)))
    (@alloc arena)
    ;; A role is COMPOSITE if it is the super-role of a chain — which
    ;; includes transitivity, already expanded to `r ∘ r ⊑ r` — and
    ;; NON-SIMPLE if it is composite or has a non-simple sub-role. The
    ;; built-in roles count as composite (§11.1); owl:bottomObjectProperty
    ;; is the one that reaches here. Closed upward through the told
    ;; inclusions, equivalences included (expand-sugar made them pairs),
    ;; to a fixpoint: one pass per added role at most.
    (let ((mut out (list-new arena RoleId))
          (mut changed true))
      (do
        (list-push out (union-new RoleId named-role
                         (record-new IRI (value OWL_BOTTOM_OBJECT_PROPERTY))))
        (for-each (ax axs)
          (match ax
            ((ra-property-chain ch)
              (when (not (role-listed out (. ch super))) (list-push out (. ch super))))
            (_ (do))))
        (while changed
          (do
            (set! changed false)
            (for-each (ax axs)
              (match ax
                ((ra-sub-object-property a b)
                  (when (and (role-listed out a) (not (role-listed out b)))
                    (do (list-push out b) (set! changed true))))
                (_ (do))))))
        out)))

  (fn concept-self-roles-simple ((nonsimple (List RoleId)) (c RawConcept))
    (@intent "Is every ∃R.Self inside this concept on a simple role?")
    (@spec (((List RoleId) RawConcept) -> Bool))
    (@pure)
    (match c
      ((rc-has-self r) (not (role-listed nonsimple r)))
      ((rc-and cs)
        (let ((mut ok true))
          (do
            (for-each (x cs) (when (not (concept-self-roles-simple nonsimple x)) (set! ok false)))
            ok)))
      ((rc-some _ f)   (concept-self-roles-simple nonsimple (deref f)))
      (_ true)))

  (fn self-roles-simple ((nonsimple (List RoleId)) (ax RawAxiom))
    (@intent "Is every ObjectHasSelf this axiom uses on a simple role?")
    (@spec (((List RoleId) RawAxiom) -> Bool))
    (@pure)
    ;; Only the class-expression positions can hold Self. An empty
    ;; `nonsimple` list — every rung but el++ — makes this true, which is
    ;; right: Self is out of profile there by `concept-in-profile`.
    (match ax
      ((ra-sub-class-of l r)
        (and (concept-self-roles-simple nonsimple (deref l))
             (concept-self-roles-simple nonsimple (deref r))))
      ((ra-disjoint-classes cs)
        (let ((mut ok true))
          (do
            (for-each (x cs) (when (not (concept-self-roles-simple nonsimple x)) (set! ok false)))
            ok)))
      ((ra-object-property-domain _ c) (concept-self-roles-simple nonsimple (deref c)))
      ((ra-object-property-range _ c)  (concept-self-roles-simple nonsimple (deref c)))
      ((ra-class-assertion ca)         (concept-self-roles-simple nonsimple (deref (. ca concept))))
      (_ true)))

  (fn box-c ((arena Arena) (c RawConcept))
    (@intent "Heap-box a concept for a union variant that carries a pointer")
    (@spec ((Arena RawConcept) -> (Ptr RawConcept)))
    (@alloc arena)
    (let ((p (cast (Ptr RawConcept) (arena-alloc arena (sizeof RawConcept)))))
      (do (set! (deref p) c) p)))

  ;; ============================================================
  ;; sriq's RBox gate (§5.5): simple roles over AllOPE, the collapse of
  ;; role-equivalence classes, and [Sim12]'s ≺-regularity
  ;;
  ;; Roles are NODES. Property k, in canonical IRI order, is node 2k and
  ;; its inverse node 2k + 1, so `inv` flips one bit and every relation
  ;; built below is closed under inv by construction, as §5.5 requires.
  ;; Indices come from the canonically sorted property list (Lesson
  ;; 68d3eeb0), so the answer cannot depend on serialization.
  ;;
  ;; Graphs are adjacency arrays (CSR) walked breadth-first: a closure
  ;; matrix, as el's check uses, is cubic in 2 × RO's 650 properties.
  ;; ============================================================

  (type Ria (record
    (word  (List Int))   ; the sub-role word, as nodes
    (super Int)))        ; the super-role, as a node

  (type Csr (record
    (off (List Int))     ; node v's targets are adj[off[v] .. off[v+1])
    (adj (List Int))))

  (type SriqRbox (record
    (props     (List RoleId))   ; the named properties, canonically sorted
    (nonsimple (List Bool))     ; per node
    (regular   Bool)))

  (fn ints-new ((arena Arena) (n Int) (v Int))
    (@intent "An n-long list of v")
    (@spec ((Arena Int Int) -> (List Int)))
    (@alloc arena)
    (let ((mut xs (list-new arena Int))
          (mut i 0))
      (do
        (while (< i n) (do (list-push xs v) (set! i (+ i 1))))
        xs)))

  (fn int-at ((xs (List Int)) (i Int))
    (@intent "Element i, or -1 past the end")
    (@spec (((List Int) Int) -> Int))
    (@pure)
    (match (list-get xs i)
      ((some v) v)
      ((none)   -1)))

  (fn inv-node ((n Int))
    (@intent "The node of a role's inverse")
    (@spec ((Int) -> Int))
    (@pure)
    (@pre {n >= 0})
    (@post {$result >= 0})
    (if (== (% n 2) 0) (+ n 1) (- n 1)))

  (fn sriq-node ((props (List RoleId)) (r RoleId))
    (@intent "A role's node, or -1 when it names no property of the RBox")
    (@spec (((List RoleId) RoleId) -> Int))
    (@pure)
    (match r
      ((named-role _)
        (let ((k (role-idx props r))) (if (< k 0) -1 (* 2 k))))
      ((inverse-role i)
        (let ((k (role-idx props (union-new RoleId named-role i))))
          (if (< k 0) -1 (+ (* 2 k) 1))))
      ((fresh-role _) -1)))

  (fn property-of ((r RoleId))
    (@intent "The named property a role is or inverts")
    (@spec ((RoleId) -> (Option RoleId)))
    (@pure)
    (match r
      ((named-role _)   (some r))
      ((inverse-role i) (some (union-new RoleId named-role i)))
      ((fresh-role _)   (none))))

  (fn ria-roles ((arena Arena) (ax RawAxiom))
    (@intent "The roles of an axiom that is a role inclusion in §5.5's S0, or empty")
    (@spec ((Arena RawAxiom) -> (List RoleId)))
    (@alloc arena)
    (let ((mut rs (list-new arena RoleId)))
      (do
        (match ax
          ((ra-sub-object-property a b)    (do (list-push rs a) (list-push rs b)))
          ((ra-property-chain ch)
            (do (for-each (st (. ch steps)) (list-push rs st)) (list-push rs (. ch super))))
          ((ra-equivalent-properties xs)   (for-each (x xs) (list-push rs x)))
          ((ra-inverse-properties a b)     (do (list-push rs a) (list-push rs b)))
          ((ra-property-characteristic c r)
            (when (== c 'prop-symmetric) (list-push rs r)))
          (_ (do)))
        rs)))

  (fn is-sriq-ria ((ax RawAxiom))
    (@intent "Is this axiom a role inclusion in §5.5's S0, so part of the RBox the gate judges?")
    (@spec ((RawAxiom) -> Bool))
    (@pure)
    ;; SubObjectPropertyOf with or without a chain (transitivity is one by
    ;; now, expand-sugar), equivalences, inverses, and symmetry (`R⁻ ⊑ R`).
    (match ax
      ((ra-sub-object-property _ _)    true)
      ((ra-property-chain _)           true)
      ((ra-equivalent-properties _)    true)
      ((ra-inverse-properties _ _)     true)
      ((ra-property-characteristic c _) (== c 'prop-symmetric))
      (_ false)))

  (fn admitted ((arena Arena) (p Profile) (axs (List RawAxiom)))
    (@intent "The axioms the rung admits one by one: the theory its RBox conditions judge")
    (@spec ((Arena Profile (List RawAxiom)) -> (List RawAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena RawAxiom)))
      (do
        (for-each (ax axs)
          (when (axiom-in-profile p ax) (list-push out ax)))
        out)))

  (fn sriq-props ((arena Arena) (axs (List RawAxiom)))
    (@intent "Every property a role inclusion names, canonically sorted")
    (@spec ((Arena (List RawAxiom)) -> (List RoleId)))
    (@alloc arena)
    (let ((mut ps (list-new arena RoleId)))
      (do
        (for-each (ax axs)
          (for-each (r (ria-roles arena ax))
            (match (property-of r)
              ((some pr) (when (push-role-unique ps pr) (list-push ps pr)))
              ((none)    (do)))))
        (sort-roles arena ps))))

  (fn ria-of ((arena Arena) (x Int) (y Int))
    (@intent "The one-step inclusion x ⊑ y")
    (@spec ((Arena Int Int) -> Ria))
    (@alloc arena)
    (let ((mut w (list-new arena Int)))
      (do (list-push w x) (record-new Ria (word w) (super y)))))

  (fn sriq-rias ((arena Arena) (props (List RoleId)) (axs (List RawAxiom)))
    (@intent "§5.5 S0's role inclusions, as node words")
    (@spec ((Arena (List RoleId) (List RawAxiom)) -> (List Ria)))
    (@alloc arena)
    ;; R ≡ S⁻ is `R ⊑ S⁻` and `S⁻ ⊑ R`; symmetry is `R⁻ ⊑ R`; an
    ;; equivalence (one with an inverse arrives whole) is every ordered
    ;; pair. One local list, for expand-sugar's reason.
    (let ((mut out (list-new arena Ria)))
      (do
        (for-each (ax axs)
          (match ax
            ((ra-sub-object-property a b)
              (let ((na (sriq-node props a)) (nb (sriq-node props b)))
                (when (and (>= na 0) (>= nb 0)) (list-push out (ria-of arena na nb)))))
            ((ra-property-chain ch)
              (let ((ns  (sriq-nodes arena props (. ch steps)))
                    (sup (sriq-node props (. ch super))))
                (when (and (>= sup 0) (all-nodes ns))
                  (list-push out (record-new Ria (word ns) (super sup))))))
            ((ra-equivalent-properties rs)
              (let ((ns (sriq-nodes arena props rs)))
                (when (all-nodes ns)
                  (for-each (x ns)
                    (for-each (y ns)
                      (when (!= x y) (list-push out (ria-of arena x y))))))))
            ((ra-inverse-properties a b)
              (let ((na (sriq-node props a)) (nb (sriq-node props b)))
                (when (and (>= na 0) (>= nb 0))
                  (do (list-push out (ria-of arena na (inv-node nb)))
                      (list-push out (ria-of arena (inv-node nb) na))))))
            ((ra-property-characteristic c r)
              (when (== c 'prop-symmetric)
                (let ((nr (sriq-node props r)))
                  (when (>= nr 0) (list-push out (ria-of arena (inv-node nr) nr))))))
            (_ (do))))
        out)))

  (fn sriq-nodes ((arena Arena) (props (List RoleId)) (rs (List RoleId)))
    (@intent "Each role's node, in order")
    (@spec ((Arena (List RoleId) (List RoleId)) -> (List Int)))
    (@alloc arena)
    (let ((mut ns (list-new arena Int)))
      (do (for-each (r rs) (list-push ns (sriq-node props r))) ns)))

  (fn all-nodes ((ns (List Int)))
    (@intent "Does every role in the word have a node?")
    (@spec (((List Int)) -> Bool))
    (@pure)
    (let ((mut ok true))
      (do (for-each (n ns) (when (< n 0) (set! ok false))) ok)))

  (fn csr-build ((arena Arena) (n Int) (src (List Int)) (dst (List Int)))
    (@intent "The adjacency arrays of the edges src[k] → dst[k] over n nodes")
    (@spec ((Arena Int (List Int) (List Int)) -> Csr))
    (@alloc arena)
    ;; A counting sort by source. `list-set` writes through, `list-push`
    ;; into a parameter would not (expand-sugar's note).
    (let ((off (ints-new arena (+ n 1) 0))
          (m   (cast Int (list-len src)))
          (mut i 0))
      (do
        (for-each (s src) (list-set off (+ s 1) (+ (int-at off (+ s 1)) 1)))
        (set! i 1)
        (while (<= i n)
          (do (list-set off i (+ (int-at off i) (int-at off (- i 1))))
              (set! i (+ i 1))))
        (let ((pos (ints-new arena n 0))
              (adj (ints-new arena m 0))
              (mut k 0)
              (mut v 0))
          (do
            (while (< v n) (do (list-set pos v (int-at off v)) (set! v (+ v 1))))
            (while (< k m)
              (let ((s (int-at src k)))
                (do (list-set adj (int-at pos s) (int-at dst k))
                    (list-set pos s (+ (int-at pos s) 1))
                    (set! k (+ k 1)))))
            (record-new Csr (off off) (adj adj)))))))

  (fn csr-reach ((arena Arena) (g Csr) (n Int) (starts (List Int)))
    (@intent "Every node reachable from the starts, starts included")
    (@spec ((Arena Csr Int (List Int)) -> (List Bool)))
    (@alloc arena)
    (let ((seen (mat-new arena n))
          (mut queue (list-new arena Int))
          (mut head 0))
      (do
        (for-each (s starts)
          (when (and (>= s 0) (not (mat-get seen s)))
            (do (list-set seen s true) (list-push queue s))))
        (while (< head (cast Int (list-len queue)))
          (let ((v (int-at queue head)))
            (do
              (set! head (+ head 1))
              (let ((mut e (int-at (. g off) v))
                    (stop (int-at (. g off) (+ v 1))))
                (while (< e stop)
                  (let ((w (int-at (. g adj) e)))
                    (do
                      (when (not (mat-get seen w))
                        (do (list-set seen w true) (list-push queue w)))
                      (set! e (+ e 1)))))))))
        seen)))

  (fn sriq-reps ((arena Arena) (fwd Csr) (bwd Csr) (n Int))
    (@intent "Each node's representative: §5.5's collapse of →'s strongly connected components")
    (@spec ((Arena Csr Csr Int) -> (List Int)))
    (@alloc arena)
    ;; A component is what a node reaches and is reached from. Its
    ;; representative is its least property, oriented as it occurs: the
    ;; property's own node if the component holds it, else its inverse's.
    ;; So the inverse component's representative is the inverse, and a
    ;; component holding P and P⁻ is represented by P.
    (let ((rep (ints-new arena n -1))
          (mut v 0))
      (do
        (while (< v n)
          (do
            (when (< (int-at rep v) 0)
              (let ((mut one (list-new arena Int)))
                (do
                  (list-push one v)
                  (let ((f (csr-reach arena fwd n one))
                        (b (csr-reach arena bwd n one))
                        (mut m -1)
                        (mut u 0)
                        (mut x 0))
                    (do
                      (while (< u n)
                        (do
                          (when (and (mat-get f u) (mat-get b u)
                                     (or (< m 0) (< (/ u 2) m)))
                            (set! m (/ u 2)))
                          (set! u (+ u 1))))
                      (let ((r (if (and (mat-get f (* 2 m)) (mat-get b (* 2 m)))
                                 (* 2 m)
                                 (+ (* 2 m) 1))))
                        (while (< x n)
                          (do
                            (when (and (mat-get f x) (mat-get b x)) (list-set rep x r))
                            (set! x (+ x 1))))))))))
            (set! v (+ v 1))))
        rep)))

  (fn word-slice ((arena Arena) (w (List Int)) (from Int) (upto Int))
    (@intent "w[from .. upto)")
    (@spec ((Arena (List Int) Int Int) -> (List Int)))
    (@alloc arena)
    (let ((mut out (list-new arena Int))
          (mut i from))
      (do
        (while (< i upto) (do (list-push out (int-at w i)) (set! i (+ i 1))))
        out)))

  (fn ints-subset ((a (List Int)) (b (List Int)))
    (@intent "Is every element of a in b?")
    (@spec (((List Int) (List Int)) -> Bool))
    (@pure)
    (let ((mut ok true))
      (do
        (for-each (x a)
          (let ((mut found false))
            (do
              (for-each (y b) (when (== x y) (set! found true)))
              (when (not found) (set! ok false)))))
        ok)))

  (fn ria-constraints ((arena Arena) (w (List Int)) (s Int))
    (@intent "The roles R_i ≺ S a complex RIA w ⊑ S demands: the ⊆-least set among the forms it matches")
    (@spec ((Arena (List Int) Int) -> (List Int)))
    (@alloc arena)
    ;; [Sim12] §2.1's forms over R^c, after the collapse (§5.5):
    ;; (R4) R ∘ R ⊑ R and (R5) R⁻ ⊑ R demand nothing, nor does `R ⊑ R`,
    ;; which the collapse leaves of an inclusion inside one component.
    ;; (R5) cannot actually arrive here: R⁻ ⊑ R puts R and R⁻ in one
    ;; component, as → is closed under inv, so the collapse has already
    ;; made it `R ⊑ R`. It is kept because §5.5 states it.
    ;; In (R1)–(R3) every position but a recursive end, the R that opens
    ;; (R2) or closes (R3), demands R_i ≺ R. Length 1 is (R1).
    (let ((n (cast Int (list-len w)))
          (nothing (list-new arena Int)))
      (cond
        ((== n 1)
          (let ((x (int-at w 0)))
            (if (or (== x s) (== x (inv-node s)))
              nothing
              w)))
        ((and (== n 2) (== (int-at w 0) s) (== (int-at w 1) s)) nothing)
        (else
          (let ((r2 (== (int-at w 0) s))
                (r3 (== (int-at w (- n 1)) s))
                (tail (word-slice arena w 1 n))
                (head (word-slice arena w 0 (- n 1))))
            (cond
              ;; Both ends recursive: both sets hold R itself, so either
              ;; is cyclic; the ⊆-least is taken when there is one.
              ((and r2 r3) (if (ints-subset head tail) head tail))
              (r2 tail)
              (r3 head)
              (else w)))))))

  (fn inv-word ((arena Arena) (w (List Int)))
    (@intent "R^c's inverse of a word: reversed, each role inverted")
    (@spec ((Arena (List Int)) -> (List Int)))
    (@alloc arena)
    (let ((mut out (list-new arena Int))
          (mut i (- (cast Int (list-len w)) 1)))
      (do
        (while (>= i 0)
          (do (list-push out (inv-node (int-at w i))) (set! i (- i 1))))
        out)))

  (fn rep-word ((arena Arena) (w (List Int)) (rep (List Int)))
    (@intent "A word with each role replaced by its representative")
    (@spec ((Arena (List Int) (List Int)) -> (List Int)))
    (@alloc arena)
    (let ((mut out (list-new arena Int)))
      (do (for-each (x w) (list-push out (int-at rep x))) out)))

  (fn csr-acyclic ((arena Arena) (g Csr) (n Int))
    (@intent "Has the graph no cycle (a self-loop included)? Kahn's algorithm")
    (@spec ((Arena Csr Int) -> Bool))
    (@alloc arena)
    (let ((indeg (ints-new arena n 0))
          (mut queue (list-new arena Int))
          (mut head 0)
          (mut done 0)
          (mut v 0))
      (do
        (for-each (w (. g adj)) (list-set indeg w (+ (int-at indeg w) 1)))
        (while (< v n)
          (do (when (== (int-at indeg v) 0) (list-push queue v)) (set! v (+ v 1))))
        (while (< head (cast Int (list-len queue)))
          (let ((u (int-at queue head)))
            (do
              (set! head (+ head 1))
              (set! done (+ done 1))
              (let ((mut e (int-at (. g off) u))
                    (stop (int-at (. g off) (+ u 1))))
                (while (< e stop)
                  (let ((w (int-at (. g adj) e)))
                    (do
                      (list-set indeg w (- (int-at indeg w) 1))
                      (when (== (int-at indeg w) 0) (list-push queue w))
                      (set! e (+ e 1)))))))))
        (== done n))))

  (fn sriq-rbox-none ((arena Arena))
    (@intent "The RBox answer for a rung that is not sriq: nothing non-simple, regular")
    (@spec ((Arena) -> SriqRbox))
    (@alloc arena)
    (record-new SriqRbox (props (list-new arena RoleId)) (nonsimple (list-new arena Bool)) (regular true)))

  (fn sriq-rbox ((arena Arena) (axs (List RawAxiom)))
    (@intent "§5.5's RBox gate: which roles are simple, and is the collapsed completion ≺-regular?")
    (@spec ((Arena (List RawAxiom)) -> SriqRbox))
    (@alloc arena)
    ;; - → is OWL 2 §11.1's hierarchy over AllOPE: each one-step
    ;;   inclusion R ⊑ S, and inv(R) ⊑ inv(S) with it.
    ;; - A role is non-simple when a composite role reaches it along →.
    ;;   Composite: the super of a chain of length ≥ 2, and its inverse;
    ;;   owl:bottomObjectProperty counts as one, as under el++.
    ;; - A RIA is complex unless it is one step into a simple role, and
    ;;   R^c holds each complex RIA and its inverse, over representatives.
    ;; - The RBox is regular iff their constraint graph is acyclic.
    (let ((props (sriq-props arena axs))
          (n     (* 2 (cast Int (list-len props))))
          (rias  (sriq-rias arena props axs))
          (mut fs    (list-new arena Int))
          (mut fd    (list-new arena Int))
          (mut seeds (list-new arena Int))
          (mut cs    (list-new arena Int))
          (mut cd    (list-new arena Int)))
      (do
        (for-each (ria rias)
          (if (== (list-len (. ria word)) 1)
            (let ((x (int-at (. ria word) 0)) (s (. ria super)))
              (do (list-push fs x) (list-push fd s)
                  (list-push fs (inv-node x)) (list-push fd (inv-node s))))
            (do (list-push seeds (. ria super))
                (list-push seeds (inv-node (. ria super))))))
        (let ((bot (sriq-node props (union-new RoleId named-role
                                      (record-new IRI (value OWL_BOTTOM_OBJECT_PROPERTY))))))
          (when (>= bot 0) (do (list-push seeds bot) (list-push seeds (inv-node bot)))))
        (let ((fwd (csr-build arena n fs fd))
              (bwd (csr-build arena n fd fs)))
          (let ((nonsimple (csr-reach arena fwd n seeds))
                (rep       (sriq-reps arena fwd bwd n)))
            (do
              (for-each (ria rias)
                (when (or (> (list-len (. ria word)) 1)
                          (mat-get nonsimple (. ria super)))
                  (let ((w  (rep-word arena (. ria word) rep))
                        (s  (int-at rep (. ria super))))
                    (do
                      (for-each (x (ria-constraints arena w s))
                        (do (list-push cs x) (list-push cd s)))
                      (for-each (x (ria-constraints arena (inv-word arena w) (inv-node s)))
                        (do (list-push cs x) (list-push cd (inv-node s))))))))
              (record-new SriqRbox
                (props props)
                (nonsimple nonsimple)
                (regular (csr-acyclic arena (csr-build arena n cs cd) n)))))))))

  (fn sriq-role-simple ((rb SriqRbox) (r RoleId))
    (@intent "Is this role simple in the RBox §5.5's gate judged?")
    (@spec ((SriqRbox RoleId) -> Bool))
    (@pure)
    (let ((nd (sriq-node (. rb props) r)))
      (if (< nd 0)
        ;; In no role inclusion: simple, unless it is the empty role.
        (match (property-of r)
          ((some pr) (not (is-bottom-role pr)))
          ((none)    true))
        (not (mat-get (. rb nonsimple) nd)))))

  (fn is-bottom-role ((r RoleId))
    (@intent "Is this owl:bottomObjectProperty?")
    (@spec ((RoleId) -> Bool))
    (@pure)
    (match r
      ((named-role i)   (== (string-cmp (. i value) OWL_BOTTOM_OBJECT_PROPERTY) 0))
      ((inverse-role i) (== (string-cmp (. i value) OWL_BOTTOM_OBJECT_PROPERTY) 0))
      ((fresh-role _)   false)))

  (fn sriq-concept-simple ((rb SriqRbox) (c RawConcept))
    (@intent "Is every number restriction and Self in this concept on a simple role?")
    (@spec ((SriqRbox RawConcept) -> Bool))
    (@pure)
    (match c
      ((rc-card _ r _)    (sriq-role-simple rb r))
      ((rc-qcard _ r _ f) (and (sriq-role-simple rb r) (sriq-concept-simple rb (deref f))))
      ((rc-has-self r)    (sriq-role-simple rb r))
      ((rc-and cs)        (sriq-concepts-simple rb cs))
      ((rc-or cs)         (sriq-concepts-simple rb cs))
      ((rc-not f)         (sriq-concept-simple rb (deref f)))
      ((rc-some _ f)      (sriq-concept-simple rb (deref f)))
      ((rc-all _ f)       (sriq-concept-simple rb (deref f)))
      (_ true)))

  (fn sriq-concepts-simple ((rb SriqRbox) (cs (List RawConcept)))
    (@intent "sriq-concept-simple over a list")
    (@spec ((SriqRbox (List RawConcept)) -> Bool))
    (@pure)
    (let ((mut ok true))
      (do (for-each (c cs) (when (not (sriq-concept-simple rb c)) (set! ok false))) ok)))

  (fn sriq-axiom-simple ((rb SriqRbox) (ax RawAxiom))
    (@intent "Does this axiom put on simple roles everything OWL 2 §11.2 restricts to them?")
    (@spec ((SriqRbox RawAxiom) -> Bool))
    (@pure)
    ;; Number restrictions, Self, functional, inverse-functional,
    ;; irreflexive and asymmetric roles, and disjointness (§5.5). Per
    ;; axiom: the offending axiom is its own witness.
    (match ax
      ((ra-sub-class-of l r)
        (and (sriq-concept-simple rb (deref l)) (sriq-concept-simple rb (deref r))))
      ((ra-equivalent-classes cs)      (sriq-concepts-simple rb cs))
      ((ra-disjoint-classes cs)        (sriq-concepts-simple rb cs))
      ((ra-object-property-domain _ c) (sriq-concept-simple rb (deref c)))
      ((ra-object-property-range _ c)  (sriq-concept-simple rb (deref c)))
      ((ra-class-assertion ca)         (sriq-concept-simple rb (deref (. ca concept))))
      ((ra-disjoint-union du)          (sriq-concepts-simple rb (. du members)))
      ((ra-property-characteristic c r)
        (if (or (== c 'prop-functional) (or (== c 'prop-inverse-functional)
                (or (== c 'prop-irreflexive) (== c 'prop-asymmetric))))
          (sriq-role-simple rb r)
          true))
      ((ra-disjoint-properties rs)
        (let ((mut ok true))
          (do (for-each (r rs) (when (not (sriq-role-simple rb r)) (set! ok false))) ok)))
      (_ true)))

  (fn is-rbox-axiom ((ax RawAxiom))
    (@intent "Is this a role inclusion or a property chain?")
    (@spec ((RawAxiom) -> Bool))
    (@pure)
    ;; The RBox proper. Domain and range axioms are NOT included: their
    ;; gate is per-axiom, so the offending RIA is its own witness and
    ;; there is no collective failure to propagate.
    (match ax
      ((ra-sub-object-property _ _) true)
      ((ra-property-chain _)        true)
      (_ false)))

  (fn axiom-range-ok ((entries (List RangeEntry)) (told (List Bool)) (n Int)
                      (roles (List RoleId)) (ax RawAxiom))
    (@intent "The range/composition condition, for the axioms it applies to")
    (@spec (((List RangeEntry) (List Bool) Int (List RoleId) RawAxiom) -> Bool))
    (@pure)
    ;; Only composition shares a target, so role HIERARCHY is
    ;; unaffected: `r ⊑ s` with ranges on both is accepted.
    (match ax
      ((ra-property-chain ch) (chain-range-ok entries told n roles ch))
      (_ true)))

  (fn gate-axioms ((arena Arena) (axs (List RawAxiom)) (sig Signature)
                   (carried (List Omission)) (p Profile))
    (@intent "Split decoded axioms into accepted and omitted, per the rung's language (§5.2, §5.4)")
    (@spec ((Arena (List RawAxiom) Signature (List Omission) Profile) -> GateResult))
    (@alloc arena)
    ;; `carried` holds omissions raised before the gate — unresolved
    ;; imports from stage 0. They ride through rather than being
    ;; recomputed, because coverage is one list and §6.2's verdict rule
    ;; reads its emptiness.
    ;; Negation is rewritten AFTER sugar, so an equivalence's halves are
    ;; judged one by one, and BEFORE everything else, so every gate
    ;; condition below judges the rewritten theory.
    ;;
    ;; Under el++, inclusions into owl:topObjectProperty are tautologies
    ;; and are dropped first (§5.4 K0), so no RBox condition sees them.
    (let ((expanded (drop-top-role-tautologies arena p
                      (expand-negation arena p (expand-sugar arena axs))))
          (mut accepted (list-new arena RawAxiom))
          (mut omitted  (list-new arena Omission)))
      (do
        (for-each (o carried) (list-push omitted o))
        ;; A COLLECTIVE RBOX FAILURE OMITS THE WHOLE RBOX. The tempting
        ;; alternative is to delete a witness and carry on, but that
        ;; needs a REMOVAL SET and a witness is not one: several
        ;; deletions can each restore regularity, each yields a
        ;; different residual theory, and the choice is not even local —
        ;; deleting a hierarchy edge can strip an inherited range so
        ;; that range elimination then runs outside its own
        ;; precondition. A deterministic refusal is worth more than a
        ;; larger result set nobody can reproduce.
        (let ((rview  (named-roles-only arena expanded))
              (sriq   (is-sriq p))
              ;; sriq's RBox gate (§5.5) replaces el's: simple roles over
              ;; AllOPE, the collapse, and [Sim12]'s ≺-regularity. It reads
              ;; the RBox axioms the rung admits one by one.
              (srb    (if (is-sriq p)
                        (sriq-rbox arena (admitted arena p expanded))
                        (sriq-rbox-none arena)))
              (rbox-bad (if (is-sriq p)
                          (not (. srb regular))
                          (match (check-regularity arena rview)
                            ((rbox-regular) false)
                            ((rbox-irregular _) true))))
              ;; The RBox role list is collected ONCE over the expanded
              ;; axioms and shared by the closure, the range table and the
              ;; per-axiom check — it had been recomputed for each.
              (rroles (collect-rbox-roles arena rview))
              (told   (told-closure arena rview rroles (cast Int (list-len rroles))))
              (ranges (collect-ranges arena rview rroles))
              ;; Self is only ever in el++, so only el++ pays for the
              ;; simple-role closure.
              (nonsimple (if (is-el-plus-plus p)
                           (non-simple-roles arena rview)
                           (list-new arena RoleId))))
          (for-each (ax expanded)
          (match (disposition p ax)
            ;; Consumed: read into the signature already, yields no
            ;; axiom. NOT an omission — dropping it from coverage is
            ;; what keeps a declared-but-unused class from looking like
            ;; a gap.
            ('d-consumed (do))
            ;; Inert: semantically empty in OWL 2. Treating these as
            ;; unsupported returns inconclusive on every documented
            ;; ontology, which is the failure that makes a reasoner
            ;; useless rather than merely incomplete.
            ('d-inert    (do))
            ('d-in-profile
              (if (and (axiom-in-profile p ax)
                       (not (and rbox-bad
                                 (if sriq (is-sriq-ria ax) (is-rbox-axiom ax))))
                       ;; Self only on a simple role (§5.4), and under sriq
                       ;; every restriction OWL 2 §11.2 puts on simple
                       ;; roles: per axiom, like the range condition.
                       (if sriq
                         (sriq-axiom-simple srb ax)
                         (self-roles-simple nonsimple ax))
                       ;; A range-condition violation is PER-AXIOM:
                       ;; the offending RIA is its own witness, so it
                       ;; is omitted alone rather than collapsing the
                       ;; whole RBox the way non-regularity does. sriq has
                       ;; no range condition: [TGH21] needs none.
                       (or sriq
                           (axiom-range-ok ranges told
                             (cast Int (list-len rroles)) rroles ax)))
                (list-push accepted ax)
                ;; In-profile FORM with out-of-profile operands, or an
                ;; RBox axiom in an RBox that failed regularity.
                (list-push omitted
                  (union-new Omission out-of-profile (axiom-input-ref arena ax)))))
            ('d-out-of-profile
              (list-push omitted
                (union-new Omission out-of-profile (axiom-input-ref arena ax)))))))
        ;; Declaration checks run over the ACCEPTED axioms only. An
        ;; out-of-profile axiom is already reported; also reporting the
        ;; classes it happens to mention would turn one rejected axiom
        ;; into a cascade of findings about entities that are not the
        ;; problem.
        (for-each (o (missing-declarations arena sig
                       (collect-entity-refs arena accepted)))
          (list-push omitted o))
        (record-new GateResult
          (accepted  (sort-axioms arena accepted))
          (omissions (sort-omissions arena omitted))
          (signature sig)))))

  ;; ACCEPTED AXIOMS LEAVE THE GATE IN CANONICAL ORDER, or fresh ids do
  ;; not. §6.3 assigns fresh-node ids "in order of first occurrence under
  ;; the canonical axiom ordering", and the normalizer mints them in the
  ;; order it is handed axioms. Handing it DOCUMENT order made the normal
  ;; form a function of triple order: litmus.ttl with its triples reversed
  ;; normalized differently (test-triple-order-independence).
  ;;
  ;; The key is the canonical functional-syntax rendering. It is a total
  ;; order independent of serialization — an in-profile axiom carries no
  ;; blank-node label — and two axioms that render identically ARE the
  ;; same axiom, so how a tie resolves cannot change the normal form.
  (fn sort-axioms ((arena Arena) (xs (List RawAxiom)))
    (@intent "Accepted axioms, ordered by their canonical rendering")
    (@spec ((Arena (List RawAxiom)) -> (List RawAxiom)))
    (@alloc arena)
    (let ((texts (axiom-texts arena xs)))
      (let ((idx (sort-range arena (cast Int (list-len xs))
                   (fn ((i Int) (j Int)) (string-cmp (str-at texts i) (str-at texts j)))))
            (mut out (list-new arena RawAxiom)))
        (do (for-each (k idx) (list-push out (axiom-at xs k))) out))))

  (fn axiom-texts ((arena Arena) (xs (List RawAxiom)))
    (@intent "Each axiom's canonical rendering, computed once rather than per comparison")
    (@spec ((Arena (List RawAxiom)) -> (List String)))
    (@alloc arena)
    (let ((mut out (list-new arena String)))
      (do (for-each (ax xs) (list-push out (render-axiom arena ax))) out)))

  (fn axiom-at ((xs (List RawAxiom)) (i Int))
    (@intent "Element i, where the caller has already bounds-checked")
    (@spec (((List RawAxiom) Int) -> RawAxiom))
    (@pure)
    (@pre {i >= 0})
    (@pre {i < (list-len xs)})
    (match (list-get xs i)
      ((some v) v)
      ((none)   (union-new RawAxiom ra-unrecognized
                  (union-new InputRef synthetic "unreachable: axiom index out of range")))))

  ;; ============================================================
  ;; RBox gate 1 — property-chain regularity (§5.2)
  ;;
  ;; OWL 2 requires a strict partial order ≺ on object properties under
  ;; which every RIA takes one of §11.2's permitted forms. This is
  ;; CITED, not derived: its rationale is termination of an automaton
  ;; construction, which is exactly the kind of thing that looks
  ;; over-strict when you reason from examples.
  ;;
  ;; A GENERIC CYCLE DETECTOR OVER ROLE INCLUSIONS IS WRONG IN BOTH
  ;; DIRECTIONS, and both are FALSE-FAILS — a user's correct ontology
  ;; refused. Equivalent simple roles (`r ⊑ s`, `s ⊑ r`) form a
  ;; non-trivial SCC in the inclusion graph while being perfectly
  ;; regular, and transitivity (`r ∘ r ⊑ r`) is a self-loop the
  ;; normative cases expressly permit. Neither generates a ≺ edge here:
  ;; simple inclusions are NEVER matched against the cases (step 0),
  ;; and the repeated role in `r ∘ r ⊑ r` is licensed by the form it
  ;; matches.
  ;; ============================================================

  (type RboxVerdict (union
    (rbox-regular)
    (rbox-irregular String)))   ; diagnostic naming the violated pair

  (fn role-idx ((roles (List RoleId)) (r RoleId))
    (@intent "Canonical index of a role, or -1 if it is not in the RBox")
    (@spec (((List RoleId) RoleId) -> Int))
    (@pure)
    (let ((mut found -1)
          (mut i 0))
      (do
        (for-each (x roles)
          (do
            (when (and (< found 0) (== (role-cmp x r) 0)) (set! found i))
            (set! i (+ i 1))))
        found)))

  (fn push-role-unique ((rs (List RoleId)) (r RoleId))
    (@intent "Append a role if the list does not already hold it")
    (@spec (((List RoleId) RoleId) -> Bool))
    (@pure)
    ;; NOTE: this returns whether the role is new; the CALLER pushes.
    ;; A helper that pushed here would grow its own copy of the value
    ;; struct and lose it on return.
    (< (role-idx rs r) 0))

  (fn collect-rbox-roles ((arena Arena) (axs (List RawAxiom)))
    (@intent "Every role named in the RBox, in canonical order")
    (@spec ((Arena (List RawAxiom)) -> (List RoleId)))
    (@alloc arena)
    ;; Canonical order matters: role indices key the constraint matrix,
    ;; and a matrix indexed by document order would make the gate's
    ;; answer depend on serialization.
    (let ((mut rs (list-new arena RoleId)))
      (do
        (for-each (ax axs)
          (match ax
            ((ra-sub-object-property a b)
              (do
                (when (push-role-unique rs a) (list-push rs a))
                (when (push-role-unique rs b) (list-push rs b))))
            ((ra-property-chain ch)
              (do
                (for-each (st (. ch steps))
                  (when (push-role-unique rs st) (list-push rs st)))
                (when (push-role-unique rs (. ch super)) (list-push rs (. ch super)))))
            ;; Range-bearing roles must be indexed too. A role that
            ;; carries only a range and no inclusion would otherwise get
            ;; index -1, and the range gate would silently find no range
            ;; to check — a false pass in the direction that loses
            ;; completeness.
            ((ra-object-property-range r _)
              (when (push-role-unique rs r) (list-push rs r)))
            (_ (do))))
        (sort-roles arena rs))))

  (fn sort-roles ((arena Arena) (xs (List RoleId)))
    (@intent "Canonically sorted copy")
    (@spec ((Arena (List RoleId)) -> (List RoleId)))
    (@alloc arena)
    (let ((idx (sort-range arena (cast Int (list-len xs))
                 (fn ((i Int) (j Int)) (role-cmp (role-at xs i) (role-at xs j)))))
          (mut out (list-new arena RoleId)))
      (do (for-each (k idx) (list-push out (role-at xs k))) out)))

  (fn role-at ((xs (List RoleId)) (i Int))
    (@intent "Element i, where the caller has already bounds-checked")
    (@spec (((List RoleId) Int) -> RoleId))
    (@pure)
    (@pre {i >= 0})
    (@pre {i < (list-len xs)})
    (match (list-get xs i)
      ((some v) v)
      ((none)   (union-new RoleId fresh-role 0))))

  (fn mat-new ((arena Arena) (cells Int))
    (@intent "A cells-long false vector, used as an n×n bit matrix")
    (@spec ((Arena Int) -> (List Bool)))
    (@alloc arena)
    (let ((mut m (list-new arena Bool))
          (mut i 0))
      (do
        (while (< i cells) (do (list-push m false) (set! i (+ i 1))))
        m)))

  (fn mat-get ((m (List Bool)) (i Int))
    (@intent "Cell i")
    (@spec (((List Bool) Int) -> Bool))
    (@pure)
    (match (list-get m i)
      ((some v) v)
      ((none)   false)))

  (fn mat-close ((m (List Bool)) (n Int))
    (@intent "Transitive closure in place, Warshall")
    (@spec (((List Bool) Int) -> Bool))
    ;; `list-set` writes through the caller's buffer because it never
    ;; reallocates; `list-push` here would grow a copy and lose it.
    (let ((mut k 0))
      (do
        (while (< k n)
          (do
            (let ((mut i 0))
              (while (< i n)
                (do
                  (when (mat-get m (+ (* i n) k))
                    (let ((mut j 0))
                      (while (< j n)
                        (do
                          (when (mat-get m (+ (* k n) j))
                            (list-set m (+ (* i n) j) true))
                          (set! j (+ j 1))))))
                  (set! i (+ i 1)))))
            (set! k (+ k 1))))
        true)))

  (fn told-closure ((arena Arena) (axs (List RawAxiom)) (roles (List RoleId)) (n Int))
    (@intent "Reflexive-transitive told role hierarchy ⊑*")
    (@spec ((Arena (List RawAxiom) (List RoleId) Int) -> (List Bool)))
    (@alloc arena)
    ;; SIMPLE INCLUSIONS ONLY. §11.2's case enumeration applies to
    ;; chains of length ≥ 2; a simple `r ⊑ s` builds this hierarchy and
    ;; nothing more. Feeding simple inclusions into case matching makes
    ;; "matches no permitted form" reject every rdfs:subPropertyOf
    ;; axiom in existence.
    (let ((m (mat-new arena (* n n)))
          (mut i 0))
      (do
        ;; reflexive
        (while (< i n) (do (list-set m (+ (* i n) i) true) (set! i (+ i 1))))
        (for-each (ax axs)
          (match ax
            ((ra-sub-object-property a b)
              (let ((ia (role-idx roles a))
                    (ib (role-idx roles b)))
                (when (and (>= ia 0) (>= ib 0))
                  (list-set m (+ (* ia n) ib) true))))
            (_ (do))))
        (mat-close m n)
        m)))

  (fn candidate-size ((ch RawChain) (from Int) (to Int))
    (@intent "How many DISTINCT roles a candidate case would constrain")
    (@spec ((RawChain Int Int) -> Int))
    (@pure)
    ;; Distinct, because dominance compares constraint SETS: two
    ;; positions holding the same role contribute one constraint, not
    ;; two. An empty range (from > to) counts zero, which is how the
    ;; transitivity case scores ∅.
    (let ((steps (. ch steps))
          (mut count 0)
          (mut i from))
      (do
        (while (<= i to)
          (do
            (let ((mut dup false)
                  (mut j from))
              (do
                (while (< j i)
                  (do
                    (when (== (role-cmp (role-at steps j) (role-at steps i)) 0)
                      (set! dup true))
                    (set! j (+ j 1))))
                (when (not dup) (set! count (+ count 1)))))
            (set! i (+ i 1))))
        count)))

  (fn add-chain-constraints ((ch RawChain) (roles (List RoleId)) (n Int)
                             (cmat (List Bool)) (from Int) (to Int))
    (@intent "Add `stepᵢ ≺ super` for positions in [from, to]")
    (@spec ((RawChain (List RoleId) Int (List Bool) Int Int) -> Bool))
    (let ((steps (. ch steps))
          (isup  (role-idx roles (. ch super)))
          (mut i from))
      (do
        (while (<= i to)
          (do
            (let ((ist (role-idx roles (role-at steps i))))
              (when (and (>= ist 0) (>= isup 0))
                (list-set cmat (+ (* ist n) isup) true)))
            (set! i (+ i 1))))
        true)))

  (fn describe-violation ((arena Arena) (roles (List RoleId)) (i Int) (j Int))
    (@intent "A deterministic diagnostic for a violated ≺ pair")
    (@spec ((Arena (List RoleId) Int Int) -> String))
    (@alloc arena)
    (string-concat arena "property-chain regularity: "
      (string-concat arena (render-role arena (role-at roles i))
        (string-concat arena " must precede "
          (string-concat arena (render-role arena (role-at roles j))
            (string-concat arena ", but the told hierarchy has "
              (string-concat arena (render-role arena (role-at roles j))
                (string-concat arena " sub-property-of "
                  (render-role arena (role-at roles i))))))))))

  (fn check-regularity ((arena Arena) (axs (List RawAxiom)))
    (@intent "OWL 2 §11.2 regularity over the RBox AS WRITTEN")
    (@spec ((Arena (List RawAxiom)) -> RboxVerdict))
    (@alloc arena)
    ;; Runs BEFORE binary decomposition. A fresh intermediate role is
    ;; unconstrained by any ≺ the original chains had to respect, so a
    ;; cyclic dependency among the original roles can be split across
    ;; two innocuous-looking binary steps and vanish — checking after
    ;; decomposition passes RBoxes OWL 2 rejects.
    (let ((roles (collect-rbox-roles arena axs))
          (n (cast Int (list-len roles))))
      (if (== n 0)
        (union-new RboxVerdict rbox-regular)
        (let ((told (told-closure arena axs roles n))
              (cmat (mat-new arena (* n n)))
              (mut msg (Option String) (none)))
          (do
            (for-each (ax axs)
              (match ax
                ((ra-property-chain ch)
                  (let ((steps (. ch steps))
                        (len (cast Int (list-len (. ch steps))))
                        (sup (. ch super)))
                    (when (>= len 2)
                      (let ((left-ok  (== (role-cmp (role-at steps 0) sup) 0))
                            (right-ok (== (role-cmp (role-at steps (- len 1)) sup) 0)))
                        (cond
                          ;; Transitivity `t ∘ t ⊑ t` generates NOTHING.
                          ;; It also matches the generic case, which
                          ;; would yield `t ≺ t` and falsely reject —
                          ;; dominance picks the ⊆-least set, and ∅ wins.
                          ((and (== len 2) left-ok right-ok) (do))
                          (else
                            ;; CANDIDATES ARE WHOLE CASES, never
                            ;; independently-skipped end positions.
                            ;; `t ∘ a ∘ t ⊑ t` matches left-recursion
                            ;; with {a≺t, t≺t} and right-recursion with
                            ;; {t≺t, a≺t}; skipping both ends
                            ;; independently would give {a≺t} and
                            ;; wrongly accept it. Every real case match
                            ;; here carries `t ≺ t`, which the closure
                            ;; check then rejects.
                            (let ((gen (candidate-size ch 0 (- len 1)))
                                  (lft (if left-ok  (candidate-size ch 1 (- len 1)) 1000000))
                                  (rgt (if right-ok (candidate-size ch 0 (- len 2)) 1000000)))
                              (cond
                                ((and (<= lft rgt) (<= lft gen))
                                  (add-chain-constraints ch roles n cmat 1 (- len 1)))
                                ((<= rgt gen)
                                  (add-chain-constraints ch roles n cmat 0 (- len 2)))
                                (else
                                  (add-chain-constraints ch roles n cmat 0 (- len 1)))))))))))
                (_ (do))))

            ;; ≺ IS TRANSITIVE, so compatibility must hold for every
            ;; pair the order IMPLIES, not only for generated edges.
            ;; Given a ≺ b, b ≺ c and told c ⊑ a, every generated edge
            ;; passes and the graph is acyclic — but transitivity forces
            ;; a ≺ c, which c ⊑* a forbids.
            (mat-close cmat n)

            ;; A pair (x,y) is violated when told y ⊑* x. This subsumes
            ;; cycle detection: a cycle puts (x,x) in the closure, and
            ;; ⊑* is reflexive, so x ⊑* x makes it a violation — which
            ;; is exactly the `r ≺ r` self-edge the conventional
            ;; "non-trivial SCC" reading drops.
            (let ((mut i 0))
              (while (< i n)
                (do
                  (let ((mut j 0))
                    (while (< j n)
                      (do
                        (when (and (mat-get cmat (+ (* i n) j))
                                   (mat-get told (+ (* j n) i)))
                          (match msg
                            ((none)   (set! msg (some (describe-violation arena roles i j))))
                            ((some _) (do))))
                        (set! j (+ j 1)))))
                  (set! i (+ i 1)))))

            (match msg
              ((some m) (union-new RboxVerdict rbox-irregular m))
              ((none)   (union-new RboxVerdict rbox-regular))))))))

  ;; ============================================================
  ;; RBox gate 2 — the range/composition condition (§5.2)
  ;;
  ;; Ranges and role composition cannot be combined freely. Given
  ;; `r ∘ s ⊑ t`, a `t`-successor reached through the composition is
  ;; built as an `s`-successor and so satisfies range(s) — but as a
  ;; `t`-successor it must ALSO satisfy range(t). Nothing constructs a
  ;; different witness, so unless range(t) is already implied by
  ;; range(s) the model is wrong and completeness is lost.
  ;;
  ;; THE PUBLISHED CONDITION, ADOPTED EXACTLY. For every RIA
  ;; `r₁ ∘ … ∘ rₙ ⊑ t`:
  ;;
  ;;   (∃t'. t ⊑* t' ∧ range(t') = C) ⟹ (∃s'. rₙ ⊑* s' ∧ range(s') = C)
  ;;
  ;; BOTH sides quantified through the told hierarchy, and the SAME C —
  ;; not a subclass of it. A subclass range looks plausible and may
  ;; even be semantically sound, but HOWL's completeness rests on
  ;; implementing a calculus someone has PROVED complete; a gate
  ;; admitting ontologies outside the proved condition leaves the proof
  ;; behind and the citation no longer covers what the engine does.
  ;; Wanting the relaxation later is legitimate — it needs a proof, not
  ;; a citation.
  ;;
  ;; The one-sided variant is unsound as a gate: requiring a DIRECT
  ;; range(t) while letting the range on s be inherited accepts
  ;; `r ∘ s ⊑ t`, `t ⊑ u`, `range(u) = C` with no range on s at all.
  ;; ============================================================

  (type RangeEntry (record
    (role   Int)          ; canonical role index
    (filler RawConcept)))

  (fn collect-ranges ((arena Arena) (axs (List RawAxiom)) (roles (List RoleId)))
    (@intent "Every told object-property range, keyed by canonical role index")
    (@spec ((Arena (List RawAxiom) (List RoleId)) -> (List RangeEntry)))
    (@alloc arena)
    (let ((mut out (list-new arena RangeEntry)))
      (do
        (for-each (ax axs)
          (match ax
            ((ra-object-property-range r c)
              (let ((ir (role-idx roles r)))
                (when (>= ir 0)
                  (list-push out (record-new RangeEntry
                                   (role ir) (filler (deref c)))))))
            (_ (do))))
        out)))

  (fn has-inherited-range ((entries (List RangeEntry)) (told (List Bool)) (n Int)
                           (base Int) (c RawConcept))
    (@intent "∃ s'. base ⊑* s' ∧ range(s') = c")
    (@spec (((List RangeEntry) (List Bool) Int Int RawConcept) -> Bool))
    (@pure)
    (let ((mut found false))
      (do
        (for-each (e entries)
          (when (and (mat-get told (+ (* base n) (. e role)))
                     ;; SAME expression, compared structurally. Accepting
                     ;; a subclass here is the documented trap.
                     (== (concept-cmp (. e filler) c) 0))
            (set! found true)))
        found)))

  (fn chain-range-ok ((entries (List RangeEntry)) (told (List Bool)) (n Int)
                      (roles (List RoleId)) (ch RawChain))
    (@intent "Does this RIA satisfy the range/composition condition?")
    (@spec (((List RangeEntry) (List Bool) Int (List RoleId) RawChain) -> Bool))
    (@pure)
    (let ((steps (. ch steps))
          (len (cast Int (list-len (. ch steps))))
          (it (role-idx roles (. ch super))))
      (if (or (< len 1) (< it 0))
        true
        ;; Only rₙ is consulted. The intermediate roles of a longer
        ;; chain impose nothing on the composed target.
        (let ((ilast (role-idx roles (role-at steps (- len 1))))
              (mut ok true))
          (do
            (when (>= ilast 0)
              (for-each (e entries)
                ;; antecedent: t ⊑* t' and range(t') = C
                (when (mat-get told (+ (* it n) (. e role)))
                  (when (not (has-inherited-range entries told n ilast (. e filler)))
                    (set! ok false)))))
            ok)))))

  ;; ============================================================
  ;; Declaration checks — the determinate half
  ;;
  ;; OWL 2 DL requires a declaration for every class, object property,
  ;; data property and annotation property, but NAMED-INDIVIDUAL
  ;; DECLARATIONS ARE OPTIONAL. So an undeclared individual is not a
  ;; finding, while an undeclared class used in a subsumption is.
  ;;
  ;; Only positions where structural position UNIQUELY FIXES the kind
  ;; produce a `missing-declaration`. The ambiguous cases —
  ;; `:a :p :b` with `:p` undeclared, and an IRI declared under two
  ;; disjoint property kinds — are input-errors raised in decode,
  ;; because there is no determinate EntityKind to put in the report.
  ;; ============================================================

  ;; The referring axiom itself, not its rendering: the text is needed
  ;; only when the entity turns out to be undeclared, which in a clean
  ;; ontology is never, and rendering every accepted axiom up front cost
  ;; GO a second full rendering pass (`sort-axioms` renders the first).
  (type EntityRef (record
    (kind   EntityKind)
    (entity IRI)
    (axiom  RawAxiom)))

  (fn axiom-ref-of ((arena Arena) (ax RawAxiom))
    (@intent "The canonical AxiomRef of an axiom")
    (@spec ((Arena RawAxiom) -> AxiomRef))
    (@alloc arena)
    (let ((no-source (Option IRI) (none)))
      (record-new AxiomRef (source no-source) (text (render-axiom arena ax)))))

  (fn collect-concept-classes ((arena Arena) (c RawConcept) (acc (List IRI)))
    (@intent "Every named class occurring in a class expression")
    (@spec ((Arena RawConcept (List IRI)) -> (List IRI)))
    (@alloc arena)
    (let ((mut out acc))
      (do
        (match c
          ((rc-name n)
            (match n
              ((class-node i)      (list-push out i))
              ((individual-node _) (do))
              ((fresh-node _)      (do))))
          ((rc-and cs)   (for-each (x cs) (set! out (collect-concept-classes arena x out))))
          ((rc-some _ f) (set! out (collect-concept-classes arena (deref f) out)))
          ;; sriq's constructors (§5.5); no other rung accepts them.
          ((rc-or cs)    (for-each (x cs) (set! out (collect-concept-classes arena x out))))
          ((rc-not f)    (set! out (collect-concept-classes arena (deref f) out)))
          ((rc-all _ f)  (set! out (collect-concept-classes arena (deref f) out)))
          ((rc-qcard _ _ _ f) (set! out (collect-concept-classes arena (deref f) out)))
          (_ (do)))
        out)))

  (fn collect-entity-refs ((arena Arena) (axs (List RawAxiom)))
    (@intent "Every entity reference whose kind its position fixes")
    (@spec ((Arena (List RawAxiom)) -> (List EntityRef)))
    (@alloc arena)
    (let ((mut out (list-new arena EntityRef)))
      (do
        (for-each (ax axs)
          (let ((mut classes (list-new arena IRI))
                (mut roles (list-new arena RoleId)))
            (do
              (match ax
                ((ra-sub-class-of l rr)
                  (do
                    (set! classes (collect-concept-classes arena (deref l) classes))
                    (set! classes (collect-concept-classes arena (deref rr) classes))))
                ((ra-equivalent-classes cs)
                  (for-each (x cs) (set! classes (collect-concept-classes arena x classes))))
                ((ra-disjoint-classes cs)
                  (for-each (x cs) (set! classes (collect-concept-classes arena x classes))))
                ((ra-object-property-domain rl c)
                  (do (list-push roles rl)
                      (set! classes (collect-concept-classes arena (deref c) classes))))
                ((ra-object-property-range rl c)
                  (do (list-push roles rl)
                      (set! classes (collect-concept-classes arena (deref c) classes))))
                ((ra-class-assertion ca)
                  ;; The concept is a class expression; the SUBJECT is an
                  ;; individual, and individual declarations are optional.
                  (set! classes (collect-concept-classes arena (deref (. ca concept)) classes)))
                ((ra-sub-object-property a b) (do (list-push roles a) (list-push roles b)))
                ((ra-property-chain ch)
                  (do (for-each (st (. ch steps)) (list-push roles st))
                      (list-push roles (. ch super))))
                ((ra-object-property-assertion e) (list-push roles (. e role)))
                ((ra-negative-assertion e)        (list-push roles (. e role)))
                ((ra-property-characteristic _ rl) (list-push roles rl))
                ;; sriq's RBox and class axioms (§5.5); no other rung
                ;; accepts them.
                ((ra-inverse-properties a b)      (do (list-push roles a) (list-push roles b)))
                ((ra-equivalent-properties rs)    (for-each (rl rs) (list-push roles rl)))
                ((ra-disjoint-properties rs)      (for-each (rl rs) (list-push roles rl)))
                ((ra-disjoint-union du)
                  (do
                    (list-push classes (. du class))
                    (for-each (x (. du members))
                      (set! classes (collect-concept-classes arena x classes)))))
                (_ (do)))
              (for-each (i classes)
                (list-push out (record-new EntityRef
                                 (kind 'entity-class) (entity i) (axiom ax))))
              (for-each (rl roles)
                (match rl
                  ;; ObjectInverseOf(P) declares nothing, but P must be.
                  ((named-role i)
                    (list-push out (record-new EntityRef
                                     (kind 'entity-object-property) (entity i) (axiom ax))))
                  ((inverse-role i)
                    (list-push out (record-new EntityRef
                                     (kind 'entity-object-property) (entity i) (axiom ax))))
                  ((fresh-role _) (do)))))))
        out)))

  (fn entity-ref-declared ((sig Signature) (e EntityRef))
    (@intent "Is this entity declared under the kind its position fixes?")
    (@spec ((Signature EntityRef) -> Bool))
    (@pure)
    (match (. e kind)
      ('entity-class               (signature-has-class sig (. e entity)))
      ('entity-object-property     (signature-has-object-property sig (. e entity)))
      ('entity-data-property       true)
      ('entity-annotation-property true)
      ;; NAMED-INDIVIDUAL DECLARATIONS ARE OPTIONAL in OWL 2 DL, so an
      ;; undeclared individual is never a finding.
      ('entity-individual          true)
      ('entity-datatype            true)))

  (fn same-entity ((a EntityRef) (b EntityRef))
    (@intent "Same kind and same IRI")
    (@spec ((EntityRef EntityRef) -> Bool))
    (@pure)
    (and (== (. a kind) (. b kind))
         (== (iri-cmp (. a entity) (. b entity)) 0)))

  (fn missing-declarations ((arena Arena) (sig Signature) (refs (List EntityRef)))
    (@intent "One missing-declaration omission per undeclared entity")
    (@spec ((Arena Signature (List EntityRef)) -> (List Omission)))
    (@alloc arena)
    (let ((mut out (list-new arena Omission))
          (mut seen (list-new arena EntityRef)))
      (do
        (for-each (e refs)
          (when (not (entity-ref-declared sig e))
            (let ((mut dup false))
              (do
                (for-each (s2 seen) (when (same-entity s2 e) (set! dup true)))
                (when (not dup)
                  (let ((mut refs-for (list-new arena AxiomRef)))
                    (do
                      (list-push seen e)
                      ;; EVERY referring axiom, canonically sorted. The
                      ;; field invariant types.slop states is that
                      ;; `referring` is sorted, and
                      ;; `missing-declaration-cmp` compares the lists
                      ;; ELEMENT-WISE — comparing two unsorted lists
                      ;; element-wise is not an order at all.
                      (for-each (f refs)
                        (when (same-entity f e) (list-push refs-for (axiom-ref-of arena (. f axiom)))))
                      (list-push out
                        (union-new Omission missing-declaration
                          (record-new MissingDeclaration
                            (kind      (. e kind))
                            (entity    (. e entity))
                            (referring (sort-axiom-refs arena refs-for))))))))))))
        out)))
)
