;; M4's canonical search report. Timing and worker count never enter it.
(module alignmentreport
  (import types (AxiomRef))
  (import repair (SearchResult Phase candidate-reason-text))
  (import owl2 (render-omission))
  (export alignment-lines)

  (fn boolean ((b Bool))
    (@spec ((Bool) -> String))
    (if b "true" "false"))

  (fn line ((a Arena) (key String) (value String))
    (@spec ((Arena String String) -> String))
    (@alloc a)
    (string-concat a key (string-concat a " " value)))

  (fn phase-line ((a Arena) (name String) (p Phase))
    (@spec ((Arena String Phase) -> String))
    (@alloc a)
    (string-concat a (line a "search-phase" name)
      (string-concat a (line a " exhausted" (boolean (. p exhausted)))
        (string-concat a (line a " capped" (boolean (. p capped)))
                        (line a " unresolved" (boolean (. p unresolved)))))))

  (fn indices-text ((a Arena) (xs (List Int)))
    (@spec ((Arena (List Int)) -> String))
    (@alloc a)
    (let ((mut text ""))
      (do (for-each (i xs)
            (set! text (string-concat a text
                         (string-concat a (if (== (string-len text) 0) "" " ") (int-to-string a i)))))
          text)))

  (fn alignment-lines ((a Arena) (refs (List AxiomRef)) (s SearchResult))
    (@intent "Verified repairs and unverified candidates, with independently reported search limits and coverage")
    (@spec ((Arena (List AxiomRef) SearchResult) -> (List String)))
    (@alloc a)
    (let ((mut out (list-new a String)) (mut i 0) (c (. s counts)))
      (do
        (list-push out "howl-repair 1")
        (list-push out (line a "search-complete" (boolean (. s complete))))
        (list-push out (line a "already-coherent" (boolean (. s already-coherent))))
        (list-push out (line a "unrepairable-by-mappings" (boolean (. s unrepairable))))
        (list-push out (phase-line a "conflicts" (. s conflict-phase)))
        (list-push out (phase-line a "hitting-sets" (. s hitting-phase)))
        (list-push out (phase-line a "verification" (. s verification-phase)))
        (list-push out (line a "preflight-calls" (int-to-string a (. c preflight-calls))))
        (list-push out (line a "conflict-calls" (int-to-string a (. c conflict-calls))))
        (list-push out (line a "conflict-nodes" (int-to-string a (. c conflict-nodes))))
        (list-push out (line a "hitting-nodes" (int-to-string a (. c hitting-nodes))))
        (list-push out (line a "verification-calls" (int-to-string a (. c verification-calls))))
        (list-push out (line a "cache-hits" (int-to-string a (. c cache-hits))))
        (list-push out (line a "search-omitted" (int-to-string a (cast Int (list-len (. s omissions))))))
        (for-each (om (. s omissions)) (list-push out (line a "search-omission" (render-omission a om))))
        (list-push out (line a "mappings" (int-to-string a (cast Int (list-len refs)))))
        (for-each (ref refs)
          (do
            (list-push out (string-concat a (line a "mapping" (int-to-string a i))
              (string-concat a " <" (string-concat a
                (match (. ref source) ((some iri) (. iri value)) ((none) ""))
                (string-concat a "> " (. ref text))))))
            (set! i (+ i 1))))
        (list-push out (line a "verified-repairs" (int-to-string a (cast Int (list-len (. s verified))))))
        (for-each (r (. s verified)) (list-push out (line a "repair" (indices-text a (. r items)))))
        (list-push out (line a "candidates" (int-to-string a (cast Int (list-len (. s candidates))))))
        (for-each (r (. s candidates))
          (list-push out (string-concat a (line a "candidate" (candidate-reason-text (. r reason)))
                           (string-concat a " " (indices-text a (. r removed))))))
        out)))
)
