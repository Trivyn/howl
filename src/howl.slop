;; ============================================================
;; HOWL: a consequence-based description-logic reasoner
;;
;; Classifies a description logic — the complete subsumption
;; hierarchy and coherence of a TBox — including the defined-class
;; entailments that RL materialization structurally cannot see.
;;
;; Sibling to GROWL: GROWL materializes OWL 2 RL, HOWL classifies.
;; They compose through RDF, never through shared internal state.
;; ============================================================

(module howl
  (@doc "Consequence-based description-logic reasoner (v0: ELH⊥R+ with domain/range)")

  (import rdf (Triple IRI))
  (import types (Node RoleId Concept NormAxiom
                 Derived Addressed Context Saturation
                 EntityKind AxiomRef InputRef MissingDeclaration Omission Coverage Termination
                 EdgePair
                 SubPair Findings Outcome Fault Names
                 Profile ProfileSelection ReasonerConfig
                 KName KscAxiom Evidence KscResult
                 default-config emit-edge make-context copy-fault copy-omissions empty-names
                 outcome-is-complete findings-are-incoherent))
  (import normalize (Decoded NormResult decode-document decode-encoded copy-decoded normalize-decoded))
  (import termstore (Encoded))
  (import select (select-profile choose-auto profile-implemented))
  (import saturate (RoundResult saturate))
  (import classify (extract-findings entails-sub extract-ksc-findings))
  (import gate (gate-axioms))
  (import kscnormal (normalize-ksc copy-ksc-axioms copy-kname))
  (import kscsat (ksc-classify input-classes))
  (import premise (RuleIndex build-rule-index))

  (export
    ;; Types (re-exported from types)
    Node
    RoleId
    Concept
    NormAxiom
    Derived
    Addressed
    Context
    Saturation
    EntityKind
    AxiomRef
    InputRef
    Omission
    Coverage
    Termination
    SubPair
    Findings
    Outcome
    Fault
    Profile
    ProfileSelection
    ReasonerConfig
    MissingDeclaration
    ;; Configuration
    default-config
    ;; The pipeline
    classify
    classify-encoded
    release-outcome
    ;; The pipeline, split at the front end (timing seam, §12 M1 (c))
    Decoded
    decode
    decode-from
    own-decoded
    Prepared Work ElWork KscWork
    decode-owned prepare-in-profile
    prepare-decoded
    prepare
    reason
    ;; Verdict (§6.2) — the single statement of the rule
    outcome-is-complete
    findings-are-incoherent
    verdict
    Verdict
    ;; Saturation helpers
    EdgePair
    emit-edge
    make-context)

  ;; ============================================================
  ;; The verdict (§6.2)
  ;;
  ;; | Findings      | Coverage + termination            | Verdict      |
  ;; |---------------|-----------------------------------|--------------|
  ;; | incoherent    | ANYTHING                          | incoherent   |
  ;; | not incoherent| omitted ≠ ∅, or termination ≠ fix | inconclusive |
  ;; | not incoherent| omitted = ∅ AND fixpoint          | coherent     |
  ;;
  ;; The asymmetry between rows 1 and 2 is not a compromise; it falls
  ;; out of MONOTONICITY. Every rule is faithful, so anything in
  ;; findings is sound whatever the coverage; and restoring an omitted
  ;; axiom can only ADD conclusions, never retract one. So a ⊥ derived
  ;; from a subset of the ontology is a ⊥ in the whole ontology.
  ;;
  ;; The same monotonicity is why a partial run may still never report
  ;; a COMPLETE hierarchy or a MINIMAL repair: those are claims about
  ;; absence.
  ;; ============================================================

  (type Verdict (enum
    verdict-coherent       ; exit 0
    verdict-incoherent     ; exit 1
    verdict-inconclusive)) ; exit 2

  (fn verdict ((o Outcome))
    (@intent "Map an Outcome to its verdict — the ONE statement of §6.2's rule")
    (@spec ((Outcome) -> Verdict))
    (@pure)
    ;; THE SAFETY PROPERTY, in machine-checkable form: a coverage gap
    ;; must be unable to produce a COHERENT verdict. This is the false
    ;; pass the whole design exists to prevent — a validator that
    ;; returns "coherent" when it could not actually tell is worse than
    ;; no validator, because CI trains users to trust it.
    ;;
    ;; Provable only because the coverage test below is LOCAL. The WP
    ;; checker does no interprocedural reasoning — it models a callee as
    ;; an uninterpreted function, so delegating the whole test to
    ;; `outcome-is-complete` lets it return True under a non-empty
    ;; omission list and the property fails with exactly that
    ;; counterexample.
    (@post (implies {(list-len (. (. o coverage) omitted)) > 0}
                    {$result != 'verdict-coherent}))
    ;; A finding wins over incomplete coverage, always. Testing
    ;; coverage first would implement an early `inconclusive` that
    ;; DISCARDS a definitive finding — the precise inversion the rule
    ;; forbids, and the one an earlier draft of the spec got wrong.
    (if (findings-are-incoherent (. o findings))
      'verdict-incoherent
      ;; The explicit coverage early-out is REDUNDANT with
      ;; `outcome-is-complete`, which tests the same conjunct — and it
      ;; is kept deliberately. Its job is not to change the answer but
      ;; to put the safety property within reach of the prover: with the
      ;; test local, "a coverage gap cannot yield coherent" is a
      ;; structural fact about this function rather than an inference
      ;; across a call boundary the checker will not make.
      ;;
      ;; Defence in depth on the one property most worth having proved.
      ;; The termination arm stays delegated, so the definition of
      ;; `complete` still lives in one place.
      (if (> (list-len (. (. o coverage) omitted)) 0)
        'verdict-inconclusive
        (if (outcome-is-complete o)
          'verdict-coherent
          'verdict-inconclusive))))

  ;; ============================================================
  ;; The pipeline
  ;;
  ;;   triples → decode    (header, decode: triples to axioms)
  ;;           → prepare   (gate, normalize, init, index)
  ;;           → saturate  (CR1–CR7 to fixpoint or the round cap)
  ;;           → extract   (taxonomy + findings)
  ;;           → Outcome
  ;;
  ;; Input is a flat, COPIED triple buffer, never a store handle, and
  ;; reasoning is pure over it (§8.4). `imports-resolved` is the
  ;; caller's closure attestation: HOWL is network-free and cannot
  ;; resolve owl:imports itself, so the header pre-pass computes
  ;; declared \ attested and puts each shortfall into coverage.omitted
  ;; as `unresolved-import`. The run is then STRUCTURALLY incomplete and
  ;; the verdict rule does the rest — no consumer has to remember to
  ;; check anything.
  ;;
  ;; Be precise about what that catches: FORGETTING, NOT LYING. Once
  ;; documents are flattened into one buffer, nothing ties an import
  ;; IRI to any content, so a caller listing an IRI while supplying
  ;; none of its triples passes silently. The attestation is a TRUST
  ;; BOUNDARY, not a proof.
  ;; ============================================================

  ;; ============================================================
  ;; The pipeline, split where the front end ends
  ;;
  ;; `classify` is `prepare` then `reason`, and nothing else; `prepare`
  ;; is `decode` then `prepare-decoded`. The splits exist for §12 M1 (c):
  ;; the benchmark times CLASSIFICATION FROM AXIOMS IN HAND - the point
  ;; an OWL API caller reaches when its parse returns - and the only
  ;; honest way to measure that from outside the library is a call
  ;; boundary. The clock stays on the caller's side of it — HOWL never
  ;; consults a clock inside a reasoning call (§6.8), so a timing can
  ;; never reach a report.
  ;; ============================================================

  ;; What the front end hands the reasoner: the normalized axioms, the
  ;; initialized saturation (Δ₀ seeded AND committed, §6.3 step 4) and
  ;; the coverage the gate computed.
  ;;
  ;; A Prepared is CONSUMED by `reason`. Saturation grows the context
  ;; store in place — every Set and Map in it is a pointer — so reasoning
  ;; twice over one Prepared would start the second run from the first
  ;; run's fixpoint and report a round count that belongs to neither.
  ;;
  ;; The premise index is built HERE, so `prepare_ms` pays for it. The
  ;; figure compared against ELK is `prepare_ms + reason_ms`, not
  ;; `reason_ms` alone: ELK loads and indexes its axioms lazily, at the
  ;; first query, INSIDE its classification window (bench/bench.py times
  ;; it there), so excluding HOWL's index would compare unlike boundaries.
  ;; `decode_ms` (triples to axioms) is outside it, as the OWL API's
  ;; RDF-to-axiom mapping is outside ELK's, and is reported beside it.
  ;; WHAT EACH CALCULUS NEEDS, as a union: el's renamed axioms, premise
  ;; index and initialized saturation; el++'s normal form (§5.4 K1) and
  ;; the classes the report asks about. Profile, coverage and names are
  ;; common; el++ renames nothing, so its `names` is empty.
  (type ElWork (record
    (axioms     (List NormAxiom))
    (index      RuleIndex)
    (saturation Saturation)))

  (type KscWork (record
    (axioms  (List KscAxiom))
    (classes (List KName))))

  (type Work (union
    (el-work  ElWork)
    (ksc-work KscWork)))

  (type Prepared (record
    (profile    Profile)      ; resolved from the selection before the gate ran
    (work       Work)
    (coverage   Coverage)
    (names      Names)))      ; el's axioms, index and saturation are renamed (types.slop)

  (fn decode ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)))
    (@intent "The front end's first half: header pre-pass and decode, triples to axioms")
    (@spec ((Arena (List Triple) (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    (decode-document arena triples imports-resolved))

  (fn decode-from ((arena Arena) (doc Encoded) (imports-resolved (List IRI)))
    (@intent "The front end's first half over an already encoded document")
    (@spec ((Arena Encoded (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    ;; For a caller that encoded its input as it parsed (the CLI streams
    ;; the Turtle straight into an Encoded): the Decoded's strings are
    ;; `doc`'s dictionary's, so `doc`'s arena must outlive it - or the
    ;; caller takes an owned copy with `own-decoded` and frees `doc`'s
    ;; arena, as the CLI does.
    (decode-encoded arena doc imports-resolved))

  (fn own-decoded ((arena Arena) (r (Result Decoded Fault)))
    (@intent "A decode's result owning every string it holds, so the input's arena can be freed")
    (@spec ((Arena (Result Decoded Fault)) -> (Result Decoded Fault)))
    (@alloc arena)
    ;; THE INPUT GOES BEFORE THE GATE STARTS. A Decoded borrows its IRIs
    ;; from the encoded input, whose arena also holds the id triples, stage
    ;; 0's output and the decode stores: on GO about half a gigabyte, dead
    ;; once decode returns but held through the gate and normalizer. The
    ;; copy is a few percent of that.
    ;; The `ok` arm first: slop types a match's result from its first arm.
    (match r
      ((ok d)    (ok (copy-decoded arena d)))
      ((error f) (error (copy-fault arena f)))))

  (fn decode-owned ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)))
    (@intent "Decode in an arena of its own, freed before returning; the result is owned in arena")
    (@spec ((Arena (List Triple) (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    (let ((front (arena-new 16777216))
          (res   (own-decoded arena (decode front triples imports-resolved))))
      (do
        (arena-free front)
        res)))

  (fn prepare-decoded ((arena Arena) (d Decoded) (config ReasonerConfig))
    (@intent "The front end's second half: resolve the profile, gate, normalize, initialize, index")
    (@spec ((Arena Decoded ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; WHY THE PIPELINE STILL REFUSES ON A FRONT-END FAULT.
    ;; An `input-error` has no verdict to misread; an Outcome would.
    ;; Returning a partial Outcome when the front end could not decode
    ;; the document would present as full coverage over an empty
    ;; saturation, which §6.2's verdict rule reads as a clean
    ;; `coherent` — sound, catastrophically incomplete, and
    ;; indistinguishable from success at every interface. (A decode
    ;; fault never gets here: `decode` returns it.)
    ;;
    ;; THE PROFILE IS RESOLVED FIRST (§5.1). An explicit request for a
    ;; rung that is not built is refused as `unavailable` before any
    ;; work: running `el` in its place would classify a smaller theory
    ;; than was asked for and report it under the wrong name. `auto` is
    ;; resolved from this ontology (auto-profile), and the Prepared
    ;; carries the rung chosen, so the report names what ran.
    (match (select-profile (. config selection))
      ((some profile)
        (if (not (profile-implemented profile))
          (error (union-new Fault unavailable profile))
          (prepare-in-profile arena d config profile)))
      ((none)
        (prepare-in-profile arena d config (auto-profile d)))))

  (fn out-of-profile-count ((oms (List Omission)))
    (@intent "How many omissions are axioms out of the rung's profile")
    (@spec (((List Omission)) -> Int))
    (@pure)
    ;; Unresolved imports and missing declarations are the same under
    ;; every rung, so they never decide between rungs.
    (let ((mut n 0))
      (do
        (for-each (o oms)
          (match o
            ((out-of-profile _)      (set! n (+ n 1)))
            ((unresolved-import _)   (do))
            ((missing-declaration _) (do))))
        n)))

  (fn auto-profile ((d Decoded))
    (@intent "§5.1's auto for this ontology: el if it omits nothing, else whichever of el and el++ omits fewer")
    (@spec ((Decoded) -> Profile))
    ;; The gates run in a scratch arena, freed here: only the counts are
    ;; kept, and the chosen rung's own prepare gates again. el++ is gated
    ;; only when el leaves something out.
    (let ((scratch (arena-new 16777216))
          (out-el  (out-of-profile-count
                     (. (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) 'profile-el) omissions)))
          (out-pp  (if (== out-el 0)
                     0
                     (out-of-profile-count
                       (. (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) 'profile-el-plus-plus)
                          omissions))))
          (chosen  (choose-auto (cast (Int 0 ..) out-el) (cast (Int 0 ..) out-pp))))
      (do
        (arena-free scratch)
        chosen)))

  (fn prepare-in-profile ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "prepare-decoded once the profile is resolved and implemented")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; el++ has its own gate verdicts and normal form (§5.4); el's are
    ;; §5.2's. horn-sriq and sriq never get here: profile-implemented
    ;; refuses them first.
    (match profile
      ('profile-el-plus-plus (prepare-ksc arena d config profile))
      ('profile-el           (prepare-el arena d config profile))
      ('profile-horn-sriq    (prepare-el arena d config profile))
      ('profile-sriq         (prepare-el arena d config profile))))

  (fn strict-refuses ((config ReasonerConfig) (cov Coverage))
    (@intent "--strict refuses a run with any omission")
    (@spec ((ReasonerConfig Coverage) -> Bool))
    (if (. config strict-profile) (> (list-len (. cov omitted)) 0) false))

  (fn prepare-el ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "el's front-end second half: gate, normalize, rename, initialize, index")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;;
    ;; --strict REFUSES AFTER THE GATE, BEFORE SATURATION. The omissions
    ;; are exactly what the caller asked not to run past, so `refused`
    ;; carries them and nothing else: no Outcome, so no verdict and no
    ;; findings a partial run might have produced (§9, §10 item 12).
    ;;
    ;; THE GATE AND THE NORMALIZER RUN IN A SCRATCH ARENA, freed before
    ;; returning: everything in a Prepared - and in the refusal - is built
    ;; in `arena` and owns its strings (normalize-decoded). `d` is the
    ;; caller's and is not freed here.
    (let ((scratch (arena-new 16777216))
          (nr      (normalize-decoded arena scratch d))
          (res     (if (strict-refuses config (. nr coverage))
                     (error (union-new Fault refused (. (. nr coverage) omitted)))
                     (ok (record-new Prepared
                           (profile    profile)
                           (work       (union-new Work el-work
                                         (record-new ElWork
                                           (axioms     (. nr axioms))
                                           (index      (build-rule-index arena (. nr axioms)))
                                           (saturation (. nr saturation)))))
                           (coverage   (. nr coverage))
                           (names      (. nr names)))))))
      (do
        (arena-free scratch)
        res)))

  (fn prepare-ksc ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "el++'s front-end second half: gate under el++, normalize into Definition 1 (§5.4)")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; As prepare-el: the gate and normalizer run in a scratch arena, and
    ;; what the Prepared keeps - the normal form, the queried classes, the
    ;; omissions - is copied into `arena` with its strings.
    (let ((scratch (arena-new 16777216))
          (gr      (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) 'profile-el-plus-plus))
          (cov     (record-new Coverage (omitted (copy-omissions arena (. gr omissions)))))
          (res     (if (strict-refuses config cov)
                     (error (union-new Fault refused (. cov omitted)))
                     (ok (record-new Prepared
                           (profile  profile)
                           (work     (union-new Work ksc-work
                                       (record-new KscWork
                                         (axioms  (copy-ksc-axioms arena
                                                    (. (normalize-ksc scratch (. gr accepted)) axioms)))
                                         (classes (copy-knames arena
                                                    (input-classes scratch (. gr signature)))))))
                           (coverage cov)
                           (names    (empty-names arena)))))))
      (do
        (arena-free scratch)
        res)))

  (fn copy-knames ((arena Arena) (ns (List KName)))
    (@intent "Class names that own their strings")
    (@spec ((Arena (List KName)) -> (List KName)))
    (@alloc arena)
    (let ((mut out (list-new arena KName)))
      (do
        (for-each (n ns) (list-push out (copy-kname arena n)))
        out)))

  (fn prepare ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "The front end: header, decode, gate, normalize, initialize — and --strict's refusal")
    (@spec ((Arena (List Triple) (List IRI) ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;;
    ;; DECODE RUNS IN AN ARENA OF ITS OWN, freed as soon as it returns
    ;; (`decode-owned`): only an owned copy of the Decoded is held through
    ;; the gate and normalizer, and that goes before this returns, so a
    ;; Prepared owns every string it holds and the caller's triples may go
    ;; as soon as this returns. A decode fault's message is copied out.
    (let ((held (arena-new 16777216))
          ;; The `ok` arm first: slop types a match's result from its first
          ;; arm, and an `error` arm first leaves the ok type void in the C.
          (res  (match (decode-owned held triples imports-resolved)
                  ((ok d)    (prepare-decoded arena d config))
                  ((error f) (error (copy-fault arena f))))))
      (do
        (arena-free held)
        res)))

  (fn reason ((arena Arena) (p Prepared) (config ReasonerConfig))
    (@intent "Run a prepared theory's calculus and extract its findings")
    (@spec ((Arena Prepared ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; Coverage travels from the gate UNCHANGED. It is what makes a run
    ;; with omissions report `inconclusive` rather than `coherent`, so
    ;; nothing downstream may quietly empty it.
    (match (. p work)
      ((el-work w)
        (match (saturate arena (. w saturation) (. w index) config)
          ((error f) (error f))
          ((ok rr)
            (ok (record-new Outcome
                  (profile     (. p profile))
                  (coverage    (. p coverage))
                  (termination (. rr termination))
                  (findings    (extract-findings arena (. rr saturation) (. p names)))
                  (evidence    (union-new Evidence el-evidence (. rr saturation)))
                  (rounds      (. (. rr saturation) iteration))
                  (names       (. p names))
                  (owned       (. rr arenas)))))))
      ((ksc-work w)
        (match (ksc-classify arena (. w axioms) (. w classes) config)
          ((error f) (error f))
          ((ok r)
            (ok (record-new Outcome
                  (profile     (. p profile))
                  (coverage    (. p coverage))
                  (termination (. r termination))
                  (findings    (extract-ksc-findings arena r))
                  (evidence    (union-new Evidence ksc-evidence r))
                  (rounds      (. r rounds))
                  (names       (. p names))
                  (owned       (list-new arena Arena)))))))))

  (fn classify ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "Classify a TBox: coherence, unsatisfiable classes, and the subsumption hierarchy")
    (@spec ((Arena (List Triple) (List IRI) ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; The port's entry point. It stays one call, so the library path
    ;; cannot drift from the CLI's timed path: both are these two calls.
    (match (prepare arena triples imports-resolved config)
      ((error f) (error f))
      ((ok p)    (reason arena p config))))

  (fn release-outcome ((o Outcome))
    (@intent "Free the arenas an Outcome's evidence lives in beyond the caller's")
    (@spec ((Outcome) -> Unit))
    ;; For a host that classifies more than once (the Rust crate): el's
    ;; store grows in commit arenas of its own and its last queues in their
    ;; generation's, and `evidence` reads them, so they cannot go before
    ;; the Outcome is done with - on GO, ~80 MB a run. Afterwards
    ;; `evidence` must not be read; the findings, coverage and the report
    ;; lines are in the caller's arena and stay valid. A process that exits
    ;; (the CLI) need not call it.
    (for-each (a (. o owned)) (arena-free a)))

  (fn prepare-encoded ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "The front end over an encoded document, owning everything it returns")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; The CLI's `decode-held` and `prepare-from` as one call. `doc` is only
    ;; read: decode's working memory is a scratch arena of its own, freed
    ;; once the owned copy is taken, and the owned Decoded is freed once
    ;; prepared - so `doc` can be prepared again.
    (let ((held  (arena-new 16777216))
          (front (arena-new 16777216))
          (d     (own-decoded held (decode-from front doc imports-resolved))))
      (do
        (arena-free front)
        ;; The `ok` arm first: slop types a match's result from its first arm.
        (let ((res (match d
                     ((ok dd)   (prepare-decoded arena dd config))
                     ((error f) (error (copy-fault arena f))))))
          (do
            (arena-free held)
            res)))))

  (fn classify-encoded ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "Classify an encoded document: the CLI's path, as one call")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; The entry point for a host that encodes its input as the CLI does
    ;; (the Rust crate, rust/csrc_shim.c). With `prepare-encoded` it is the
    ;; CLI's `decode-held`, `prepare-from` and `reason-prepared`, so a host's
    ;; report is the CLI's report and the CLI's goldens certify it.
    (match (prepare-encoded arena doc imports-resolved config)
      ((error f) (error f))
      ((ok p)    (reason arena p config))))
)
