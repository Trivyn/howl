;; ============================================================
;; HOWL: a consequence-based description-logic reasoner
;;
;; Classifies a description logic — the complete subsumption
;; hierarchy and coherence of a TBox — including the defined-class
;; entailments that RL materialization structurally cannot see.
;;
;; Sibling to GROWL: GROWL materializes OWL 2 RL, HOWL classifies.
;; They compose through RDF, never through shared internal state.
;; ============================================================

(module howl
  (@doc "Consequence-based description-logic reasoner (v0: ELH⊥R+ with domain/range)")

  (import rdf (Triple IRI Term TermKind make-iri make-blank make-literal make-triple))
  (import ttl (parse-ttl-string-for-each-triple))
  (import report (report-lines node-text))
  (import owl2 (render-omission))
  (import types (Node RoleId Concept NormAxiom
                 Derived Addressed Context Saturation
                 EntityKind AxiomRef InputRef MissingDeclaration Omission Coverage Termination
                 EdgePair
                 SubPair Findings Outcome Fault Names Verdict verdict
                 Profile ProfileSelection ReasonerConfig
                 KName KscAxiom Evidence KscResult
                 default-config emit-edge make-context copy-fault copy-omissions empty-names
                 outcome-is-complete findings-are-incoherent))
  (import normalize (Decoded NormResult decode-document decode-encoded copy-decoded normalize-decoded))
  (import termstore (Encoded new-encoded encoded-add encoded-next-document))
  (import select (select-profile choose-auto profile-implemented))
  (import saturate (RoundResult saturate reuse-arena))
  (import classify (extract-findings entails-sub extract-ksc-findings))
  (import gate (gate-axioms))
  (import kscnormal (normalize-ksc copy-ksc-axioms copy-kname))
  (import kscsat (ksc-classify input-classes))
  (import premise (RuleIndex build-rule-index))

  (export
    ;; Types (re-exported from types)
    Node
    RoleId
    Concept
    NormAxiom
    Derived
    Addressed
    Context
    Saturation
    EntityKind
    AxiomRef
    InputRef
    Omission
    Coverage
    Termination
    SubPair
    Findings
    Outcome
    Fault
    Profile
    ProfileSelection
    ReasonerConfig
    MissingDeclaration
    ;; Configuration
    default-config
    ;; The pipeline
    classify
    classify-encoded
    release-outcome
    ;; The public C API (`:c-name`; slop generates include/howl.h from it)
    Input Run Options TermIn TurtleResult FaultKind
    input-new input-free input-begin-document input-add-triple input-add-turtle
    input-attest-import
    default-options run-classify run-free
    run-ok run-fault run-fault-message run-fault-profile
    run-profile run-verdict run-inconsistent run-termination run-rounds
    run-unsat-len run-unsat run-sub-len run-sub run-super
    run-omission-len run-omission run-report-len run-report-line
    ;; The pipeline, split at the front end (timing seam, §12 M1 (c))
    Decoded
    decode
    decode-from
    own-decoded
    Prepared Work ElWork KscWork
    decode-owned prepare-in-profile
    prepare-decoded
    prepare
    reason
    ;; Verdict (§6.2) — the single statement of the rule
    outcome-is-complete
    findings-are-incoherent
    verdict
    Verdict
    ;; Saturation helpers
    EdgePair
    emit-edge
    make-context)

  ;; ============================================================
  ;; The pipeline
  ;;
  ;;   triples → decode    (header, decode: triples to axioms)
  ;;           → prepare   (gate, normalize, init, index)
  ;;           → saturate  (CR1–CR7 to fixpoint or the round cap)
  ;;           → extract   (taxonomy + findings)
  ;;           → Outcome
  ;;
  ;; Input is a flat, COPIED triple buffer, never a store handle, and
  ;; reasoning is pure over it (§8.4). `imports-resolved` is the
  ;; caller's closure attestation: HOWL is network-free and cannot
  ;; resolve owl:imports itself, so the header pre-pass computes
  ;; declared \ attested and puts each shortfall into coverage.omitted
  ;; as `unresolved-import`. The run is then STRUCTURALLY incomplete and
  ;; the verdict rule does the rest — no consumer has to remember to
  ;; check anything.
  ;;
  ;; Be precise about what that catches: FORGETTING, NOT LYING. Once
  ;; documents are flattened into one buffer, nothing ties an import
  ;; IRI to any content, so a caller listing an IRI while supplying
  ;; none of its triples passes silently. The attestation is a TRUST
  ;; BOUNDARY, not a proof.
  ;; ============================================================

  ;; ============================================================
  ;; The pipeline, split where the front end ends
  ;;
  ;; `classify` is `prepare` then `reason`, and nothing else; `prepare`
  ;; is `decode` then `prepare-decoded`. The splits exist for §12 M1 (c):
  ;; the benchmark times CLASSIFICATION FROM AXIOMS IN HAND - the point
  ;; an OWL API caller reaches when its parse returns - and the only
  ;; honest way to measure that from outside the library is a call
  ;; boundary. The clock stays on the caller's side of it — HOWL never
  ;; consults a clock inside a reasoning call (§6.8), so a timing can
  ;; never reach a report.
  ;; ============================================================

  ;; What the front end hands the reasoner: the normalized axioms, the
  ;; initialized saturation (Δ₀ seeded AND committed, §6.3 step 4) and
  ;; the coverage the gate computed.
  ;;
  ;; A Prepared is CONSUMED by `reason`. Saturation grows the context
  ;; store in place — every Set and Map in it is a pointer — so reasoning
  ;; twice over one Prepared would start the second run from the first
  ;; run's fixpoint and report a round count that belongs to neither.
  ;;
  ;; The premise index is built HERE, so `prepare_ms` pays for it. The
  ;; figure compared against ELK is `prepare_ms + reason_ms`, not
  ;; `reason_ms` alone: ELK loads and indexes its axioms lazily, at the
  ;; first query, INSIDE its classification window (bench/bench.py times
  ;; it there), so excluding HOWL's index would compare unlike boundaries.
  ;; `decode_ms` (triples to axioms) is outside it, as the OWL API's
  ;; RDF-to-axiom mapping is outside ELK's, and is reported beside it.
  ;; WHAT EACH CALCULUS NEEDS, as a union: el's renamed axioms, premise
  ;; index and initialized saturation; el++'s normal form (§5.4 K1) and
  ;; the classes the report asks about. Profile, coverage and names are
  ;; common; el++ renames nothing, so its `names` is empty.
  (type ElWork (record
    (axioms     (List NormAxiom))
    (index      RuleIndex)
    (saturation Saturation)))

  (type KscWork (record
    (axioms  (List KscAxiom))
    (classes (List KName))))

  (type Work (union
    (el-work  ElWork)
    (ksc-work KscWork)))

  (type Prepared (record
    (profile    Profile)      ; resolved from the selection before the gate ran
    (work       Work)
    (coverage   Coverage)
    (names      Names)))      ; el's axioms, index and saturation are renamed (types.slop)

  (fn decode ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)))
    (@intent "The front end's first half: header pre-pass and decode, triples to axioms")
    (@spec ((Arena (List Triple) (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    (decode-document arena triples imports-resolved))

  (fn decode-from ((arena Arena) (doc Encoded) (imports-resolved (List IRI)))
    (@intent "The front end's first half over an already encoded document")
    (@spec ((Arena Encoded (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    ;; For a caller that encoded its input as it parsed (the CLI streams
    ;; the Turtle straight into an Encoded): the Decoded's strings are
    ;; `doc`'s dictionary's, so `doc`'s arena must outlive it - or the
    ;; caller takes an owned copy with `own-decoded` and frees `doc`'s
    ;; arena, as the CLI does.
    (decode-encoded arena doc imports-resolved))

  (fn own-decoded ((arena Arena) (r (Result Decoded Fault)))
    (@intent "A decode's result owning every string it holds, so the input's arena can be freed")
    (@spec ((Arena (Result Decoded Fault)) -> (Result Decoded Fault)))
    (@alloc arena)
    ;; THE INPUT GOES BEFORE THE GATE STARTS. A Decoded borrows its IRIs
    ;; from the encoded input, whose arena also holds the id triples, stage
    ;; 0's output and the decode stores: on GO about half a gigabyte, dead
    ;; once decode returns but held through the gate and normalizer. The
    ;; copy is a few percent of that.
    ;; The `ok` arm first: slop types a match's result from its first arm.
    (match r
      ((ok d)    (ok (copy-decoded arena d)))
      ((error f) (error (copy-fault arena f)))))

  (fn decode-owned ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)))
    (@intent "Decode in an arena of its own, freed before returning; the result is owned in arena")
    (@spec ((Arena (List Triple) (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    (let ((front (arena-new 16777216))
          (res   (own-decoded arena (decode front triples imports-resolved))))
      (do
        (arena-free front)
        res)))

  (fn prepare-decoded ((arena Arena) (d Decoded) (config ReasonerConfig))
    (@intent "The front end's second half: resolve the profile, gate, normalize, initialize, index")
    (@spec ((Arena Decoded ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; WHY THE PIPELINE STILL REFUSES ON A FRONT-END FAULT.
    ;; An `input-error` has no verdict to misread; an Outcome would.
    ;; Returning a partial Outcome when the front end could not decode
    ;; the document would present as full coverage over an empty
    ;; saturation, which §6.2's verdict rule reads as a clean
    ;; `coherent` — sound, catastrophically incomplete, and
    ;; indistinguishable from success at every interface. (A decode
    ;; fault never gets here: `decode` returns it.)
    ;;
    ;; THE PROFILE IS RESOLVED FIRST (§5.1). An explicit request for a
    ;; rung that is not built is refused as `unavailable` before any
    ;; work: running `el` in its place would classify a smaller theory
    ;; than was asked for and report it under the wrong name. `auto` is
    ;; resolved from this ontology (auto-profile), and the Prepared
    ;; carries the rung chosen, so the report names what ran.
    (match (select-profile (. config selection))
      ((some profile)
        (if (not (profile-implemented profile))
          (error (union-new Fault unavailable profile))
          (prepare-in-profile arena d config profile)))
      ((none)
        (prepare-in-profile arena d config (auto-profile d)))))

  (fn out-of-profile-count ((oms (List Omission)))
    (@intent "How many omissions are axioms out of the rung's profile")
    (@spec (((List Omission)) -> Int))
    (@pure)
    ;; Unresolved imports and missing declarations are the same under
    ;; every rung, so they never decide between rungs.
    (let ((mut n 0))
      (do
        (for-each (o oms)
          (match o
            ((out-of-profile _)      (set! n (+ n 1)))
            ((unresolved-import _)   (do))
            ((missing-declaration _) (do))))
        n)))

  (fn auto-profile ((d Decoded))
    (@intent "§5.1's auto for this ontology: el if it omits nothing, else whichever of el and el++ omits fewer")
    (@spec ((Decoded) -> Profile))
    ;; The gates run in a scratch arena, freed here: only the counts are
    ;; kept, and the chosen rung's own prepare gates again. el++ is gated
    ;; only when el leaves something out.
    (let ((scratch (arena-new 16777216))
          (out-el  (out-of-profile-count
                     (. (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) 'profile-el) omissions)))
          (out-pp  (if (== out-el 0)
                     0
                     (out-of-profile-count
                       (. (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) 'profile-el-plus-plus)
                          omissions))))
          (chosen  (choose-auto (cast (Int 0 ..) out-el) (cast (Int 0 ..) out-pp))))
      (do
        (arena-free scratch)
        chosen)))

  (fn prepare-in-profile ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "prepare-decoded once the profile is resolved and implemented")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; el++ has its own gate verdicts and normal form (§5.4); el's are
    ;; §5.2's. horn-sriq and sriq never get here: profile-implemented
    ;; refuses them first.
    (match profile
      ('profile-el-plus-plus (prepare-ksc arena d config profile))
      ('profile-el           (prepare-el arena d config profile))
      ('profile-horn-sriq    (prepare-el arena d config profile))
      ('profile-sriq         (prepare-el arena d config profile))))

  (fn strict-refuses ((config ReasonerConfig) (cov Coverage))
    (@intent "--strict refuses a run with any omission")
    (@spec ((ReasonerConfig Coverage) -> Bool))
    (if (. config strict-profile) (> (list-len (. cov omitted)) 0) false))

  (fn prepare-el ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "el's front-end second half: gate, normalize, rename, initialize, index")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;;
    ;; --strict REFUSES AFTER THE GATE, BEFORE SATURATION. The omissions
    ;; are exactly what the caller asked not to run past, so `refused`
    ;; carries them and nothing else: no Outcome, so no verdict and no
    ;; findings a partial run might have produced (§9, §10 item 12).
    ;;
    ;; THE GATE AND THE NORMALIZER RUN IN A SCRATCH ARENA, freed before
    ;; returning: everything in a Prepared - and in the refusal - is built
    ;; in `arena` and owns its strings (normalize-decoded). `d` is the
    ;; caller's and is not freed here.
    (let ((scratch (arena-new 16777216))
          (nr      (normalize-decoded arena scratch d))
          (res     (if (strict-refuses config (. nr coverage))
                     (error (union-new Fault refused (. (. nr coverage) omitted)))
                     (ok (record-new Prepared
                           (profile    profile)
                           (work       (union-new Work el-work
                                         (record-new ElWork
                                           (axioms     (. nr axioms))
                                           (index      (build-rule-index arena (. nr axioms)))
                                           (saturation (. nr saturation)))))
                           (coverage   (. nr coverage))
                           (names      (. nr names)))))))
      (do
        (arena-free scratch)
        res)))

  (fn prepare-ksc ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "el++'s front-end second half: gate under el++, normalize into Definition 1 (§5.4)")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; As prepare-el: the gate and normalizer run in a scratch arena, and
    ;; what the Prepared keeps - the normal form, the queried classes, the
    ;; omissions - is copied into `arena` with its strings.
    (let ((scratch (arena-new 16777216))
          (gr      (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) 'profile-el-plus-plus))
          (cov     (record-new Coverage (omitted (copy-omissions arena (. gr omissions)))))
          (res     (if (strict-refuses config cov)
                     (error (union-new Fault refused (. cov omitted)))
                     (ok (record-new Prepared
                           (profile  profile)
                           (work     (union-new Work ksc-work
                                       (record-new KscWork
                                         (axioms  (copy-ksc-axioms arena
                                                    (. (normalize-ksc scratch (. gr accepted)) axioms)))
                                         (classes (copy-knames arena
                                                    (input-classes scratch (. gr signature)))))))
                           (coverage cov)
                           (names    (empty-names arena)))))))
      (do
        (arena-free scratch)
        res)))

  (fn copy-knames ((arena Arena) (ns (List KName)))
    (@intent "Class names that own their strings")
    (@spec ((Arena (List KName)) -> (List KName)))
    (@alloc arena)
    (let ((mut out (list-new arena KName)))
      (do
        (for-each (n ns) (list-push out (copy-kname arena n)))
        out)))

  (fn prepare ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "The front end: header, decode, gate, normalize, initialize — and --strict's refusal")
    (@spec ((Arena (List Triple) (List IRI) ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;;
    ;; DECODE RUNS IN AN ARENA OF ITS OWN, freed as soon as it returns
    ;; (`decode-owned`): only an owned copy of the Decoded is held through
    ;; the gate and normalizer, and that goes before this returns, so a
    ;; Prepared owns every string it holds and the caller's triples may go
    ;; as soon as this returns. A decode fault's message is copied out.
    (let ((held (arena-new 16777216))
          ;; The `ok` arm first: slop types a match's result from its first
          ;; arm, and an `error` arm first leaves the ok type void in the C.
          (res  (match (decode-owned held triples imports-resolved)
                  ((ok d)    (prepare-decoded arena d config))
                  ((error f) (error (copy-fault arena f))))))
      (do
        (arena-free held)
        res)))

  (fn reason ((arena Arena) (p Prepared) (config ReasonerConfig))
    (@intent "Run a prepared theory's calculus and extract its findings")
    (@spec ((Arena Prepared ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; Coverage travels from the gate UNCHANGED. It is what makes a run
    ;; with omissions report `inconclusive` rather than `coherent`, so
    ;; nothing downstream may quietly empty it.
    (match (. p work)
      ((el-work w)
        (match (saturate arena (. w saturation) (. w index) config)
          ((error f) (error f))
          ((ok rr)
            (ok (record-new Outcome
                  (profile     (. p profile))
                  (coverage    (. p coverage))
                  (termination (. rr termination))
                  (findings    (extract-findings arena (. rr saturation) (. p names)))
                  (evidence    (union-new Evidence el-evidence (. rr saturation)))
                  (rounds      (. (. rr saturation) iteration))
                  (names       (. p names))
                  (owned       (. rr arenas)))))))
      ((ksc-work w)
        (match (ksc-classify arena (. w axioms) (. w classes) config)
          ((error f) (error f))
          ((ok r)
            (ok (record-new Outcome
                  (profile     (. p profile))
                  (coverage    (. p coverage))
                  (termination (. r termination))
                  (findings    (extract-ksc-findings arena r))
                  (evidence    (union-new Evidence ksc-evidence r))
                  (rounds      (. r rounds))
                  (names       (. p names))
                  (owned       (list-new arena Arena)))))))))

  (fn classify ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "Classify a TBox: coherence, unsatisfiable classes, and the subsumption hierarchy")
    (@spec ((Arena (List Triple) (List IRI) ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; The port's entry point. It stays one call, so the library path
    ;; cannot drift from the CLI's timed path: both are these two calls.
    (match (prepare arena triples imports-resolved config)
      ((error f) (error f))
      ((ok p)    (reason arena p config))))

  (fn release-outcome ((o Outcome))
    (@intent "Free the arenas an Outcome's evidence lives in beyond the caller's")
    (@spec ((Outcome) -> Unit))
    ;; For a host that classifies more than once (the Rust crate): el's
    ;; store grows in commit arenas of its own and its last queues in their
    ;; generation's, and `evidence` reads them, so they cannot go before
    ;; the Outcome is done with - on GO, ~80 MB a run. Afterwards
    ;; `evidence` must not be read; the findings, coverage and the report
    ;; lines are in the caller's arena and stay valid. A process that exits
    ;; (the CLI) need not call it.
    (for-each (a (. o owned)) (arena-free a)))

  (fn prepare-encoded ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "The front end over an encoded document, owning everything it returns")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; The CLI's `decode-held` and `prepare-from` as one call. `doc` is only
    ;; read: decode's working memory is a scratch arena of its own, freed
    ;; once the owned copy is taken, and the owned Decoded is freed once
    ;; prepared - so `doc` can be prepared again.
    (let ((held  (arena-new 16777216))
          (front (arena-new 16777216))
          (d     (own-decoded held (decode-from front doc imports-resolved))))
      (do
        (arena-free front)
        ;; The `ok` arm first: slop types a match's result from its first arm.
        (let ((res (match d
                     ((ok dd)   (prepare-decoded arena dd config))
                     ((error f) (error (copy-fault arena f))))))
          (do
            (arena-free held)
            res)))))

  (fn classify-encoded ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "Classify an encoded document: the CLI's path, as one call")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; The entry point for a host that encodes its input as the CLI does
    ;; (the Rust crate, rust/csrc_shim.c). With `prepare-encoded` it is the
    ;; CLI's `decode-held`, `prepare-from` and `reason-prepared`, so a host's
    ;; report is the CLI's report and the CLI's goldens certify it.
    (match (prepare-encoded arena doc imports-resolved config)
      ((error f) (error f))
      ((ok p)    (reason arena p config))))

  ;; ============================================================
  ;; The public C API
  ;;
  ;; Every function below carries a `:c-name`, and that is what makes it
  ;; public: slop's header generator (`slop build`, and `make csrc` through
  ;; csrc/generate_c.py) writes include/howl.h from exactly the `:c-name`
  ;; functions and the types their signatures reach.
  ;;
  ;; HANDLES ARE OPAQUE. An Input or a Run is one `(Ptr Void)` field, so the
  ;; header holds `void*` and nothing behind it. An Outcome embeds its whole
  ;; Saturation or KscResult by value; were it reachable from a signature,
  ;; dozens of engine-internal structs would land in the header and change
  ;; with every engine change - the GROWL 0.6.0 wrong-offset hazard for
  ;; every mirror of them. Behind each handle is a state record in an arena
  ;; of its own, which `*-free` frees.
  ;;
  ;; THE INPUT IS ENCODED AS THE CLI ENCODES IT (`encoded-add`, and
  ;; `encoded-next-document` between documents) and classified by
  ;; `classify-encoded`, the CLI's own path as one call, so the CLI's
  ;; goldens certify a caller's report byte for byte (rust/tests/goldens.rs).
  ;;
  ;; EVERY ACCESSOR IS TOTAL. Asked of a faulted run, the verdict is
  ;; inconclusive - never a pass - and every list is empty.
  ;; ============================================================

  (type Input (record (p (Ptr Void))))
  (type Run   (record (p (Ptr Void))))

  (type InputState (record
    (arena     Arena)              ; the Encoded and the attested IRIs; the state itself
    (scratch   Arena)              ; one triple's terms at a time, emptied after each
    (enc       (Ptr Encoded))
    (imports   (List IRI))
    (documents Int)
    (failed    (Option String))))  ; set: a document or term was refused, and the input with it

  ;; The options a caller sets. Plain integers, not SLOP's range types: a
  ;; C caller can hand over any value, and an out-of-range one is refused
  ;; by name (fault-invalid-options) rather than narrowed into range.
  (type Options (record
    (workers        Int)           ; 1..64; never changes the report
    (max-iterations Int)           ; 0..10000 rounds
    (profile        Profile)       ; ignored when auto-select is set
    (auto-select    Bool)          ; the cheapest built profile covering the ontology
    (cancel         I64)))         ; address of a uint32 flag, 0 for none; read at round boundaries

  ;; An RDF term. An empty `datatype` or `lang` is absent - neither may be
  ;; empty in RDF. `blank` is a blank node's id within its document.
  (type TermIn (record
    (kind     TermKind)
    (blank    Int)
    (value    String)
    (datatype String)
    (lang     String)))

  (type TurtleResult (record
    (ok      Bool)
    (message String)               ; owned by the input
    (line    Int)
    (column  Int)))

  (type FaultKind (enum
    fault-none                     ; the run has a result
    fault-cancelled                ; no partial result: where it stopped depends on scheduling
    fault-input-error
    fault-unavailable              ; the profile asked for is not built yet
    fault-invalid-options))

  (type RunState (record
    (arena         Arena)
    (outcome       (Option Outcome))
    (fault         FaultKind)
    (message       String)
    (fault-profile Profile)
    (verdict       Verdict)
    (lines         (List String))))

  (fn input-state ((in Input))
    (@intent "The state behind an Input handle")
    (@spec ((Input) -> (Ptr InputState)))
    (cast (Ptr InputState) (. in p)))

  (fn run-state ((r Run))
    (@intent "The state behind a Run handle")
    (@spec ((Run) -> RunState))
    (deref (cast (Ptr RunState) (. r p))))

  (fn input-new ()
    (@intent "An empty input")
    (@spec (() -> Input))
    :c-name "howl_input_new"
    (let ((a (arena-new 16777216))
          (p (cast (Ptr InputState) (arena-alloc a (sizeof InputState)))))
      (do
        (set! (deref p) (record-new InputState
                          (arena     a)
                          (scratch   (arena-new 1048576))
                          (enc       (new-encoded a))
                          (imports   (list-new a IRI))
                          (documents 0)
                          (failed    (none))))
        (record-new Input (p (cast (Ptr Void) p))))))

  (fn input-free ((in Input))
    (@intent "Free an input and everything added to it")
    (@spec ((Input) -> Unit))
    :c-name "howl_input_free"
    (let ((s (deref (input-state in))))
      (do
        (arena-free (. s scratch))
        (arena-free (. s arena)))))

  (fn input-begin-document ((in Input))
    (@intent "Begin the next document: its blank nodes are kept apart from the ones before")
    (@spec ((Input) -> Unit))
    :c-name "howl_input_begin_document"
    ;; As `howl validate ROOT -I FILE` does: every document after the first
    ;; has its blank ids shifted past everything already encoded.
    (let ((p (input-state in))
          (mut s (deref p)))
      (do
        (when (> (. s documents) 0)
          (encoded-next-document (. s arena) (. s enc)))
        (set! s documents (+ (. s documents) 1))
        (set! (deref p) s))))

  (fn optional-string ((s String))
    (@intent "An empty string as absent")
    (@spec ((String) -> (Option String)))
    (if (== (string-len s) 0) (none) (some s)))

  (fn make-term ((arena Arena) (t TermIn))
    (@intent "A slop-rdf term from a TermIn, or none for a kind HOWL does not take as input")
    (@spec ((Arena TermIn) -> (Option Term)))
    (@alloc arena)
    (match (. t kind)
      ('iri     (some (make-iri arena (. t value))))
      ;; Bounded, not just non-negative: every later document's ids are
      ;; shifted past the highest one so far (encoded-next-document), and
      ;; an id near the top of Int would overflow that shift.
      ('blank   (if (and (>= (. t blank) 0) (<= (. t blank) 1099511627775))
                  (some (make-blank arena (cast (Int 0 ..) (. t blank))))
                  (none)))
      ('literal (some (make-literal arena (. t value)
                        (optional-string (. t datatype)) (optional-string (. t lang)))))
      ('triple  (none))))

  (fn input-add-triple ((in Input) (s TermIn) (p TermIn) (o TermIn))
    (@intent "Add one triple to the current document; false, and the input refused, for a term it cannot take")
    (@spec ((Input TermIn TermIn TermIn) -> Bool))
    :c-name "howl_input_add_triple"
    ;; The terms are built in the scratch arena and emptied after the call:
    ;; `encoded-add` copies every string it keeps into the input's arena.
    (let ((ptr (input-state in))
          (mut st (deref ptr))
          (sc (. st scratch))
          (ok (match (make-term sc s)
                ((none) false)
                ((some ts)
                  (match (make-term sc p)
                    ((none) false)
                    ((some tp)
                      (match (make-term sc o)
                        ((none) false)
                        ((some to)
                          (do (encoded-add (. st arena) (. st enc) (make-triple sc ts tp to))
                              true)))))))))
      (do
        (reuse-arena sc)
        (when (not ok)
          (do
            (set! st failed (some "a term of a kind HOWL does not take (a quoted triple, or a blank id outside 0..2^40-1)"))
            (set! (deref ptr) st)))
        ok)))

  (fn input-add-turtle ((in Input) (text String))
    (@intent "Add one Turtle document; a document that does not parse refuses the input")
    (@spec ((Input String) -> TurtleResult))
    :c-name "howl_input_add_turtle"
    ;; As the CLI's `parse-into`: slop-rdf's streaming parser, its memory a
    ;; scratch arena freed on return; only what `encoded-add` copies
    ;; survives. The triples before a parse error stay encoded, which is
    ;; why the input is refused rather than classified short.
    (do
      (input-begin-document in)
      (if (== (string-len text) 0)
        (record-new TurtleResult (ok true) (message "") (line 0) (column 0))
        (let ((ptr   (input-state in))
              (mut st (deref ptr))
              (arena (. st arena))
              (enc   (. st enc))
              (parse (arena-new 16777216))
              (res   (match (parse-ttl-string-for-each-triple parse text
                              (fn ((t Triple)) (encoded-add arena enc t)))
                       ((ok _)    (record-new TurtleResult (ok true) (message "") (line 0) (column 0)))
                       ((error e) (record-new TurtleResult
                                    (ok      false)
                                    (message (string-concat arena "" (. e message)))
                                    (line    (. (. e position) line))
                                    (column  (. (. e position) column)))))))
          (do
            (arena-free parse)
            (when (not (. res ok))
              (do
                (set! st failed (some (string-concat arena "a Turtle document does not parse: " (. res message))))
                (set! (deref ptr) st)))
            res)))))

  (fn input-attest-import ((in Input) (iri String))
    (@intent "Attest that an owl:imports target is resolved: its document has been added")
    (@spec ((Input String) -> Unit))
    :c-name "howl_input_attest_import"
    ;; This catches forgetting, not lying: nothing ties the IRI to any
    ;; triples once documents are merged.
    (let ((ptr (input-state in))
          (mut st (deref ptr)))
      (do
        (list-push (. st imports) (record-new IRI (value (string-concat (. st arena) "" iri))))
        (set! (deref ptr) st))))

  (fn default-options ()
    (@intent "The engine's defaults as Options: explicit el, 4 workers, 1000 rounds")
    (@spec (() -> Options))
    :c-name "howl_default_options"
    (let ((c (default-config)))
      (record-new Options
        (workers        (cast Int (. c worker-count)))
        (max-iterations (cast Int (. c max-iterations)))
        (profile        (match (. c selection) ((explicit p) p) ((auto) 'profile-el)))
        (auto-select    (match (. c selection) ((explicit _) false) ((auto) true)))
        (cancel         (. c cancel-ptr)))))

  (fn options-problem ((o Options))
    (@intent "Why options cannot run, or none")
    (@spec ((Options) -> (Option String)))
    (@post (match $result
             ((none) (and {(. o workers) >= 1} {(. o workers) <= 64}
                          {(. o max-iterations) >= 0} {(. o max-iterations) <= 10000}))
             ((some _) true)))
    (if (< (. o workers) 1) (some "workers must be 1..64")
      (if (> (. o workers) 64) (some "workers must be 1..64")
        (if (< (. o max-iterations) 0) (some "max_iterations must be 0..10000")
          (if (> (. o max-iterations) 10000) (some "max_iterations must be 0..10000")
            (none))))))

  (fn options-config ((o Options))
    (@intent "The engine's config for in-range options: always non-strict")
    (@spec ((Options) -> ReasonerConfig))
    (@pre {(. o workers) >= 1})
    (@pre {(. o workers) <= 64})
    (@pre {(. o max-iterations) >= 0})
    (@pre {(. o max-iterations) <= 10000})
    ;; The library always runs non-strict (SPEC §8.4): an omission is a
    ;; report, not a refusal.
    (let ((mut c (default-config)))
      (do
        (set! c worker-count (cast (Int 1 .. 64) (. o workers)))
        (set! c max-iterations (cast (Int 0 .. 10000) (. o max-iterations)))
        (set! c selection (if (. o auto-select)
                            (union-new ProfileSelection auto)
                            (union-new ProfileSelection explicit (. o profile))))
        (set! c strict-profile false)
        (set! c cancel-ptr (. o cancel))
        c)))

  (fn new-run ((a Arena) (st RunState))
    (@intent "A Run handle over state stored in its own arena")
    (@spec ((Arena RunState) -> Run))
    (let ((p (cast (Ptr RunState) (arena-alloc a (sizeof RunState)))))
      (do
        (set! (deref p) st)
        (record-new Run (p (cast (Ptr Void) p))))))

  (fn faulted ((a Arena) (kind FaultKind) (message String) (profile Profile))
    (@intent "A run with no result")
    (@spec ((Arena FaultKind String Profile) -> Run))
    (new-run a (record-new RunState
                 (arena a) (outcome (none)) (fault kind) (message message)
                 (fault-profile profile) (verdict 'verdict-inconclusive)
                 (lines (list-new a String)))))

  (fn run-classify ((in Input) (o Options))
    (@intent "Classify an input: coherence, unsatisfiable classes, and the subsumption hierarchy")
    (@spec ((Input Options) -> Run))
    :c-name "howl_run_classify"
    ;; The input is only read, and can be classified again.
    (let ((a  (arena-new 16777216))
          (st (deref (input-state in))))
      (match (options-problem o)
        ((some why) (faulted a 'fault-invalid-options why (. o profile)))
        ((none)
          (match (. st failed)
            ;; Copied: `why` lives in the input's arena, and a run's
            ;; strings must outlive the input (until run-free).
            ((some why) (faulted a 'fault-input-error (string-concat a "" why) (. o profile)))
            ((none)
              (match (classify-encoded a (deref (. st enc)) (. st imports) (options-config o))
                ((ok out)
                  (new-run a (record-new RunState
                               (arena a) (outcome (some out)) (fault 'fault-none) (message "")
                               (fault-profile (. out profile)) (verdict (verdict out))
                               (lines (report-lines a out)))))
                ((error f)
                  (match f
                    ((cancelled)       (faulted a 'fault-cancelled "" (. o profile)))
                    ((input-error m)   (faulted a 'fault-input-error m (. o profile)))
                    ((unavailable p)   (faulted a 'fault-unavailable "" p))
                    ;; Only a strict run refuses, and this API never runs
                    ;; strict; should it happen it is an input error, never
                    ;; a verdict.
                    ((refused _)       (faulted a 'fault-input-error "refused under a strict profile" (. o profile))))))))))))

  (fn run-free ((r Run))
    (@intent "Free a run and every string it returned")
    (@spec ((Run) -> Unit))
    :c-name "howl_run_free"
    ;; el's store and last queues live in arenas of the engine's own, which
    ;; the Outcome carries; they go first, then the run's own arena.
    (let ((st (run-state r)))
      (do
        (match (. st outcome)
          ((some o) (release-outcome o))
          ((none)   (do)))
        (arena-free (. st arena)))))

  (fn run-ok ((r Run))
    (@intent "Whether the run has a result")
    (@spec ((Run) -> Bool))
    :c-name "howl_run_ok"
    (match (. (run-state r) outcome) ((some _) true) ((none) false)))

  (fn run-fault ((r Run))
    (@intent "Why the run has no result, or fault-none")
    (@spec ((Run) -> FaultKind))
    :c-name "howl_run_fault"
    (. (run-state r) fault))

  (fn run-fault-message ((r Run))
    (@intent "The fault's message: the input error or the option out of range")
    (@spec ((Run) -> String))
    :c-name "howl_run_fault_message"
    (. (run-state r) message))

  (fn run-fault-profile ((r Run))
    (@intent "The profile a fault-unavailable run asked for")
    (@spec ((Run) -> Profile))
    :c-name "howl_run_fault_profile"
    (. (run-state r) fault-profile))

  (fn run-profile ((r Run))
    (@intent "The profile that ran")
    (@spec ((Run) -> Profile))
    :c-name "howl_run_profile"
    (. (run-state r) fault-profile))

  (fn run-verdict ((r Run))
    (@intent "The run's verdict (§6.2); inconclusive for a run with no result")
    (@spec ((Run) -> Verdict))
    :c-name "howl_run_verdict"
    (. (run-state r) verdict))

  (fn run-inconsistent ((r Run))
    (@intent "Whether the ontology was found inconsistent")
    (@spec ((Run) -> Bool))
    :c-name "howl_run_inconsistent"
    (match (. (run-state r) outcome) ((some o) (. (. o findings) inconsistent)) ((none) false)))

  (fn run-termination ((r Run))
    (@intent "How the run ended: fixpoint, or the round budget ran out")
    (@spec ((Run) -> Termination))
    :c-name "howl_run_termination"
    (match (. (run-state r) outcome)
      ((some o) (. o termination))
      ((none)   (union-new Termination resource-limit 0))))

  (fn run-rounds ((r Run))
    (@intent "Rounds run (the report's `rounds` line)")
    (@spec ((Run) -> Int))
    :c-name "howl_run_rounds"
    (match (. (run-state r) outcome) ((some o) (. o rounds)) ((none) 0)))

  (fn run-unsat-len ((r Run))
    (@intent "How many named classes are unsatisfiable")
    (@spec ((Run) -> Int))
    :c-name "howl_run_unsat_len"
    (match (. (run-state r) outcome)
      ((some o) (cast Int (list-len (. (. o findings) unsatisfiable))))
      ((none)   0)))

  (fn run-unsat ((r Run) (i Int))
    (@intent "The i-th unsatisfiable class's IRI, in canonical order")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_unsat"
    (match (. (run-state r) outcome)
      ((some o) (match (list-get (. (. o findings) unsatisfiable) i) ((some c) (. c value)) ((none) "")))
      ((none)   "")))

  (fn run-sub-len ((r Run))
    (@intent "How many (sub, super) pairs the taxonomy has")
    (@spec ((Run) -> Int))
    :c-name "howl_run_sub_len"
    (match (. (run-state r) outcome)
      ((some o) (cast Int (list-len (. (. o findings) subsumptions))))
      ((none)   0)))

  (fn run-sub ((r Run) (i Int))
    (@intent "The i-th pair's subclass, rendered as the report's `sub` line renders it")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_sub"
    (let ((st (run-state r)))
      (match (. st outcome)
        ((some o) (match (list-get (. (. o findings) subsumptions) i)
                    ((some sp) (node-text (. st arena) (. sp sub)))
                    ((none)    "")))
        ((none)   ""))))

  (fn run-super ((r Run) (i Int))
    (@intent "The i-th pair's superclass, rendered as the report's `sub` line renders it")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_super"
    (let ((st (run-state r)))
      (match (. st outcome)
        ((some o) (match (list-get (. (. o findings) subsumptions) i)
                    ((some sp) (node-text (. st arena) (. sp super)))
                    ((none)    "")))
        ((none)   ""))))

  (fn run-omission-len ((r Run))
    (@intent "How many inputs the run did not cover; any makes a clean run inconclusive")
    (@spec ((Run) -> Int))
    :c-name "howl_run_omission_len"
    (match (. (run-state r) outcome)
      ((some o) (cast Int (list-len (. (. o coverage) omitted))))
      ((none)   0)))

  (fn run-omission ((r Run) (i Int))
    (@intent "The i-th omission, rendered as the report's `omission` line renders it")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_omission"
    (let ((st (run-state r)))
      (match (. st outcome)
        ((some o) (match (list-get (. (. o coverage) omitted) i)
                    ((some om) (render-omission (. st arena) om))
                    ((none)    "")))
        ((none)   ""))))

  (fn run-report-len ((r Run))
    (@intent "How many lines the canonical report has")
    (@spec ((Run) -> Int))
    :c-name "howl_run_report_len"
    (cast Int (list-len (. (run-state r) lines))))

  (fn run-report-line ((r Run) (i Int))
    (@intent "The canonical report's i-th line: the bytes `howl validate --report` prints")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_report_line"
    (match (list-get (. (run-state r) lines) i) ((some l) l) ((none) "")))
)
