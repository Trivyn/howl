;; ============================================================
;; HOWL: a consequence-based description-logic reasoner
;;
;; Classifies a description logic — the complete subsumption
;; hierarchy and coherence of a TBox — including the defined-class
;; entailments that RL materialization structurally cannot see.
;;
;; Sibling to GROWL: GROWL materializes OWL 2 RL, HOWL classifies.
;; They compose through RDF, never through shared internal state.
;; ============================================================

(module howl
  (@doc "Consequence-based description-logic reasoner (v0: ELH⊥R+ with domain/range)")

  (import rdf (Triple IRI Term TermKind make-iri make-blank make-literal make-triple))
  (import ttl (parse-ttl-string-for-each-triple))
  (import report (report-lines probe-lines answer-lines node-text))
  (import probe (QueryKind ProbeAnswer Query Answered Probing sort-queries probe-document answer-queries))
  (import locality (module-decoded))
  (import owl2 (render-omission))
  (import types (Node RoleId Concept NormAxiom
                 Derived Addressed Context Saturation
                 EntityKind AxiomRef InputRef MissingDeclaration Omission Coverage Termination
                 EdgePair
                 SubPair Findings Outcome Fault Names Verdict verdict
                 Profile ProfileSelection ReasonerConfig
                 KName KscAxiom Evidence KscResult SriqEvidence
                 default-config emit-edge make-context copy-fault copy-omissions empty-names copy-iri copy-string
                 outcome-is-complete findings-are-incoherent))
  (import normalize (Decoded NormResult decode-document decode-encoded copy-decoded normalize-decoded))
  (import termstore (Encoded new-encoded encoded-add encoded-next-document))
  (import select (select-profile choose-auto choose-auto-low profile-implemented unavailable-message))
  (import saturate (RoundResult saturate reuse-arena))
  (import classify (extract-findings entails-sub extract-ksc-findings))
  (import gate (gate-axioms axiom-input-ref omission-origins))
  (import canon (sort-omissions omission-cmp))
  (import owl2 (RawAxiom))
  (import strlib (index-of substring))
  (import sriqclauses (SriqIds))
  (import sriqref (RefIn RefStatus copy-clauses))
  (import sriqabox (Inputs SplitRun split-inputs split-run-of split-findings sriq-config))
  (import kscnormal (normalize-ksc copy-ksc-axioms copy-kname))
  (import kscsat (ksc-classify input-classes))
  (import premise (RuleIndex build-rule-index))

  (export
    ;; Types (re-exported from types)
    Node
    RoleId
    Concept
    NormAxiom
    Derived
    Addressed
    Context
    Saturation
    EntityKind
    AxiomRef
    InputRef
    Omission
    Coverage
    Termination
    SubPair
    Findings
    Outcome
    Fault
    Profile
    ProfileSelection
    ReasonerConfig
    MissingDeclaration
    ;; Configuration
    default-config
    ;; The pipeline
    classify
    classify-encoded
    release-outcome
    ;; The public C API (`:c-name`; slop generates include/howl.h from it)
    Input Run Options TermIn TurtleResult FaultKind
    input-new input-free input-begin-document input-add-triple input-add-turtle
    input-attest-import
    default-options run-classify run-free
    run-ok run-fault run-fault-message run-fault-profile
    run-profile run-verdict run-inconsistent run-termination run-rounds
    run-unsat-len run-unsat run-sub-len run-sub run-super
    run-omission-len run-omission run-report-len run-report-line
    DocumentSource run-omission-kind run-omission-entity-kind run-omission-document
    ;; The pipeline, split at the front end (timing seam, §12 M1 (c))
    Decoded
    decode
    decode-from
    own-decoded
    Prepared Work ElWork KscWork
    decode-owned prepare-in-profile sriq-omissions
    prepare-decoded
    prepare
    reason
    ;; Verdict (§6.2) — the single statement of the rule
    outcome-is-complete
    findings-are-incoherent
    verdict
    Verdict
    ;; Saturation helpers
    EdgePair
    emit-edge
    make-context)

  ;; ============================================================
  ;; The pipeline
  ;;
  ;;   triples → decode    (header, decode: triples to axioms)
  ;;           → prepare   (gate, normalize, init, index)
  ;;           → saturate  (CR1–CR7 to fixpoint or the round cap)
  ;;           → extract   (taxonomy + findings)
  ;;           → Outcome
  ;;
  ;; Input is a flat, COPIED triple buffer, never a store handle, and
  ;; reasoning is pure over it (§8.4). `imports-resolved` is the
  ;; caller's closure attestation: HOWL is network-free and cannot
  ;; resolve owl:imports itself, so the header pre-pass computes
  ;; declared \ attested and puts each shortfall into coverage.omitted
  ;; as `unresolved-import`. The run is then STRUCTURALLY incomplete and
  ;; the verdict rule does the rest — no consumer has to remember to
  ;; check anything.
  ;;
  ;; Be precise about what that catches: FORGETTING, NOT LYING. Once
  ;; documents are flattened into one buffer, nothing ties an import
  ;; IRI to any content, so a caller listing an IRI while supplying
  ;; none of its triples passes silently. The attestation is a TRUST
  ;; BOUNDARY, not a proof.
  ;; ============================================================

  ;; ============================================================
  ;; The pipeline, split where the front end ends
  ;;
  ;; `classify` is `prepare` then `reason`, and nothing else; `prepare`
  ;; is `decode` then `prepare-decoded`. The splits exist for §12 M1 (c):
  ;; the benchmark times CLASSIFICATION FROM AXIOMS IN HAND - the point
  ;; an OWL API caller reaches when its parse returns - and the only
  ;; honest way to measure that from outside the library is a call
  ;; boundary. The clock stays on the caller's side of it — HOWL never
  ;; consults a clock inside a reasoning call (§6.8), so a timing can
  ;; never reach a report.
  ;; ============================================================

  ;; What the front end hands the reasoner: the normalized axioms, the
  ;; initialized saturation (Δ₀ seeded AND committed, §6.3 step 4) and
  ;; the coverage the gate computed.
  ;;
  ;; A Prepared is CONSUMED by `reason`. Saturation grows the context
  ;; store in place — every Set and Map in it is a pointer — so reasoning
  ;; twice over one Prepared would start the second run from the first
  ;; run's fixpoint and report a round count that belongs to neither.
  ;;
  ;; The premise index is built HERE, so `prepare_ms` pays for it. The
  ;; figure compared against ELK is `prepare_ms + reason_ms`, not
  ;; `reason_ms` alone: ELK loads and indexes its axioms lazily, at the
  ;; first query, INSIDE its classification window (bench/bench.py times
  ;; it there), so excluding HOWL's index would compare unlike boundaries.
  ;; `decode_ms` (triples to axioms) is outside it, as the OWL API's
  ;; RDF-to-axiom mapping is outside ELK's, and is reported beside it.
  ;; WHAT EACH CALCULUS NEEDS, as a union: el's renamed axioms, premise
  ;; index and initialized saturation; el++'s normal form (§5.4 K1) and
  ;; the classes the report asks about. Profile, coverage and names are
  ;; common; el++ renames nothing, so its `names` is empty.
  (type ElWork (record
    (axioms     (List NormAxiom))
    (index      RuleIndex)
    (saturation Saturation)))

  (type KscWork (record
    (axioms  (List KscAxiom))
    (classes (List KName))))

  ;; sriq's (§5.5, the ABox split): both runs' clauses as the calculus
  ;; reads them, and the query classes' IRIs by id, for the findings.
  (type SriqWork (record
    (h       RefIn)
    (c       RefIn)
    (has-c   Bool)
    (classes (List IRI))
    (step    (Option StepDown))))   ; auto's step-down (§5.1), when auto chose sriq

  ;; What auto steps down to when sriq's run passes the clause budget
  ;; without a definitive finding: the rung el and el++ alone would choose,
  ;; and the input, owned, to prepare it from. Only an auto run keeps it.
  (type StepDown (record
    (profile Profile)
    (decoded Decoded)))

  ;; auto's choice (§5.1), and the rung it steps down to if that is sriq.
  (type AutoChoice (record
    (profile Profile)
    (low     Profile)))

  (type Work (union
    (el-work   ElWork)
    (ksc-work  KscWork)
    (sriq-work SriqWork)))

  (type Prepared (record
    (profile    Profile)      ; resolved from the selection before the gate ran
    (work       Work)
    (coverage   Coverage)
    (names      Names)))      ; el's axioms, index and saturation are renamed (types.slop)

  (fn decode ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)))
    (@intent "The front end's first half: header pre-pass and decode, triples to axioms")
    (@spec ((Arena (List Triple) (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    (decode-document arena triples imports-resolved))

  (fn decode-from ((arena Arena) (doc Encoded) (imports-resolved (List IRI)))
    (@intent "The front end's first half over an already encoded document")
    (@spec ((Arena Encoded (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    ;; For a caller that encoded its input as it parsed (the CLI streams
    ;; the Turtle straight into an Encoded): the Decoded's strings are
    ;; `doc`'s dictionary's, so `doc`'s arena must outlive it - or the
    ;; caller takes an owned copy with `own-decoded` and frees `doc`'s
    ;; arena, as the CLI does.
    (decode-encoded arena doc imports-resolved))

  (fn own-decoded ((arena Arena) (r (Result Decoded Fault)))
    (@intent "A decode's result owning every string it holds, so the input's arena can be freed")
    (@spec ((Arena (Result Decoded Fault)) -> (Result Decoded Fault)))
    (@alloc arena)
    ;; THE INPUT GOES BEFORE THE GATE STARTS. A Decoded borrows its IRIs
    ;; from the encoded input, whose arena also holds the id triples, stage
    ;; 0's output and the decode stores: on GO about half a gigabyte, dead
    ;; once decode returns but held through the gate and normalizer. The
    ;; copy is a few percent of that.
    ;; The `ok` arm first: slop types a match's result from its first arm.
    (match r
      ((ok d)    (ok (copy-decoded arena d)))
      ((error f) (error (copy-fault arena f)))))

  (fn decode-owned ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)))
    (@intent "Decode in an arena of its own, freed before returning; the result is owned in arena")
    (@spec ((Arena (List Triple) (List IRI)) -> (Result Decoded Fault)))
    (@alloc arena)
    (let ((front (arena-new 16777216))
          (res   (own-decoded arena (decode front triples imports-resolved))))
      (do
        (arena-free front)
        res)))

  (fn prepare-decoded ((arena Arena) (d Decoded) (config ReasonerConfig))
    (@intent "The front end's second half: resolve the profile, gate, normalize, initialize, index")
    (@spec ((Arena Decoded ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; WHY THE PIPELINE STILL REFUSES ON A FRONT-END FAULT.
    ;; An `input-error` has no verdict to misread; an Outcome would.
    ;; Returning a partial Outcome when the front end could not decode
    ;; the document would present as full coverage over an empty
    ;; saturation, which §6.2's verdict rule reads as a clean
    ;; `coherent` — sound, catastrophically incomplete, and
    ;; indistinguishable from success at every interface. (A decode
    ;; fault never gets here: `decode` returns it.)
    ;;
    ;; THE PROFILE IS RESOLVED FIRST (§5.1). An explicit request for a
    ;; rung that is not built is refused as `unavailable` before any
    ;; work: running `el` in its place would classify a smaller theory
    ;; than was asked for and report it under the wrong name. `auto` is
    ;; resolved from this ontology (auto-profile), and the Prepared
    ;; carries the rung chosen, so the report names what ran.
    (match (select-profile (. config selection))
      ((some profile)
        (if (not (profile-implemented profile))
          (error (union-new Fault unavailable profile))
          (prepare-sourced arena d config profile)))
      ((none)
        (let ((ch (auto-profile d)))
          (match (prepare-sourced arena d config (. ch profile))
            ((ok p)    (ok (with-step-down arena p d (. ch low))))
            ((error f) (error f)))))))

  (fn with-step-down ((arena Arena) (p Prepared) (d Decoded) (low Profile))
    (@intent "An auto run's Prepared: under sriq, it keeps the input, owned, and the rung to step down to")
    (@spec ((Arena Prepared Decoded Profile) -> Prepared))
    (@alloc arena)
    ;; The copy costs a Decoded's size for the run's length, and only an
    ;; auto run that chose sriq pays it.
    (match (. p work)
      ((sriq-work w)
        (record-new Prepared
          (profile  (. p profile))
          (work     (union-new Work sriq-work
                      (record-new SriqWork (h (. w h)) (c (. w c)) (has-c (. w has-c)) (classes (. w classes))
                                           (step (some (record-new StepDown (profile low)
                                                                            (decoded (copy-decoded arena d))))))))
          (coverage (. p coverage))
          (names    (. p names))))
      (_ p)))

  (fn out-of-profile-count ((oms (List Omission)))
    (@intent "How many omissions are axioms out of the rung's profile")
    (@spec (((List Omission)) -> Int))
    (@pure)
    ;; Unresolved imports, missing declarations and undeclared properties
    ;; are the same under every rung, so they never decide between rungs.
    (let ((mut n 0))
      (do
        (for-each (o oms)
          (match o
            ((out-of-profile _)      (set! n (+ n 1)))
            ((unresolved-import _)   (do))
            ((missing-declaration _) (do))
            ((undeclared-property _) (do))))
        n)))

  (fn auto-profile ((d Decoded))
    (@intent "§5.1's auto for this ontology: the first of el, el++, sriq that omits nothing, else the one omitting
              fewest; and the rung el and el++ alone would choose, for the step-down")
    (@spec ((Decoded) -> AutoChoice))
    ;; The gates run in a scratch arena, freed here: only the counts are
    ;; kept, and the chosen rung's own prepare gates again. Each rung is
    ;; gated only when the ones before it leave something out. The counts
    ;; are the gate's: S1's guard is a size limit, not a language, and
    ;; does not decide between rungs.
    (let ((scratch (arena-new 16777216))
          (out-el  (rung-count scratch d 'profile-el))
          (out-pp  (if (== out-el 0) 0 (rung-count scratch d 'profile-el-plus-plus)))
          (out-sq  (if (== out-pp 0) 0 (rung-count scratch d 'profile-sriq)))
          (chosen  (record-new AutoChoice
                     (profile (choose-auto (cast (Int 0 ..) out-el) (cast (Int 0 ..) out-pp) (cast (Int 0 ..) out-sq)))
                     (low     (choose-auto-low (cast (Int 0 ..) out-el) (cast (Int 0 ..) out-pp))))))
      (do
        (arena-free scratch)
        chosen)))

  (fn rung-count ((scratch Arena) (d Decoded) (p Profile))
    (@intent "How many logical axioms p's gate leaves out of profile")
    (@spec ((Arena Decoded Profile) -> Int))
    (@alloc scratch)
    (out-of-profile-count (. (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) p) omissions)))

  (fn prepare-in-profile ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "prepare-decoded once the profile is resolved and implemented")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; el++ has its own gate verdicts and normal form (§5.4), sriq its
    ;; own and the ABox split (§5.5); el's are §5.2's. horn-sriq (dropped)
    ;; never gets here: profile-implemented refuses it first.
    (match profile
      ('profile-el-plus-plus (prepare-ksc arena d config profile))
      ('profile-el           (prepare-el arena d config profile))
      ('profile-horn-sriq    (prepare-el arena d config profile))
      ('profile-sriq         (prepare-sriq arena d config profile))))

  (fn prepare-sourced ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "prepare-in-profile, each omission given the document it came from (issue #67)")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; After the gate, over the coverage it produced: the omissions are
    ;; exactly what they were, and their documents are found beside them
    ;; (gate.slop, omission-origins). el's gate runs under el for
    ;; horn-sriq too (normalize-decoded), so its axioms expand as el's.
    (match (prepare-in-profile arena d config profile)
      ((ok p)
        (let ((scratch (arena-new 16777216))
              (gp      (match (. p profile)
                         ('profile-el-plus-plus 'profile-el-plus-plus)
                         ('profile-sriq         'profile-sriq)
                         ('profile-el           'profile-el)
                         ('profile-horn-sriq    'profile-el)))
              (origins (omission-origins arena scratch (. (. p coverage) omitted)
                         (. d axioms) (. d axiom-docs) (. d omissions) (. d omission-docs)
                         (. d documents) gp)))
          (do
            (arena-free scratch)
            (ok (record-new Prepared
                  (profile  (. p profile))
                  (work     (. p work))
                  (coverage (record-new Coverage (omitted (. (. p coverage) omitted)) (origins origins)))
                  (names    (. p names)))))))
      ((error f) (error f))))

  (fn strict-refuses ((config ReasonerConfig) (cov Coverage))
    (@intent "--strict refuses a run with any omission")
    (@spec ((ReasonerConfig Coverage) -> Bool))
    (if (. config strict-profile) (> (list-len (. cov omitted)) 0) false))

  (fn prepare-el ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "el's front-end second half: gate, normalize, rename, initialize, index")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;;
    ;; --strict REFUSES AFTER THE GATE, BEFORE SATURATION. The omissions
    ;; are exactly what the caller asked not to run past, so `refused`
    ;; carries them and nothing else: no Outcome, so no verdict and no
    ;; findings a partial run might have produced (§9, §10 item 12).
    ;;
    ;; THE GATE AND THE NORMALIZER RUN IN A SCRATCH ARENA, freed before
    ;; returning: everything in a Prepared - and in the refusal - is built
    ;; in `arena` and owns its strings (normalize-decoded). `d` is the
    ;; caller's and is not freed here.
    (let ((scratch (arena-new 16777216))
          (nr      (normalize-decoded arena scratch d))
          (res     (if (strict-refuses config (. nr coverage))
                     (error (union-new Fault refused (. (. nr coverage) omitted)))
                     (ok (record-new Prepared
                           (profile    profile)
                           (work       (union-new Work el-work
                                         (record-new ElWork
                                           (axioms     (. nr axioms))
                                           (index      (build-rule-index arena (. nr axioms)))
                                           (saturation (. nr saturation)))))
                           (coverage   (. nr coverage))
                           (names      (. nr names)))))))
      (do
        (arena-free scratch)
        res)))

  (fn prepare-ksc ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "el++'s front-end second half: gate under el++, normalize into Definition 1 (§5.4)")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; As prepare-el: the gate and normalizer run in a scratch arena, and
    ;; what the Prepared keeps - the normal form, the queried classes, the
    ;; omissions - is copied into `arena` with its strings.
    (let ((scratch (arena-new 16777216))
          (gr      (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) 'profile-el-plus-plus))
          (cov     (record-new Coverage (omitted (copy-omissions arena (. gr omissions)))
                                        (origins (list-new arena Int))))
          (res     (if (strict-refuses config cov)
                     (error (union-new Fault refused (. cov omitted)))
                     (ok (record-new Prepared
                           (profile  profile)
                           (work     (union-new Work ksc-work
                                       (record-new KscWork
                                         (axioms  (copy-ksc-axioms arena
                                                    (. (normalize-ksc scratch (. gr accepted)) axioms)))
                                         (classes (copy-knames arena
                                                    (input-classes scratch (. gr signature)))))))
                           (coverage cov)
                           (names    (empty-names arena)))))))
      (do
        (arena-free scratch)
        res)))

  (fn prepare-sriq ((arena Arena) (d Decoded) (config ReasonerConfig) (profile Profile))
    (@intent "sriq's front-end second half: gate under sriq, the ABox split, normalize both runs (§5.5)")
    (@spec ((Arena Decoded ReasonerConfig Profile) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; As prepare-ksc: the gate, the split and the normaliser run in a
    ;; scratch arena, and what the Prepared keeps (both runs' clauses, the
    ;; query classes, the omissions) is copied into `arena`. A normaliser
    ;; refusal (an input it cannot read) is an input-error.
    (let ((scratch (arena-new 16777216))
          (gr      (gate-axioms scratch (. d axioms) (. d signature) (. d omissions) 'profile-sriq))
          (res     (match (split-inputs scratch gr)
                     ((ok in)    (sriq-prepared arena config profile (. gr omissions) in))
                     ((error m)  (error (union-new Fault input-error (copy-string arena m)))))))
      (do
        (arena-free scratch)
        res)))

  (fn sriq-prepared ((arena Arena) (config ReasonerConfig) (profile Profile) (gate-oms (List Omission)) (in Inputs))
    (@intent "The Prepared for a split: coverage is the gate's omissions and every chain S1's guard set aside, sorted,
              each once; --strict refuses any")
    (@spec ((Arena ReasonerConfig Profile (List Omission) Inputs) -> (Result Prepared Fault)))
    (@alloc arena)
    (let ((cov (record-new Coverage (omitted (sriq-omissions arena gate-oms (. in omitted)))
                                    (origins (list-new arena Int)))))
      (if (strict-refuses config cov)
        (error (union-new Fault refused (. cov omitted)))
        (ok (record-new Prepared
              (profile  profile)
              (work     (union-new Work sriq-work
                          (record-new SriqWork (h (copy-refin arena (. in h))) (c (copy-refin arena (. in c)))
                                               (has-c (. in has-c)) (classes (query-iris arena (. in ids)))
                                               (step (none)))))
              (coverage cov)
              (names    (empty-names arena)))))))

  (fn sriq-omissions ((arena Arena) (gate-oms (List Omission)) (s1 (List RawAxiom)))
    (@intent "The gate's omissions and S1's guard's (each an out-of-profile axiom), copied into arena, sorted, each once")
    (@spec ((Arena (List Omission) (List RawAxiom)) -> (List Omission)))
    (@alloc arena)
    (let ((mut all (list-new arena Omission)))
      (do (for-each (o gate-oms) (list-push all o))
          (for-each (a s1) (list-push all (union-new Omission out-of-profile (axiom-input-ref arena a))))
          (distinct-omissions arena (sort-omissions arena (copy-omissions arena all))))))

  (fn distinct-omissions ((arena Arena) (os (List Omission)))
    (@intent "os (sorted) with each omission once: the two runs' guards can set the same chain aside")
    (@spec ((Arena (List Omission)) -> (List Omission)))
    (@alloc arena)
    (let ((mut out (list-new arena Omission)))
      (do (for-each (o os)
            (match (list-get out (- (cast Int (list-len out)) 1))
              ((some last) (when (!= (omission-cmp last o) 0) (list-push out o)))
              ((none) (list-push out o))))
          out)))

  (fn copy-refin ((arena Arena) (in RefIn))
    (@intent "in, its clauses and hidden ids copied into arena")
    (@spec ((Arena RefIn) -> RefIn))
    (@alloc arena)
    (let ((mut hid (list-new arena U32)))
      (do (for-each (h (. in hidden)) (list-push hid h))
          (record-new RefIn (onto (copy-clauses arena (. in onto))) (nclass (. in nclass)) (nquery (. in nquery))
                            (nrole (. in nrole)) (nfn (. in nfn)) (nconst (. in nconst)) (hidden hid)))))

  (fn query-iris ((arena Arena) (ids SriqIds))
    (@intent "The query classes' IRIs by id (0 to nclass - 1, the input's class names), owning their strings")
    (@spec ((Arena SriqIds) -> (List IRI)))
    (@alloc arena)
    (let ((mut out (list-new arena IRI)) (mut b 0))
      (do (for-each (n (. ids class-of))
            (do (when (< b (. ids nclass))
                  (match n ((dn-class i) (list-push out (copy-iri arena i))) ((dn-fresh _) (do))))
                (set! b (+ b 1))))
          out)))

  (fn copy-knames ((arena Arena) (ns (List KName)))
    (@intent "Class names that own their strings")
    (@spec ((Arena (List KName)) -> (List KName)))
    (@alloc arena)
    (let ((mut out (list-new arena KName)))
      (do
        (for-each (n ns) (list-push out (copy-kname arena n)))
        out)))

  (fn prepare ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "The front end: header, decode, gate, normalize, initialize — and --strict's refusal")
    (@spec ((Arena (List Triple) (List IRI) ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;;
    ;; DECODE RUNS IN AN ARENA OF ITS OWN, freed as soon as it returns
    ;; (`decode-owned`): only an owned copy of the Decoded is held through
    ;; the gate and normalizer, and that goes before this returns, so a
    ;; Prepared owns every string it holds and the caller's triples may go
    ;; as soon as this returns. A decode fault's message is copied out.
    (let ((held (arena-new 16777216))
          ;; The `ok` arm first: slop types a match's result from its first
          ;; arm, and an `error` arm first leaves the ok type void in the C.
          (res  (match (decode-owned held triples imports-resolved)
                  ((ok d)    (prepare-decoded arena d config))
                  ((error f) (error (copy-fault arena f))))))
      (do
        (arena-free held)
        res)))

  (fn reason ((arena Arena) (p Prepared) (config ReasonerConfig))
    (@intent "Run a prepared theory's calculus and extract its findings")
    (@spec ((Arena Prepared ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; Coverage travels from the gate UNCHANGED. It is what makes a run
    ;; with omissions report `inconclusive` rather than `coherent`, so
    ;; nothing downstream may quietly empty it.
    (match (. p work)
      ((el-work w)
        (match (saturate arena (. w saturation) (. w index) config)
          ((error f) (error f))
          ((ok rr)
            (ok (record-new Outcome
                  (profile     (. p profile))
                  (coverage    (. p coverage))
                  (termination (. rr termination))
                  (findings    (extract-findings arena (. rr saturation) (. p names)))
                  (evidence    (union-new Evidence el-evidence (. rr saturation)))
                  (rounds      (. (. rr saturation) iteration))
                  (names       (. p names))
                  (owned       (. rr arenas))
                  (stepped-down false))))))
      ((ksc-work w)
        (match (ksc-classify arena (. w axioms) (. w classes) config)
          ((error f) (error f))
          ((ok r)
            (ok (record-new Outcome
                  (profile     (. p profile))
                  (coverage    (. p coverage))
                  (termination (. r termination))
                  (findings    (extract-ksc-findings arena r))
                  (evidence    (union-new Evidence ksc-evidence r))
                  (rounds      (. r rounds))
                  (names       (. p names))
                  (owned       (list-new arena Arena))
                  (stepped-down false))))))
      ((sriq-work w) (sriq-reason arena p w config))))

  (fn sriq-reason ((arena Arena) (p Prepared) (w SriqWork) (config ReasonerConfig))
    (@intent "sriq's run (§5.5): Run H, then Run C on what H left of the round budget, under the clause budget; the
              split's verdict; Fault::cancelled when the host cancels")
    (@spec ((Arena Prepared SriqWork ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; The termination is fixpoint only when every run that ran finished
    ;; (its fixpoint, or ⊤ → ⊥); a round cap or the clause budget is
    ;; resource-limit. An inconsistency is definitive whatever stopped the
    ;; other run, and §6.2's verdict reads it from the findings.
    (let ((sp (split-run-of arena (. w h) (. w c) (. w has-c) false
                            (sriq-config (cast Int (. config max-iterations)) (cast Int (. config clause-budget)) (. config cancel-ptr)))))
      (if (. sp cancelled)
        (error (union-new Fault cancelled))
        (let ((o (sriq-outcome arena p w sp)))
          (match (. w step)
            ((some s) (if (steps-down sp o) (step-down arena s config) (ok o)))
            ((none)   (ok o)))))))

  (fn steps-down ((sp SplitRun) (o Outcome))
    (@intent "Does auto step down (§5.1)? The run passed the clause budget, and found nothing definitive")
    (@spec ((SplitRun Outcome) -> Bool))
    ;; A round cap is the caller's, and is reported as it binds; only the
    ;; budget means the calculus is too expensive for this input. An
    ;; inconsistency or an unsatisfiable class is definitive (§6.2), and
    ;; the run that found it is reported.
    (and (or (over-budget (. (. (. sp h) res) status))
             (and (. sp ran-c) (over-budget (. (. (. sp c) res) status))))
         (not (findings-are-incoherent (. o findings)))))

  (fn over-budget ((s RefStatus))
    (@intent "Did the clause budget stop the run: its stored clauses, or one rule instance's choices (SPEC 5.5)?")
    (@spec ((RefStatus) -> Bool))
    (@pure)
    (or (== s 'rs-clauses) (== s 'rs-product)))

  (fn step-down ((arena Arena) (s StepDown) (config ReasonerConfig))
    (@intent "auto's step-down: the input prepared and run under the rung el and el++ alone would choose")
    (@spec ((Arena StepDown ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; The rerun has the whole round budget: it is the run that answers.
    (match (prepare-sourced arena (. s decoded) config (. s profile))
      ((ok lp)
        (match (reason arena lp config)
          ((ok o)    (ok (stepped arena o)))
          ((error f) (error f))))
      ((error f) (error f))))

  (fn stepped ((arena Arena) (o Outcome))
    (@intent "o, marked as auto's step-down")
    (@spec ((Arena Outcome) -> Outcome))
    (@alloc arena)
    (record-new Outcome
      (profile     (. o profile))
      (coverage    (. o coverage))
      (termination (. o termination))
      (findings    (. o findings))
      (evidence    (. o evidence))
      (rounds      (. o rounds))
      (names       (. o names))
      (owned       (. o owned))
      (stepped-down true)))

  (fn sriq-outcome ((arena Arena) (p Prepared) (w SriqWork) (sp SplitRun))
    (@intent "The Outcome of a split run that was not cancelled")
    (@spec ((Arena Prepared SriqWork SplitRun) -> Outcome))
    (@alloc arena)
    (record-new Outcome
      (profile     (. p profile))
      (coverage    (. p coverage))
      (termination (if (. sp finished)
                     (union-new Termination fixpoint)
                     (union-new Termination resource-limit (cast (Int 0 ..) (. sp rounds)))))
      (findings    (split-findings arena (. (. (. sp h) res) st) (. w classes) (. sp inconsistent)))
      (evidence    (union-new Evidence sriq-evidence
                     (record-new SriqEvidence (h-rounds (. (. (. sp h) res) rounds))
                                              (c-rounds (if (. sp ran-c) (. (. (. sp c) res) rounds) 0))
                                              (ran-c (. sp ran-c)))))
      (rounds      (. sp rounds))
      (names       (. p names))
      (owned       (list-new arena Arena))
      (stepped-down false)))

  (fn classify ((arena Arena) (triples (List Triple)) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "Classify a TBox: coherence, unsatisfiable classes, and the subsumption hierarchy")
    (@spec ((Arena (List Triple) (List IRI) ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; The port's entry point. It stays one call, so the library path
    ;; cannot drift from the CLI's timed path: both are these two calls.
    (match (prepare arena triples imports-resolved config)
      ((error f) (error f))
      ((ok p)    (reason arena p config))))

  (fn release-outcome ((o Outcome))
    (@intent "Free the arenas an Outcome's evidence lives in beyond the caller's")
    (@spec ((Outcome) -> Unit))
    ;; For a host that classifies more than once (the Rust crate): el's
    ;; store grows in commit arenas of its own and its last queues in their
    ;; generation's, and `evidence` reads them, so they cannot go before
    ;; the Outcome is done with - on GO, ~80 MB a run. Afterwards
    ;; `evidence` must not be read; the findings, coverage and the report
    ;; lines are in the caller's arena and stay valid. A process that exits
    ;; (the CLI) need not call it.
    (for-each (a (. o owned)) (arena-free a)))

  (fn prepare-encoded ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "The front end over an encoded document, owning everything it returns")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    (prepare-encoded-within arena doc imports-resolved config false (list-new arena IRI)))

  (fn prepare-encoded-within ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig)
                              (modular Bool) (seed (List IRI)))
    (@intent "The front end over an encoded document, or, when modular, over its ⊥-locality module for seed (SPEC §8.4)")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig Bool (List IRI)) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; The CLI's `decode-held` and `prepare-from` as one call. `doc` is only
    ;; read: decode's working memory is a scratch arena of its own, freed
    ;; once the owned copy is taken, and the owned Decoded is freed once
    ;; prepared - so `doc` can be prepared again. With a seed, the module
    ;; is taken between decode and the gate, so `auto` gates the module.
    (let ((held  (arena-new 16777216))
          (front (arena-new 16777216))
          (d     (own-decoded held (decode-from front doc imports-resolved))))
      (do
        (arena-free front)
        ;; The `ok` arm first: slop types a match's result from its first arm.
        (let ((res (match d
                     ((ok dd)   (prepare-decoded arena (within-seed held dd modular seed) config))
                     ((error f) (error (copy-fault arena f))))))
          (do
            (arena-free held)
            res)))))

  (fn within-seed ((held Arena) (d Decoded) (modular Bool) (seed (List IRI)))
    (@intent "d itself, or, when modular, its module for the seed")
    (@spec ((Arena Decoded Bool (List IRI)) -> Decoded))
    (@alloc held)
    ;; A flag and a list, not an (Option (List IRI)): slop names that
    ;; type two ways in the C it generates, and they do not match.
    (if modular (module-decoded held d seed) d))

  (fn classify-encoded ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig))
    (@intent "Classify an encoded document: the CLI's path, as one call")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; The entry point for a host that encodes its input as the CLI does
    ;; (the Rust crate, rust/csrc_shim.c). With `prepare-encoded` it is the
    ;; CLI's `decode-held`, `prepare-from` and `reason-prepared`, so a host's
    ;; report is the CLI's report and the CLI's goldens certify it.
    (match (prepare-encoded arena doc imports-resolved config)
      ((error f) (error f))
      ((ok p)    (reason arena p config))))

  (fn probe-encoded ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (queries (List Query))
                     (config ReasonerConfig) (modular Bool))
    (@intent "Answer probe queries from a classification of their own input (probe-document's), or of its module for the queries when modular (the answer run, SPEC §8.4)")
    (@spec ((Arena Encoded (List IRI) (List Query) ReasonerConfig Bool) -> (Result Probing Fault)))
    (@alloc arena)
    ;; The classification runs in a scratch arena and only the answers and
    ;; the coverage are copied out. Never strict: a probe run's omissions
    ;; make its answers unknown, they do not refuse them.
    (let ((scratch (arena-new 16777216))
          (mut cfg config))
      (do
        (set! cfg strict-profile false)
        (let ((res (probe-outcome arena (probe-classified scratch doc imports-resolved cfg modular queries)
                                  queries)))
          (do
            (arena-free scratch)
            res)))))

  (fn probe-classified ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig)
                        (modular Bool) (queries (List Query)))
    (@intent "The probe input classified: over its module for the queries when modular, and that run is used only when it is complete or inconsistent; otherwise over the whole input (SPEC §8.4)")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig Bool (List Query)) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; A complete run on the module answers exactly as a complete run on
    ;; the whole input would (L2, L4), and an inconsistency it finds is
    ;; O's. Short of that (an omission inside the module, a cap, the
    ;; budget), its answers could fall short of the two-run mode's, so the
    ;; whole input is classified instead: the two-run mode's own probe run.
    ;; That keeps every yes and no the two-run mode gives (Constraint
    ;; 499c3842), and costs a second run only when the module's falls short.
    ;; When the module's gate already omits something, its run cannot be
    ;; complete, so it is not run at all: straight to the whole input.
    (if (not modular)
      (classify-within arena doc imports-resolved config false (list-new arena IRI))
      (match (prepare-encoded-within arena doc imports-resolved config true (query-seed arena queries))
        ((error f) (error f))
        ((ok p)
          (if (> (list-len (. (. p coverage) omitted)) 0)
            (classify-within arena doc imports-resolved config false (list-new arena IRI))
            (module-or-whole arena doc imports-resolved config (reason arena p config)))))))

  (fn module-or-whole ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig)
                       (m (Result Outcome Fault)))
    (@intent "The module's run when it is complete or inconsistent; otherwise the whole input classified instead")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig (Result Outcome Fault)) -> (Result Outcome Fault)))
    (@alloc arena)
    (match m
      ((ok o)
        (if (or (outcome-is-complete o) (. (. o findings) inconsistent))
          m
          (do
            (release-outcome o)
            (classify-within arena doc imports-resolved config false (list-new arena IRI)))))
      ((error _) m)))

  (fn classify-within ((arena Arena) (doc Encoded) (imports-resolved (List IRI)) (config ReasonerConfig)
                       (modular Bool) (seed (List IRI)))
    (@intent "classify-encoded, over the document's module for seed when modular")
    (@spec ((Arena Encoded (List IRI) ReasonerConfig Bool (List IRI)) -> (Result Outcome Fault)))
    (@alloc arena)
    (match (prepare-encoded-within arena doc imports-resolved config modular seed)
      ((error f) (error f))
      ((ok p)    (reason arena p config))))

  (fn query-seed ((arena Arena) (queries (List Query)))
    (@intent "Σ₀: every class a query names (SPEC §8.4)")
    (@spec ((Arena (List Query)) -> (List IRI)))
    (@alloc arena)
    (let ((mut out (list-new arena IRI)))
      (do (for-each (q queries)
            (do (list-push out (. q sub))
                (when (> (string-len (. (. q sup) value)) 0) (list-push out (. q sup)))))
          out)))

  (fn probe-outcome ((arena Arena) (r (Result Outcome Fault)) (queries (List Query)))
    (@intent "The probe run's result, owned in arena: its answers, or its fault")
    (@spec ((Arena (Result Outcome Fault) (List Query)) -> (Result Probing Fault)))
    (@alloc arena)
    (match r
      ((ok o)    (ok (probing-of arena o queries)))
      ((error f) (error (copy-fault arena f)))))

  (fn probing-of ((arena Arena) (o Outcome) (queries (List Query)))
    (@intent "A probe run's answers and coverage, owned in arena; the run's own arenas released")
    (@spec ((Arena Outcome (List Query)) -> Probing))
    (@alloc arena)
    ;; The documents are numbered by probe-run, which knows the input.
    (let ((p (record-new Probing
               (answers      (answer-queries arena o queries))
               (inconsistent (. (. o findings) inconsistent))
               (omissions    (copy-omissions arena (. (. o coverage) omitted)))
               (profile      (. o profile))
               (origins      (copy-origins arena (. (. o coverage) origins)))
               (input-docs   0)
               (probe-docs   0))))
      (do
        (release-outcome o)
        p)))

  (fn no-probing ((arena Arena))
    (@intent "The probe result of a run that asked nothing")
    (@spec ((Arena) -> Probing))
    (@alloc arena)
    ;; No probe run ran, so its profile is never read: no line names it.
    (record-new Probing (answers (list-new arena Answered)) (inconsistent false)
      (omissions (list-new arena Omission)) (profile 'profile-el)
      (origins (list-new arena Int)) (input-docs 0) (probe-docs 0)))

  (fn copy-origins ((arena Arena) (xs (List Int)))
    (@intent "Omission documents, copied into arena")
    (@spec ((Arena (List Int)) -> (List Int)))
    (@alloc arena)
    (let ((mut out (list-new arena Int)))
      (do (for-each (x xs) (list-push out x)) out)))

  ;; ============================================================
  ;; The public C API
  ;;
  ;; Every function below carries a `:c-name`, and that is what makes it
  ;; public: slop's header generator (`slop build`, and `make csrc` through
  ;; csrc/generate_c.py) writes include/howl.h from exactly the `:c-name`
  ;; functions and the types their signatures reach.
  ;;
  ;; HANDLES ARE OPAQUE. An Input or a Run is one `(Ptr Void)` field, so the
  ;; header holds `void*` and nothing behind it. An Outcome embeds its whole
  ;; Saturation or KscResult by value; were it reachable from a signature,
  ;; dozens of engine-internal structs would land in the header and change
  ;; with every engine change - the GROWL 0.6.0 wrong-offset hazard for
  ;; every mirror of them. Behind each handle is a state record in an arena
  ;; of its own, which `*-free` frees.
  ;;
  ;; THE INPUT IS ENCODED AS THE CLI ENCODES IT (`encoded-add`, and
  ;; `encoded-next-document` between documents) and classified by
  ;; `classify-encoded`, the CLI's own path as one call, so the CLI's
  ;; goldens certify a caller's report byte for byte (rust/tests/goldens.rs).
  ;;
  ;; EVERY ACCESSOR IS TOTAL. Asked of a faulted run, the verdict is
  ;; inconclusive - never a pass - and every list is empty.
  ;; ============================================================

  (type Input (record (p (Ptr Void))))
  (type Run   (record (p (Ptr Void))))

  (type InputState (record
    (arena     Arena)              ; the Encoded and the attested IRIs; the state itself
    (scratch   Arena)              ; one triple's terms at a time, emptied after each
    (enc       (Ptr Encoded))
    (imports   (List IRI))
    (documents Int)
    (probes    (Ptr Encoded))      ; the probe documents (§8.5 A4), classified only by the probe run
    (probe-docs Int)
    (queries   (List Query))       ; as asked; sorted and deduplicated when a run reads them
    (failed    (Option String))))  ; set: a document or term was refused, and the input with it

  ;; The options a caller sets. Plain integers, not SLOP's range types: a
  ;; C caller can hand over any value, and an out-of-range one is refused
  ;; by name (fault-invalid-options) rather than narrowed into range.
  (type Options (record
    (workers        Int)           ; 1..64; never changes the report
    (max-iterations Int)           ; 0..10000 rounds
    (profile        Profile)       ; ignored when auto-select is set
    (auto-select    Bool)          ; the cheapest built profile covering the ontology
    (cancel         I64)))         ; address of a uint32 flag, 0 for none; read at round boundaries

  ;; An RDF term. An empty `datatype` or `lang` is absent - neither may be
  ;; empty in RDF. `blank` is a blank node's id within its document.
  (type TermIn (record
    (kind     TermKind)
    (blank    Int)
    (value    String)
    (datatype String)
    (lang     String)))

  (type TurtleResult (record
    (ok      Bool)
    (message String)               ; owned by the input
    (line    Int)
    (column  Int)))

  ;; Where an omission's document is (issue #67): one of the input's, one
  ;; of the probe documents, or no one document.
  (type DocumentSource (enum
    document-none
    document-input
    document-probe))

  (type FaultKind (enum
    fault-none                     ; the run has a result
    fault-cancelled                ; no partial result: where it stopped depends on scheduling
    fault-input-error
    fault-unavailable              ; the profile asked for is not built yet
    fault-invalid-options))

  (type RunState (record
    (arena         Arena)
    (outcome       (Option Outcome))
    (fault         FaultKind)
    (message       String)
    (fault-profile Profile)
    (verdict       Verdict)
    (probing       Probing)        ; empty unless a query was asked
    (lines         (List String))))

  (fn input-state ((in Input))
    (@intent "The state behind an Input handle")
    (@spec ((Input) -> (Ptr InputState)))
    (cast (Ptr InputState) (. in p)))

  (fn run-state ((r Run))
    (@intent "The state behind a Run handle")
    (@spec ((Run) -> RunState))
    (deref (cast (Ptr RunState) (. r p))))

  (fn input-new ()
    (@intent "An empty input")
    (@spec (() -> Input))
    :c-name "howl_input_new"
    (let ((a (arena-new 16777216))
          (p (cast (Ptr InputState) (arena-alloc a (sizeof InputState)))))
      (do
        (set! (deref p) (record-new InputState
                          (arena     a)
                          (scratch   (arena-new 1048576))
                          (enc       (new-encoded a))
                          (imports   (list-new a IRI))
                          (documents 0)
                          (probes    (new-encoded a))
                          (probe-docs 0)
                          (queries   (list-new a Query))
                          (failed    (none))))
        (record-new Input (p (cast (Ptr Void) p))))))

  (fn input-free ((in Input))
    (@intent "Free an input and everything added to it")
    (@spec ((Input) -> Unit))
    :c-name "howl_input_free"
    (let ((s (deref (input-state in))))
      (do
        (arena-free (. s scratch))
        (arena-free (. s arena)))))

  (fn input-begin-document ((in Input))
    (@intent "Begin the next document: its blank nodes are kept apart from the ones before")
    (@spec ((Input) -> Unit))
    :c-name "howl_input_begin_document"
    (begin-in in false))

  (fn input-begin-probe-document ((in Input))
    (@intent "Begin the next probe document (§8.5 A4): read only by the probe run")
    (@spec ((Input) -> Unit))
    :c-name "howl_input_begin_probe_document"
    (begin-in in true))

  (fn target ((st InputState) (probe Bool))
    (@intent "Where a document goes: the input, or its probe documents")
    (@spec ((InputState Bool) -> (Ptr Encoded)))
    (if probe (. st probes) (. st enc)))

  (fn begin-in ((in Input) (probe Bool))
    (@intent "Begin the next document of the input or of its probe documents")
    (@spec ((Input Bool) -> Unit))
    ;; As `howl validate ROOT -I FILE` does: every document after the first
    ;; has its blank ids shifted past everything already encoded.
    (let ((p (input-state in))
          (mut s (deref p))
          (n (if probe (. s probe-docs) (. s documents))))
      (do
        (when (> n 0)
          (encoded-next-document (. s arena) (target s probe)))
        (if probe
          (set! s probe-docs (+ n 1))
          (set! s documents (+ n 1)))
        (set! (deref p) s))))

  (fn optional-string ((s String))
    (@intent "An empty string as absent")
    (@spec ((String) -> (Option String)))
    (if (== (string-len s) 0) (none) (some s)))

  (fn make-term ((arena Arena) (t TermIn))
    (@intent "A slop-rdf term from a TermIn, or none for a kind HOWL does not take as input")
    (@spec ((Arena TermIn) -> (Option Term)))
    (@alloc arena)
    (match (. t kind)
      ('iri     (some (make-iri arena (. t value))))
      ;; Bounded, not just non-negative: every later document's ids are
      ;; shifted past the highest one so far (encoded-next-document), and
      ;; an id near the top of Int would overflow that shift.
      ('blank   (if (and (>= (. t blank) 0) (<= (. t blank) 1099511627775))
                  (some (make-blank arena (cast (Int 0 ..) (. t blank))))
                  (none)))
      ('literal (some (make-literal arena (. t value)
                        (optional-string (. t datatype)) (optional-string (. t lang)))))
      ('triple  (none))))

  (fn input-add-triple ((in Input) (s TermIn) (p TermIn) (o TermIn))
    (@intent "Add one triple to the current document; false, and the input refused, for a term it cannot take")
    (@spec ((Input TermIn TermIn TermIn) -> Bool))
    :c-name "howl_input_add_triple"
    (add-triple-to in false s p o))

  (fn input-add-probe-triple ((in Input) (s TermIn) (p TermIn) (o TermIn))
    (@intent "Add one triple to the current probe document; refused as input-add-triple refuses")
    (@spec ((Input TermIn TermIn TermIn) -> Bool))
    :c-name "howl_input_add_probe_triple"
    (add-triple-to in true s p o))

  (fn add-triple-to ((in Input) (probe Bool) (s TermIn) (p TermIn) (o TermIn))
    (@intent "Add one triple to the current document of the input or of its probe documents")
    (@spec ((Input Bool TermIn TermIn TermIn) -> Bool))
    ;; The terms are built in the scratch arena and emptied after the call:
    ;; `encoded-add` copies every string it keeps into the input's arena.
    (let ((ptr (input-state in))
          (mut st (deref ptr))
          (sc (. st scratch))
          (ok (match (make-term sc s)
                ((none) false)
                ((some ts)
                  (match (make-term sc p)
                    ((none) false)
                    ((some tp)
                      (match (make-term sc o)
                        ((none) false)
                        ((some to)
                          (do (encoded-add (. st arena) (target st probe) (make-triple sc ts tp to))
                              true)))))))))
      (do
        (reuse-arena sc)
        (when (not ok)
          (do
            (set! st failed
                  (some "a term of a kind HOWL does not take (a quoted triple, or a blank id outside 0..2^40-1)"))
            (set! (deref ptr) st)))
        ok)))

  (fn input-add-turtle ((in Input) (text String))
    (@intent "Add one Turtle document; a document that does not parse refuses the input")
    (@spec ((Input String) -> TurtleResult))
    :c-name "howl_input_add_turtle"
    (add-turtle-to in false text))

  (fn input-add-probe-turtle ((in Input) (text String))
    (@intent "Add one probe document as Turtle (§8.5 A4); one that does not parse refuses the input")
    (@spec ((Input String) -> TurtleResult))
    :c-name "howl_input_add_probe_turtle"
    (add-turtle-to in true text))

  (fn add-turtle-to ((in Input) (probe Bool) (text String))
    (@intent "Add one Turtle document to the input or to its probe documents")
    (@spec ((Input Bool String) -> TurtleResult))
    ;; As the CLI's `parse-into`: slop-rdf's streaming parser, its memory a
    ;; scratch arena freed on return; only what `encoded-add` copies
    ;; survives. The triples before a parse error stay encoded, which is
    ;; why the input is refused rather than classified short.
    (do
      (begin-in in probe)
      (if (== (string-len text) 0)
        (record-new TurtleResult (ok true) (message "") (line 0) (column 0))
        (let ((ptr   (input-state in))
              (mut st (deref ptr))
              (arena (. st arena))
              (enc   (target st probe))
              (parse (arena-new 16777216))
              (res   (match (parse-ttl-string-for-each-triple parse text
                              (fn ((t Triple)) (encoded-add arena enc t)))
                       ((ok _)    (record-new TurtleResult (ok true) (message "") (line 0) (column 0)))
                       ((error e) (record-new TurtleResult
                                    (ok      false)
                                    (message (string-concat arena "" (. e message)))
                                    (line    (. (. e position) line))
                                    (column  (. (. e position) column)))))))
          (do
            (arena-free parse)
            (when (not (. res ok))
              (do
                (set! st failed (some (string-concat arena "a Turtle document does not parse: " (. res message))))
                (set! (deref ptr) st)))
            res)))))

  (fn input-attest-import ((in Input) (iri String))
    (@intent "Attest that an owl:imports target is resolved: its document has been added")
    (@spec ((Input String) -> Unit))
    :c-name "howl_input_attest_import"
    ;; This catches forgetting, not lying: nothing ties the IRI to any
    ;; triples once documents are merged.
    (let ((ptr (input-state in))
          (mut st (deref ptr)))
      (do
        (list-push (. st imports) (record-new IRI (value (string-concat (. st arena) "" iri))))
        (set! (deref ptr) st))))

  (fn input-ask-unsatisfiable ((in Input) (cls String))
    (@intent "Ask whether a class is unsatisfiable: the probe run answers it (§8.5 A4)")
    (@spec ((Input String) -> Unit))
    :c-name "howl_input_ask_unsatisfiable"
    (ask in 'query-unsatisfiable cls ""))

  (fn input-ask-subsumed ((in Input) (sub String) (sup String))
    (@intent "Ask whether sub ⊑ sup: the probe run answers it (§8.5 A4)")
    (@spec ((Input String String) -> Unit))
    :c-name "howl_input_ask_subsumed"
    (ask in 'query-subsumed sub sup))

  (fn ask ((in Input) (kind QueryKind) (sub String) (sup String))
    (@intent "Record a query; one naming an empty IRI refuses the input")
    (@spec ((Input QueryKind String String) -> Unit))
    ;; The IRIs are copied: the caller's strings need not outlive the call.
    (let ((ptr (input-state in))
          (mut st (deref ptr))
          (a (. st arena))
          (empty (match kind
                   ('query-unsatisfiable (== (string-len sub) 0))
                   ('query-subsumed      (or (== (string-len sub) 0) (== (string-len sup) 0))))))
      (do
        (if empty
          (set! st failed (some "a probe query names an empty IRI"))
          (list-push (. st queries)
            (record-new Query (kind kind)
              (sub (record-new IRI (value (string-concat a "" sub))))
              (sup (record-new IRI (value (string-concat a "" sup)))))))
        (set! (deref ptr) st))))

  (fn default-options ()
    (@intent "The engine's defaults as Options: explicit el, 4 workers, 1000 rounds")
    (@spec (() -> Options))
    :c-name "howl_default_options"
    (let ((c (default-config)))
      (record-new Options
        (workers        (cast Int (. c worker-count)))
        (max-iterations (cast Int (. c max-iterations)))
        (profile        (match (. c selection) ((explicit p) p) ((auto) 'profile-el)))
        (auto-select    (match (. c selection) ((explicit _) false) ((auto) true)))
        (cancel         (. c cancel-ptr)))))

  (fn options-problem ((o Options))
    (@intent "Why options cannot run, or none")
    (@spec ((Options) -> (Option String)))
    (@post (match $result
             ((none) (and {(. o workers) >= 1} {(. o workers) <= 64}
                          {(. o max-iterations) >= 0} {(. o max-iterations) <= 10000}))
             ((some _) true)))
    (if (< (. o workers) 1) (some "workers must be 1..64")
      (if (> (. o workers) 64) (some "workers must be 1..64")
        (if (< (. o max-iterations) 0) (some "max_iterations must be 0..10000")
          (if (> (. o max-iterations) 10000) (some "max_iterations must be 0..10000")
            (none))))))

  (fn options-config ((o Options))
    (@intent "The engine's config for in-range options: always non-strict")
    (@spec ((Options) -> ReasonerConfig))
    (@pre {(. o workers) >= 1})
    (@pre {(. o workers) <= 64})
    (@pre {(. o max-iterations) >= 0})
    (@pre {(. o max-iterations) <= 10000})
    ;; The library always runs non-strict (SPEC §8.4): an omission is a
    ;; report, not a refusal.
    (let ((mut c (default-config)))
      (do
        (set! c worker-count (cast (Int 1 .. 64) (. o workers)))
        (set! c max-iterations (cast (Int 0 .. 10000) (. o max-iterations)))
        (set! c selection (if (. o auto-select)
                            (union-new ProfileSelection auto)
                            (union-new ProfileSelection explicit (. o profile))))
        (set! c strict-profile false)
        (set! c cancel-ptr (. o cancel))
        c)))

  (fn new-run ((a Arena) (st RunState))
    (@intent "A Run handle over state stored in its own arena")
    (@spec ((Arena RunState) -> Run))
    (let ((p (cast (Ptr RunState) (arena-alloc a (sizeof RunState)))))
      (do
        (set! (deref p) st)
        (record-new Run (p (cast (Ptr Void) p))))))

  (fn faulted ((a Arena) (kind FaultKind) (message String) (profile Profile))
    (@intent "A run with no result")
    (@spec ((Arena FaultKind String Profile) -> Run))
    (new-run a (record-new RunState
                 (arena a) (outcome (none)) (fault kind) (message message)
                 (fault-profile profile) (verdict 'verdict-inconclusive)
                 (probing (no-probing a)) (lines (list-new a String)))))

  (fn run-classify ((in Input) (o Options))
    (@intent "Classify an input: coherence, unsatisfiable classes, and the subsumption hierarchy")
    (@spec ((Input Options) -> Run))
    :c-name "howl_run_classify"
    ;; The input is only read, and can be classified again.
    (let ((a  (arena-new 16777216))
          (st (deref (input-state in))))
      (match (options-problem o)
        ((some why) (faulted a 'fault-invalid-options why (. o profile)))
        ((none)
          (match (. st failed)
            ;; Copied: `why` lives in the input's arena, and a run's
            ;; strings must outlive the input (until run-free).
            ((some why) (faulted a 'fault-input-error (string-concat a "" why) (. o profile)))
            ((none)
              (match (classify-encoded a (deref (. st enc)) (. st imports) (options-config o))
                ((ok out)   (with-probes a st out o))
                ((error f)  (run-faulted a f "" (. o profile))))))))))

  (fn run-faulted ((a Arena) (f Fault) (prefix String) (profile Profile))
    (@intent "A run with no result, for the engine's fault")
    (@spec ((Arena Fault String Profile) -> Run))
    (match f
      ((cancelled)       (faulted a 'fault-cancelled "" profile))
      ((input-error m)   (faulted a 'fault-input-error (string-concat a prefix m) profile))
      ((unavailable p)   (faulted a 'fault-unavailable (unavailable-message a p) p))
      ;; Only a strict run refuses, and this API never runs strict; should
      ;; it happen it is an input error, never a verdict.
      ((refused _)       (faulted a 'fault-input-error "refused under a strict profile" profile))))

  (fn probe-run ((a Arena) (st InputState) (o Options) (modular Bool))
    (@intent "The input's queries answered by a probe run of their own (probe-document's input), over its module when modular")
    (@spec ((Arena InputState Options Bool) -> (Result Probing Fault)))
    (@alloc a)
    ;; The probe run's input is built in an arena freed once it has run.
    (let ((qs  (sort-queries a (. st queries)))
          (pa  (arena-new 16777216))
          (doc (probe-document pa (deref (. st enc)) (deref (. st probes)) qs))
          (res (probe-encoded a (deref doc) (. st imports) qs (options-config o) modular)))
      (do
        (arena-free pa)
        (match res
          ((ok p)
            (let ((mut q p))
              (do
                (set! q input-docs (cast Int (list-len (. (deref (. st enc)) starts))))
                (set! q probe-docs (cast Int (list-len (. (deref (. st probes)) starts))))
                (ok q))))
          ((error f) (error f))))))

  (fn with-probes ((a Arena) (st InputState) (out Outcome) (o Options))
    (@intent "The run over a finished outcome, its probe queries answered by a run of their own")
    (@spec ((Arena InputState Outcome Options) -> Run))
    ;; A probe run that faults takes the whole run with it: cancelled is
    ;; cancelled, and an input error (a probe document HOWL cannot decode)
    ;; is the caller's, named as the probe run's.
    (if (== (list-len (. st queries)) 0)
      (finished a out (no-probing a) false)
      (match (probe-run a st o false)
        ((ok p)    (finished a out p true))
        ((error f)
          (do
            (release-outcome out)
            (run-faulted a f "probe run: " (. o profile)))))))

  (fn run-answer ((in Input) (o Options))
    (@intent "Answer the input's probe queries alone: one probe run, no main classification (SPEC §8.4)")
    (@spec ((Input Options) -> Run))
    :c-name "howl_run_answer"
    ;; The same probe input as howl_run_classify's, over its ⊥-locality
    ;; module for the queries (SPEC §8.4), with no main run before it: every
    ;; yes and no howl_run_classify gives is kept (Constraint 499c3842), and
    ;; an omission outside the module no longer turns a no into unknown. So
    ;; the run has no outcome and no report: its
    ;; verdict is inconclusive and its findings empty, and its lines are
    ;; the answers (`answer-lines`).
    (let ((a  (arena-new 16777216))
          (st (deref (input-state in))))
      (match (options-problem o)
        ((some why) (faulted a 'fault-invalid-options why (. o profile)))
        ((none)
          (match (. st failed)
            ((some why) (faulted a 'fault-input-error (string-concat a "" why) (. o profile)))
            ((none)     (answer-of-input a st o)))))))

  (fn answer-of-input ((a Arena) (st InputState) (o Options))
    (@intent "The answer run over an input that loaded: nothing asked runs nothing")
    (@spec ((Arena InputState Options) -> Run))
    ;; Here the probe run is the whole run, so its fault is the run's,
    ;; named as it is (no "probe run: " prefix).
    (if (== (list-len (. st queries)) 0)
      (answered a (no-probing a) false)
      (match (probe-run a st o true)
        ((ok p)    (answered a p true))
        ((error f) (run-faulted a f "" (. o profile))))))

  (fn answered ((a Arena) (p Probing) (ran Bool))
    (@intent "An answer run: answers and no outcome, its lines the answering profile (when a probe run ran) and the probe lines")
    (@spec ((Arena Probing Bool) -> Run))
    (new-run a (record-new RunState
                 (arena a) (outcome (none)) (fault 'fault-none) (message "")
                 (fault-profile (. p profile)) (verdict 'verdict-inconclusive)
                 (probing p) (lines (answer-lines a p ran)))))

  (fn finished ((a Arena) (out Outcome) (p Probing) (asked Bool))
    (@intent "A run with a result: the report's lines, then the probe lines when a query was asked")
    (@spec ((Arena Outcome Probing Bool) -> Run))
    (let ((mut lines (report-lines a out)))
      (do
        (when asked
          (for-each (l (probe-lines a p)) (list-push lines l)))
        (new-run a (record-new RunState
                     (arena a) (outcome (some out)) (fault 'fault-none) (message "")
                     (fault-profile (. out profile)) (verdict (verdict out))
                     (probing p) (lines lines))))))

  (fn run-free ((r Run))
    (@intent "Free a run and every string it returned")
    (@spec ((Run) -> Unit))
    :c-name "howl_run_free"
    ;; el's store and last queues live in arenas of the engine's own, which
    ;; the Outcome carries; they go first, then the run's own arena.
    (let ((st (run-state r)))
      (do
        (match (. st outcome)
          ((some o) (release-outcome o))
          ((none)   (do)))
        (arena-free (. st arena)))))

  (fn run-ok ((r Run))
    (@intent "Whether the run has a result: a classification's outcome, or an answer run's answers")
    (@spec ((Run) -> Bool))
    :c-name "howl_run_ok"
    ;; Every run without a result carries a fault (`faulted`), and every
    ;; run with one carries fault-none, so this is the outcome test for a
    ;; classify run. An answer run (`howl_run_answer`) has answers and no
    ;; outcome.
    (== (. (run-state r) fault) 'fault-none))

  (fn run-fault ((r Run))
    (@intent "Why the run has no result, or fault-none")
    (@spec ((Run) -> FaultKind))
    :c-name "howl_run_fault"
    (. (run-state r) fault))

  (fn run-fault-message ((r Run))
    (@intent "The fault's message: the input error or the option out of range")
    (@spec ((Run) -> String))
    :c-name "howl_run_fault_message"
    (. (run-state r) message))

  (fn run-fault-profile ((r Run))
    (@intent "The profile a fault-unavailable run asked for")
    (@spec ((Run) -> Profile))
    :c-name "howl_run_fault_profile"
    (. (run-state r) fault-profile))

  (fn run-profile ((r Run))
    (@intent "The profile that ran")
    (@spec ((Run) -> Profile))
    :c-name "howl_run_profile"
    (. (run-state r) fault-profile))

  (fn run-verdict ((r Run))
    (@intent "The run's verdict (§6.2); inconclusive for a run with no result")
    (@spec ((Run) -> Verdict))
    :c-name "howl_run_verdict"
    (. (run-state r) verdict))

  (fn run-inconsistent ((r Run))
    (@intent "Whether the ontology was found inconsistent")
    (@spec ((Run) -> Bool))
    :c-name "howl_run_inconsistent"
    (match (. (run-state r) outcome) ((some o) (. (. o findings) inconsistent)) ((none) false)))

  (fn run-termination ((r Run))
    (@intent "How the run ended: fixpoint, or the round budget ran out")
    (@spec ((Run) -> Termination))
    :c-name "howl_run_termination"
    (match (. (run-state r) outcome)
      ((some o) (. o termination))
      ((none)   (union-new Termination resource-limit 0))))

  (fn run-rounds ((r Run))
    (@intent "Rounds run (the report's `rounds` line)")
    (@spec ((Run) -> Int))
    :c-name "howl_run_rounds"
    (match (. (run-state r) outcome) ((some o) (. o rounds)) ((none) 0)))

  (fn run-unsat-len ((r Run))
    (@intent "How many named classes are unsatisfiable")
    (@spec ((Run) -> Int))
    :c-name "howl_run_unsat_len"
    (match (. (run-state r) outcome)
      ((some o) (cast Int (list-len (. (. o findings) unsatisfiable))))
      ((none)   0)))

  (fn run-unsat ((r Run) (i Int))
    (@intent "The i-th unsatisfiable class's IRI, in canonical order")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_unsat"
    (match (. (run-state r) outcome)
      ((some o) (match (list-get (. (. o findings) unsatisfiable) i) ((some c) (. c value)) ((none) "")))
      ((none)   "")))

  (fn run-sub-len ((r Run))
    (@intent "How many (sub, super) pairs the taxonomy has")
    (@spec ((Run) -> Int))
    :c-name "howl_run_sub_len"
    (match (. (run-state r) outcome)
      ((some o) (cast Int (list-len (. (. o findings) subsumptions))))
      ((none)   0)))

  (fn run-sub ((r Run) (i Int))
    (@intent "The i-th pair's subclass, rendered as the report's `sub` line renders it")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_sub"
    (let ((st (run-state r)))
      (match (. st outcome)
        ((some o) (match (list-get (. (. o findings) subsumptions) i)
                    ((some sp) (node-text (. st arena) (. sp sub)))
                    ((none)    "")))
        ((none)   ""))))

  (fn run-super ((r Run) (i Int))
    (@intent "The i-th pair's superclass, rendered as the report's `sub` line renders it")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_super"
    (let ((st (run-state r)))
      (match (. st outcome)
        ((some o) (match (list-get (. (. o findings) subsumptions) i)
                    ((some sp) (node-text (. st arena) (. sp super)))
                    ((none)    "")))
        ((none)   ""))))

  (fn run-omission-len ((r Run))
    (@intent "How many inputs the run did not cover; any makes a clean run inconclusive")
    (@spec ((Run) -> Int))
    :c-name "howl_run_omission_len"
    (match (. (run-state r) outcome)
      ((some o) (cast Int (list-len (. (. o coverage) omitted))))
      ((none)   0)))

  (fn run-omission ((r Run) (i Int))
    (@intent "The i-th omission, rendered as the report's `omission` line renders it")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_omission"
    (let ((st (run-state r)))
      (match (. st outcome)
        ((some o) (match (list-get (. (. o coverage) omitted) i)
                    ((some om) (render-omission (. st arena) om))
                    ((none)    "")))
        ((none)   ""))))

  (fn omission-kind ((arena Arena) (om Omission))
    (@intent "The omission's kind: its rendering's head token, up to the first `(`")
    (@spec ((Arena Omission) -> String))
    (@alloc arena)
    ;; Taken from the rendering, so the kind is the report's by
    ;; construction: an out-of-profile axiom's head is any of RawAxiom's
    ;; forms (SubClassOf, DataAxiom, Unrecognized, ...), and a fixed enum
    ;; would have to grow with it.
    (let ((t (render-omission arena om)))
      (match (index-of t "(")
        ((some n) (substring arena t 0 n))
        ((none)   t))))

  (fn omission-entity-kind ((om Omission))
    (@intent "A missing declaration's entity kind; entity-class for any other omission")
    (@spec ((Omission) -> EntityKind))
    (match om
      ((missing-declaration md) (. md kind))
      ((out-of-profile _)       'entity-class)
      ((unresolved-import _)    'entity-class)
      ((undeclared-property _)  'entity-class)))

  (fn origin-at ((origins (List Int)) (i Int))
    (@intent "The i-th omission's document as numbered when it was found, or -1")
    (@spec (((List Int) Int) -> Int))
    (match (list-get origins i) ((some d) d) ((none) -1)))

  (fn run-omission-kind ((r Run) (i Int))
    (@intent "The i-th omission's kind: the head token of its `omission` line (MissingDeclaration, SubClassOf, ...)")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_omission_kind"
    (let ((st (run-state r)))
      (match (. st outcome)
        ((some o) (match (list-get (. (. o coverage) omitted) i)
                    ((some om) (omission-kind (. st arena) om))
                    ((none)    "")))
        ((none)   ""))))

  (fn run-omission-entity-kind ((r Run) (i Int))
    (@intent "The i-th omission's entity kind, when it is a MissingDeclaration; entity-class otherwise")
    (@spec ((Run Int) -> EntityKind))
    :c-name "howl_run_omission_entity_kind"
    (match (. (run-state r) outcome)
      ((some o) (match (list-get (. (. o coverage) omitted) i)
                  ((some om) (omission-entity-kind om))
                  ((none)    'entity-class)))
      ((none)   'entity-class)))

  (fn run-omission-document ((r Run) (i Int))
    (@intent "The input document the i-th omission came from, by index in add order; -1 when no one document is it")
    (@spec ((Run Int) -> Int))
    :c-name "howl_run_omission_document"
    (match (. (run-state r) outcome)
      ((some o) (origin-at (. (. o coverage) origins) i))
      ((none)   -1)))

  ;; The probe run's answers (§8.5 A4): empty when nothing was asked.
  (fn run-probe-len ((r Run))
    (@intent "How many queries the probe run answered, each once")
    (@spec ((Run) -> Int))
    :c-name "howl_run_probe_len"
    (cast Int (list-len (. (. (run-state r) probing) answers))))

  (fn probe-at ((r Run) (i Int))
    (@intent "The i-th answer, in canonical order")
    (@spec ((Run Int) -> (Option Answered)))
    (list-get (. (. (run-state r) probing) answers) i))

  (fn run-probe-kind ((r Run) (i Int))
    (@intent "The i-th query's kind")
    (@spec ((Run Int) -> QueryKind))
    :c-name "howl_run_probe_kind"
    (match (probe-at r i)
      ((some a) (. (. a query) kind))
      ((none)   'query-unsatisfiable)))

  (fn run-probe-sub ((r Run) (i Int))
    (@intent "The i-th query's class: the one asked unsatisfiable, or the subclass")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_probe_sub"
    (match (probe-at r i)
      ((some a) (. (. (. a query) sub) value))
      ((none)   "")))

  (fn run-probe-sup ((r Run) (i Int))
    (@intent "The i-th query's superclass; empty for an unsatisfiability query")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_probe_sup"
    (match (probe-at r i)
      ((some a) (. (. (. a query) sup) value))
      ((none)   "")))

  (fn run-probe-answer ((r Run) (i Int))
    (@intent "The i-th answer: yes (entailed), no (not, by a complete probe run) or unknown")
    (@spec ((Run Int) -> ProbeAnswer))
    :c-name "howl_run_probe_answer"
    (match (probe-at r i)
      ((some a) (. a answer))
      ((none)   'answer-unknown)))

  (fn run-probe-inconsistent ((r Run))
    (@intent "Whether the probe run was inconsistent, making every answer a vacuous yes")
    (@spec ((Run) -> Bool))
    :c-name "howl_run_probe_inconsistent"
    (. (. (run-state r) probing) inconsistent))

  (fn run-probe-omission-len ((r Run))
    (@intent "How many inputs the probe run did not cover; any rules out a no")
    (@spec ((Run) -> Int))
    :c-name "howl_run_probe_omission_len"
    (cast Int (list-len (. (. (run-state r) probing) omissions))))

  (fn run-probe-omission ((r Run) (i Int))
    (@intent "The probe run's i-th omission, rendered as its `probe-omission` line renders it")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_probe_omission"
    (let ((st (run-state r)))
      (match (list-get (. (. st probing) omissions) i)
        ((some om) (render-omission (. st arena) om))
        ((none)    ""))))

  (fn run-probe-omission-kind ((r Run) (i Int))
    (@intent "The probe run's i-th omission's kind, as run-omission-kind gives it")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_probe_omission_kind"
    (let ((st (run-state r)))
      (match (list-get (. (. st probing) omissions) i)
        ((some om) (omission-kind (. st arena) om))
        ((none)    ""))))

  (fn run-probe-omission-entity-kind ((r Run) (i Int))
    (@intent "The probe run's i-th omission's entity kind, as run-omission-entity-kind gives it")
    (@spec ((Run Int) -> EntityKind))
    :c-name "howl_run_probe_omission_entity_kind"
    (match (list-get (. (. (run-state r) probing) omissions) i)
      ((some om) (omission-entity-kind om))
      ((none)    'entity-class)))

  (fn probe-origin ((p Probing) (i Int))
    (@intent "The probe run's i-th omission's document, numbered over the probe run's whole input")
    (@spec ((Probing Int) -> Int))
    (origin-at (. p origins) i))

  (fn run-probe-omission-source ((r Run) (i Int))
    (@intent "Whether the probe run's i-th omission came from an input document, a probe document, or no one document")
    (@spec ((Run Int) -> DocumentSource))
    :c-name "howl_run_probe_omission_source"
    (let ((p (. (run-state r) probing))
          (k (probe-origin p i)))
      (if (< k 0) 'document-none
        (if (< k (. p input-docs)) 'document-input
          (if (< k (+ (. p input-docs) (. p probe-docs))) 'document-probe 'document-none)))))

  (fn run-probe-omission-document ((r Run) (i Int))
    (@intent "The probe run's i-th omission's document: its index among the input's, or among the probe documents (run-probe-omission-source says which); -1 for none")
    (@spec ((Run Int) -> Int))
    :c-name "howl_run_probe_omission_document"
    (let ((p (. (run-state r) probing))
          (k (probe-origin p i)))
      (if (< k 0) -1
        (if (< k (. p input-docs)) k
          (if (< k (+ (. p input-docs) (. p probe-docs))) (- k (. p input-docs)) -1)))))

  (fn run-report-len ((r Run))
    (@intent "How many lines the canonical report has")
    (@spec ((Run) -> Int))
    :c-name "howl_run_report_len"
    (cast Int (list-len (. (run-state r) lines))))

  (fn run-report-line ((r Run) (i Int))
    (@intent "The canonical report's i-th line: the bytes `howl validate --report` prints")
    (@spec ((Run Int) -> String))
    :c-name "howl_run_report_line"
    (match (list-get (. (run-state r) lines) i) ((some l) l) ((none) "")))
)
