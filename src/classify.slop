;; ============================================================
;; Hierarchy extraction and findings  —  SPEC.md §6.4, §6.7
;;
;; ⚠  M1, NOT YET IMPLEMENTED.
;;
;; SUBSUMPTION IS NOT RAW S(·) MEMBERSHIP, and reading it that way is
;; incomplete. If ⊥ ∈ S(A) then A ⊑ B is entailed for EVERY class B,
;; yet nothing puts those Bs into S(A) — the completion rules have no
;; reason to. The published formulation reads subsumption as a
;; disjunction, and extraction must implement all three arms:
;;
;;   entails-sub(A,B)  iff  findings.inconsistent   (everything follows)
;;                      or  ⊥ ∈ S(A)                (everything follows from A)
;;                      or  B ∈ S(A)
;;
;; The first disjunct is not redundant with the second. Inconsistency
;; can arrive through an INDIVIDUAL context — C(a) with C ⊑ ⊥ gives
;; ⊥ ∈ S(individual(a)) — while leaving every CLASS context untouched.
;; Omitting it makes an unrelated probe A ⊑ B answer FALSE on an
;; ontology that entails everything, and it does so precisely when the
;; inconsistency came from the ABox encoding v0 exists to support.
;;
;; TWO DIFFERENT OUTPUTS FOLLOW FROM THAT DISJUNCTION, and they must
;; not be confused. They agree semantically and differ as data:
;;
;;   entails-sub(A,B)        the PROBE — all three disjuncts. Used by
;;                           the agreement stage, `explain`,
;;                           differential testing, subsumption_delta
;;   Findings.subsumptions   the TAXONOMY — bottom-compressed: an
;;                           unsatisfiable C is the single pair (C,⊥),
;;                           never C against every class. Used for
;;                           Turtle emission
;;
;; A probe for A ⊑ B where A is unsatisfiable must answer TRUE; the
;; taxonomy must NOT contain that pair, or every unsatisfiable class
;; explodes the list by the size of the signature. Reading one
;; paragraph and implementing the other produces either false
;; negatives on probes or a quadratic hierarchy — and a differential
;; test reporting mismatches that are artifacts of representation.
;;
;; EXTRACTION IS A DEFINED PASS, NOT A PROJECTION OF THE STORE:
;;   1. Unsatisfiable classes COLLAPSE INTO ⊥ — every C with ⊥ ∈ S(C)
;;      is emitted as owl:equivalentClass owl:Nothing, not as a class
;;      with whatever accidental subsumers it accrued.
;;   2. ⊥ is below everything and ⊤ above everything BY CONSTRUCTION,
;;      not by derivation.
;;   3. On ontology inconsistency the hierarchy is NOT EMITTED AT ALL.
;;      The entailed hierarchy is the full cross-product — useless to
;;      serialize, misleading to truncate. `subsumptions` is empty and
;;      documented as UNDEFINED-because-inconsistent, not
;;      empty-because-nothing-follows.
;;
;; Without step 1 a partially-collapsed hierarchy leaks into the output
;; and into subsumption_delta; without step 3 an inconsistent ontology
;; yields a small, plausible, entirely meaningless hierarchy. Both are
;; silent — the classification looks fine.
;;
;; OUTPUT IS PROJECTED BACK TO class-node CONTEXTS ONLY. Fresh names
;; are normalization artifacts that appear in no input and must appear
;; in no output; individual contexts encode assertions, not
;; subsumptions, and emitting `:a rdfs:subClassOf :C` for an individual
;; is a category error a downstream RL engine would then faithfully
;; materialize. Unsatisfiability found in an individual context is
;; still reported — as an INCONSISTENCY, which is what it is.
;; ============================================================

(module classify
  (@doc "Hierarchy extraction, findings, and output projection (M1)")

  (import rdf (IRI))
  (import vocab (OWL_NOTHING))
  (import types (Node SubPair Findings Saturation Context Names KName KscResult ClassAnswer
                 node-top node-bottom node-eq kname-eq renamed-node original-node))
  (import canon (sort-iris sort-sub-pairs))

  (export
    extract-findings
    extract-ksc-findings
    entails-sub
    ksc-entails-sub
    context-has-bottom
    detect-inconsistent)

  (fn context-has-bottom ((sat Saturation) (n Node))
    (@intent "⊥ ∈ S(n) — the unsatisfiability test, for one context")
    (@spec ((Saturation Node) -> Bool))
    (@pure)
    ;; `bottom` is bound rather than called inline: a set element
    ;; compiles to `&(ELEM)`, and a function-call result is not a C
    ;; lvalue. This is a hard compile error, not a silent one — but it
    ;; is worth naming, because the inline form reads perfectly well.
    (let ((bottom (node-bottom)))
      (match (map-get (. sat contexts) n)
        ((some ctx) (set-has (. ctx subsumers) bottom))
        ((none)     false))))

  (fn detect-inconsistent ((sat Saturation) (names Names))
    (@intent "⊥ ∈ S(⊤), or ⊥ ∈ S(individual(a)) for some individual a")
    (@spec ((Saturation Names) -> Bool))
    (@pure)
    ;; The saturation's nodes are RENAMED (types.slop, Names): the tag that
    ;; says "individual" is read from the node each key stands for. ⊤ is
    ;; never renamed, so its context is found as itself.
    ;; The INDIVIDUAL arm is the one that is easy to omit and expensive
    ;; to omit. §5.2's ABox encoding puts assertions into individual
    ;; contexts, so `C(a)` with `C ⊑ ⊥` gives ⊥ ∈ S(individual(a)) while
    ;; leaving every CLASS context untouched — an ontology that entails
    ;; everything, reported as merely having no unsatisfiable classes.
    (let ((mut found (context-has-bottom sat (node-top))))
      (do
        (for-each (n (. sat contexts))
          (when (is-individual names n)
            (when (context-has-bottom sat n) (set! found true))))
        found)))

  (fn is-individual ((names Names) (n Node))
    (@intent "Does this saturation node stand for an individual?")
    (@spec ((Names Node) -> Bool))
    (match (original-node names n)
      ((individual-node _) true)
      ((class-node _)      false)
      ((fresh-node _)      false)))

  (fn entails-sub ((sat Saturation) (names Names) (inconsistent Bool) (a Node) (b Node))
    (@intent "The subsumption PROBE — all three disjuncts, not just B ∈ S(A)")
    (@spec ((Saturation Names Bool Node Node) -> Bool))
    (@pure)
    ;; `a` and `b` are the caller's ORIGINAL nodes; the saturation holds
    ;; them renamed, so both are looked up through `names`.
    ;; An inconsistent ontology entails EVERY subsumption. This arm is
    ;; not redundant with the ⊥ ∈ S(A) arm below: inconsistency can
    ;; arrive through an INDIVIDUAL context, leaving every class context
    ;; untouched, and omitting it makes an unrelated probe answer `false`
    ;; on an ontology that entails everything — precisely when the
    ;; inconsistency came from the ABox encoding v0 exists to support.
    (@post (implies {inconsistent == true} {$result == true}))
    ;; Nested `if`, not `or`: `or`/`and` in a body make the return value
    ;; opaque to the WP checker, and the contract above would then fail
    ;; on a counterexample despite being true.
    (let ((bottom (node-bottom)))
      (if inconsistent
        true
        (match (renamed-node names a)
          ((none) false)
          ((some ra)
            (match (map-get (. sat contexts) ra)
              ((some ctx)
                (if (set-has (. ctx subsumers) bottom)
                  true
                  (match (renamed-node names b)
                    ((some rb) (set-has (. ctx subsumers) rb))
                    ((none)    false))))
              ((none) false)))))))

  ;; ============================================================
  ;; Extraction, split so the "undefined, not empty" contracts hold
  ;;
  ;; The two collectors below exist because a LOOP makes `$result`
  ;; opaque to the WP checker: with the iteration inline,
  ;; `extract-findings`' postconditions fail on a counterexample even
  ;; though they are true. Hoisting the loops leaves that function's own
  ;; body branch-only, so the checker can see `inconsistent` is the
  ;; literal `false` on the path that builds non-empty lists — which is
  ;; what makes the implication vacuous and provable there.
  ;;
  ;; Both collectors share `is-bottom-iri` rather than each testing
  ;; owl:Nothing themselves, so the exclusion has ONE site and the two
  ;; lists cannot drift apart about which classes they are describing.
  ;; ============================================================

  (fn is-bottom-iri ((iri IRI))
    (@intent "owl:Nothing, which is excluded from output by name")
    (@spec ((IRI) -> Bool))
    (@pure)
    ;; owl:Nothing MUST be excluded explicitly or every ontology reports
    ;; itself incoherent: initialization seeds Δ₀(N) = {N, ⊤} for every
    ;; node, so ⊥ ∈ S(⊥) holds BY CONSTRUCTION the moment owl:Nothing
    ;; appears — which any disjointness axiom guarantees. Without this,
    ;; `unsatisfiable` is non-empty for essentially every real ontology
    ;; and `howl validate` exits 1 universally. That is a FALSE FAIL —
    ;; the mirror of the false pass everything else guards against, and
    ;; less dangerous only because uselessly noisy surfaces on first use
    ;; where dangerously quiet does not.
    (string-eq (. iri value) OWL_NOTHING))

  (fn collect-unsatisfiable ((arena Arena) (sat Saturation) (names Names))
    (@intent "Named classes C ≠ owl:Nothing with ⊥ ∈ S(C), as a LOWER BOUND unless complete")
    (@spec ((Arena Saturation Names) -> (List IRI)))
    (@alloc arena)
    (let ((mut unsat (list-new arena IRI))
          (bottom (node-bottom)))
      (do
        (for-each ((n ctx) (. sat contexts))
          (match (original-node names n)
            ((class-node iri)
              (when (not (is-bottom-iri iri))
                (when (set-has (. ctx subsumers) bottom)
                  (list-push unsat iri))))
            ;; Unsatisfiability found in an INDIVIDUAL context is still
            ;; reported — as an INCONSISTENCY, which is what it is, and
            ;; which `detect-inconsistent` has already decided by the
            ;; time this runs. Fresh nodes are normalization artifacts
            ;; that appear in no input and must appear in no output.
            ((individual-node _) (do))
            ((fresh-node _)      (do))))
        ;; SORTED ON THE WAY OUT (§6.8). `for-each` over a Set walks
        ;; bucket order, which is a function of hash and insertion
        ;; history rather than of content — so an unsorted list here
        ;; would make the report vary with worker count and defeat the
        ;; consumer's verdict hashing.
        (sort-iris arena unsat))))

  (fn collect-taxonomy ((arena Arena) (sat Saturation) (names Names))
    (@intent "The subsumption hierarchy, bottom-compressed and projected to class contexts")
    (@spec ((Arena Saturation Names) -> (List SubPair)))
    (@alloc arena)
    ;; Keys and subsumers are RENAMED; each is mapped back to the node it
    ;; stands for before the class test, and the pairs hold originals, so
    ;; the sort below is over the same values it always was.
    (let ((mut subs (list-new arena SubPair))
          (bottom (node-bottom)))
      (do
        (for-each ((rn ctx) (. sat contexts))
          (match (original-node names rn)
            ((class-node iri)
              (when (not (is-bottom-iri iri))
                (if (set-has (. ctx subsumers) bottom)
                  ;; BOTTOM-COMPRESSION. An unsatisfiable C is emitted as
                  ;; the single pair (C,⊥) — never as C against every
                  ;; class in the signature, which is what raw entailment
                  ;; gives and which would blow the taxonomy up by the
                  ;; size of the signature. The PROBE still answers true
                  ;; for any (C,B): the two outputs agree semantically
                  ;; and differ as data, and implementing one where the
                  ;; other belongs gives either false negatives on probes
                  ;; or a quadratic hierarchy.
                  (let ((n (original-node names rn)))
                    (list-push subs (record-new SubPair (sub n) (super bottom))))
                  (for-each (rb (. ctx subsumers))
                    (match (original-node names rb)
                      ((class-node _)
                        (let ((n (original-node names rn))
                              (b (original-node names rb)))
                          (list-push subs (record-new SubPair (sub n) (super b)))))
                      ((individual-node _) (do))
                      ((fresh-node _)      (do)))))))
            ((individual-node _) (do))
            ((fresh-node _)      (do))))
        ;; SORTED ON THE WAY OUT (§6.8, M1 acceptance (e)) — this was
        ;; OWED through M1 and is discharged here, because the front end
        ;; is about to give these lists a consumer. Two `for-each`es over
        ;; Sets feed this list, and both walk bucket order; canonical
        ;; ordering is what makes the report byte-identical across worker
        ;; counts and therefore hashable into a durable verdict.
        ;;
        ;; The comparator is `canon.string-cmp` (FFI memcmp), NOT
        ;; `strlib.compare` — see the header of src/canon.slop for why
        ;; strcmp is unsafe on the IRI slices this walks.
        (sort-sub-pairs arena subs))))

  (fn extract-findings ((arena Arena) (sat Saturation) (names Names))
    (@intent "Extract the taxonomy and coherence findings from a saturated state")
    (@spec ((Arena Saturation Names) -> Findings))
    (@alloc arena)
    ;; The three conditions, defined separately (§6.2):
    ;;
    ;;   inconsistent  := ⊥ ∈ S(⊤) or ∃ individual a. ⊥ ∈ S(individual(a))
    ;;   unsatisfiable := ∅ when inconsistent; otherwise
    ;;                    { iri | class-node(iri) ∈ input signature,
    ;;                            iri ≠ owl:Nothing, ⊥ ∈ S(class-node(iri)) }
    ;;   incoherent    := inconsistent ∨ unsatisfiable ≠ ∅
    ;;
    ;; THE TWO UNDEFINED-NOT-EMPTY RULES, as contracts. Under
    ;; inconsistency both lists are empty because they are UNDEFINED, not
    ;; because nothing follows: an inconsistent ontology has no model, so
    ;; every class is unsatisfiable and every subsumption entailed, yet
    ;; raw ⊥ ∈ S(A) finds none of them when the inconsistency arrived
    ;; through an individual context. Reporting those raw sets would be a
    ;; lower bound so misleading it is worse than nothing —
    ;; `inconsistent: true` alongside `unsatisfiable: []` reads as
    ;; "consistent classes".
    ;; OWED — THE TWO UNDEFINED-NOT-EMPTY RULES AS CONTRACTS. They were
    ;; stated here as
    ;;
    ;;   (@post (implies {(. $result inconsistent) == true}
    ;;                   {(list-len (. $result unsatisfiable)) == 0}))
    ;;
    ;; and they are TRUE, but this checker cannot discharge them in any
    ;; formulation of this function, which was established by probing
    ;; rather than assumed:
    ;;
    ;;   - loops inline in the body        → `$result` opaque
    ;;   - `if` between two `record-new`s  → field projection LOST, even
    ;;                                       when both arms are visibly
    ;;                                       empty
    ;;   - one `record-new`, `if` per field → same loss
    ;;
    ;; Only a single unconditional `record-new` keeps `(. $result f)`
    ;; visible. So the shape below is as close as the checker allows,
    ;; and the obligation is discharged EMPIRICALLY by
    ;; `test-inconsistency-suppresses-both-lists`.
    ;;
    ;; Leaving the @post in place would be worse than removing it: it
    ;; fails, so `make verify` goes red and every other contract in the
    ;; project stops being a signal. Stating a postcondition the prover
    ;; cannot discharge reads as coverage while providing none (§7).
    ;; ONE `record-new`, with the emptiness decided per field, rather
    ;; than an `if` choosing between two whole records. The shape is
    ;; forced by the checker and it is worth stating why, because the
    ;; branch-per-record version reads better: an `if` whose arms are
    ;; two `record-new`s LOSES FIELD PROJECTION on `$result`, so the
    ;; postconditions above fail on a counterexample even when both arms
    ;; are trivially empty. A single `record-new` keeps the fields
    ;; visible. The loops are hoisted into the collectors above for the
    ;; same reason — a loop in this body would lose `$result` too.
    ;;
    ;; `inconsistent` is bound once and used three times, so the field
    ;; and the two guards cannot disagree: whatever makes the flag true
    ;; is exactly what empties the lists.
    (let ((inconsistent (detect-inconsistent sat names)))
      (record-new Findings
        (inconsistent  inconsistent)
        (unsatisfiable (if inconsistent
                         (list-new arena IRI)
                         (collect-unsatisfiable arena sat names)))
        (subsumptions  (if inconsistent
                         (list-new arena SubPair)
                         (collect-taxonomy arena sat names)))
        (imports-seen  (list-new arena IRI)))))

  ;; ============================================================
  ;; el++'s extraction (SPEC §5.4 K5): the same three sets, read from the
  ;; per-class answers instead of S(·). An answer's `unsat` stands for
  ;; ⊥ ∈ S(A) and its subsumers for S(A)'s class nodes, so the lists are
  ;; built as el's are: owl:Nothing excluded, an unsatisfiable class
  ;; compressed to (C, ⊥), both empty under inconsistency, sorted.
  ;; ============================================================

  (fn ksc-unsatisfiable ((arena Arena) (r KscResult))
    (@intent "Input classes other than owl:Nothing whose answer is unsat")
    (@spec ((Arena KscResult) -> (List IRI)))
    (@alloc arena)
    (let ((mut unsat (list-new arena IRI)))
      (do
        (for-each (a (. r answers))
          (match (. a cls)
            ((k-class iri)
              (when (not (is-bottom-iri iri))
                (when (. a unsat) (list-push unsat iri))))
            ((k-fresh _) (do))))
        (sort-iris arena unsat))))

  (fn ksc-taxonomy ((arena Arena) (r KscResult))
    (@intent "The subsumption hierarchy from the answers, bottom-compressed")
    (@spec ((Arena KscResult) -> (List SubPair)))
    (@alloc arena)
    (let ((mut subs (list-new arena SubPair))
          (bottom (node-bottom)))
      (do
        (for-each (a (. r answers))
          (match (. a cls)
            ((k-class iri)
              (when (not (is-bottom-iri iri))
                (let ((n (union-new Node class-node iri)))
                  (if (. a unsat)
                    (list-push subs (record-new SubPair (sub n) (super bottom)))
                    (for-each (b (. a subsumers))
                      (match b
                        ((k-class biri)
                          (list-push subs (record-new SubPair (sub n)
                                            (super (union-new Node class-node biri)))))
                        ((k-fresh _) (do))))))))
            ((k-fresh _) (do))))
        (sort-sub-pairs arena subs))))

  (fn extract-ksc-findings ((arena Arena) (r KscResult))
    (@intent "el++'s findings: inconsistency, unsatisfiable classes and the taxonomy (K5)")
    (@spec ((Arena KscResult) -> Findings))
    (@alloc arena)
    ;; The undefined-not-empty rule (§6.2), which extract-findings must
    ;; leave owed: under inconsistency both lists are empty.
    (@post {(. $result inconsistent) == (. r inconsistent)})
    (@post (implies {(. $result inconsistent) == true} {(list-len (. $result unsatisfiable)) == 0}))
    (@post (implies {(. $result inconsistent) == true} {(list-len (. $result subsumptions)) == 0}))
    ;; One record-new with the emptiness decided per field, for
    ;; extract-findings' reasons; `inconsistent` bound once.
    (let ((inconsistent (. r inconsistent)))
      (record-new Findings
        (inconsistent  inconsistent)
        (unsatisfiable (if inconsistent (list-new arena IRI) (ksc-unsatisfiable arena r)))
        (subsumptions  (if inconsistent (list-new arena SubPair) (ksc-taxonomy arena r)))
        (imports-seen  (list-new arena IRI)))))

  (fn ksc-answer-holds ((a ClassAnswer) (b KName))
    (@intent "K5's holds(A, B) on one answer: unsat(A), or B among A's subsumers")
    (@spec ((ClassAnswer KName) -> Bool))
    (if (. a unsat)
      true
      (let ((mut found false))
        (do
          (for-each (n (. a subsumers)) (when (kname-eq n b) (set! found true)))
          found))))

  (fn ksc-entails-sub ((r KscResult) (a KName) (b KName))
    (@intent "el++'s subsumption PROBE: inconsistent, or unsat(A), or holds(A, B) (K5)")
    (@spec ((KscResult KName KName) -> Bool))
    (@post (implies {(. r inconsistent) == true} {$result == true}))
    (if (. r inconsistent)
      true
      (let ((mut found false))
        (do
          (for-each (x (. r answers))
            (when (kname-eq (. x cls) a)
              (when (ksc-answer-holds x b) (set! found true))))
          found))))
)
