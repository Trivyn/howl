          (do (println "  [ksc] Self on a sub-role feeds a chain: Q ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 23) "http://example.org/t#C" "http://example.org/t#E") 1))
          (do (println "  [ksc] (29) re-points a sub-role triple into a chain: C ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 24) "http://example.org/t#C" "http://example.org/t#E") 1))
          (do (println "  [ksc] a super-role's range at a sub-role witness: C ⊑ E") (set! ok false)))
