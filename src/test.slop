;; ============================================================
;; HOWL test harness
;;
;; What is testable today is the VERDICT DISCIPLINE (§6.2) and the
;; structural invariants — the reasoning pipeline is still M0/M1.
;;
;; These are not placeholder tests. §10 item 4 calls the verdict rule a
;; SAFETY property and says to test it by trying to break it, in all
;; three rows, because the failure modes are opposite: folding
;; `inconclusive` into `coherent` gives CI a false pass, and folding it
;; into `incoherent` makes every ontology with an unsupported construct
;; look broken and trains users to ignore the gate.
;;
;; The sharpest row is #2 below — a finding under PARTIAL coverage is
;; still definitive, because inference is monotone. An earlier draft of
;; the spec got exactly that row wrong, sending every out-of-profile run
;; to inconclusive and thereby discarding a sound result.
;; ============================================================

(module test
  (@doc "Verdict-discipline and structural-invariant tests")

  (import rdf (IRI Triple Term make-iri make-blank make-triple term-eq))
  (import vocab (RDF_FIRST RDF_REST RDF_NIL RDFS_SUBCLASS_OF OWL_EQUIVALENT_CLASS
                 OWL_THING RDFS_LABEL))
  (import decode (graph-to-indexed rdf-list-checked term-at stage0-header Stage0
                  one-object decode-concept CONCEPT_FUEL build-signature
                  decode-axioms Stage1))
  (import gate (GateResult RboxVerdict expand-sugar gate-axioms check-regularity))
  (import owl2 (RawConcept Signature signature-has-class
                signature-has-object-property signature-has-annotation-property
                RawAxiom Disposition disposition axiom-in-profile))
  (import ttl (parse-ttl-file parse-ttl-string))
  (import rdf (Graph))
  (import types (Node RoleId NormAxiom Derived Addressed EdgePair LogicalEdge
                 Context Queue Saturation
                 Omission Coverage Termination SubPair Findings Outcome Fault
                 ReasonerConfig
                 default-config emit-edge make-context make-queue
                 node-top node-bottom node-eq role-eq derived-eq addressed-eq
                 outcome-is-complete findings-are-incoherent))
  (import canon (string-cmp iri-cmp node-cmp sort-iris sort-nodes iri-at int-at sort-range))
  (import saturate (RoundResult saturate make-initial-saturation))
  (import classify (extract-findings entails-sub))
  (import howl (Verdict verdict classify))

  ;; ============================================================
  ;; Fixture builders
  ;; ============================================================

  (fn empty-saturation ((arena Arena))
    (@intent "A Saturation with no contexts — enough to hang an Outcome on")
    (@spec ((Arena) -> Saturation))
    (@alloc arena)
    (record-new Saturation
      (contexts     (map-new arena Node Context))
      (queues       (map-new arena Node Queue))
      (active       (set-new arena Node))
      (active-count 0)
      (iteration    0)))

  (fn make-findings ((arena Arena) (inconsistent Bool) (unsat-count Int))
    (@intent "Findings with a controllable inconsistency flag and unsatisfiable-set size")
    (@spec ((Arena Bool Int) -> Findings))
    (@alloc arena)
    (let ((mut unsat (list-new arena IRI)))
      (do
        (when (> unsat-count 0)
          (list-push unsat (record-new IRI (value "http://example.org/Unsat"))))
        (record-new Findings
          (inconsistent  inconsistent)
          (unsatisfiable unsat)
          (subsumptions  (list-new arena SubPair))
          (imports-seen  (list-new arena IRI))))))

  (fn make-outcome ((arena Arena) (inconsistent Bool) (unsat-count Int)
                    (omitted-count Int) (reached-fixpoint Bool))
    (@intent "Assemble an Outcome across the three independent axes")
    (@spec ((Arena Bool Int Int Bool) -> Outcome))
    (@alloc arena)
    (let ((mut omitted (list-new arena Omission)))
      (do
        (when (> omitted-count 0)
          (list-push omitted
            (union-new Omission unresolved-import
              (record-new IRI (value "http://example.org/missing-import")))))
        (record-new Outcome
          (coverage    (record-new Coverage (omitted omitted)))
          (termination (if reached-fixpoint
                         (union-new Termination fixpoint)
                         (union-new Termination resource-limit 1000)))
          (findings    (make-findings arena inconsistent unsat-count))
          (saturation  (empty-saturation arena))))))

  (fn verdict-eq ((a Verdict) (b Verdict))
    (@intent "Compare two verdicts")
    (@spec ((Verdict Verdict) -> Bool))
    (@pure)
    (== a b))

  ;; ============================================================
  ;; Verdict discipline (§6.2, §10 item 4)
  ;; ============================================================

  ;; Row 3: nothing found, full coverage, fixpoint reached.
  (fn test-coherent-requires-complete ((arena Arena))
    (@intent "Clean findings + empty omissions + fixpoint => coherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (verdict-eq (verdict (make-outcome arena false 0 0 true)) 'verdict-coherent))

  ;; Row 2, first half: coverage gap alone blocks a coherent verdict.
  ;; This is the false-pass guard — the absence of a finding under
  ;; partial coverage carries NO information.
  (fn test-omission-blocks-coherent ((arena Arena))
    (@intent "Clean findings but a non-empty omission list => inconclusive, never coherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (verdict-eq (verdict (make-outcome arena false 0 1 true)) 'verdict-inconclusive))

  ;; Row 2, second half: hitting the round cap blocks it too.
  (fn test-cap-blocks-coherent ((arena Arena))
    (@intent "Clean findings but termination = resource-limit => inconclusive")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (verdict-eq (verdict (make-outcome arena false 0 0 false)) 'verdict-inconclusive))

  ;; Row 1, THE IMPORTANT ONE. A contradiction derived from a SUBSET of
  ;; the ontology is a contradiction in the whole ontology, because
  ;; inference is monotone — restoring an omitted axiom can only add
  ;; conclusions, never retract one. Reporting this as inconclusive
  ;; would discard a sound result.
  (fn test-finding-beats-partial-coverage ((arena Arena))
    (@intent "Inconsistent findings under BOTH a coverage gap and a cap => still incoherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (verdict-eq (verdict (make-outcome arena true 0 1 false)) 'verdict-incoherent))

  ;; Coherence is the WEAKEST of the three conditions: an unsatisfiable
  ;; named class makes an ontology incoherent whether or not it is
  ;; inconsistent. `consistent: true` with a non-empty unsatisfiable set
  ;; is a valid report and a FAILING condition.
  (fn test-consistent-but-incoherent ((arena Arena))
    (@intent "inconsistent = false but unsatisfiable non-empty => incoherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (verdict-eq (verdict (make-outcome arena false 1 0 true)) 'verdict-incoherent)
         (findings-are-incoherent (make-findings arena false 1))))

  ;; ============================================================
  ;; Structural invariants
  ;; ============================================================

  ;; §7 lists initialization as a Z3-reachable structural obligation,
  ;; and §5.2 explains why: seeds written into the STORE leave every
  ;; queue empty, so `active` is empty at round 0, the driver reports
  ;; fixpoint before firing a single rule, and the run returns an
  ;; instant empty classification that reads as success.
  (fn test-context-starts-with-empty-store ((arena Arena))
    (@intent "A fresh context has an EMPTY subsumer set — seeds belong in the delta")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((ctx (make-context arena
                 (union-new Node class-node
                   (record-new IRI (value "http://example.org/C"))))))
      (== (list-len (set-elements (. ctx subsumers))) 0)))

  (fn node-iri ((n Node))
    (@intent "The IRI text of a class or individual node; empty for a fresh node")
    (@spec ((Node) -> String))
    (match n
      ((class-node i)      (. i value))
      ((individual-node i) (. i value))
      ((fresh-node _)      "")))

  ;; A logical edge is ONE fact stored as TWO halves, and which half
  ;; goes where is the part that matters: emitting only the successor
  ;; looks complete from the deriving context and fails only in the
  ;; CONSUMING rules, since CR4/CR5 read `preds` and CR7 reads both
  ;; sides. The symptom is under-derivation with no error.
  ;;
  ;; `EdgePair` now makes "both halves exist" a TYPE guarantee and the
  ;; destinations a proven postcondition, so this test is a
  ;; belt-and-braces check on the wiring rather than the primary
  ;; defence it used to be.
  (fn test-emit-edge-addresses-both-halves ((arena Arena))
    (@intent "emit-edge sends the successor half to X and the predecessor half to Y")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (union-new Node class-node (record-new IRI (value "http://example.org/X"))))
          (y (union-new Node class-node (record-new IRI (value "http://example.org/Y"))))
          (r (union-new RoleId named-role (record-new IRI (value "http://example.org/r"))))
          (pair (emit-edge arena (record-new LogicalEdge (from x) (role r) (to y)))))
      (if (string-eq (node-iri (. (. pair succ-half) to)) "http://example.org/X")
        (string-eq (node-iri (. (. pair pred-half) to)) "http://example.org/Y")
        false)))

  ;; The stub must not hand back an Outcome. An Outcome carries a
  ;; verdict; a Fault does not. Until the rules land, silence must be
  ;; unreadable as success.
  (fn test-stub-refuses-rather-than-passing ((arena Arena))
    (@intent "classify returns a Fault, never an Outcome that could read as coherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (classify arena (list-new arena Triple) (list-new arena IRI) (default-config))
      ((ok _)    false)
      ((error _) true)))

  ;; ============================================================
  ;; M1 — the reasoning fixtures
  ;;
  ;; These drive `saturate` DIRECTLY rather than through
  ;; `howl.classify`, which still refuses. That is deliberate: until the
  ;; §5.2 gate exists to populate `coverage.omitted`, a partial rule set
  ;; behind a non-refusing `classify` would present as full coverage, a
  ;; reached fixpoint and no findings — which the verdict rule reads as
  ;; a clean COHERENT. The rules can be exercised without granting that.
  ;;
  ;; Axioms are hand-normalized. That is not a shortcut around the front
  ;; end; it is also how M0 gets its expected-canonical-`NormAxiom`
  ;; fixtures, since §6.3 requires normalization to be checked against
  ;; exactly this.
  ;; ============================================================

  (fn cls ((name String))
    (@intent "A class node")
    (@spec ((String) -> Node))
    (@pure)
    (union-new Node class-node (record-new IRI (value name))))

  (fn rol ((name String))
    (@intent "A named role")
    (@spec ((String) -> RoleId))
    (@pure)
    (union-new RoleId named-role (record-new IRI (value name))))

  (fn run-fixture ((arena Arena) (signature (List Node)) (axioms (List NormAxiom)))
    (@intent "Initialize from a signature and saturate to fixpoint")
    (@spec ((Arena (List Node) (List NormAxiom)) -> (Result RoundResult Fault)))
    (@alloc arena)
    (saturate arena (make-initial-saturation arena signature) axioms (default-config)))

  ;; ------------------------------------------------------------
  ;; §3.1 THE LITMUS. This is the test that decides whether HOWL is a
  ;; DL reasoner or a materialization engine.
  ;;
  ;;   Parent ≡ Person ⊓ ∃hasChild.Person
  ;;   Mother ⊑ Person ⊓ ∃hasChild.Person        ⟹  Mother ⊑ Parent
  ;;
  ;; Entailed only THROUGH the existential on the defining side, which
  ;; is exactly what forward materialization cannot see. Normalized, the
  ;; defining side's ∃ sits in NEGATIVE position, so it needs
  ;; `∃hasChild.Person ⊑ X` — see `test-polarity-guard` for what happens
  ;; if that direction is flipped.
  ;; ------------------------------------------------------------

  (fn litmus-signature ((arena Arena))
    (@intent "Person, Parent, Mother, and the fresh node normalization introduces")
    (@spec ((Arena) -> (List Node)))
    (@alloc arena)
    (let ((mut sig (list-new arena Node)))
      (do
        (list-push sig (cls "http://example.org/Person"))
        (list-push sig (cls "http://example.org/Parent"))
        (list-push sig (cls "http://example.org/Mother"))
        (list-push sig (union-new Node fresh-node 0))
        sig)))

  (fn litmus-axioms ((arena Arena) (correct-polarity Bool))
    (@intent "The §3.1 litmus in normal form; `false` flips the fresh definition")
    (@spec ((Arena Bool) -> (List NormAxiom)))
    (@alloc arena)
    (let ((person (cls "http://example.org/Person"))
          (parent (cls "http://example.org/Parent"))
          (mother (cls "http://example.org/Mother"))
          (x      (union-new Node fresh-node 0))
          (has-child (rol "http://example.org/hasChild"))
          (mut ax (list-new arena NormAxiom)))
      (do
        ;; ∃hasChild.Person ⊑ X — NEGATIVE position, the load-bearing one.
        (if correct-polarity
          (list-push ax (union-new NormAxiom sub-some-lhs has-child person x))
          ;; The conservative-but-incomplete rewrite: X ⊑ ∃hasChild.Person.
          (list-push ax (union-new NormAxiom sub-some-rhs x has-child person)))
        ;; Person ⊓ X ⊑ Parent
        (list-push ax (union-new NormAxiom sub-and person x parent))
        ;; Parent ⊑ Person, Parent ⊑ ∃hasChild.Person
        (list-push ax (union-new NormAxiom sub-name parent person))
        (list-push ax (union-new NormAxiom sub-some-rhs parent has-child person))
        ;; Mother ⊑ Person, Mother ⊑ ∃hasChild.Person
        (list-push ax (union-new NormAxiom sub-name mother person))
        (list-push ax (union-new NormAxiom sub-some-rhs mother has-child person))
        ax)))

  (fn litmus-derives-parent ((arena Arena) (correct-polarity Bool))
    (@intent "Run the litmus and probe Mother ⊑ Parent")
    (@spec ((Arena Bool) -> Bool))
    (@alloc arena)
    (match (run-fixture arena (litmus-signature arena) (litmus-axioms arena correct-polarity))
      ((ok r)
        (let ((f (extract-findings arena (. r saturation))))
          (entails-sub (. r saturation) (. f inconsistent)
            (cls "http://example.org/Mother") (cls "http://example.org/Parent"))))
      ((error _) false)))

  (fn test-litmus ((arena Arena))
    (@intent "§3.1: HOWL derives Mother ⊑ Parent — the DL-reasoner threshold")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (litmus-derives-parent arena true))

  ;; The mirror, and it is a REAL test rather than a curiosity. §6.3
  ;; step 3 warns that the one-sided "definitional" rewrite is
  ;; conservative, incomplete, and looks like it followed the spec's
  ;; example. If this ever passes, normalization has silently lost the
  ;; only entailment that defines the project.
  (fn test-polarity-guard ((arena Arena))
    (@intent "With the fresh definition at the WRONG polarity, Mother ⊑ Parent is NOT derivable")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (not (litmus-derives-parent arena false)))

  ;; ------------------------------------------------------------
  ;; Termination. §6.4: the `\ Sₙ` novelty test is not an optimization —
  ;; without it, `A ⊑ B, B ⊑ A` re-derives both subsumers every round,
  ;; a batch-only dedup keeps them because they are distinct WITHIN the
  ;; batch, the frontier never empties, and an ordinary cyclic hierarchy
  ;; burns its budget and returns inconclusive forever.
  ;; ------------------------------------------------------------

  (fn test-cyclic-hierarchy-terminates ((arena Arena))
    (@intent "A ⊑ B, B ⊑ A reaches FIXPOINT rather than the round cap")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (cls "http://example.org/A"))
          (b (cls "http://example.org/B"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig a)
        (list-push sig b)
        (list-push ax (union-new NormAxiom sub-name a b))
        (list-push ax (union-new NormAxiom sub-name b a))
        (match (run-fixture arena sig ax)
          ((ok r)
            (match (. r termination)
              ((fixpoint)         true)
              ((resource-limit _) false)))
          ((error _) false)))))

  ;; ------------------------------------------------------------
  ;; CR4's two-sided trigger, and the round snapshot that makes it work.
  ;;
  ;;   E ⊑ ∃r.F,  F ⊑ G,  ∃r.G ⊑ H     ⟹  E ⊑ H
  ;;
  ;; The edge (E,r,F) and the subsumer G ∈ S(F) are derived in the SAME
  ;; round, so both land in F's inbox together. §6.4 calls this the
  ;; silent-and-permanent case: if the driver joined against the
  ;; PRE-round state Sₙ₋₁, neither premise would see the other, and in
  ;; the next round neither is in the delta any more — so the conclusion
  ;; is never derived, by any handler, ever. Sₙ = Sₙ₋₁ ∪ Δₙ is what
  ;; makes it reachable.
  ;; ------------------------------------------------------------

  (fn test-same-round-co-arrival ((arena Arena))
    (@intent "A CR4 subsumer and its matching predecessor edge arriving together still conclude")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((e (cls "http://example.org/E"))
          (f (cls "http://example.org/F"))
          (g (cls "http://example.org/G"))
          (h (cls "http://example.org/H"))
          (r (rol "http://example.org/r"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig e) (list-push sig f) (list-push sig g) (list-push sig h)
        (list-push ax (union-new NormAxiom sub-some-rhs e r f))   ; E ⊑ ∃r.F
        (list-push ax (union-new NormAxiom sub-name f g))          ; F ⊑ G
        (list-push ax (union-new NormAxiom sub-some-lhs r g h))    ; ∃r.G ⊑ H
        (match (run-fixture arena sig ax)
          ((ok res)
            (let ((fi (extract-findings arena (. res saturation))))
              (entails-sub (. res saturation) (. fi inconsistent) e h)))
          ((error _) false)))))

  ;; The MIRROR, and it exists because mutation testing found a hole:
  ;; deleting `cr-exists-lhs-on-sub` from the dispatcher broke no test
  ;; at all. Both the litmus and the co-arrival fixture happen to have
  ;; the edge arrive no earlier than the subsumer, so CR4's *other*
  ;; handler covered them and this one was never needed.
  ;;
  ;;   E ⊑ ∃r.F,  F ⊑ F1,  F1 ⊑ G,  ∃r.G ⊑ H     ⟹  E ⊑ H
  ;;
  ;; The chain F ⊑ F1 ⊑ G DELAYS G by one round, so the edge (E,r,F)
  ;; has already arrived and been processed by the time G reaches S(F).
  ;; Only the new-subsumer handler, scanning the STORED predecessors,
  ;; can close it. §6.4's point exactly: a multi-premise rule must be
  ;; re-triggered by EACH premise independently, and which premise
  ;; arrives last is a scheduling artifact.
  ;; ------------------------------------------------------------

  (fn test-late-subsumer-still-concludes ((arena Arena))
    (@intent "CR4 concludes when the subsumer arrives AFTER its edge — pins the new-subsumer handler")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((e  (cls "http://example.org/E"))
          (f  (cls "http://example.org/F"))
          (f1 (cls "http://example.org/F1"))
          (g  (cls "http://example.org/G"))
          (h  (cls "http://example.org/H"))
          (r  (rol "http://example.org/r"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig e) (list-push sig f) (list-push sig f1)
        (list-push sig g) (list-push sig h)
        (list-push ax (union-new NormAxiom sub-some-rhs e r f))   ; E ⊑ ∃r.F
        (list-push ax (union-new NormAxiom sub-name f f1))         ; F ⊑ F1
        (list-push ax (union-new NormAxiom sub-name f1 g))         ; F1 ⊑ G  (the delay)
        (list-push ax (union-new NormAxiom sub-some-lhs r g h))    ; ∃r.G ⊑ H
        (match (run-fixture arena sig ax)
          ((ok res)
            (let ((fi (extract-findings arena (. res saturation))))
              (entails-sub (. res saturation) (. fi inconsistent) e h)))
          ((error _) false)))))

  ;; ------------------------------------------------------------
  ;; Unsatisfiability, and the two outputs that follow from it.
  ;;
  ;;   A ⊑ B,  A ⊑ C,  B ⊓ C ⊑ ⊥       ⟹  ⊥ ∈ S(A)
  ;;
  ;; Note this ontology is CONSISTENT and INCOHERENT at once — exactly
  ;; the case `validate` exists to catch and the one a reasoner keyed
  ;; only on inconsistency misses.
  ;; ------------------------------------------------------------

  (fn unsat-fixture ((arena Arena))
    (@intent "A ⊑ B, A ⊑ C, B ⊓ C ⊑ ⊥")
    (@spec ((Arena) -> (Result RoundResult Fault)))
    (@alloc arena)
    (let ((a (cls "http://example.org/A"))
          (b (cls "http://example.org/B"))
          (c (cls "http://example.org/C"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig a) (list-push sig b) (list-push sig c)
        (list-push ax (union-new NormAxiom sub-name a b))
        (list-push ax (union-new NormAxiom sub-name a c))
        (list-push ax (union-new NormAxiom sub-and b c (node-bottom)))
        (run-fixture arena sig ax))))

  (fn test-unsatisfiable-class-detected ((arena Arena))
    (@intent "⊥ ∈ S(A) surfaces as a non-empty unsatisfiable set, and owl:Nothing does NOT")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (unsat-fixture arena)
      ((ok r)
        (let ((f (extract-findings arena (. r saturation))))
          ;; Exactly one unsatisfiable class: A. If owl:Nothing leaked in
          ;; — and it satisfies ⊥ ∈ S(⊥) by construction, since every
          ;; context is seeded with itself — this would be 2, and every
          ;; real ontology would exit 1.
          (if (== (list-len (. f unsatisfiable)) 1)
            (findings-are-incoherent f)
            false)))
      ((error _) false)))

  (fn test-bottom-compression ((arena Arena))
    (@intent "The PROBE answers true for an unsatisfiable A; the TAXONOMY holds only (A,⊥)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (unsat-fixture arena)
      ((ok r)
        (let ((a (cls "http://example.org/A"))
              (b (cls "http://example.org/B"))
              (f (extract-findings arena (. r saturation)))
              (mut pairs-about-a 0))
          (do
            (for-each (p (. f subsumptions))
              (when (node-eq (. p sub) a)
                (set! pairs-about-a (+ pairs-about-a 1))))
            ;; A is unsatisfiable, so A ⊑ B is entailed for EVERY B and
            ;; the probe must say so. The taxonomy must NOT say so, or an
            ;; unsatisfiable class explodes the hierarchy by the size of
            ;; the signature. Both readings are defensible in isolation;
            ;; implementing one where the other belongs gives either
            ;; false negatives on probes or a quadratic hierarchy.
            (if (entails-sub (. r saturation) (. f inconsistent) a b)
              (== pairs-about-a 1)
              false))))
      ((error _) false)))

  ;; ------------------------------------------------------------
  ;; UNDEFINED, NOT EMPTY. Under inconsistency both output lists are
  ;; empty because they are UNDEFINED — an inconsistent ontology has no
  ;; model, so every class is unsatisfiable and every subsumption
  ;; entailed, yet raw ⊥ ∈ S(A) finds none of them when the
  ;; inconsistency arrived through ⊤ or an individual. `inconsistent:
  ;; true` alongside a populated `unsatisfiable` would read as a partial
  ;; census of the damage; alongside an empty one it reads as
  ;; "consistent classes". Neither is what the fields mean.
  ;;
  ;; This carries the obligation that `extract-findings` states as OWED:
  ;; the contracts are true but undischargeable by the checker, so the
  ;; guarantee lives here instead of nowhere.
  ;;
  ;;   ⊤ ⊑ ⊥   ⟹   ⊥ ∈ S(⊤)   ⟹   inconsistent
  ;; ------------------------------------------------------------

  (fn test-inconsistency-suppresses-both-lists ((arena Arena))
    (@intent "An inconsistent ontology reports EMPTY lists, not a partial census")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (cls "http://example.org/A"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig a)
        ;; ⊤ ⊑ ⊥ — the smallest inconsistency there is.
        (list-push ax (union-new NormAxiom sub-name (node-top) (node-bottom)))
        (match (run-fixture arena sig ax)
          ((ok r)
            (let ((f (extract-findings arena (. r saturation))))
              (if (. f inconsistent)
                (if (== (list-len (. f unsatisfiable)) 0)
                  (== (list-len (. f subsumptions)) 0)
                  false)
                false)))
          ((error _) false)))))

  ;; The equality the toolchain does not give us. `==` on a `Derived` compares
  ;; ONLY the first payload (slop-lang/slop#66): `(derived-succ r Y₁)` and
  ;; `(derived-succ r Y₂)` come back equal, because the role matches and the
  ;; node is never examined. Nothing in HOWL keys a Set on `Derived`, so the
  ;; broken function is not even emitted today — but this test pins the
  ;; behaviour we DO rely on, and it is the check that will still be here if
  ;; someone reaches for `==` after 0.1.3 lands and the hazard looks retired.
  (fn test-derived-eq-compares-both-payloads ((arena Arena))
    (@intent "derived-eq distinguishes a second payload that generated `==` ignores")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((r  (rol "http://example.org/r"))
          (y1 (cls "http://example.org/Y1"))
          (y2 (cls "http://example.org/Y2"))
          (x  (cls "http://example.org/X")))
      (do
        (if (derived-eq (union-new Derived derived-succ r y1)
                        (union-new Derived derived-succ r y2))
          false
          (if (not (derived-eq (union-new Derived derived-succ r y1)
                               (union-new Derived derived-succ r y1)))
            false
            ;; Cross-variant: same role, same node, different direction.
            (if (derived-eq (union-new Derived derived-succ r y1)
                            (union-new Derived derived-pred r y1))
              false
              ;; Addressed must compare destination AND payload.
              (if (addressed-eq
                    (record-new Addressed (to x) (what (union-new Derived derived-sub y1)))
                    (record-new Addressed (to y2) (what (union-new Derived derived-sub y1))))
                false
                (addressed-eq
                  (record-new Addressed (to x) (what (union-new Derived derived-sub y1)))
                  (record-new Addressed (to x) (what (union-new Derived derived-sub y1)))))))))))

  ;; ------------------------------------------------------------
  ;; Order independence (§6.8). Set iteration is bucket order, which is
  ;; not content-canonical, so a round must not depend on it. Feeding
  ;; the same theory with the signature in the opposite order perturbs
  ;; map insertion order without changing content; the round count and
  ;; the findings sizes must be identical.
  ;;
  ;; This checks SIZES rather than element order, because canonical
  ;; ordering of the findings lists is still OWED (see classify.slop) —
  ;; asserting element order here would be asserting something the
  ;; implementation does not yet claim.
  ;; ------------------------------------------------------------

  (fn test-order-independence ((arena Arena))
    (@intent "Reversing the signature changes neither the round count nor the findings")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (cls "http://example.org/A"))
          (b (cls "http://example.org/B"))
          (c (cls "http://example.org/C"))
          (mut fwd (list-new arena Node))
          (mut rev (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push fwd a) (list-push fwd b) (list-push fwd c)
        (list-push rev c) (list-push rev b) (list-push rev a)
        (list-push ax (union-new NormAxiom sub-name a b))
        (list-push ax (union-new NormAxiom sub-name b c))
        (match (run-fixture arena fwd ax)
          ((ok r1)
            (match (run-fixture arena rev ax)
              ((ok r2)
                (let ((f1 (extract-findings arena (. r1 saturation)))
                      (f2 (extract-findings arena (. r2 saturation))))
                  (if (== (. (. r1 saturation) iteration) (. (. r2 saturation) iteration))
                    (if (== (list-len (. f1 subsumptions)) (list-len (. f2 subsumptions)))
                      (== (list-len (. f1 unsatisfiable)) (list-len (. f2 unsatisfiable)))
                      false)
                    false)))
              ((error _) false)))
          ((error _) false)))))

  ;; ============================================================

  ;; ============================================================
  ;; Canonical ordering (§6.8) — src/canon.slop
  ;; ============================================================

  (fn mk-iri ((v String))
    (@intent "An IRI record from a string")
    (@spec ((String) -> IRI))
    (@pure)
    (record-new IRI (value v)))

  (fn test-string-cmp-is-length-safe ((arena Arena))
    (@intent "A prefix orders by LENGTH, not by the bytes that follow it in the buffer")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE HAZARD, DEMONSTRATED. `strlib.compare` is `strcmp` over
    ;; `(. a data)`, so it reads to the first NUL. Every IRI HOWL
    ;; orders is a slice into a parsed Turtle buffer, where the byte
    ;; after an IRI is the rest of the document. `apple` below is
    ;; exactly such a slice — it shares its storage with `applesauce`
    ;; and has no NUL at offset 5 — so `strcmp` would compare
    ;; "applesauce" against "applesauce" and report EQUAL, silently
    ;; merging two distinct IRIs in a sorted report. `string-cmp` uses
    ;; the length and gets it right.
    (let ((buf   "applesauce")
          (apple (String (. buf data) 5)))
      (and (== (string-cmp apple buf) -1)
        (and (== (string-cmp buf apple) 1)
          (and (== (string-cmp apple "apple") 0)
               (== (string-cmp apple apple) 0))))))

  (fn test-node-cmp-separates-punned-iris ((arena Arena))
    (@intent "class-node(:x) and individual-node(:x) are DISTINCT under the order")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; §6.2: OWL permits punning, so the same IRI can denote a class
    ;; AND an individual. A comparator reading only the IRI would call
    ;; these equal, collapsing the two populations the tags exist to
    ;; keep apart — and §6.2's own example shows the cost: a class
    ;; `:x ⊑ ⊥` merged with an unrelated individual `:x` manufactures a
    ;; FALSE inconsistency.
    (let ((c (union-new Node class-node (mk-iri "http://example.org/x")))
          (i (union-new Node individual-node (mk-iri "http://example.org/x"))))
      (and (!= (node-cmp c i) 0)
        (and (== (node-cmp c i) -1)          ; class-node sorts first
          (and (== (node-cmp i c) 1)
               (== (node-cmp c c) 0))))))

  (fn test-sort-orders-and-is-input-determined ((arena Arena))
    (@intent "Sorting is a function of CONTENT, not of insertion order (§6.8)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The §6.8 property in miniature: the same four IRIs presented in
    ;; two different orders must produce byte-identical output. This is
    ;; what makes a report hashable into a durable verdict.
    (let ((mut a (list-new arena IRI))
          (mut b (list-new arena IRI)))
      (do
        (list-push a (mk-iri "http://example.org/zebra"))
        (list-push a (mk-iri "http://example.org/apple"))
        (list-push a (mk-iri "http://example.org/apple2"))
        (list-push a (mk-iri "http://example.org/mango"))
        (list-push b (mk-iri "http://example.org/mango"))
        (list-push b (mk-iri "http://example.org/apple2"))
        (list-push b (mk-iri "http://example.org/zebra"))
        (list-push b (mk-iri "http://example.org/apple"))
        (let ((sa (sort-iris arena a))
              (sb (sort-iris arena b))
              (mut ok true)
              (mut i 0)
              (n  (cast Int (list-len sa))))
          (do
            ;; same length as the input, and as each other
            (if (!= n 4) (set! ok false) (do))
            (if (!= (cast Int (list-len sb)) 4) (set! ok false) (do))
            ;; element-wise identical, and ascending
            (while (< i n)
              (do
                (if (!= (iri-cmp (iri-at sa i) (iri-at sb i)) 0)
                  (set! ok false) (do))
                (if (and (> i 0) (>= (iri-cmp (iri-at sa (- i 1)) (iri-at sa i)) 0))
                  (set! ok false) (do))
                (set! i (+ i 1))))
            ;; and the least really is the least
            (if (!= (iri-cmp (iri-at sa 0) (mk-iri "http://example.org/apple")) 0)
              (set! ok false) (do))
            ok)))))

  ;; ============================================================
  ;; Front end — the checked RDF-list walk (M0 slice 2)
  ;; ============================================================

  (fn ex-iri ((arena Arena) (local String))
    (@intent "An example-namespace IRI term")
    (@spec ((Arena String) -> Term))
    (@alloc arena)
    (make-iri arena (string-concat arena "http://example.org/t#" local)))

  ;; ============================================================
  ;; Front end — stage 0, the header pre-pass (M0 slice 2)
  ;;
  ;; These run against the REAL corpus fixtures rather than
  ;; hand-built triples. The fixtures are what SPEC.md §12's
  ;; acceptance criteria name, so testing anything else would be
  ;; testing a paraphrase of the requirement.
  ;; ============================================================

  (fn count-subclass-triples ((ts (List Triple)) (pred Term))
    (@intent "How many rdfs:subClassOf triples survived stage 0")
    (@spec (((List Triple) Term) -> Int))
    (@pure)
    (let ((mut n 0))
      (do
        (for-each (t ts)
          (when (term-eq (. t predicate) pred) (set! n (+ n 1))))
        n)))

  (fn test-unattested-import-yields-an-omission ((arena Arena))
    (@intent "M0 ACCEPTANCE (b): a declared import nobody supplied becomes an omission")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE FALSE PASS THIS CLOSES. HOWL never fetches an import; the
    ;; caller attests to the closure it supplied. A declared import
    ;; nobody attested to means axioms HOWL never saw, so a "coherent"
    ;; verdict would be over a strictly smaller ontology than the
    ;; document describes — sound about the wrong input.
    (match (parse-ttl-file arena "corpus/fixtures/hazards/unattested-import.ttl")
      ((error _) false)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) false)
          ((ok s0)
            (and (== (cast Int (list-len (. s0 imports-declared))) 1)
                 (== (cast Int (list-len (. s0 omissions))) 1)))))))

  (fn test-attested-import-yields-none ((arena Arena))
    (@intent "The same document, with the import attested, gates clean")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The necessary other half. Without it the test above passes for
    ;; an implementation that emits an omission for EVERY import,
    ;; which would make every real ontology inconclusive.
    (match (parse-ttl-file arena "corpus/fixtures/hazards/unattested-import.ttl")
      ((error _) false)
      ((ok g)
        (let ((mut resolved (list-new arena IRI)))
          (do
            (list-push resolved (record-new IRI (value "http://example.org/does-not-exist")))
            (match (stage0-header arena (. g triples) resolved)
              ((error _) false)
              ((ok s0)
                (and (== (cast Int (list-len (. s0 imports-declared))) 1)
                     (== (cast Int (list-len (. s0 omissions))) 0)))))))))

  (fn test-header-and-reification-are-consumed ((arena Arena))
    (@intent "Ontology header and owl:Axiom scaffolding leave stage 0 as logical content")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; annotation-heavy.ttl asserts `:A rdfs:subClassOf :B` AND reifies
    ;; it. Stage 0 must reconstruct the reified axiom without
    ;; duplicating the asserted one — exactly one subclass triple
    ;; survives — and must leave no versionIRI, versionInfo or
    ;; annotatedTarget triple behind for the gate to call unsupported.
    (match (parse-ttl-file arena "corpus/fixtures/hazards/annotation-heavy.ttl")
      ((error _) false)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) false)
          ((ok s0)
            (let ((sub-pred (make-iri arena RDFS_SUBCLASS_OF))
                  (kept (count-subclass-triples (. s0 triples) sub-pred))
                  (before (count-subclass-triples (. g triples) sub-pred)))
              ;; The document writes the subclass triple once, plus an
              ;; owl:annotatedProperty naming rdfs:subClassOf — which is
              ;; NOT a subclass triple and must not be counted as one.
              (and (== kept 1)
                   (and (== before 1)
                        (and (== (cast Int (list-len (. s0 omissions))) 0)
                             (< (cast Int (list-len (. s0 triples)))
                                (cast Int (list-len (. g triples)))))))))))))

  ;; ============================================================
  ;; Front end — stage 1a, class expressions (M0 slice 2)
  ;; ============================================================

  (fn count-out-of-profile ((axs (List RawAxiom)))
    (@intent "How many decoded axioms v0 cannot take — form OR operands")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    ;; BOTH CONDITIONS, and the corpus proved why. Counting only
    ;; `d-out-of-profile` passed six out-of-profile fixtures silently:
    ;; `SubClassOf(A, ObjectUnionOf(B,C))` is a SubClassOf, an
    ;; in-profile FORM, carrying a concept ELH⊥R+ has no constructor
    ;; for. The form matrix cannot see into the operands.
    (let ((mut n 0))
      (do
        (for-each (a axs)
          (match (disposition a)
            ('d-out-of-profile (set! n (+ n 1)))
            ('d-in-profile     (when (not (axiom-in-profile a)) (set! n (+ n 1))))
            ('d-inert          (do))
            ('d-consumed       (do))))
        n)))

  (fn count-disposition ((axs (List RawAxiom)) (want Disposition))
    (@intent "How many decoded axioms carry the given disposition")
    (@spec (((List RawAxiom) Disposition) -> Int))
    (@pure)
    (let ((mut n 0))
      (do
        (for-each (a axs)
          (when (== (disposition a) want) (set! n (+ n 1))))
        n)))

  (fn decode-fixture ((arena Arena) (path String))
    (@intent "Parse, stage 0, stage 1 — the whole front end as it stands")
    (@spec ((Arena String) -> (Option Stage1)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)
            (match (decode-axioms arena (. s0 triples))
              ((error _) (none))
              ((ok s1)  (some s1))))))))

  (fn nary-disjoint-member-count ((axs (List RawAxiom)))
    (@intent "How many classes the decoded n-ary disjointness actually carries")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    (let ((mut n 0))
      (do
        (for-each (a axs)
          (match a
            ((ra-disjoint-classes cs) (set! n (cast Int (list-len cs))))
            (_ (do))))
        n)))

  (fn test-nary-disjointness-keeps-its-members ((arena Arena))
    (@intent "owl:AllDisjointClasses decodes with all three members, not zero")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A SILENTLY EMPTIED AXIOM IS THE WORST FAILURE SHAPE. This axiom
    ;; is IN PROFILE, so decoding it with an empty member list would
    ;; have HOWL accept it, derive nothing from it, and still report
    ;; full coverage — a wrong answer no coverage check can see,
    ;; because the axiom is counted as handled. Only reading the
    ;; members back catches it.
    (match (decode-fixture arena "corpus/fixtures/v0/disjoint-nary.ttl")
      ((none) false)
      ((some s1)
        (and (== (nary-disjoint-member-count (. s1 axioms)) 3)
             (== (count-out-of-profile (. s1 axioms)) 0)))))

  (fn out-of-profile-count-of ((arena Arena) (path String))
    (@intent "Out-of-profile axioms in a fixture, or -1 if it did not decode")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (decode-fixture arena path)
      ((none)    -1)
      ((some s1) (count-out-of-profile (. s1 axioms)))))

  (fn test-v0-corpus-decodes-clean ((arena Arena))
    (@intent "Every v0 fixture decodes with nothing out of profile")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The v0 corpus IS the profile, fixture by fixture. One of these
    ;; going out-of-profile means a construct the spec admits has no
    ;; decoder — which downstream looks like an incomplete ontology
    ;; rather than a missing feature.
    (let ((mut paths (list-new arena String))
          (mut ok true))
      (do
        (list-push paths "corpus/fixtures/v0/subclass-atomic.ttl")
        (list-push paths "corpus/fixtures/v0/intersection.ttl")
        (list-push paths "corpus/fixtures/v0/exists-lhs.ttl")
        (list-push paths "corpus/fixtures/v0/exists-rhs.ttl")
        (list-push paths "corpus/fixtures/v0/equivalent-classes.ttl")
        (list-push paths "corpus/fixtures/v0/equivalent-properties.ttl")
        (list-push paths "corpus/fixtures/v0/disjoint-binary.ttl")
        (list-push paths "corpus/fixtures/v0/disjoint-nary.ttl")
        (list-push paths "corpus/fixtures/v0/subproperty.ttl")
        (list-push paths "corpus/fixtures/v0/property-chain.ttl")
        (list-push paths "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push paths "corpus/fixtures/v0/transitive.ttl")
        (list-push paths "corpus/fixtures/v0/domain.ttl")
        (list-push paths "corpus/fixtures/v0/range.ttl")
        (list-push paths "corpus/fixtures/v0/abox-assertions.ttl")
        (list-push paths "corpus/fixtures/v0/top-bottom.ttl")
        (list-push paths "corpus/fixtures/v0/litmus.ttl")
        (for-each (p paths)
          (when (!= (out-of-profile-count-of arena p) 0)
            (do (print "  [sweep] expected 0 out-of-profile, got ")
                (print (int-to-string arena (out-of-profile-count-of arena p)))
                (print " in ") (println p)
                (set! ok false))))
        ok)))

  (fn test-out-of-profile-corpus-is-caught ((arena Arena))
    (@intent "All 14 out-of-profile fixtures yield at least one rejected axiom")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The other half, and the one that matters for soundness: a
    ;; construct v0 cannot handle must be REPORTED, not quietly decoded
    ;; into something in-profile. A decoder that mapped owl:unionOf onto
    ;; an intersection would pass the v0 sweep above and be catastrophic.
    (let ((mut paths (list-new arena String))
          (mut ok true))
      (do
        (list-push paths "corpus/fixtures/out-of-profile/union.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/complement.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/allvalues.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/nominals.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/cardinality.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/has-self.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/inverse.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/equality.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/property-characteristics.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/haskey-disjointunion.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/swrl-rule.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/builtin-roles.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/anonymous-individual.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/datatypes.ttl")
        (for-each (p paths)
          (when (< (out-of-profile-count-of arena p) 1)
            (do (print "  [sweep] expected >=1 out-of-profile, got ")
                (print (int-to-string arena (out-of-profile-count-of arena p)))
                (print " in ") (println p)
                (set! ok false))))
        ok)))

  (fn test-annotation-heavy-decodes-clean ((arena Arena))
    (@intent "M0 ACCEPTANCE (a): nothing in an annotated ontology is out of profile")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE FAILURE THIS CATCHES IS TOTAL, NOT PARTIAL. If labels,
    ;; declarations or reification reach the out-of-profile list, every
    ;; real ontology gates dirty and NOTHING downstream ever classifies
    ;; — HOWL would be correct and useless. The independent census got
    ;; exactly this wrong on its first run, bucketing 350
    ;; owl:annotatedTarget triples as unsupported.
    (match (decode-fixture arena "corpus/fixtures/hazards/annotation-heavy.ttl")
      ((none) false)
      ((some s1)
        (let ((axs (. s1 axioms)))
          (and (== (count-out-of-profile axs) 0)
            ;; and the logical content SURVIVED: the subclass axiom is
            ;; still there. A decoder that dropped everything would also
            ;; score zero out-of-profile.
            (and (> (count-disposition axs 'd-in-profile) 0)
              (and (> (count-disposition axs 'd-inert) 0)
                   (> (count-disposition axs 'd-consumed) 0))))))))

  (fn test-litmus-decodes-clean ((arena Arena))
    (@intent "The litmus ontology decodes with nothing out of profile")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (decode-fixture arena "corpus/fixtures/v0/litmus.ttl")
      ((none) false)
      ((some s1)
        (let ((axs (. s1 axioms)))
          (and (== (count-out-of-profile axs) 0)
               ;; Parent's equivalence and Mother's inclusion, at least.
               (>= (count-disposition axs 'd-in-profile) 2))))))

  ;; ============================================================
  ;; Front end — sugar expansion and the profile gate (M0 slice 3)
  ;; ============================================================

  (fn test-missing-class-declaration-is-reported ((arena Arena))
    (@intent "A class used in a subsumption but never declared is an omission")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Determinate position: the object of rdfs:subClassOf can only be a
    ;; class, so there IS an EntityKind to report and the recoverable
    ;; `missing-declaration` omission applies — unlike the ambiguous
    ;; property case, which faults instead.
    (let ((pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n"))
      (and (> (gate-omissions-of-ttl arena (string-concat arena pre
                ":A a owl:Class . :A rdfs:subClassOf :B .")) 0)
           ;; THE ACCEPTING HALF: declare :B and the same document gates
           ;; clean. Without it this passes for an implementation that
           ;; reports a missing declaration for every class in existence.
           (== (gate-omissions-of-ttl arena (string-concat arena pre
                 ":A a owl:Class . :B a owl:Class . :A rdfs:subClassOf :B .")) 0))))

  (fn test-undeclared-individual-is-not-reported ((arena Arena))
    (@intent "Named-individual declarations are OPTIONAL in OWL 2 DL")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Requiring one would report a finding against the majority of
    ;; published ABoxes — a false-fail that looks rigorous. Position and
    ;; declaration are additive: an IRI may be used as an individual
    ;; with no owl:NamedIndividual triple at all.
    (let ((ttl "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n:A a owl:Class . :p a owl:ObjectProperty .\n:a a :A . :a :p :b .\n"))
      (== (gate-omissions-of-ttl arena ttl) 0)))

  (fn decodes-ok ((arena Arena) (ttl String))
    (@intent "Does this document get past stage 1 without an input-error?")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (parse-ttl-string arena ttl)
      ((error _) false)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) false)
          ((ok s0)
            (match (decode-axioms arena (. s0 triples))
              ((error _) false)
              ((ok _)    true)))))))

  (fn test-undeclared-property-is-an-input-error ((arena Arena))
    (@intent "`:a :p :b` with :p undeclared is ambiguous, so it FAULTS")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; `missing-declaration` is recoverable only where structural
    ;; position uniquely fixes the entity kind. Here it does not: :p
    ;; could be an object property or an annotation property, and
    ;; neither reading can be reported as missing-declaration(kind, …)
    ;; because there is no determinate kind to name.
    (let ((pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n:a a owl:NamedIndividual . :b a owl:NamedIndividual .\n"))
      (and (not (decodes-ok arena (string-concat arena pre ":a :p :b .")))
           ;; THE ACCEPTING HALF: declare it and the same document is
           ;; fine. Without this the test passes for an implementation
           ;; that rejects every property assertion in existence.
           (decodes-ok arena (string-concat arena pre
             ":p a owl:ObjectProperty . :a :p :b .")))))

  (fn test-unknown-owl-vocabulary-still-decodes ((arena Arena))
    (@intent "Reserved vocabulary HOWL does not implement gates, never faults")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A future profile's axiom must DECODE and be reported, not fail to
    ;; parse. Treating unknown owl: vocabulary like an undeclared user
    ;; property would fail a document merely for mentioning it.
    (let ((ttl "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n:A a owl:Class . :B a owl:Class .\n:A owl:someFutureAxiom :B .\n"))
      (and (decodes-ok arena ttl)
           (> (gate-omissions-of-ttl arena ttl) 0))))

  (fn test-conflicting-declarations-are-an-input-error ((arena Arena))
    (@intent "An IRI declared under two disjoint property kinds FAULTS")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Punning a class with an individual is legal and stays legal —
    ;; node-cmp compares the tag first exactly so the two remain
    ;; distinct. The three property kinds are pairwise disjoint, and an
    ;; IRI in two of them has the same ambiguity an undeclared one has.
    (let ((pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n"))
      (and (not (decodes-ok arena (string-concat arena pre
                  ":p a owl:ObjectProperty . :p a owl:AnnotationProperty .")))
           ;; and legal class/individual punning is NOT rejected
           (decodes-ok arena (string-concat arena pre
             ":x a owl:Class . :x a owl:NamedIndividual .")))))

  (fn gate-omissions-of-ttl ((arena Arena) (ttl String))
    (@intent "Gate an inline Turtle document and count its omissions")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (parse-ttl-string arena ttl)
      ((error _) -1)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) -1)
          ((ok s0)
            (match (decode-axioms arena (. s0 triples))
              ((error _) -1)
              ((ok s1)
                (cast Int (list-len (. (gate-axioms arena (. s1 axioms) (. s1 signature)
                                         (. s0 omissions)) omissions))))))))))

  (fn rc-prefix ()
    (@intent "The shared prefix block for the range-condition table")
    (@spec (() -> String))
    (@pure)
    "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:r a owl:ObjectProperty . :s a owl:ObjectProperty . :t a owl:ObjectProperty .\n:u a owl:ObjectProperty . :s2 a owl:ObjectProperty . :p a owl:ObjectProperty .\n:q a owl:ObjectProperty .\n:Agent a owl:Class . :Person a owl:Class .\n")

  (fn test-range-composition-table ((arena Arena))
    (@intent "§5.2's eight-row range/composition verdict table, row by row")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE PUBLISHED CONDITION, ROW BY ROW. Row 3 is the one that
    ;; matters: a SUBCLASS range is rejected ON PURPOSE, and it is
    ;; exactly the case a well-meaning implementer admits because the
    ;; semantics seem to permit it. Admitting it silently leaves the
    ;; cited completeness proof behind — the citation stops covering
    ;; what the engine does.
    (let ((pre (rc-prefix))
          (mut ok true))
      (do
        ;; 1. range(s) = range(t) = Agent — the same expression on rₙ
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :s rdfs:range :Agent . :t rdfs:range :Agent .")) 0)
          (do (println "  [range] row 1 should be ACCEPTED") (set! ok false)))

        ;; 2. inherited through the told role hierarchy
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:range :Agent . :s rdfs:subPropertyOf :s2 . :s2 rdfs:range :Agent .")) 0)
          (do (println "  [range] row 2 should be ACCEPTED") (set! ok false)))

        ;; 3. a SUBCLASS range is NOT the published condition
        (when (< (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :s rdfs:range :Person . :t rdfs:range :Agent . :Person rdfs:subClassOf :Agent .")) 1)
          (do (println "  [range] row 3 should be REJECTED (subclass range)") (set! ok false)))

        ;; 4. nothing constrains the composed target
        (when (< (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:range :Agent .")) 1)
          (do (println "  [range] row 4 should be REJECTED (no range on s)") (set! ok false)))

        ;; 5. t INHERITS a range, so s must carry it too — the one-sided
        ;;    formula wrongly accepts this
        (when (< (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:subPropertyOf :u . :u rdfs:range :Agent .")) 1)
          (do (println "  [range] row 5 should be REJECTED (inherited range on t)") (set! ok false)))

        ;; 6. t imposes nothing to violate
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) .")) 0)
          (do (println "  [range] row 6 should be ACCEPTED (no range on t)") (set! ok false)))

        ;; 7. role HIERARCHY is unaffected; only composition shares a target
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":r rdfs:subPropertyOf :s . :r rdfs:range :Person . :s rdfs:range :Agent .")) 0)
          (do (println "  [range] row 7 should be ACCEPTED (plain subproperty)") (set! ok false)))

        ;; 8. only rₙ is consulted; intermediate roles are not
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :p :q :s ) . :t rdfs:range :Agent . :s rdfs:range :Agent .")) 0)
          (do (println "  [range] row 8 should be ACCEPTED (n-ary, last role carries it)") (set! ok false)))
        ok)))

  (fn regularity-of ((arena Arena) (path String))
    (@intent "The regularity verdict for a fixture's expanded RBox")
    (@spec ((Arena String) -> (Option Bool)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)
            (match (decode-axioms arena (. s0 triples))
              ((error _) (none))
              ((ok s1)
                (match (check-regularity arena (expand-sugar arena (. s1 axioms)))
                  ((rbox-regular)     (some true))
                  ((rbox-irregular _) (some false))))))))))

  (fn test-regularity-rejects-mutual-recursion ((arena Arena))
    (@intent "r o s subseteq s with s o r subseteq r is non-regular")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The constraint graph holds r ≺ s and s ≺ r, whose closure
    ;; contains (r,r); ⊑* is reflexive, so r ⊑* r makes it a violation.
    ;; That is the `r ≺ r` self-edge the conventional "non-trivial SCC"
    ;; reading drops, leaving the most obvious violation with no
    ;; witness at all.
    (match (regularity-of arena "corpus/fixtures/hazards/rbox-regularity-reject.ttl")
      ((none) false)
      ((some regular) (not regular))))

  (fn test-regularity-accepts-equivalence-and-transitivity ((arena Arena))
    (@intent "THE FALSE-FAIL CASE: equivalent simple roles and r o r subseteq r are regular")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A GENERIC CYCLE DETECTOR OVER ROLE INCLUSIONS FAILS BOTH OF
    ;; THESE, and both failures refuse a correct ontology. `r ⊑ s` with
    ;; `s ⊑ r` is a non-trivial SCC in the INCLUSION graph while being
    ;; perfectly regular, and `t ∘ t ⊑ t` is a self-loop the normative
    ;; cases expressly permit. Neither generates a ≺ edge: simple
    ;; inclusions are never matched against the cases, and transitivity
    ;; is dominated by the case that constrains nothing. An earlier
    ;; draft of the spec specified exactly the naive graph.
    (match (regularity-of arena "corpus/fixtures/hazards/rbox-regularity-accept.ttl")
      ((none) false)
      ((some regular) regular)))

  (fn test-regularity-accepts-plain-subproperty ((arena Arena))
    (@intent "An ordinary rdfs:subPropertyOf is not matched against the chain cases")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Feeding simple inclusions into case matching makes "matches no
    ;; permitted form" reject every rdfs:subPropertyOf axiom in
    ;; existence — which an earlier spec draft did, contradicting its
    ;; own accepted-examples table two paragraphs later.
    (match (regularity-of arena "corpus/fixtures/v0/subproperty.ttl")
      ((none) false)
      ((some regular) regular)))

  (fn test-regularity-accepts-nary-chain ((arena Arena))
    (@intent "A well-founded n-ary chain is regular")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (regularity-of arena "corpus/fixtures/v0/property-chain-nary.ttl")
      ((none) false)
      ((some regular) regular)))

  (fn test-irregular-rbox-is-omitted-whole ((arena Arena))
    (@intent "A collective RBox failure omits the RBox, and accepts none of it")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; HOWL does not classify a projected RBox. Deleting a witness needs
    ;; a removal set, a witness is not one, and the choice is not local.
    (match (gate-fixture arena "corpus/fixtures/hazards/rbox-regularity-reject.ttl")
      ((none) false)
      ((some gr)
        (and (> (cast Int (list-len (. gr omissions))) 0)
             (== (count-variant-chain (. gr accepted)) 0)))))

  (fn gate-fixture ((arena Arena) (path String))
    (@intent "Parse, stage 0, decode, gate — the front end as far as it goes")
    (@spec ((Arena String) -> (Option GateResult)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)
            (match (decode-axioms arena (. s0 triples))
              ((error _) (none))
              ((ok s1)
                (some (gate-axioms arena (. s1 axioms) (. s1 signature)
                        (. s0 omissions))))))))))

  (fn count-variant-chain ((axs (List RawAxiom)))
    (@intent "How many property-chain axioms survived the gate")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    (let ((mut n 0))
      (do (for-each (a axs) (match a ((ra-property-chain _) (set! n (+ n 1))) (_ (do)))) n)))

  (fn count-variant-disjoint ((axs (List RawAxiom)))
    (@intent "How many disjointness axioms survived the gate")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    (let ((mut n 0))
      (do (for-each (a axs) (match a ((ra-disjoint-classes _) (set! n (+ n 1))) (_ (do)))) n)))

  (fn count-variant-subclass ((axs (List RawAxiom)))
    (@intent "How many class inclusions survived the gate")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    (let ((mut n 0))
      (do (for-each (a axs) (match a ((ra-sub-class-of _ _) (set! n (+ n 1))) (_ (do)))) n)))

  (fn test-gate-annotation-heavy-is-clean ((arena Arena))
    (@intent "M0 ACCEPTANCE (a): a versioned, annotated ontology gates CLEAN")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The whole acceptance criterion, end to end through the real gate:
    ;; no label, declaration or reification triple reaches
    ;; coverage.omitted. Get this wrong and NOTHING downstream ever
    ;; classifies — HOWL is correct and useless.
    (match (gate-fixture arena "corpus/fixtures/hazards/annotation-heavy.ttl")
      ((none) false)
      ((some gr)
        (and (== (cast Int (list-len (. gr omissions))) 0)
             ;; and the logical content survived, so an empty omission
             ;; list cannot be bought by dropping everything
             (> (count-variant-subclass (. gr accepted)) 0)))))

  (fn test-gate-carries-import-omissions ((arena Arena))
    (@intent "M0 ACCEPTANCE (b): a stage-0 omission survives into coverage")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Coverage is ONE list. An import shortfall raised before the gate
    ;; has to ride through it, or the gate silently launders a
    ;; dangling import into a clean verdict.
    (match (gate-fixture arena "corpus/fixtures/hazards/unattested-import.ttl")
      ((none) false)
      ((some gr) (== (cast Int (list-len (. gr omissions))) 1))))

  (fn test-sugar-transitivity-becomes-a-chain ((arena Arena))
    (@intent "TransitiveObjectProperty(r) is rewritten to r ∘ r ⊑ r before the gates")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The RBox gates read the told hierarchy and chains AS WRITTEN. If
    ;; transitivity is still sugar when regularity runs, the gate
    ;; answers a question about an RBox missing an axiom the document
    ;; states.
    (match (gate-fixture arena "corpus/fixtures/v0/transitive.ttl")
      ((none) false)
      ((some gr)
        (and (> (count-variant-chain (. gr accepted)) 0)
             (== (cast Int (list-len (. gr omissions))) 0)))))

  (fn test-sugar-nary-disjointness-becomes-pairs ((arena Arena))
    (@intent "DisjointClasses(C1 C2 C3) becomes exactly three pairs")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Three classes must give three pairs — not six (every ordered
    ;; pair) and not one (the n-ary axiom left whole, which normalizes
    ;; to a single binary conjunction and loses two disjointness facts).
    (match (gate-fixture arena "corpus/fixtures/v0/disjoint-nary.ttl")
      ((none) false)
      ((some gr) (== (count-variant-disjoint (. gr accepted)) 3))))

  (fn test-sugar-equivalence-is-a-star-not-all-pairs ((arena Arena))
    (@intent "EquivalentClasses gives 2(n−1) inclusions, not n(n−1)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A star through the canonically least operand entails the same
    ;; closure by transitivity of ⊑ while staying linear. The naive
    ;; all-pairs reading is quadratic before saturation even begins.
    (match (gate-fixture arena "corpus/fixtures/v0/equivalent-classes.ttl")
      ((none) false)
      ((some gr)
        (and (> (count-variant-subclass (. gr accepted)) 0)
             (== (cast Int (list-len (. gr omissions))) 0)))))

  (fn gate-omission-count ((arena Arena) (path String))
    (@intent "Omissions for a fixture, or -1 if the front end refused it")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (gate-fixture arena path)
      ((none)    -1)
      ((some gr) (cast Int (list-len (. gr omissions))))))

  (fn test-gate-accepts-every-v0-fixture ((arena Arena))
    (@intent "All 17 v0 fixtures gate with EMPTY coverage.omitted")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE FALSE-FAIL HALF, and the one review habitually skips. A gate
    ;; is reviewed for what it lets through; over-rejection reads as
    ;; conservative and therefore safe. It is not: refusing a user's
    ;; correct ontology is its own failure, and a gate that rejects too
    ;; much also invalidates the completeness claim conditioned on it.
    (let ((mut paths (list-new arena String))
          (mut ok true))
      (do
        (list-push paths "corpus/fixtures/v0/subclass-atomic.ttl")
        (list-push paths "corpus/fixtures/v0/intersection.ttl")
        (list-push paths "corpus/fixtures/v0/exists-lhs.ttl")
        (list-push paths "corpus/fixtures/v0/exists-rhs.ttl")
        (list-push paths "corpus/fixtures/v0/equivalent-classes.ttl")
        (list-push paths "corpus/fixtures/v0/equivalent-properties.ttl")
        (list-push paths "corpus/fixtures/v0/disjoint-binary.ttl")
        (list-push paths "corpus/fixtures/v0/disjoint-nary.ttl")
        (list-push paths "corpus/fixtures/v0/subproperty.ttl")
        (list-push paths "corpus/fixtures/v0/property-chain.ttl")
        (list-push paths "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push paths "corpus/fixtures/v0/transitive.ttl")
        (list-push paths "corpus/fixtures/v0/domain.ttl")
        (list-push paths "corpus/fixtures/v0/range.ttl")
        (list-push paths "corpus/fixtures/v0/abox-assertions.ttl")
        (list-push paths "corpus/fixtures/v0/top-bottom.ttl")
        (list-push paths "corpus/fixtures/v0/litmus.ttl")
        (for-each (p paths)
          (when (!= (gate-omission-count arena p) 0)
            (do (print "  [gate] expected 0 omissions, got ")
                (print (int-to-string arena (gate-omission-count arena p)))
                (print " in ") (println p)
                (set! ok false))))
        ok)))

  (fn test-gate-rejects-every-out-of-profile-fixture ((arena Arena))
    (@intent "All 14 out-of-profile fixtures gate with NON-EMPTY coverage.omitted")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut paths (list-new arena String))
          (mut ok true))
      (do
        (list-push paths "corpus/fixtures/out-of-profile/union.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/complement.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/allvalues.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/nominals.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/cardinality.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/has-self.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/inverse.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/equality.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/property-characteristics.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/haskey-disjointunion.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/swrl-rule.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/builtin-roles.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/anonymous-individual.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/datatypes.ttl")
        (for-each (p paths)
          (when (< (gate-omission-count arena p) 1)
            (do (print "  [gate] expected >=1 omission, got ")
                (print (int-to-string arena (gate-omission-count arena p)))
                (print " in ") (println p)
                (set! ok false))))
        ok)))

  (fn signature-of-fixture ((arena Arena) (path String))
    (@intent "Parse, run stage 0, and build the signature — the common prefix")
    (@spec ((Arena String) -> (Option Signature)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)  (some (build-signature arena (. s0 triples))))))))

  (fn test-declared-unused-class-reaches-the-signature ((arena Arena))
    (@intent "M0 ACCEPTANCE (c): a declared, unmentioned class is in the signature")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The signature is what stage 4 initializes contexts FROM, so this
    ;; is where acceptance (c) is won or lost. Key initialization on
    ;; axiom occurrence instead and `:Unused` is a class HOWL silently
    ;; does not know exists — it cannot answer `Unused ⊑ ⊤`, cannot
    ;; list it, cannot serve a probe naming it. Not an error, an
    ;; absence, which is worse.
    (match (signature-of-fixture arena "corpus/fixtures/hazards/declared-unused-class.ttl")
      ((none) false)
      ((some sig)
        (and (signature-has-class sig (record-new IRI (value "http://example.org/t#Unused")))
             (signature-has-class sig (record-new IRI (value "http://example.org/t#A")))))))

  (fn test-builtins-are-declared ((arena Arena))
    (@intent "owl:Thing is never a missing declaration")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Without the built-ins pre-populated, every ontology that writes
    ;; `rdfs:subClassOf owl:Thing` collects a missing-declaration
    ;; omission for vocabulary the STANDARD declares — a correct
    ;; document gating dirty.
    (match (signature-of-fixture arena "corpus/fixtures/hazards/declared-unused-class.ttl")
      ((none) false)
      ((some sig)
        (and (signature-has-class sig (record-new IRI (value OWL_THING)))
             ;; rdfs:label must be a KNOWN annotation property, which is
             ;; what makes a label assertion inert rather than
             ;; unrecognized — acceptance (a) rests on this.
             (signature-has-annotation-property sig (record-new IRI (value RDFS_LABEL)))))))

  (fn test-custom-annotation-property-is-recognized ((arena Arena))
    (@intent "A user-declared annotation property is structural, not a hardcoded list")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; §5.2 requires Inert to be STRUCTURAL: any assertion whose
    ;; predicate is a declared annotation property is inert. A
    ;; whitelist of rdfs:label and friends would mark `:curatorNote`
    ;; out-of-profile and fail acceptance (a) on the very fixture
    ;; written to catch it.
    (match (signature-of-fixture arena "corpus/fixtures/hazards/annotation-heavy.ttl")
      ((none) false)
      ((some sig)
        (and (signature-has-annotation-property sig
               (record-new IRI (value "http://example.org/t#curatorNote")))
             (and (signature-has-class sig (record-new IRI (value "http://example.org/t#A")))
                  ;; and it is NOT mistaken for a class
                  (not (signature-has-class sig
                         (record-new IRI (value "http://example.org/t#curatorNote")))))))))

  (fn is-named-class ((c RawConcept) (iri String))
    (@intent "Is this concept exactly the named class with this IRI?")
    (@spec ((RawConcept String) -> Bool))
    (@pure)
    (match c
      ((rc-name nd)
        (match nd
          ((class-node i)      (== (string-cmp (. i value) iri) 0))
          ((individual-node _) false)
          ((fresh-node _)      false)))
      (_ false)))

  (fn is-some-person ((c RawConcept) (role-iri String) (filler-iri String))
    (@intent "Is this concept EXISTS role.filler, with both named?")
    (@spec ((RawConcept String String) -> Bool))
    (@pure)
    (match c
      ((rc-some r f)
        (and (match r
               ((named-role i) (== (string-cmp (. i value) role-iri) 0))
               ((fresh-role _) false))
             (is-named-class (deref f) filler-iri)))
      (_ false)))

  (fn test-decode-litmus-class-expression ((arena Arena))
    (@intent "§3.1's defining expression decodes to rc-and[rc-name, rc-some]")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE STRUCTURE THE WHOLE PROJECT TURNS ON. `Parent ≡ Person ⊓
    ;; ∃hasChild.Person` is what lets `Mother ⊑ Parent` be derived
    ;; through the existential on the DEFINING side — the step a
    ;; materialization engine cannot take. If the decoder flattens the
    ;; restriction, loses a conjunct, or reads the filler as anonymous,
    ;; the litmus fails later for a reason that looks like a reasoning
    ;; bug rather than a parsing one. This pins it at the seam.
    (let ((person "http://example.org/t#Person")
          (has-child "http://example.org/t#hasChild"))
      (match (parse-ttl-file arena "corpus/fixtures/v0/litmus.ttl")
        ((error _) false)
        ((ok g)
          (match (stage0-header arena (. g triples) (list-new arena IRI))
            ((error _) false)
            ((ok s0)
              (let ((ig (graph-to-indexed arena (. s0 triples)))
                    (parent (make-iri arena "http://example.org/t#Parent"))
                    (eq-pred (make-iri arena OWL_EQUIVALENT_CLASS)))
                (match (one-object arena ig parent eq-pred)
                  ((error _) false)
                  ((ok defn)
                    (match (decode-concept arena ig defn CONCEPT_FUEL)
                      ((error _) false)
                      ((ok c)
                        (match c
                          ((rc-and cs)
                            (let ((mut n 0)
                                  (mut saw-person false)
                                  (mut saw-some false))
                              (do
                                (for-each (x cs)
                                  (do
                                    (set! n (+ n 1))
                                    (when (is-named-class x person) (set! saw-person true))
                                    (when (is-some-person x has-child person)
                                      (set! saw-some true))))
                                ;; BOTH conjuncts, and exactly two. A
                                ;; truncated RDF list would give n = 1
                                ;; and a strictly stronger axiom.
                                (and (== n 2) (and saw-person saw-some)))))
                          (_ false)))))))))))))

  (fn test-decode-represents-out-of-profile-rather-than-failing ((arena Arena))
    (@intent "owl:unionOf decodes to rc-or — represented, not a parse error")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; DECODING IS NOT ACCEPTING. A union is out of profile, but it must
    ;; arrive at the gate as a named construct so the gate can report
    ;; it. If the decoder faulted here instead, an ontology with one
    ;; union anywhere would lose EVERY axiom rather than that one.
    (let ((b1 (make-blank arena 1))
          (c1 (make-blank arena 2))
          (c2 (make-blank arena 3))
          (nil-t (make-iri arena RDF_NIL))
          (f (make-iri arena RDF_FIRST))
          (r (make-iri arena RDF_REST))
          (u (make-iri arena "http://www.w3.org/2002/07/owl#unionOf"))
          (ea (ex-iri arena "A"))
          (eb (ex-iri arena "B"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 u c1))
        (list-push ts (make-triple arena c1 f ea))
        (list-push ts (make-triple arena c1 r c2))
        (list-push ts (make-triple arena c2 f eb))
        (list-push ts (make-triple arena c2 r nil-t))
        (match (decode-concept arena (graph-to-indexed arena ts) b1 CONCEPT_FUEL)
          ((error _) false)
          ((ok c)
            (match c
              ((rc-or cs) (== (cast Int (list-len cs)) 2))
              (_ false)))))))

  (fn test-decode-blank-node-cycle-is-bounded ((arena Arena))
    (@intent "A cyclic class expression faults rather than recursing forever")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; `_:x owl:complementOf _:x` is unbounded recursion in the front
    ;; end, BEFORE max-iterations bounds anything. The fuel bound is
    ;; what makes a hostile or corrupt document terminate.
    (let ((b1 (make-blank arena 1))
          (comp (make-iri arena "http://www.w3.org/2002/07/owl#complementOf"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 comp b1))
        (match (decode-concept arena (graph-to-indexed arena ts) b1 CONCEPT_FUEL)
          ((error _) true)
          ((ok _) false)))))

  (fn test-rdf-list-well-formed ((arena Arena))
    (@intent "A three-cell collection reads back in order, all elements present")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((b1 (make-blank arena 1))
          (b2 (make-blank arena 2))
          (b3 (make-blank arena 3))
          (nil-t (make-iri arena RDF_NIL))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (ea (ex-iri arena "A"))
          (eb (ex-iri arena "B"))
          (ec (ex-iri arena "C"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f ea))
        (list-push ts (make-triple arena b1 r b2))
        (list-push ts (make-triple arena b2 f eb))
        (list-push ts (make-triple arena b2 r b3))
        (list-push ts (make-triple arena b3 f ec))
        (list-push ts (make-triple arena b3 r nil-t))
        (match (rdf-list-checked arena (graph-to-indexed arena ts) b1)
          ((error _) false)
          ((ok els)
            (and (== (cast Int (list-len els)) 3)
              (and (term-eq (term-at els 0) ea)
                (and (term-eq (term-at els 1) eb)
                     (term-eq (term-at els 2) ec)))))))))

  (fn test-rdf-list-truncation-is-a-fault ((arena Arena))
    (@intent "A cell with no rdf:first FAULTS — it must never yield a shorter list")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE HAZARD, DEMONSTRATED. slop-rdf's `rdf-list-elements-indexed`
    ;; skips a cell with no `rdf:first` and walks on, returning two
    ;; elements where the document wrote three. Under
    ;; `owl:intersectionOf` that silently turns `A ⊓ B ⊓ C ⊑ D` into
    ;; the STRICTLY STRONGER `A ⊓ B ⊑ D`, so HOWL would derive and
    ;; report subsumptions that do not hold. A shorter list is a wrong
    ;; answer in the shape of a right one, which is why this is a
    ;; Result rather than a best effort.
    (let ((b1 (make-blank arena 1))
          (b2 (make-blank arena 2))
          (b3 (make-blank arena 3))
          (nil-t (make-iri arena RDF_NIL))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (ea (ex-iri arena "A"))
          (ec (ex-iri arena "C"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f ea))
        (list-push ts (make-triple arena b1 r b2))
        ;; b2 carries rdf:rest but NO rdf:first — the silent-drop case
        (list-push ts (make-triple arena b2 r b3))
        (list-push ts (make-triple arena b3 f ec))
        (list-push ts (make-triple arena b3 r nil-t))
        (match (rdf-list-checked arena (graph-to-indexed arena ts) b1)
          ((ok _) false)
          ((error e)
            (match e
              ((list-truncated _) true)
              ((list-branching _) false)
              ((list-cyclic _)    false)))))))

  (fn test-rdf-list-cycle-terminates ((arena Arena))
    (@intent "An rdf:rest cycle faults rather than spinning in the front end")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; slop-rdf's walker has no visited set, so this input loops
    ;; forever pushing into the arena. That happens in the front end,
    ;; BEFORE max-iterations applies to anything, so the budget that
    ;; is supposed to bound a run does not bound this.
    (let ((b1 (make-blank arena 1))
          (b2 (make-blank arena 2))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (ea (ex-iri arena "A"))
          (eb (ex-iri arena "B"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f ea))
        (list-push ts (make-triple arena b1 r b2))
        (list-push ts (make-triple arena b2 f eb))
        (list-push ts (make-triple arena b2 r b1))
        (match (rdf-list-checked arena (graph-to-indexed arena ts) b1)
          ((ok _) false)
          ((error e)
            (match e
              ((list-cyclic _)    true)
              ((list-truncated _) false)
              ((list-branching _) false)))))))

  (fn test-rdf-list-branching-is-a-fault ((arena Arena))
    (@intent "Two rdf:first values on one cell have no determinate reading")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Determinism, not pedantry. slop-rdf takes `(list-get firsts 0)`,
    ;; and index order is HASH-BUCKET order — so which conjunct
    ;; survives depends on table layout, and adding an unrelated
    ;; triple elsewhere can rehash and change the answer. §6.8 forbids
    ;; exactly that.
    (let ((b1 (make-blank arena 1))
          (nil-t (make-iri arena RDF_NIL))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (ea (ex-iri arena "A"))
          (eb (ex-iri arena "B"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f ea))
        (list-push ts (make-triple arena b1 f eb))
        (list-push ts (make-triple arena b1 r nil-t))
        (match (rdf-list-checked arena (graph-to-indexed arena ts) b1)
          ((ok _) false)
          ((error e)
            (match e
              ((list-branching _) true)
              ((list-truncated _) false)
              ((list-cyclic _)    false)))))))

  (fn test-sort-is-stable ((arena Arena))
    (@intent "Ties keep their input order — what §6.8 determinism rests on")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Stability is INVISIBLE through `sort-iris`: `iri-cmp` is a total
    ;; order, so two elements that tie are byte-identical and any
    ;; permutation of them looks correct. It is observable only through a
    ;; comparator that returns 0 for elements the test can still tell
    ;; apart, which is what the raw `sort-range` entry point allows.
    ;;
    ;; This is not a tidiness property. A comparator here may legitimately
    ;; tie two DISTINCT values — `missing-declaration-cmp` ties on equal
    ;; referring-lists, and an out-of-profile omission list can hold two
    ;; entries a comparator does not separate. If ties resolved by run
    ;; boundaries, their order would be a function of list LENGTH, and
    ;; §6.8 requires the report to be a function of content alone.
    ;;
    ;; The key descends in blocks of three, so a correct sort must move
    ;; every block and a stable answer is NOT the identity permutation:
    ;;   indices 0 1 2 -> key 2  |  3 4 5 -> key 1  |  6 7 8 -> key 0
    ;; Stable ascending order is therefore exactly 6 7 8 3 4 5 0 1 2; an
    ;; unstable sort still orders the blocks but scrambles within one.
    (let ((idx (sort-range arena 9
                 (fn ((a Int) (b Int))
                   (let ((ka (- 2 (/ a 3)))
                         (kb (- 2 (/ b 3))))
                     (cond ((< ka kb) -1)
                           ((> ka kb) 1)
                           (else 0))))))
          (mut expect (list-new arena Int))
          (mut ok true)
          (mut i 0))
      (do
        (list-push expect 6) (list-push expect 7) (list-push expect 8)
        (list-push expect 3) (list-push expect 4) (list-push expect 5)
        (list-push expect 0) (list-push expect 1) (list-push expect 2)
        (if (!= (cast Int (list-len idx)) 9) (set! ok false) (do))
        (while (< i 9)
          (do
            (if (!= (int-at idx i) (int-at expect i)) (set! ok false) (do))
            (set! i (+ i 1))))
        ok)))

  (fn test-sort-is-a-permutation ((arena Arena))
    (@intent "Sorting preserves length and multiset — nothing dropped, nothing invented")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; This is the obligation `sort-range` states but cannot prove: the
    ;; buffers are filled by `list-push` in a loop and then permuted by
    ;; `list-set`, and slop#124 withholds the provenance axioms for any
    ;; body that calls `list-set`. Duplicates are included deliberately —
    ;; a sort that silently deduplicated would still pass a
    ;; sortedness-only test while changing the report.
    (let ((mut xs (list-new arena IRI)))
      (do
        (list-push xs (mk-iri "b"))
        (list-push xs (mk-iri "a"))
        (list-push xs (mk-iri "b"))
        (list-push xs (mk-iri "c"))
        (list-push xs (mk-iri "a"))
        (let ((s (sort-iris arena xs))
              (mut ok true)
              (mut i 0)
              (n (cast Int (list-len xs))))
          (do
            (if (!= (cast Int (list-len s)) 5) (set! ok false) (do))
            ;; every input element occurs in the output
            (while (< i n)
              (let ((mut found false)
                    (mut j 0))
                (do
                  (while (< j 5)
                    (do
                      (if (== (iri-cmp (iri-at xs i) (iri-at s j)) 0)
                        (set! found true) (do))
                      (set! j (+ j 1))))
                  (if found (do) (set! ok false))
                  (set! i (+ i 1)))))
            ;; a a b b c
            (if (!= (iri-cmp (iri-at s 0) (mk-iri "a")) 0) (set! ok false) (do))
            (if (!= (iri-cmp (iri-at s 1) (mk-iri "a")) 0) (set! ok false) (do))
            (if (!= (iri-cmp (iri-at s 4) (mk-iri "c")) 0) (set! ok false) (do))
            ok)))))

  (fn print-test-result ((name String) (passed Bool))
    (@intent "Print a test result with a pass/fail indicator")
    (@spec ((String Bool) -> Unit))
    (if passed
      (do (print "[PASS] ") (println name))
      (do (print "[FAIL] ") (println name))))

  (fn main ()
    (@intent "Run the verdict-discipline and structural-invariant tests")
    (@spec (() -> Int))
    :c-name "main"
    (with-arena 4194304
      (let ((mut passed 0)
            (mut failed 0))
        (do
          (println "HOWL — verdict discipline & structural invariants")
          (println "========================================")

          (let ((r (test-coherent-requires-complete arena)))
            (print-test-result "verdict: complete + clean => coherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-omission-blocks-coherent arena)))
            (print-test-result "verdict: omission blocks coherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-cap-blocks-coherent arena)))
            (print-test-result "verdict: round cap blocks coherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-finding-beats-partial-coverage arena)))
            (print-test-result "verdict: finding beats partial coverage" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-consistent-but-incoherent arena)))
            (print-test-result "verdict: consistent-but-incoherent => incoherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-context-starts-with-empty-store arena)))
            (print-test-result "init: context store starts empty" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-emit-edge-addresses-both-halves arena)))
            (print-test-result "edges: emit-edge addresses both halves" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-stub-refuses-rather-than-passing arena)))
            (print-test-result "stub: classify refuses, never passes" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-litmus arena)))
            (print-test-result "§3.1 LITMUS: derives Mother ⊑ Parent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-polarity-guard arena)))
            (print-test-result "polarity: wrong-direction fresh definition loses the litmus" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-cyclic-hierarchy-terminates arena)))
            (print-test-result "termination: A ⊑ B, B ⊑ A reaches fixpoint" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-same-round-co-arrival arena)))
            (print-test-result "CR4: same-round co-arrival still concludes" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-late-subsumer-still-concludes arena)))
            (print-test-result "CR4: subsumer arriving after its edge still concludes" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-unsatisfiable-class-detected arena)))
            (print-test-result "unsat: ⊥ ∈ S(A) found, owl:Nothing excluded" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-bottom-compression arena)))
            (print-test-result "output: probe entails all, taxonomy holds only (A,⊥)" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-inconsistency-suppresses-both-lists arena)))
            (print-test-result "findings: inconsistency empties both lists (undefined, not empty)" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-derived-eq-compares-both-payloads arena)))
            (print-test-result "equality: derived-eq compares BOTH payloads (slop#66)" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-order-independence arena)))
            (print-test-result "determinism: signature order changes nothing" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-string-cmp-is-length-safe arena)))
            (print-test-result "order: string-cmp is length-safe (no NUL assumption)" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-node-cmp-separates-punned-iris arena)))
            (print-test-result "order: punned IRIs stay distinct under node-cmp" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-sort-orders-and-is-input-determined arena)))
            (print-test-result "order: sort is input-determined, not insertion-ordered" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-sort-is-a-permutation arena)))
            (print-test-result "order: sort preserves length and multiset" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-sort-is-stable arena)))
            (print-test-result "order: sort is stable, so ties are content-determined" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-rdf-list-well-formed arena)))
            (print-test-result "rdf-list: a well-formed collection reads back in order" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-rdf-list-truncation-is-a-fault arena)))
            (print-test-result "rdf-list: truncation FAULTS, never a shorter conjunction" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-rdf-list-cycle-terminates arena)))
            (print-test-result "rdf-list: an rdf:rest cycle terminates with a fault" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-rdf-list-branching-is-a-fault arena)))
            (print-test-result "rdf-list: a branching cell has no determinate reading" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-unattested-import-yields-an-omission arena)))
            (print-test-result "§12(b): an unattested owl:imports becomes an omission" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-attested-import-yields-none arena)))
            (print-test-result "§12(b): the same import, attested, gates clean" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-header-and-reification-are-consumed arena)))
            (print-test-result "stage 0: header and owl:Axiom scaffolding consumed" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-decode-litmus-class-expression arena)))
            (print-test-result "stage 1: §3.1's defining expression decodes intact" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-decode-represents-out-of-profile-rather-than-failing arena)))
            (print-test-result "stage 1: owl:unionOf is REPRESENTED, not a parse error" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-decode-blank-node-cycle-is-bounded arena)))
            (print-test-result "stage 1: a cyclic class expression terminates" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-declared-unused-class-reaches-the-signature arena)))
            (print-test-result "§12(c): a declared, unused class reaches the signature" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-builtins-are-declared arena)))
            (print-test-result "signature: OWL built-ins are never missing declarations" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-custom-annotation-property-is-recognized arena)))
            (print-test-result "signature: a custom annotation property is structural" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-annotation-heavy-decodes-clean arena)))
            (print-test-result "§12(a): an annotated ontology decodes with 0 out-of-profile" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-litmus-decodes-clean arena)))
            (print-test-result "stage 1: the litmus ontology decodes clean" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-nary-disjointness-keeps-its-members arena)))
            (print-test-result "stage 1: n-ary disjointness keeps all its members" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-v0-corpus-decodes-clean arena)))
            (print-test-result "corpus: all 17 v0 fixtures decode with 0 out-of-profile" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-out-of-profile-corpus-is-caught arena)))
            (print-test-result "corpus: every out-of-profile fixture is caught" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-gate-annotation-heavy-is-clean arena)))
            (print-test-result "§12(a): an annotated ontology GATES clean" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-gate-carries-import-omissions arena)))
            (print-test-result "§12(b): a stage-0 import omission survives the gate" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-sugar-transitivity-becomes-a-chain arena)))
            (print-test-result "sugar: TransitiveObjectProperty becomes r o r subseteq r" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-sugar-nary-disjointness-becomes-pairs arena)))
            (print-test-result "sugar: 3 disjoint classes give exactly 3 pairs" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-sugar-equivalence-is-a-star-not-all-pairs arena)))
            (print-test-result "sugar: equivalence expands to a canonical star" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-gate-accepts-every-v0-fixture arena)))
            (print-test-result "gate: all 17 v0 fixtures gate CLEAN (false-fail half)" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-gate-rejects-every-out-of-profile-fixture arena)))
            (print-test-result "gate: all 14 out-of-profile fixtures are omitted" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-regularity-rejects-mutual-recursion arena)))
            (print-test-result "regularity: mutually recursive chains are rejected" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-regularity-accepts-equivalence-and-transitivity arena)))
            (print-test-result "regularity: equivalent roles + transitivity ACCEPTED" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-regularity-accepts-plain-subproperty arena)))
            (print-test-result "regularity: a plain subPropertyOf is accepted" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-regularity-accepts-nary-chain arena)))
            (print-test-result "regularity: a well-founded n-ary chain is accepted" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-irregular-rbox-is-omitted-whole arena)))
            (print-test-result "regularity: an irregular RBox is omitted WHOLE" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-range-composition-table arena)))
            (print-test-result "range: all 8 rows of §5.2's verdict table" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-undeclared-property-is-an-input-error arena)))
            (print-test-result "declarations: an ambiguous undeclared property FAULTS" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-unknown-owl-vocabulary-still-decodes arena)))
            (print-test-result "declarations: unknown owl: vocabulary gates, never faults" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-conflicting-declarations-are-an-input-error arena)))
            (print-test-result "declarations: conflicting kinds fault; punning still legal" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-missing-class-declaration-is-reported arena)))
            (print-test-result "declarations: an undeclared CLASS is a missing-declaration" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-undeclared-individual-is-not-reported arena)))
            (print-test-result "declarations: an undeclared individual is NOT a finding" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (println "")
          (println "========================================")
          (print "Passed: ")
          (println (int-to-string arena passed))
          (print "Failed: ")
          (println (int-to-string arena failed))
          (println "========================================")

          (if (== failed 0) 0 1))))))
