  ;; ============================================================
  ;; Fixture builders
  ;; ============================================================

  (fn empty-saturation ((arena Arena))
    (@intent "A Saturation with no contexts — enough to hang an Outcome on")
    (@spec ((Arena) -> Saturation))
    (@alloc arena)
    (record-new Saturation
      (contexts     (map-new arena Node Context))
      (queues       (map-new arena Node Queue))
      (active       (set-new arena Node))
      (active-count 0)
      (iteration    0)))

  ;; ============================================================
  ;; el's evidence, out of the generalized Outcome and Prepared
  ;; ============================================================

  (fn outcome-saturation ((arena Arena) (o Outcome))
    (@intent "An el Outcome's saturation; an empty one for any other calculus")
    (@spec ((Arena Outcome) -> Saturation))
    (@alloc arena)
    (match (. o evidence)
      ((el-evidence sat)  sat)
      ((ksc-evidence _)   (empty-saturation arena))
      ((sriq-evidence _)  (empty-saturation arena))))

  (fn prepared-el-work ((arena Arena) (p Prepared))
    (@intent "An el Prepared's work; an empty one for any other calculus")
    (@spec ((Arena Prepared) -> ElWork))
    (@alloc arena)
    (match (. p work)
      ((el-work w)   w)
      ((ksc-work _)  (empty-el-work arena))
      ((sriq-work _) (empty-el-work arena))))

  (fn empty-el-work ((arena Arena))
    (@intent "An el work with nothing in it")
    (@spec ((Arena) -> ElWork))
    (@alloc arena)
    (record-new ElWork
      (axioms     (list-new arena NormAxiom))
      (index      (build-rule-index arena (list-new arena NormAxiom)))
      (saturation (empty-saturation arena))))

  (fn make-findings ((arena Arena) (inconsistent Bool) (unsat-count Int))
    (@intent "Findings with a controllable inconsistency flag and unsatisfiable-set size")
    (@spec ((Arena Bool Int) -> Findings))
    (@alloc arena)
    (let ((mut unsat (list-new arena IRI)))
      (do
        (when (> unsat-count 0)
          (list-push unsat (record-new IRI (value "http://example.org/Unsat"))))
        (record-new Findings
          (inconsistent  inconsistent)
          (unsatisfiable unsat)
          (subsumptions  (list-new arena SubPair))
          (imports-seen  (list-new arena IRI))))))

  (fn make-outcome ((arena Arena) (inconsistent Bool) (unsat-count Int)
                    (omitted-count Int) (reached-fixpoint Bool))
    (@intent "Assemble an Outcome across the three independent axes")
    (@spec ((Arena Bool Int Int Bool) -> Outcome))
    (@alloc arena)
    (let ((mut omitted (list-new arena Omission)))
      (do
        (when (> omitted-count 0)
          (list-push omitted
            (union-new Omission unresolved-import
              (record-new IRI (value "http://example.org/missing-import")))))
        (record-new Outcome
          (profile     'profile-el)
          (coverage    (record-new Coverage (omitted omitted)))
          (termination (if reached-fixpoint
                         (union-new Termination fixpoint)
                         (union-new Termination resource-limit 1000)))
          (findings    (make-findings arena inconsistent unsat-count))
          (evidence    (union-new Evidence el-evidence (empty-saturation arena)))
          (rounds      0)
          (names       (empty-names arena))
          (owned       (list-new arena Arena))
          (stepped-down false)))))

  (fn verdict-eq ((a Verdict) (b Verdict))
    (@intent "Compare two verdicts")
    (@spec ((Verdict Verdict) -> Bool))
    (@pure)
    (== a b))

  ;; ============================================================
  ;; Verdict discipline (§6.2, §10 item 4)
  ;; ============================================================

  ;; Row 3: nothing found, full coverage, fixpoint reached.
  (fn test-coherent-requires-complete ((arena Arena))
    (@intent "Clean findings + empty omissions + fixpoint => coherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (verdict-eq (verdict (make-outcome arena false 0 0 true)) 'verdict-coherent))

  ;; Row 2, first half: coverage gap alone blocks a coherent verdict.
  ;; This is the false-pass guard — the absence of a finding under
  ;; partial coverage carries NO information.
  (fn test-omission-blocks-coherent ((arena Arena))
    (@intent "Clean findings but a non-empty omission list => inconclusive, never coherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (verdict-eq (verdict (make-outcome arena false 0 1 true)) 'verdict-inconclusive))

  ;; Row 2, second half: hitting the round cap blocks it too.
  (fn test-cap-blocks-coherent ((arena Arena))
    (@intent "Clean findings but termination = resource-limit => inconclusive")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (verdict-eq (verdict (make-outcome arena false 0 0 false)) 'verdict-inconclusive))

  ;; Row 1, THE IMPORTANT ONE. A contradiction derived from a SUBSET of
  ;; the ontology is a contradiction in the whole ontology, because
  ;; inference is monotone — restoring an omitted axiom can only add
  ;; conclusions, never retract one. Reporting this as inconclusive
  ;; would discard a sound result.
  (fn test-finding-beats-partial-coverage ((arena Arena))
    (@intent "Inconsistent findings under BOTH a coverage gap and a cap => still incoherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (verdict-eq (verdict (make-outcome arena true 0 1 false)) 'verdict-incoherent))

  ;; Coherence is the WEAKEST of the three conditions: an unsatisfiable
  ;; named class makes an ontology incoherent whether or not it is
  ;; inconsistent. `consistent: true` with a non-empty unsatisfiable set
  ;; is a valid report and a FAILING condition.
  (fn test-consistent-but-incoherent ((arena Arena))
    (@intent "inconsistent = false but unsatisfiable non-empty => incoherent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (verdict-eq (verdict (make-outcome arena false 1 0 true)) 'verdict-incoherent)
         (findings-are-incoherent (make-findings arena false 1))))

  ;; ============================================================
  ;; Structural invariants
  ;; ============================================================

  ;; §7 lists initialization as a Z3-reachable structural obligation,
  ;; and §5.2 explains why: seeds written into the STORE leave every
  ;; queue empty, so `active` is empty at round 0, the driver reports
  ;; fixpoint before firing a single rule, and the run returns an
  ;; instant empty classification that reads as success.
  (fn test-context-starts-with-empty-store ((arena Arena))
    (@intent "A fresh context has an EMPTY subsumer set — seeds belong in the delta")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((ctx (make-context arena
                 (union-new Node class-node
                   (record-new IRI (value "http://example.org/C"))))))
      (== (list-len (set-elements (. ctx subsumers))) 0)))

  (fn node-iri ((n Node))
    (@intent "The IRI text of a class or individual node; empty for a fresh node")
    (@spec ((Node) -> String))
    (match n
      ((class-node i)      (. i value))
      ((individual-node i) (. i value))
      ((fresh-node _)      "")))

  ;; A logical edge is ONE fact stored as TWO halves, and which half
  ;; goes where is the part that matters: emitting only the successor
  ;; looks complete from the deriving context and fails only in the
  ;; CONSUMING rules, since CR4/CR5 read `preds` and CR7 reads both
  ;; sides. The symptom is under-derivation with no error.
  ;;
  ;; `EdgePair` now makes "both halves exist" a TYPE guarantee and the
  ;; destinations a proven postcondition, so this test is a
  ;; belt-and-braces check on the wiring rather than the primary
  ;; defence it used to be.
  (fn test-emit-edge-addresses-both-halves ((arena Arena))
    (@intent "emit-edge sends the successor half to X and the predecessor half to Y")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (union-new Node class-node (record-new IRI (value "http://example.org/X"))))
          (y (union-new Node class-node (record-new IRI (value "http://example.org/Y"))))
          (r (union-new RoleId named-role (record-new IRI (value "http://example.org/r"))))
          (pair (emit-edge arena (record-new LogicalEdge (from x) (role r) (to y)))))
      (if (string-eq (node-iri (. (. pair succ-half) to)) "http://example.org/X")
        (string-eq (node-iri (. (. pair pred-half) to)) "http://example.org/Y")
        false)))

  ;; The stub must not hand back an Outcome. An Outcome carries a
  ;; verdict; a Fault does not. Until the rules land, silence must be
  ;; unreadable as success.
  (fn classify-fixture ((arena Arena) (path String))
    (@intent "The whole pipeline: Turtle in, Outcome out")
    (@spec ((Arena String) -> (Option Outcome)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (classify arena (. g triples) (list-new arena IRI) (default-config))
          ((error _) (none))
          ((ok o)    (some o))))))

  (fn classify-fixture-with ((arena Arena) (path String) (workers Int) (cap Int))
    (@intent "The whole pipeline at a chosen worker count and round budget")
    (@spec ((Arena String Int Int) -> (Option Outcome)))
    (@alloc arena)
    (let ((mut cfg (default-config)))
      (do
        (set! cfg worker-count (cast (Int 1 .. 64) workers))
        (set! cfg max-iterations (cast (Int 0 .. 10000) cap))
        (match (parse-ttl-file arena path)
          ((error _) (none))
          ((ok g)
            (match (classify arena (. g triples) (list-new arena IRI) cfg)
              ((error _) (none))
              ((ok o)    (some o))))))))

  (fn workers-agree ((arena Arena) (path String) (cap Int))
    (@intent "The report at W = 1 and at W = 4 is the same text, line for line")
    (@spec ((Arena String Int) -> Bool))
    (@alloc arena)
    (match (classify-fixture-with arena path 1 cap)
      ((none) false)
      ((some one)
        (match (classify-fixture-with arena path 4 cap)
          ((none) false)
          ((some four) (same-lines (report-lines arena one) (report-lines arena four)))))))

  (fn test-worker-count-does-not-change-the-report ((arena Arena))
    (@intent "M1 (e): the same report at W = 1 and W = 4, complete and capped")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; CAPPED RUNS ARE THE POINT: saturation is confluent, so complete runs
    ;; agree under any scheduling; a run cut short reports whatever state the
    ;; rounds reached, and that is where a racing engine would differ. Cap 1
    ;; cuts every fixture below short. corpus/determinism.py does the full
    ;; W x cap matrix over every fixture; this keeps the property in `make test`.
    ;; undeclared-filler.ttl creates a context at the barrier, the one
    ;; write to the context registry a round makes (saturate.slop).
    (and (workers-agree arena "corpus/fixtures/v0/litmus.ttl" 1000)
         (workers-agree arena "corpus/fixtures/v0/litmus.ttl" 1)
         (workers-agree arena "corpus/fixtures/hazards/cyclic-hierarchy.ttl" 1)
         (workers-agree arena "corpus/fixtures/hazards/abox-disjoint-range.ttl" 1)
         (workers-agree arena "corpus/fixtures/probes/some-unsat-filler.ttl" 2)
         (workers-agree arena "corpus/fixtures/probes/chain-nary.ttl" 1000)
         (workers-agree arena "corpus/fixtures/hazards/undeclared-filler.ttl" 1000)
         (workers-agree arena "corpus/fixtures/hazards/undeclared-filler.ttl" 1)))

  (fn edge-context ((arena Arena) (n Node) (r RoleId) (m Node) (succ Bool))
    (@intent "A pending context for n holding the one r-edge half toward m")
    (@spec ((Arena Node RoleId Node Bool) -> Context))
    (@alloc arena)
    (let ((c (make-context arena n))
          (s (set-new arena Node)))
      (do
        (set-put s m)
        (if succ (map-put (. c succs) r s) (map-put (. c preds) r s))
        c)))

  (fn queue-has ((sat Saturation) (n Node) (d Derived))
    (@intent "Does n's next-round queue hold d?")
    (@spec ((Saturation Node Derived) -> Bool))
    (match (queue-of sat n)
      ((some q)
        (let ((mut found false))
          (do
            (for-each (it (. q items)) (when (derived-eq it d) (set! found true)))
            found)))
      ((none) false)))

  (fn stored-edge ((sat Saturation) (x Node) (r RoleId) (y Node))
    (@intent "Both halves of the edge (x, r, y) are in the store")
    (@spec ((Saturation Node RoleId Node) -> Bool))
    (and (match (context-of sat x)
           ((some cx) (match (map-get (. cx succs) r) ((some s) (set-has s y)) ((none) false)))
           ((none) false))
         (match (context-of sat y)
           ((some cy) (match (map-get (. cy preds) r) ((some s) (set-has s x)) ((none) false)))
           ((none) false))))

  (fn queue-len ((sat Saturation) (n Node))
    (@intent "How many facts n's next-round queue holds; -1 when it has none")
    (@spec ((Saturation Node) -> Int))
    (match (queue-of sat n)
      ((some q) (cast Int (list-len (. q items))))
      ((none)   -1)))

  (fn test-commit-dedups-across-deltas ((arena Arena))
    (@intent "Two workers deriving the same facts commit them once, and queue each new fact once")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The REPORT cannot see a commit that queues a fact twice: processing
    ;; it twice re-derives the same set. So the barrier is checked directly.
    ;; Worker a derives P ∈ S(X) and the edge (X, r, Y); worker b derives
    ;; P and Q ∈ S(X) and the same edge. Both workers' copies of X's facts
    ;; land in X's ONE owner's bucket (the partition's job), so the store
    ;; gets P, Q and both edge halves once, X's queue holds exactly P, Q and
    ;; the successor half, and Y's exactly the predecessor half - checked
    ;; by content, not only by count. X and Y have no contexts beforehand,
    ;; so the partition must create them too.
    (let ((x (cls "http://example.org/X"))
          (y (cls "http://example.org/Y"))
          (p (cls "http://example.org/P"))
          (q (cls "http://example.org/Q"))
          (r (rol "http://example.org/r"))
          (sat (empty-saturation arena))
          (a  (record-new RoundDelta (pending (map-new arena Node Context))))
          (b  (record-new RoundDelta (pending (map-new arena Node Context))))
          (ax (edge-context arena x r y true))
          (ay (edge-context arena y r x false))
          (bx (edge-context arena x r y true))
          (by (edge-context arena y r x false))
          (c1 (arena-new 1048576))
          (c2 (arena-new 1048576))
          (q1 (arena-new 1048576))
          (q2 (arena-new 1048576))
          (mut ds  (list-new arena RoundDelta))
          (mut cas (list-new arena Arena))
          (mut qas (list-new arena Arena)))
      (do
        (set-put (. ax subsumers) p)
        (set-put (. bx subsumers) p)
        (set-put (. bx subsumers) q)
        (map-put (. a pending) x ax)
        (map-put (. a pending) y ay)
        (map-put (. b pending) x bx)
        (map-put (. b pending) y by)
        (list-push ds a)
        (list-push ds b)
        (list-push cas c1)
        (list-push cas c2)
        (list-push qas q1)
        (list-push qas q2)
        (let ((next (commit-round arena arena arena sat ds cas qas)))
          (and (== (queue-len next x) 3)
               (== (queue-len next y) 1)
               (queue-has next x (union-new Derived derived-sub p))
               (queue-has next x (union-new Derived derived-sub q))
               (queue-has next x (union-new Derived derived-succ r y))
               (queue-has next y (union-new Derived derived-pred r x))
               (stored-edge next x r y)
               (== (. next active-count) 2)
               (== (. next iteration) 1)
               (match (context-of next x)
                 ((some cx) (and (set-has (. cx subsumers) p) (set-has (. cx subsumers) q)))
                 ((none)    false)))))))

  (fn test-names-round-trip ((arena Arena))
    (@intent "The saturation boundary's renaming inverts, keeps ⊤ and ⊥, keeps punning apart; empty is identity")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A class and an individual with the SAME IRI must rename to two
    ;; different ids - the tags are what keep punned names apart, and a
    ;; table keyed by IRI alone would merge them (types.slop, Node).
    (let ((names  (empty-names arena))
          (empty  (empty-names arena))
          (c      (cls "http://example.org/C"))
          (i      (union-new Node individual-node (record-new IRI (value "http://example.org/C"))))
          (f      (union-new Node fresh-node 7))
          (r      (rol "http://example.org/r"))
          (top    (node-top))
          (bottom (node-bottom))
          (rc     (intern-node arena names c))
          (ri     (intern-node arena names i))
          (rf     (intern-node arena names f))
          (rr     (intern-role arena names r)))
      (and (node-eq (original-node names rc) c)
           (node-eq (original-node names ri) i)
           (node-eq (original-node names rf) f)
           (role-eq (original-role names rr) r)
           (not (node-eq rc ri))
           (node-eq (intern-node arena names c) rc)
           (same-renamed names c rc)
           (node-eq (intern-node arena names top) top)
           (node-eq (intern-node arena names bottom) bottom)
           (node-eq (original-node empty f) f)
           (same-renamed empty c c)
           (same-renamed empty f f)
           ;; An unknown ORIGINAL fresh node under a non-empty table: its
           ;; id may belong to another node (C is id 0), so it is not
           ;; mistaken for that node's renamed form.
           (match (renamed-node names (union-new Node fresh-node 0))
             ((none)   true)
             ((some _) false)))))

  (fn same-renamed ((names Names) (n Node) (expect Node))
    (@intent "renamed-node n is exactly expect")
    (@spec ((Names Node Node) -> Bool))
    (match (renamed-node names n)
      ((some r) (node-eq r expect))
      ((none)   false)))

  (fn test-litmus-end-to-end ((arena Arena))
    (@intent "§12: Turtle in, Mother ⊑ Parent out, verdict COHERENT")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE WHOLE PROJECT, END TO END. M1 derived this from a hand-built
    ;; NormAxiom fixture; this derives it from the document. It is
    ;; reachable ONLY through the existential on the defining side —
    ;; what materialization cannot see — so if HOWL answers it from
    ;; Turtle, it is a DL reasoner rather than a materialization engine.
    (let ((parent (cls "http://example.org/t#Parent"))
          (mother (cls "http://example.org/t#Mother")))
      (match (classify-fixture arena "corpus/fixtures/v0/litmus.ttl")
        ((none) false)
        ((some o)
          (and (== (cast Int (list-len (. (. o coverage) omitted))) 0)
               (entails-sub (outcome-saturation arena o) (. o names) (. (. o findings) inconsistent) mother parent)
               (match (verdict o) ('verdict-coherent true) (_ false)))))))

  (fn test-role-hierarchy-carries-edges ((arena Arena))
    (@intent "Role hierarchy: an r-edge is an s-edge when r ⊑ s, and not the converse")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A ⊑ ∃r.B, r ⊑ s, ∃s.B ⊑ C: only reading R(s) through the role
    ;; closure lets CR4 match the stored r-edge against ∃s.B. The converse,
    ;; E ⊑ ∃s.B with ∃r.B ⊑ F, must NOT give E ⊑ F.
    (match (classify-fixture arena "corpus/fixtures/probes/subproperty-existential.ttl")
      ((none) false)
      ((some o)
        (let ((inc (. (. o findings) inconsistent)))
          (and (entails-sub (outcome-saturation arena o) (. o names) inc (cls "http://example.org/t#A")
                            (cls "http://example.org/t#C"))
               (not (entails-sub (outcome-saturation arena o) (. o names) inc (cls "http://example.org/t#E")
                                 (cls "http://example.org/t#F"))))))))

  (fn test-role-closure-deep ((arena Arena))
    (@intent "CR4 and CR7 match edges through sup* and sub* of the told role hierarchy")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; role-hierarchy-deep.ttl: each entailment needs the closure at one
    ;; site (see the fixture) - a three-level hierarchy, a late subsumer, an
    ;; equivalent-property cycle, a chain over sub-role legs in both arrival
    ;; orders, and a transitive role under a sub-role - and the converse
    ;; direction must still not hold.
    (match (classify-fixture arena "corpus/fixtures/hazards/role-hierarchy-deep.ttl")
      ((none) false)
      ((some o)
        (let ((inc (. (. o findings) inconsistent))
              (sat (outcome-saturation arena o))
              (nm  (. o names)))
          (and (== (cast Int (list-len (. (. o coverage) omitted))) 0)
               (entails-sub sat nm inc (cls "http://example.org/t#A1") (cls "http://example.org/t#C1"))
               (entails-sub sat nm inc (cls "http://example.org/t#A2") (cls "http://example.org/t#C2"))
               (entails-sub sat nm inc (cls "http://example.org/t#A3") (cls "http://example.org/t#C3"))
               (entails-sub sat nm inc (cls "http://example.org/t#D3") (cls "http://example.org/t#E3"))
               (entails-sub sat nm inc (cls "http://example.org/t#X4") (cls "http://example.org/t#E"))
               (entails-sub sat nm inc (cls "http://example.org/t#X5") (cls "http://example.org/t#E"))
               (entails-sub sat nm inc (cls "http://example.org/t#X6") (cls "http://example.org/t#F6"))
               (not (entails-sub sat nm inc (cls "http://example.org/t#A7")
                                 (cls "http://example.org/t#N7"))))))))

  (fn test-smaller-side-joins ((arena Arena))
    (@intent "CR2 and CR4 derive through the context-side walk when the context is the smaller side")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; smaller-side-join.ttl makes S(X) and S(Y) smaller than the partner
    ;; buckets, so the dispatcher walks the CONTEXT and probes the bucket -
    ;; a branch no other fixture reaches, and one the goldens of the large
    ;; corpora were the only thing to catch when it broke. Each entailment
    ;; below has that branch as its only derivation (see the fixture).
    (match (classify-fixture arena "corpus/fixtures/hazards/smaller-side-join.ttl")
      ((none) false)
      ((some o)
        (let ((inc (. (. o findings) inconsistent)))
          (and (== (cast Int (list-len (. (. o coverage) omitted))) 0)
               (entails-sub (outcome-saturation arena o) (. o names) inc (cls "http://example.org/t#X")
                            (cls "http://example.org/t#E3"))
               (entails-sub (outcome-saturation arena o) (. o names) inc (cls "http://example.org/t#X2")
                            (cls "http://example.org/t#H2")))))))

  (fn test-unattested-import-is-inconclusive ((arena Arena))
    (@intent "M0 ACCEPTANCE (b) end to end: a dangling import is never COHERENT")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE FALSE PASS THE WHOLE VERDICT RULE EXISTS FOR. The axioms here
    ;; are trivially coherent; what makes the run inconclusive is the
    ;; coverage gap, and a pipeline that quietly emptied coverage would
    ;; report a clean COHERENT over an ontology it only partly read.
    (match (classify-fixture arena "corpus/fixtures/hazards/unattested-import.ttl")
      ((none) false)
      ((some o)
        (and (> (cast Int (list-len (. (. o coverage) omitted))) 0)
             (match (verdict o) ('verdict-inconclusive true) (_ false))))))

  (fn test-declared-unused-class-gets-a-context ((arena Arena))
    (@intent "M0 ACCEPTANCE (c) end to end: :Unused is a class HOWL knows exists")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Not an error if this fails — just silence. HOWL would be unable
    ;; to answer `Unused ⊑ ⊤`, unable to list it in a hierarchy, and
    ;; unable to serve a probe naming it, while reporting a clean
    ;; coherent verdict over an ontology it silently knows less about.
    (let ((unused (cls "http://example.org/t#Unused")))
      (match (classify-fixture arena "corpus/fixtures/hazards/declared-unused-class.ttl")
        ((none) false)
        ((some o)
          (and (entails-sub (outcome-saturation arena o) (. o names) (. (. o findings) inconsistent)
                 unused (node-top))
               (match (verdict o) ('verdict-coherent true) (_ false)))))))

  (fn test-abox-disjoint-range-is-incoherent ((arena Arena))
    (@intent "THE MANDATORY IDENTITY FIXTURE: disjoint ranges on a shared target")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Disjoint(C,D), range(r)=C, range(s)=D, r(a,b), s(c,b). This is
    ;; INCONSISTENT, and it is the fixture that fails if role assertions
    ;; went through `∃` instead of edges — individual(b) is an ordinary
    ;; concept name, not a singleton, so the r- and s-successors could
    ;; be different members and nothing would collide. It also fails if
    ;; asserted edges do not seed ran_T, because the published range
    ;; rewrite touches only existential GCIs.
    (match (classify-fixture arena "corpus/fixtures/hazards/abox-disjoint-range.ttl")
      ((none) false)
      ((some o)
        (match (verdict o) ('verdict-incoherent true) (_ false)))))

  ;; ------------------------------------------------------------
  ;; EXTERNAL CONFORMANCE, PINNED HERE. corpus/conformance.py runs the W3C
  ;; OWL 2 and ELK suites; each defect they found is a hazard fixture, and
  ;; each fixture is asserted end to end below so the guarantee does not
  ;; live only in a Python harness that needs the network and a JVM.
  ;; ------------------------------------------------------------

  (fn omitted-count ((o Outcome))
    (@intent "How many axioms the run set aside")
    (@spec ((Outcome) -> Int))
    (@pure)
    (cast Int (list-len (. (. o coverage) omitted))))

  (fn test-undeclared-individual-is-reasoned-over ((arena Arena))
    (@intent "W3C DisjointClasses-002: an undeclared individual's class assertions count")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; :stewie a :Boy , :Girl with Boy and Girl disjoint, :stewie declared
    ;; as nothing. It got no context, so this read as a FALSE COHERENT.
    (match (classify-fixture arena "corpus/fixtures/hazards/undeclared-individual.ttl")
      ((none) false)
      ((some o)
        (and (== (omitted-count o) 0)
             (. (. o findings) inconsistent)
             (match (verdict o) ('verdict-incoherent true) (_ false))))))

  (fn test-anonymous-class-assertion-is-read ((arena Arena))
    (@intent "W3C WebOnt-Restriction-001: `:a a [∃op.⊥]` is a class assertion, not unrecognized")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Filed as unrecognized it was sound but INCONCLUSIVE; read, it is
    ;; INCONSISTENT with nothing omitted.
    (match (classify-fixture arena "corpus/fixtures/hazards/anonymous-class-assertion.ttl")
      ((none) false)
      ((some o)
        (and (== (omitted-count o) 0)
             (. (. o findings) inconsistent)))))

  (fn test-annotation-on-annotation-is-consumed ((arena Arena))
    (@intent "W3C AnnotationAnnotations-001: an owl:Annotation node is header, not an axiom")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Stage 0 must swallow the node — its annotatedSource/Property/Target
    ;; included — and the document must classify COHERENT with nothing
    ;; omitted. Read as a class assertion on an anonymous individual, it
    ;; made the run INCONCLUSIVE.
    (let ((path "corpus/fixtures/hazards/annotated-annotation.ttl")
          (src-pred (make-iri arena "http://www.w3.org/2002/07/owl#annotatedSource")))
      (and
        (match (parse-ttl-file arena path)
          ((error _) false)
          ((ok g)
            (match (stage0-header arena (. g triples) (list-new arena IRI))
              ((error _) false)
              ((ok s0)
                (and (== (count-subclass-triples (. g triples) src-pred) 1)
                     (== (count-subclass-triples (stage0-triples arena s0) src-pred) 0)
                     (== (cast Int (list-len (. s0 omissions))) 0))))))
        (match (classify-fixture arena path)
          ((none) false)
          ((some o)
            (and (== (omitted-count o) 0)
                 (match (verdict o) ('verdict-coherent true) (_ false))))))))

  (fn test-logical-triple-on-header-node-is-not-swallowed ((arena Arena))
    (@intent "A subClassOf on an owl:Annotation node reaches the decoder, never vanishes")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Consumed with the node's scaffolding, the triple left no trace and the
    ;; run read COHERENT. Passed on, it is an omission: INCONCLUSIVE.
    (match (classify-fixture arena "corpus/fixtures/hazards/logical-triple-on-header-node.ttl")
      ((none) false)
      ((some o)
        (and (> (omitted-count o) 0)
             (match (verdict o) ('verdict-inconclusive true) (_ false))))))

  (fn test-repeated-disjoint-member-is-positional ((arena Arena))
    (@intent "ELK DisjointSelf: AllDisjointClasses (A B A) makes A disjoint from itself")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; OWL 2 reads the members pairwise BY POSITION, so A is unsatisfiable
    ;; and B is not. The OWL API collapses the repeat, so no oracle can
    ;; check this (corpus/differential.py's blind spots) — HOWL's answer is
    ;; pinned here and by the fixture's golden instead.
    (let ((a (record-new IRI (value "http://example.org/t#A"))))
      (match (classify-fixture arena "corpus/fixtures/hazards/disjoint-repeated-member.ttl")
        ((none) false)
        ((some o)
          (let ((unsat (. (. o findings) unsatisfiable)))
            (and (== (omitted-count o) 0)
                 (not (. (. o findings) inconsistent))
                 (== (cast Int (list-len unsat)) 1)
                 (match (list-get unsat 0)
                   ((some u) (string-eq (. u value) (. a value)))
                   ((none) false))))))))

  ;; ------------------------------------------------------------
  ;; THE PROBE AGREES WITH THE REPORT. The differential (SPEC §10 item 1,
  ;; corpus/differential.py) certifies the canonical REPORT against the
  ;; oracles; the port serves `entails-sub`. The two read the same
  ;; saturation by different code — extraction bottom-compresses and
  ;; projects to class contexts, the probe tests ⊥ and B in S(A) — so
  ;; this checks, over EVERY ordered pair of class contexts, that the
  ;; probe answers exactly what the report says:
  ;;
  ;;   entails-sub(A,B)  =  inconsistent  or  (A,⊥) listed  or  (A,B) listed
  ;;
  ;; Without it the differential would certify one function and ship
  ;; another. The fixtures are chosen to hit each disjunct and each
  ;; representational corner (equivalence, punning, ⊤/⊥ as named
  ;; classes, an individual-borne inconsistency, a context with no
  ;; axioms), not to cover constructs: construct coverage is the
  ;; differential's job, and this agreement is structural.
  ;; ------------------------------------------------------------

  (fn report-entails ((f Findings) (a Node) (b Node))
    (@intent "entails-sub read off the report: inconsistent, or A unsatisfiable, or (A,B) listed")
    (@spec ((Findings Node Node) -> Bool))
    (@pure)
    (if (. f inconsistent)
      true
      (let ((bottom (node-bottom))
            (mut found false))
        (do
          (for-each (p (. f subsumptions))
            (when (node-eq (. p sub) a)
              (when (node-eq (. p super) bottom) (set! found true))
              (when (node-eq (. p super) b) (set! found true))))
          found))))

  (fn probe-agrees-with-report ((arena Arena) (path String))
    (@intent "entails-sub equals the report's answer on every ordered pair of class contexts")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (classify-fixture arena path)
      ((none) false)
      ((some o)
        (let ((sat   (outcome-saturation arena o))
              (names (. o names))
              (f     (. o findings))
              (mut ok    true)
              (mut pairs 0))
          (do
            ;; The store's keys are RENAMED (types.slop, Names): each is
            ;; mapped back to the node it stands for, and the probe is asked
            ;; about originals, as a caller would ask it.
            (for-each ((ra actx) (. sat contexts))
              (let ((a (original-node names ra)))
                (match a
                  ((class-node ai)
                    ;; owl:Nothing is excluded from the report by name
                    ;; (classify.is-bottom-iri) and ⊥ ⊑ B holds vacuously.
                    (when (not (string-eq (. ai value) "http://www.w3.org/2002/07/owl#Nothing"))
                      (for-each ((rb bctx) (. sat contexts))
                        (let ((b (original-node names rb)))
                          (match b
                            ((class-node _)
                              (do
                                (set! pairs (+ pairs 1))
                                (when (not (== (entails-sub sat names (. f inconsistent) a b)
                                               (report-entails f a b)))
                                  (set! ok false))))
                            ((individual-node _) (do))
                            ((fresh-node _)      (do)))))))
                  ((individual-node _) (do))
                  ((fresh-node _)      (do)))))
            ;; A fixture that yielded no class pairs checked nothing.
            (and ok (> pairs 0)))))))

  (fn test-entails-sub-agrees-with-report ((arena Arena))
    (@intent "The port's probe and the differential's report answer every pair alike")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (probe-agrees-with-report arena "corpus/fixtures/v0/litmus.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/v0/top-bottom.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/hazards/unsatisfiable-consistent.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/hazards/inconsistent-via-individual.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/hazards/abox-disjoint-range.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/hazards/cyclic-hierarchy.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/hazards/punning.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/hazards/owl-nothing-present.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/hazards/declared-unused-class.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/probes/some-unsat-filler.ttl")
         (probe-agrees-with-report arena "corpus/fixtures/probes/top-subsumes-everything.ttl")))

  ;; ============================================================
  ;; M1 — the reasoning fixtures
  ;;
  ;; These drive `saturate` DIRECTLY rather than through
  ;; `howl.classify`, which still refuses. That is deliberate: until the
  ;; §5.2 gate exists to populate `coverage.omitted`, a partial rule set
  ;; behind a non-refusing `classify` would present as full coverage, a
  ;; reached fixpoint and no findings — which the verdict rule reads as
  ;; a clean COHERENT. The rules can be exercised without granting that.
  ;;
  ;; Axioms are hand-normalized. That is not a shortcut around the front
  ;; end; it is also how M0 gets its expected-canonical-`NormAxiom`
  ;; fixtures, since §6.3 requires normalization to be checked against
  ;; exactly this.
  ;; ============================================================

  (fn cls ((name String))
    (@intent "A class node")
    (@spec ((String) -> Node))
    (@pure)
    (union-new Node class-node (record-new IRI (value name))))

  (fn rol ((name String))
    (@intent "A named role")
    (@spec ((String) -> RoleId))
    (@pure)
    (union-new RoleId named-role (record-new IRI (value name))))

  (fn run-fixture ((arena Arena) (signature (List Node)) (axioms (List NormAxiom)))
    (@intent "Initialize from a signature and saturate to fixpoint")
    (@spec ((Arena (List Node) (List NormAxiom)) -> (Result RoundResult Fault)))
    (@alloc arena)
    (saturate arena (make-initial-saturation arena signature)
      (build-rule-index arena axioms) (default-config)))

  ;; ------------------------------------------------------------
  ;; §3.1 THE LITMUS. This is the test that decides whether HOWL is a
  ;; DL reasoner or a materialization engine.
  ;;
  ;;   Parent ≡ Person ⊓ ∃hasChild.Person
  ;;   Mother ⊑ Person ⊓ ∃hasChild.Person        ⟹  Mother ⊑ Parent
  ;;
  ;; Entailed only THROUGH the existential on the defining side, which
  ;; is exactly what forward materialization cannot see. Normalized, the
  ;; defining side's ∃ sits in NEGATIVE position, so it needs
  ;; `∃hasChild.Person ⊑ X` — see `test-polarity-guard` for what happens
  ;; if that direction is flipped.
  ;; ------------------------------------------------------------

  (fn litmus-signature ((arena Arena))
    (@intent "Person, Parent, Mother, and the fresh node normalization introduces")
    (@spec ((Arena) -> (List Node)))
    (@alloc arena)
    (let ((mut sig (list-new arena Node)))
      (do
        (list-push sig (cls "http://example.org/Person"))
        (list-push sig (cls "http://example.org/Parent"))
        (list-push sig (cls "http://example.org/Mother"))
        (list-push sig (union-new Node fresh-node 0))
        sig)))

  (fn litmus-axioms ((arena Arena) (correct-polarity Bool))
    (@intent "The §3.1 litmus in normal form; `false` flips the fresh definition")
    (@spec ((Arena Bool) -> (List NormAxiom)))
    (@alloc arena)
    (let ((person (cls "http://example.org/Person"))
          (parent (cls "http://example.org/Parent"))
          (mother (cls "http://example.org/Mother"))
          (x      (union-new Node fresh-node 0))
          (has-child (rol "http://example.org/hasChild"))
          (mut ax (list-new arena NormAxiom)))
      (do
        ;; ∃hasChild.Person ⊑ X — NEGATIVE position, the load-bearing one.
        (if correct-polarity
          (list-push ax (union-new NormAxiom sub-some-lhs has-child person x))
          ;; The conservative-but-incomplete rewrite: X ⊑ ∃hasChild.Person.
          (list-push ax (union-new NormAxiom sub-some-rhs x has-child person)))
        ;; Person ⊓ X ⊑ Parent
        (list-push ax (union-new NormAxiom sub-and person x parent))
        ;; Parent ⊑ Person, Parent ⊑ ∃hasChild.Person
        (list-push ax (union-new NormAxiom sub-name parent person))
        (list-push ax (union-new NormAxiom sub-some-rhs parent has-child person))
        ;; Mother ⊑ Person, Mother ⊑ ∃hasChild.Person
        (list-push ax (union-new NormAxiom sub-name mother person))
        (list-push ax (union-new NormAxiom sub-some-rhs mother has-child person))
        ax)))

  (fn litmus-derives-parent ((arena Arena) (correct-polarity Bool))
    (@intent "Run the litmus and probe Mother ⊑ Parent")
    (@spec ((Arena Bool) -> Bool))
    (@alloc arena)
    (match (run-fixture arena (litmus-signature arena) (litmus-axioms arena correct-polarity))
      ((ok r)
        (let ((f (extract-findings arena (. r saturation) (empty-names arena))))
          (entails-sub (. r saturation) (empty-names arena) (. f inconsistent)
            (cls "http://example.org/Mother") (cls "http://example.org/Parent"))))
      ((error _) false)))

  (fn test-litmus ((arena Arena))
    (@intent "§3.1: HOWL derives Mother ⊑ Parent — the DL-reasoner threshold")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (litmus-derives-parent arena true))

  ;; The mirror, and it is a REAL test rather than a curiosity. §6.3
  ;; step 3 warns that the one-sided "definitional" rewrite is
  ;; conservative, incomplete, and looks like it followed the spec's
  ;; example. If this ever passes, normalization has silently lost the
  ;; only entailment that defines the project.
  (fn test-polarity-guard ((arena Arena))
    (@intent "With the fresh definition at the WRONG polarity, Mother ⊑ Parent is NOT derivable")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (not (litmus-derives-parent arena false)))

  ;; ------------------------------------------------------------
  ;; Termination. §6.4: the `\ Sₙ` novelty test is not an optimization —
  ;; without it, `A ⊑ B, B ⊑ A` re-derives both subsumers every round,
  ;; a batch-only dedup keeps them because they are distinct WITHIN the
  ;; batch, the frontier never empties, and an ordinary cyclic hierarchy
  ;; burns its budget and returns inconclusive forever.
  ;; ------------------------------------------------------------

  (fn test-cyclic-hierarchy-terminates ((arena Arena))
    (@intent "A ⊑ B, B ⊑ A reaches FIXPOINT rather than the round cap")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (cls "http://example.org/A"))
          (b (cls "http://example.org/B"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig a)
        (list-push sig b)
        (list-push ax (union-new NormAxiom sub-name a b))
        (list-push ax (union-new NormAxiom sub-name b a))
        (match (run-fixture arena sig ax)
          ((ok r)
            (match (. r termination)
              ((fixpoint)         true)
              ((resource-limit _) false)))
          ((error _) false)))))

  ;; ------------------------------------------------------------
  ;; CR4's two-sided trigger, and the round snapshot that makes it work.
  ;;
  ;;   E ⊑ ∃r.F,  F ⊑ G,  ∃r.G ⊑ H     ⟹  E ⊑ H
  ;;
  ;; The edge (E,r,F) and the subsumer G ∈ S(F) are derived in the SAME
  ;; round, so both land in F's inbox together. §6.4 calls this the
  ;; silent-and-permanent case: if the driver joined against the
  ;; PRE-round state Sₙ₋₁, neither premise would see the other, and in
  ;; the next round neither is in the delta any more — so the conclusion
  ;; is never derived, by any handler, ever. Sₙ = Sₙ₋₁ ∪ Δₙ is what
  ;; makes it reachable.
  ;; ------------------------------------------------------------

  (fn test-same-round-co-arrival ((arena Arena))
    (@intent "A CR4 subsumer and its matching predecessor edge arriving together still conclude")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((e (cls "http://example.org/E"))
          (f (cls "http://example.org/F"))
          (g (cls "http://example.org/G"))
          (h (cls "http://example.org/H"))
          (r (rol "http://example.org/r"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig e) (list-push sig f) (list-push sig g) (list-push sig h)
        (list-push ax (union-new NormAxiom sub-some-rhs e r f))   ; E ⊑ ∃r.F
        (list-push ax (union-new NormAxiom sub-name f g))          ; F ⊑ G
        (list-push ax (union-new NormAxiom sub-some-lhs r g h))    ; ∃r.G ⊑ H
        (match (run-fixture arena sig ax)
          ((ok res)
            (let ((fi (extract-findings arena (. res saturation) (empty-names arena))))
              (entails-sub (. res saturation) (empty-names arena) (. fi inconsistent) e h)))
          ((error _) false)))))

  ;; The MIRROR, and it exists because mutation testing found a hole:
  ;; deleting `cr-exists-lhs-on-sub` from the dispatcher broke no test
  ;; at all. Both the litmus and the co-arrival fixture happen to have
  ;; the edge arrive no earlier than the subsumer, so CR4's *other*
  ;; handler covered them and this one was never needed.
  ;;
  ;;   E ⊑ ∃r.F,  F ⊑ F1,  F1 ⊑ G,  ∃r.G ⊑ H     ⟹  E ⊑ H
  ;;
  ;; The chain F ⊑ F1 ⊑ G DELAYS G by one round, so the edge (E,r,F)
  ;; has already arrived and been processed by the time G reaches S(F).
  ;; Only the new-subsumer handler, scanning the STORED predecessors,
  ;; can close it. §6.4's point exactly: a multi-premise rule must be
  ;; re-triggered by EACH premise independently, and which premise
  ;; arrives last is a scheduling artifact.
  ;; ------------------------------------------------------------

  (fn test-late-subsumer-still-concludes ((arena Arena))
    (@intent "CR4 concludes when the subsumer arrives AFTER its edge — pins the new-subsumer handler")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((e  (cls "http://example.org/E"))
          (f  (cls "http://example.org/F"))
          (f1 (cls "http://example.org/F1"))
          (g  (cls "http://example.org/G"))
          (h  (cls "http://example.org/H"))
          (r  (rol "http://example.org/r"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig e) (list-push sig f) (list-push sig f1)
        (list-push sig g) (list-push sig h)
        (list-push ax (union-new NormAxiom sub-some-rhs e r f))   ; E ⊑ ∃r.F
        (list-push ax (union-new NormAxiom sub-name f f1))         ; F ⊑ F1
        (list-push ax (union-new NormAxiom sub-name f1 g))         ; F1 ⊑ G  (the delay)
        (list-push ax (union-new NormAxiom sub-some-lhs r g h))    ; ∃r.G ⊑ H
        (match (run-fixture arena sig ax)
          ((ok res)
            (let ((fi (extract-findings arena (. res saturation) (empty-names arena))))
              (entails-sub (. res saturation) (empty-names arena) (. fi inconsistent) e h)))
          ((error _) false)))))

  ;; ------------------------------------------------------------
  ;; Unsatisfiability, and the two outputs that follow from it.
  ;;
  ;;   A ⊑ B,  A ⊑ C,  B ⊓ C ⊑ ⊥       ⟹  ⊥ ∈ S(A)
  ;;
  ;; Note this ontology is CONSISTENT and INCOHERENT at once — exactly
  ;; the case `validate` exists to catch and the one a reasoner keyed
  ;; only on inconsistency misses.
  ;; ------------------------------------------------------------

  (fn unsat-fixture ((arena Arena))
    (@intent "A ⊑ B, A ⊑ C, B ⊓ C ⊑ ⊥")
    (@spec ((Arena) -> (Result RoundResult Fault)))
    (@alloc arena)
    (let ((a (cls "http://example.org/A"))
          (b (cls "http://example.org/B"))
          (c (cls "http://example.org/C"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig a) (list-push sig b) (list-push sig c)
        (list-push ax (union-new NormAxiom sub-name a b))
        (list-push ax (union-new NormAxiom sub-name a c))
        (list-push ax (union-new NormAxiom sub-and b c (node-bottom)))
        (run-fixture arena sig ax))))

  (fn test-unsatisfiable-class-detected ((arena Arena))
    (@intent "⊥ ∈ S(A) surfaces as a non-empty unsatisfiable set, and owl:Nothing does NOT")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (unsat-fixture arena)
      ((ok r)
        (let ((f (extract-findings arena (. r saturation) (empty-names arena))))
          ;; Exactly one unsatisfiable class: A. If owl:Nothing leaked in
          ;; — and it satisfies ⊥ ∈ S(⊥) by construction, since every
          ;; context is seeded with itself — this would be 2, and every
          ;; real ontology would exit 1.
          (if (== (list-len (. f unsatisfiable)) 1)
            (findings-are-incoherent f)
            false)))
      ((error _) false)))

  (fn test-bottom-compression ((arena Arena))
    (@intent "The PROBE answers true for an unsatisfiable A; the TAXONOMY holds only (A,⊥)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (unsat-fixture arena)
      ((ok r)
        (let ((a (cls "http://example.org/A"))
              (b (cls "http://example.org/B"))
              (f (extract-findings arena (. r saturation) (empty-names arena)))
              (mut pairs-about-a 0))
          (do
            (for-each (p (. f subsumptions))
              (when (node-eq (. p sub) a)
                (set! pairs-about-a (+ pairs-about-a 1))))
            ;; A is unsatisfiable, so A ⊑ B is entailed for EVERY B and
            ;; the probe must say so. The taxonomy must NOT say so, or an
            ;; unsatisfiable class explodes the hierarchy by the size of
            ;; the signature. Both readings are defensible in isolation;
            ;; implementing one where the other belongs gives either
            ;; false negatives on probes or a quadratic hierarchy.
            (if (entails-sub (. r saturation) (empty-names arena) (. f inconsistent) a b)
              (== pairs-about-a 1)
              false))))
      ((error _) false)))

  ;; ------------------------------------------------------------
  ;; UNDEFINED, NOT EMPTY. Under inconsistency both output lists are
  ;; empty because they are UNDEFINED — an inconsistent ontology has no
  ;; model, so every class is unsatisfiable and every subsumption
  ;; entailed, yet raw ⊥ ∈ S(A) finds none of them when the
  ;; inconsistency arrived through ⊤ or an individual. `inconsistent:
  ;; true` alongside a populated `unsatisfiable` would read as a partial
  ;; census of the damage; alongside an empty one it reads as
  ;; "consistent classes". Neither is what the fields mean.
  ;;
  ;; This carries the obligation that `extract-findings` states as OWED:
  ;; the contracts are true but undischargeable by the checker, so the
  ;; guarantee lives here instead of nowhere.
  ;;
  ;;   ⊤ ⊑ ⊥   ⟹   ⊥ ∈ S(⊤)   ⟹   inconsistent
  ;; ------------------------------------------------------------

  (fn test-inconsistency-suppresses-both-lists ((arena Arena))
    (@intent "An inconsistent ontology reports EMPTY lists, not a partial census")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (cls "http://example.org/A"))
          (mut sig (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push sig a)
        ;; ⊤ ⊑ ⊥ — the smallest inconsistency there is.
        (list-push ax (union-new NormAxiom sub-name (node-top) (node-bottom)))
        (match (run-fixture arena sig ax)
          ((ok r)
            (let ((f (extract-findings arena (. r saturation) (empty-names arena))))
              (if (. f inconsistent)
                (if (== (list-len (. f unsatisfiable)) 0)
                  (== (list-len (. f subsumptions)) 0)
                  false)
                false)))
          ((error _) false)))))

  ;; The equality the toolchain does not give us. `==` on a `Derived` compares
  ;; ONLY the first payload (slop-lang/slop#66): `(derived-succ r Y₁)` and
  ;; `(derived-succ r Y₂)` come back equal, because the role matches and the
  ;; node is never examined. Nothing in HOWL keys a Set on `Derived`, so the
  ;; broken function is not even emitted today — but this test pins the
  ;; behaviour we DO rely on, and it is the check that will still be here if
  ;; someone reaches for `==` after 0.1.3 lands and the hazard looks retired.
  (fn test-derived-eq-compares-both-payloads ((arena Arena))
    (@intent "derived-eq distinguishes a second payload that generated `==` ignores")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((r  (rol "http://example.org/r"))
          (y1 (cls "http://example.org/Y1"))
          (y2 (cls "http://example.org/Y2"))
          (x  (cls "http://example.org/X")))
      (do
        (if (derived-eq (union-new Derived derived-succ r y1)
                        (union-new Derived derived-succ r y2))
          false
          (if (not (derived-eq (union-new Derived derived-succ r y1)
                               (union-new Derived derived-succ r y1)))
            false
            ;; Cross-variant: same role, same node, different direction.
            (if (derived-eq (union-new Derived derived-succ r y1)
                            (union-new Derived derived-pred r y1))
              false
              ;; Addressed must compare destination AND payload.
              (if (addressed-eq
                    (record-new Addressed (to x) (what (union-new Derived derived-sub y1)))
                    (record-new Addressed (to y2) (what (union-new Derived derived-sub y1))))
                false
                (addressed-eq
                  (record-new Addressed (to x) (what (union-new Derived derived-sub y1)))
                  (record-new Addressed (to x) (what (union-new Derived derived-sub y1)))))))))))

  ;; ------------------------------------------------------------
  ;; Order independence (§6.8). Set iteration is bucket order, which is
  ;; not content-canonical, so a round must not depend on it. Feeding
  ;; the same theory with the signature in the opposite order perturbs
  ;; map insertion order without changing content; the round count and
  ;; the findings sizes must be identical.
  ;;
  ;; This checks SIZES only. Element order is pinned end to end by
  ;; `test-triple-order-independence`, which compares whole canonical
  ;; reports line for line.
  ;; ------------------------------------------------------------

  (fn test-order-independence ((arena Arena))
    (@intent "Reversing the signature changes neither the round count nor the findings")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (cls "http://example.org/A"))
          (b (cls "http://example.org/B"))
          (c (cls "http://example.org/C"))
          (mut fwd (list-new arena Node))
          (mut rev (list-new arena Node))
          (mut ax  (list-new arena NormAxiom)))
      (do
        (list-push fwd a) (list-push fwd b) (list-push fwd c)
        (list-push rev c) (list-push rev b) (list-push rev a)
        (list-push ax (union-new NormAxiom sub-name a b))
        (list-push ax (union-new NormAxiom sub-name b c))
        (match (run-fixture arena fwd ax)
          ((ok r1)
            (match (run-fixture arena rev ax)
              ((ok r2)
                (let ((f1 (extract-findings arena (. r1 saturation) (empty-names arena)))
                      (f2 (extract-findings arena (. r2 saturation) (empty-names arena))))
                  (if (== (. (. r1 saturation) iteration) (. (. r2 saturation) iteration))
                    (if (== (list-len (. f1 subsumptions)) (list-len (. f2 subsumptions)))
                      (== (list-len (. f1 unsatisfiable)) (list-len (. f2 unsatisfiable)))
                      false)
                    false)))
              ((error _) false)))
          ((error _) false)))))

  ;; ============================================================

  ;; ============================================================
  ;; Canonical ordering (§6.8) — src/canon.slop
  ;; ============================================================

  (fn mk-iri ((v String))
    (@intent "An IRI record from a string")
    (@spec ((String) -> IRI))
    (@pure)
    (record-new IRI (value v)))

  (fn test-string-cmp-is-length-safe ((arena Arena))
    (@intent "A prefix orders by LENGTH, not by the bytes that follow it in the buffer")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE HAZARD, DEMONSTRATED. Before slop 0.4.0 `strlib.compare` was
    ;; `strcmp` over `(. a data)` (slop#161), so it read to the first NUL. Every IRI HOWL
    ;; orders is a slice into a parsed Turtle buffer, where the byte
    ;; after an IRI is the rest of the document. `apple` below is
    ;; exactly such a slice — it shares its storage with `applesauce`
    ;; and has no NUL at offset 5 — so `strcmp` would compare
    ;; "applesauce" against "applesauce" and report EQUAL, silently
    ;; merging two distinct IRIs in a sorted report. `string-cmp` uses
    ;; the length and gets it right.
    (let ((buf   "applesauce")
          (apple (String (. buf data) 5)))
      (and (== (string-cmp apple buf) -1)
           (== (string-cmp buf apple) 1)
           (== (string-cmp apple "apple") 0)
           (== (string-cmp apple apple) 0))))

  (fn test-node-cmp-separates-punned-iris ((arena Arena))
    (@intent "class-node(:x) and individual-node(:x) are DISTINCT under the order")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; §6.2: OWL permits punning, so the same IRI can denote a class
    ;; AND an individual. A comparator reading only the IRI would call
    ;; these equal, collapsing the two populations the tags exist to
    ;; keep apart — and §6.2's own example shows the cost: a class
    ;; `:x ⊑ ⊥` merged with an unrelated individual `:x` manufactures a
    ;; FALSE inconsistency.
    (let ((c (union-new Node class-node (mk-iri "http://example.org/x")))
          (i (union-new Node individual-node (mk-iri "http://example.org/x"))))
      (and (!= (node-cmp c i) 0)
           (== (node-cmp c i) -1)          ; class-node sorts first
           (== (node-cmp i c) 1)
           (== (node-cmp c c) 0))))

  (fn test-sort-orders-and-is-input-determined ((arena Arena))
    (@intent "Sorting is a function of CONTENT, not of insertion order (§6.8)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The §6.8 property in miniature: the same four IRIs presented in
    ;; two different orders must produce byte-identical output. This is
    ;; what makes a report hashable into a durable verdict.
    (let ((mut a (list-new arena IRI))
          (mut b (list-new arena IRI)))
      (do
        (list-push a (mk-iri "http://example.org/zebra"))
        (list-push a (mk-iri "http://example.org/apple"))
        (list-push a (mk-iri "http://example.org/apple2"))
        (list-push a (mk-iri "http://example.org/mango"))
        (list-push b (mk-iri "http://example.org/mango"))
        (list-push b (mk-iri "http://example.org/apple2"))
        (list-push b (mk-iri "http://example.org/zebra"))
        (list-push b (mk-iri "http://example.org/apple"))
        (let ((sa (sort-iris arena a))
              (sb (sort-iris arena b))
              (mut ok true)
              (mut i 0)
              (n  (cast Int (list-len sa))))
          (do
            ;; same length as the input, and as each other
            (if (!= n 4) (set! ok false) (do))
            (if (!= (cast Int (list-len sb)) 4) (set! ok false) (do))
            ;; element-wise identical, and ascending
            (while (< i n)
              (do
                (if (!= (iri-cmp (iri-at sa i) (iri-at sb i)) 0)
                  (set! ok false) (do))
                (if (and (> i 0) (>= (iri-cmp (iri-at sa (- i 1)) (iri-at sa i)) 0))
                  (set! ok false) (do))
                (set! i (+ i 1))))
            ;; and the least really is the least
            (if (!= (iri-cmp (iri-at sa 0) (mk-iri "http://example.org/apple")) 0)
              (set! ok false) (do))
            ok)))))

  ;; ============================================================
  ;; Front end — the checked RDF-list walk (M0 slice 2)
  ;; ============================================================

  (fn ex-iri ((arena Arena) (local String))
    (@intent "An example-namespace IRI term")
    (@spec ((Arena String) -> Term))
    (@alloc arena)
    (make-iri arena (string-concat arena "http://example.org/t#" local)))

  ;; ============================================================
  ;; Front end — stage 0, the header pre-pass (M0 slice 2)
  ;;
  ;; These run against the REAL corpus fixtures rather than
  ;; hand-built triples. The fixtures are what SPEC.md §12's
  ;; acceptance criteria name, so testing anything else would be
  ;; testing a paraphrase of the requirement.
  ;; ============================================================

  (fn count-subclass-triples ((ts (List Triple)) (pred Term))
    (@intent "How many rdfs:subClassOf triples survived stage 0")
    (@spec (((List Triple) Term) -> Int))
    (@pure)
    (let ((mut n 0))
      (do
        (for-each (t ts)
          (when (term-eq (. t predicate) pred) (set! n (+ n 1))))
        n)))

  (fn test-unattested-import-yields-an-omission ((arena Arena))
    (@intent "M0 ACCEPTANCE (b): a declared import nobody supplied becomes an omission")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE FALSE PASS THIS CLOSES. HOWL never fetches an import; the
    ;; caller attests to the closure it supplied. A declared import
    ;; nobody attested to means axioms HOWL never saw, so a "coherent"
    ;; verdict would be over a strictly smaller ontology than the
    ;; document describes — sound about the wrong input.
    (match (parse-ttl-file arena "corpus/fixtures/hazards/unattested-import.ttl")
      ((error _) false)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) false)
          ((ok s0)
            (and (== (cast Int (list-len (. s0 imports-declared))) 1)
                 (== (cast Int (list-len (. s0 omissions))) 1)))))))

  (fn test-attested-import-yields-none ((arena Arena))
    (@intent "The same document, with the import attested, gates clean")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The necessary other half. Without it the test above passes for
    ;; an implementation that emits an omission for EVERY import,
    ;; which would make every real ontology inconclusive.
    (match (parse-ttl-file arena "corpus/fixtures/hazards/unattested-import.ttl")
      ((error _) false)
      ((ok g)
        (let ((mut resolved (list-new arena IRI)))
          (do
            (list-push resolved (record-new IRI (value "http://example.org/does-not-exist")))
            (match (stage0-header arena (. g triples) resolved)
              ((error _) false)
              ((ok s0)
                (and (== (cast Int (list-len (. s0 imports-declared))) 1)
                     (== (cast Int (list-len (. s0 omissions))) 0)))))))))

  (fn test-term-store-by-content ((arena Arena))
    (@intent "The term store keys terms by content, collapses duplicates, and answers only what it holds")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The document states `:s :p "v"^^:dt` twice (the parser keeps both)
    ;; and types :s and :u as :T. The probe literal is built here, its
    ;; datatype string concatenated at run time, so it shares no pointer
    ;; with the parsed one: only CONTENT can make them the same term. A
    ;; store keying literals by their bytes (as slop's generated hash did
    ;; before #205, pointers and padding included) says it is absent.
    (let ((ttl "@prefix : <http://example.org/t#> .\n:s :p \"v\"^^:dt .\n:s :p \"v\"^^:dt .\n:s a :T .\n:u a :T .\n"))
      (match (parse-ttl-string arena ttl)
        ((error _) false)
        ((ok g)
          (let ((st (build-store arena (. g triples)))
                (s  (make-iri arena "http://example.org/t#s"))
                (p  (make-iri arena "http://example.org/t#p"))
                (u  (make-iri arena "http://example.org/t#u"))
                (dt (string-concat arena "http://example.org/t#" "dt"))
                (v  (make-literal arena "v" (some dt) (none)))
                (other (make-literal arena "v" (none) (none))))
            (and (== (cast Int (list-len (store-objects arena st s p))) 1)
                 (store-contains st (make-triple arena s p v))
                 (not (store-contains st (make-triple arena s p other)))
                 (== (cast Int (list-len (store-typed arena st (make-iri arena "http://example.org/t#T")))) 2)
                 (store-has-any st s p)
                 (not (store-has-any st u p))
                 (== (cast Int (list-len (store-objects arena st u p))) 0)))))))

  (fn test-term-store-quoted-and-tagged ((arena Arena))
    (@intent "Quoted triples are one term by structure, nested too; literals differ by language tag")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Built directly, so the two are certainly allocated apart. q1 and q2 are
    ;; allocated apart but equal, as `term-eq` means it, so the store must
    ;; find q1's triple through q2 - and the same one level down, for a
    ;; quoted triple that contains them. A pointer-keyed store (slop-rdf's
    ;; IndexedGraph) saw two terms. Literals: "v"@en is stored; "v"@en
    ;; built apart is present, "v"@fr and plain "v" are not.
    (let ((a  (make-iri arena "http://example.org/t#a"))
          (b  (make-iri arena "http://example.org/t#b"))
          (c  (make-iri arena "http://example.org/t#c"))
          (p  (make-iri arena "http://example.org/t#p"))
          (r  (make-iri arena "http://example.org/t#r"))
          (o  (make-iri arena "http://example.org/t#o"))
          (q1 (make-triple-term arena (make-triple arena a b c)))
          (q2 (make-triple-term arena (make-triple arena a b c)))
          (n1 (make-triple-term arena (make-triple arena q1 r o)))
          (n2 (make-triple-term arena (make-triple arena q2 r o)))
          (en (make-literal arena "v" (none) (some "en")))
          (en2 (make-literal arena "v" (none) (some (string-concat arena "e" "n"))))
          (fr (make-literal arena "v" (none) (some "fr")))
          (plain (make-literal arena "v" (none) (none)))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena q1 p o))
        (list-push ts (make-triple arena n1 p o))
        (list-push ts (make-triple arena a p en))
        (let ((st (build-store arena ts)))
          (and (== (cast Int (list-len (store-objects arena st q2 p))) 1)
               (store-has-any st n2 p)
               (store-contains st (make-triple arena a p en2))
               (not (store-contains st (make-triple arena a p fr)))
               (not (store-contains st (make-triple arena a p plain))))))))

  (fn stage0-triples ((arena Arena) (s0 Stage0))
    (@intent "Stage 0's logical triples as slop-rdf triples, for a test to read")
    (@spec ((Arena Stage0) -> (List Triple)))
    (@alloc arena)
    (let ((mut out (list-new arena Triple)))
      (do
        (for-each (it (. s0 triples)) (list-push out (triple-of (. s0 dict) it)))
        out)))

  (fn decode-rendered ((arena Arena) (r (Result Stage1 Fault)))
    (@intent "A decode's outcome as text: every axiom rendered in order, or the fault")
    (@spec ((Arena (Result Stage1 Fault)) -> (List String)))
    (@alloc arena)
    (let ((mut out (list-new arena String)))
      (do
        (match r
          ((ok s1) (for-each (ax (. s1 axioms)) (list-push out (render-axiom arena ax))))
          ((error f)
            (match f
              ((input-error m) (list-push out m))
              ((refused _)     (list-push out "refused"))
              ((cancelled)     (list-push out "cancelled"))
              ((unavailable _) (list-push out "unavailable")))))
        out)))

  (fn decode-store-agrees ((arena Arena) (path String))
    (@intent "On one fixture, decode over its filtered store equals decode over a store of every triple")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) false)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) false)
          ((ok s0)
            (let ((full (store-over arena (. s0 dict))))
              (do
                (for-each (it (. s0 triples)) (store-insert-ids arena full it))
                (let ((a (decode-rendered arena (decode-axioms-with arena full (. s0 dict) (. s0 triples))))
                      (b (decode-rendered arena (decode-axioms-with arena (decode-store arena (. s0 dict) (. s0 triples))
                                                   (. s0 dict) (. s0 triples))))
                      (mut same (== (list-len a) (list-len b)))
                      (mut i 0))
                  (do
                    (while (and same (< i (cast Int (list-len a))))
                      (do
                        (when (!= (string-cmp (str-at a i) (str-at b i)) 0) (set! same false))
                        (set! i (+ i 1))))
                    (when (not same) (do (print "  [decode-store] differs: ") (println path)))
                    same)))))))))

  (fn test-decode-store-answers-as-the-full-store ((arena Arena))
    (@intent "Decode's store indexes only the predicates it queries, and decodes exactly as a full store does")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; `decode-store` keeps the triples of 21 predicates - the ones decode's
    ;; queries ask about. If a query on another predicate is ever added,
    ;; the fixture exercising it decodes differently here. The fixtures
    ;; cover RDF lists (IRI and blank cells), restrictions, cardinalities,
    ;; n-ary axioms with owl:members, inverse expressions and chains.
    (let ((mut ok true)
          (mut ps (list-new arena String)))
      (do
        (list-push ps "corpus/fixtures/v0/litmus.ttl")
        (list-push ps "corpus/fixtures/v0/intersection.ttl")
        (list-push ps "corpus/fixtures/v0/exists-lhs.ttl")
        (list-push ps "corpus/fixtures/v0/disjoint-nary.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push ps "corpus/fixtures/v0/abox-assertions.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/cardinality.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/complement.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/union.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/nominals.ttl")
        (list-push ps "corpus/fixtures/el++/has-self.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/inverse-expressions.ttl")
        (list-push ps "corpus/fixtures/el++/equality.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/allvalues.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/datatypes.ttl")
        (list-push ps "corpus/fixtures/hazards/annotation-heavy.ttl")
        (for-each (p ps) (when (not (decode-store-agrees arena p)) (set! ok false)))
        ok)))

  (fn stage0-fault-of ((arena Arena) (ts (List Triple)))
    (@intent "Stage 0's input-error message for these triples, or empty when it succeeds")
    (@spec ((Arena (List Triple)) -> String))
    (@alloc arena)
    (match (stage0-header arena ts (list-new arena IRI))
      ((ok _) "")
      ((error f)
        (match f
          ((input-error m) m)
          ((refused _)     "refused")
          ((cancelled)     "cancelled")
          ((unavailable _) "unavailable")))))

  (fn test-stage0-fault-follows-the-document ((arena Arena))
    (@intent "Which malformed reification's fault is reported follows the document, never hash order")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Two owl:Axiom nodes, one missing its annotatedSource, the other its
    ;; annotatedTarget. The last one in the document is the fault reported,
    ;; so reversing the triples must flip the message. When the nodes came
    ;; from the index's hash set, both orders gave the same message - the
    ;; one whose blank node hashed last - and this failed.
    (let ((ttl "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:A a owl:Class . :B a owl:Class .\n_:x a owl:Axiom ; owl:annotatedProperty rdfs:subClassOf ; owl:annotatedTarget :B .\n_:y a owl:Axiom ; owl:annotatedSource :A ; owl:annotatedProperty rdfs:subClassOf .\n"))
      (match (parse-ttl-string arena ttl)
        ((error _) false)
        ((ok g)
          (and (== (string-cmp (stage0-fault-of arena (. g triples))
                     "owl:Axiom node without a usable owl:annotatedTarget") 0)
               (== (string-cmp (stage0-fault-of arena (reversed-triples arena (. g triples)))
                     "owl:Axiom node without a usable owl:annotatedSource") 0))))))

  (fn test-stage0-rebuild-checks-the-whole-input ((arena Arena))
    (@intent "A reified triple asserted anywhere in the input - header included - is not rebuilt")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The owl:Axiom reifies `<t> rdfs:comment "c"`, which the document
    ;; also asserts - on the ontology node, where stage 0 consumes it as
    ;; header material. "Also asserted" means in the INPUT, so nothing is
    ;; rebuilt and nothing is left. Stage 0 now answers containment from
    ;; small stores rather than one over the document; testing it against
    ;; the KEPT triples instead would leave the rebuilt comment here.
    (let ((ttl "@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n<http://example.org/t> a owl:Ontology ; rdfs:comment \"c\" .\n_:x a owl:Axiom ; owl:annotatedSource <http://example.org/t> ; owl:annotatedProperty rdfs:comment ; owl:annotatedTarget \"c\" .\n"))
      (match (parse-ttl-string arena ttl)
        ((error _) false)
        ((ok g)
          (match (stage0-header arena (. g triples) (list-new arena IRI))
            ((error _) false)
            ((ok s0) (== (cast Int (list-len (. s0 triples))) 0)))))))

  (fn test-header-and-reification-are-consumed ((arena Arena))
    (@intent "Ontology header and owl:Axiom scaffolding leave stage 0 as logical content")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; annotation-heavy.ttl asserts `:A rdfs:subClassOf :B` AND reifies
    ;; it. Stage 0 must reconstruct the reified axiom without
    ;; duplicating the asserted one — exactly one subclass triple
    ;; survives — and must leave no versionIRI, versionInfo or
    ;; annotatedTarget triple behind for the gate to call unsupported.
    (match (parse-ttl-file arena "corpus/fixtures/hazards/annotation-heavy.ttl")
      ((error _) false)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) false)
          ((ok s0)
            (let ((sub-pred (make-iri arena RDFS_SUBCLASS_OF))
                  (kept (count-subclass-triples (stage0-triples arena s0) sub-pred))
                  (before (count-subclass-triples (. g triples) sub-pred)))
              ;; The document writes the subclass triple once, plus an
              ;; owl:annotatedProperty naming rdfs:subClassOf — which is
              ;; NOT a subclass triple and must not be counted as one.
              (and (== kept 1)
                   (== before 1)
                   (== (cast Int (list-len (. s0 omissions))) 0)
                   (< (cast Int (list-len (. s0 triples)))
                      (cast Int (list-len (. g triples)))))))))))

  ;; ============================================================
  ;; Front end — stage 1a, class expressions (M0 slice 2)
  ;; ============================================================

  (fn count-out-of-profile ((axs (List RawAxiom)))
    (@intent "How many decoded axioms v0 cannot take — form OR operands")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    ;; BOTH CONDITIONS, and the corpus proved why. Counting only
    ;; `d-out-of-profile` passed six out-of-profile fixtures silently:
    ;; `SubClassOf(A, ObjectUnionOf(B,C))` is a SubClassOf, an
    ;; in-profile FORM, carrying a concept ELH⊥R+ has no constructor
    ;; for. The form matrix cannot see into the operands.
    (let ((mut n 0))
      (do
        (for-each (a axs)
          (match (disposition 'profile-el a)
            ('d-out-of-profile (set! n (+ n 1)))
            ('d-in-profile     (when (not (axiom-in-profile 'profile-el a)) (set! n (+ n 1))))
            ('d-inert          (do))
            ('d-consumed       (do))))
        n)))

  (fn count-disposition ((axs (List RawAxiom)) (want Disposition))
    (@intent "How many decoded axioms carry the given disposition")
    (@spec (((List RawAxiom) Disposition) -> Int))
    (@pure)
    (let ((mut n 0))
      (do
        (for-each (a axs)
          (when (== (disposition 'profile-el a) want) (set! n (+ n 1))))
        n)))

  (fn decode-fixture ((arena Arena) (path String))
    (@intent "Parse, stage 0, stage 1 — the whole front end as it stands")
    (@spec ((Arena String) -> (Option Stage1)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)
            (match (decode-axioms arena (. s0 dict) (. s0 triples))
              ((error _) (none))
              ((ok s1)  (some s1))))))))

  (fn nary-disjoint-member-count ((axs (List RawAxiom)))
    (@intent "How many classes the decoded n-ary disjointness actually carries")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    (let ((mut n 0))
      (do
        (for-each (a axs)
          (match a
            ((ra-disjoint-classes cs) (set! n (cast Int (list-len cs))))
            (_ (do))))
        n)))

  (fn test-nary-disjointness-keeps-its-members ((arena Arena))
    (@intent "owl:AllDisjointClasses decodes with all three members, not zero")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A SILENTLY EMPTIED AXIOM IS THE WORST FAILURE SHAPE. This axiom
    ;; is IN PROFILE, so decoding it with an empty member list would
    ;; have HOWL accept it, derive nothing from it, and still report
    ;; full coverage — a wrong answer no coverage check can see,
    ;; because the axiom is counted as handled. Only reading the
    ;; members back catches it.
    (match (decode-fixture arena "corpus/fixtures/v0/disjoint-nary.ttl")
      ((none) false)
      ((some s1)
        (and (== (nary-disjoint-member-count (. s1 axioms)) 3)
             (== (count-out-of-profile (. s1 axioms)) 0)))))

  (fn out-of-profile-count-of ((arena Arena) (path String))
    (@intent "Out-of-profile axioms in a fixture, or -1 if it did not decode")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (decode-fixture arena path)
      ((none)    -1)
      ((some s1) (count-out-of-profile (. s1 axioms)))))

  (fn test-v0-corpus-decodes-clean ((arena Arena))
    (@intent "Every v0 fixture decodes with nothing out of profile")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The v0 corpus IS the profile, fixture by fixture. One of these
    ;; going out-of-profile means a construct the spec admits has no
    ;; decoder — which downstream looks like an incomplete ontology
    ;; rather than a missing feature. The v0/negation-* fixtures are
    ;; not here: a positive complement is in the fragment only AFTER the
    ;; gate's rewrite (expand-negation), so they decode with rc-not and
    ;; are checked where the rewrite runs, in the gate test below.
    (let ((mut paths (list-new arena String))
          (mut ok true))
      (do
        (list-push paths "corpus/fixtures/v0/subclass-atomic.ttl")
        (list-push paths "corpus/fixtures/v0/intersection.ttl")
        (list-push paths "corpus/fixtures/v0/exists-lhs.ttl")
        (list-push paths "corpus/fixtures/v0/exists-rhs.ttl")
        (list-push paths "corpus/fixtures/v0/equivalent-classes.ttl")
        (list-push paths "corpus/fixtures/v0/equivalent-properties.ttl")
        (list-push paths "corpus/fixtures/v0/disjoint-binary.ttl")
        (list-push paths "corpus/fixtures/v0/disjoint-nary.ttl")
        (list-push paths "corpus/fixtures/v0/subproperty.ttl")
        (list-push paths "corpus/fixtures/v0/property-chain.ttl")
        (list-push paths "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push paths "corpus/fixtures/v0/transitive.ttl")
        (list-push paths "corpus/fixtures/v0/domain.ttl")
        (list-push paths "corpus/fixtures/v0/range.ttl")
        (list-push paths "corpus/fixtures/v0/abox-assertions.ttl")
        (list-push paths "corpus/fixtures/v0/top-bottom.ttl")
        (list-push paths "corpus/fixtures/v0/litmus.ttl")
        (for-each (p paths)
          (when (!= (out-of-profile-count-of arena p) 0)
            (do (print "  [sweep] expected 0 out-of-profile, got ")
                (print (int-to-string arena (out-of-profile-count-of arena p)))
                (print " in ") (println p)
                (set! ok false))))
        ok)))

  (fn test-out-of-profile-corpus-is-caught ((arena Arena))
    (@intent "All 15 out-of-profile fixtures yield at least one rejected axiom")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The other half, and the one that matters for soundness: a
    ;; construct v0 cannot handle must be REPORTED, not quietly decoded
    ;; into something in-profile. A decoder that mapped owl:unionOf onto
    ;; an intersection would pass the v0 sweep above and be catastrophic.
    (let ((mut paths (list-new arena String))
          (mut ok true))
      (do
        (list-push paths "corpus/fixtures/out-of-profile/union.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/complement.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/allvalues.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/nominals.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/cardinality.ttl")
        (list-push paths "corpus/fixtures/el++/has-self.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/inverse.ttl")
        (list-push paths "corpus/fixtures/el++/equality.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/property-characteristics.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/haskey-disjointunion.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/swrl-rule.ttl")
        (list-push paths "corpus/fixtures/el++/builtin-roles.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/anonymous-individual.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/datatypes.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/inverse-expressions.ttl")
        (for-each (p paths)
          (when (< (out-of-profile-count-of arena p) 1)
            (do (print "  [sweep] expected >=1 out-of-profile, got ")
                (print (int-to-string arena (out-of-profile-count-of arena p)))
                (print " in ") (println p)
                (set! ok false))))
        ok)))

  (fn test-annotation-heavy-decodes-clean ((arena Arena))
    (@intent "M0 ACCEPTANCE (a): nothing in an annotated ontology is out of profile")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE FAILURE THIS CATCHES IS TOTAL, NOT PARTIAL. If labels,
    ;; declarations or reification reach the out-of-profile list, every
    ;; real ontology gates dirty and NOTHING downstream ever classifies
    ;; — HOWL would be correct and useless. The independent census got
    ;; exactly this wrong on its first run, bucketing 350
    ;; owl:annotatedTarget triples as unsupported.
    (match (decode-fixture arena "corpus/fixtures/hazards/annotation-heavy.ttl")
      ((none) false)
      ((some s1)
        (let ((axs (. s1 axioms)))
          (and (== (count-out-of-profile axs) 0)
               ;; and the logical content SURVIVED: the subclass axiom is
               ;; still there. A decoder that dropped everything would also
               ;; score zero out-of-profile.
               (> (count-disposition axs 'd-in-profile) 0)
               (> (. s1 inert) 0)
               (> (count-disposition axs 'd-consumed) 0))))))

  (fn test-litmus-decodes-clean ((arena Arena))
    (@intent "The litmus ontology decodes with nothing out of profile")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (decode-fixture arena "corpus/fixtures/v0/litmus.ttl")
      ((none) false)
      ((some s1)
        (let ((axs (. s1 axioms)))
          (and (== (count-out-of-profile axs) 0)
               ;; Parent's equivalence and Mother's inclusion, at least.
               (>= (count-disposition axs 'd-in-profile) 2))))))

  ;; ============================================================
  ;; Front end — sugar expansion and the profile gate (M0 slice 3)
  ;; ============================================================

  (fn test-missing-class-declaration-is-reported ((arena Arena))
    (@intent "A class used in a subsumption but never declared is an omission")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Determinate position: the object of rdfs:subClassOf can only be a
    ;; class, so there IS an EntityKind to report and the recoverable
    ;; `missing-declaration` omission applies — unlike the ambiguous
    ;; property case, which faults instead.
    (let ((pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n"))
      (and (> (gate-omissions-of-ttl arena (string-concat arena pre
                ":A a owl:Class . :A rdfs:subClassOf :B .")) 0)
           ;; THE ACCEPTING HALF: declare :B and the same document gates
           ;; clean. Without it this passes for an implementation that
           ;; reports a missing declaration for every class in existence.
           (== (gate-omissions-of-ttl arena (string-concat arena pre
                 ":A a owl:Class . :B a owl:Class . :A rdfs:subClassOf :B .")) 0))))

  (fn cites-lines ((arena Arena) (refs (List AxiomRef)))
    (@intent "Each cited axiom's text on its own line")
    (@spec ((Arena (List AxiomRef)) -> String))
    (@alloc arena)
    (let ((mut out ""))
      (do
        (for-each (r refs) (set! out (string-concat arena out (string-concat arena (. r text) "\n"))))
        out)))

  (fn cited-text ((arena Arena) (gr GateResult) (iri String))
    (@intent "The axioms the missing declaration of iri cites, one per line; none when iri is not missing")
    (@spec ((Arena GateResult String) -> String))
    (@alloc arena)
    (let ((mut out "none"))
      (do
        (for-each (o (. gr omissions))
          (match o
            ((missing-declaration md)
              (when (string-eq (. (. md entity) value) iri)
                (set! out (cites-lines arena (. md referring)))))
            (_ (do))))
        out)))

  (fn test-missing-declaration-cites-its-axioms ((arena Arena))
    (@intent "A missing declaration cites exactly the accepted axioms that name the entity")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; `referring` is not in the report's text, so only a direct read sees
    ;; it: citing every accepted axiom passed every other test.
    (let ((pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:A a owl:Class . :B a owl:Class .\n"))
      (match (gate-ttl arena (string-concat arena pre
               ":A rdfs:subClassOf :D . :B rdfs:subClassOf :D . :A rdfs:subClassOf :E . :A rdfs:subClassOf :B ."))
        ((none)    false)
        ((some gr)
          (and (string-eq (cited-text arena gr "http://example.org/t#D")
                          "SubClassOf(http://example.org/t#A http://example.org/t#D)\nSubClassOf(http://example.org/t#B http://example.org/t#D)\n")
               (string-eq (cited-text arena gr "http://example.org/t#E")
                          "SubClassOf(http://example.org/t#A http://example.org/t#E)\n")
               (string-eq (cited-text arena gr "http://example.org/t#B") "none"))))))

  (fn test-undeclared-individual-is-not-reported ((arena Arena))
    (@intent "Named-individual declarations are OPTIONAL in OWL 2 DL")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Requiring one would report a finding against the majority of
    ;; published ABoxes — a false-fail that looks rigorous. Position and
    ;; declaration are additive: an IRI may be used as an individual
    ;; with no owl:NamedIndividual triple at all.
    (let ((ttl "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n:A a owl:Class . :p a owl:ObjectProperty .\n:a a :A . :a :p :b .\n"))
      (== (gate-omissions-of-ttl arena ttl) 0)))

  (fn accepted-count-of-ttl ((arena Arena) (ttl String))
    (@intent "How many axioms the gate ACCEPTED for an inline document")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (parse-ttl-string arena ttl)
      ((error _) -1)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) -1)
          ((ok s0)
            (match (decode-axioms arena (. s0 dict) (. s0 triples))
              ((error _) -1)
              ((ok s1)
                (cast Int (list-len (. (gate-axioms arena (. s1 axioms) (. s1 signature)
                                         (carried-of arena s0 s1) 'profile-el) accepted))))))))))

  (fn test-reserved-iri-as-individual-is-out-of-profile ((arena Arena))
    (@intent "owl:Nothing used as a named individual is REPORTED, not consumed")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; OWL 2 forbids reserved IRIs as named individuals, and this one
    ;; hides well: `individual-node(owl:Nothing)` is a DISTINCT node
    ;; from `class-node(owl:Nothing)` under tag-first comparison — which
    ;; is exactly the property that makes punning safe — so it never
    ;; collides with ⊥ and would otherwise be consumed as an ordinary
    ;; declaration and silently given a context.
    (let ((pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n:A a owl:Class . :p a owl:ObjectProperty . :a a owl:NamedIndividual .\n"))
      (and (> (gate-omissions-of-ttl arena (string-concat arena pre
                "owl:Nothing a owl:NamedIndividual .")) 0)
           (> (gate-omissions-of-ttl arena (string-concat arena pre
                ":a :p owl:Nothing .")) 0)
           ;; THE ACCEPTING HALF: `owl:Thing a owl:Class` is
           ;; legitimate — it IS a class — and rejecting it would
           ;; refuse ordinary published documents.
           (== (gate-omissions-of-ttl arena (string-concat arena pre
                "owl:Thing a owl:Class .")) 0))))

  (fn test-annotation-property-axioms-are-inert ((arena Arena))
    (@intent "SubAnnotationPropertyOf / AnnotationPropertyDomain carry NO logical content")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; ANNOTATION AXIOMS ARE SEMANTICALLY INERT IN OWL 2. Decoding
    ;; `:note rdfs:domain :A` as an ObjectPropertyDomain injects the GCI
    ;; `∃note.⊤ ⊑ A` — real logical content the document does not state
    ;; — and `:note rdfs:subPropertyOf :other` injects a role inclusion
    ;; into the TOLD HIERARCHY that both RBox gates then read. The first
    ;; is unsound (derives subsumptions that do not hold); the second
    ;; can reject a valid RBox.
    (let ((pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:A a owl:Class .\n:note a owl:AnnotationProperty . :other a owl:AnnotationProperty .\n"))
      (and (== (accepted-count-of-ttl arena (string-concat arena pre
                 ":note rdfs:domain :A .")) 0)
           (== (accepted-count-of-ttl arena (string-concat arena pre
                 ":note rdfs:range :A .")) 0)
           (== (accepted-count-of-ttl arena (string-concat arena pre
                 ":note rdfs:subPropertyOf :other .")) 0))))

  (fn decodes-ok ((arena Arena) (ttl String))
    (@intent "Does this document get past stage 1 without an input-error?")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (parse-ttl-string arena ttl)
      ((error _) false)
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) false)
          ((ok s0)
            (match (decode-axioms arena (. s0 dict) (. s0 triples))
              ((error _) false)
              ((ok _)    true)))))))

  (fn carried-of ((arena Arena) (s0 Stage0) (s1 Stage1))
    (@intent "What decode-encoded hands the gate as carried coverage: stage 0's, then stage 1's")
    (@spec ((Arena Stage0 Stage1) -> (List Omission)))
    (@alloc arena)
    (let ((mut oms (list-new arena Omission)))
      (do
        (for-each (o (. s0 omissions)) (list-push oms o))
        (for-each (o (. s1 omitted)) (list-push oms o))
        oms)))

  (fn test-undeclared-property-is-an-omission ((arena Arena))
    (@intent "`:a :p :b` with :p undeclared is ambiguous, so it is OMITTED, never guessed")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; `missing-declaration` names a kind, and here no position fixes one:
    ;; :p could be an object property or an annotation property, and with
    ;; a literal a data property or an annotation property. The run must
    ;; still go on (issue #70), so the triples are one omission per
    ;; property, citing them all, and the theory is read without them.
    (let ((pre (string-concat arena "@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n"
                 ":c a owl:Class . :d a owl:Class . :c rdfs:subClassOf :d .\n")))
      (and (omits-exactly arena "undeclared, IRI and literal objects"
             (string-concat arena pre
               ":a :p :b . :c :editorNote \"x\" . :d :editorNote \"y\" .")
             "UndeclaredProperty(http://example.org/t#editorNote)\nUndeclaredProperty(http://example.org/t#p)\n")
           ;; the rest of the document is still read
           (== (string-cmp (gate-accepted-of-ttl arena (string-concat arena (eq-prefix)
                 (string-concat arena pre ":c :editorNote \"x\" .")))
               "SubClassOf(http://example.org/t#c http://example.org/t#d)\n") 0)
           ;; one omission per property, citing every triple, sorted
           (undeclared-cites arena (string-concat arena (eq-prefix)
             (string-concat arena pre ":d :editorNote \"y\" . :c :editorNote \"x\" ."))
             "<http://example.org/t#c> <http://example.org/t#editorNote> \"x\" ."
             "<http://example.org/t#d> <http://example.org/t#editorNote> \"y\" .")
           ;; THE ACCEPTING HALF: declare it and nothing is omitted.
           ;; Without this the test passes for an implementation that
           ;; omits every property assertion in existence.
           (omits-exactly arena "declared"
             (string-concat arena pre
               ":p a owl:ObjectProperty . :a :p :b . :editorNote a owl:AnnotationProperty . :c :editorNote \"x\" .")
             ""))))

  (fn undeclared-cites ((arena Arena) (ttl String) (first String) (second String))
    (@intent "Is the document's one omission an undeclared property citing exactly these two triples?")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (match (gate-ttl arena ttl)
      ((none) false)
      ((some gr)
        (and (== (list-len (. gr omissions)) 1)
             (match (omission-at (. gr omissions) 0)
               ((undeclared-property u)
                 (and (== (list-len (. u referring)) 2)
                      (== (string-cmp (str-at (. u referring) 0) first) 0)
                      (== (string-cmp (str-at (. u referring) 1) second) 0)))
               (_ false))))))

  (fn test-unknown-owl-vocabulary-still-decodes ((arena Arena))
    (@intent "Reserved vocabulary HOWL does not implement gates, never faults")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A future profile's axiom must DECODE and be reported, not fail to
    ;; parse. Treating unknown owl: vocabulary like an undeclared user
    ;; property would fail a document merely for mentioning it.
    (let ((ttl "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n:A a owl:Class . :B a owl:Class .\n:A owl:someFutureAxiom :B .\n"))
      (and (decodes-ok arena ttl)
           (> (gate-omissions-of-ttl arena ttl) 0))))

  (fn test-conflicting-declarations-are-an-input-error ((arena Arena))
    (@intent "An IRI declared under two disjoint property kinds FAULTS")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Punning a class with an individual is legal and stays legal —
    ;; node-cmp compares the tag first exactly so the two remain
    ;; distinct. The three property kinds are pairwise disjoint, and an
    ;; IRI in two of them has the same ambiguity an undeclared one has.
    (let ((pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n"))
      (and (not (decodes-ok arena (string-concat arena pre
                  ":p a owl:ObjectProperty . :p a owl:AnnotationProperty .")))
           ;; and legal class/individual punning is NOT rejected
           (decodes-ok arena (string-concat arena pre
             ":x a owl:Class . :x a owl:NamedIndividual .")))))

  (fn gate-ttl ((arena Arena) (ttl String))
    (@intent "Parse, stage 0, decode and gate an inline Turtle document under el")
    (@spec ((Arena String) -> (Option GateResult)))
    (@alloc arena)
    (gate-ttl-in arena ttl 'profile-el))

  (fn gate-ttl-in ((arena Arena) (ttl String) (p Profile))
    (@intent "Parse, stage 0, decode and gate an inline Turtle document under a rung")
    (@spec ((Arena String Profile) -> (Option GateResult)))
    (@alloc arena)
    (match (parse-ttl-string arena ttl)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)
            (match (decode-axioms arena (. s0 dict) (. s0 triples))
              ((error _) (none))
              ((ok s1)
                (some (gate-axioms arena (. s1 axioms) (. s1 signature)
                        (carried-of arena s0 s1) p)))))))))

  ;; ============================================================
  ;; ⊥-locality (SPEC §8.4, "The answer run classifies a module")
  ;; ============================================================

  (fn axioms-of-ttl ((arena Arena) (ttl String))
    (@intent "An inline document decoded: its logical axioms, declarations left out")
    (@spec ((Arena String) -> (List RawAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena RawAxiom)))
      (do
        (match (parse-ttl-string arena ttl)
          ((error _) (do))
          ((ok g)
            (match (stage0-header arena (. g triples) (list-new arena IRI))
              ((error _) (do))
              ((ok s0)
                (match (decode-axioms arena (. s0 dict) (. s0 triples))
                  ((error _) (do))
                  ((ok s1) (for-each (ax (. s1 axioms))
                             (when (not (is-declaration ax)) (list-push out ax)))))))))
        out)))

  (fn is-declaration ((ax RawAxiom))
    (@intent "Is ax a declaration?")
    (@spec ((RawAxiom) -> Bool))
    (match ax ((ra-declaration _) true) (_ false)))

  (fn t-iris ((arena Arena) (names (List String)))
    (@intent "The example namespace's IRIs for these local names, as a set")
    (@spec ((Arena (List String)) -> (Set IRI)))
    (@alloc arena)
    (let ((out (set-new arena IRI)))
      (do (for-each (n names)
            (set-put out (record-new IRI (value (string-concat arena "http://example.org/t#" n)))))
          out)))

  (fn loc ((arena Arena) (label String) (ttl String) (names (List String)) (want Bool))
    (@intent "Is the document's one logical axiom local for S = these names exactly as wanted? Prints it when not")
    (@spec ((Arena String String (List String) Bool) -> Bool))
    (@alloc arena)
    (let ((axs (axioms-of-ttl arena (string-concat arena (rung-prefix) ttl)))
          (s   (t-iris arena names)))
      (if (and (== (list-len axs) 1)
               (match (list-get axs 0) ((some ax) (== (axiom-local ax s) want)) ((none) false)))
        true
        (do (print "  [locality] ") (print label) (print ": ") (print (int-to-string arena (cast Int (list-len axs))))
            (println " axiom(s), or the wrong verdict")
            false))))

  (fn test-locality-table ((arena Arena))
    (@intent "SPEC §8.4's Con⊥, Con⊤ and locality table, row by row, each with an S that makes it local and one that does not")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and
        ;; C ⊑ D: C outside S, or D everything
        (loc arena "C ⊑ D, S = {}" ":C rdfs:subClassOf :D ." (list String) true)
        (loc arena "C ⊑ D, S = {C}" ":C rdfs:subClassOf :D ." (list String "C") false)
        (loc arena "C ⊑ ⊤, S = {C}" ":C rdfs:subClassOf owl:Thing ." (list String "C") true)
        ;; ∃: empty when its role or filler is
        (loc arena "∃r.D ⊑ C, S = {C}" "[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :D ] rdfs:subClassOf :C ." (list String "C") true)
        (loc arena "∃r.D ⊑ C, S = {C r}" "[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :D ] rdfs:subClassOf :C ." (list String "C" "r") true)
        (loc arena "∃r.D ⊑ C, S = {C r D}" "[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :D ] rdfs:subClassOf :C ." (list String "C" "r" "D") false)
        ;; ∀: everything when its role is empty or its filler everything
        (loc arena "C ⊑ ∀r.D, S = {C}" ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :D ] ." (list String "C") true)
        (loc arena "C ⊑ ∀r.D, S = {C r}" ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :D ] ." (list String "C" "r") false)
        ;; ¬: everything when what it negates is empty
        (loc arena "C ⊑ ¬D, S = {C}" ":C rdfs:subClassOf [ owl:complementOf :D ] ." (list String "C") true)
        (loc arena "C ⊑ ¬D, S = {C D}" ":C rdfs:subClassOf [ owl:complementOf :D ] ." (list String "C" "D") false)
        ;; ⊔ and ⊓
        (loc arena "C ⊑ D ⊔ ⊤, S = {C D}" ":C rdfs:subClassOf [ owl:unionOf ( :D owl:Thing ) ] ." (list String "C" "D") true)
        (loc arena "C ⊓ D ⊑ ⊥, S = {C}" "[ owl:intersectionOf ( :C :D ) ] rdfs:subClassOf owl:Nothing ." (list String "C") true)
        (loc arena "C ⊓ D ⊑ ⊥, S = {C D}" "[ owl:intersectionOf ( :C :D ) ] rdfs:subClassOf owl:Nothing ." (list String "C" "D") false)
        (loc arena "C ⊔ D ⊑ ⊥, S = {C}" "[ owl:unionOf ( :C :D ) ] rdfs:subClassOf owl:Nothing ." (list String "C") false)
        ;; number restrictions
        (loc arena "C ⊑ ≤1 r, S = {C}" ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxCardinality 1 ] ." (list String "C") true)
        (loc arena "C ⊑ ≤1 r, S = {C r}" ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxCardinality 1 ] ." (list String "C" "r") false)
        (loc arena "C ⊑ ≥0 r, S = {C r}" ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:minCardinality 0 ] ." (list String "C" "r") true)
        (loc arena "≥1 r ⊑ C, S = {C}" "[ a owl:Restriction ; owl:onProperty :r ; owl:minCardinality 1 ] rdfs:subClassOf :C ." (list String "C") true)
        (loc arena "C ⊑ ≤1 r.D, S = {C r}" ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 1 ; owl:onClass :D ] ." (list String "C" "r") true)
        (loc arena "C ⊑ ≤1 r.D, S = {C r D}" ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 1 ; owl:onClass :D ] ." (list String "C" "r" "D") false)
        ;; nominals and Self
        (loc arena "∃r.{a} ⊑ C, S = {C a}" "[ a owl:Restriction ; owl:onProperty :r ; owl:hasValue :a ] rdfs:subClassOf :C ." (list String "C" "a") true)
        (loc arena "∃r.{a} ⊑ C, S = {C r a}" "[ a owl:Restriction ; owl:onProperty :r ; owl:hasValue :a ] rdfs:subClassOf :C ." (list String "C" "r" "a") false)
        (loc arena "∃r.Self ⊑ C, S = {C}" "[ a owl:Restriction ; owl:onProperty :r ; owl:hasSelf true ] rdfs:subClassOf :C ." (list String "C") true)
        (loc arena "{a} ⊑ C, S = {C}" "[ owl:oneOf ( :a ) ] rdfs:subClassOf :C ." (list String "C") false)
        ;; n-ary class axioms
        (loc arena "C ≡ D, S = {}" ":C owl:equivalentClass :D ." (list String) true)
        (loc arena "C ≡ D, S = {C}" ":C owl:equivalentClass :D ." (list String "C") false)
        (loc arena "Disjoint(C, D), S = {C}" ":C owl:disjointWith :D ." (list String "C") true)
        (loc arena "Disjoint(C, D), S = {C D}" ":C owl:disjointWith :D ." (list String "C" "D") false)
        (loc arena "DisjointUnion(C, D), S = {}" ":C owl:disjointUnionOf ( :D ) ." (list String) true)
        (loc arena "DisjointUnion(C, D), S = {D}" ":C owl:disjointUnionOf ( :D ) ." (list String "D") false)
        ;; the RBox
        (loc arena "r ⊑ s, S = {s}" ":r rdfs:subPropertyOf :s ." (list String "s") true)
        (loc arena "r ⊑ s, S = {r}" ":r rdfs:subPropertyOf :s ." (list String "r") false)
        (loc arena "r∘s ⊑ t, S = {r t}" ":t owl:propertyChainAxiom ( :r :s ) ." (list String "r" "t") true)
        (loc arena "r∘s ⊑ t, S = {r s}" ":t owl:propertyChainAxiom ( :r :s ) ." (list String "r" "s") false)
        (loc arena "Trans(r), S = {}" ":r a owl:TransitiveProperty ." (list String) true)
        (loc arena "Trans(r), S = {r}" ":r a owl:TransitiveProperty ." (list String "r") false)
        (loc arena "Func(r), S = {}" ":r a owl:FunctionalProperty ." (list String) true)
        (loc arena "Ref(r) is never local" ":r a owl:ReflexiveProperty ." (list String) false)
        (loc arena "Domain(r, C), S = {C}" ":r rdfs:domain :C ." (list String "C") true)
        (loc arena "Domain(r, C), S = {r}" ":r rdfs:domain :C ." (list String "r") false)
        (loc arena "Range(r, C), S = {}" ":r rdfs:range :C ." (list String) true)
        (loc arena "r ≡ s⁻, S = {r}" ":r owl:inverseOf :s ." (list String "r") false)
        (loc arena "r ≡ s⁻, S = {}" ":r owl:inverseOf :s ." (list String) true)
        (loc arena "Disjoint(r, s), S = {r}" ":r owl:propertyDisjointWith :s ." (list String "r") true)
        (loc arena "Disjoint(r, s), S = {r s}" ":r owl:propertyDisjointWith :s ." (list String "r" "s") false)
        ;; the ABox: an assertion holds of no empty class or role
        (loc arena "C(a), S = {}" ":a a :C ." (list String) false)
        (loc arena "∀r.D(a), S = {}" ":a a [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :D ] ." (list String) true)
        (loc arena "r(a, b) is never local" ":a :r :b ." (list String) false)
        (loc arena "¬r(a, b), S = {}" "[ a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ] ." (list String) true)
        (loc arena "a = b is never local" ":a owl:sameAs :b ." (list String) false)
        ;; what HOWL cannot read is never local, wherever it sits
        (loc arena "HasKey is never local" ":C owl:hasKey ( :r ) ." (list String) false)
        (loc arena "C ⊑ ∃d.string, S = {}: C empty" ":d a owl:DatatypeProperty . :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :d ; owl:someValuesFrom <http://www.w3.org/2001/XMLSchema#string> ] ." (list String) true)
        ;; OWL's own vocabulary is never outside S: it cannot be emptied
        (loc arena "Domain(topObjectProperty, Nothing), S = {}" "owl:topObjectProperty rdfs:domain owl:Nothing ." (list String) false)
        (loc arena "DisjointUnion(Thing, C, D), S = {}" "owl:Thing owl:disjointUnionOf ( :C :D ) ." (list String) false)
        (loc arena "C ⊑ ∃d.string, S = {C}: a data range is neither" ":d a owl:DatatypeProperty . :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :d ; owl:someValuesFrom <http://www.w3.org/2001/XMLSchema#string> ] ." (list String "C") false)))

  (fn test-unreadable-is-omitted ((arena Arena))
    (@intent "L3: an axiom whose signature HOWL cannot read in full is an omission under every rung")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (rungs3-omit arena "HasKey" ":C owl:hasKey ( :r ) ." 1 1 1)
         (rungs3-omit arena "a data range in a class position"
           ":d a owl:DatatypeProperty . :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :d ; owl:someValuesFrom <http://www.w3.org/2001/XMLSchema#string> ] ."
           1 1 1)
         ;; Two: the class expression, and its undeclared property <urn:x>.
         (rungs3-omit arena "an undecodable class expression" ":C rdfs:subClassOf [ <urn:x> :D ] ." 2 2 2)))

  (fn test-module-order-free ((arena Arena))
    (@intent "The module is the least fixpoint: the same axioms whatever their order")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((axs  (axioms-of-ttl arena (string-concat arena (rung-prefix)
                  ":C rdfs:subClassOf :D . :D rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :E ] . :E rdfs:subClassOf :F . :X rdfs:subClassOf :Y . :r rdfs:subPropertyOf :s . :Y owl:disjointWith :Z . :a :t :b .")))
          (seed (list IRI (record-new IRI (value "http://example.org/t#C"))))
          (mut rev (list-new arena RawAxiom))
          (mut k 0))
      (do
        (set! k (- (cast Int (list-len axs)) 1))
        (while (>= k 0)
          (do (match (list-get axs k) ((some a) (list-push rev a)) ((none) (do))) (set! k (- k 1))))
        (let ((m1 (rendered-sorted arena (. (module-axioms arena axs seed) axioms)))
              (m2 (rendered-sorted arena (. (module-axioms arena rev seed) axioms))))
          ;; C ⊑ D, D ⊑ ∃r.E, E ⊑ F and r ⊑ s are in M; X ⊑ Y and
          ;; Disjoint(Y, Z) are local; t(a, b), an assertion, is never.
          (and (== (list-len m1) 5) (lines-equal m1 m2))))))

  (fn rendered-sorted ((arena Arena) (axs (List RawAxiom)))
    (@intent "The axioms rendered, in sorted order")
    (@spec ((Arena (List RawAxiom)) -> (List String)))
    (@alloc arena)
    (let ((mut out (list-new arena String)))
      (do (for-each (ax axs) (list-push out (render-axiom arena ax)))
          (sort-strings arena out))))

  (fn lines-equal ((a (List String)) (b (List String)))
    (@intent "The same strings in the same order")
    (@spec (((List String) (List String)) -> Bool))
    (let ((mut ok (== (list-len a) (list-len b)))
          (mut k 0))
      (do (for-each (x a)
            (do (match (list-get b k) ((some y) (when (not (string-eq x y)) (set! ok false))) ((none) (set! ok false)))
                (set! k (+ k 1))))
          ok)))

  (fn module-answer ((arena Arena) (text String) (sub String) (sup String))
    (@intent "The answer run's one answer, and its omission count and inconsistency, over a document of the example namespace")
    (@spec ((Arena String String String) -> String))
    (@alloc arena)
    (let ((in (input-new))
          (mut o (default-options)))
      (do
        (set! o profile 'profile-el)
        (input-add-turtle in (string-concat arena (probe-prefixes) text))
        (input-ask-subsumed in (string-concat arena "http://example.org/t#" sub) (string-concat arena "http://example.org/t#" sup))
        (let ((r   (run-answer in o))
              (out (lines-text arena r)))
          (do (run-free r) (input-free in) out)))))

  (fn test-module-answers ((arena Arena))
    (@intent "§8.4: an omission outside the module no longer blocks `no`; one inside does; an inconsistency anywhere still makes every answer a flagged yes")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((base ":A a owl:Class . :B a owl:Class . :X a owl:Class . :Y a owl:Class . :Z a owl:Class . :A rdfs:subClassOf :B .\n")
          (union ":X rdfs:subClassOf [ owl:unionOf ( :Y :Z ) ] .\n")
          (clash ":C a owl:Class . :C rdfs:subClassOf owl:Nothing . :c a owl:NamedIndividual , :C .\n"))
      (let ((top     (module-answer arena (string-concat arena base "owl:topObjectProperty rdfs:domain owl:Nothing .\n") "B" "A"))
            (thing   (module-answer arena (string-concat arena base ":P a owl:Class . :Q a owl:Class . :P rdfs:subClassOf owl:Nothing . :Q rdfs:subClassOf owl:Nothing . owl:Thing owl:disjointUnionOf ( :P :Q ) .\n") "B" "A"))
            (outside (module-answer arena (string-concat arena base union) "B" "A"))
            (inside  (module-answer arena (string-concat arena base union) "X" "Y"))
            (incons  (module-answer arena (string-concat arena base clash) "B" "A")))
        ;; Codex's counterexamples: the universal role and owl:Thing make
        ;; these inconsistent from outside the queried classes. The module
        ;; must keep them, so no `no` may come back.
        (let ((ok (and (not (ends-with-line arena top "probe subsumed http://example.org/t#B http://example.org/t#A no"))
                       (not (ends-with-line arena thing "probe subsumed http://example.org/t#B http://example.org/t#A no"))
                       (string-eq outside "profile el\nprobes 1\nprobe-inconsistent false\nprobe-omitted 0\nprobe subsumed http://example.org/t#B http://example.org/t#A no\n")
                       (starts-with inside "profile el\nprobes 1\nprobe-inconsistent false\nprobe-omitted 1\n")
                       (ends-with-line arena inside "probe subsumed http://example.org/t#X http://example.org/t#Y unknown")
                       (starts-with incons "profile el\nprobes 1\nprobe-inconsistent true\n")
                       (ends-with-line arena incons "probe subsumed http://example.org/t#B http://example.org/t#A yes"))))
          (do (when (not ok) (do (println "  [module] answers:") (print top) (print thing) (print outside) (print inside) (print incons)))
              ok)))))

  (fn ends-with-line ((arena Arena) (text String) (line String))
    (@intent "Is line the text's last line?")
    (@spec ((Arena String String) -> Bool))
    (@alloc arena)
    (let ((n (string-len text)) (m (string-len line)))
      (and (>= n (+ m 1))
           (string-eq (substring arena text (cast (Int 0 ..) (- n (+ m 1))) (cast (Int 0 ..) m)) line))))

  (fn gate-omissions-of-ttl ((arena Arena) (ttl String))
    (@intent "Gate an inline Turtle document and count its omissions")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (gate-ttl arena ttl)
      ((none)    -1)
      ((some gr) (cast Int (list-len (. gr omissions))))))

  (fn gate-accepted-of-ttl ((arena Arena) (ttl String))
    (@intent "Gate an inline Turtle document; its accepted axioms' renderings, one per line")
    (@spec ((Arena String) -> String))
    (@alloc arena)
    (match (gate-ttl arena ttl)
      ((none) "<did not gate>")
      ((some gr)
        (let ((mut out ""))
          (do
            (for-each (ax (. gr accepted))
              (set! out (string-concat arena out
                          (string-concat arena (render-axiom arena ax) "\n"))))
            out)))))

  (fn rc-prefix ()
    (@intent "The shared prefix block for the range-condition table")
    (@spec (() -> String))
    (@pure)
    "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:r a owl:ObjectProperty . :s a owl:ObjectProperty . :t a owl:ObjectProperty .\n:u a owl:ObjectProperty . :s2 a owl:ObjectProperty . :p a owl:ObjectProperty .\n:q a owl:ObjectProperty .\n:Agent a owl:Class . :Person a owl:Class .\n")

  (fn test-range-composition-table ((arena Arena))
    (@intent "§5.2's twelve-row range/composition verdict table, row by row")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE PUBLISHED CONDITION, ROW BY ROW. Row 3 is the one that
    ;; matters: a SUBCLASS range is rejected ON PURPOSE, and it is
    ;; exactly the case a well-meaning implementer admits because the
    ;; semantics seem to permit it. Admitting it silently leaves the
    ;; cited completeness proof behind — the citation stops covering
    ;; what the engine does.
    (let ((pre (rc-prefix))
          (mut ok true))
      (do
        ;; 1. range(s) = range(t) = Agent — the same expression on rₙ
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :s rdfs:range :Agent . :t rdfs:range :Agent .")) 0)
          (do (println "  [range] row 1 should be ACCEPTED") (set! ok false)))

        ;; 2. inherited through the told role hierarchy
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:range :Agent . :s rdfs:subPropertyOf :s2 . :s2 rdfs:range :Agent .")) 0)
          (do (println "  [range] row 2 should be ACCEPTED") (set! ok false)))

        ;; 3. a SUBCLASS range is NOT the published condition
        (when (< (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :s rdfs:range :Person . :t rdfs:range :Agent . :Person rdfs:subClassOf :Agent .")) 1)
          (do (println "  [range] row 3 should be REJECTED (subclass range)") (set! ok false)))

        ;; 4. nothing constrains the composed target
        (when (< (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:range :Agent .")) 1)
          (do (println "  [range] row 4 should be REJECTED (no range on s)") (set! ok false)))

        ;; 5. t INHERITS a range, so s must carry it too — the one-sided
        ;;    formula wrongly accepts this
        (when (< (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:subPropertyOf :u . :u rdfs:range :Agent .")) 1)
          (do (println "  [range] row 5 should be REJECTED (inherited range on t)") (set! ok false)))

        ;; 6. t imposes nothing to violate
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) .")) 0)
          (do (println "  [range] row 6 should be ACCEPTED (no range on t)") (set! ok false)))

        ;; 7. role HIERARCHY is unaffected; only composition shares a target
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":r rdfs:subPropertyOf :s . :r rdfs:range :Person . :s rdfs:range :Agent .")) 0)
          (do (println "  [range] row 7 should be ACCEPTED (plain subproperty)") (set! ok false)))

        ;; 8. only rₙ is consulted; intermediate roles are not
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :p :q :s ) . :t rdfs:range :Agent . :s rdfs:range :Agent .")) 0)
          (do (println "  [range] row 8 should be ACCEPTED (n-ary, last role carries it)") (set! ok false)))

        ;; 9–12: A NEGATIVE RANGE IMPOSES NOTHING. The gate judges the
        ;; theory after the negation rewrite, where ran(t) = C ⊓ ¬B is
        ;; ran(t) = C plus the GCI ∃t.B ⊑ ⊥, and only C is a range.

        ;; 9. the positive part is shared, so the chain is accepted
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:range [ owl:intersectionOf ( :Agent [ owl:complementOf :Person ] ) ] . :s rdfs:range :Agent .")) 0)
          (do (println "  [range] row 9 should be ACCEPTED (only the positive part is imposed)") (set! ok false)))

        ;; 10. the positive part is still imposed
        (when (< (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:range [ owl:intersectionOf ( :Agent [ owl:complementOf :Person ] ) ] .")) 1)
          (do (println "  [range] row 10 should be REJECTED (positive part not on s)") (set! ok false)))

        ;; 11. a purely negative range imposes nothing at all
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:range [ owl:complementOf :Person ] .")) 0)
          (do (println "  [range] row 11 should be ACCEPTED (negative range only)") (set! ok false)))

        ;; 12. a range the rewrite cannot take is omitted AS WRITTEN and
        ;;     keeps imposing its whole filler, so the chain goes too
        (when (!= (gate-omissions-of-ttl arena (string-concat arena pre
                    ":t owl:propertyChainAxiom ( :r :s ) . :t rdfs:range [ owl:intersectionOf ( :Agent [ owl:complementOf [ owl:unionOf ( :Agent :Person ) ] ] ) ] . :s rdfs:range :Agent .")) 2)
          (do (println "  [range] row 12 should omit the range AND the chain") (set! ok false)))
        ok)))

  ;; ============================================================
  ;; The el++ gate (§5.4): each construct under both rungs
  ;; ============================================================

  (fn rung-prefix ()
    (@intent "The shared prefix block for the two-rung gate table")
    (@spec (() -> String))
    (@pure)
    "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:r a owl:ObjectProperty . :s a owl:ObjectProperty . :t a owl:ObjectProperty .\n:C a owl:Class . :D a owl:Class .\n:a a owl:NamedIndividual . :b a owl:NamedIndividual .\n")

  (fn omissions-under ((arena Arena) (ttl String) (p Profile))
    (@intent "Omissions of an inline document gated under a rung, or -1 if it did not gate")
    (@spec ((Arena String Profile) -> Int))
    (@alloc arena)
    (match (gate-ttl-in arena ttl p)
      ((none)    -1)
      ((some gr) (cast Int (list-len (. gr omissions))))))

  (fn accepted-under ((arena Arena) (ttl String) (p Profile))
    (@intent "Axioms an inline document keeps under a rung, or -1 if it did not gate")
    (@spec ((Arena String Profile) -> Int))
    (@alloc arena)
    (match (gate-ttl-in arena ttl p)
      ((none)    -1)
      ((some gr) (cast Int (list-len (. gr accepted))))))

  (fn gate-alike-under ((arena Arena) (label String) (a String) (b String) (p Profile))
    (@intent "Do two documents keep and omit the same number of axioms under a rung?")
    (@spec ((Arena String String String Profile) -> Bool))
    (@alloc arena)
    (let ((ka (accepted-under arena a p)) (kb (accepted-under arena b p))
          (oa (omissions-under arena a p)) (ob (omissions-under arena b p)))
      (if (and (>= ka 0) (and (== ka kb) (== oa ob)))
        true
        (do
          (println (string-concat arena "  [rungs] " label))
          (print "    kept ") (print (int-to-string arena ka)) (print " vs ") (println (int-to-string arena kb))
          (print "    omitted ") (print (int-to-string arena oa)) (print " vs ") (println (int-to-string arena ob))
          false))))

  (fn rungs-gate-alike ((arena Arena) (label String) (ttl-a String) (ttl-b String))
    (@intent "Do two documents keep and omit the same number of axioms, under el and under el++?")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (let ((a (string-concat arena (rung-prefix) ttl-a))
          (b (string-concat arena (rung-prefix) ttl-b)))
      (and (gate-alike-under arena label a b 'profile-el)
           (gate-alike-under arena label a b 'profile-el-plus-plus))))

  (fn rungs-omit ((arena Arena) (label String) (ttl String) (el-want Int) (elpp-want Int))
    (@intent "Does the gate omit exactly this many axioms under el and under el++?")
    (@spec ((Arena String String Int Int) -> Bool))
    (@alloc arena)
    (let ((doc (string-concat arena (rung-prefix) ttl)))
      (let ((el (omissions-under arena doc 'profile-el))
            (pp (omissions-under arena doc 'profile-el-plus-plus)))
        (if (and (== el el-want) (== pp elpp-want))
          true
          (do
            (println (string-concat arena "  [rungs] " label))
            (print "    el omitted ") (println (int-to-string arena el))
            (print "    el++ omitted ") (println (int-to-string arena pp))
            false)))))

  (fn test-data-lemma ((arena Arena))
    (@intent "§5.2's data lemma: idle data properties' axioms are inert in both rungs, and nothing else is")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Each row's count is the omissions under el and under el++. The
    ;; lemma is decided before the gate, so the two always agree. The rows
    ;; that keep omissions are the ones a wrong lemma would set aside:
    ;; a property used below (the hierarchy runs UP), a disjointness
    ;; between used properties, a domain on owl:topDataProperty.
    (and
      (rungs-omit arena "idle: domain, range, functionality"
        ":d a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :C ; rdfs:range <http://www.w3.org/2001/XMLSchema#integer> ." 0 0)
      (rungs-omit arena "idle: sub-property, equivalence, disjointness"
        ":d a owl:DatatypeProperty . :e a owl:DatatypeProperty . :f a owl:DatatypeProperty .\n:d rdfs:subPropertyOf :e ; owl:equivalentProperty :f . :e owl:propertyDisjointWith :f ." 0 0)
      (rungs-omit arena "used in an assertion: domain and assertion omitted"
        ":d a owl:DatatypeProperty ; rdfs:domain :C . :a :d 1 ." 2 2)
      (rungs-omit arena "used below: the super-property is not idle"
        ":p a owl:DatatypeProperty ; rdfs:domain :C .\n:q a owl:DatatypeProperty ; rdfs:subPropertyOf :p . :a :q 1 ." 3 3)
      (rungs-omit arena "used in a restriction: the range stays"
        ":d a owl:DatatypeProperty ; rdfs:range <http://www.w3.org/2001/XMLSchema#integer> .\n:C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :d ; owl:someValuesFrom <http://www.w3.org/2001/XMLSchema#integer> ] ." 2 2)
      (rungs-omit arena "disjointness: an idle member suffices, two used ones do not"
        ":u a owl:DatatypeProperty . :v a owl:DatatypeProperty . :i a owl:DatatypeProperty .\n:u owl:propertyDisjointWith :i . :u owl:propertyDisjointWith :v . :a :u 1 ; :v 2 ." 3 3)
      (rungs-omit arena "a DatatypeRestriction range goes with its axiom"
        ":d a owl:DatatypeProperty ; rdfs:range [ a <http://www.w3.org/2000/01/rdf-schema#Datatype> ; owl:onDatatype <http://www.w3.org/2001/XMLSchema#short> ; owl:withRestrictions ( [ <http://www.w3.org/2001/XMLSchema#minInclusive> 0 ] ) ] ." 0 0)
      (rungs-omit arena "a sub-property of owl:topDataProperty is a tautology"
        ":d a owl:DatatypeProperty ; rdfs:subPropertyOf owl:topDataProperty ." 0 0)
      (rungs-omit arena "a domain on owl:topDataProperty stays"
        "owl:topDataProperty rdfs:domain :C ." 1 1)
      ;; Declared, the built-in is among the data properties idleness is
      ;; read over: only its standing use keeps it from being idle.
      (rungs-omit arena "a declared owl:topDataProperty is still never idle"
        "owl:topDataProperty a owl:DatatypeProperty ; rdfs:domain :C ." 1 1)
      (rungs-omit arena "a disjointness with owl:topDataProperty stays"
        ":d a owl:DatatypeProperty ; owl:propertyDisjointWith owl:topDataProperty ." 1 1)
      (rungs-omit arena "an axiom annotation is not a use (RO annotates RO_0002029's range)"
        ":d a owl:DatatypeProperty ; rdfs:range <http://www.w3.org/2001/XMLSchema#integer> .\n[ a owl:Axiom ; owl:annotatedSource :d ; owl:annotatedProperty rdfs:range ; owl:annotatedTarget <http://www.w3.org/2001/XMLSchema#integer> ; rdfs:comment \"why\" ] ." 0 0)
      (rungs-omit arena "a filler shared with its own reification still goes with its axiom"
        ":d a owl:DatatypeProperty ; rdfs:range _:x .\n_:x a <http://www.w3.org/2000/01/rdf-schema#Datatype> ; owl:onDatatype <http://www.w3.org/2001/XMLSchema#short> ; owl:withRestrictions ( [ <http://www.w3.org/2001/XMLSchema#minInclusive> 0 ] ) .\n[ a owl:Axiom ; owl:annotatedSource :d ; owl:annotatedProperty rdfs:range ; owl:annotatedTarget _:x ; rdfs:comment \"why\" ] ." 0 0)
      (rungs-omit arena "a reified-only assertion is a use: it is rebuilt before the lemma"
        ":d a owl:DatatypeProperty ; rdfs:domain :C .\n[ a owl:Axiom ; owl:annotatedSource :a ; owl:annotatedProperty :d ; owl:annotatedTarget \"x\" ] ." 2 2)
      ;; The tree takes a filler's internals only. A domain filler that also
      ;; heads a GCI keeps its structure for it, so the document gates as
      ;; it does without the idle domain. Consuming the filler whole
      ;; dropped the GCI with no omission (Codex, slice 3 review).
      ;; Only a well-shaped data range goes: a malformed one decodes as
      ;; today (Codex, slice 3 re-review).
      (rungs-omit arena "owl:withRestrictions without owl:onDatatype is not swallowed"
        ":d a owl:DatatypeProperty ; rdfs:domain _:x .\n_:x a owl:Class ; owl:withRestrictions ( [ <http://www.w3.org/2001/XMLSchema#minInclusive> 0 ] ) ." 2 2)
      (rungs-omit arena "a facet node with a second triple is not swallowed"
        ":d a owl:DatatypeProperty ; rdfs:range [ a <http://www.w3.org/2000/01/rdf-schema#Datatype> ; owl:onDatatype <http://www.w3.org/2001/XMLSchema#short> ; owl:withRestrictions ( [ <http://www.w3.org/2001/XMLSchema#minInclusive> 0 ; owl:someValuesFrom :C ] ) ] ." 1 1)
      (rungs-omit arena "a reified-only declaration declares: stage 0 rebuilds it"
        "[ a owl:Axiom ; owl:annotatedSource :d ; owl:annotatedProperty <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; owl:annotatedTarget owl:DatatypeProperty ] .\n:d rdfs:range <http://www.w3.org/2001/XMLSchema#integer> ." 0 0)
      (rungs-gate-alike arena "a filler that heads an axiom keeps it"
        ":d a owl:DatatypeProperty ; rdfs:domain _:x .\n_:x owl:intersectionOf ( :C :D ) ; rdfs:subClassOf owl:Nothing ."
        ":d a owl:DatatypeProperty .\n[ owl:intersectionOf ( :C :D ) ] rdfs:subClassOf owl:Nothing .")))

  ;; ============================================================
  ;; sriq slice 4a: every ObjectInverseOf decodes whole, and data is data
  ;; ============================================================

  (fn inv-decls ()
    (@intent "Declarations for the inverse and data decode rows, after eq-prefix")
    (@spec (() -> String))
    (@pure)
    "@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:p a owl:ObjectProperty . :q a owl:ObjectProperty . :s a owl:ObjectProperty .\n:A a owl:Class . :B a owl:Class . :C a owl:Class .\n:d a owl:DatatypeProperty . :e a owl:DatatypeProperty .\n")

  (fn test-inverses-decode-whole ((arena Arena))
    (@intent "ObjectInverseOf decodes in every property position, and el/el++ omit it as written")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Before RoleId had an inverse arm, each of these was an opaque
    ;; N-Triples fragment (or, in a restriction, one constant string for
    ;; every inverse restriction). Now each renders as the axiom it is.
    (and
      (omits-exactly arena "an inverse sub-property"
        (string-concat arena (inv-decls) ":q rdfs:subPropertyOf [ owl:inverseOf :p ] .")
        "SubObjectPropertyOf(http://example.org/t#q ObjectInverseOf(http://example.org/t#p))\n")
      (omits-exactly arena "an inverse chain step"
        (string-concat arena (inv-decls) ":s owl:propertyChainAxiom ( [ owl:inverseOf :p ] :q ) .")
        "SubObjectPropertyOf(ObjectPropertyChain(ObjectInverseOf(http://example.org/t#p) http://example.org/t#q) http://example.org/t#s)\n")
      (omits-exactly arena "two restrictions on inverses stay apart"
        (string-concat arena (inv-decls) ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :p ] ; owl:someValuesFrom :B ] .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :q ] ; owl:allValuesFrom :C ] .")
        "SubClassOf(http://example.org/t#A ObjectAllValuesFrom(ObjectInverseOf(http://example.org/t#q) http://example.org/t#C))\nSubClassOf(http://example.org/t#A ObjectSomeValuesFrom(ObjectInverseOf(http://example.org/t#p) http://example.org/t#B))\n")
      (omits-exactly arena "an inverse's domain"
        (string-concat arena (inv-decls) "[ owl:inverseOf :p ] rdfs:domain :A .")
        "ObjectPropertyDomain(ObjectInverseOf(http://example.org/t#p) http://example.org/t#A)\n")
      (omits-exactly arena "an inverse's characteristic"
        (string-concat arena (inv-decls) "[ owl:inverseOf :q ] a owl:FunctionalProperty .")
        "FunctionalObjectProperty(ObjectInverseOf(http://example.org/t#q))\n")
      (omits-exactly arena "an inverse of an inverse expression"
        (string-concat arena (inv-decls) ":p owl:inverseOf [ owl:inverseOf :q ] .")
        "InverseObjectProperties(http://example.org/t#p ObjectInverseOf(http://example.org/t#q))\n")
      (omits-exactly arena "a negative assertion on an inverse"
        (string-concat arena (inv-decls) "[ a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty [ owl:inverseOf :p ] ; owl:targetIndividual :b ] .")
        "NegativeObjectPropertyAssertion(ObjectInverseOf(http://example.org/t#p) http://example.org/t#a http://example.org/t#b)\n")
      (omits-exactly arena "disjoint properties with an inverse member"
        (string-concat arena (inv-decls) "[ a owl:AllDisjointProperties ; owl:members ( :p [ owl:inverseOf :q ] ) ] .")
        "DisjointObjectProperties(http://example.org/t#p ObjectInverseOf(http://example.org/t#q))\n")
      (omits-exactly arena "a disjoint union, read whole"
        (string-concat arena (inv-decls) ":C owl:disjointUnionOf ( :A :B ) .")
        "DisjointUnion(http://example.org/t#C http://example.org/t#A http://example.org/t#B)\n")
      ;; `_:x owl:inverseOf :r , :s` makes no ObjectInverseOf, and no axiom
      ;; can read it. It was dropped with no omission, and the document
      ;; came out coherent; each triple is now an omission.
      (rungs-omit arena "an ambiguous inverse node is two omissions, not a silent drop"
        "_:x owl:inverseOf :r , :s ." 2 2)
      ;; An inverse-bearing RIA is omitted alone. Seen by el's §11.2
      ;; check, `s ∘ r⁻ ⊑ t` with `t ⊑ s` is a hierarchy violation, and
      ;; the whole RBox, `t ⊑ s` included, would be omitted with it.
      ;; el++ drops `R ⊑ owl:topObjectProperty` for its own roles only; an
      ;; inverse there is outside its language and omitted as written.
      ;; An equivalence with an inverse is omitted whole, as written; its
      ;; star split it, and an equivalence of one inverse with itself had
      ;; no pieces at all.
      (omits-exactly arena "an equivalence with an inverse, whole"
        (string-concat arena (inv-decls) ":p owl:equivalentProperty [ owl:inverseOf :q ] .")
        "EquivalentObjectProperties(http://example.org/t#p ObjectInverseOf(http://example.org/t#q))\n")
      (rungs-omit arena "an inverse equivalent to itself is an omission, not a silent drop"
        "_:x owl:inverseOf :r ; owl:equivalentProperty _:x ." 1 1)
      (rungs-omit arena "an inverse into the universal role is omitted, not dropped"
        "[ owl:inverseOf :r ] rdfs:subPropertyOf owl:topObjectProperty ." 1 1)
      (rungs-omit arena "an inverse chain never reaches el's regularity check"
        ":t rdfs:subPropertyOf :s . :t owl:propertyChainAxiom ( :s [ owl:inverseOf :r ] ) ." 1 1)))

  (fn test-data-constructs-decode-as-data ((arena Arena))
    (@intent "A data restriction or data property axiom decodes as data, never as its object twin")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; DataSomeValuesFrom read as rc-some was ACCEPTED by el and el++, its
    ;; datatype taken for a class; EquivalentDataProperties was accepted
    ;; as role inclusions; owl:onDataRange and owl:onProperties faulted
    ;; the whole document.
    (and
      (omits-exactly arena "DataSomeValuesFrom"
        (string-concat arena (inv-decls) ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :d ; owl:someValuesFrom xsd:integer ] .")
        "SubClassOf(http://example.org/t#A DataRange(DataSomeValuesFrom(http://example.org/t#d http://www.w3.org/2001/XMLSchema#integer)))\n")
      (omits-exactly arena "DataAllValuesFrom"
        (string-concat arena (inv-decls) ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :d ; owl:allValuesFrom xsd:integer ] .")
        "SubClassOf(http://example.org/t#A DataRange(DataAllValuesFrom(http://example.org/t#d http://www.w3.org/2001/XMLSchema#integer)))\n")
      (omits-exactly arena "a data cardinality"
        (string-concat arena (inv-decls) ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :d ; owl:maxCardinality 1 ] .")
        "SubClassOf(http://example.org/t#A DataRange(DataMaxCardinality(http://example.org/t#d \"1\")))\n")
      (omits-exactly arena "owl:onDataRange is data, not a fault"
        (string-concat arena (inv-decls) ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :e ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] .")
        "SubClassOf(http://example.org/t#A DataRange(DataMinCardinality(http://example.org/t#e \"1\")))\n")
      ;; Its owl:onProperties triple is not structural, so it also stays
      ;; an omission of its own; two such restrictions stay apart.
      (rungs-omit arena "owl:onProperties is data, not a fault"
        ":d a owl:DatatypeProperty . :e a owl:DatatypeProperty .\n:C rdfs:subClassOf [ a owl:Restriction ; owl:onProperties ( :d ) ; owl:someValuesFrom <http://www.w3.org/2001/XMLSchema#integer> ] .\n:D rdfs:subClassOf [ a owl:Restriction ; owl:onProperties ( :e ) ; owl:allValuesFrom <http://www.w3.org/2001/XMLSchema#integer> ] ." 4 4)
      (rungs-omit arena "a stray owl:onProperties is an omission, not a silent drop"
        "_:x owl:onProperties ( :r ) ." 1 1)
      (rungs-omit arena "a disjoint union with no member list is an omission, not a fault"
        ":C owl:disjointUnionOf _:missing ." 1 1)
      (rungs-omit arena "FunctionalDataProperty on a used property is data"
        ":d a owl:DatatypeProperty , owl:FunctionalProperty . :a :d 1 ." 2 2)
      (rungs-omit arena "EquivalentDataProperties is data, not role inclusions"
        ":d a owl:DatatypeProperty . :e a owl:DatatypeProperty . :d owl:equivalentProperty :e . :a :d 1 ." 2 2)
      (rungs-omit arena "a negative assertion on a data property is data"
        ":d a owl:DatatypeProperty . :a :d 1 .\n[ a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :d ; owl:targetIndividual :b ] ." 2 2)
      (rungs-omit arena "DisjointDataProperties on used properties is data"
        ":d a owl:DatatypeProperty . :e a owl:DatatypeProperty .\n[ a owl:AllDisjointProperties ; owl:members ( :d :e ) ] . :a :d 1 ; :e 2 ." 3 3)))

  (fn test-concept-order-is-total ((arena Arena))
    (@intent "concept-cmp orders number restrictions and nominals by every payload")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; They tied before, so their order was input order; sriq admits them.
    (let ((r (union-new RoleId named-role (record-new IRI (value "http://example.org/t#r"))))
          (s (union-new RoleId named-role (record-new IRI (value "http://example.org/t#s"))))
          (a (union-new Node individual-node (record-new IRI (value "http://example.org/t#a"))))
          (b (union-new Node individual-node (record-new IRI (value "http://example.org/t#b"))))
          (c (union-new RawConcept rc-name (union-new Node class-node (record-new IRI (value "http://example.org/t#C")))))
          (d (union-new RawConcept rc-name (union-new Node class-node (record-new IRI (value "http://example.org/t#D")))))
          (mut na (list-new arena Node))
          (mut nb (list-new arena Node)))
      (do
        (list-push na a) (list-push nb a) (list-push nb b)
        (and
          (< (concept-cmp (union-new RawConcept rc-card 'card-min r 1) (union-new RawConcept rc-card 'card-min r 2)) 0)
          (< (concept-cmp (union-new RawConcept rc-card 'card-min r 2) (union-new RawConcept rc-card 'card-max r 1)) 0)
          (< (concept-cmp (union-new RawConcept rc-card 'card-min r 1) (union-new RawConcept rc-card 'card-min s 1)) 0)
          (< (concept-cmp (union-new RawConcept rc-qcard 'card-max r 1 (box-test-concept arena c))
                          (union-new RawConcept rc-qcard 'card-max r 1 (box-test-concept arena d))) 0)
          (== (concept-cmp (union-new RawConcept rc-qcard 'card-max r 1 (box-test-concept arena c))
                           (union-new RawConcept rc-qcard 'card-max r 1 (box-test-concept arena c))) 0)
          (< (concept-cmp (union-new RawConcept rc-oneof na) (union-new RawConcept rc-oneof nb)) 0)
          (> (concept-cmp (union-new RawConcept rc-oneof nb) (union-new RawConcept rc-oneof na)) 0)))))

  (fn box-test-concept ((arena Arena) (c RawConcept))
    (@intent "c, boxed for a test's concept payload")
    (@spec ((Arena RawConcept) -> (Ptr RawConcept)))
    (@alloc arena)
    (let ((p (cast (Ptr RawConcept) (arena-alloc arena (sizeof RawConcept)))))
      (do (set! (deref p) c) p)))

  (fn rungs3-omit ((arena Arena) (label String) (ttl String) (el-want Int) (elpp-want Int) (sriq-want Int))
    (@intent "Does the gate omit exactly this many axioms under el, el++ and sriq?")
    (@spec ((Arena String String Int Int Int) -> Bool))
    (@alloc arena)
    (let ((doc (string-concat arena (rung-prefix) ttl)))
      (let ((el (omissions-under arena doc 'profile-el))
            (pp (omissions-under arena doc 'profile-el-plus-plus))
            (sq (omissions-under arena doc 'profile-sriq)))
        (if (and (== el el-want) (and (== pp elpp-want) (== sq sriq-want)))
          true
          (do
            (println (string-concat arena "  [rungs3] " label))
            (print "    el ") (print (int-to-string arena el))
            (print "  el++ ") (print (int-to-string arena pp))
            (print "  sriq ") (println (int-to-string arena sq))
            false)))))

  ;; ============================================================
  ;; sriq slice 5b: S0, the collapse, and S1's hook
  ;; ============================================================

  (fn s0-prefix ()
    (@intent "The prefix block for the S0 rows: short IRIs, so the expected text stays readable")
    (@spec (() -> String))
    (@pure)
    "@prefix : <urn:x:> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:A a owl:Class . :B a owl:Class . :C a owl:Class .\n:r a owl:ObjectProperty . :s a owl:ObjectProperty . :t a owl:ObjectProperty .\n:a a owl:NamedIndividual . :b a owl:NamedIndividual .\n")

  (fn render-saxioms ((arena Arena) (axs (List SAxiom)))
    (@intent "One axiom per line")
    (@spec ((Arena (List SAxiom)) -> String))
    (@alloc arena)
    (let ((mut out ""))
      (do
        (for-each (a axs)
          (set! out (string-concat arena out (string-concat arena (render-saxiom arena a) "\n"))))
        out)))

  (fn s0-of ((arena Arena) (ttl String) (through-s1 Bool))
    (@intent "S0's axioms for an inline document gated under sriq, after S1's hook when asked")
    (@spec ((Arena String Bool) -> String))
    (@alloc arena)
    (match (gate-ttl-in arena (string-concat arena (s0-prefix) ttl) 'profile-sriq)
      ((none) "did not gate\n")
      ((some gr)
        (let ((om (cast Int (list-len (. gr omissions))))
              (lead (if (> (cast Int (list-len (. gr omissions))) 0)
                      (string-concat arena "omitted " (string-concat arena (int-to-string arena om) "\n"))
                      "")))
          (match (sriq-s0 arena (. gr accepted))
            ((error m) (string-concat arena lead (string-concat arena "refused: " (string-concat arena m "\n"))))
            ((ok s0)
              (if through-s1
                (match (sriq-s1 arena s0 S1_BOUND)
                  ((error m) (string-concat arena lead (string-concat arena "refused: " (string-concat arena m "\n"))))
                  ((ok s1)   (string-concat arena lead (render-saxioms arena (. s1 axioms)))))
                (string-concat arena lead (render-saxioms arena (. s0 axioms))))))))))

  (fn s0-is ((arena Arena) (label String) (ttl String) (want String))
    (@intent "Does S0 give exactly these axioms? Prints what it got when not")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (let ((got (s0-of arena ttl false)))
      (if (== (string-cmp got want) 0)
        true
        (do
          (println (string-concat arena "  [s0] " label))
          (print got)
          false))))

  (fn s1-is ((arena Arena) (label String) (ttl String) (want String))
    (@intent "Does S0 then S1's hook give exactly this? Prints what it got when not")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (let ((got (s0-of arena ttl true)))
      (if (== (string-cmp got want) 0)
        true
        (do
          (println (string-concat arena "  [s1] " label))
          (print got)
          false))))

  (fn test-sriq-s0-rows ((arena Arena))
    (@intent "§5.5 S0, row by row: the language table, the collapse, the canonical forms, S1's hook")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (when (not (s0-is arena "subclass"
                     ":A rdfs:subClassOf :B ."
                     "urn:x:A ⊑ urn:x:B\n"))
          (set! ok false))
        (when (not (s0-is arena "domain"
                     ":r rdfs:domain :A ."
                     "∃urn:x:r.⊤ ⊑ urn:x:A\n"))
          (set! ok false))
        (when (not (s0-is arena "range"
                     ":r rdfs:range :A ."
                     "⊤ ⊑ ∀urn:x:r.urn:x:A\n"))
          (set! ok false))
        (when (not (s0-is arena "union and complement"
                     ":A rdfs:subClassOf [ owl:unionOf ( :B [ owl:complementOf :C ] ) ] ."
                     "urn:x:A ⊑ (urn:x:B ⊔ ¬urn:x:C)\n"))
          (set! ok false))
        (when (not (s0-is arena "ACI: a nested, repeated, reordered conjunction"
                     ":A rdfs:subClassOf [ owl:intersectionOf ( :C [ owl:intersectionOf ( :B :C ) ] ) ] ."
                     "urn:x:A ⊑ (urn:x:B ⊓ urn:x:C)\n"))
          (set! ok false))
        (when (not (s0-is arena "a unit: C or bottom is C"
                     ":A rdfs:subClassOf [ owl:unionOf ( :B owl:Nothing ) ] ."
                     "urn:x:A ⊑ urn:x:B\n"))
          (set! ok false))
        (when (not (s0-is arena "a unit: C and top is C"
                     ":A rdfs:subClassOf [ owl:intersectionOf ( :B owl:Thing ) ] ."
                     "urn:x:A ⊑ urn:x:B\n"))
          (set! ok false))
        (when (not (s0-is arena "a zero: C or top is top"
                     ":A rdfs:subClassOf [ owl:unionOf ( :B owl:Thing ) ] ."
                     "urn:x:A ⊑ ⊤\n"))
          (set! ok false))
        (when (not (s0-is arena "qualified >=1 is exists"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:minQualifiedCardinality 1 ; owl:onClass :B ] ."
                     "urn:x:A ⊑ ∃urn:x:r.urn:x:B\n"))
          (set! ok false))
        (when (not (s0-is arena "exact 2 is >=2 and <=2"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:qualifiedCardinality 2 ; owl:onClass :B ] ."
                     "urn:x:A ⊑ (≥2 urn:x:r.urn:x:B ⊓ ≤2 urn:x:r.urn:x:B)\n"))
          (set! ok false))
        (when (not (s0-is arena "unqualified is qualified by top"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxCardinality 3 ] ."
                     "urn:x:A ⊑ ≤3 urn:x:r.⊤\n"))
          (set! ok false))
        (when (not (s0-is arena "Self on an inverse is Self on the property"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :r ] ; owl:hasSelf true ] ."
                     "urn:x:A ⊑ ∃urn:x:r.Self\n"))
          (set! ok false))
        (when (not (s0-is arena "DisjointClasses"
                     ":A owl:disjointWith :B ."
                     "(urn:x:A ⊓ urn:x:B) ⊑ ⊥\n"))
          (set! ok false))
        (when (not (s0-is arena "DisjointUnion"
                     ":C owl:disjointUnionOf ( :A :B ) ."
                     "urn:x:C ⊑ (urn:x:A ⊔ urn:x:B)\n(urn:x:A ⊓ urn:x:B) ⊑ ⊥\n(urn:x:A ⊔ urn:x:B) ⊑ urn:x:C\n"))
          (set! ok false))
        (when (not (s0-is arena "characteristics"
                     ":r a owl:FunctionalProperty , owl:InverseFunctionalProperty , owl:ReflexiveProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ."
                     "⊤ ⊑ ≤1 urn:x:r.⊤\n⊤ ⊑ ≤1 urn:x:r⁻.⊤\nRef(urn:x:r)\nIrr(urn:x:r)\nDis(urn:x:r, urn:x:r⁻)\n"))
          (set! ok false))
        (when (not (s0-is arena "DisjointObjectProperties"
                     ":r owl:propertyDisjointWith :s ."
                     "Dis(urn:x:r, urn:x:s)\n"))
          (set! ok false))
        (when (not (s0-is arena "ClassAssertion"
                     ":a a [ owl:unionOf ( :A :B ) ] ."
                     "{urn:x:a} ⊑ (urn:x:A ⊔ urn:x:B)\n"))
          (set! ok false))
        (when (not (s0-is arena "ObjectPropertyAssertion"
                     ":a :r :b ."
                     "{urn:x:a} ⊑ ∃urn:x:r.{urn:x:b}\n"))
          (set! ok false))
        (when (not (s0-is arena "NegativeObjectPropertyAssertion"
                     "[ a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ] ."
                     "{urn:x:a} ⊑ ∀urn:x:r.¬{urn:x:b}\n"))
          (set! ok false))
        (when (not (s0-is arena "SameIndividual around the least member"
                     ":b owl:sameAs :a ."
                     "{urn:x:a} ⊑ {urn:x:b}\n{urn:x:b} ⊑ {urn:x:a}\n"))
          (set! ok false))
        (when (not (s0-is arena "DifferentIndividuals"
                     ":a owl:differentFrom :b ."
                     "({urn:x:a} ⊓ {urn:x:b}) ⊑ ⊥\n"))
          (set! ok false))
        (when (not (s0-is arena "InverseObjectProperties collapses to nothing"
                     ":r owl:inverseOf :s .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s ; owl:someValuesFrom :B ] ."
                     "urn:x:A ⊑ ∃urn:x:r⁻.urn:x:B\n"))
          (set! ok false))
        (when (not (s0-is arena "an equivalence with an inverse collapses"
                     ":r owl:equivalentProperty [ owl:inverseOf :s ] .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s ; owl:someValuesFrom :B ] ."
                     "urn:x:A ⊑ ∃urn:x:r⁻.urn:x:B\n"))
          (set! ok false))
        (when (not (s0-is arena "P and P- in one component keep P- [= P"
                     ":r owl:inverseOf :r ."
                     "urn:x:r⁻ ⊑ urn:x:r\n"))
          (set! ok false))
        (when (not (s0-is arena "symmetry is P- [= P"
                     ":r a owl:SymmetricProperty ."
                     "urn:x:r⁻ ⊑ urn:x:r\n"))
          (set! ok false))
        (when (not (s0-is arena "RO's part_of/has_part: transitivity in both orientations"
                     ":r a owl:TransitiveProperty . :s a owl:TransitiveProperty . :r owl:inverseOf :s ."
                     "urn:x:r ∘ urn:x:r ⊑ urn:x:r\nurn:x:r⁻ ∘ urn:x:r⁻ ⊑ urn:x:r⁻\n"))
          (set! ok false))
        (when (not (s0-is arena "a simple role hierarchy"
                     ":r rdfs:subPropertyOf :s . :s rdfs:subPropertyOf :t ."
                     "urn:x:r ⊑ urn:x:s\nurn:x:s ⊑ urn:x:t\n"))
          (set! ok false))
        (when (not (s0-is arena "the empty role"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty owl:bottomObjectProperty ; owl:someValuesFrom :B ] ."
                     "urn:x:A ⊑ ∃http://www.w3.org/2002/07/owl#bottomObjectProperty.urn:x:B\n∃http://www.w3.org/2002/07/owl#bottomObjectProperty.⊤ ⊑ ⊥\n"))
          (set! ok false))
        (when (not (s1-is arena "S1's hook passes a chain-free RBox"
                     ":r rdfs:subPropertyOf :s .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] ."
                     "urn:x:A ⊑ ∃urn:x:r.urn:x:B\nurn:x:r ⊑ urn:x:s\n"))
          (set! ok false))
        (when (not (s1-is arena "transitivity alone is eliminated: nothing is left"
                     ":r a owl:TransitiveProperty ."
                     ""))
          (set! ok false))
        ok)))

  (fn sort-strings ((arena Arena) (xs (List String)))
    (@intent "Lexicographically sorted copy")
    (@spec ((Arena (List String)) -> (List String)))
    (@alloc arena)
    (let ((idx (sort-range arena (cast Int (list-len xs))
                 (fn ((i Int) (j Int)) (string-cmp (str-at-t xs i) (str-at-t xs j)))))
          (mut out (list-new arena String)))
      (do (for-each (k idx) (list-push out (str-at-t xs k))) out)))

  (fn str-at-t ((xs (List String)) (i Int))
    (@intent "Element i, or empty")
    (@spec (((List String) Int) -> String))
    (@pure)
    (match (list-get xs i) ((some v) v) ((none) "")))

  (fn refusal-line ((arena Arena) (m String))
    (@intent "A refusal, as one line")
    (@spec ((Arena String) -> String))
    (@alloc arena)
    (string-concat arena "refused: " (string-concat arena m "\n")))

  (fn s2-text ((arena Arena) (r (Result S2 String)))
    (@intent "S2's clauses, one per line, sorted; or S2's error")
    (@spec ((Arena (Result S2 String)) -> String))
    (@alloc arena)
    (match r
      ((error m) (string-concat arena "S2 error: " (string-concat arena m "\n")))
      ((ok s2)
        (let ((mut ls (list-new arena String))
              (mut out ""))
          (do
            (for-each (c (. s2 clauses)) (list-push ls (render-dl arena s2 c)))
            (for-each (l (sort-strings arena ls)) (set! out (string-concat arena out (string-concat arena l "\n"))))
            out)))))

  (fn s2-after-s1 ((arena Arena) (r (Result S1 String)))
    (@intent "S2 over S1's output, or S1's refusal")
    (@spec ((Arena (Result S1 String)) -> String))
    (@alloc arena)
    (match r
      ((error m) (refusal-line arena m))
      ((ok s1)   (s2-text arena (sriq-s2 arena (. s1 axioms))))))

  (fn s2-after-s0 ((arena Arena) (r (Result S0 String)))
    (@intent "S1 then S2 over S0's output, or S0's refusal")
    (@spec ((Arena (Result S0 String)) -> String))
    (@alloc arena)
    (match r
      ((error m) (refusal-line arena m))
      ((ok s0)   (s2-after-s1 arena (sriq-s1 arena s0 S1_BOUND)))))

  (fn s2-of ((arena Arena) (ttl String))
    (@intent "S2's clauses for an inline document under sriq, one per line, sorted")
    (@spec ((Arena String) -> String))
    (@alloc arena)
    (match (gate-ttl-in arena (string-concat arena (s0-prefix) ttl) 'profile-sriq)
      ((none) "did not gate\n")
      ((some gr)
        (string-concat arena (if (> (cast Int (list-len (. gr omissions))) 0) "OMITTED\n" "")
                             (s2-after-s0 arena (sriq-s0 arena (. gr accepted)))))))

  (fn s2-is ((arena Arena) (label String) (ttl String) (want String))
    (@intent "Does S2 give exactly these clauses? Prints what it got when not")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (let ((got (s2-of arena ttl)))
      (if (== (string-cmp got want) 0)
        true
        (do
          (println (string-concat arena "  [s2] " label))
          (print got)
          false))))

  ;; ------------------------------------------------------------
  ;; 5d: ids from content (§5.5 S5). S2 mints names in first-occurrence
  ;; order; S5 renumbers every one by what it names. So reordering the
  ;; input anywhere — its triples, the gate's accepted list, or S2's own
  ;; input — must change no byte of the output, and the output must keep
  ;; S5's promises (sriq-invariants). Tracked fixtures only: `make test`
  ;; is what CI runs, and corpus/vendor/ is fetched locally (corpus/fetch.sh).
  ;; S1 mints names too, so its input is reversed as well.
  ;; ------------------------------------------------------------

  (fn sriq-fixtures ((arena Arena))
    (@intent "Tracked fixtures that between them mint every id kind S5 renumbers")
    (@spec ((Arena) -> (List String)))
    (@alloc arena)
    ;; A_E, P̄ and function symbols are everywhere; role-hierarchy-deep has
    ;; the most of each (21, 6, 9). S_{B₂} comes only from the two
    ;; out-of-profile cardinality fixtures.
    (let ((mut ps (list-new arena String)))
      (do
        (list-push ps "corpus/fixtures/v0/litmus.ttl")
        (list-push ps "corpus/fixtures/v0/negation-domain-range.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/inverse-expressions.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/property-characteristics.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/cardinality.ttl")
        (list-push ps "corpus/fixtures/hazards/range-complex-fillers.ttl")
        (list-push ps "corpus/fixtures/hazards/abox-disjoint-range.ttl")
        (list-push ps "corpus/fixtures/hazards/abox-complex-range.ttl")
        (list-push ps "corpus/fixtures/hazards/abox-nary-chain.ttl")
        (list-push ps "corpus/fixtures/hazards/smaller-side-join.ttl")
        (list-push ps "corpus/fixtures/hazards/role-hierarchy-deep.ttl")
        (list-push ps "corpus/fixtures/el++/ksc-22.ttl")
        (list-push ps "corpus/fixtures/el++/ksc-28.ttl")
        ;; Chains and transitivity, for S1 (slice 6d).
        (list-push ps "corpus/fixtures/v0/transitive.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push ps "corpus/fixtures/v0/negation-chain.ttl")
        (list-push ps "corpus/fixtures/probes/chain-binary.ttl")
        (list-push ps "corpus/fixtures/hazards/rbox-regularity-accept.ttl")
        (list-push ps "corpus/fixtures/hazards/chain-prefix-collision.ttl")
        (list-push ps "corpus/fixtures/hazards/abox-chain-mixed.ttl")
        (list-push ps "corpus/fixtures/el++/ksc-05.ttl")
        (list-push ps "corpus/fixtures/sriq/sim12-example1.ttl")
        (list-push ps "corpus/fixtures/sriq/symmetric.ttl")
        (list-push ps "corpus/fixtures/sriq/inverse-all.ttl")
        ps)))

  (fn gate-triples-in ((arena Arena) (ts (List Triple)) (p Profile))
    (@intent "Stage 0, decode and gate a triple list under a rung")
    (@spec ((Arena (List Triple) Profile) -> (Option GateResult)))
    (@alloc arena)
    (match (stage0-header arena ts (list-new arena IRI))
      ((error _) (none))
      ((ok s0)
        (match (decode-axioms arena (. s0 dict) (. s0 triples))
          ((error _) (none))
          ((ok s1) (some (gate-axioms arena (. s1 axioms) (. s1 signature) (. s0 omissions) p)))))))

  (fn reversed-raw ((arena Arena) (xs (List RawAxiom)))
    (@intent "The same axioms, last first")
    (@spec ((Arena (List RawAxiom)) -> (List RawAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena RawAxiom))
          (mut k (- (cast Int (list-len xs)) 1)))
      (do
        (while (>= k 0)
          (do (match (list-get xs k) ((some x) (list-push out x)) ((none) (do))) (set! k (- k 1))))
        out)))

  (fn reversed-saxioms ((arena Arena) (xs (List SAxiom)))
    (@intent "The same axioms, last first")
    (@spec ((Arena (List SAxiom)) -> (List SAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena SAxiom))
          (mut k (- (cast Int (list-len xs)) 1)))
      (do
        (while (>= k 0)
          (do (match (list-get xs k) ((some x) (list-push out x)) ((none) (do))) (set! k (- k 1))))
        out)))

  (fn s2-to-names ((arena Arena) (gr GateResult) (s1 S1) (flip Bool))
    (@intent "S2 then S5, S2's input reversed on request")
    (@spec ((Arena GateResult S1 Bool) -> (Result SriqNormal String)))
    (@alloc arena)
    (match (sriq-s2 arena (if flip (reversed-saxioms arena (. s1 axioms)) (. s1 axioms)))
      ((error m) (error m))
      ((ok s2)   (ok (sriq-names arena s2 (. gr signature) (guard-witnesses arena (. gr accepted) s1))))))

  (fn reversed-s0 ((arena Arena) (s0 S0))
    (@intent "S0's output with its axioms last first")
    (@spec ((Arena S0) -> S0))
    (@alloc arena)
    (record-new S0 (axioms (reversed-saxioms arena (. s0 axioms))) (rbox (. s0 rbox))))

  (fn sriq-nf ((arena Arena) (gr GateResult) (flip-accepted Bool) (flip-s0 Bool) (flip-s2 Bool))
    (@intent "A gated document's sriq normal form, its inputs reordered on request at three stages")
    (@spec ((Arena GateResult Bool Bool Bool) -> (Result SriqNormal String)))
    (@alloc arena)
    (match (sriq-s0 arena (if flip-accepted (reversed-raw arena (. gr accepted)) (. gr accepted)))
      ((error m) (error m))
      ((ok s0)
        (match (sriq-s1 arena (if flip-s0 (reversed-s0 arena s0) s0) S1_BOUND)
          ((error m) (error m))
          ((ok s1)   (s2-to-names arena gr s1 flip-s2))))))

  (fn nf-lines ((arena Arena) (r (Result SriqNormal String)))
    (@intent "The rendered output, or the refusal as its one line")
    (@spec ((Arena (Result SriqNormal String)) -> (List String)))
    (@alloc arena)
    (match r
      ((ok n) (render-sriq-normal arena n))
      ((error m) (let ((mut ls (list-new arena String))) (do (list-push ls (string-concat arena "error: " m)) ls)))))

  (fn nf-invariants-hold ((arena Arena) (path String) (r (Result SriqNormal String)))
    (@intent "Does the output keep S5's promises? Prints each failure")
    (@spec ((Arena String (Result SriqNormal String)) -> Bool))
    (@alloc arena)
    (match r
      ((error m) (do (print "  [s5] refused: ") (print path) (print " ") (println m) false))
      ((ok n)
        (let ((bad (sriq-invariants arena n)))
          (if (== (list-len bad) 0)
            true
            (do (print "  [s5] ") (println path)
                (for-each (b bad) (do (print "    ") (println b)))
                false))))))

  (fn sriq-order-independent ((arena Arena) (path String))
    (@intent "One document: triples, the accepted list, S1's input and S2's input reversed all give the same bytes")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (do (print "  [s5] did not parse: ") (println path) false))
      ((ok g)
        (match (gate-triples-in arena (. g triples) 'profile-sriq)
          ((none) (do (print "  [s5] did not gate: ") (println path) false))
          ((some fwd)
            (match (gate-triples-in arena (reversed-triples arena (. g triples)) 'profile-sriq)
              ((none) false)
              ((some rev)
                (let ((n0 (sriq-nf arena fwd false false false))
                      (l0 (nf-lines arena n0))
                      (l1 (nf-lines arena (sriq-nf arena rev false false false)))
                      (l2 (nf-lines arena (sriq-nf arena fwd true false false)))
                      (l3 (nf-lines arena (sriq-nf arena fwd false false true)))
                      (l4 (nf-lines arena (sriq-nf arena fwd false true false)))
                      (mut ok (nf-invariants-hold arena path n0)))
                  (do
                    (when (not (same-lines l0 l1)) (do (print "  [s5] triples reversed differ: ") (println path) (set! ok false)))
                    (when (not (same-lines l0 l2)) (do (print "  [s5] accepted reversed differs: ") (println path) (set! ok false)))
                    (when (not (same-lines l0 l3)) (do (print "  [s5] S2's input reversed differs: ") (println path) (set! ok false)))
                    (when (not (same-lines l0 l4)) (do (print "  [s5] S1's input reversed differs: ") (println path) (set! ok false)))
                    ok)))))))))

  (fn test-sriq-ids-row ((arena Arena))
    (@intent "One document's whole S5 output, hand-checked: ids follow content, not S2's mint order")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (gate-ttl-in arena (string-concat arena (s0-prefix)
             ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :s ] ; owl:someValuesFrom :B ] .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :C ] .\n:B rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 1 ; owl:onClass [ owl:unionOf ( :A :C ) ] ] .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :t ; owl:minQualifiedCardinality 2 ; owl:onClass :B ] .")
             'profile-sriq)
      ((none) false)
      ((some gr)
        (let ((want "DL1|| A0 A1\nDL1| urn:x:A| A3\nDL1| urn:x:A| A4\nDL1| urn:x:A A0|\nDL1| urn:x:B| A5\nDL1| urn:x:C| A2\nDL1| urn:x:C A0|\nDL2|A2|urn:x:s^bar|1|urn:x:B| f0\nDL2|A4|urn:x:t|2|urn:x:B| f1 f2\nDL3|urn:x:r^bar|A3|urn:x:C\nDL4|A5|urn:x:r|1|A1|S0\nDL8|urn:x:r|urn:x:r^bar\nDL8|urn:x:s|urn:x:s^bar\nDL8|urn:x:r^bar|urn:x:r\nDL8|urn:x:s^bar|urn:x:s\nA0 = (¬urn:x:A ⊓ ¬urn:x:C)\nA1 = (urn:x:A ⊔ urn:x:C)\nA2 = ∃urn:x:s⁻.urn:x:B\nA3 = ∀urn:x:r.urn:x:C\nA4 = ≥2 urn:x:t.urn:x:B\nA5 = ≤1 urn:x:r.(urn:x:A ⊔ urn:x:C)\nS0 = urn:x:r A1\nbar urn:x:r\nbar urn:x:s\nfns 3\nclass urn:x:A\nclass urn:x:B\nclass urn:x:C\nindividual urn:x:a\nindividual urn:x:b\n")
              (mut got ""))
          (do
            (for-each (l (nf-lines arena (sriq-normalize arena (. gr accepted) (. gr signature))))
              (set! got (string-concat arena got (string-concat arena l "\n"))))
            (if (string-eq got want)
              true
              (do (println "  [s5] ids row, got:") (print got) false)))))))

  (fn test-sriq-one-clause-from-two-axioms ((arena Arena))
    (@intent "Two axioms with the same clause between them give it once")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The collapse makes t ⊑ u, with t = r⁻ and u = s⁻, into r⁻ ⊑ s⁻:
    ;; distinct from r ⊑ s to S0, and the same DL7 r ⊑ s to S2. The
    ;; corpus does this (BFO-core's DL7/DL8 duplicates); S5's dedupe is
    ;; what keeps the clause list a set.
    (match (gate-ttl-in arena (string-concat arena (s0-prefix)
             ":u a owl:ObjectProperty .\n:r rdfs:subPropertyOf :s .\n:t owl:inverseOf :r .\n:u owl:inverseOf :s .\n:t rdfs:subPropertyOf :u .")
             'profile-sriq)
      ((none) false)
      ((some gr)
        (let ((want "DL7|urn:x:r|urn:x:s\nfns 0\nclass urn:x:A\nclass urn:x:B\nclass urn:x:C\nindividual urn:x:a\nindividual urn:x:b\n")
              (mut got ""))
          (do
            (for-each (l (nf-lines arena (sriq-normalize arena (. gr accepted) (. gr signature))))
              (set! got (string-concat arena got (string-concat arena l "\n"))))
            (if (string-eq got want)
              true
              (do (println "  [s5] one clause from two axioms, got:") (print got) false)))))))

  (fn test-sriq-ids-from-content ((arena Arena))
    (@intent "§5.5 S5 / §6.8: the sriq normal form is order-independent, and its ids dense and in key order")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (mut ps (list-new arena String)))
      (do
        (for-each (p (sriq-fixtures arena)) (when (not (sriq-order-independent arena p)) (set! ok false)))
        ok)))

  (fn yields-nothing-by-design ((a RawAxiom))
    (@intent "Axioms with no clause of their own: no logical content, or absorbed into S0's collapse")
    (@spec ((RawAxiom) -> Bool))
    (@pure)
    (match a
      ((ra-declaration _)           true)
      ((ra-annotation)              true)
      ((ra-inert-data)              true)
      ((ra-equivalent-properties _) true)
      ((ra-inverse-properties _ _)  true)
      (_                            false)))

  (fn one-raw ((arena Arena) (a RawAxiom))
    (@intent "[a]")
    (@spec ((Arena RawAxiom) -> (List RawAxiom)))
    (@alloc arena)
    (let ((mut xs (list-new arena RawAxiom))) (do (list-push xs a) xs)))

  (fn print-alone ((arena Arena) (a RawAxiom))
    (@intent "An axiom that gave no clauses, as S0 reads it")
    (@spec ((Arena RawAxiom) -> Bool))
    (@alloc arena)
    (do
      (print "  [s5] no clauses from ")
      (match (sriq-s0 arena (one-raw arena a))
        ((ok s0)   (print (render-saxioms arena (. s0 axioms))))
        ((error _) (println "?")))
      true))

  (fn is-chain-axiom ((a RawAxiom))
    (@intent "A property chain, transitivity included (expand-sugar makes it one)")
    (@spec ((RawAxiom) -> Bool))
    (@pure)
    (match a ((ra-property-chain _) true) (_ false)))

  (fn yield-kind ((arena Arena) (a RawAxiom) (sig Signature))
    (@intent "One axiom normalised alone: 0 it yields as it should, 1 a chain S1 eliminated, 2 a fault (printed)")
    (@spec ((Arena RawAxiom Signature) -> Int))
    (@alloc arena)
    ;; A chain alone constrains nothing S1 keeps: it is eliminated, and its
    ;; consequences arrive only through the ∀s it expands (§5.5 S1).
    (match (sriq-normalize arena (one-raw arena a) sig)
      ((error m) (do (print "  [s5] refused alone: ") (println m) 2))
      ((ok n)
        (cond
          ((> (list-len (. n clauses)) 0) 0)
          ((is-chain-axiom a)            1)
          ((yields-nothing-by-design a)  0)
          (else (do (print-alone arena a) 2))))))

  (fn every-axiom-yields ((arena Arena) (path String))
    (@intent "Each accepted axiom, normalised alone, gives clauses or is one that yields nothing by design")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-sriq)
      ((none) (do (print "  [s5] did not gate: ") (println path) false))
      ((some gr)
        (let ((mut ok true)
              (mut chains 0))
          (do
            (for-each (a (. gr accepted))
              (let ((k (yield-kind arena a (. gr signature))))
                (do (when (== k 1) (set! chains (+ chains 1)))
                    (when (== k 2) (set! ok false)))))
            (print "  [s5] ") (print path) (print ": ")
            (print (int-to-string arena (cast Int (list-len (. gr accepted))))) (print " accepted, ")
            (print (int-to-string arena chains)) (println " chains eliminated by S1")
            ok)))))

  (fn test-sriq-every-axiom-yields ((arena Arena))
    (@intent "No accepted axiom is silently lost by the normaliser")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (mut ps (list-new arena String)))
      (do
        (for-each (p (sriq-fixtures arena)) (when (not (every-axiom-yields arena p)) (set! ok false)))
        ok)))

  (fn s1-text ((arena Arena) (s1 S1))
    (@intent "S1's axioms, then what its guard omitted")
    (@spec ((Arena S1) -> String))
    (@alloc arena)
    (let ((mut out (render-saxioms arena (. s1 axioms))))
      (do (for-each (a (. s1 omitted)) (set! out (string-concat arena out (string-concat arena "omitted " (string-concat arena (render-saxiom arena a) "\n")))))
          out)))

  (fn s1-bounded-of ((arena Arena) (ttl String) (bound Int))
    (@intent "S1 under a given bound on distinct labelled concepts")
    (@spec ((Arena String Int) -> String))
    (@alloc arena)
    (match (gate-ttl-in arena (string-concat arena (s0-prefix) ttl) 'profile-sriq)
      ((none) "did not gate\n")
      ((some gr)
        (match (sriq-s0 arena (. gr accepted))
          ((error m) (string-concat arena "refused: " (string-concat arena m "\n")))
          ((ok s0)
            (match (sriq-s1 arena s0 bound)
              ((error m) (string-concat arena "refused: " (string-concat arena m "\n")))
              ((ok s1)   (s1-text arena s1))))))))

  (fn s1-bounded-is ((arena Arena) (label String) (ttl String) (bound Int) (want String))
    (@intent "Does S1 under this bound give exactly this? Prints what it got when not")
    (@spec ((Arena String String Int String) -> Bool))
    (@alloc arena)
    (let ((got (s1-bounded-of arena ttl bound)))
      (if (string-eq got want)
        true
        (do (print "  [s1] ") (println label) (print got) false))))

  (fn test-sriq-guard-witnesses ((arena Arena))
    (@intent "A tripped guard's witnesses are the input's chain axioms, carried to the normaliser's output")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Transitivity arrives as r ∘ r ⊑ r; the guard omits it, and the rest
    ;; (A ⊑ ∀r.B, unlabelled) still reaches S2. A one-step "chain" (t ⊑ s,
    ;; written as a chain) is an ordinary inclusion: kept, so not a witness.
    (match (gate-ttl-in arena (string-concat arena (s0-prefix)
             ":r a owl:TransitiveProperty .\n:s owl:propertyChainAxiom ( :t ) .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] .")
             'profile-sriq)
      ((none) false)
      ((some gr)
        (match (sriq-normalize-bounded arena (. gr accepted) (. gr signature) 0)
          ((error m) (do (print "  [guard] refused: ") (println m) false))
          ((ok n)
            (let ((want "omitted SubObjectPropertyOf(ObjectPropertyChain(urn:x:r urn:x:r) urn:x:r)\n")
                  (mut got ""))
              (do
                (for-each (l (render-sriq-normal arena n))
                  (when (starts-with l "omitted ") (set! got (string-concat arena got (string-concat arena l "\n")))))
                (if (and (string-eq got want) (> (list-len (. n clauses)) 0))
                  true
                  (do (println "  [guard] witnesses, got:") (print got) false)))))))))

  (fn test-sriq-s1-rows ((arena Arena))
    (@intent "§5.5 S1, row by row: [Sim12] §4 with the two errata read as the SPEC pins them")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Each row is S1's output, hand-checked against Definitions 4–6:
    ;; item 1 I ⊑ ∀S.F; item 2 I ⊑ ∀w.F (R1); item 3 F ⊑ ∀w.F (R2);
    ;; item 4 I ⊑ ∀w.I (R3); item 5 F ⊑ I (R4); ∃R.C on the left gives
    ;; C ⊑ I and expand(I ⊑ ∀inv(R).F).
    (let ((mut ok true))
      (do
        (when (not (s1-bounded-is arena "the guard: past the bound, S0 minus its chains, the chains omitted"
                     ":r a owl:TransitiveProperty .\n:s rdfs:subPropertyOf :r .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     0 "urn:x:A ⊑ ∀urn:x:r.urn:x:B\nurn:x:s ⊑ urn:x:r\nomitted urn:x:r ∘ urn:x:r ⊑ urn:x:r\n"))
          (set! ok false))
        (when (not (s1-bounded-is arena "the guard: at the bound, S1 runs whole"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     1 "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\n"))
          (set! ok false))
        (when (not (s1-is arena "a filler is canonical before it is keyed: the named ∀ sorts after ≥2"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom [ owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] [ a owl:Restriction ; owl:onProperty :s ; owl:minQualifiedCardinality 2 ; owl:onClass :C ] ) ] ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.(≥2 urn:x:s.urn:x:C ⊓ I[∀urn:x:r.urn:x:B])]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.(≥2 urn:x:s.urn:x:C ⊓ I[∀urn:x:r.urn:x:B])] ⊑ ∀urn:x:r.F[∀urn:x:r.(≥2 urn:x:s.urn:x:C ⊓ I[∀urn:x:r.urn:x:B])]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.(≥2 urn:x:s.urn:x:C ⊓ I[∀urn:x:r.urn:x:B])] ⊑ (≥2 urn:x:s.urn:x:C ⊓ I[∀urn:x:r.urn:x:B])\nF[∀urn:x:r.(≥2 urn:x:s.urn:x:C ⊓ I[∀urn:x:r.urn:x:B])] ⊑ I[∀urn:x:r.(≥2 urn:x:s.urn:x:C ⊓ I[∀urn:x:r.urn:x:B])]\n"))
          (set! ok false))
        (when (not (s1-is arena "transitive: a positive ∀ becomes I, F and the automaton (items 1, 5)"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\n"))
          (set! ok false))
        (when (not (s1-is arena "a domain on a transitive role: a negative ∃ (Definition 6's ∃ case)"
                     ":r a owl:TransitiveProperty ; rdfs:domain :A ."
                     "⊤ ⊑ I[∃urn:x:r.⊤]\nI[∃urn:x:r.⊤] ⊑ ∀urn:x:r⁻.F[∃urn:x:r.⊤]\nF[∃urn:x:r.⊤] ⊑ urn:x:A\nF[∃urn:x:r.⊤] ⊑ I[∃urn:x:r.⊤]\n"))
          (set! ok false))
        (when (not (s1-is arena "a range on a transitive role: ⊤ ⊑ ∀r.A"
                     ":r a owl:TransitiveProperty ; rdfs:range :A ."
                     "⊤ ⊑ I[∀urn:x:r.urn:x:A]\nI[∀urn:x:r.urn:x:A] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:A]\nF[∀urn:x:r.urn:x:A] ⊑ urn:x:A\nF[∀urn:x:r.urn:x:A] ⊑ I[∀urn:x:r.urn:x:A]\n"))
          (set! ok false))
        (when (not (s1-is arena "symmetric and transitive: expanded both ways, one pair"
                     ":r a owl:TransitiveProperty , owl:SymmetricProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r⁻.F[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\n"))
          (set! ok false))
        (when (not (s1-is arena "a negative assertion on a transitive role"
                     ":r a owl:TransitiveProperty .\n[] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ."
                     "{urn:x:a} ⊑ I[∀urn:x:r.¬{urn:x:b}]\nI[∀urn:x:r.¬{urn:x:b}] ⊑ ∀urn:x:r.F[∀urn:x:r.¬{urn:x:b}]\nF[∀urn:x:r.¬{urn:x:b}] ⊑ ¬{urn:x:b}\nF[∀urn:x:r.¬{urn:x:b}] ⊑ I[∀urn:x:r.¬{urn:x:b}]\n"))
          (set! ok false))
        (when (not (s1-is arena "Ref on a transitive role is kept"
                     ":r a owl:TransitiveProperty , owl:ReflexiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\nRef(urn:x:r)\n"))
          (set! ok false))
        (when (not (s1-is arena "a sub-role into a transitive role: item 2 keeps it (R1, length 1)"
                     ":r a owl:TransitiveProperty .\n:s rdfs:subPropertyOf :r .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:s.F[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\n"))
          (set! ok false))
        (when (not (s1-is arena "a chain into its first role: item 3 (R2)"
                     ":r owl:propertyChainAxiom ( :r :s ) .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:s.F[∀urn:x:r.urn:x:B]\n"))
          (set! ok false))
        (when (not (s1-is arena "a chain into its last role: item 4 (R3)"
                     ":r owl:propertyChainAxiom ( :s :r ) .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:s.I[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\n"))
          (set! ok false))
        (when (not (s1-is arena "a chain into a third role: item 2 (R1)"
                     ":t owl:propertyChainAxiom ( :r :s ) .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :t ; owl:allValuesFrom :B ] ."
                     "urn:x:A ⊑ I[∀urn:x:t.urn:x:B]\nI[∀urn:x:t.urn:x:B] ⊑ ∀urn:x:r.∀urn:x:s.F[∀urn:x:t.urn:x:B]\nI[∀urn:x:t.urn:x:B] ⊑ ∀urn:x:t.F[∀urn:x:t.urn:x:B]\nF[∀urn:x:t.urn:x:B] ⊑ urn:x:B\n"))
          (set! ok false))
        (when (not (s1-is arena "≤n's filler is negative: its ∃ on a transitive role is labelled"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s ; owl:maxQualifiedCardinality 1 ; owl:onClass [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] ] ."
                     "urn:x:A ⊑ ≤1 urn:x:s.F[∃urn:x:r.urn:x:B]\nurn:x:B ⊑ I[∃urn:x:r.urn:x:B]\nI[∃urn:x:r.urn:x:B] ⊑ ∀urn:x:r⁻.F[∃urn:x:r.urn:x:B]\nF[∃urn:x:r.urn:x:B] ⊑ I[∃urn:x:r.urn:x:B]\n"))
          (set! ok false))
        (when (not (s1-is arena "a positive ∃ on a transitive role is left alone"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] ."
                     "urn:x:A ⊑ ∃urn:x:r.urn:x:B\n"))
          (set! ok false))
        (when (not (s1-is arena "nested ∀∀: the inner one is named first"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.I[∀urn:x:r.urn:x:B]]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.I[∀urn:x:r.urn:x:B]] ⊑ ∀urn:x:r.F[∀urn:x:r.I[∀urn:x:r.urn:x:B]]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.I[∀urn:x:r.urn:x:B]] ⊑ I[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.I[∀urn:x:r.urn:x:B]] ⊑ I[∀urn:x:r.I[∀urn:x:r.urn:x:B]]\n"))
          (set! ok false))
        (when (not (s1-is arena "one pair for a repeated labelled concept"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] .\n:C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nurn:x:C ⊑ I[∀urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\n"))
          (set! ok false))
        (when (not (s1-is arena "∀ and ∃ on the same (r, B) get different names"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] .\n[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] rdfs:subClassOf :C ."
                     "urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nurn:x:B ⊑ I[∃urn:x:r.urn:x:B]\nI[∀urn:x:r.urn:x:B] ⊑ ∀urn:x:r.F[∀urn:x:r.urn:x:B]\nF[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nF[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\nI[∃urn:x:r.urn:x:B] ⊑ ∀urn:x:r⁻.F[∃urn:x:r.urn:x:B]\nF[∃urn:x:r.urn:x:B] ⊑ urn:x:C\nF[∃urn:x:r.urn:x:B] ⊑ I[∃urn:x:r.urn:x:B]\n"))
          (set! ok false))
        (when (not (s1-is arena "the bottom role's row is expanded like any other"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty owl:bottomObjectProperty ; owl:someValuesFrom :B ] ."
                     "⊤ ⊑ I[∃http://www.w3.org/2002/07/owl#bottomObjectProperty.⊤]\nurn:x:A ⊑ ∃http://www.w3.org/2002/07/owl#bottomObjectProperty.urn:x:B\nI[∃http://www.w3.org/2002/07/owl#bottomObjectProperty.⊤] ⊑ ∀http://www.w3.org/2002/07/owl#bottomObjectProperty⁻.F[∃http://www.w3.org/2002/07/owl#bottomObjectProperty.⊤]\nF[∃http://www.w3.org/2002/07/owl#bottomObjectProperty.⊤] ⊑ ⊥\n"))
          (set! ok false))
        ok)))

  (fn s1-invariants-hold ((arena Arena) (path String))
    (@intent "Does S1's output on this document keep S1's promises? Prints each failure")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-sriq)
      ((none) (do (print "  [s1] did not gate: ") (println path) false))
      ((some gr)
        (match (sriq-s0 arena (. gr accepted))
          ((error m) (do (print "  [s1] S0 refused: ") (println m) false))
          ((ok s0)
            (match (sriq-s1 arena s0 S1_BOUND)
              ((error m) (do (print "  [s1] refused: ") (println m) false))
              ((ok s1)   (print-problems path (sriq-s1-invariants arena (. s0 rbox) (. s0 axioms) s1)))))))))

  (fn print-problems ((path String) (bad (List String)))
    (@intent "True when there are none; otherwise each, under the document's name")
    (@spec ((String (List String)) -> Bool))
    (if (== (list-len bad) 0)
      true
      (do (print "  [s1] ") (println path)
          (for-each (b bad) (do (print "    ") (println b)))
          false)))

  (fn test-sriq-s1-invariants ((arena Arena))
    (@intent "§5.5 S1's promises on every fixture: no complex RIA, no labelled restriction but item 1, every atom's axioms")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do (for-each (p (sriq-fixtures arena)) (when (not (s1-invariants-hold arena p)) (set! ok false)))
          ok)))

  (fn test-sriq-s2-refuses-a-count-past-the-bound ((arena Arena))
    (@intent "S2 refuses a number restriction above the gate's bound, which its NNF could not keep exact")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Through the pipeline the gate omits such an axiom first, so it is
    ;; built here directly: A ⊑ ≤17 r.⊤.
    (let ((a (union-new SConcept sc-name (record-new IRI (value "urn:x:A"))))
          (r (union-new RoleId named-role (record-new IRI (value "urn:x:r"))))
          (mut axs (list-new arena SAxiom)))
      (do
        (list-push axs (union-new SAxiom sa-gci (box-sc arena a)
                         (box-sc arena (union-new SConcept sc-atmost 17 r
                                         (box-sc arena (union-new SConcept sc-top))))))
        (match (sriq-s2 arena axs)
          ((ok _)    false)
          ((error _) true)))))

  (fn test-sriq-s2-rows ((arena Arena))
    (@intent "§5.5 S2, row by row against [TGH21] Table 1")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (when (not (s2-is arena "a name below a name"
                     ":A rdfs:subClassOf :B ."
                     "DL1 urn:x:A ⊑ urn:x:B\n"))
          (set! ok false))
        (when (not (s2-is arena "a conjunction on the right is a disjunct, so named"
                     ":A rdfs:subClassOf [ owl:intersectionOf ( :B :C ) ] ."
                     "DL1 A[(urn:x:B ⊓ urn:x:C)] ⊑ urn:x:B\nDL1 A[(urn:x:B ⊓ urn:x:C)] ⊑ urn:x:C\nDL1 urn:x:A ⊑ A[(urn:x:B ⊓ urn:x:C)]\n"))
          (set! ok false))
        (when (not (s2-is arena "a top-level conjunction is split (choice 3)"
                     "owl:Thing rdfs:subClassOf [ owl:intersectionOf ( :B :C ) ] ."
                     "DL1 ⊤ ⊑ urn:x:B\nDL1 ⊤ ⊑ urn:x:C\n"))
          (set! ok false))
        (when (not (s2-is arena "a disjunction is one DL1"
                     ":A rdfs:subClassOf [ owl:unionOf ( :B :C ) ] ."
                     "DL1 urn:x:A ⊑ urn:x:B ⊔ urn:x:C\n"))
          (set! ok false))
        (when (not (s2-is arena "a conjunction on the left is the body"
                     "[ owl:intersectionOf ( :A :B ) ] rdfs:subClassOf :C ."
                     "DL1 urn:x:A ⊓ urn:x:B ⊑ urn:x:C\n"))
          (set! ok false))
        (when (not (s2-is arena "a negation is the body"
                     ":A rdfs:subClassOf [ owl:complementOf :B ] ."
                     "DL1 urn:x:A ⊓ urn:x:B ⊑ ⊥\n"))
          (set! ok false))
        (when (not (s2-is arena "bottom on the right"
                     ":A rdfs:subClassOf owl:Nothing ."
                     "DL1 urn:x:A ⊑ ⊥\n"))
          (set! ok false))
        (when (not (s2-is arena "top on the left"
                     "owl:Thing rdfs:subClassOf :A ."
                     "DL1 ⊤ ⊑ urn:x:A\n"))
          (set! ok false))
        (when (not (s2-is arena "a tautology emits nothing"
                     ":A rdfs:subClassOf owl:Thing ."
                     ""))
          (set! ok false))
        (when (not (s2-is arena "exists: DL1 then DL2, no shortcut"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] ."
                     "DL1 urn:x:A ⊑ A[∃urn:x:r.urn:x:B]\nDL2 A[∃urn:x:r.urn:x:B] ⊑ ≥1 urn:x:r.urn:x:B\n"))
          (set! ok false))
        (when (not (s2-is arena "exists top: DL2 keeps its filler as top"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom owl:Thing ] ."
                     "DL1 urn:x:A ⊑ A[∃urn:x:r.⊤]\nDL2 A[∃urn:x:r.⊤] ⊑ ≥1 urn:x:r.⊤\n"))
          (set! ok false))
        (when (not (s2-is arena "at least 2"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:minQualifiedCardinality 2 ; owl:onClass :B ] ."
                     "DL1 urn:x:A ⊑ A[≥2 urn:x:r.urn:x:B]\nDL2 A[≥2 urn:x:r.urn:x:B] ⊑ ≥2 urn:x:r.urn:x:B\n"))
          (set! ok false))
        (when (not (s2-is arena "exists on an inverse uses bar"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :r ] ; owl:someValuesFrom :B ] ."
                     "DL1 urn:x:A ⊑ A[∃urn:x:r⁻.urn:x:B]\nDL2 A[∃urn:x:r⁻.urn:x:B] ⊑ ≥1 bar(urn:x:r).urn:x:B\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "forall is DL3 over inv(R), so bar"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "DL1 urn:x:A ⊑ A[∀urn:x:r.urn:x:B]\nDL3 ∃bar(urn:x:r).A[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "forall on an inverse needs no bar"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :r ] ; owl:allValuesFrom :B ] ."
                     "DL1 urn:x:A ⊑ A[∀urn:x:r⁻.urn:x:B]\nDL3 ∃urn:x:r.A[∀urn:x:r⁻.urn:x:B] ⊑ urn:x:B\n"))
          (set! ok false))
        (when (not (s2-is arena "forall with a negated filler"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :r ] ; owl:allValuesFrom [ owl:complementOf :B ] ] ."
                     "DL1 A[¬urn:x:B] ⊓ urn:x:B ⊑ ⊥\nDL1 urn:x:A ⊑ A[∀urn:x:r⁻.¬urn:x:B]\nDL3 ∃urn:x:r.A[∀urn:x:r⁻.¬urn:x:B] ⊑ A[¬urn:x:B]\n"))
          (set! ok false))
        (when (not (s2-is arena "at most: DL4 with S_{r,B}"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 2 ; owl:onClass :B ] ."
                     "DL1 urn:x:A ⊑ A[≤2 urn:x:r.urn:x:B]\nDL4 A[≤2 urn:x:r.urn:x:B] ⊑ ≤2 urn:x:r.urn:x:B via S_{urn:x:r,urn:x:B}\n"))
          (set! ok false))
        (when (not (s2-is arena "S1's names are S2's names, never defined"
                     ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ."
                     "DL1 F[∀urn:x:r.urn:x:B] ⊑ I[∀urn:x:r.urn:x:B]\nDL1 F[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nDL1 I[∀urn:x:r.urn:x:B] ⊑ A[∀urn:x:r.F[∀urn:x:r.urn:x:B]]\nDL1 urn:x:A ⊑ I[∀urn:x:r.urn:x:B]\nDL3 ∃bar(urn:x:r).A[∀urn:x:r.F[∀urn:x:r.urn:x:B]] ⊑ F[∀urn:x:r.urn:x:B]\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "two fillers on one role get two S roles"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 1 ; owl:onClass :B ] .\n:C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 1 ; owl:onClass :C ] ."
                     "DL1 urn:x:A ⊑ A[≤1 urn:x:r.urn:x:B]\nDL1 urn:x:C ⊑ A[≤1 urn:x:r.urn:x:C]\nDL4 A[≤1 urn:x:r.urn:x:B] ⊑ ≤1 urn:x:r.urn:x:B via S_{urn:x:r,urn:x:B}\nDL4 A[≤1 urn:x:r.urn:x:C] ⊑ ≤1 urn:x:r.urn:x:C via S_{urn:x:r,urn:x:C}\n"))
          (set! ok false))
        (when (not (s2-is arena "at most over a union: the filler named above"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 1 ; owl:onClass [ owl:unionOf ( :B :C ) ] ] ."
                     "DL1 A[(¬urn:x:B ⊓ ¬urn:x:C)] ⊓ urn:x:B ⊑ ⊥\nDL1 A[(¬urn:x:B ⊓ ¬urn:x:C)] ⊓ urn:x:C ⊑ ⊥\nDL1 urn:x:A ⊑ A[≤1 urn:x:r.(urn:x:B ⊔ urn:x:C)]\nDL1 ⊤ ⊑ A[(urn:x:B ⊔ urn:x:C)] ⊔ A[(¬urn:x:B ⊓ ¬urn:x:C)]\nDL4 A[≤1 urn:x:r.(urn:x:B ⊔ urn:x:C)] ⊑ ≤1 urn:x:r.A[(urn:x:B ⊔ urn:x:C)] via S_{urn:x:r,A[(urn:x:B ⊔ urn:x:C)]}\n"))
          (set! ok false))
        (when (not (s2-is arena "exactly 2: at least and at most"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:qualifiedCardinality 2 ; owl:onClass :B ] ."
                     "DL1 urn:x:A ⊑ A[(≥2 urn:x:r.urn:x:B ⊓ ≤2 urn:x:r.urn:x:B)]\nDL2 A[(≥2 urn:x:r.urn:x:B ⊓ ≤2 urn:x:r.urn:x:B)] ⊑ ≥2 urn:x:r.urn:x:B\nDL4 A[(≥2 urn:x:r.urn:x:B ⊓ ≤2 urn:x:r.urn:x:B)] ⊑ ≤2 urn:x:r.urn:x:B via S_{urn:x:r,urn:x:B}\n"))
          (set! ok false))
        (when (not (s2-is arena "a nested conjunction is named once"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom [ owl:intersectionOf ( :B :C ) ] ] .\n:B rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s ; owl:someValuesFrom [ owl:intersectionOf ( :C :B ) ] ] ."
                     "DL1 A[(urn:x:B ⊓ urn:x:C)] ⊑ urn:x:B\nDL1 A[(urn:x:B ⊓ urn:x:C)] ⊑ urn:x:C\nDL1 urn:x:A ⊑ A[∃urn:x:r.(urn:x:B ⊓ urn:x:C)]\nDL1 urn:x:B ⊑ A[∃urn:x:s.(urn:x:B ⊓ urn:x:C)]\nDL2 A[∃urn:x:r.(urn:x:B ⊓ urn:x:C)] ⊑ ≥1 urn:x:r.A[(urn:x:B ⊓ urn:x:C)]\nDL2 A[∃urn:x:s.(urn:x:B ⊓ urn:x:C)] ⊑ ≥1 urn:x:s.A[(urn:x:B ⊓ urn:x:C)]\n"))
          (set! ok false))
        (when (not (s2-is arena "exists on the left"
                     "[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] rdfs:subClassOf :A ."
                     "DL3 ∃urn:x:r.urn:x:B ⊑ urn:x:A\n"))
          (set! ok false))
        (when (not (s2-is arena "domain"
                     ":r rdfs:domain :A ."
                     "DL1 ⊤ ⊑ A[⊤]\nDL3 ∃urn:x:r.A[⊤] ⊑ urn:x:A\n"))
          (set! ok false))
        (when (not (s2-is arena "range"
                     ":r rdfs:range :A ."
                     "DL1 ⊤ ⊑ A[⊤]\nDL3 ∃bar(urn:x:r).A[⊤] ⊑ urn:x:A\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\n"))
          (set! ok false))
        ;; Choice 11's corners: an inverse's domain; complex C and D; the
        ;; tautologies; D = ⊥; two ranges in one conjunction; T made once.
        (when (not (s2-is arena "choice 11: the domain of an inverse, over its P̄"
                     "[ owl:inverseOf :r ] rdfs:domain :A ."
                     "DL1 ⊤ ⊑ A[⊤]\nDL3 ∃bar(urn:x:r).A[⊤] ⊑ urn:x:A\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "choice 11: a complex filler is named above it, a complex right side below it"
                     "[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom [ owl:unionOf ( :B :C ) ] ] rdfs:subClassOf [ owl:intersectionOf ( :A :B ) ] ."
                     "DL1 A[(urn:x:A ⊓ urn:x:B)] ⊑ urn:x:A\nDL1 A[(urn:x:A ⊓ urn:x:B)] ⊑ urn:x:B\nDL1 A[(¬urn:x:B ⊓ ¬urn:x:C)] ⊓ urn:x:B ⊑ ⊥\nDL1 A[(¬urn:x:B ⊓ ¬urn:x:C)] ⊓ urn:x:C ⊑ ⊥\nDL1 ⊤ ⊑ A[(urn:x:B ⊔ urn:x:C)] ⊔ A[(¬urn:x:B ⊓ ¬urn:x:C)]\nDL3 ∃urn:x:r.A[(urn:x:B ⊔ urn:x:C)] ⊑ A[(urn:x:A ⊓ urn:x:B)]\n"))
          (set! ok false))
        (when (not (s2-is arena "choice 11: ∃R.⊥ ⊑ A and ∃R.B ⊑ ⊤ are tautologies, emitting nothing"
                     "[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom owl:Nothing ] rdfs:subClassOf :A .\n[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] rdfs:subClassOf owl:Thing ."
                     ""))
          (set! ok false))
        (when (not (s2-is arena "choice 11: the match is on canonical NNF, so ≥1 R.B on the left is ∃R.B"
                     "[ a owl:Restriction ; owl:onProperty :r ; owl:minQualifiedCardinality \"1\"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ; owl:onClass :B ] rdfs:subClassOf :A ."
                     "DL3 ∃urn:x:r.urn:x:B ⊑ urn:x:A\n"))
          (set! ok false))
        (when (not (s2-is arena "choice 11: the match is on NNF, so ¬∀R.¬B on the left is ∃R.B"
                     "[ owl:complementOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom [ owl:complementOf :B ] ] ] rdfs:subClassOf :A ."
                     "DL3 ∃urn:x:r.urn:x:B ⊑ urn:x:A\n"))
          (set! ok false))
        (when (not (s2-is arena "choice 11: ⊤ ⊑ ∀R.⊤ is a tautology, and makes no T"
                     ":r rdfs:range owl:Thing ."
                     ""))
          (set! ok false))
        (when (not (s2-is arena "choice 11: two ∀ conjuncts of one ⊤ axiom are two ranges"
                     "owl:Thing rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :A ] [ a owl:Restriction ; owl:onProperty :s ; owl:allValuesFrom :B ] ) ] ."
                     "DL1 ⊤ ⊑ A[⊤]\nDL3 ∃bar(urn:x:r).A[⊤] ⊑ urn:x:A\nDL3 ∃bar(urn:x:s).A[⊤] ⊑ urn:x:B\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 bar(urn:x:s) ⊑ urn:x:s⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\nDL8 urn:x:s ⊑ bar(urn:x:s)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "choice 11: ⊤ ⊑ A ⊔ ∀R.B is not a range"
                     "owl:Thing rdfs:subClassOf [ owl:unionOf ( :A [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] ) ] ."
                     "DL1 ⊤ ⊑ urn:x:A ⊔ A[∀urn:x:r.urn:x:B]\nDL3 ∃bar(urn:x:r).A[∀urn:x:r.urn:x:B] ⊑ urn:x:B\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "choice 11: ∃R.B ⊑ ⊥ names ⊥ below"
                     "[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] rdfs:subClassOf owl:Nothing ."
                     "DL1 A[⊥] ⊑ ⊥\nDL3 ∃urn:x:r.urn:x:B ⊑ A[⊥]\n"))
          (set! ok false))
        (when (not (s2-is arena "choice 11: two ranges and two domains, T made once"
                     ":r rdfs:range :A .\n:s rdfs:range :B .\n:r rdfs:domain :C .\n:s rdfs:domain :A ."
                     "DL1 ⊤ ⊑ A[⊤]\nDL3 ∃bar(urn:x:r).A[⊤] ⊑ urn:x:A\nDL3 ∃bar(urn:x:s).A[⊤] ⊑ urn:x:B\nDL3 ∃urn:x:r.A[⊤] ⊑ urn:x:C\nDL3 ∃urn:x:s.A[⊤] ⊑ urn:x:A\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 bar(urn:x:s) ⊑ urn:x:s⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\nDL8 urn:x:s ⊑ bar(urn:x:s)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "Self"
                     ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasSelf true ] ."
                     "DL1 urn:x:A ⊑ A[∃urn:x:r.Self]\nDL5 A[∃urn:x:r.Self] ⊑ ∃urn:x:r.Self\n"))
          (set! ok false))
        (when (not (s2-is arena "Ref: top below a Self name"
                     ":r a owl:ReflexiveProperty ."
                     "DL1 ⊤ ⊑ A[∃urn:x:r.Self]\nDL5 A[∃urn:x:r.Self] ⊑ ∃urn:x:r.Self\n"))
          (set! ok false))
        (when (not (s2-is arena "Irr: DL6 and a DL1 to bottom"
                     ":r a owl:IrreflexiveProperty ."
                     "DL1 A[∃urn:x:r.Self] ⊑ ⊥\nDL6 ∃urn:x:r.Self ⊑ A[∃urn:x:r.Self]\n"))
          (set! ok false))
        (when (not (s2-is arena "Ref and Irr share one name"
                     ":r a owl:ReflexiveProperty , owl:IrreflexiveProperty ."
                     "DL1 A[∃urn:x:r.Self] ⊑ ⊥\nDL1 ⊤ ⊑ A[∃urn:x:r.Self]\nDL5 A[∃urn:x:r.Self] ⊑ ∃urn:x:r.Self\nDL6 ∃urn:x:r.Self ⊑ A[∃urn:x:r.Self]\n"))
          (set! ok false))
        (when (not (s2-is arena "functional: DL4 at most 1 with top"
                     ":r a owl:FunctionalProperty ."
                     "DL1 ⊤ ⊑ A[≤1 urn:x:r.⊤]\nDL4 A[≤1 urn:x:r.⊤] ⊑ ≤1 urn:x:r.⊤ via S_{urn:x:r,⊤}\n"))
          (set! ok false))
        (when (not (s2-is arena "inverse functional uses bar"
                     ":r a owl:InverseFunctionalProperty ."
                     "DL1 ⊤ ⊑ A[≤1 urn:x:r⁻.⊤]\nDL4 A[≤1 urn:x:r⁻.⊤] ⊑ ≤1 bar(urn:x:r).⊤ via S_{bar(urn:x:r),⊤}\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "a role inclusion is DL7"
                     ":r rdfs:subPropertyOf :s ."
                     "DL7 urn:x:r ⊑ urn:x:s\n"))
          (set! ok false))
        (when (not (s2-is arena "into an inverse is DL8"
                     ":r rdfs:subPropertyOf [ owl:inverseOf :s ] ."
                     "DL8 urn:x:r ⊑ urn:x:s⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "symmetry is DL8 to itself"
                     ":r a owl:SymmetricProperty ."
                     "DL8 urn:x:r ⊑ urn:x:r⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "disjoint properties"
                     ":r owl:propertyDisjointWith :s ."
                     "DL9 Disj(urn:x:r, urn:x:s)\n"))
          (set! ok false))
        (when (not (s2-is arena "asymmetry is DL9 with bar"
                     ":r a owl:AsymmetricProperty ."
                     "DL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\nDL9 Disj(urn:x:r, bar(urn:x:r))\n"))
          (set! ok false))
        (when (not (s2-is arena "a class assertion: DL10 then DL1"
                     ":a a :A ."
                     "DL1 A[{urn:x:a}] ⊑ urn:x:A\nDL10 {urn:x:a} ⊑ A[{urn:x:a}]\n"))
          (set! ok false))
        (when (not (s2-is arena "a property assertion: DL10, DL1, DL2, DL11"
                     ":a :r :b ."
                     "DL1 A[{urn:x:a}] ⊑ A[∃urn:x:r.{urn:x:b}]\nDL10 {urn:x:a} ⊑ A[{urn:x:a}]\nDL11 A[{urn:x:b}] ⊑ {urn:x:b}\nDL2 A[∃urn:x:r.{urn:x:b}] ⊑ ≥1 urn:x:r.A[{urn:x:b}]\n"))
          (set! ok false))
        (when (not (s2-is arena "a negative assertion: DL10, DL1, DL3, DL1"
                     "[ a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ] ."
                     "DL1 A[{urn:x:a}] ⊑ A[∀urn:x:r.¬{urn:x:b}]\nDL1 A[¬{urn:x:b}] ⊓ A[{urn:x:b}] ⊑ ⊥\nDL10 {urn:x:a} ⊑ A[{urn:x:a}]\nDL10 {urn:x:b} ⊑ A[{urn:x:b}]\nDL3 ∃bar(urn:x:r).A[∀urn:x:r.¬{urn:x:b}] ⊑ A[¬{urn:x:b}]\nDL8 bar(urn:x:r) ⊑ urn:x:r⁻\nDL8 urn:x:r ⊑ bar(urn:x:r)⁻\n"))
          (set! ok false))
        (when (not (s2-is arena "SameIndividual: one name per nominal, both ways"
                     ":a owl:sameAs :b ."
                     "DL1 A[{urn:x:a}] ⊑ A[{urn:x:b}]\nDL1 A[{urn:x:b}] ⊑ A[{urn:x:a}]\nDL10 {urn:x:a} ⊑ A[{urn:x:a}]\nDL10 {urn:x:b} ⊑ A[{urn:x:b}]\nDL11 A[{urn:x:a}] ⊑ {urn:x:a}\nDL11 A[{urn:x:b}] ⊑ {urn:x:b}\n"))
          (set! ok false))
        (when (not (s2-is arena "DifferentIndividuals"
                     ":a owl:differentFrom :b ."
                     "DL1 A[{urn:x:a}] ⊓ A[{urn:x:b}] ⊑ ⊥\nDL10 {urn:x:a} ⊑ A[{urn:x:a}]\nDL10 {urn:x:b} ⊑ A[{urn:x:b}]\n"))
          (set! ok false))
        ok)))

  ;; ------------------------------------------------------------
  ;; Slice 7b: the clause boundary (sriqclauses.slop). Each Table 1 form
  ;; is expanded from a hand-built one-axiom normal form, so the row reads
  ;; against Table 1 itself, not against S2's naming. Classes A, B, C and
  ;; individuals a, b are the input's; s has a P̄.
  ;; ------------------------------------------------------------

  (fn x-iri ((arena Arena) (local String))
    (@intent "urn:x:<local>")
    (@spec ((Arena String) -> IRI))
    (@alloc arena)
    (record-new IRI (value (string-concat arena "urn:x:" local))))

  (fn dn ((arena Arena) (local String))
    (@intent "The input class urn:x:<local>")
    (@spec ((Arena String) -> DName))
    (@alloc arena)
    (union-new DName dn-class (x-iri arena local)))

  (fn dp ((arena Arena) (local String))
    (@intent "The property urn:x:<local>")
    (@spec ((Arena String) -> DRole))
    (@alloc arena)
    (union-new DRole dr-prop (x-iri arena local)))

  (fn iris-of ((arena Arena) (locals (List String)))
    (@intent "urn:x:<local> for each")
    (@spec ((Arena (List String)) -> (List IRI)))
    (@alloc arena)
    (let ((mut out (list-new arena IRI))) (do (for-each (l locals) (list-push out (x-iri arena l))) out)))

  (fn strs ((arena Arena) (text String))
    (@intent "The words of a space-separated list")
    (@spec ((Arena String) -> (List String)))
    (@alloc arena)
    (let ((n (cast Int (string-len text)))
          (mut out (list-new arena String))
          (mut start 0)
          (mut i 0))
      (do
        (while (<= i n)
          (do
            (when (or (== i n) (== (cast Int (char-at text i)) 32))
              (do (when (> i start) (list-push out (substring arena text (cast (Int 0 ..) start) (cast (Int 0 ..) (- i start)))))
                  (set! start (+ i 1))))
            (set! i (+ i 1))))
        out)))

  (fn split-lines ((arena Arena) (text String))
    (@intent "The non-empty lines of a text")
    (@spec ((Arena String) -> (List String)))
    (@alloc arena)
    (let ((n (cast Int (string-len text)))
          (mut out (list-new arena String))
          (mut start 0)
          (mut i 0))
      (do
        (while (<= i n)
          (do
            (when (or (== i n) (== (cast Int (char-at text i)) 10))
              (do (when (> i start) (list-push out (substring arena text (cast (Int 0 ..) start) (cast (Int 0 ..) (- i start)))))
                  (set! start (+ i 1))))
            (set! i (+ i 1))))
        out)))

  (fn module-dump ((arena Arena) (path String) (seeds-path String))
    (@intent "module-dump FILE SEEDS: for each seed line (class IRIs), HOWL's ⊥-module of FILE (SPEC §8.4) as oracle module prints the OWL API's: the axiom count and the sorted symbols with the seed")
    (@spec ((Arena String String) -> Int))
    (@alloc arena)
    (match (file-text arena seeds-path)
      ((none) (do (println "cannot read the seeds") 2))
      ((some seeds)
        (let ((axs (file-axioms arena path)))
          (do
            (println "howl-modules 1")
            (for-each (line (split-lines arena seeds))
              (let ((scratch (arena-new 1048576)))
                (do
                  (dump-one-module scratch axs line)
                  (arena-free scratch))))
            0)))))

  (fn file-axioms ((arena Arena) (path String))
    (@intent "A file decoded as the answer run decodes it: its axioms, declarations included (they are local)")
    (@spec ((Arena String) -> (List RawAxiom)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (list-new arena RawAxiom))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (list-new arena RawAxiom))
          ((ok s0)
            (match (decode-axioms arena (. s0 dict) (. s0 triples))
              ((error _) (list-new arena RawAxiom))
              ((ok s1) (. s1 axioms))))))))

  (fn unreadable-count ((axs (List RawAxiom)))
    (@intent "How many axioms HOWL cannot read in full (SPEC §8.4 L3): with any in M, M's run is incomplete and the answer run falls back")
    (@spec (((List RawAxiom)) -> Int))
    (let ((mut n 0))
      (do (for-each (ax axs) (when (not (axiom-readable ax)) (set! n (+ n 1))))
          n)))

  (fn dump-one-module ((arena Arena) (axs (List RawAxiom)) (line String))
    (@intent "seed, axioms N, sym S... (sorted), end")
    (@spec ((Arena (List RawAxiom) String) -> Unit))
    (@alloc arena)
    (let ((words (strs arena line))
          (mut seed (list-new arena IRI)))
      (do
        (for-each (w words) (list-push seed (record-new IRI (value w))))
        (let ((m (module-axioms arena axs seed))
              (mut syms (list-new arena String)))
          (do
            (for-each (x (set-elements (. m symbols) :arena arena)) (list-push syms (. x value)))
            (print "seed ") (println line)
            (print "axioms ") (println (int-to-string arena (cast Int (list-len (. m axioms)))))
            (print "unreadable ") (println (int-to-string arena (unreadable-count (. m axioms))))
            (for-each (x (sort-strings arena syms)) (do (print "sym ") (println x)))
            (println "end"))))))

  (fn line1 ((arena Arena) (text String))
    (@intent "[text]")
    (@spec ((Arena String) -> (List String)))
    (@alloc arena)
    (let ((mut out (list-new arena String))) (do (list-push out text) out)))

  (fn row-normal ((arena Arena) (cs (List DlClause)) (nfresh Int) (nsub Int) (nfns Int))
    (@intent "A normal form over classes A, B, C and individuals a, b, with s's P̄, nfresh A_k, nsub S_{B₂} and nfns function symbols")
    (@spec ((Arena (List DlClause) Int Int Int) -> SriqNormal))
    (@alloc arena)
    (let ((top-filler (Option DName) (none))
          (mut concepts (list-new arena SConcept))
          (mut sroles (list-new arena DRole))
          (mut sfills (list-new arena (Option DName)))
          (mut k 0))
      (do
        (while (< k nfresh) (do (list-push concepts (union-new SConcept sc-top)) (set! k (+ k 1))))
        (set! k 0)
        (while (< k nsub) (do (list-push sroles (dp arena "r")) (list-push sfills top-filler) (set! k (+ k 1))))
        (record-new SriqNormal
          (clauses     cs)
          (concepts    concepts)
          (sroles      sroles)
          (sfills      sfills)
          (bars        (iris-of arena (strs arena "s")))
          (fns         (cast (Int 0 ..) nfns))
          (classes     (iris-of arena (strs arena "A B C")))
          (individuals (iris-of arena (strs arena "a b")))
          (omitted     (list-new arena RawAxiom))))))

  (fn clause-text ((arena Arena) (n SriqNormal))
    (@intent "The expanded clauses one per line, or the refusal")
    (@spec ((Arena SriqNormal) -> String))
    (@alloc arena)
    (match (sriq-clauses arena n)
      ((error m) (string-concat arena "error: " m))
      ((ok sc)
        (let ((mut out ""))
          (do (for-each (l (render-clauses arena sc)) (set! out (string-concat arena out (string-concat arena l "\n"))))
              out)))))

  (fn clauses-sound ((arena Arena) (n SriqNormal))
    (@intent "Every clause a DL-clause, and every id in range and round-tripping")
    (@spec ((Arena SriqNormal) -> Bool))
    (@alloc arena)
    (match (sriq-clauses arena n)
      ((error _) false)
      ((ok sc)
        (let ((mut ok (== (list-len (ids-dense arena sc)) 0)))
          (do (for-each (c (. sc clauses)) (when (not (and (dl-clause-shape c) (clause-canonical c))) (set! ok false)))
              ok)))))

  (fn table1-is ((arena Arena) (label String) (n SriqNormal) (want String))
    (@intent "One row: the expansion is exactly `want`, and sound. Prints the difference")
    (@spec ((Arena String SriqNormal String) -> Bool))
    (@alloc arena)
    (let ((got (clause-text arena n)))
      (cond
        ((not (string-eq got want))
          (do (print "  [table 1] ") (print label) (println ", got:") (print got) false))
        ((not (clauses-sound arena n))
          (do (print "  [table 1] ") (print label) (println ": not a DL-clause, or an id out of range") false))
        (else true))))

  (fn one-dl ((arena Arena) (c DlClause))
    (@intent "[c]")
    (@spec ((Arena DlClause) -> (List DlClause)))
    (@alloc arena)
    (let ((mut out (list-new arena DlClause))) (do (list-push out c) out)))

  (fn dl1-of ((arena Arena) (body String) (head String))
    (@intent "DL1 over input classes, A0 standing for the first fresh name")
    (@spec ((Arena String String) -> DlClause))
    (@alloc arena)
    (let ((mut b (list-new arena DName))
          (mut h (list-new arena DName)))
      (do
        (for-each (w (strs arena body)) (list-push b (if (string-eq w "A0") (union-new DName dn-fresh 0) (dn arena w))))
        (for-each (w (strs arena head)) (list-push h (if (string-eq w "A0") (union-new DName dn-fresh 0) (dn arena w))))
        (union-new DlClause dl1 (record-new Dl1 (body b) (head h))))))

  (fn fn-ids ((arena Arena) (n Int))
    (@intent "0 .. n−1")
    (@spec ((Arena Int) -> (List (Int 0 ..))))
    (@alloc arena)
    (let ((mut out (list-new arena (Int 0 ..))) (mut i 0))
      (do (while (< i n) (do (list-push out (cast (Int 0 ..) i)) (set! i (+ i 1)))) out)))

  (fn dl4-of ((arena Arena) (sub String) (n Int) (filler (Option DName)))
    (@intent "DL4 sub ⊑ ≤n r.filler through S_0")
    (@spec ((Arena String Int (Option DName)) -> DlClause))
    (@alloc arena)
    (union-new DlClause dl4 (record-new Dl4 (sub (dn arena sub)) (role (dp arena "r")) (count (cast (Int 0 ..) n))
                                            (filler filler) (srole (union-new DRole dr-sub 0)))))

  (fn dl2-of ((arena Arena) (sub String) (role DRole) (n Int) (filler (Option DName)))
    (@intent "DL2 sub ⊑ ≥n role.filler, with function symbols 0 .. n − 1")
    (@spec ((Arena String DRole Int (Option DName)) -> DlClause))
    (@alloc arena)
    (union-new DlClause dl2 (record-new Dl2 (sub (dn arena sub)) (role role) (count (cast (Int 1 ..) n))
                                            (filler filler) (fns (fn-ids arena n)))))

  (fn table1-rows-names ((arena Arena))
    (@intent "Table 1's DL1, DL2 and DL3, row by row")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((bar-s (union-new DRole dr-bar (x-iri arena "s")))
          (mut ok true))
      (do
        (when (not (table1-is arena "DL1" (row-normal arena (one-dl arena (dl1-of arena "A B" "C A0")) 1 0 0)
                     "urn:x:A(x) ∧ urn:x:B(x) → urn:x:C(x) ∨ A0(x)\n")) (set! ok false))
        (when (not (table1-is arena "DL1, empty body" (row-normal arena (one-dl arena (dl1-of arena "" "B A")) 0 0 0)
                     "⊤ → urn:x:A(x) ∨ urn:x:B(x)\n")) (set! ok false))
        (when (not (table1-is arena "DL1, empty head" (row-normal arena (one-dl arena (dl1-of arena "C A" "")) 0 0 0)
                     "urn:x:A(x) ∧ urn:x:C(x) → ⊥\n")) (set! ok false))
        (when (not (table1-is arena "DL2, n = 3"
                     (row-normal arena (one-dl arena (dl2-of arena "A" (dp arena "r") 3 (some (dn arena "B")))) 0 0 3)
                     "urn:x:A(x) → urn:x:B(f0(x))\nurn:x:A(x) → urn:x:B(f1(x))\nurn:x:A(x) → urn:x:B(f2(x))\nurn:x:A(x) → urn:x:r(x, f0(x))\nurn:x:A(x) → urn:x:r(x, f1(x))\nurn:x:A(x) → urn:x:r(x, f2(x))\nurn:x:A(x) → f1(x) ≉ f0(x)\nurn:x:A(x) → f2(x) ≉ f0(x)\nurn:x:A(x) → f2(x) ≉ f1(x)\n"))
          (set! ok false))
        (when (not (table1-is arena "DL2, filler ⊤, n = 2, over s̄"
                     (row-normal arena (one-dl arena (dl2-of arena "A" bar-s 2 (none))) 0 0 2)
                     "urn:x:A(x) → urn:x:s^bar(x, f0(x))\nurn:x:A(x) → urn:x:s^bar(x, f1(x))\nurn:x:A(x) → f1(x) ≉ f0(x)\n"))
          (set! ok false))
        (when (not (table1-is arena "DL3"
                     (row-normal arena (one-dl arena (union-new DlClause dl3 (dp arena "r") (dn arena "B") (dn arena "C"))) 0 0 0)
                     "urn:x:B(x) ∧ urn:x:r(z1, x) → urn:x:C(z1)\n"))
          (set! ok false))
        ok)))

  (fn table1-rows-dl4 ((arena Arena))
    (@intent "Table 1's DL4: n + 1 neighbours, ⊤ fillers, and a shared S_{B₂} clause")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (mut two (list-new arena DlClause)))
      (do
        (when (not (table1-is arena "DL4, n = 2" (row-normal arena (one-dl arena (dl4-of arena "A" 2 (some (dn arena "B")))) 0 1 0)
                     "urn:x:A(x) ∧ S0(x, z1) ∧ S0(x, z2) ∧ S0(x, z3) → z2 ≈ z1 ∨ z3 ≈ z1 ∨ z3 ≈ z2\nurn:x:B(x) ∧ urn:x:r(z1, x) → S0(z1, x)\n"))
          (set! ok false))
        (when (not (table1-is arena "DL4, filler ⊤, n = 0" (row-normal arena (one-dl arena (dl4-of arena "C" 0 (none))) 0 1 0)
                     "urn:x:C(x) ∧ S0(x, z1) → ⊥\nurn:x:r(z1, x) → S0(z1, x)\n"))
          (set! ok false))
        (list-push two (dl4-of arena "A" 1 (some (dn arena "B"))))
        (list-push two (dl4-of arena "C" 2 (some (dn arena "B"))))
        (when (not (table1-is arena "two DL4s sharing S_{B₂}" (row-normal arena two 0 1 0)
                     "urn:x:A(x) ∧ S0(x, z1) ∧ S0(x, z2) → z2 ≈ z1\nurn:x:B(x) ∧ urn:x:r(z1, x) → S0(z1, x)\nurn:x:C(x) ∧ S0(x, z1) ∧ S0(x, z2) ∧ S0(x, z3) → z2 ≈ z1 ∨ z3 ≈ z1 ∨ z3 ≈ z2\n"))
          (set! ok false))
        ok)))

  (fn table1-rows-roles ((arena Arena))
    (@intent "Table 1's DL5 to DL11, row by row")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((bar-s (union-new DRole dr-bar (x-iri arena "s")))
          (mut ok true))
      (do
        (when (not (table1-is arena "DL5" (row-normal arena (one-dl arena (union-new DlClause dl5 (dn arena "A") (dp arena "r"))) 0 0 0)
                     "urn:x:A(x) → urn:x:r(x, x)\n")) (set! ok false))
        (when (not (table1-is arena "DL6" (row-normal arena (one-dl arena (union-new DlClause dl6 (dp arena "r") (dn arena "B"))) 0 0 0)
                     "urn:x:r(x, x) → urn:x:B(x)\n")) (set! ok false))
        (when (not (table1-is arena "DL7" (row-normal arena (one-dl arena (union-new DlClause dl7 (dp arena "r") (dp arena "s"))) 0 0 0)
                     "urn:x:r(z1, x) → urn:x:s(z1, x)\n")) (set! ok false))
        (when (not (table1-is arena "DL8" (row-normal arena (one-dl arena (union-new DlClause dl8 (dp arena "r") bar-s)) 0 0 0)
                     "urn:x:r(z1, x) → urn:x:s^bar(x, z1)\n")) (set! ok false))
        (when (not (table1-is arena "DL9" (row-normal arena (one-dl arena (union-new DlClause dl9 (dp arena "s") (dp arena "r"))) 0 0 0)
                     "urn:x:r(z1, x) ∧ urn:x:s(z1, x) → ⊥\n")) (set! ok false))
        (when (not (table1-is arena "DL9 over one role: the body is a set" (row-normal arena (one-dl arena (union-new DlClause dl9 (dp arena "r") (dp arena "r"))) 0 0 0)
                     "urn:x:r(z1, x) → ⊥\n")) (set! ok false))
        (when (not (table1-is arena "DL10" (row-normal arena (one-dl arena (union-new DlClause dl10 (x-iri arena "a") (dn arena "B"))) 0 0 0)
                     "⊤ → urn:x:B(urn:x:a)\n")) (set! ok false))
        (when (not (table1-is arena "DL11" (row-normal arena (one-dl arena (union-new DlClause dl11 (dn arena "C") (x-iri arena "b"))) 0 0 0)
                     "urn:x:C(x) → urn:x:b ≈ x\n")) (set! ok false))
        ok)))

  (fn test-sriq-table1-rows ((arena Arena))
    (@intent "Every Table 1 form expands to exactly its DL-clauses over dense ids ([TGH21] Table 1, SPEC §5.5 S2)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (table1-rows-names arena))
          (b (table1-rows-dl4 arena))
          (c (table1-rows-roles arena)))
      (and a b c)))

  (fn boundary-refuses ((arena Arena) (label String) (n SriqNormal) (want String))
    (@intent "Is n refused with exactly `want`? Prints what it got")
    (@spec ((Arena String SriqNormal String) -> Bool))
    (@alloc arena)
    (let ((got (clause-text arena n)))
      (if (string-eq got (string-concat arena "error: the clause boundary has no id for " want))
        true
        (do (print "  [clauses] ") (print label) (print ": ") (println got) false))))

  (fn test-sriq-clauses-cover-every-name ((arena Arena))
    (@intent "A class or individual only a clause names gets an id in IRI order; a name no table can hold is refused with its text, never dropped")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((thing (union-new DName dn-class (record-new IRI (value "http://www.w3.org/2002/07/owl#Thing"))))
          (bar-r (union-new DRole dr-bar (x-iri arena "r")))
          (over-fns (dl2-of arena "A" (dp arena "r") 2 (none)))
          (mut ok true))
      (do
        ;; urn:x:AA sorts between A and B, so its id is 1, and B(x) follows it.
        (when (not (table1-is arena "an undeclared class" (row-normal arena (one-dl arena (dl1-of arena "B AA" "")) 0 0 0)
                     "urn:x:AA(x) ∧ urn:x:B(x) → ⊥\n")) (set! ok false))
        (when (not (table1-is arena "an undeclared individual"
                     (row-normal arena (one-dl arena (union-new DlClause dl10 (x-iri arena "aa") (dn arena "B"))) 0 0 0)
                     "⊤ → urn:x:B(urn:x:aa)\n")) (set! ok false))
        (when (not (boundary-refuses arena "owl:Thing as a name"
                     (row-normal arena (one-dl arena (union-new DlClause dl6 (dp arena "r") thing)) 0 0 0)
                     "class http://www.w3.org/2002/07/owl#Thing")) (set! ok false))
        (when (not (boundary-refuses arena "a P̄ S2 never made"
                     (row-normal arena (one-dl arena (union-new DlClause dl7 (dp arena "s") bar-r)) 0 0 0)
                     "role urn:x:r^bar")) (set! ok false))
        (when (not (boundary-refuses arena "a fresh name past concepts"
                     (row-normal arena (one-dl arena (dl1-of arena "A0" "B")) 0 0 0)
                     "class A0")) (set! ok false))
        (when (not (boundary-refuses arena "a function symbol past fns"
                     (row-normal arena (one-dl arena over-fns) 0 0 1)
                     "function symbol 1")) (set! ok false))
        ok)))

  (fn lits-of ((arena Arena) (a Lit) (b Lit) (c Lit))
    (@intent "[a, b, c]")
    (@spec ((Arena Lit Lit Lit) -> (List Lit)))
    (@alloc arena)
    (let ((mut out (list-new arena Lit))) (do (list-push out a) (list-push out b) (list-push out c) out)))

  (fn no-lits ((arena Arena))
    (@intent "[]")
    (@spec ((Arena) -> (List Lit)))
    (@alloc arena)
    (list-new arena Lit))

  (fn one-lit ((arena Arena) (a Lit))
    (@intent "[a]")
    (@spec ((Arena Lit) -> (List Lit)))
    (@alloc arena)
    (let ((mut out (list-new arena Lit))) (do (list-push out a) out)))

  (fn not-canonical ((body (List Lit)) (head (List Lit)))
    (@intent "Is the clause body → head, taken as written, rejected as non-canonical?")
    (@spec (((List Lit) (List Lit)) -> Bool))
    (@pure)
    (not (clause-canonical (record-new Clause (body body) (head head)))))

  (fn canonical-rejects ((arena Arena))
    (@intent "clause-canonical rejects a second record for a literal or a clause")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((b0 (cast U32 0)) (b1 (cast U32 1))
          (x (at-x)) (y (at-y)) (z1 (at-z (cast U32 1))))
      (and (not-canonical (no-lits arena) (one-lit arena (record-new Lit (form 'lf-unary) (pred b0) (t1 x) (t2 y))))
           (not-canonical (no-lits arena) (one-lit arena (record-new Lit (form 'lf-eq) (pred b0) (t1 x) (t2 z1))))
           (not-canonical (no-lits arena) (one-lit arena (record-new Lit (form 'lf-neq) (pred b0) (t1 x) (t2 z1))))
           (not-canonical (no-lits arena) (one-lit arena (record-new Lit (form 'lf-eq) (pred b1) (t1 z1) (t2 x))))
           (not-canonical (lits2-of arena (atom1 b1 x) (atom1 b0 x)) (no-lits arena))
           (not-canonical (lits2-of arena (atom1 b0 x) (atom1 b0 x)) (no-lits arena))
           (not-canonical (no-lits arena) (lits2-of arena (eq-lit z1 x) (atom1 b0 x)))
           ;; x with a function symbol in its unused slot, and z₀.
           (not-canonical (one-lit arena (atom1 b0 (record-new ATerm (kind 'ak-x) (fsym b1) (cst b0) (zi b0)))) (no-lits arena))
           (not-canonical (one-lit arena (atom2 b0 x (record-new ATerm (kind 'ak-z) (fsym b0) (cst b0) (zi b0)))) (no-lits arena))
           (not-canonical (no-lits arena) (one-lit arena (atom1 b0 (record-new ATerm (kind 'ak-fx) (fsym b0) (cst b1) (zi b0)))))
           (not-canonical (no-lits arena) (one-lit arena (atom1 b0 (record-new ATerm (kind 'ak-y) (fsym b0) (cst b1) (zi b0)))))
           (not-canonical (no-lits arena) (one-lit arena (atom1 b0 (record-new ATerm (kind 'ak-u) (fsym b1) (cst b0) (zi b0)))))
           (not-canonical (no-lits arena) (one-lit arena (atom1 b0 (record-new ATerm (kind 'ak-fu) (fsym b0) (cst b0) (zi b1))))))))

  (fn lits2-of ((arena Arena) (a Lit) (b Lit))
    (@intent "[a, b], as written")
    (@spec ((Arena Lit Lit) -> (List Lit)))
    (@alloc arena)
    (let ((mut out (list-new arena Lit))) (do (list-push out a) (list-push out b) out)))

  (fn index-classes ((arena Arena) (ds (List DName)))
    (@intent "Each input class of ds → its position")
    (@spec ((Arena (List DName)) -> (Map IRI U32)))
    (@alloc arena)
    (let ((mut m (map-new arena IRI U32))
          (mut i 0))
      (do
        (for-each (d ds)
          (do (match d ((dn-class c) (map-put m c (cast U32 i))) ((dn-fresh _) (do)))
              (set! i (+ i 1))))
        m)))

  (fn index-iris ((arena Arena) (xs (List IRI)))
    (@intent "Each IRI of xs → its position")
    (@spec ((Arena (List IRI)) -> (Map IRI U32)))
    (@alloc arena)
    (let ((mut m (map-new arena IRI U32))
          (mut i 0))
      (do (for-each (x xs) (do (map-put m x (cast U32 i)) (set! i (+ i 1)))) m)))

  (fn permuted-tables-flagged ((arena Arena) (ok-clause Clause))
    (@intent "ids-dense flags a role or constant table permuted together with its index: consistent, but not in content order")
    (@spec ((Arena Clause) -> Bool))
    (@alloc arena)
    ;; DL7 r ⊑ s names r and s; s has a P̄. So roles are [r, s, s̄]; put s
    ;; before r, indexes and all; or give r a P̄ too and put s̄ before r̄.
    ;; Constants [a, b] become [b, a].
    (let ((ids (build-sriq-ids arena (row-normal arena (one-dl arena (union-new DlClause dl7 (dp arena "r") (dp arena "s"))) 0 0 0)))
          (mut roles (list-new arena DRole))
          (mut consts (list-new arena IRI))
          (mut pr ids)
          (mut pb ids)
          (mut pc ids))
      (do
        (list-push roles (dp arena "s"))
        (list-push roles (dp arena "r"))
        (list-push roles (union-new DRole dr-bar (x-iri arena "s")))
        (set! pr role-of roles)
        (set! pr prop-ix (index-iris arena (iris-of arena (strs arena "s r"))))
        (list-push consts (x-iri arena "b"))
        (list-push consts (x-iri arena "a"))
        (set! pc const-of consts)
        (set! pc const-ix (index-iris arena consts))
        (set! pb role-of (bars-swapped arena))
        (set! pb sub0 4)
        (set! pb bar-ix (bar-index arena))
        (and (not (flagged arena ids ok-clause))
             (flagged arena pr ok-clause)
             (flagged arena pb ok-clause)
             (flagged arena pc ok-clause)))))

  (fn bars-swapped ((arena Arena))
    (@intent "Roles r, s, then s̄ before r̄: two P̄ out of P's order")
    (@spec ((Arena) -> (List DRole)))
    (@alloc arena)
    (let ((mut out (list-new arena DRole)))
      (do (list-push out (dp arena "r")) (list-push out (dp arena "s"))
          (list-push out (union-new DRole dr-bar (x-iri arena "s")))
          (list-push out (union-new DRole dr-bar (x-iri arena "r")))
          out)))

  (fn bar-index ((arena Arena))
    (@intent "s̄ → 2, r̄ → 3: consistent with bars-swapped")
    (@spec ((Arena) -> (Map IRI U32)))
    (@alloc arena)
    (let ((mut m (map-new arena IRI U32)))
      (do (map-put m (x-iri arena "s") (cast U32 2)) (map-put m (x-iri arena "r") (cast U32 3)) m)))

  (fn shape-rejects ((arena Arena))
    (@intent "dl-clause-shape takes TGH21 §2.3's DL-clauses and nothing else")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((b0 (cast U32 0))
          (x (at-x)) (z1 (at-z (cast U32 1))) (z2 (at-z (cast U32 2)))
          (fx (at-fx (cast U32 0))) (u (at-u (cast U32 0))) (y (at-y))
          (good (make-clause arena (lits-of arena (atom1 b0 x) (atom2 b0 x z1) (atom2 b0 z1 x))
                                   (lits-of arena (atom1 b0 fx) (atom2 b0 fx x) (neq-lit fx u))))
          (good2 (make-clause arena (one-lit arena (atom2 b0 x x))
                                    (lits-of arena (atom1 b0 u) (atom2 b0 x fx) (eq-lit z1 x)))))
      (and (dl-clause-shape good)
           (dl-clause-shape good2)
           (not (dl-clause-shape (make-clause arena (one-lit arena (atom1 b0 fx)) (no-lits arena))))
           (not (dl-clause-shape (make-clause arena (one-lit arena (atom2 b0 z1 z2)) (no-lits arena))))
           (not (dl-clause-shape (make-clause arena (one-lit arena (atom1 b0 y)) (no-lits arena))))
           (not (dl-clause-shape (make-clause arena (one-lit arena (eq-lit x z1)) (no-lits arena))))
           (not (dl-clause-shape (make-clause arena (no-lits arena) (one-lit arena (atom1 b0 y)))))
           (not (dl-clause-shape (make-clause arena (no-lits arena) (one-lit arena (atom2 b0 fx z1)))))
           (not (dl-clause-shape (make-clause arena (no-lits arena) (one-lit arena (eq-lit y x)))))
           (clause-canonical good)
           (clause-canonical good2)
           (canonical-rejects arena))))

  (fn flagged ((arena Arena) (ids SriqIds) (c Clause))
    (@intent "Does ids-dense flag an ontology of the one clause c?")
    (@spec ((Arena SriqIds Clause) -> Bool))
    (@alloc arena)
    (let ((mut cs (list-new arena Clause)))
      (do (list-push cs c)
          (> (list-len (ids-dense arena (record-new SriqClauses (ids ids) (clauses cs)))) 0))))

  (fn ids-dense-rejects ((arena Arena))
    (@intent "ids-dense flags an id out of range in each slot, and a table that does not round-trip")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Classes A, B, C; roles r and s̄ (DL5 names r; s has a P̄); no
    ;; function symbols; constants a and b. Not `far`: MinGW's windows.h,
    ;; which the runtime includes on Windows, defines it as a macro.
    (let ((ids (build-sriq-ids arena (row-normal arena (one-dl arena (union-new DlClause dl5 (dn arena "A") (dp arena "r"))) 0 0 0)))
          (out-of-range (cast U32 99))
          (x (at-x))
          (ok-clause (make-clause arena (one-lit arena (atom1 (cast U32 2) x)) (one-lit arena (atom2 (cast U32 1) x (at-u (cast U32 1))))))
          (mut swapped ids)
          (mut permuted ids))
      (do
        (set! swapped class-of (reverse-dnames arena (. ids class-of)))
        (set! permuted class-of (reverse-dnames arena (. ids class-of)))
        (set! permuted class-ix (index-classes arena (. permuted class-of)))
        (and (not (flagged arena ids ok-clause))
             (flagged arena ids (make-clause arena (one-lit arena (atom1 out-of-range x)) (no-lits arena)))
             (flagged arena ids (make-clause arena (one-lit arena (atom2 out-of-range x x)) (no-lits arena)))
             (flagged arena ids (make-clause arena (no-lits arena) (one-lit arena (atom1 (cast U32 0) (at-fx (cast U32 0))))))
             (flagged arena ids (make-clause arena (no-lits arena) (one-lit arena (atom1 (cast U32 0) (at-u (cast U32 2))))))
             (flagged arena ids (make-clause arena (no-lits arena) (one-lit arena (atom1 (cast U32 0) (at-z (cast U32 0))))))
             (flagged arena swapped ok-clause)
             (flagged arena permuted ok-clause)
             (permuted-tables-flagged arena ok-clause)))))

  (fn reverse-dnames ((arena Arena) (xs (List DName)))
    (@intent "xs backwards")
    (@spec ((Arena (List DName)) -> (List DName)))
    (@alloc arena)
    (let ((mut out (list-new arena DName))
          (mut i (- (cast Int (list-len xs)) 1)))
      (do
        (while (>= i 0)
          (do (match (list-get xs i) ((some d) (list-push out d)) ((none) (do)))
              (set! i (- i 1))))
        out)))

  (fn test-sriq-clause-checks-reject ((arena Arena))
    (@intent "The boundary's own checks reject what they exist to reject: a clause outside §2.3's shapes, an id out of range, a table that does not round-trip")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (shape-rejects arena))
          (b (ids-dense-rejects arena)))
      (do (when (not a) (println "  [clauses] dl-clause-shape takes or refuses the wrong clause"))
          (when (not b) (println "  [clauses] ids-dense misses a broken id or table"))
          (and a b))))

  (fn sample-aterms ((arena Arena))
    (@intent "One a-term of each kind, two where an id varies")
    (@spec ((Arena) -> (List ATerm)))
    (@alloc arena)
    (let ((mut out (list-new arena ATerm)))
      (do
        (list-push out (at-x)) (list-push out (at-y))
        (list-push out (at-z (cast U32 1))) (list-push out (at-z (cast U32 2)))
        (list-push out (at-fx (cast U32 0))) (list-push out (at-fx (cast U32 1)))
        (list-push out (at-u (cast U32 0))) (list-push out (at-u (cast U32 1)))
        (list-push out (at-fu (cast U32 0) (cast U32 1))) (list-push out (at-fu (cast U32 1) (cast U32 0)))
        out)))

  (fn oriented-pair-ok ((s ATerm) (t ATerm) (same Bool))
    (@intent "s ⋈ t and t ⋈ s are one literal; ≈ and ≉ differ; the larger a-term is first; aterm-cmp is antisymmetric")
    (@spec ((ATerm ATerm Bool) -> Bool))
    (@pure)
    (and (lit-eq (eq-lit s t) (eq-lit t s))
         (lit-eq (neq-lit s t) (neq-lit t s))
         (not (lit-eq (eq-lit s t) (neq-lit s t)))
         (>= (aterm-cmp (. (eq-lit s t) t1) (. (eq-lit s t) t2)) 0)
         (== (aterm-cmp s t) (- 0 (aterm-cmp t s)))
         (== (== (aterm-cmp s t) 0) same)))

  (fn test-sriq-eq-orientation ((arena Arena))
    (@intent "§2.1's \"t1 ⋈ t2 is identical to t2 ⋈ t1\": one record either way round, over every pair of a-term kinds")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((ts (sample-aterms arena))
          (mut ok true)
          (mut i 0))
      (do
        (for-each (s ts)
          (let ((mut j 0))
            (do
              (for-each (t ts)
                (do (when (not (oriented-pair-ok s t (== i j)))
                      (do (print "  [orientation] pair ") (print (int-to-string arena i)) (print " ")
                          (println (int-to-string arena j)) (set! ok false)))
                    (set! j (+ j 1))))
              (set! i (+ i 1)))))
        ok)))

  (fn clause-lines ((arena Arena) (r (Result SriqNormal String)))
    (@intent "A normal form's expanded clauses, or its refusal, as lines")
    (@spec ((Arena (Result SriqNormal String)) -> (List String)))
    (@alloc arena)
    (match r
      ((error m) (line1 arena (string-concat arena "error: " m)))
      ((ok n)
        (match (sriq-clauses arena n)
          ((error m) (line1 arena (string-concat arena "error: " m)))
          ((ok sc)   (render-clauses arena sc))))))

  (fn fixture-clauses-ok ((arena Arena) (path String))
    (@intent "One fixture: every clause a DL-clause, every id in range, and the same clauses under reordered input")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-sriq)
      ((none) (do (print "  [clauses] did not gate: ") (println path) false))
      ((some gr)
        (let ((n0 (sriq-nf arena gr false false false))
              (l0 (clause-lines arena n0))
              (l1 (clause-lines arena (sriq-nf arena gr true false false)))
              (l2 (clause-lines arena (sriq-nf arena gr false true false)))
              (l3 (clause-lines arena (sriq-nf arena gr false false true))))
          (match n0
            ((error m) (do (print "  [clauses] refused: ") (print path) (print " ") (println m) false))
            ((ok n)
              (cond
                ((not (clauses-sound arena n))
                  (do (print "  [clauses] not DL-clauses, or ids out of range: ") (println path) false))
                ((not (and (same-lines l0 l1) (same-lines l0 l2) (same-lines l0 l3)))
                  (do (print "  [clauses] reordered input differs: ") (println path) false))
                (else true))))))))

  (fn test-sriq-clauses-on-fixtures ((arena Arena))
    (@intent "On every sriq fixture: DL-clauses, dense ids from content, and the same clauses under reordered input")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do (for-each (p (sriq-fixtures arena)) (when (not (fixture-clauses-ok arena p)) (set! ok false)))
          ok)))

  ;; ------------------------------------------------------------
  ;; Slice 7c: the context order (sriqorder.slop). The constants: a and
  ;; b, named (ids 0, 1), and Nom's a·S0², b·S0¹, a·S0¹, a·S0²·S0¹,
  ;; a·S0¹·S1¹ and a·S1¹ (ids 2 to 7), numbered out of ⋗'s order on
  ;; purpose: ⋗ ascending is 0, 1, 4, 2, 7, 3, 6, 5. Ids 5 and 6 differ in
  ;; both letters, the last one the other way round, so the letter nearest
  ;; the base must decide; a·S1¹ is above a·S0² by its role, below it by i.
  ;; ------------------------------------------------------------

  (fn ord-table ((arena Arena))
    (@intent "The order over the test's eight constants")
    (@spec ((Arena) -> SriqOrder))
    (@alloc arena)
    (let ((base (named-consts arena 2))
          (a (const-entry base (cast U32 0)))
          (b (const-entry base (cast U32 1)))
          (a2 (aux-const a (cast U32 0) (cast U32 0) (cast U32 2)))
          (b1 (aux-const b (cast U32 1) (cast U32 0) (cast U32 1)))
          (a1 (aux-const a (cast U32 0) (cast U32 0) (cast U32 1)))
          (mut cs (list-new arena ConstEntry)))
      (do
        (list-push cs a) (list-push cs b) (list-push cs a2) (list-push cs b1) (list-push cs a1)
        (list-push cs (aux-const a2 (cast U32 2) (cast U32 0) (cast U32 1)))
        (list-push cs (aux-const a1 (cast U32 4) (cast U32 1) (cast U32 1)))
        (list-push cs (aux-const a (cast U32 0) (cast U32 1) (cast U32 1)))
        (record-new SriqOrder (consts cs) (rank -1)))))

  (fn ord-label ((arena Arena) (ord SriqOrder) (u U32))
    (@intent "u's label as letters S·1000 + i, from the base")
    (@spec ((Arena SriqOrder U32) -> (List Int)))
    (@alloc arena)
    (let ((mut back (list-new arena Int))
          (mut out (list-new arena Int))
          (mut c u)
          (mut k (cast Int (. (const-entry ord u) len))))
      (do
        (while (> k 0)
          (let ((e (const-entry ord c)))
            (do (list-push back (+ (* (cast Int (. e srole)) 1000) (cast Int (. e i))))
                (set! c (. e parent))
                (set! k (- k 1)))))
        (let ((mut j (- (cast Int (list-len back)) 1)))
          (while (>= j 0)
            (do (list-push out (int-at back j)) (set! j (- j 1)))))
        out)))

  (fn ord-ints-cmp ((a (List Int)) (b (List Int)))
    (@intent "Lexicographic on equally long lists")
    (@spec (((List Int) (List Int)) -> Int))
    (@pure)
    (let ((mut r 0) (mut i 0))
      (do
        (while (and (== r 0) (< i (cast Int (list-len a))))
          (do (set! r (cond ((< (int-at a i) (int-at b i)) -1) ((> (int-at a i) (int-at b i)) 1) (else 0)))
              (set! i (+ i 1))))
        r)))

  (fn ref-const-gt ((arena Arena) (ord SriqOrder) (a U32) (b U32))
    (@intent "⋗ on constants from S5's words: longer label, then later base, then the label from the base")
    (@spec ((Arena SriqOrder U32 U32) -> Bool))
    (@alloc arena)
    (let ((ea (const-entry ord a)) (eb (const-entry ord b)))
      (cond
        ((!= (. ea len) (. eb len)) (> (. ea len) (. eb len)))
        ((!= (. ea base) (. eb base)) (> (. ea base) (. eb base)))
        (else (> (ord-ints-cmp (ord-label arena ord a) (ord-label arena ord b)) 0)))))

  (fn ref-is-var ((t ATerm))
    (@intent "x or y")
    (@spec ((ATerm) -> Bool))
    (@pure)
    (or (== (. t kind) 'ak-x) (== (. t kind) 'ak-y)))

  (fn ref-has-arg ((t ATerm))
    (@intent "f(x) or f(u)")
    (@spec ((ATerm) -> Bool))
    (@pure)
    (or (== (. t kind) 'ak-fx) (== (. t kind) 'ak-fu)))

  (fn ref-arg ((t ATerm))
    (@intent "The argument of f(x) or f(u)")
    (@spec ((ATerm) -> ATerm))
    (@pure)
    (if (== (. t kind) 'ak-fx) (at-x) (at-u (. t cst))))

  (fn ref-prec-gt ((arena Arena) (ord SriqOrder) (a ATerm) (b ATerm))
    (@intent "⋗ on the head symbols of two non-variable a-terms: functions above constants, functions by id")
    (@spec ((Arena SriqOrder ATerm ATerm) -> Bool))
    (@alloc arena)
    (cond
      ((and (ref-has-arg a) (ref-has-arg b)) (> (. a fsym) (. b fsym)))
      ((ref-has-arg a) true)
      ((ref-has-arg b) false)
      (else (ref-const-gt arena ord (. a cst) (. b cst)))))

  (fn ref-same-head ((a ATerm) (b ATerm))
    (@intent "The same head symbol")
    (@spec ((ATerm ATerm) -> Bool))
    (@pure)
    (if (and (ref-has-arg a) (ref-has-arg b)) (== (. a fsym) (. b fsym))
        (and (not (ref-has-arg a)) (not (ref-has-arg b)) (== (. a cst) (. b cst)))))

  (fn ref-lpo ((arena Arena) (ord SriqOrder) (s ATerm) (t ATerm))
    (@intent "The lexicographic path order induced by ⋗ ([TGH21] §2.2), literally, over x, y, f(x), u and f(u)")
    (@spec ((Arena SriqOrder ATerm ATerm) -> Bool))
    (@alloc arena)
    (cond
      ;; t a variable: it occurs in s, and s is not t.
      ((ref-is-var t) (and (== (. s kind) 'ak-fx) (== (. t kind) 'ak-x)))
      ((ref-is-var s) false)
      ;; Case 3: an argument of s is ⪰ t.
      ((and (ref-has-arg s) (or (ord-aterm-same (ref-arg s) t) (ref-lpo arena ord (ref-arg s) t))) true)
      ;; Case 1: s's head ⋗ t's, and s ≻ each argument of t.
      ((ref-prec-gt arena ord s t) (or (not (ref-has-arg t)) (ref-lpo arena ord s (ref-arg t))))
      ;; Case 2: the same head, the first argument greater, and s ≻ it.
      ((and (ref-same-head s t) (ref-has-arg s))
        (and (ref-lpo arena ord (ref-arg s) (ref-arg t)) (ref-lpo arena ord s (ref-arg t))))
      (else false)))

  (fn ord-aterm-same ((a ATerm) (b ATerm))
    (@intent "The same a-term")
    (@spec ((ATerm ATerm) -> Bool))
    (@pure)
    (and (== (. a kind) (. b kind)) (== (. a fsym) (. b fsym)) (== (. a cst) (. b cst)) (== (. a zi) (. b zi))))

  (fn ord-aterms ((arena Arena))
    (@intent "The universe's a-terms: x, y, f0(x), f1(x), every constant, and f0(u) and f1(u) for every constant u")
    (@spec ((Arena) -> (List ATerm)))
    (@alloc arena)
    (let ((mut out (list-new arena ATerm))
          (mut k 0))
      (do
        (list-push out (at-x)) (list-push out (at-y))
        (list-push out (at-fx (cast U32 0))) (list-push out (at-fx (cast U32 1)))
        (while (< k 8) (do (list-push out (at-u (cast U32 k))) (set! k (+ k 1))))
        (set! k 0)
        (while (< k 8)
          (do (list-push out (at-fu (cast U32 0) (cast U32 k))) (list-push out (at-fu (cast U32 1) (cast U32 k)))
              (set! k (+ k 1))))
        out)))

  (fn ord-push-binary ((arena Arena) (out (List CTerm)) (l ATerm) (r ATerm))
    (@intent "out with S0(l, r) added")
    (@spec ((Arena (List CTerm) ATerm ATerm) -> (List CTerm)))
    (@alloc arena)
    (let ((mut o out)) (do (list-push o (ct-p (atom2 (cast U32 0) l r))) o)))

  (fn ord-universe ((arena Arena))
    (@intent "Definition 2's context terms over the test signature: true, the a-terms, B0 and B1 of each, and S0's two families")
    (@spec ((Arena) -> (List CTerm)))
    (@alloc arena)
    (ord-universe-n arena 2))

  (fn ord-universe-n ((arena Arena) (npred Int))
    (@intent "ord-universe with classes B0 to B(npred - 1)")
    (@spec ((Arena Int) -> (List CTerm)))
    (@alloc arena)
    (let ((as (ord-aterms arena))
          (mut out (list-new arena CTerm)))
      (do
        (list-push out (ct-true))
        (for-each (t as) (list-push out (ct-a t)))
        (for-each (t as)
          (let ((mut b 0))
            (while (< b npred) (do (list-push out (ct-p (atom1 (cast U32 b) t))) (set! b (+ b 1))))))
        ;; S(x, t) and S(t, x) for t in x, y, f(x), u.
        (for-each (t as)
          (when (not (== (. t kind) 'ak-fu))
            (do (set! out (ord-push-binary arena out (at-x) t))
                (when (not (== (. t kind) 'ak-x)) (set! out (ord-push-binary arena out t (at-x)))))))
        ;; S(u, t) and S(t, u) for t in y, a constant, f(u).
        (for-each (u as)
          (when (== (. u kind) 'ak-u)
            (for-each (t as)
              (when (or (== (. t kind) 'ak-y) (== (. t kind) 'ak-u) (== (. t kind) 'ak-fu))
                (do (set! out (ord-push-binary arena out u t))
                    (when (not (== (. t kind) 'ak-u)) (set! out (ord-push-binary arena out t u))))))))
        out)))

  (fn ord-ct-at ((xs (List CTerm)) (i Int))
    (@intent "Element i, or true")
    (@spec (((List CTerm) Int) -> CTerm))
    (@pure)
    (match (list-get xs i) ((some c) c) ((none) (ct-true))))

  (fn ord-get ((m (List Bool)) (n Int) (i Int) (j Int))
    (@intent "m[i][j]")
    (@spec (((List Bool) Int Int Int) -> Bool))
    (@pure)
    (match (list-get m (+ (* i n) j)) ((some b) b) ((none) false)))

  (fn ord-ge ((m (List Bool)) (n Int) (u (List CTerm)) (i Int) (j Int))
    (@intent "i ⪰ j under m: the same term, or m[i][j]")
    (@spec (((List Bool) Int (List CTerm) Int Int) -> Bool))
    (@pure)
    (or (== i j) (ord-get m n i j)))

  (fn ord-index ((u (List CTerm)) (t ATerm))
    (@intent "The universe index of the a-term t, or -1")
    (@spec (((List CTerm) ATerm) -> Int))
    (@pure)
    (let ((mut r -1) (mut i 0))
      (do (for-each (c u) (do (when (and (== r -1) (== (. c ck) 'ck-a) (ord-aterm-same (. c a) t)) (set! r i)) (set! i (+ i 1)))) r)))

  (fn ord-arg-ge ((m (List Bool)) (n Int) (u (List CTerm)) (arg ATerm) (j Int))
    (@intent "Item 6's A|p ⪰ s, for one argument of A and its own argument, under m")
    (@spec (((List Bool) Int (List CTerm) ATerm Int) -> Bool))
    (@pure)
    (let ((ia (ord-index u arg))
          (inner (if (ref-has-arg arg) (ord-index u (ref-arg arg)) -1)))
      (or (and (>= ia 0) (ord-ge m n u ia j))
          (and (>= inner 0) (ord-ge m n u inner j)))))

  (fn ord-p-args-le ((m (List Bool)) (n Int) (u (List CTerm)) (a Lit) (b Lit))
    (@intent "Item 7: b is a with each a-term the same or smaller under m, and not all the same")
    (@spec (((List Bool) Int (List CTerm) Lit Lit) -> Bool))
    (@pure)
    (let ((a1 (ord-index u (. a t1))) (b1 (ord-index u (. b t1)))
          (a2 (ord-index u (. a t2))) (b2 (ord-index u (. b t2)))
          (one (and (>= a1 0) (>= b1 0) (ord-ge m n u a1 b1)))
          (two (or (== (. a form) 'lf-unary) (and (>= a2 0) (>= b2 0) (ord-ge m n u a2 b2))))
          (same (and (== a1 b1) (or (== (. a form) 'lf-unary) (== a2 b2)))))
      (and (== (. a form) (. b form)) (== (. a pred) (. b pred)) one two (not same))))

  (fn ord-generated ((arena Arena) (ord SriqOrder) (m (List Bool)) (n Int) (u (List CTerm)) (i Int) (j Int))
    (@intent "Is i ≻ j one of the generating comparisons, items 6 and 7 read under m?")
    (@spec ((Arena SriqOrder (List Bool) Int (List CTerm) Int Int) -> Bool))
    (@alloc arena)
    (let ((s (ord-ct-at u i)) (t (ord-ct-at u j)))
      (cond
        ((== i j) false)
        ((== (. t ck) 'ck-true) (not (== (. s ck) 'ck-true)))
        ((and (== (. s ck) 'ck-a) (== (. t ck) 'ck-a))
          (or (ref-lpo arena ord (. s a) (. t a)) (ord-items-1-3 arena ord (. s a) (. t a))))
        ((and (== (. s ck) 'ck-p) (== (. t ck) 'ck-a))
          (or (ref-is-var (. t a))
              (ord-arg-ge m n u (. (. s p) t1) j)
              (and (== (. (. s p) form) 'lf-binary) (ord-arg-ge m n u (. (. s p) t2) j))))
        ((and (== (. s ck) 'ck-p) (== (. t ck) 'ck-p))
          (or (ord-p-args-le m n u (. s p) (. t p)) (ord-rank-step ord (. s p) (. t p))))
        (else false))))

  (fn ord-rank-step ((ord SriqOrder) (a Lit) (b Lit))
    (@intent "The ranked order's generating comparison (slice 9g): F(x) ≻ G(x) when F ranks above G")
    (@spec ((SriqOrder Lit Lit) -> Bool))
    (@pure)
    ;; Written from SPEC §5.5 S5, not from rank-gt: F is fresh (id from the
    ;; rank), and G is a query class or a fresh name of smaller id.
    (let ((r (. ord rank)) (f (cast Int (. a pred))) (g (cast Int (. b pred))))
      (and (== (. a form) 'lf-unary) (== (. b form) 'lf-unary)
           (== (. (. a t1) kind) 'ak-x) (== (. (. b t1) kind) 'ak-x)
           (>= r 0) (>= f r) (or (< g r) (> f g)))))

  (fn ord-items-1-3 ((arena Arena) (ord SriqOrder) (s ATerm) (t ATerm))
    (@intent "§4.2's items 1 to 3: x ≻ y; f(x) ≻ g(x) for f ⋗ g; f(x) ≻ each constant, x and y")
    (@spec ((Arena SriqOrder ATerm ATerm) -> Bool))
    (@alloc arena)
    (or (and (== (. s kind) 'ak-x) (== (. t kind) 'ak-y))
        (and (== (. s kind) 'ak-fx) (== (. t kind) 'ak-fx) (> (. s fsym) (. t fsym)))
        (and (== (. s kind) 'ak-fx) (or (ref-is-var t) (== (. t kind) 'ak-u)))))

  (fn ord-step ((arena Arena) (ord SriqOrder) (m (List Bool)) (n Int) (u (List CTerm)))
    (@intent "One round: every generating comparison under m, then the transitive closure; m is not changed")
    (@spec ((Arena SriqOrder (List Bool) Int (List CTerm)) -> (List Bool)))
    (@alloc arena)
    (let ((mut r (list-new arena Bool)) (mut i 0))
      (do
        (while (< i (* n n))
          (do (list-push r (or (ord-get m n (/ i n) (% i n)) (ord-generated arena ord m n u (/ i n) (% i n))))
              (set! i (+ i 1))))
        (ord-close r n))))

  (fn ord-close ((m (List Bool)) (n Int))
    (@intent "m closed under transitivity, in place (Floyd–Warshall)")
    (@spec (((List Bool) Int) -> (List Bool)))
    (let ((mut k 0))
      (do
        (while (< k n)
          (let ((mut i 0))
            (do (while (< i n)
                  (do (when (ord-get m n i k) (ord-close-row m n i k))
                      (set! i (+ i 1))))
                (set! k (+ k 1)))))
        m)))

  (fn ord-close-row ((m (List Bool)) (n Int) (i Int) (k Int))
    (@intent "Row i gains row k: i ≻ k and k ≻ j give i ≻ j")
    (@spec (((List Bool) Int Int Int) -> Bool))
    (let ((mut j 0))
      (do (while (< j n)
            (do (when (ord-get m n k j) (list-set m (+ (* i n) j) true))
                (set! j (+ j 1))))
          true)))

  (fn ord-count ((m (List Bool)))
    (@intent "How many comparisons m holds")
    (@spec (((List Bool)) -> Int))
    (@pure)
    (let ((mut c 0)) (do (for-each (b m) (when b (set! c (+ c 1)))) c)))

  (fn ord-least ((arena Arena) (ord SriqOrder) (u (List CTerm)))
    (@intent "The least order containing the LPO and items 1 to 7 over u: rounds until nothing is added")
    (@spec ((Arena SriqOrder (List CTerm)) -> (List Bool)))
    (@alloc arena)
    (let ((n (cast Int (list-len u)))
          (mut m (list-new arena Bool))
          (mut i 0)
          (mut last -1))
      (do
        (while (< i (* n n)) (do (list-push m false) (set! i (+ i 1))))
        (while (!= last (ord-count m))
          (do (set! last (ord-count m))
              (set! m (ord-step arena ord m n u))))
        m)))

  (fn ct-text ((arena Arena) (c CTerm))
    (@intent "A context term, briefly, for failure messages")
    (@spec ((Arena CTerm) -> String))
    (@alloc arena)
    (let ((a (. c a)) (p (. c p)))
      (match (. c ck)
        ('ck-true "true")
        ('ck-a (string-concat arena "a" (aterm-code arena a)))
        ('ck-p (string-concat arena (if (== (. p form) 'lf-unary) "B" "S")
                 (string-concat arena (int-to-string arena (cast Int (. p pred)))
                   (string-concat arena (aterm-code arena (. p t1)) (if (== (. p form) 'lf-unary) "" (aterm-code arena (. p t2))))))))))

  (fn aterm-code ((arena Arena) (t ATerm))
    (@intent "(kind f u i)")
    (@spec ((Arena ATerm) -> String))
    (@alloc arena)
    (string-concat arena "(" (string-concat arena (int-to-string arena (akind-code (. t kind)))
      (string-concat arena " " (string-concat arena (int-to-string arena (cast Int (. t fsym)))
        (string-concat arena " " (string-concat arena (int-to-string arena (cast Int (. t cst))) ")")))))))

  (fn akind-code ((k AKind))
    (@intent "x 0, y 1, z 2, f(x) 3, u 4, f(u) 5")
    (@spec ((AKind) -> Int))
    (@pure)
    (match k ('ak-x 0) ('ak-y 1) ('ak-z 2) ('ak-fx 3) ('ak-u 4) ('ak-fu 5)))

  (fn test-sriq-order-closure ((arena Arena))
    (@intent "The case table is the least order containing the LPO and §4.2's items 1 to 7, pair by pair over Definition 2's terms")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (order-closure-on arena (ord-table arena) (ord-universe arena)))

  (fn test-sriq-ranked-order-closure ((arena Arena))
    (@intent "The ranked table (B0, B1 query classes; B2, B3 fresh) is the least order containing Sequoia's and the precedence")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (order-closure-on arena (ranked (ord-table arena) 2) (ord-universe-n arena 4)))

  (fn order-closure-on ((arena Arena) (ord SriqOrder) (u (List CTerm)))
    (@intent "The table under ord is the least order generated over u, pair by pair")
    (@spec ((Arena SriqOrder (List CTerm)) -> Bool))
    (@alloc arena)
    (let ((n (cast Int (list-len u)))
          (m (ord-least arena ord u))
          (mut bad 0)
          (mut i 0))
      (do
        (while (< i n)
          (do (set! bad (+ bad (ord-row-mismatches arena ord u m i bad)))
              (set! i (+ i 1))))
        (when (< (ord-count m) 100) (println "  [order] the closure is suspiciously small"))
        (and (== bad 0) (>= (ord-count m) 100)))))

  (fn ord-row-mismatches ((arena Arena) (ord SriqOrder) (u (List CTerm)) (m (List Bool)) (i Int) (seen Int))
    (@intent "How many j the table and the closure disagree on for i ≻ j; the first few printed")
    (@spec ((Arena SriqOrder (List CTerm) (List Bool) Int Int) -> Int))
    (@alloc arena)
    (let ((n (cast Int (list-len u)))
          (mut bad 0)
          (mut j 0))
      (do
        (while (< j n)
          (do (when (!= (ord-get m n i j) (cterm-gt ord (ord-ct-at u i) (ord-ct-at u j)))
                (do (when (< (+ seen bad) 8)
                      (do (print "  [order] closure ") (if (ord-get m n i j) (print "has ") (print "lacks "))
                          (print (ct-text arena (ord-ct-at u i))) (print " > ") (println (ct-text arena (ord-ct-at u j)))))
                    (set! bad (+ bad 1))))
              (set! j (+ j 1))))
        bad)))

  (fn test-sriq-order-strict-and-admissible ((arena Arena))
    (@intent "Over the universe the table is a strict order, and admissible (Definition 7, 1 to 3 and 5) with ⋗ as S5 pins it")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (order-strict-on arena (ord-table arena) (ord-universe arena)))

  (fn test-sriq-ranked-order-strict-and-admissible ((arena Arena))
    (@intent "The ranked table is a strict order and admissible (Definition 7, 1 to 3 and 5) over the four-class universe")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (order-strict-on arena (ranked (ord-table arena) 2) (ord-universe-n arena 4)))

  (fn order-strict-on ((arena Arena) (ord SriqOrder) (u (List CTerm)))
    (@intent "Strict and admissible under ord over u")
    (@spec ((Arena SriqOrder (List CTerm)) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (for-each (s u)
          (do
            (when (cterm-gt ord s s) (do (print "  [order] reflexive at ") (println (ct-text arena s)) (set! ok false)))
            (when (and (not (== (. s ck) 'ck-true)) (not (cterm-gt ord s (ct-true))))
              (do (print "  [order] not above true: ") (println (ct-text arena s)) (set! ok false)))
            (for-each (t u)
              (when (not (ord-pair-ok arena ord u s t)) (set! ok false)))
            ;; zᵢ is an ontology clause's variable: never compared.
            (when (and (== (. s ck) 'ck-a)
                       (or (aterm-gt ord (at-z (cast U32 1)) (. s a)) (aterm-gt ord (. s a) (at-z (cast U32 1)))))
              (do (print "  [order] compared with z1: ") (println (ct-text arena s)) (set! ok false)))))
        ok)))

  (fn ord-pair-ok ((arena Arena) (ord SriqOrder) (u (List CTerm)) (s CTerm) (t CTerm))
    (@intent "Asymmetry and transitivity through every r, and Definition 7's items 2 and 3, for one pair")
    (@spec ((Arena SriqOrder (List CTerm) CTerm CTerm) -> Bool))
    (@alloc arena)
    (let ((st (cterm-gt ord s t))
          (mut ok true))
      (do
        (when (and st (cterm-gt ord t s)) (set! ok false))
        (when st (for-each (r u) (when (and (cterm-gt ord t r) (not (cterm-gt ord s r))) (set! ok false))))
        ;; Def. 7(2): a p-term is above x; no constant is above a p-term.
        (when (and (== (. s ck) 'ck-p) (== (. t ck) 'ck-a) (== (. (. t a) kind) 'ak-x) (not st)) (set! ok false))
        (when (and (== (. s ck) 'ck-a) (== (. (. s a) kind) 'ak-u) (== (. t ck) 'ck-p) st) (set! ok false))
        ;; Def. 7(3): the LPO is contained; x and y never meet a constant.
        (when (and (== (. s ck) 'ck-a) (== (. t ck) 'ck-a) (ref-lpo arena ord (. s a) (. t a)) (not st)) (set! ok false))
        (when (and (== (. s ck) 'ck-a) (== (. t ck) 'ck-a)
                   (or (and (ref-is-var (. s a)) (== (. (. t a) kind) 'ak-u))
                       (and (== (. (. s a) kind) 'ak-u) (ref-is-var (. t a))))
                   st)
          (set! ok false))
        ;; Def. 7(5): a function-free p-term mentioning y or a constant is
        ;; above a p-term only when that is itself with smaller a-terms.
        (when (and st (== (. s ck) 'ck-p) (== (. t ck) 'ck-p) (ord-def7-5-bound (. s p))
                   (or (!= (. (. s p) pred) (. (. t p) pred)) (!= (. (. s p) form) (. (. t p) form))))
          (set! ok false))
        (when (not ok) (do (print "  [order] pair ") (print (ct-text arena s)) (print " ") (println (ct-text arena t))))
        ok)))

  (fn ord-def7-5-bound ((l Lit))
    (@intent "Is l function-free and mentioning y or a constant (Definition 7(5)'s premise)?")
    (@spec ((Lit) -> Bool))
    (@pure)
    (let ((k1 (. (. l t1) kind)) (k2 (. (. l t2) kind)) (bin (== (. l form) 'lf-binary)))
      (and (not (or (== k1 'ak-fx) (== k1 'ak-fu) (and bin (or (== k2 'ak-fx) (== k2 'ak-fu)))))
           (or (== k1 'ak-y) (== k1 'ak-u) (and bin (or (== k2 'ak-y) (== k2 'ak-u)))))))

  (fn test-sriq-order-c2 ((arena Arena))
    (@intent "Theorem 2's C2 for every query clause B(x) → A(x): every s with A(x) ≻ s is x, true or mentions y")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (order-c2-on arena (ord-table arena) (ord-universe arena)))

  (fn test-sriq-ranked-order-c2 ((arena Arena))
    (@intent "C2 under the ranked order for every query class (B0, B1), which stay unranked, while the fresh B2 and B3 rank above")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((ord (ranked (ord-table arena) 2)) (x (at-x)))
      (and (order-c2-on arena ord (ord-universe-n arena 4))
           (cterm-gt ord (ct-p (atom1 (cast U32 2) x)) (ct-p (atom1 (cast U32 1) x)))
           (cterm-gt ord (ct-p (atom1 (cast U32 3) x)) (ct-p (atom1 (cast U32 2) x)))
           (not (cterm-gt ord (ct-p (atom1 (cast U32 0) x)) (ct-p (atom1 (cast U32 1) x))))
           (not (cterm-gt ord (ct-p (atom1 (cast U32 1) x)) (ct-p (atom1 (cast U32 0) x)))))))

  (fn order-c2-on ((arena Arena) (ord SriqOrder) (u (List CTerm)))
    (@intent "C2 under ord for every query clause B(x) → A(x) over u, A a query class (below the rank, when ranked)")
    (@spec ((Arena SriqOrder (List CTerm)) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (for-each (a u)
          (when (and (== (. a ck) 'ck-p) (== (. (. a p) form) 'lf-unary) (== (. (. (. a p) t1) kind) 'ak-x)
                     (or (< (. ord rank) 0) (< (cast Int (. (. a p) pred)) (. ord rank))))
            (for-each (s u)
              (when (and (cterm-gt ord a s) (not (ord-c2-exempt s)))
                (do (print "  [order] C2 fails: ") (print (ct-text arena a)) (print " > ") (println (ct-text arena s))
                    (set! ok false))))))
        ok)))

  (fn ord-c2-exempt ((s CTerm))
    (@intent "x, true, or a term mentioning y")
    (@spec ((CTerm) -> Bool))
    (@pure)
    (match (. s ck)
      ('ck-true true)
      ('ck-a (or (== (. (. s a) kind) 'ak-x) (== (. (. s a) kind) 'ak-y)))
      ('ck-p (or (== (. (. (. s p) t1) kind) 'ak-y) (and (== (. (. s p) form) 'lf-binary) (== (. (. (. s p) t2) kind) 'ak-y))))))

  (fn test-sriq-const-order ((arena Arena))
    (@intent "⋗ on constants: label length, then base, then the label from the base; ascending 0, 1, 4, 2, 7, 3, 6, 5")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((ord (ord-table arena))
          (mut ranks (list-new arena Int))
          (mut ok true))
      (do
        ;; ranks[id] = position in ⋗ ascending.
        (list-push ranks 0) (list-push ranks 1) (list-push ranks 3) (list-push ranks 5)
        (list-push ranks 2) (list-push ranks 7) (list-push ranks 6) (list-push ranks 4)
        (let ((mut a 0))
          (while (< a 8)
            (do (when (not (const-row-ok arena ord ranks a)) (set! ok false))
                (set! a (+ a 1)))))
        ok)))

  (fn const-row-ok ((arena Arena) (ord SriqOrder) (ranks (List Int)) (a Int))
    (@intent "Does const-gt agree with the ranks for a against every constant?")
    (@spec ((Arena SriqOrder (List Int) Int) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut b 0))
      (do
        (while (< b 8)
          (do (when (!= (const-gt ord (cast U32 a) (cast U32 b)) (> (int-at ranks a) (int-at ranks b)))
                (do (print "  [order] constants ") (print (int-to-string arena a)) (print " ")
                    (println (int-to-string arena b)) (set! ok false)))
              (set! b (+ b 1))))
        ok)))

  (fn flags-text ((arena Arena) (fs (List Bool)))
    (@intent "T and F, one per flag")
    (@spec ((Arena (List Bool)) -> String))
    (@alloc arena)
    (let ((mut out "")) (do (for-each (f fs) (set! out (string-concat arena out (if f "T" "F")))) out)))

  (fn flags-are ((arena Arena) (label String) (head (List Lit)) (want String))
    (@intent "One row: the head as a set, its flags exactly `want`")
    (@spec ((Arena String (List Lit) String) -> Bool))
    (@alloc arena)
    (flags-under arena (ord-table arena) label head want))

  (fn flags-under ((arena Arena) (ord SriqOrder) (label String) (head (List Lit)) (want String))
    (@intent "flags-are under ord")
    (@spec ((Arena SriqOrder String (List Lit) String) -> Bool))
    (@alloc arena)
    (let ((got (flags-text arena (max-flags arena ord (. (make-clause arena (list-new arena Lit) head) head)))))
      (if (string-eq got want)
        true
        (do (print "  [max] ") (print label) (print ": got ") (println got) false))))

  (fn two-lits ((arena Arena) (a Lit) (b Lit))
    (@intent "[a, b]")
    (@spec ((Arena Lit Lit) -> (List Lit)))
    (@alloc arena)
    (let ((mut out (list-new arena Lit))) (do (list-push out a) (list-push out b) out)))

  (fn test-sriq-max-flags-rows ((arena Arena))
    (@intent "Δ ⊁ L, row by row, each head sorted as a set first")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((b0 (cast U32 0)) (s0 (cast U32 0))
          (x (at-x)) (y (at-y)) (f0x (at-fx (cast U32 0))) (f1x (at-fx (cast U32 1)))
          (u2 (at-u (cast U32 2))) (u4 (at-u (cast U32 4)))
          (mut ok true))
      (do
        ;; Distinct predicates are never compared.
        (when (not (flags-are arena "B0(f0(x)), S0(x, f0(x))" (two-lits arena (atom1 b0 f0x) (atom2 s0 x f0x)) "TT")) (set! ok false))
        ;; Item 7: B0(f0(x)) ≻ B0(x).
        (when (not (flags-are arena "B0(x), B0(f0(x))" (two-lits arena (atom1 b0 f0x) (atom1 b0 x)) "FT")) (set! ok false))
        ;; {B0(x), true} and {f1(x), f0(x)} are incomparable.
        (when (not (flags-are arena "B0(x), f1(x) ≈ f0(x)" (two-lits arena (eq-lit f0x f1x) (atom1 b0 x)) "TT")) (set! ok false))
        ;; {f1(x), x} ≻ {f0(x), x}.
        (when (not (flags-are arena "f0(x) ≈ x, f1(x) ≈ x" (two-lits arena (eq-lit f1x x) (eq-lit f0x x)) "FT")) (set! ok false))
        ;; {s, s, t, t} ≻ {s, t}.
        (when (not (flags-are arena "f0(x) ≈ x, f0(x) ≉ x" (two-lits arena (neq-lit f0x x) (eq-lit x f0x)) "FT")) (set! ok false))
        ;; Constants by ⋗: u2 ⋗ u4.
        (when (not (flags-are arena "B0(u2), B0(u4)" (two-lits arena (atom1 b0 u4) (atom1 b0 u2)) "TF")) (set! ok false))
        ;; Item 5: B0(y) is above x and y, so {B0(y), true} ≻ {x, y}.
        (when (not (flags-are arena "B0(y), x ≈ y" (two-lits arena (eq-lit y x) (atom1 b0 y)) "TF")) (set! ok false))
        (when (not (lits-strict arena (ord-table arena) (sample-lits arena))) (set! ok false))
        ok)))

  (fn test-sriq-ranked-max-flags-rows ((arena Arena))
    (@intent "Δ ⊁ L under the ranked order (slice 9g): B0 and B1 query classes, B2 and B3 fresh")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((ord (ranked (ord-table arena) 2))
          (q (cast U32 0)) (q1 (cast U32 1)) (f1 (cast U32 2)) (f2 (cast U32 3))
          (x (at-x)) (y (at-y)) (f0x (at-fx (cast U32 0))) (u2 (at-u (cast U32 2))))
      (and
        ;; A fresh name above a query class, and fresh names by id.
        (flags-under arena ord "B0(x), B2(x)" (two-lits arena (atom1 f1 x) (atom1 q x)) "FT")
        (flags-under arena ord "B2(x), B3(x)" (two-lits arena (atom1 f2 x) (atom1 f1 x)) "FT")
        ;; Query classes stay unranked: both maximal.
        (flags-under arena ord "B0(x), B1(x)" (two-lits arena (atom1 q1 x) (atom1 q x)) "TT")
        ;; Through item 7: B2(f0(x)) ≻ B2(x) ≻ B0(x) ≻ B0(y).
        (flags-under arena ord "B0(y), B2(f0(x))" (two-lits arena (atom1 f1 f0x) (atom1 q y)) "FT")
        ;; Definition 7(5): an atom over y or a constant gains nothing.
        (flags-under arena ord "B0(x), B2(y)" (two-lits arena (atom1 f1 y) (atom1 q x)) "TT")
        (flags-under arena ord "B0(u2), B2(u2)" (two-lits arena (atom1 f1 u2) (atom1 q u2)) "TT")
        (lits-strict arena ord (sample-lits arena))
        (lits-strict arena ord (ranked-sample-lits arena)))))

  (fn ranked-sample-lits ((arena Arena))
    (@intent "Literals the precedence orders: two query classes and two fresh names over x, f0(x) and y, and a role")
    (@spec ((Arena) -> (List Lit)))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (f0x (at-fx (cast U32 0))) (mut out (list-new arena Lit)) (mut b 0))
      (do (while (< b 4)
            (do (list-push out (atom1 (cast U32 b) x)) (list-push out (atom1 (cast U32 b) f0x))
                (list-push out (atom1 (cast U32 b) y))
                (set! b (+ b 1))))
          (list-push out (atom2 (cast U32 0) x f0x)) (list-push out (atom2 (cast U32 1) y x))
          out)))

  (fn sample-lits ((arena Arena))
    (@intent "One literal of each form over a few a-terms")
    (@spec ((Arena) -> (List Lit)))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (f0x (at-fx (cast U32 0))) (u2 (at-u (cast U32 2)))
          (mut out (list-new arena Lit)))
      (do
        (list-push out (atom1 (cast U32 0) x)) (list-push out (atom1 (cast U32 0) f0x)) (list-push out (atom1 (cast U32 1) y))
        (list-push out (atom2 (cast U32 0) x f0x)) (list-push out (atom2 (cast U32 0) u2 y))
        (list-push out (eq-lit f0x x)) (list-push out (eq-lit x y)) (list-push out (eq-lit u2 x))
        (list-push out (neq-lit f0x x)) (list-push out (neq-lit u2 y))
        out)))

  (fn lits-strict ((arena Arena) (ord SriqOrder) (ls (List Lit)))
    (@intent "The literal order is irreflexive and asymmetric on ls")
    (@spec ((Arena SriqOrder (List Lit)) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (for-each (a ls)
          (do (when (lit-gt arena ord a a) (do (println "  [max] a literal above itself") (set! ok false)))
              (for-each (b ls)
                (when (and (lit-gt arena ord a b) (lit-gt arena ord b a))
                  (do (println "  [max] two literals above each other") (set! ok false))))))
        ok)))

  ;; ------------------------------------------------------------
  ;; Slice 7d: redundancy and the commit (sriqsubsume.slop). Unary atoms
  ;; over x, classes A = 0, B = 1, C = 2, D = 3 by their letter.
  ;; ------------------------------------------------------------

  (fn letter-atoms ((arena Arena) (letters String))
    (@intent "B(x) for each letter A to D of a space-separated list")
    (@spec ((Arena String) -> (List Lit)))
    (@alloc arena)
    (let ((mut out (list-new arena Lit)))
      (do
        (for-each (w (strs arena letters))
          (list-push out (atom1 (cast U32 (- (cast Int (char-at w 0)) 65)) (at-x))))
        out)))

  (fn cl ((arena Arena) (body String) (head String))
    (@intent "body → head over the letters, as a canonical clause")
    (@spec ((Arena String String) -> Clause))
    (@alloc arena)
    (make-clause arena (letter-atoms arena body) (letter-atoms arena head)))

  (fn with-lit ((arena Arena) (c Clause) (l Lit))
    (@intent "c with l added to its head")
    (@spec ((Arena Clause Lit) -> Clause))
    (@alloc arena)
    (let ((mut h (list-new arena Lit)))
      (do (for-each (x (. c head)) (list-push h x)) (list-push h l)
          (make-clause arena (. c body) h))))

  (fn clauses-of ((arena Arena) (a Clause) (b Clause))
    (@intent "[a, b]")
    (@spec ((Arena Clause Clause) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause))) (do (list-push out a) (list-push out b) out)))

  (fn test-sriq-inhat-rows ((arena Arena))
    (@intent "§2.1's ∈̂, case by case: (i) s ≈ s, (ii) s ≈ t with s ≉ t, (iii) inclusion of body and head, without substitution")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (fx (at-fx (cast U32 0)))
          (none-set (list-new arena Clause))
          (w (clauses-of arena (cl arena "A" "B C") (cl arena "D" "C")))
          (ay (make-clause arena (one-lit arena (atom1 (cast U32 0) y)) (one-lit arena (atom1 (cast U32 1) y)))))
      (and
        ;; (i) and (ii), in an empty set.
        (in-hat (with-lit arena (cl arena "A" "B") (eq-lit fx fx)) none-set)
        (in-hat (with-lit arena (with-lit arena (cl arena "A" "") (eq-lit fx x)) (neq-lit x fx)) none-set)
        (not (in-hat (with-lit arena (cl arena "A" "B") (neq-lit fx fx)) none-set))
        (not (in-hat (with-lit arena (cl arena "A" "") (eq-lit fx x)) none-set))
        (not (in-hat (with-lit arena (with-lit arena (cl arena "A" "") (eq-lit fx x)) (neq-lit y fx)) none-set))
        ;; (iii): a larger body and a larger head are subsumed; anything else is not.
        (in-hat (cl arena "A" "B C") w)
        (in-hat (cl arena "A B" "B C D") w)
        (in-hat (cl arena "D A" "C") w)
        (not (in-hat (cl arena "" "B C") w))
        (not (in-hat (cl arena "A" "B") w))
        (not (in-hat (cl arena "B" "C") w))
        ;; No substitution: A(x) → B(x) does not subsume A(y) → B(y).
        (not (in-hat ay (clauses-of arena (cl arena "A" "B") (cl arena "C" "D")))))))

  (fn reference-min ((arena Arena) (xs (List Clause)))
    (@intent "min(X) from its definition: the members that are no tautology and that no other member subsumes")
    (@spec ((Arena (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)))
      (do
        (for-each (c xs)
          (let ((mut keep (not (tautology c))))
            (do (for-each (d xs) (when (and (not (clause-eq c d)) (subsumes d c)) (set! keep false)))
                (when (and keep (not (in-list out c))) (list-push out c)))))
        out)))

  (fn in-list ((xs (List Clause)) (c Clause))
    (@intent "Is c in xs?")
    (@spec (((List Clause) Clause) -> Bool))
    (@pure)
    (let ((mut found false)) (do (for-each (x xs) (when (clause-eq x c) (set! found true))) found)))

  (fn same-clause-set ((a (List Clause)) (b (List Clause)))
    (@intent "The same clauses, in any order: equally many, and each list's within the other")
    (@spec (((List Clause) (List Clause)) -> Bool))
    (@pure)
    (let ((mut ok (== (list-len a) (list-len b))))
      (do (for-each (c a) (when (not (in-list b c)) (set! ok false)))
          (for-each (c b) (when (not (in-list a c)) (set! ok false)))
          ok)))

  (fn commit-w ((arena Arena))
    (@intent "The context's set before the commit: A → B ∨ C and D → C")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (clauses-of arena (cl arena "A" "B C") (cl arena "D" "C")))

  (fn commit-candidates ((arena Arena))
    (@intent "Six candidates: one subsumed, one subsuming, a tautology, chains both ways")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)))
      (do
        (list-push out (cl arena "A" "B"))                                  ; subsumes A → B ∨ C
        (list-push out (cl arena "A D" "B"))                                ; subsumed by A → B
        (list-push out (with-lit arena (cl arena "B" "") (eq-lit (at-x) (at-x))))  ; a tautology
        (list-push out (cl arena "D" "C B"))                                ; subsumed by D → C
        (list-push out (cl arena "" "C"))                                   ; subsumes D → C and more
        (list-push out (cl arena "A B" "C"))                                ; inserted, then subsumed by ⊤ → C
        out)))

  (fn clause-list-at ((xs (List Clause)) (i Int) (fallback Clause))
    (@intent "Element i, or the fallback")
    (@spec (((List Clause) Int Clause) -> Clause))
    (@pure)
    (match (list-get xs i) ((some c) c) ((none) fallback)))

  (fn permuted ((arena Arena) (xs (List Clause)) (code Int))
    (@intent "xs in the order a base-6 code gives, or empty when the code repeats a position")
    (@spec ((Arena (List Clause) Int) -> (List Clause)))
    (@alloc arena)
    (let ((n (cast Int (list-len xs)))
          (fallback (cl arena "" ""))
          (mut out (list-new arena Clause))
          (mut used (list-new arena Bool))
          (mut c code)
          (mut ok true)
          (mut k 0))
      (do
        (while (< k n) (do (list-push used false) (set! k (+ k 1))))
        (set! k 0)
        (while (< k n)
          (let ((p (% c n)))
            (do (if (match (list-get used p) ((some b) b) ((none) true))
                  (set! ok false)
                  (do (list-set used p true) (list-push out (clause-list-at xs p fallback))))
                (set! c (/ c n))
                (set! k (+ k 1)))))
        (if ok out (list-new arena Clause)))))

  (fn appended ((arena Arena) (a (List Clause)) (b (List Clause)))
    (@intent "a, then b")
    (@spec ((Arena (List Clause) (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)))
      (do (for-each (c a) (list-push out c)) (for-each (c b) (list-push out c)) out)))

  (fn new-members ((arena Arena) (xs (List Clause)) (ws (List Clause)))
    (@intent "The members of xs that ws lacks")
    (@spec ((Arena (List Clause) (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)))
      (do (for-each (c xs) (when (not (in-list ws c)) (list-push out c))) out)))

  (fn order-ok ((arena Arena) (ws (List Clause)) (order (List Clause)) (want (List Clause)) (want-added (List Clause)))
    (@intent "Does committing in this order leave want, having added want-added?")
    (@spec ((Arena (List Clause) (List Clause) (List Clause) (List Clause)) -> Bool))
    (@alloc arena)
    (let ((r (commit-min arena ws order)))
      (and (same-clause-set (. r set) want) (same-clause-set (. r added) want-added))))

  (fn test-sriq-commit-min-permutation ((arena Arena))
    (@intent "R1: in each of the 720 orders of six candidates, the commit leaves min(W ∪ C) and adds exactly its new members")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((ws (commit-w arena))
          (cs (commit-candidates arena))
          (want (reference-min arena (appended arena ws cs)))
          (want-added (new-members arena want ws))
          (expected (clauses-of arena (cl arena "A" "B") (cl arena "" "C")))
          (mut orders 0)
          (mut bad 0)
          (mut code 0))
      (do
        (while (< code 46656)
          (let ((order (permuted arena cs code)))
            (do (when (> (list-len order) 0)
                  (do (set! orders (+ orders 1))
                      (when (not (order-ok arena ws order want want-added)) (set! bad (+ bad 1)))))
                (set! code (+ code 1)))))
        (when (!= orders 720) (println "  [commit] not 720 orders"))
        (when (> bad 0) (do (print "  [commit] orders that differ: ") (println (int-to-string arena bad))))
        ;; min(W ∪ C) is A → B and ⊤ → C, both new.
        (when (not (same-clause-set want expected)) (println "  [commit] min(W ∪ C) is not {A → B, ⊤ → C}"))
        (and (== orders 720) (== bad 0) (same-clause-set want expected) (same-clause-set want-added expected)))))

  (fn keeps-but-adds-not ((arena Arena))
    (@intent "W's A → B survives a commit of C → D: both are in the set, and only C → D was added")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ws (list-new arena Clause))
          (mut cs (list-new arena Clause)))
      (do
        (list-push ws (cl arena "A" "B"))
        (list-push cs (cl arena "C" "D"))
        (let ((r (commit-min arena ws cs)))
          (and (== (list-len (. r set)) 2)
               (in-list (. r set) (cl arena "A" "B"))
               (== (list-len (. r added)) 1)
               (in-list (. r added) (cl arena "C" "D")))))))

  (fn test-sriq-commit-survivors ((arena Arena))
    (@intent "Δₙ₊₁ is what is inserted and survives: a candidate inserted, then subsumed by a later one, is not added")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((r (commit-min arena (list-new arena Clause) (clauses-of arena (cl arena "A B" "C") (cl arena "" "C"))))
          (m (commit-min arena (commit-w arena) (commit-candidates arena))))
      (and (in-list (. r added) (cl arena "" "C"))
           (== (list-len (. r added)) 1)
           ;; A member of W that survives is in the set but was not added.
           (keeps-but-adds-not arena)
           (same-clause-set (. m set) (clauses-of arena (cl arena "A" "B") (cl arena "" "C"))))))

  (fn test-sriq-inhat-persists ((arena Arena))
    (@intent "R2: whatever is ∈̂ W before the commit is ∈̂ its result, though its subsumers are deleted")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((ws (commit-w arena))
          (after (. (commit-min arena ws (commit-candidates arena)) set))
          (mut samples (list-new arena Clause))
          (mut ok true))
      (do
        (list-push samples (cl arena "A B" "B C"))
        (list-push samples (cl arena "A D" "C"))
        (list-push samples (cl arena "A" "B C D"))
        (list-push samples (cl arena "D" "C"))
        (list-push samples (with-lit arena (cl arena "C" "") (eq-lit (at-y) (at-y))))
        (for-each (c samples)
          (when (and (in-hat c ws) (not (in-hat c after))) (set! ok false)))
        ;; And the commit deleted both of W's clauses.
        (and ok (not (in-list after (cl arena "A" "B C"))) (not (in-list after (cl arena "D" "C")))))))

  ;; ------------------------------------------------------------
  ;; Slice 7e: Core, Hyper, Ineq and Factor (rules/sriq.slop). Classes
  ;; A 0, B 1, C 2, D 3, G 4, E 5; roles R 0, S 1; function symbols
  ;; f 0, g 1, h 2, so g(x) ≻ f(x) as in [TGH21] §3.1's O1. HOWL's order
  ;; never ranks D(x) against G(x), so each row is O1's inference read as
  ;; an instance under HOWL's order.
  ;; ------------------------------------------------------------

  (fn r-atom ((c Int) (t ATerm))
    (@intent "Class c of t")
    (@spec ((Int ATerm) -> Lit))
    (@pure)
    (atom1 (cast U32 c) t))

  (fn r-role ((r Int) (a ATerm) (b ATerm))
    (@intent "Role r of a, b")
    (@spec ((Int ATerm ATerm) -> Lit))
    (@pure)
    (atom2 (cast U32 r) a b))

  (fn r-fx ((f Int))
    (@intent "f(x)")
    (@spec ((Int) -> ATerm))
    (@pure)
    (at-fx (cast U32 f)))

  (fn r-clause ((arena Arena) (body (List Lit)) (head (List Lit)))
    (@intent "A set clause")
    (@spec ((Arena (List Lit) (List Lit)) -> Clause))
    (@alloc arena)
    (make-clause arena body head))

  (fn r-premises ((arena Arena) (ord SriqOrder) (c Clause))
    (@intent "c with each head literal selected in turn")
    (@spec ((Arena SriqOrder Clause) -> (List Premise)))
    (@alloc arena)
    (let ((mut out (list-new arena Premise)) (mut i 0))
      (do (while (< i (cast Int (list-len (. c head))))
            (do (list-push out (select arena ord c i)) (set! i (+ i 1))))
          out)))

  (fn r-cands ((arena Arena) (ord SriqOrder) (atoms Int) (cs (List Clause)))
    (@intent "The same candidates, every head literal of every clause, for each body atom")
    (@spec ((Arena SriqOrder Int (List Clause)) -> (List Cands)))
    (@alloc arena)
    (let ((mut ps (list-new arena Premise))
          (mut out (list-new arena Cands))
          (mut k 0))
      (do (for-each (c cs) (for-each (p (r-premises arena ord c)) (list-push ps p)))
          (while (< k atoms) (do (list-push out (record-new Cands (ps ps))) (set! k (+ k 1))))
          out)))

  (fn r-hyper ((arena Arena) (start HState) (ont Clause) (cs (List Clause)))
    (@intent "Every Hyper conclusion of the ontology clause ont over the context clauses cs, as set clauses")
    (@spec ((Arena HState Clause (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((ord (named-consts arena 3))
          (rs (hyper-join arena start (. ont body) (r-cands arena ord (cast Int (list-len (. ont body))) cs) (. ont head)))
          (mut out (list-new arena Clause)))
      (do (for-each (r rs) (list-push out (assemble arena r))) out)))

  (fn r-useful ((arena Arena) (cs (List Clause)))
    (@intent "cs without tautologies or repeats")
    (@spec ((Arena (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)))
      (do (for-each (c cs) (when (and (not (tautology c)) (not (in-list out c))) (list-push out c))) out)))

  (fn r-one ((arena Arena) (c Clause))
    (@intent "[c]")
    (@spec ((Arena Clause) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause))) (do (list-push out c) out)))

  (fn hyper-is ((arena Arena) (label String) (got (List Clause)) (want (List Clause)))
    (@intent "The useful conclusions are exactly want")
    (@spec ((Arena String (List Clause) (List Clause)) -> Bool))
    (@alloc arena)
    (if (same-clause-set (r-useful arena got) want)
      true
      (do (print "  [hyper] ") (println label) false)))

  (fn r-premise ((arena Arena) (ord SriqOrder) (c Clause) (l Lit))
    (@intent "c with the head literal l selected")
    (@spec ((Arena SriqOrder Clause Lit) -> Premise))
    (@alloc arena)
    (let ((mut at 0) (mut i 0))
      (do (for-each (h (. c head)) (do (when (lit-eq h l) (set! at i)) (set! i (+ i 1))))
          (select arena ord c at))))

  (fn test-sriq-hyper-rows ((arena Arena))
    (@intent "Hyper, row by row: O1's inferences (15) to (21) under HOWL's order, a premise with a body, a literal that is not maximal, and DL4 with a repeated neighbour")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (z2 (at-z (cast U32 2)))
          (nolits (list-new arena Lit))
          (start (hyper-start arena (at-x) true))
          (c15 (r-clause arena nolits (one-lit arena (r-atom 0 x))))
          (c17 (r-clause arena nolits (one-lit arena (r-role 0 x (r-fx 0)))))
          (c18 (r-clause arena nolits (two-lits arena (r-atom 3 x) (r-atom 4 x))))
          (c20 (r-clause arena nolits (two-lits arena (r-atom 3 x) (r-role 0 x (r-fx 1)))))
          (o2 (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 1 (r-fx 0)))))
          (o3 (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x (r-fx 0)))))
          (o6 (r-clause arena (one-lit arena (r-atom 0 x)) (two-lits arena (r-atom 3 x) (r-atom 4 x))))
          (o8 (r-clause arena (one-lit arena (r-atom 4 x)) (one-lit arena (r-role 0 x (r-fx 1)))))
          (o7 (r-clause arena (one-lit arena (r-atom 4 x)) (one-lit arena (r-atom 2 (r-fx 1)))))
          (o9 (r-clause arena (two-lits arena (r-role 0 x z1) (r-role 0 x z2)) (one-lit arena (eq-lit z2 z1))))
          (blocked (r-clause arena nolits (two-lits arena (r-atom 1 x) (r-atom 1 (r-fx 0)))))
          (o-bc (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 2 x))))
          (all (r-hyper arena start o9 (clauses-of arena c17 c20))))
      (and
        ;; R(x, f0(x)) shares A's id 0 but is not A(x).
        (hyper-is arena "(15) and (2) give (16)"
          (r-hyper arena start o2 (clauses-of arena c15 (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-role 0 x (r-fx 0))))))
          (r-one arena (r-clause arena nolits (one-lit arena (r-atom 1 (r-fx 0))))))
        (hyper-is arena "(15) and (3) give (17)" (r-hyper arena start o3 (r-one arena c15)) (r-one arena c17))
        (hyper-is arena "(15) and (6) give (18)" (r-hyper arena start o6 (r-one arena c15)) (r-one arena c18))
        (hyper-is arena "(18) and (8) give (20)" (r-hyper arena start o8 (r-one arena c18)) (r-one arena c20))
        ;; G(x) is selected; D(x) rides along in the conclusion.
        (hyper-is arena "(18) and (7) give (19)" (r-hyper arena start o7 (r-one arena c18))
          (r-one arena (r-clause arena nolits (two-lits arena (r-atom 3 x) (r-atom 2 (r-fx 1))))))
        ;; The two choices that repeat a neighbour fire too, as tautologies.
        (hyper-is arena "(17), (20) and (9) give (21)" all
          (r-one arena (r-clause arena nolits (two-lits arena (r-atom 3 x) (eq-lit (r-fx 1) (r-fx 0))))))
        (== (list-len all) 4)
        (hyper-is arena "a premise's body joins the conclusion's"
          (r-hyper arena start o-bc (r-one arena (r-clause arena (one-lit arena (r-atom 3 x)) (one-lit arena (r-atom 1 x)))))
          (r-one arena (r-clause arena (one-lit arena (r-atom 3 x)) (one-lit arena (r-atom 2 x)))))
        ;; B(x) is below B(f(x)) in its clause, so it is not selected, and
        ;; B(f(x)) is not B(x).
        (hyper-is arena "a literal below another is not selected" (r-hyper arena start o-bc (r-one arena blocked)) (list-new arena Clause))
        (test-sriq-hyper-dl4 arena)
        ;; A body atom with no candidates list: nothing fires.
        (== (list-len (hyper-join arena start (. o9 body) (list-new arena Cands) (. o9 head))) 0))))

  (fn test-sriq-hyper-dl4 ((arena Arena))
    (@intent "DL4 (≤ 1 R.B) over R(x, f0(x)), R(x, f1(x)) and B(f0(x)) alone: only the choice z₁ = z₂ = f0(x) fires, and its conclusion is ∈̂ (i)'s tautology")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (z2 (at-z (cast U32 2)))
          (nolits (list-new arena Lit))
          (start (hyper-start arena (at-x) true))
          (mut body (two-lits arena (r-role 0 x z1) (r-role 0 x z2)))
          (o-dl4 (r-clause arena (do (list-push body (r-atom 1 z1)) (list-push body (r-atom 1 z2)) body)
                   (one-lit arena (eq-lit z2 z1))))
          (mut cs (clauses-of arena
                (r-clause arena nolits (one-lit arena (r-role 0 x (r-fx 0))))
                (r-clause arena nolits (one-lit arena (r-role 0 x (r-fx 1))))))
          (got (do (list-push cs (r-clause arena nolits (one-lit arena (r-atom 1 (r-fx 0)))))
                   (r-hyper arena start o-dl4 cs))))
      (and (== (list-len got) 1)
           (hyper-is arena "DL4's repeated neighbour is a tautology" got (list-new arena Clause)))))

  (fn test-sriq-hyper-root-rows ((arena Arena))
    (@intent "Hyper at the root: x binds to the premise's constant, a bodiless clause takes the constant it is given (E4), zᵢ binds a constant, f(x) becomes f(u), and S(x, x) needs one constant twice")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (z1 (at-z (cast U32 1)))
          (u0 (at-u (cast U32 0))) (u1 (at-u (cast U32 1)))
          (nolits (list-new arena Lit))
          (root (hyper-start arena (at-x) false))
          (b-u0 (r-clause arena nolits (one-lit arena (r-atom 1 u0))))
          (b-y (r-clause arena nolits (one-lit arena (r-atom 1 y))))
          (s-u1u0 (r-clause arena nolits (one-lit arena (r-role 1 u1 u0))))
          (o-bc (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 2 x))))
          (o-bf (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 0 (r-fx 0)))))
          (o-top (r-clause arena nolits (two-lits arena (r-atom 3 x) (r-atom 5 x))))
          (o-dl3 (r-clause arena (two-lits arena (r-role 1 z1 x) (r-atom 1 x)) (one-lit arena (r-atom 2 z1))))
          (o-self (r-clause arena (one-lit arena (r-role 1 x x)) (one-lit arena (r-atom 2 x)))))
      (and
        (test-sriq-hyper-example1 arena)
        (hyper-is arena "B(u0) and B(x) → C(x) give C(u0)" (r-hyper arena root o-bc (r-one arena b-u0))
          (r-one arena (r-clause arena nolits (one-lit arena (r-atom 2 u0)))))
        (hyper-is arena "x never binds y at the root" (r-hyper arena root o-bc (r-one arena b-y)) (list-new arena Clause))
        (hyper-is arena "f(x) at the root is f(u0)" (r-hyper arena root o-bf (r-one arena b-u0))
          (r-one arena (r-clause arena nolits (one-lit arena (r-atom 0 (at-fu (cast U32 0) (cast U32 0)))))))
        (hyper-is arena "a bodiless clause on the constant it is given" (r-hyper arena (hyper-start arena u1 true) o-top (list-new arena Clause))
          (r-one arena (r-clause arena nolits (two-lits arena (r-atom 3 u1) (r-atom 5 u1)))))
        ;; x is bound by S's second argument, then B(x) must be B(u0).
        (hyper-is arena "DL3 at the root binds z1 to another constant" (r-hyper arena root o-dl3 (clauses-of arena b-u0 s-u1u0))
          (r-one arena (r-clause arena nolits (one-lit arena (r-atom 2 u1)))))
        (hyper-is arena "S(x, x) does not match S(u0, u1)"
          (r-hyper arena root o-self (r-one arena (r-clause arena nolits (one-lit arena (r-role 1 u0 u1))))) (list-new arena Clause))
        (hyper-is arena "S(x, x) matches S(u1, u1)"
          (r-hyper arena root o-self (r-one arena (r-clause arena nolits (one-lit arena (r-role 1 u1 u1)))))
          (r-one arena (r-clause arena nolits (one-lit arena (r-atom 2 u1))))))))

  (fn test-sriq-hyper-example1 ((arena Arena))
    (@intent "[TGH21] Example 1's two root Hypers: (114), (115) and (88) give (117), which with (116) and (90) gives (118), binding x to o and z₁ to y")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; C 2, D 3, E 5, F 6; S 1; o is u0.
    (let ((x (at-x)) (y (at-y)) (z1 (at-z (cast U32 1))) (o (at-u (cast U32 0)))
          (root (hyper-start arena (at-x) false))
          (c114 (r-clause arena (one-lit arena (r-atom 3 o)) (one-lit arena (r-atom 3 o))))
          (c115 (r-clause arena (one-lit arena (r-atom 2 o)) (one-lit arena (r-atom 2 o))))
          (c116 (r-clause arena (one-lit arena (r-role 1 y o)) (one-lit arena (r-role 1 y o))))
          (o88 (r-clause arena (two-lits arena (r-atom 2 x) (r-atom 3 x)) (one-lit arena (r-atom 5 x))))
          (o90 (r-clause arena (two-lits arena (r-role 1 z1 x) (r-atom 5 x)) (one-lit arena (r-atom 6 z1))))
          (c117 (r-clause arena (two-lits arena (r-atom 2 o) (r-atom 3 o)) (one-lit arena (r-atom 5 o))))
          (mut b118 (two-lits arena (r-atom 2 o) (r-atom 3 o))))
      (do
        (list-push b118 (r-role 1 y o))
        (and
          (hyper-is arena "(114), (115) and (88) give (117)" (r-hyper arena root o88 (clauses-of arena c114 c115)) (r-one arena c117))
          (hyper-is arena "(117), (116) and (90) give (118)" (r-hyper arena root o90 (clauses-of arena c117 c116))
            (r-one arena (r-clause arena b118 (one-lit arena (r-atom 6 y)))))))))

  (fn test-sriq-ineq-factor-core-rows ((arena Arena))
    (@intent "Ineq drops t ≉ t, maximal or not, and nothing else; Factor is [TGH21] §3.1's example, and fails when any one side condition fails; Core gives ⊤ → A")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (f1x (r-fx 1)) (f0x (r-fx 0))
          (nolits (list-new arena Lit))
          (ord (named-consts arena 3))
          (low (r-clause arena nolits (two-lits arena (neq-lit x x) (r-atom 1 f0x))))
          (p-low-neq (r-premise arena ord low (neq-lit x x)))
          (p-eq (select arena ord (r-clause arena nolits (one-lit arena (eq-lit f1x f1x))) 0))
          (p-non (select arena ord (r-clause arena nolits (one-lit arena (neq-lit f1x x))) 0))
          ;; [TGH21] §3.1's ⊤ → f(x) ≈ y ∨ f(x) ≈ g(x) ⟹ ⊤ → g(x) ≉ y ∨ f(x) ≈ g(x)
          ;; needs t₂ = g(x) ⊁ s = f(x), the reverse of O1's g(x) ≻ f(x), so
          ;; here f is f1 and g is f0.
          (fac (r-clause arena nolits (two-lits arena (eq-lit f1x y) (eq-lit f1x f0x))))
          (p-fac (r-premise arena ord fac (eq-lit f1x f0x)))
          (ok-factor (factor-rule arena ord p-fac (eq-lit f1x y) f1x)))
      (and
        (clause-eq (assemble arena (ineq-rule (select arena ord (r-clause arena nolits (one-lit arena (neq-lit f1x f1x))) 0)))
          (r-clause arena nolits nolits))
        (not (. p-low-neq maxed))
        (. (ineq-rule p-low-neq) fires)
        (clause-eq (assemble arena (ineq-rule p-low-neq)) (r-clause arena nolits (one-lit arena (r-atom 1 f0x))))
        (not (. (ineq-rule p-eq) fires))
        (not (. (ineq-rule p-non) fires))
        (. p-fac maxed)
        (. ok-factor fires)
        (clause-eq (assemble arena ok-factor) (r-clause arena nolits (two-lits arena (neq-lit y f0x) (eq-lit f1x f0x))))
        (test-sriq-factor-each-condition arena)
        (. (core-rule arena (r-atom 0 x)) fires)
        (clause-eq (assemble arena (core-rule arena (r-atom 0 x))) (r-clause arena nolits (one-lit arena (r-atom 0 x)))))))

  (fn test-sriq-factor-each-condition ((arena Arena))
    (@intent "Factor with exactly one side condition failing does not fire")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (f1x (r-fx 1)) (f0x (r-fx 0))
          (nolits (list-new arena Lit))
          (ord (named-consts arena 3))
          (fac (r-clause arena nolits (two-lits arena (eq-lit f1x y) (eq-lit f1x f0x))))
          (p-low (r-premise arena ord fac (eq-lit f1x y)))
          (p-fac (r-premise arena ord fac (eq-lit f1x f0x)))
          ;; ⊤ → f1(x) ≈ y ∨ f0(x) ≈ y: the shared side y is below t₂ = f1(x).
          (fy (r-clause arena nolits (two-lits arena (eq-lit f1x y) (eq-lit f0x y))))
          (p-fy (r-premise arena ord fy (eq-lit f1x y)))
          ;; ⊤ → f1(x) ≈ f0(x) ∨ f0(x) ≈ y: l₁ lacks s = f1(x).
          (fz (r-clause arena nolits (two-lits arena (eq-lit f1x f0x) (eq-lit f0x y))))
          (p-fz (r-premise arena ord fz (eq-lit f1x f0x)))
          (u0 (at-u (cast U32 0)))
          (xy (r-clause arena nolits (two-lits arena (eq-lit x y) (eq-lit u0 y))))
          (p-xy (r-premise arena ord xy (eq-lit x y)))
          (p-uy (r-premise arena ord xy (eq-lit u0 y))))
      (and
        ;; Not maximal: f1(x) ≈ y is below f1(x) ≈ f0(x).
        (not (. p-low maxed))
        (not (. (factor-rule arena ord p-low (eq-lit f1x f0x) f1x) fires))
        ;; t₂ ≻ s.
        (. p-fy maxed)
        (not (. (factor-rule arena ord p-fy (eq-lit f0x y) y) fires))
        ;; l₁ not in the head.
        (not (. (factor-rule arena ord p-fac (eq-lit f1x x) f1x) fires))
        ;; l₁ without s.
        (. p-fz maxed)
        (not (. (factor-rule arena ord p-fz (eq-lit f0x y) f1x) fires))
        ;; The selected literal without s: x and y are never compared with
        ;; a constant, so x ≈ y is maximal beside u0 ≈ y, and t₂ ⊁ s.
        (. p-xy maxed)
        (not (. (factor-rule arena ord p-xy (eq-lit u0 y) u0) fires))
        ;; t₁ ≻ s does not stop it: in the same clause u0 ≈ y is maximal
        ;; too, and with s = y, t₁ = x ≻ y while t₂ = u0 ⊁ y.
        (. p-uy maxed)
        (. (factor-rule arena ord p-uy (eq-lit x y) y) fires)
        (clause-eq (assemble arena (factor-rule arena ord p-uy (eq-lit x y) y))
          (r-clause arena nolits (two-lits arena (neq-lit x u0) (eq-lit u0 y)))))))

  ;; ------------------------------------------------------------
  ;; Slice 7f: Eq, Join, Nom and Λ (rules/sriq.slop). The class, role and
  ;; function-symbol ids are 7e's; each row names the clauses it is.
  ;; ------------------------------------------------------------

  (fn r-pos ((k Int) (inner Bool))
    (@intent "Position k, or the x or u under its f")
    (@spec ((Int Bool) -> Pos))
    (@pure)
    (record-new Pos (arg (cast U32 k)) (inner inner)))

  (fn r-top ((arena Arena) (head (List Lit)))
    (@intent "⊤ → head")
    (@spec ((Arena (List Lit)) -> Clause))
    (@alloc arena)
    (r-clause arena (list-new arena Lit) head))

  (fn r-eq ((arena Arena) (root Bool) (c1 Clause) (l1 Lit) (k1 Int) (c2 Clause) (l2 Lit) (p Pos))
    (@intent "Eq from c1 at l1's side k1 into c2 at l2's position p")
    (@spec ((Arena Bool Clause Lit Int Clause Lit Pos) -> RConcl))
    (@alloc arena)
    (let ((ord (named-consts arena 3)))
      (eq-rule arena ord root (r-premise arena ord c1 l1) (cast U32 k1) (r-premise arena ord c2 l2) p)))

  (fn eq-gives ((arena Arena) (label String) (r RConcl) (want Clause))
    (@intent "Eq fires and concludes want")
    (@spec ((Arena String RConcl Clause) -> Bool))
    (@alloc arena)
    (if (and (. r fires) (clause-eq (assemble arena r) want))
      true
      (do (print "  [eq] ") (println label) false)))

  (fn test-sriq-eq-rows ((arena Arena))
    (@intent "Eq, row by row: O1's (21) and (19) give (22), Example 1's (95) and (94) give (96), Example 2's (148) and (147) give (149), and the root rewrites a constant everywhere")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (f0x (r-fx 0)) (f1x (r-fx 1)) (f2x (r-fx 2))
          (o (at-u (cast U32 0))) (u1 (at-u (cast U32 1)))
          (c21 (r-top arena (two-lits arena (r-atom 3 x) (eq-lit f1x f0x))))
          (c19 (r-top arena (two-lits arena (r-atom 3 x) (r-atom 2 f1x))))
          (c95 (r-top arena (two-lits arena (r-atom 6 x) (eq-lit x o))))
          (c94 (r-top arena (two-lits arena (r-atom 6 x) (r-atom 3 x))))
          (c148 (r-top arena (one-lit arena (eq-lit f2x o))))
          (c147 (r-top arena (one-lit arena (r-role 2 f2x x))))
          (root-eq (r-top arena (one-lit arena (eq-lit u1 o))))
          (root-s (r-top arena (one-lit arena (r-role 1 u1 u1))))
          (root-f (r-top arena (one-lit arena (r-atom 1 (at-fu (cast U32 0) (cast U32 1)))))))
      (and
        ;; g is f1 and f is f0, so g(x) ≈ f(x) is stored f1(x) ≈ f0(x).
        (eq-gives arena "(21) and (19) give (22)"
          (r-eq arena false c21 (eq-lit f1x f0x) (side-of (eq-lit f1x f0x) f1x) c19 (r-atom 2 f1x) (r-pos 1 false))
          (r-top arena (two-lits arena (r-atom 3 x) (r-atom 2 f0x))))
        ;; x ≈ o rewrites x in D(x): x and o are never compared.
        (eq-gives arena "(95) and (94) give (96)"
          (r-eq arena false c95 (eq-lit x o) (side-of (eq-lit x o) x) c94 (r-atom 3 x) (r-pos 1 false))
          (r-top arena (two-lits arena (r-atom 6 x) (r-atom 3 o))))
        ;; S₂ is role 2 and h is f2.
        (eq-gives arena "(148) and (147) give (149)"
          (r-eq arena false c148 (eq-lit f2x o) (side-of (eq-lit f2x o) f2x) c147 (r-role 2 f2x x) (r-pos 1 false))
          (r-top arena (one-lit arena (r-role 2 o x))))
        ;; At the root a constant goes everywhere in s₂: both arguments, and under f.
        (eq-gives arena "the root rewrites u1 in both arguments"
          (r-eq arena true root-eq (eq-lit u1 o) (side-of (eq-lit u1 o) u1) root-s (r-role 1 u1 u1) (r-pos 1 false))
          (r-top arena (one-lit arena (r-role 1 o o))))
        (eq-gives arena "away from the root, only at p"
          (r-eq arena false root-eq (eq-lit u1 o) (side-of (eq-lit u1 o) u1) root-s (r-role 1 u1 u1) (r-pos 1 false))
          (r-top arena (one-lit arena (r-role 1 o u1))))
        (eq-gives arena "the root rewrites u1 under f"
          (r-eq arena true root-eq (eq-lit u1 o) (side-of (eq-lit u1 o) u1) root-f (r-atom 1 (at-fu (cast U32 0) (cast U32 1))) (r-pos 1 true))
          (r-top arena (one-lit arena (r-atom 1 (at-fu (cast U32 0) (cast U32 0))))))
        (test-sriq-eq-excluded arena))))

  (fn side-of ((l Lit) (s ATerm))
    (@intent "Which side of l is s: 1 or 2")
    (@spec ((Lit ATerm) -> Int))
    (@pure)
    (if (aterm-eq (. l t1) s) 1 2))

  (fn test-sriq-eq-excluded ((arena Arena))
    (@intent "Eq does not fire on x ≈ y or y ≈ u, on x inside an f or beside a y, with t₁ ≻ s₁, with t₂ ≻ s₂, off its position, or when either literal is not maximal")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (f0x (r-fx 0)) (f1x (r-fx 1)) (o (at-u (cast U32 0)))
          (cxy (r-top arena (one-lit arena (eq-lit x y))))
          (cyu (r-top arena (one-lit arena (eq-lit y o))))
          (cxo (r-top arena (one-lit arena (eq-lit x o))))
          (bx (r-top arena (one-lit arena (r-atom 1 x))))
          (bo (r-top arena (one-lit arena (r-atom 1 o))))
          (syx (r-top arena (one-lit arena (r-role 1 y x))))
          (bfx (r-top arena (one-lit arena (r-atom 1 f0x))))
          (cf (r-top arena (one-lit arena (eq-lit f1x f0x))))
          (bf1 (r-top arena (one-lit arena (r-atom 1 f1x))))
          (bf0 (r-top arena (one-lit arena (r-atom 1 f0x))))
          (e2 (r-top arena (one-lit arena (eq-lit f1x x))))
          ;; f0(x) ≻ y, so in ⊤ → f1(x) ≈ y ∨ f1(x) ≈ f0(x) the first is not maximal.
          (low (r-top arena (two-lits arena (eq-lit f1x y) (eq-lit f1x f0x)))))
      (and
        (not (. (r-eq arena false cxy (eq-lit x y) (side-of (eq-lit x y) x) bx (r-atom 1 x) (r-pos 1 false)) fires))
        (not (. (r-eq arena false cyu (eq-lit y o) (side-of (eq-lit y o) o) bo (r-atom 1 o) (r-pos 1 false)) fires))
        (. (r-eq arena false cxo (eq-lit x o) (side-of (eq-lit x o) x) bx (r-atom 1 x) (r-pos 1 false)) fires)
        (not (. (r-eq arena false cxo (eq-lit x o) (side-of (eq-lit x o) x) syx (r-role 1 y x) (r-pos 2 false)) fires))
        (not (. (r-eq arena false cxo (eq-lit x o) (side-of (eq-lit x o) x) bfx (r-atom 1 f0x) (r-pos 1 true)) fires))
        ;; A unary atom has no second argument.
        (not (. (r-eq arena false cxo (eq-lit x o) (side-of (eq-lit x o) x) bx (r-atom 1 x) (r-pos 2 false)) fires))
        ;; The first premise's literal must be an equality.
        (not (. (r-eq arena false (r-top arena (one-lit arena (neq-lit f1x f0x))) (neq-lit f1x f0x) (side-of (neq-lit f1x f0x) f1x)
                      bf1 (r-atom 1 f1x) (r-pos 1 false)) fires))
        ;; t₁ ≻ s₁: f0(x) is below f1(x), so f0(x) is not s₁.
        (not (. (r-eq arena false cf (eq-lit f1x f0x) (side-of (eq-lit f1x f0x) f0x) bf0 (r-atom 1 f0x) (r-pos 1 false)) fires))
        (. (r-eq arena false cf (eq-lit f1x f0x) (side-of (eq-lit f1x f0x) f1x) bf1 (r-atom 1 f1x) (r-pos 1 false)) fires)
        ;; t₂ ≻ s₂: in f1(x) ≈ x, the side x is not s₂.
        (not (. (r-eq arena false cxo (eq-lit x o) (side-of (eq-lit x o) x) e2 (eq-lit f1x x) (r-pos (side-of (eq-lit f1x x) x) false)) fires))
        ;; s₂|p is not s₁.
        (not (. (r-eq arena false cf (eq-lit f1x f0x) (side-of (eq-lit f1x f0x) f1x) bf0 (r-atom 1 f0x) (r-pos 1 false)) fires))
        ;; Not maximal, first premise, then second.
        (not (. (r-eq arena false low (eq-lit f1x y) (side-of (eq-lit f1x y) f1x) bf1 (r-atom 1 f1x) (r-pos 1 false)) fires))
        (not (. (r-eq arena false cf (eq-lit f1x f0x) (side-of (eq-lit f1x f0x) f1x) low (eq-lit f1x y) (r-pos (side-of (eq-lit f1x y) f1x) false)) fires)))))

  (fn test-sriq-join-rows ((arena Arena))
    (@intent "Join: Example 1's (112) as HOWL reaches it. r-Pred carries (118)'s ground C(o) and D(o) into C(o) ∧ D(o) → F(x) (E3), and Join resolves C(o) with (110), ⊤ → C(o). A non-ground atom, u ≈ u, x ≈ u and a literal that is not maximal do not join")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (o (at-u (cast U32 0))) (u1 (at-u (cast U32 1)))
          (nolits (list-new arena Lit))
          (ord (named-consts arena 3))
          (c110 (r-top arena (one-lit arena (r-atom 2 o))))
          (pre (r-clause arena (two-lits arena (r-atom 2 o) (r-atom 3 o)) (one-lit arena (r-atom 6 x))))
          (j (join-rule arena (r-premise arena ord c110 (r-atom 2 o)) (r-body arena pre (r-atom 2 o))))
          (cx (r-top arena (one-lit arena (r-atom 2 x))))
          (prex (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-atom 6 x))))
          (uu (r-top arena (one-lit arena (eq-lit o u1))))
          (preu (r-clause arena (one-lit arena (eq-lit o u1)) (one-lit arena (r-atom 6 x))))
          (xo (r-top arena (one-lit arena (eq-lit x o))))
          (prexo (r-clause arena (one-lit arena (eq-lit x o)) (one-lit arena (r-atom 6 x))))
          (low (r-top arena (two-lits arena (r-atom 2 o) (r-atom 2 (at-fu (cast U32 0) (cast U32 0)))))))
      (and
        (. j fires)
        (clause-eq (assemble arena j) (r-clause arena (one-lit arena (r-atom 3 o)) (one-lit arena (r-atom 6 x))))
        (. (join-rule arena (r-premise arena ord uu (eq-lit o u1)) (r-body arena preu (eq-lit o u1))) fires)
        (not (. (join-rule arena (r-premise arena ord cx (r-atom 2 x)) (r-body arena prex (r-atom 2 x))) fires))
        (not (. (join-rule arena (r-premise arena ord xo (eq-lit x o)) (r-body arena prexo (eq-lit x o))) fires))
        (not (. (join-rule arena (r-premise arena ord (r-top arena (one-lit arena (eq-lit o o))) (eq-lit o o))
                              (r-body arena (r-clause arena (one-lit arena (eq-lit o o)) (one-lit arena (r-atom 6 x))) (eq-lit o o))) fires))
        (not (. (join-rule arena (r-premise arena ord low (r-atom 2 o)) (r-body arena pre (r-atom 2 o))) fires))
        ;; A different atom in the body.
        (not (. (join-rule arena (r-premise arena ord c110 (r-atom 2 o)) (r-body arena pre (r-atom 3 o))) fires)))))

  (fn r-body ((arena Arena) (c Clause) (l Lit))
    (@intent "c viewed at body literal l")
    (@spec ((Arena Clause Lit) -> BodyView))
    (@alloc arena)
    (let ((mut at 0) (mut i 0))
      (do (for-each (b (. c body)) (do (when (lit-eq b l) (set! at i)) (set! i (+ i 1))))
          (body-at arena c at))))

  (fn r-kids-order ((arena Arena))
    (@intent "Named 0 and 1; 2 and 3 are o₀'s S¹ and S² for S role 2; 4 is constant 2's S¹, at depth 2; 5 is o₀'s S′¹ for S′ role 3")
    (@spec ((Arena) -> SriqOrder))
    (@alloc arena)
    (let ((base (named-consts arena 2))
          (mut cs (list-new arena ConstEntry)))
      (do
        (for-each (e (. base consts)) (list-push cs e))
        (let ((e0 (const-entry base (cast U32 0))))
          (do (list-push cs (aux-const e0 (cast U32 0) (cast U32 2) (cast U32 1)))
              (list-push cs (aux-const e0 (cast U32 0) (cast U32 2) (cast U32 2)))
              (list-push cs (aux-const (aux-const e0 (cast U32 0) (cast U32 2) (cast U32 1)) (cast U32 2) (cast U32 2) (cast U32 1)))
              (list-push cs (aux-const e0 (cast U32 0) (cast U32 3) (cast U32 1)))))
        (record-new SriqOrder (consts cs) (rank -1)))))

  (fn r-ids ((arena Arena) (a Int) (b Int))
    (@intent "[a] when b < 0, else [a, b]")
    (@spec ((Arena Int Int) -> (List U32)))
    (@alloc arena)
    (let ((mut out (list-new arena U32)))
      (do (list-push out (cast U32 a)) (when (>= b 0) (list-push out (cast U32 b))) out)))

  (fn test-sriq-nom-rows ((arena Arena))
    (@intent "Nom: Example 2's (149), ⊤ → S₂(o, x), with B₁(o), gives (150), ⊤ → x ≈ o_{S₂¹}; n = 2 gives both children; no firing at |ρ| = Λ, or with the wrong children")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; (131)'s ⊤ ⊑ ≤1 S₂.⊤ is normalised to a fresh class A, here class 7,
    ;; with ⊤ → A(x) and the DL4 A(x) ∧ S₂(x, z₁) ∧ S₂(x, z₂) → z₁ ≈ z₂.
    ;; E4's root Hyper gives ⊤ → A(o), which r-Pred carries into v_{B₁}:
    ;; that is this row's ⊤ → B₁(o). The DL4 also runs through a fresh
    ;; sub-role S_{B₂} of S₂ (S₂(z₁, x) → S_{B₂}(z₁, x)), so Nom's second
    ;; premise is S_{B₂}(o, x), which Hyper derives from (149); role 2 is
    ;; S_{B₂} here. o is constant 0.
    (let ((x (at-x)) (o (at-u (cast U32 0))) (o2 (at-u (cast U32 2)))
          (ord (r-kids-order arena))
          (cb (r-top arena (one-lit arena (r-atom 7 o))))
          (c149 (r-top arena (one-lit arena (r-role 2 o x))))
          (p1 (r-premise arena ord cb (r-atom 7 o)))
          (p2 (r-premise arena ord c149 (r-role 2 o x)))
          (n1 (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 1) p1 p2 (r-ids arena 2 -1)))
          (n2 (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 2) p1 p2 (r-ids arena 2 3)))
          (d1 (r-premise arena ord (r-top arena (one-lit arena (r-atom 7 o2))) (r-atom 7 o2)))
          (d2 (r-premise arena ord (r-top arena (one-lit arena (r-role 2 o2 x))) (r-role 2 o2 x))))
      (and
        (. n1 fires)
        (clause-eq (assemble arena n1) (r-top arena (one-lit arena (eq-lit x o2))))
        (. n2 fires)
        (clause-eq (assemble arena n2) (r-top arena (two-lits arena (eq-lit x o2) (eq-lit x (at-u (cast U32 3))))))
        ;; o₂ is at depth 1: below Λ = 2 it fires, at Λ = 1 it does not.
        (. (nom-rule arena ord 2 (cast U32 7) (cast U32 2) (cast U32 1) d1 d2 (r-ids arena 4 -1)) fires)
        (not (. (nom-rule arena ord 1 (cast U32 7) (cast U32 2) (cast U32 1) d1 d2 (r-ids arena 4 -1)) fires))
        ;; The children must be o's S¹ … Sⁿ, in order, n of them.
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 2) p1 p2 (r-ids arena 3 2)) fires))
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 2) p1 p2 (r-ids arena 2 -1)) fires))
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 1) p1 p2 (r-ids arena 4 -1)) fires))
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 1) p1 p2 (r-ids arena 5 -1)) fires))
        ;; Children under role 3 fit S_{B₂} = 3, but the premise is S₂'s.
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 3) (cast U32 1) p1 p2 (r-ids arena 5 -1)) fires))
        ;; B₁(o) below B₁(f0(o)) is not maximal.
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 1)
                  (r-premise arena ord (r-top arena (two-lits arena (r-atom 7 o) (r-atom 7 (at-fu (cast U32 0) (cast U32 0))))) (r-atom 7 o))
                  p2 (r-ids arena 2 -1)) fires))
        ;; B₁'s argument must be a constant, and S_{B₂}'s second must be x.
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 1)
                  (r-premise arena ord (r-top arena (one-lit arena (r-atom 7 x))) (r-atom 7 x))
                  (r-premise arena ord (r-top arena (one-lit arena (r-role 2 x x))) (r-role 2 x x))
                  (r-ids arena 2 -1)) fires))
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 1) p1
                  (r-premise arena ord (r-top arena (one-lit arena (r-role 2 o (at-y)))) (r-role 2 o (at-y)))
                  (r-ids arena 2 -1)) fires))
        ;; The wrong class, role or constant.
        (not (. (nom-rule arena ord 5 (cast U32 6) (cast U32 2) (cast U32 1) p1 p2 (r-ids arena 2 -1)) fires))
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 1) (cast U32 1) p1 p2 (r-ids arena 2 -1)) fires))
        (not (. (nom-rule arena ord 5 (cast U32 7) (cast U32 2) (cast U32 1) p1 d2 (r-ids arena 2 -1)) fires)))))

  (fn test-sriq-depth-limit ((arena Arena))
    (@intent "Λ exactly when below 2⁶², and 2⁶² from there up, overflow included")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (== (depth-limit 2 3 4 6) 320)
         (== (depth-limit 0 0 1 2) 3)
         (== (depth-limit 30 30 3 1) 4611686018427387904)
         (== (depth-limit 30 30 4 1) 4611686018427387904)
         (== (depth-limit 30 29 6 1) (* 7 576460752303423488))
         (== (depth-limit 62 0 0 1) 4611686018427387904)
         (== (depth-limit 40 40 3 3) 4611686018427387904)
         ;; Just below the cap, exactly; and a held ω at the cap.
         (== (depth-limit 30 30 2 1) 3458764513820540928)
         (== (depth-limit 0 0 4611686018427387904 2) 4611686018427387904)))

  ;; ------------------------------------------------------------
  ;; Slice 8a: the context structure, triggers and strategies
  ;; (sriqctx.slop), and the Λ HOWL stores. O1 is [TGH21] Figure 1:
  ;; classes A 0, B 1, C 2, D 3, G 4, F1 5, F2 6, D1 7, D2 8; roles R 0,
  ;; S 1; function symbols f 0, g 1, h 2. Its (9) is printed in
  ;; [Bate+18]'s at-most form, R(x, z₁) ∧ R(x, z₂) → z₂ ≈ z₁, which is a
  ;; DL-clause all the same.
  ;; ------------------------------------------------------------

  (fn want ((label String) (got Bool) (expected Bool))
    (@intent "got is expected; otherwise say which row")
    (@spec ((String Bool Bool) -> Bool))
    (if (== got expected) true (do (print "  [sriq 8] ") (println label) false)))

  (fn want-int ((arena Arena) (label String) (got Int) (expected Int))
    (@intent "got is expected; otherwise say which row and what came")
    (@spec ((Arena String Int Int) -> Bool))
    (@alloc arena)
    (if (== got expected) true
      (do (print "  [sriq 8] ") (print label) (print ": got ") (println (int-to-string arena got)) false)))

  (fn o1-clauses ((arena Arena))
    (@intent "[TGH21] Figure 1's clauses (2) to (14)")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (z2 (at-z (cast U32 2)))
          (fx (r-fx 0)) (gx (r-fx 1)) (hx (r-fx 2))
          (mut out (list-new arena Clause)))
      (do
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 1 fx))))          ; (2)
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x fx))))        ; (3)
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 1 hx))))          ; (4)
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 1 x hx))))        ; (5)
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (lits2-of arena (r-atom 3 x) (r-atom 4 x)))) ; (6)
        (list-push out (r-clause arena (one-lit arena (r-atom 4 x)) (one-lit arena (r-atom 2 gx))))          ; (7)
        (list-push out (r-clause arena (one-lit arena (r-atom 4 x)) (one-lit arena (r-role 0 x gx))))        ; (8)
        (list-push out (r-clause arena (lits2-of arena (r-role 0 x z1) (r-role 0 x z2)) (one-lit arena (eq-lit z2 z1)))) ; (9)
        (list-push out (r-clause arena (lits2-of arena (r-atom 1 x) (r-atom 2 x)) (one-lit arena (r-atom 5 x)))) ; (10)
        (list-push out (r-clause arena (lits2-of arena (r-role 0 z1 x) (r-atom 5 x)) (one-lit arena (r-atom 7 z1)))) ; (11)
        (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 6 x))))           ; (12)
        (list-push out (r-clause arena (lits2-of arena (r-role 1 z1 x) (r-atom 6 x)) (one-lit arena (r-atom 8 z1)))) ; (13)
        (list-push out (r-clause arena (lits2-of arena (r-atom 7 x) (r-atom 8 x)) (one-lit arena (r-atom 3 x)))) ; (14)
        out)))

  (fn o1-triggers ((arena Arena))
    (@intent "O1's triggers: 9 classes, 2 roles, 3 function symbols")
    (@spec ((Arena) -> Triggers))
    (@alloc arena)
    (build-triggers arena (o1-clauses arena) 9 2 3))

  (fn test-sriq-triggers-rows ((arena Arena))
    (@intent "Definition 4 on O1, item by item: Su, Pr, Suʳ and Prʳ, τSu and τPr, and each function symbol's sole atom B(f(x)); then DL6's S(x, x), Table 1's DL4 and a symbol in two atoms")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((tr (o1-triggers arena))
          (x (at-x)) (y (at-y)) (a (at-u (cast U32 0))) (b (at-u (cast U32 1))) (fx (r-fx 0))
          (mut ok true))
      (do
        ;; Su: B(x) and B(u) for a body's B(x); D occurs in no body.
        (when (not (want "Su B(x)" (in-su tr (r-atom 1 x)) true)) (set! ok false))
        (when (not (want "Su B(u)" (in-su tr (r-atom 1 a)) true)) (set! ok false))
        (when (not (want "Su D(x)" (in-su tr (r-atom 3 x)) false)) (set! ok false))
        (when (not (want "Su D(u)" (in-su tr (r-atom 3 a)) false)) (set! ok false))
        (when (not (want "Su B(y)" (in-su tr (r-atom 1 y)) false)) (set! ok false))
        (when (not (want "Su B(f(x))" (in-su tr (r-atom 1 fx)) false)) (set! ok false))
        ;; (9)'s R(x, zᵢ) gives R(x, y); (11)'s R(z₁, x) and (13)'s S(z₁, x) give R(y, x) and S(y, x).
        (when (not (want "Su R(x,y)" (in-su tr (r-role 0 x y)) true)) (set! ok false))
        (when (not (want "Su R(y,x)" (in-su tr (r-role 0 y x)) true)) (set! ok false))
        (when (not (want "Su S(y,x)" (in-su tr (r-role 1 y x)) true)) (set! ok false))
        (when (not (want "Su S(x,y)" (in-su tr (r-role 1 x y)) false)) (set! ok false))
        (when (not (want "Su R(u,u)" (in-su tr (r-role 0 a b)) true)) (set! ok false))
        (when (not (want "Su R(x,u)" (in-su tr (r-role 0 x a)) false)) (set! ok false))
        (when (not (want "Su u≈u" (in-su tr (eq-lit a b)) true)) (set! ok false))
        (when (not (want "Su x≈y" (in-su tr (eq-lit x y)) false)) (set! ok false))
        (when (not (want "Su u≉u" (in-su tr (neq-lit a b)) false)) (set! ok false))
        ;; Pr: B(y) and B(u) for every class of O, D included; items 2 and 3 swap Su's.
        (when (not (want "Pr D(y)" (in-pr tr (r-atom 3 y)) true)) (set! ok false))
        (when (not (want "Pr D(u)" (in-pr tr (r-atom 3 a)) true)) (set! ok false))
        (when (not (want "Pr B(x)" (in-pr tr (r-atom 1 x)) false)) (set! ok false))
        (when (not (want "Pr R(x,y)" (in-pr tr (r-role 0 x y)) true)) (set! ok false))
        (when (not (want "Pr S(x,y)" (in-pr tr (r-role 1 x y)) true)) (set! ok false))
        (when (not (want "Pr R(y,x)" (in-pr tr (r-role 0 y x)) true)) (set! ok false))
        (when (not (want "Pr S(y,x)" (in-pr tr (r-role 1 y x)) false)) (set! ok false))
        (when (not (want "Pr x≈y" (in-pr tr (eq-lit x y)) true)) (set! ok false))
        (when (not (want "Pr x≈u" (in-pr tr (eq-lit x a)) true)) (set! ok false))
        (when (not (want "Pr y≈u" (in-pr tr (eq-lit y a)) true)) (set! ok false))
        (when (not (want "Pr x≈f(x)" (in-pr tr (eq-lit fx x)) false)) (set! ok false))
        ;; Suʳ and Prʳ: over O's predicates, with a constant.
        (when (not (want "Sur D(u)" (in-sur tr (r-atom 3 a)) true)) (set! ok false))
        (when (not (want "Sur S(y,u)" (in-sur tr (r-role 1 y a)) true)) (set! ok false))
        (when (not (want "Sur S(u,y)" (in-sur tr (r-role 1 a y)) true)) (set! ok false))
        (when (not (want "Sur S(x,u)" (in-sur tr (r-role 1 x a)) false)) (set! ok false))
        (when (not (want "Sur B(y)" (in-sur tr (r-atom 1 y)) false)) (set! ok false))
        (when (not (want "Prr B(y)" (in-prr tr (r-atom 1 y)) true)) (set! ok false))
        (when (not (want "Prr y≈u" (in-prr tr (eq-lit y a)) true)) (set! ok false))
        (when (not (want "Prr x≈u" (in-prr tr (eq-lit x a)) false)) (set! ok false))
        (when (not (want "Prr S(x,y)" (in-prr tr (r-role 1 x y)) false)) (set! ok false))
        ;; τSu = 8 unary + R out + R, S in; τPr = 9 classes + the same 3.
        (when (not (want-int arena "τSu" (tau-su tr) 11)) (set! ok false))
        (when (not (want-int arena "τPr" (tau-pr tr) 12)) (set! ok false))
        ;; f, g and h each occur in one atom B(f(x)), C(g(x)), B(h(x)).
        (when (not (want "sole f" (== (sole-at tr (cast U32 0)) (cast U32 1)) true)) (set! ok false))
        (when (not (want "sole g" (== (sole-at tr (cast U32 1)) (cast U32 2)) true)) (set! ok false))
        (when (not (want "sole h" (== (sole-at tr (cast U32 2)) (cast U32 1)) true)) (set! ok false))
        (when (not (triggers-edge-rows arena)) (set! ok false))
        ok)))

  (fn triggers-edge-rows ((arena Arena))
    (@intent "DL6's S(x, x) sets neither S(x, y) nor S(y, x); Table 1's DL4 sets its S_{B₂}'s S(x, y) and S's S(y, x); a symbol in two atoms B(f(x)) has no sole one, and one in none has none")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (a (at-u (cast U32 0))) (z1 (at-z (cast U32 1))) (z2 (at-z (cast U32 2)))
          (mut cs (list-new arena Clause))
          (mut ok true))
      (do
        ;; S 0: S(x, x) → B 0(x) (DL6).
        (list-push cs (r-clause arena (one-lit arena (r-role 0 x x)) (one-lit arena (r-atom 0 x))))
        ;; S 1, S_⊤ 2 (Table 1's DL4 for ⊤ ⊑ ≤1 S.⊤, with A 1 its ⊤):
        ;; S(z₁, x) → S_⊤(z₁, x); A(x) ∧ S_⊤(x, z₁) ∧ S_⊤(x, z₂) → z₁ ≈ z₂.
        (list-push cs (r-clause arena (one-lit arena (r-role 1 z1 x)) (one-lit arena (r-role 2 z1 x))))
        (list-push cs (r-clause arena (lits-of arena (r-atom 1 x) (r-role 2 x z1) (r-role 2 x z2))
                                (one-lit arena (eq-lit z1 z2))))
        ;; f 0 in two atoms, B 0(f(x)) and A 1(f(x)); f 1 in none.
        (list-push cs (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 0 (r-fx 0)))))
        (list-push cs (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 1 (r-fx 0)))))
        (list-push cs (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 1 x (r-fx 1)))))
        (let ((tr (build-triggers arena cs 2 3 2)))
          (do
            (when (not (want "DL6 Su S(x,y)" (in-su tr (r-role 0 x y)) false)) (set! ok false))
            (when (not (want "DL6 Su S(y,x)" (in-su tr (r-role 0 y x)) false)) (set! ok false))
            (when (not (want "DL6 Su S(u,u)" (in-su tr (r-role 0 a a)) true)) (set! ok false))
            (when (not (want "DL4 Su S_T(x,y)" (in-su tr (r-role 2 x y)) true)) (set! ok false))
            (when (not (want "DL4 Pr S_T(y,x)" (in-pr tr (r-role 2 y x)) true)) (set! ok false))
            (when (not (want "DL4 Su S(y,x)" (in-su tr (r-role 1 y x)) true)) (set! ok false))
            (when (not (want "DL4 Pr S(x,y)" (in-pr tr (r-role 1 x y)) true)) (set! ok false))
            (when (not (want "DL4 Su S(x,y)" (in-su tr (r-role 1 x y)) false)) (set! ok false))
            (when (not (want "two atoms, no sole" (== (sole-at tr (cast U32 0)) (cast U32 4294967295)) true)) (set! ok false))
            (when (not (want "no atom, no sole" (== (sole-at tr (cast U32 1)) (cast U32 4294967295)) true)) (set! ok false))
            (when (not (shape-rows)) (set! ok false))
            ok)))))

  (fn shape-rows ()
    (@intent "lit-ground and mentions-x read a unary atom's term only, and see x under f")
    (@spec (() -> Bool))
    (let ((x (at-x)) (y (at-y)) (o (at-u (cast U32 0))) (p (at-u (cast U32 1)))
          (fx (r-fx 0)) (fo (at-fu (cast U32 0) (cast U32 0))))
      (and (want "ground B(o)" (lit-ground (r-atom 0 o)) true)
           (want "ground B(f(o))" (lit-ground (r-atom 0 fo)) true)
           (want "ground B(x)" (lit-ground (r-atom 0 x)) false)
           (want "ground S(o, f(o))" (lit-ground (r-role 0 o fo)) true)
           (want "ground S(o, y)" (lit-ground (r-role 0 o y)) false)
           (want "ground o ≈ p" (lit-ground (eq-lit o p)) true)
           (want "ground o ≉ x" (lit-ground (neq-lit o x)) false)
           (want "x in B(x)" (mentions-x (r-atom 0 x)) true)
           (want "x in B(f(x))" (mentions-x (r-atom 0 fx)) true)
           (want "x in B(o)" (mentions-x (r-atom 0 o)) false)
           (want "x in S(y, x)" (mentions-x (r-role 0 y x)) true)
           (want "x in S(y, o)" (mentions-x (r-role 0 y o)) false)
           (want "x in f(x) ≈ o" (mentions-x (eq-lit fx o)) true))))

  (fn test-sriq-strategy-rows ((arena Arena))
    (@intent "Definition 5 on O1's Figures 2 and 3: for f with K₁ = {B(x), R(y, x)}, eager takes K₁, cautious {B(x)}, trivial ∅; cautious falls back to ∅ without the atom; then ω, ω_D and the stored Λ")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((tr (o1-triggers arena))
          (x (at-x)) (y (at-y))
          (k1f (lits2-of arena (r-atom 1 x) (r-role 0 y x)))
          (k1g (one-lit arena (r-role 0 y x)))
          (f (cast U32 0)) (g (cast U32 1))
          (mut ok true))
      (do
        (when (not (core-is arena "eager f" (strat-choice 'st-eager tr f k1f) k1f k1f)) (set! ok false))
        (when (not (core-is arena "cautious f" (strat-choice 'st-cautious tr f k1f) k1f (one-lit arena (r-atom 1 x)))) (set! ok false))
        (when (not (core-is arena "trivial f" (strat-choice 'st-trivial tr f k1f) k1f (no-lits arena))) (set! ok false))
        ;; g's sole atom is C(g(x)), and C(x) is not in K₁ (Figure 2's (19) is not Horn).
        (when (not (core-is arena "cautious g" (strat-choice 'st-cautious tr g k1g) k1g (no-lits arena))) (set! ok false))
        (when (not (core-is arena "eager g" (strat-choice 'st-eager tr g k1g) k1g k1g)) (set! ok false))
        ;; ω: 1, m = 9, 2^(9 + 2 + 1); ω_D for 9 query classes.
        (when (not (want-int arena "ω trivial" (omega 'st-trivial tr) 1)) (set! ok false))
        (when (not (want-int arena "ω cautious" (omega 'st-cautious tr) 9)) (set! ok false))
        (when (not (want-int arena "ω eager" (omega 'st-eager tr) 4096)) (set! ok false))
        (when (not (want-int arena "pow2 held" (pow2-sat 70) 4611686018427387904)) (set! ok false))
        (when (not (want-int arena "ω_D" (omega-d 9) 11)) (set! ok false))
        ;; The stored Λ: the floor below 10,001, Theorem 2's value above it.
        (when (not (want-int arena "Λ floored" (stored-lambda 2 3 4 6) 10001)) (set! ok false))
        (when (not (want-int arena "Λ at the floor" (stored-lambda 0 0 10000 1) 10001)) (set! ok false))
        (when (not (want-int arena "Λ above" (stored-lambda 10 4 0 1) 16384)) (set! ok false))
        (when (not (want-int arena "Λ for O1 cautious" (stored-lambda (tau-su tr) (tau-pr tr) (omega 'st-cautious tr) (omega-d 9))
                             (* 8388608 20))) (set! ok false))
        ok)))

  (fn core-is ((arena Arena) (label String) (cc CoreChoice) (k1 (List Lit)) (expected (List Lit)))
    (@intent "The chosen core is expected")
    (@spec ((Arena String CoreChoice (List Lit) (List Lit)) -> Bool))
    (@alloc arena)
    (let ((got (core-of arena cc k1))
          (mut same (== (list-len got) (list-len expected))))
      (do (for-each (l expected) (when (not (has-lit got l)) (set! same false)))
          (want label same true))))

  (fn test-sriq-structure-rows ((arena Arena))
    (@intent "A1–A2's structure: v_r, v_⊤ and one v_B per query class, all empty; ctx-by-core finds v_⊤ for ∅, never v_r, and v_B for {B(x)}; Definitions 2 and 3 on one clause of each kind")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((st (init-structure arena 3 2))
          (x (at-x)) (y (at-y)) (o (at-u (cast U32 0))) (p (at-u (cast U32 1)))
          (fx (r-fx 0)) (fo (at-fu (cast U32 0) (cast U32 0)))
          (mut ok true))
      (do
        (when (not (want-int arena "contexts" (ctx-count st) 5)) (set! ok false))
        (when (not (want "v_r is the root" (ctx-root-is st 0 true) true)) (set! ok false))
        (when (not (want "v_⊤ is not" (ctx-root-is st 1 false) true)) (set! ok false))
        (when (not (want "every set empty" (all-sets-empty st) true)) (set! ok false))
        (when (not (want-int arena "no edge" (cast Int (list-len (. st edges))) 0)) (set! ok false))
        (when (not (want-int arena "constants" (cast Int (list-len (. (. st ord) consts))) 2)) (set! ok false))
        (when (not (want "∅ is v_⊤" (== (ctx-by-core st (no-lits arena)) (cast U32 1)) true)) (set! ok false))
        (when (not (want "{B1(x)} is v_B1" (== (ctx-by-core st (one-lit arena (r-atom 1 x))) (cast U32 3)) true)) (set! ok false))
        (when (not (want "{B7(x)} is none" (== (ctx-by-core st (one-lit arena (r-atom 7 x))) (cast U32 4294967295)) true)) (set! ok false))
        ;; Definitions 2 and 3.
        (when (not (want "root ⊤ → B(o)" (ctx-clause-ok true (r-top arena (one-lit arena (r-atom 0 o)))) true)) (set! ok false))
        (when (not (want "root ⊤ → B(x)" (ctx-clause-ok true (r-top arena (one-lit arena (r-atom 0 x)))) false)) (set! ok false))
        (when (not (want "root ⊤ → S(o, f(o))" (ctx-clause-ok true (r-top arena (one-lit arena (r-role 0 o fo)))) true)) (set! ok false))
        (when (not (want "v ⊤ → S(o, f(o))" (ctx-clause-ok false (r-top arena (one-lit arena (r-role 0 o fo)))) false)) (set! ok false))
        (when (not (want "v ⊤ → B(f(x))" (ctx-clause-ok false (r-top arena (one-lit arena (r-atom 0 fx)))) true)) (set! ok false))
        (when (not (want "v ⊤ → S(f(x), y)" (ctx-clause-ok false (r-top arena (one-lit arena (r-role 0 fx y)))) false)) (set! ok false))
        (when (not (want "v ⊤ → S(y, o)" (ctx-clause-ok false (r-top arena (one-lit arena (r-role 0 y o)))) true)) (set! ok false))
        (when (not (want "v ⊤ → S(f(x), o)" (ctx-clause-ok false (r-top arena (one-lit arena (r-role 0 fx o)))) false)) (set! ok false))
        (when (not (want "v ⊤ → B(z₁)" (ctx-clause-ok false (r-top arena (one-lit arena (r-atom 0 (at-z (cast U32 1)))))) false)) (set! ok false))
        (when (not (want "v o ≈ p → B(x)" (ctx-clause-ok false (r-clause arena (one-lit arena (eq-lit o p)) (one-lit arena (r-atom 0 x)))) true)) (set! ok false))
        (when (not (want "v x ≈ o → B(x)" (ctx-clause-ok false (r-clause arena (one-lit arena (eq-lit x o)) (one-lit arena (r-atom 0 x)))) false)) (set! ok false))
        (when (not (want "v ⊤ → f(x) ≉ y" (ctx-clause-ok false (r-top arena (one-lit arena (neq-lit fx y)))) true)) (set! ok false))
        ok)))

  (fn ctx-root-is ((st Structure) (v Int) (root Bool))
    (@intent "Context v exists, with root flag root and an empty core")
    (@spec ((Structure Int Bool) -> Bool))
    (match (ctx-at st v)
      ((some c) (and (== (. c root) root) (== (list-len (. c core)) 0)))
      ((none)   false)))

  (fn all-sets-empty ((st Structure))
    (@intent "Every S_v is empty")
    (@spec ((Structure) -> Bool))
    (let ((mut ok true))
      (do (for-each (s (. st sets)) (when (> (list-len (. s cs)) 0) (set! ok false))) ok)))

  (fn role-triggers-ok ((tr Triggers) (l Lit))
    (@intent "A body atom S(s, t): S(u, u) in Su; S(x, zᵢ) gives S(x, y) in Su and S(y, x) in Pr; S(zᵢ, x) the reverse")
    (@spec ((Triggers Lit) -> Bool))
    (let ((x (at-x)) (y (at-y)) (u (at-u (cast U32 0)))
          (s (. (. l t1) kind)) (t (. (. l t2) kind)) (r (. l pred)))
      (and (in-su tr (atom2 r u u))
           (or (not (and (== s 'ak-x) (== t 'ak-z))) (and (in-su tr (atom2 r x y)) (in-pr tr (atom2 r y x))))
           (or (not (and (== s 'ak-z) (== t 'ak-x))) (and (in-su tr (atom2 r y x)) (in-pr tr (atom2 r x y)))))))

  (fn body-lit-triggers-ok ((tr Triggers) (l Lit))
    (@intent "One body atom's Definition 4 atoms: B(x) puts B(x) and B(u) in Su; a role atom as role-triggers-ok")
    (@spec ((Triggers Lit) -> Bool))
    (cond ((and (== (. l form) 'lf-unary) (== (. (. l t1) kind) 'ak-x))
            (and (in-su tr l) (in-su tr (atom1 (. l pred) (at-u (cast U32 0))))))
          ((== (. l form) 'lf-binary) (role-triggers-ok tr l))
          (else true)))

  (fn body-triggers-ok ((tr Triggers) (c Clause))
    (@intent "Each body atom of c puts its Definition 4 atoms into Su and Pr")
    (@spec ((Triggers Clause) -> Bool))
    (let ((mut ok true))
      (do (for-each (l (. c body)) (when (not (body-lit-triggers-ok tr l)) (set! ok false)))
          ok)))

  (fn test-sriq-triggers-on-fixtures ((arena Arena))
    (@intent "On every sriq fixture's clauses, each body atom's triggers are in Su and Pr")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do (for-each (p (sriq-fixtures arena))
            (match (fixture-sc arena p)
              ((none) (do (print "  [8a] no clauses: ") (println p) (set! ok false)))
              ((some sc)
                (let ((tr (triggers-of arena sc)))
                  (for-each (c (. sc clauses))
                    (when (not (body-triggers-ok tr c)) (do (print "  [8a] triggers: ") (println p) (set! ok false))))))))
          ok)))

  (fn fixture-sc ((arena Arena) (path String))
    (@intent "A fixture's clauses, through the gate, the normaliser and the boundary")
    (@spec ((Arena String) -> (Option SriqClauses)))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-sriq)
      ((none) (none))
      ((some gr)
        (match (sriq-nf arena gr false false false)
          ((error _) (none))
          ((ok n) (match (sriq-clauses arena n) ((error _) (none)) ((ok sc) (some sc))))))))

  ;; ------------------------------------------------------------
  ;; Slice 8b: Table 3 (rules/sriq.slop), row by row. O1 as in 8a. O3
  ;; ([TGH21] Figure 6, Example 1): classes A 0, B 1, C 2, D 3, E 4,
  ;; F 5; roles R 0, S 1; function symbols f 0, g 1; the constant o 0.
  ;; ------------------------------------------------------------

  (fn o3-clauses ((arena Arena))
    (@intent "[TGH21] Figure 6's clauses (83) to (92)")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (o (at-u (cast U32 0)))
          (fx (r-fx 0)) (gx (r-fx 1))
          (mut out (list-new arena Clause)))
      (do
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 1 fx))))           ; (83)
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x fx))))         ; (84)
        (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 2 gx))))           ; (85)
        (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-role 1 x gx))))         ; (86)
        (list-push out (r-clause arena (one-lit arena (r-atom 2 x)) (lits2-of arena (r-atom 5 x) (r-atom 3 x)))) ; (87)
        (list-push out (r-clause arena (lits2-of arena (r-atom 2 x) (r-atom 3 x)) (one-lit arena (r-atom 4 x)))) ; (88)
        (list-push out (r-clause arena (lits2-of arena (r-role 0 z1 x) (r-atom 5 x)) (one-lit arena (r-atom 5 z1)))) ; (89)
        (list-push out (r-clause arena (lits2-of arena (r-role 1 z1 x) (r-atom 4 x)) (one-lit arena (r-atom 5 z1)))) ; (90)
        (list-push out (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (eq-lit x o))))            ; (91)
        (list-push out (r-clause arena (one-lit arena (r-atom 3 x)) (one-lit arena (eq-lit x o))))            ; (92)
        out)))

  (fn o3-fixed-clauses ((arena Arena))
    (@intent "O3 as Example 1 runs it: Figure 6 prints (87) as C ⊑ F ⊔ D, but the example's own (94) ⊤ → F(x) ∨ D(x) in v_A, and v_C's clauses, need A ⊑ F ⊔ D. As printed O3 does not entail A ⊑ F (HermiT agrees); corrected it does")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (mut out (list-new arena Clause)))
      (do (for-each (c (o3-clauses arena))
            (when (not (clause-eq c (r-clause arena (one-lit arena (r-atom 2 x)) (lits2-of arena (r-atom 5 x) (r-atom 3 x)))))
              (list-push out c)))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (lits2-of arena (r-atom 5 x) (r-atom 3 x))))
          out)))

  (fn o3-triggers ((arena Arena))
    (@intent "O3's triggers: 6 classes, 2 roles, 2 function symbols")
    (@spec ((Arena) -> Triggers))
    (@alloc arena)
    (build-triggers arena (o3-clauses arena) 6 2 2))

  (fn lits-same-set ((a (List Lit)) (b (List Lit)))
    (@intent "The same literals, as sets")
    (@spec (((List Lit) (List Lit)) -> Bool))
    (let ((mut ok (== (list-len a) (list-len b))))
      (do (for-each (l a) (when (not (has-lit b l)) (set! ok false))) ok)))

  (fn sig-of ((f Int))
    (@intent "Succ's successor term f(x), away from the root")
    (@spec ((Int) -> SuccSig))
    (record-new SuccSig (f (cast U32 f)) (root false) (u (cast U32 0))))

  (fn sig-root ((f Int) (u Int))
    (@intent "Succ's successor term f(u), at the root")
    (@spec ((Int Int) -> SuccSig))
    (record-new SuccSig (f (cast U32 f)) (root true) (u (cast U32 u))))

  (fn o1-va ((arena Arena))
    (@intent "Clauses of O1's v_A, from Figures 2 and 3: (15), (16), (17), (18), (22), (23), (25), (26)")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (fx (r-fx 0)) (hx (r-fx 2))
          (mut cs (list-new arena Clause)))
      (do (list-push cs (r-top arena (one-lit arena (r-atom 0 x))))                                ; (15)
          (list-push cs (r-top arena (one-lit arena (r-atom 1 fx))))                               ; (16)
          (list-push cs (r-top arena (one-lit arena (r-role 0 x fx))))                             ; (17)
          (list-push cs (r-top arena (lits2-of arena (r-atom 3 x) (r-atom 4 x))))                  ; (18)
          (list-push cs (r-top arena (lits2-of arena (r-atom 3 x) (r-atom 2 fx))))                 ; (22)
          (list-push cs (r-top arena (lits2-of arena (r-atom 3 x) (r-role 0 x fx))))               ; (23)
          (list-push cs (r-top arena (one-lit arena (r-atom 1 hx))))                               ; (25)
          (list-push cs (r-top arena (one-lit arena (r-role 1 x hx))))                             ; (26)
          cs)))

  (fn succ-is ((arena Arena) (label String) (c SuccConcl) (fires Bool) (kind CoreKind) (adds (List Lit)))
    (@intent "Succ's verdict, choice of core and added atoms are as expected")
    (@spec ((Arena String SuccConcl Bool CoreKind (List Lit)) -> Bool))
    (want label (and (== (. c fires) fires) (== (. (. c choice) kind) kind) (lits-same-set (. c adds) adds)) true))

  (fn test-sriq-succ-rows ((arena Arena))
    (@intent "Succ on O1: K₁ and K₂ for f in v_A (Figure 2's text), the eager, cautious and trivial instances with their added clauses (31), (39)–(40), and h's (43); covered targets do not fire; a ground atom joins K₂ but not K₁; the root reads f(u)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((tr (o1-triggers arena)) (ord (named-consts arena 1))
          (x (at-x)) (y (at-y)) (o (at-u (cast U32 0))) (fx (r-fx 0))
          (va (o1-va arena))
          (ksf (k-sets arena ord tr (sig-of 0) va))
          (ksh (k-sets arena ord tr (sig-of 2) va))
          (p16 (r-premise arena ord (r-top arena (one-lit arena (r-atom 1 fx))) (r-atom 1 fx)))
          (bx (r-atom 1 x)) (ryx (r-role 0 y x)) (cx (r-atom 2 x)) (syx (r-role 1 y x))
          (mut ok true))
      (do
        ;; K₂ = {B(x), R(y, x), C(x)} from (16), (17), (22), (23); K₁ = {B(x), R(y, x)} from (16), (17).
        (when (not (want "K2 for f" (lits-same-set (. ksf k2) (lits-of arena bx ryx cx)) true)) (set! ok false))
        (when (not (want "K1 for f" (lits-same-set (. ksf k1) (lits2-of arena bx ryx)) true)) (set! ok false))
        (when (not (want "K1 = K2 for h" (and (lits-same-set (. ksh k2) (lits2-of arena bx syx)) (lits-same-set (. ksh k1) (lits2-of arena bx syx))) true)) (set! ok false))
        ;; Eager adds (31) C(x) → C(x); cautious (39) and (40); trivial all three.
        (when (not (succ-is arena "eager f" (succ-step arena 'st-eager tr (sig-of 0) p16 ksf false) true 'cc-k1 (one-lit arena cx))) (set! ok false))
        (when (not (succ-is arena "cautious f" (succ-step arena 'st-cautious tr (sig-of 0) p16 ksf false) true 'cc-unary (lits2-of arena ryx cx))) (set! ok false))
        (when (not (succ-is arena "trivial f" (succ-step arena 'st-trivial tr (sig-of 0) p16 ksf false) true 'cc-empty (lits-of arena bx ryx cx))) (set! ok false))
        (when (not (succ-is arena "cautious h, (43)" (succ-step arena 'st-cautious tr (sig-of 2) p16 ksh false) false 'cc-unary (one-lit arena syx))) (set! ok false))
        (when (not (succ-is arena "covered" (succ-step arena 'st-eager tr (sig-of 0) p16 ksf true) false 'cc-k1 (one-lit arena cx))) (set! ok false))
        (when (not (succ-covers-rows arena ksf)) (set! ok false))
        (when (not (succ-ground-and-root arena tr ord)) (set! ok false))
        (when (not (succ-edge-rows arena tr ord)) (set! ok false))
        ok)))

  (fn succ-edge-rows ((arena Arena) (tr Triggers) (ord SriqOrder))
    (@intent "K₂ reads only maximal images: B(f(x)) under B(g(x)) is not one, though for g it is; K₁ only unit clauses; the root reads its own u's f(u) only; Succ never fires on an equality")
    (@spec ((Arena Triggers SriqOrder) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (o (at-u (cast U32 0))) (q (at-u (cast U32 1))) (fx (r-fx 0)) (gx (r-fx 1))
          (fo (at-fu (cast U32 0) (cast U32 0))) (fq (at-fu (cast U32 0) (cast U32 1)))
          (both (r-one arena (r-top arena (lits2-of arena (r-atom 1 fx) (r-atom 1 gx)))))
          (bodied (r-one arena (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-atom 1 fx)))))
          (mut rs (list-new arena Clause))
          (peq (r-premise arena ord (r-top arena (one-lit arena (eq-lit fx y))) (eq-lit fx y))))
      (do (list-push rs (r-top arena (one-lit arena (r-atom 1 fo))))
          (list-push rs (r-top arena (one-lit arena (r-atom 2 fq))))
          (and (want "B(f(x)) under B(g(x)) is not maximal" (== (list-len (. (k-sets arena ord tr (sig-of 0) both) k2)) 0) true)
               (want "B(g(x)) is" (lits-same-set (. (k-sets arena ord tr (sig-of 1) both) k2) (one-lit arena (r-atom 1 x))) true)
               (want "C(x) → B(f(x)): K2" (lits-same-set (. (k-sets arena ord tr (sig-of 0) bodied) k2) (one-lit arena (r-atom 1 x))) true)
               (want "C(x) → B(f(x)): not K1" (== (list-len (. (k-sets arena ord tr (sig-of 0) bodied) k1)) 0) true)
               (want "the root reads o's f(o), not q's" (lits-same-set (. (k-sets arena ord tr (sig-root 0 0) rs) k2) (one-lit arena (r-atom 1 x))) true)
               (want "no Succ on f(x) ≈ y" (. (succ-step arena 'st-eager tr (sig-of 0) peq (k-sets arena ord tr (sig-of 0) both) false) fires) false)))))

  (fn succ-covers-rows ((arena Arena) (ksf KSets))
    (@intent "An f-edge's target covers K₂ once it holds A′ → A′ for each A′ outside its core: (31) for v_{R,B}, (39) and (40) for v_B; ⊤ → A′ also does")
    (@spec ((Arena KSets) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y))
          (bx (r-atom 1 x)) (ryx (r-role 0 y x)) (cx (r-atom 2 x))
          (c31 (r-clause arena (one-lit arena cx) (one-lit arena cx)))
          (c39 (r-clause arena (one-lit arena ryx) (one-lit arena ryx)))
          (mut w1 (list-new arena Clause)) (mut w2 (list-new arena Clause)) (mut w3 (list-new arena Clause)))
      (do (list-push w1 c31) (list-push w2 c39) (list-push w2 c31) (list-push w3 c39)
          (list-push w3 (r-top arena (one-lit arena cx)))
          (and (want "eager target with (31)" (covers (. ksf k2) (lits2-of arena bx ryx) w1) true)
               (want "eager target without" (covers (. ksf k2) (lits2-of arena bx ryx) (list-new arena Clause)) false)
               (want "cautious target with (39), (40)" (covers (. ksf k2) (one-lit arena bx) w2) true)
               (want "cautious target with (31) only" (covers (. ksf k2) (one-lit arena bx) w1) false)
               (want "⊤ → C(x) holds C(x) → C(x)" (covers (. ksf k2) (one-lit arena bx) w3) true)
               (want "u ≈ u → u ≈ u is a tautology" (unit-held (eq-lit (at-u (cast U32 0)) (at-u (cast U32 0))) (list-new arena Clause)) true)))))

  (fn succ-ground-and-root ((arena Arena) (tr Triggers) (ord SriqOrder))
    (@intent "A maximal ground atom of Su(O) joins K₂ but not K₁; at the root the successor term is f(u), and y's image is u")
    (@spec ((Arena Triggers SriqOrder) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (o (at-u (cast U32 0))) (fx (r-fx 0)) (fo (at-fu (cast U32 0) (cast U32 0)))
          (mut cs (list-new arena Clause)) (mut rs (list-new arena Clause)))
      (do (list-push cs (r-top arena (one-lit arena (r-atom 1 fx))))
          (list-push cs (r-top arena (one-lit arena (r-atom 1 o))))
          (list-push rs (r-top arena (one-lit arena (r-atom 1 fo))))
          (list-push rs (r-top arena (one-lit arena (r-role 0 o fo))))
          (let ((ks (k-sets arena ord tr (sig-of 0) cs))
                (kr (k-sets arena ord tr (sig-root 0 0) rs)))
            (and (want "ground B(o) in K2" (lits-same-set (. ks k2) (lits2-of arena (r-atom 1 x) (r-atom 1 o))) true)
                 (want "ground B(o) not in K1" (lits-same-set (. ks k1) (one-lit arena (r-atom 1 x))) true)
                 (want "root K1" (lits-same-set (. kr k1) (lits2-of arena (r-atom 1 x) (r-role 0 y x))) true)
                 (want "root reads f(u), not f(x)" (== (list-len (. (k-sets arena ord tr (sig-of 0) rs) k2)) 0) true))))))

  (fn pre-is ((sg SuccSig) (a Lit))
    (@intent "succ-pre gives back a from aσ")
    (@spec ((SuccSig Lit) -> Bool))
    (let ((r (succ-pre sg (csub-lit (succ-csub sg) a))))
      (and (. r ok) (lit-eq (. r lit) a))))

  (fn test-sriq-succ-pre-inverts ((arena Arena))
    (@intent "Over a bounded universe, succ-pre inverts Succ's σ on every atom of Su(O)'s shapes, away from the root and at it, and refuses what is no image")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (a (at-u (cast U32 0))) (b (at-u (cast U32 1)))
          (mut ok true) (mut f 0))
      (do
        (while (< f 2)
          (do (for-each (sg (lits-sigs arena f))
                (do (when (not (and (pre-is sg (r-atom 0 x)) (pre-is sg (r-atom 1 x))
                                    (pre-is sg (r-role 0 x y)) (pre-is sg (r-role 0 y x))
                                    (pre-is sg (r-atom 0 a)) (pre-is sg (r-role 1 a b))
                                    (pre-is sg (eq-lit a b)) (pre-is sg (eq-lit a a))))
                      (do (print "  [8b] succ-pre does not invert, f ") (println (int-to-string arena f)) (set! ok false)))))
              (set! f (+ f 1))))
        ;; No preimage: another symbol's term, y alone, an inequality, f(x) against f(x).
        (when (not (want "B(g(x)) for f" (. (succ-pre (sig-of 0) (r-atom 0 (r-fx 1))) ok) false)) (set! ok false))
        (when (not (want "B(y)" (. (succ-pre (sig-of 0) (r-atom 0 y)) ok) false)) (set! ok false))
        (when (not (want "a ≉ b" (. (succ-pre (sig-of 0) (neq-lit a b)) ok) false)) (set! ok false))
        (when (not (want "S(f(x), f(x))" (. (succ-pre (sig-of 0) (r-role 0 (r-fx 0) (r-fx 0))) ok) false)) (set! ok false))
        (when (not (want "S(f(o), b) at o" (. (succ-pre (sig-root 0 0) (r-role 0 (at-fu (cast U32 0) (cast U32 0)) b)) ok) false)) (set! ok false))
        (when (not (want "ground B(f(o)) away from the root" (. (succ-pre (sig-of 0) (r-atom 0 (at-fu (cast U32 0) (cast U32 0)))) ok) false)) (set! ok false))
        ok)))

  (fn lits-sigs ((arena Arena) (f Int))
    (@intent "Succ's σ for f away from the root, and at the root for constants 0 and 1")
    (@spec ((Arena Int) -> (List SuccSig)))
    (@alloc arena)
    (let ((mut out (list-new arena SuccSig)))
      (do (list-push out (sig-of f)) (list-push out (sig-root f 0)) (list-push out (sig-root f 1)) out)))

  (fn test-sriq-rsucc-rows ((arena Arena))
    (@intent "r-Succ on Example 1: (96) gives (114), (110) gives (115), (111) gives (116) with the edge to v_r; not when held, not with y, not for a constant the atom lacks, not in v_r; one instance per constant of S(o, p)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((tr (o3-triggers arena)) (ord (named-consts arena 2))
          (x (at-x)) (y (at-y)) (o (at-u (cast U32 0))) (q (at-u (cast U32 1)))
          (c96 (r-top arena (lits2-of arena (r-atom 5 x) (r-atom 3 o))))
          (p96 (r-premise arena ord c96 (r-atom 3 o)))
          (p110 (r-premise arena ord (r-top arena (one-lit arena (r-atom 2 o))) (r-atom 2 o)))
          (p111 (r-premise arena ord (r-top arena (one-lit arena (r-role 1 x o))) (r-role 1 x o)))
          (pyo (r-premise arena ord (r-top arena (one-lit arena (r-role 1 y o))) (r-role 1 y o)))
          (poq (r-premise arena ord (r-top arena (one-lit arena (r-role 1 o q))) (r-role 1 o q)))
          (u0 (cast U32 0)) (u1 (cast U32 1)) (u2 (cast U32 2)))
      (and (want "(96) → (114)" (rsucc-is (rsucc-rule tr false p96 u0 false) true (r-atom 3 o)) true)
           (want "(110) → (115)" (rsucc-is (rsucc-rule tr false p110 u0 false) true (r-atom 2 o)) true)
           (want "(111) → (116)" (rsucc-is (rsucc-rule tr false p111 u0 false) true (r-role 1 y o)) true)
           (want "held" (. (rsucc-rule tr false p111 u0 true) fires) false)
           (want "y in the literal" (. (rsucc-rule tr false pyo u0 false) fires) false)
           (want "a constant it lacks" (. (rsucc-rule tr false p110 u1 false) fires) false)
           (want "S(o, q) for o" (. (rsucc-rule tr false poq u0 false) fires) true)
           (want "S(o, q) for q" (. (rsucc-rule tr false poq u1 false) fires) true)
           (want "S(o, q) for neither" (. (rsucc-rule tr false poq u2 false) fires) false)
           (want "not at the root" (. (rsucc-rule tr true p110 u0 false) fires) false))))

  (fn rsucc-is ((c RSuccConcl) (fires Bool) (l Lit))
    (@intent "r-Succ's verdict and its A")
    (@spec ((RSuccConcl Bool Lit) -> Bool))
    (and (== (. c fires) fires) (lit-eq (. c lit) l)))

  (fn side-cands ((arena Arena) (ord SriqOrder) (ws (List Clause)))
    (@intent "Every head literal of every clause of ws, selected")
    (@spec ((Arena SriqOrder (List Clause)) -> (List Premise)))
    (@alloc arena)
    (let ((mut out (list-new arena Premise)))
      (do (for-each (c ws) (for-each (p (r-premises arena ord c)) (list-push out p))) out)))

  (fn pred-concls ((arena Arena) (ord SriqOrder) (tr Triggers) (to-root Bool) (s CSub) (edge Bool)
                   (c Clause) (core (List Lit)) (ws (List Clause)))
    (@intent "Every Pred conclusion of main premise c (core core) into w, whose set is ws, under σ s, each once")
    (@spec ((Arena SriqOrder Triggers Bool CSub Bool Clause (List Lit) (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((v (pred-view arena c core to-root))
          (ps (side-cands arena ord ws))
          (mut cs (list-new arena PCands))
          (mut out (list-new arena Clause)))
      (do (for-each (l (. v slots)) (list-push cs (record-new PCands (slot (record-new PSlot (lit l) (edge true))) (ps ps))))
          (for-each (st (pred-join arena (pred-start arena edge) s cs))
            (let ((r (pred-finish arena st s tr to-root v)))
              (when (. r fires) (list-push out (assemble arena r)))))
          (r-useful arena out))))

  (fn test-sriq-pred-rows ((arena Arena))
    (@intent "Pred on O1: (33) + (22) gives (24) under eager; (42) + (23) + (22) gives (24) under cautious; (37) gives (27) with no side premise; (45) + (26) gives (27) through h; not through the wrong edge, nor without one, nor for a head outside Pr(O)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((tr (o1-triggers arena)) (ord (named-consts arena 1))
          (x (at-x)) (y (at-y)) (o (at-u (cast U32 0)))
          (va (o1-va arena))
          (sf (succ-csub (sig-of 0))) (sh (succ-csub (sig-of 2)))
          (c33 (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-atom 7 y))))
          (c42 (r-clause arena (lits2-of arena (r-role 0 y x) (r-atom 2 x)) (one-lit arena (r-atom 7 y))))
          (c37 (r-top arena (one-lit arena (r-atom 8 y))))
          (c45 (r-clause arena (one-lit arena (r-role 1 y x)) (one-lit arena (r-atom 8 y))))
          (c24 (r-top arena (lits2-of arena (r-atom 3 x) (r-atom 7 x))))
          (c27 (r-top arena (one-lit arena (r-atom 8 x))))
          (bx (one-lit arena (r-atom 1 x))) (nocore (no-lits arena)))
      (and (want "(33) + (22) → (24)" (same-clause-set (pred-concls arena ord tr false sf true c33 bx va) (r-one arena c24)) true)
           (want "(42) + (23) + (22) → (24)" (same-clause-set (pred-concls arena ord tr false sf true c42 bx va) (r-one arena c24)) true)
           (want "(37) → (27)" (same-clause-set (pred-concls arena ord tr false sf true c37 bx va) (r-one arena c27)) true)
           (want "(45) + (26) → (27) through h" (same-clause-set (pred-concls arena ord tr false sh true c45 bx va) (r-one arena c27)) true)
           (want "(42) through h: no R(x, h(x))" (== (list-len (pred-concls arena ord tr false sh true c42 bx va)) 0) true)
           (want "no edge" (== (list-len (pred-concls arena ord tr false sf false c37 bx va)) 0) true)
           (want "head B(x) is not in Pr" (== (list-len (pred-concls arena ord tr false sf true (r-top arena bx) nocore va)) 0) true)
           (want "S(x, o) only into the root" (== (list-len (pred-concls arena ord tr false sf true (r-top arena (one-lit arena (r-role 0 x o))) nocore va)) 0) true)
           (pred-edge-rows arena tr ord))))

  (fn pred-edge-rows ((arena Arena) (tr Triggers) (ord SriqOrder))
    (@intent "Pred's side premise must be maximal: C(f(x)) under C(g(x)) is not, C(g(x)) is; two candidates for one slot give two conclusions; and the rows into v_r")
    (@spec ((Arena Triggers SriqOrder) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (y (at-y)) (fx (r-fx 0)) (gx (r-fx 1))
          (c33 (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-atom 7 y))))
          (under (r-one arena (r-top arena (lits2-of arena (r-atom 2 fx) (r-atom 2 gx)))))
          (mut two (list-new arena Clause)) (mut want2 (list-new arena Clause)))
      (do (list-push two (r-top arena (one-lit arena (r-atom 2 fx))))
          (list-push two (r-top arena (lits2-of arena (r-atom 4 x) (r-atom 2 fx))))
          (list-push want2 (r-top arena (one-lit arena (r-atom 7 x))))
          (list-push want2 (r-top arena (lits2-of arena (r-atom 4 x) (r-atom 7 x))))
          (and (want "C(f(x)) under C(g(x))" (== (list-len (pred-concls arena ord tr false (succ-csub (sig-of 0)) true c33 (no-lits arena) under)) 0) true)
               (want "C(g(x)) is maximal" (same-clause-set (pred-concls arena ord tr false (succ-csub (sig-of 1)) true c33 (no-lits arena) under)
                                                          (r-one arena (r-top arena (lits2-of arena (r-atom 2 fx) (r-atom 7 x))))) true)
               (want "two candidates, two conclusions" (same-clause-set (pred-concls arena ord tr false (succ-csub (sig-of 0)) true c33 (no-lits arena) two) want2) true)
               (pred-root-rows arena)))))

  (fn pred-root-rows ((arena Arena))
    (@intent "Pred into v_r (E4): with core {A(x)}, v's ⊤ → x ≈ b meets the root's ⊤ → A(f(a)) for u = a only, giving ⊤ → f(a) ≈ b; S(x, o) may go to the root; the core is a side premise too. Example 1's (113) + (98) gives D(o) → F(x), and Example 2's (166) gives (147)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((tr (o3-triggers arena)) (ord (named-consts arena 2))
          (x (at-x)) (y (at-y)) (a (at-u (cast U32 0))) (b (at-u (cast U32 1)))
          (fa (at-fu (cast U32 0) (cast U32 0))) (fx (r-fx 0)) (gx (r-fx 1))
          (core (one-lit arena (r-atom 0 x)))
          (root (r-one arena (r-top arena (one-lit arena (r-atom 0 fa)))))
          (cxb (r-top arena (one-lit arena (eq-lit x b))))
          (sa (succ-csub (sig-root 0 0))) (sb (succ-csub (sig-root 0 1)))
          (c113 (r-clause arena (lits2-of arena (r-atom 3 a) (r-role 0 y x)) (one-lit arena (r-atom 5 y))))
          (va (r-one arena (r-top arena (one-lit arena (r-role 0 x fx))))))
      (and (want "into v_r for u = a" (same-clause-set (pred-concls arena ord tr true sa true cxb core root)
                                                      (r-one arena (r-top arena (one-lit arena (eq-lit fa b))))) true)
           (want "into v_r for u = b" (== (list-len (pred-concls arena ord tr true sb true cxb core root)) 0) true)
           (want "the core is a side premise" (== (list-len (pred-concls arena ord tr true sa true cxb (one-lit arena (r-atom 1 x)) root)) 0) true)
           (want "(113) + (98)" (same-clause-set (pred-concls arena ord tr false (succ-csub (sig-of 0)) true c113 core va)
                                                 (r-one arena (r-clause arena (one-lit arena (r-atom 3 a)) (one-lit arena (r-atom 5 x))))) true)
           (want "(166) → (147)" (same-clause-set (pred-concls arena ord tr false (succ-csub (sig-of 1)) true
                                                               (r-top arena (one-lit arena (r-role 1 x y))) core (list-new arena Clause))
                                                  (r-one arena (r-top arena (one-lit arena (r-role 1 gx x))))) true))))

  (fn rpred-concls ((arena Arena) (ord SriqOrder) (tr Triggers) (c Clause) (edges (List U32)) (ws (List Clause)))
    (@intent "Every r-Pred conclusion of the root clause c into v, whose set is ws and whose edges to v_r carry the constants edges, each once")
    (@spec ((Arena SriqOrder Triggers Clause (List U32) (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((v (rpred-view arena tr c))
          (ps (side-cands arena ord ws))
          (s (record-new CSub (x (at-x)) (y (at-x))))
          (mut cs (list-new arena PCands))
          (mut out (list-new arena Clause)))
      (do (for-each (l (. v slots))
            (list-push cs (record-new PCands (slot (record-new PSlot (lit l) (edge (slot-has-edge l edges)))) (ps ps))))
          (for-each (st (pred-join arena (pred-start arena true) s cs))
            (let ((r (rpred-finish arena st tr v)))
              (when (. r fires) (list-push out (assemble arena r)))))
          (r-useful arena out))))

  (fn slot-has-edge ((l Lit) (edges (List U32)))
    (@intent "Is the constant of the slot S(y, u) or S(u, y) among the edges' constants?")
    (@spec ((Lit (List U32)) -> Bool))
    (let ((u (if (== (. (. l t1) kind) 'ak-u) (. (. l t1) cst) (. (. l t2) cst)))
          (mut found false))
      (do (for-each (e edges) (when (== e u) (set! found true))) found)))

  (fn test-sriq-rpred-rows ((arena Arena))
    (@intent "r-Pred on Example 1: (118) + (111) gives C(o) ∧ D(o) → F(x), carrying the ground atoms (E3); not without the edge; a root clause with no Cᵢ reaches v; E5 refuses f(u) in the head or in a carried atom; a body atom outside Suʳ(O), or a head outside Prʳ(O), refuses")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((tr (o3-triggers arena)) (ord (named-consts arena 2))
          (x (at-x)) (y (at-y)) (o (at-u (cast U32 0))) (fo (at-fu (cast U32 0) (cast U32 0)))
          (c118 (r-clause arena (lits-of arena (r-atom 2 o) (r-atom 3 o) (r-role 1 y o)) (one-lit arena (r-atom 5 y))))
          (vb (r-one arena (r-top arena (one-lit arena (r-role 1 x o)))))
          (eo (r-u32s arena 0)) (none-e (list-new arena U32)))
      (and (want "(118) + (111)" (same-clause-set (rpred-concls arena ord tr c118 eo vb)
                                                 (r-one arena (r-clause arena (lits2-of arena (r-atom 2 o) (r-atom 3 o)) (one-lit arena (r-atom 5 x))))) true)
           (want "no edge" (== (list-len (rpred-concls arena ord tr c118 none-e vb)) 0) true)
           (want "no Cᵢ" (same-clause-set (rpred-concls arena ord tr (r-top arena (one-lit arena (r-atom 1 o))) none-e vb)
                                          (r-one arena (r-top arena (one-lit arena (r-atom 1 o))))) true)
           (want "E5: S(o, f(o))" (== (list-len (rpred-concls arena ord tr (r-top arena (one-lit arena (r-role 0 o fo))) none-e vb)) 0) true)
           (want "B(y) in the body, though v has ⊤ → B(x)" (== (list-len (rpred-concls arena ord tr (r-clause arena (one-lit arena (r-atom 1 y)) (one-lit arena (r-atom 5 y))) eo
                                                                       (r-one arena (r-top arena (one-lit arena (r-atom 1 x)))))) 0) true)
           (want "S(y, y) in the head" (== (list-len (rpred-concls arena ord tr (r-top arena (one-lit arena (r-role 1 y y))) none-e vb)) 0) true)
           (want "E5: B(f(o)) carried" (== (list-len (rpred-concls arena ord tr (r-clause arena (one-lit arena (r-atom 1 fo)) (one-lit arena (r-atom 1 o))) none-e vb)) 0) true))))

  (fn r-u32s ((arena Arena) (u Int))
    (@intent "[u]")
    (@spec ((Arena Int) -> (List U32)))
    (@alloc arena)
    (let ((mut out (list-new arena U32))) (do (list-push out (cast U32 u)) out)))

  ;; ------------------------------------------------------------
  ;; Slice 8c: the literal reference evaluator (sriqref.slop), end to
  ;; end, under all three strategies.
  ;; ------------------------------------------------------------

  (fn ref-cfg ((s Strategy))
    (@intent "The reference's configuration: 10,000 rounds, the stored Λ, and caps a naive run can afford: 512 contexts, 4,000 clauses, 10⁶ choices per instance, 8 constants from Nom")
    (@spec ((Strategy) -> RefConfig))
    (record-new RefConfig (strat s) (fuel 10000) (lam -1) (ctxs 512) (cls 4000) (prod 1000000) (cnst 8)))

  (fn ref-in ((arena Arena) (onto (List Clause)) (nclass Int) (nquery Int) (nrole Int) (nfn Int) (nconst Int))
    (@intent "A hand-built input, with no hidden query class")
    (@spec ((Arena (List Clause) Int Int Int Int Int) -> RefIn))
    (@alloc arena)
    (record-new RefIn (onto onto) (nclass nclass) (nquery nquery) (nrole nrole) (nfn nfn) (nconst nconst)
                      (hidden (list-new arena U32))))

  (fn strategies ((arena Arena))
    (@intent "trivial, eager, cautious")
    (@spec ((Arena) -> (List Strategy)))
    (@alloc arena)
    (let ((mut out (list-new arena Strategy)))
      (do (list-push out 'st-trivial) (list-push out 'st-eager) (list-push out 'st-cautious) out)))

  (fn strat-name ((s Strategy))
    (@intent "Its name")
    (@spec ((Strategy) -> String))
    (match s ('st-trivial "trivial") ('st-eager "eager") ('st-cautious "cautious")))

  (fn complete-run ((r RefResult))
    (@intent "Did the run end at the fixpoint or at ⊤ → ⊥, never at a cap or out of fuel?")
    (@spec ((RefResult) -> Bool))
    (or (== (. r status) 'rs-fixpoint) (== (. r status) 'rs-inconsistent)))

  (fn ref-says ((label String) (s Strategy) (got Bool) (expected Bool))
    (@intent "One answer of one strategy's run")
    (@spec ((String Strategy Bool Bool) -> Bool))
    (if (== got expected) true
      (do (print "  [sriq 8c] ") (print label) (print " under ") (println (strat-name s)) false)))

  (fn run-checks ((arena Arena) (label String) (in RefIn) (s Strategy) (r RefResult))
    (@intent "Every finished run: complete, its clauses context clauses (Definitions 2 and 3), its sets min, one more round changing nothing, and the combinators agreeing with the reference")
    (@spec ((Arena String RefIn Strategy RefResult) -> Bool))
    (@alloc arena)
    (run-checks-with arena label in s r true))

  (fn run-checks-with ((arena Arena) (label String) (in RefIn) (s Strategy) (r RefResult) (stable Bool))
    (@intent "run-checks; without stable, one more round is not run (a deferred run is saturated only for its supported clauses, which proto-agrees checks)")
    (@spec ((Arena String RefIn Strategy RefResult Bool) -> Bool))
    (@alloc arena)
    (and (ref-says (string-concat arena (string-concat arena label ": complete, but stopped on ") (status-name (. r status))) s (complete-run r) true)
         (ref-says (string-concat arena label ": context clauses") s (all-ctx-clauses arena (. r st)) true)
         (ref-says (string-concat arena label ": min sets") s (all-min arena (. r st)) true)
         (ref-says (string-concat arena label ": saturated after Elim") s
                   (or (not stable) (== (. r status) 'rs-inconsistent) (ref-stable arena in (ref-cfg s) (. r st))) true)
         (ref-says (string-concat arena label ": combinators agree") s (combinators-agree arena in (ref-cfg s) (. r st)) true)))

  (fn all-ctx-clauses ((arena Arena) (st Structure))
    (@intent "Every clause of every context is a clause that context may hold")
    (@spec ((Arena Structure) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut v 0))
      (do (for-each (c (. st ctxs))
            (do (for-each (k (ref-set arena st v)) (when (not (ctx-clause-ok (. c root) k)) (set! ok false)))
                (set! v (+ v 1))))
          ok)))

  (fn all-min ((arena Arena) (st Structure))
    (@intent "No clause of a set is a tautology or subsumed by another member")
    (@spec ((Arena Structure) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut v 0))
      (do (while (< v (cast Int (list-len (. st ctxs))))
            (do (when (not (set-min (ref-set arena st v))) (set! ok false))
                (set! v (+ v 1))))
          ok)))

  (fn set-min ((cs (List Clause)))
    (@intent "No clause of cs is a tautology or subsumed by another member")
    (@spec (((List Clause)) -> Bool))
    (@pure)
    (let ((mut ok true))
      (do (for-each (c cs)
            (do (when (tautology c) (set! ok false))
                (for-each (d cs) (when (and (not (clause-eq c d)) (subsumes d c)) (set! ok false)))))
          ok)))

  (fn o4-clauses ((arena Arena))
    (@intent "[TGH21] Figure 9's (119)–(130), and (131) in Table 1's DL4 form: classes A 0, B₁ 1, B₂ 2, C 3, B 4, F 5, and T 6 for its ⊤; roles R 0, S₁ 1, S₂ 2, S_T 3; f 0, g 1, h 2, h′ 3; o 0")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (z2 (at-z (cast U32 2))) (o (at-u (cast U32 0)))
          (mut out (list-new arena Clause)))
      (do
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 1 (r-fx 0)))))        ; (119)
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x (r-fx 0)))))      ; (120)
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 2 (r-fx 1)))))        ; (121)
        (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x (r-fx 1)))))      ; (122)
        (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 3 (r-fx 2)))))        ; (123)
        (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-role 1 x (r-fx 2)))))      ; (124)
        (list-push out (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-atom 3 (r-fx 3)))))        ; (125)
        (list-push out (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-role 1 x (r-fx 3)))))      ; (126)
        (list-push out (r-clause arena (one-lit arena (r-atom 3 x)) (one-lit arena (eq-lit x o))))               ; (127)
        (list-push out (r-clause arena (one-lit arena (r-role 1 z1 x)) (one-lit arena (r-role 2 x z1))))         ; (128)
        (list-push out (r-clause arena (lits2-of arena (r-atom 1 x) (r-atom 2 x)) (one-lit arena (r-atom 4 x)))) ; (129)
        (list-push out (r-clause arena (lits2-of arena (r-role 0 z1 x) (r-atom 4 x)) (one-lit arena (r-atom 5 z1)))) ; (130)
        ;; (131) as Table 1: ⊤ → T(x); S₂(z₁, x) → S_T(z₁, x); T(x) ∧ S_T(x, z₁) ∧ S_T(x, z₂) → z₁ ≈ z₂.
        (list-push out (r-top arena (one-lit arena (r-atom 6 x))))
        (list-push out (r-clause arena (one-lit arena (r-role 2 z1 x)) (one-lit arena (r-role 3 z1 x))))
        (list-push out (r-clause arena (lits-of arena (r-atom 6 x) (r-role 3 x z1) (r-role 3 x z2)) (one-lit arena (eq-lit z1 z2))))
        out)))

  (fn test-sriq-ref-papers ((arena Arena))
    (@intent "The reference on [TGH21]'s O1 (⊨ A ⊑ D, clause (28)), O3 (⊨ A ⊑ F, Example 1, with Figure 6's (87) as the example runs it; as printed ⊭, which HermiT confirms) and O4 (⊨ A ⊑ F, Example 2, Nom firing once under eager and cautious; under trivial Nom recurses, and the run is n/a at a cap), every complete run checked")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((o1 (ref-in arena (o1-clauses arena) 9 9 2 3 0))
          (o3 (ref-in arena (o3-fixed-clauses arena) 6 6 2 2 1))
          (o3p (ref-in arena (o3-clauses arena) 6 6 2 2 1))
          (o4 (ref-in arena (o4-clauses arena) 7 6 4 4 1))
          (mut ok true))
      (do (for-each (s (strategies arena))
            (when (not (papers-under arena o1 o3 o3p o4 s)) (set! ok false)))
          ok)))

  (fn papers-under ((arena Arena) (o1 RefIn) (o3 RefIn) (o3p RefIn) (o4 RefIn) (s Strategy))
    (@intent "O1, O3 (fixed and as printed) and O4 under one strategy: all four run, then each one's answers checked")
    (@spec ((Arena RefIn RefIn RefIn RefIn Strategy) -> Bool))
    (@alloc arena)
    (let ((r1 (ref-run arena o1 (ref-cfg s)))
          (r3 (ref-run arena o3 (ref-cfg s)))
          (r3p (ref-run arena o3p (ref-cfg s)))
          (r4 (ref-run arena o4 (ref-cfg s)))
          (mut ok true))
      (do (when (not (o1-holds arena o1 s r1)) (set! ok false))
          (when (not (o3-holds arena o3 o3p s r3 r3p)) (set! ok false))
          (when (not (o4-holds arena o4 s r4)) (set! ok false))
          ok)))

  (fn o1-holds ((arena Arena) (o1 RefIn) (s Strategy) (r1 RefResult))
    (@intent "O1's run checked: ⊨ A ⊑ D, ⊭ A ⊑ G, consistent")
    (@spec ((Arena RefIn Strategy RefResult) -> Bool))
    (@alloc arena)
    (and (run-checks arena "O1" o1 s r1)
         (ref-says "O1 ⊨ A ⊑ D" s (q-holds arena (. r1 st) (cast U32 0) (cast U32 3)) true)
         (ref-says "O1 ⊭ A ⊑ G" s (q-holds arena (. r1 st) (cast U32 0) (cast U32 4)) false)
         (ref-says "O1 consistent" s (q-inconsistent arena (. r1 st)) false)))

  (fn o3-holds ((arena Arena) (o3 RefIn) (o3p RefIn) (s Strategy) (r3 RefResult) (r3p RefResult))
    (@intent "O3's runs checked: fixed, ⊨ A ⊑ F and ⊭ A ⊑ E; as printed, ⊭ A ⊑ F")
    (@spec ((Arena RefIn RefIn Strategy RefResult RefResult) -> Bool))
    (@alloc arena)
    (and (run-checks arena "O3" o3 s r3)
         (ref-says "O3 ⊨ A ⊑ F" s (q-holds arena (. r3 st) (cast U32 0) (cast U32 5)) true)
         (ref-says "O3 ⊭ A ⊑ E" s (q-holds arena (. r3 st) (cast U32 0) (cast U32 4)) false)
         (run-checks arena "O3 as printed" o3p s r3p)
         (ref-says "O3 as printed ⊭ A ⊑ F" s (q-holds arena (. r3p st) (cast U32 0) (cast U32 5)) false)))

  (fn o4-holds ((arena Arena) (o4 RefIn) (s Strategy) (r4 RefResult))
    (@intent "O4's run checked: under trivial n/a at a cap; otherwise ⊨ A ⊑ F, ⊭ A ⊑ B, and Nom made exactly one constant")
    (@spec ((Arena RefIn Strategy RefResult) -> Bool))
    (@alloc arena)
    (if (== s 'st-trivial)
      ;; Under trivial, every successor shares v_⊤, and Nom mints a constant every few
      ;; rounds, which only Λ (at least 10,001) would stop: a cap ends it, n/a.
      (ref-says "O4: Nom recurses under trivial (more than one constant), and the run ends n/a at a cap" s
                (and (not (complete-run r4)) (not (== (. r4 status) 'rs-fuel))
                     (> (list-len (. (. (. r4 st) ord) consts)) 2)) true)
      (and (run-checks arena "O4" o4 s r4)
           (ref-says "O4 ⊨ A ⊑ F" s (q-holds arena (. r4 st) (cast U32 0) (cast U32 5)) true)
           (ref-says "O4 ⊭ A ⊑ B" s (q-holds arena (. r4 st) (cast U32 0) (cast U32 4)) false)
           (ref-says "O4: Nom made exactly one constant" s (== (list-len (. (. (. r4 st) ord) consts)) 2) true))))

  (fn e4-clauses ((arena Arena))
    (@intent "E4's row: individuals a 0 and c 1; P(a), A(c), E(c); A ⊑ Q ⊑ P; P ⊑ ∃R.B; ∃R.B ⊑ D; D ⊓ E ⊑ ⊥. Classes P 0, A 1, E 2, Q 3, B 4, D 5; R 0; f 0")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (a (at-u (cast U32 0))) (c (at-u (cast U32 1)))
          (mut out (list-new arena Clause)))
      (do (list-push out (r-top arena (one-lit arena (r-atom 0 a))))
          (list-push out (r-top arena (one-lit arena (r-atom 1 c))))
          (list-push out (r-top arena (one-lit arena (r-atom 2 c))))
          (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 3 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 3 x)) (one-lit arena (r-atom 0 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 4 (r-fx 0)))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x (r-fx 0)))))
          (list-push out (r-clause arena (lits2-of arena (r-role 0 z1 x) (r-atom 4 x)) (one-lit arena (r-atom 5 z1))))
          (list-push out (r-clause arena (lits2-of arena (r-atom 5 x) (r-atom 2 x)) (no-lits arena)))
          out)))

  (fn core-row-clauses ((arena Arena))
    (@intent "The core row: A(a), N(b) with N ⊓ D ⊑ ⊥ (b is not D); A ⊑ ∃R.B; B ⊑ ∀R⁻.D. Classes A 0, B 1, D 2, N 3; R 0; f 0; a 0, b 1")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (a (at-u (cast U32 0))) (b (at-u (cast U32 1)))
          (mut out (list-new arena Clause)))
      (do (list-push out (r-top arena (one-lit arena (r-atom 0 a))))
          (list-push out (r-top arena (one-lit arena (r-atom 3 b))))
          (list-push out (r-clause arena (lits2-of arena (r-atom 2 x) (r-atom 3 x)) (no-lits arena)))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 1 (r-fx 0)))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x (r-fx 0)))))
          (list-push out (r-clause arena (lits2-of arena (r-role 0 z1 x) (r-atom 1 x)) (one-lit arena (r-atom 2 z1))))
          out)))

  (fn thing-row-clauses ((arena Arena))
    (@intent "Root Hyper on a bodiless clause with x: individuals a 0 and b 1; D(a), C(b); ⊤ ⊑ B; B ⊓ C ⊑ ⊥. Inconsistent only if the root's ⊤ → B(x) reaches b (E4). Classes B 0, C 1, D 2")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (mut out (list-new arena Clause)))
      (do (list-push out (r-top arena (one-lit arena (r-atom 2 (at-u (cast U32 0))))))
          (list-push out (r-top arena (one-lit arena (r-atom 1 (at-u (cast U32 1))))))
          (list-push out (r-top arena (one-lit arena (r-atom 0 x))))
          (list-push out (r-clause arena (lits2-of arena (r-atom 0 x) (r-atom 1 x)) (no-lits arena)))
          out)))

  (fn rsucc-row-clauses ((arena Arena))
    (@intent "r-Succ end to end: A ⊑ C ⊔ F, C ⊑ {o}, N(o), C ⊓ N ⊑ ⊥, so C is empty and A ⊑ F. v_A reaches ⊤ → F(x) ∨ C(o), and C(o) must go up to v_r by r-Succ to meet N(o). Classes A 0, C 1, F 2, N 3; o 0")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (o (at-u (cast U32 0))) (mut out (list-new arena Clause)))
      (do (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (lits2-of arena (r-atom 1 x) (r-atom 2 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (eq-lit x o))))
          (list-push out (r-top arena (one-lit arena (r-atom 3 o))))
          (list-push out (r-clause arena (lits2-of arena (r-atom 1 x) (r-atom 3 x)) (no-lits arena)))
          out)))

  (fn not-dl4-clauses ((arena Arena))
    (@intent "A body like DL4's at-most clause with another head: B(x) → B(o), B(x) → S(o, x), B(x) ∧ S(x, z₁) → C(x). Satisfiable with B(o), S(o, o), C(o), so Nom must not read the last as an at-most clause. Classes B 0, C 1; S 0; o 0")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (o (at-u (cast U32 0))) (mut out (list-new arena Clause)))
      (do (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 0 o))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 o x))))
          (list-push out (r-clause arena (lits2-of arena (r-atom 0 x) (r-role 0 x (at-z (cast U32 1)))) (one-lit arena (r-atom 1 x))))
          out)))

  (fn root-rows ((arena Arena) (s Strategy))
    (@intent "The thing row is inconsistent, and the r-Succ row gives A ⊑ F and C unsatisfiable, under strategy s")
    (@spec ((Arena Strategy) -> Bool))
    (@alloc arena)
    (let ((th (ref-in arena (thing-row-clauses arena) 3 3 0 0 2))
          (rs (ref-in arena (rsucc-row-clauses arena) 4 4 0 0 1))
          (r1 (ref-run arena th (ref-cfg s)))
          (r2 (ref-run arena rs (ref-cfg s))))
      (and (run-checks arena "thing row" th s r1)
           (ref-says "thing row inconsistent" s (q-inconsistent arena (. r1 st)) true)
           (run-checks arena "r-Succ row" rs s r2)
           (ref-says "r-Succ row: A ⊑ F" s (q-holds arena (. r2 st) (cast U32 0) (cast U32 2)) true)
           (ref-says "r-Succ row: C unsatisfiable" s (q-unsat arena (. r2 st) (cast U32 1)) true)
           (not-dl4-row arena s))))

  (fn not-dl4-row ((arena Arena) (s Strategy))
    (@intent "Nom leaves a clause alone whose head is not DL4's: the row stays satisfiable")
    (@spec ((Arena Strategy) -> Bool))
    (@alloc arena)
    (let ((nd (ref-in arena (not-dl4-clauses arena) 2 2 1 0 1))
          (r (ref-run arena nd (ref-cfg s))))
      (and (run-checks arena "not-DL4 row" nd s r)
           (ref-says "not-DL4 row: B satisfiable" s (q-unsat arena (. r st) (cast U32 0)) false))))

  (fn test-sriq-ref-e4-rows ((arena Arena))
    (@intent "Pred into v_r end to end: it must reach c to find the inconsistency, and it must take core_v as a side premise, or eager's ⊤ → D(y) would wrongly reach b")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((e4 (ref-in arena (e4-clauses arena) 6 6 1 1 2))
          (cr (ref-in arena (core-row-clauses arena) 4 4 1 1 2))
          (mut ok true))
      (do (for-each (s (strategies arena))
            (let ((r (ref-run arena e4 (ref-cfg s)))
                  (q (ref-run arena cr (ref-cfg s))))
              (when (not (and (run-checks arena "E4 row" e4 s r)
                              (ref-says "E4 row inconsistent" s (q-inconsistent arena (. r st)) true)
                              (run-checks arena "core row" cr s q)
                              (ref-says "core row consistent" s (q-inconsistent arena (. q st)) false)
                              (root-rows arena s)))
                (set! ok false))))
          ok)))

  ;; The fixtures, and what each entails (their `# Expect:` lines, read
  ;; by hand): kind 0 sub A B, 1 unsat A, 2 satisfiable A, 3 inconsistent,
  ;; 4 consistent.
  (type Expect (record (file String) (kind Int) (a String) (b String)))

  (fn expects ((arena Arena))
    (@intent "The sriq fixtures' expectations")
    (@spec ((Arena) -> (List Expect)))
    (@alloc arena)
    (let ((mut out (list-new arena Expect)))
      (do (list-push out (record-new Expect (file "at-least-at-most") (kind 1) (a "D") (b "")))
          (list-push out (record-new Expect (file "at-least-at-most") (kind 0) (a "A") (b "E")))
          (list-push out (record-new Expect (file "disjoint-union") (kind 0) (a "D") (b "C")))
          (list-push out (record-new Expect (file "functional-clash") (kind 1) (a "A") (b "")))
          (list-push out (record-new Expect (file "step-down-early-unsat") (kind 1) (a "A") (b "")))
          (list-push out (record-new Expect (file "inverse-all") (kind 0) (a "A") (b "C")))
          (list-push out (record-new Expect (file "qualified-max") (kind 1) (a "A") (b "")))
          (list-push out (record-new Expect (file "qualified-max") (kind 2) (a "F") (b "")))
          (list-push out (record-new Expect (file "self") (kind 0) (a "D") (b "C")))
          (list-push out (record-new Expect (file "sim12-example1") (kind 0) (a "AB") (b "D")))
          (list-push out (record-new Expect (file "symmetric") (kind 0) (a "A") (b "C")))
          (list-push out (record-new Expect (file "union-negation") (kind 0) (a "A") (b "C")))
          (list-push out (record-new Expect (file "tgh21-o1") (kind 0) (a "A") (b "D")))
          (list-push out (record-new Expect (file "ranked-fresh-disjunct") (kind 0) (a "B") (b "A")))
          (list-push out (record-new Expect (file "deferred-reactivation") (kind 0) (a "X") (b "Q")))
          (list-push out (record-new Expect (file "deferred-retarget") (kind 0) (a "Y") (b "K1")))
          (list-push out (record-new Expect (file "deferred-stale-unit") (kind 0) (a "Y") (b "K1")))
          (for-each (e (abox-expects arena)) (list-push out e))
          out)))

  (fn abox-expects ((arena Arena))
    (@intent "The ABox fixtures (SPEC §10): each clash inconsistent, each control consistent, and the controls' subsumptions")
    (@spec ((Arena) -> (List Expect)))
    (@alloc arena)
    (let ((mut out (list-new arena Expect)))
      (do (for-each (n (strs arena "abox-functional abox-negative-transitive abox-inverse-functional abox-root-successor abox-top abox-fold-type abox-fold-shared abox-mixed-component abox-mixed-fold abox-different abox-max-successor abox-declared abox-fold-typeset"))
            (do (list-push out (record-new Expect (file (string-concat arena n "-clash")) (kind 3) (a "") (b "")))
                (list-push out (record-new Expect (file (string-concat arena n "-ok")) (kind 4) (a "") (b "")))))
          (list-push out (record-new Expect (file "abox-root-successor-ok") (kind 0) (a "A") (b "C")))
          (list-push out (record-new Expect (file "abox-top-ok") (kind 0) (a "A") (b "X")))
          (list-push out (record-new Expect (file "abox-fold-type-ok") (kind 0) (a "A") (b "E")))
          (list-push out (record-new Expect (file "abox-mixed-fold-ok") (kind 0) (a "D") (b "B")))
          out)))

  (fn class-named ((arena Arena) (ids SriqIds) (name String))
    (@intent "The id of the input class http://example.org/t#name, or past the end")
    (@spec ((Arena SriqIds String) -> U32))
    (@alloc arena)
    (let ((want (string-concat arena "http://example.org/t#" name)) (mut found (cast U32 4294967295)) (mut k 0))
      (do (while (< k (. ids nclass))
            (do (when (string-eq (class-text arena ids (cast U32 k)) want) (set! found (cast U32 k)))
                (set! k (+ k 1))))
          found)))

  (fn expect-holds ((arena Arena) (ids SriqIds) (st Structure) (e Expect))
    (@intent "Does the run answer e as expected?")
    (@spec ((Arena SriqIds Structure Expect) -> Bool))
    (@alloc arena)
    (let ((a (class-named arena ids (. e a))))
      (cond ((== (. e kind) 3) (q-inconsistent arena st))
            ((== (. e kind) 4) (not (q-inconsistent arena st)))
            ((== (. e kind) 1) (q-unsat arena st a))
            ((== (. e kind) 2) (not (q-unsat arena st a)))
            (else (q-holds arena st a (class-named arena ids (. e b)))))))

  (fn fixture-path ((arena Arena) (name String))
    (@intent "corpus/fixtures/sriq/name.ttl")
    (@spec ((Arena String) -> String))
    (@alloc arena)
    (string-concat arena (string-concat arena "corpus/fixtures/sriq/" name) ".ttl"))

  (fn raw-answers ((arena Arena) (ids SriqIds) (st Structure))
    (@intent "Every raw query, as a list of answers: inconsistent, then unsat(B) and holds(B, A) for each pair of query classes")
    (@spec ((Arena SriqIds Structure) -> (List Bool)))
    (@alloc arena)
    (let ((n (. ids nclass)) (mut out (list-new arena Bool)) (mut b 0))
      (do (list-push out (q-inconsistent arena st))
          (while (< b n)
            (let ((mut a 0))
              (do (list-push out (q-unsat arena st (cast U32 b)))
                  (while (< a n) (do (list-push out (q-holds arena st (cast U32 b) (cast U32 a))) (set! a (+ a 1))))
                  (set! b (+ b 1)))))
          out)))

  (fn same-bools ((a (List Bool)) (b (List Bool)))
    (@intent "The same answers")
    (@spec (((List Bool) (List Bool)) -> Bool))
    (let ((mut ok (== (list-len a) (list-len b))) (mut i 0))
      (do (for-each (x a) (do (match (list-get b i) ((some y) (when (!= x y) (set! ok false))) ((none) (set! ok false))) (set! i (+ i 1))))
          ok)))

  (fn fixture-ref ((arena Arena) (name String))
    (@intent "One fixture: each strategy's run complete and checked, every expectation met, and the three strategies' raw answers equal")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (fixture-sc arena (fixture-path arena name))
      ((none) (do (print "  [sriq 8c] no clauses: ") (println name) false))
      ((some sc) (fixture-ref-sc arena name sc))))

  (fn fixture-ref-sc ((arena Arena) (name String) (sc SriqClauses))
    (@intent "fixture-ref on the fixture's clauses sc: each strategy's run checked and its expectations met, and its raw answers equal to the first strategy's")
    (@spec ((Arena String SriqClauses) -> Bool))
    (@alloc arena)
    (let ((in (ref-input arena sc))
          (mut ok true)
          (mut first (list-new arena Bool))
          (mut seen false))
      (do (for-each (s (strategies arena))
            (let ((r (ref-run arena in (ref-cfg s))))
              (do (when (not (run-checks arena name in s r)) (set! ok false))
                  (when (not (expects-met arena name (. sc ids) s r)) (set! ok false))
                  (let ((ans (raw-answers arena (. sc ids) (. r st))))
                    (if seen
                      (when (not (same-bools first ans)) (do (print "  [sriq 8c] strategies disagree: ") (println name) (set! ok false)))
                      (do (set! first ans) (set! seen true)))))))
          ok)))

  (fn expects-met ((arena Arena) (name String) (ids SriqIds) (s Strategy) (r RefResult))
    (@intent "Every expectation of fixture name holds in strategy s's run r; each one that does not is printed")
    (@spec ((Arena String SriqIds Strategy RefResult) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do (for-each (e (expects arena))
            (when (and (string-eq (. e file) name) (not (expect-holds arena ids (. r st) e)))
              (do (print "  [sriq 8c] expectation: ") (print name) (print " ") (print (. e a)) (print " under ") (println (strat-name s)) (set! ok false))))
          ok)))

  (fn test-sriq-ref-fixtures ((arena Arena))
    (@intent "Every corpus/fixtures/sriq fixture through the reference under trivial, eager and cautious: complete, as expected, and the three agreeing on every raw query")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut last ""))
      (do (for-each (e (expects arena))
            (when (not (string-eq (. e file) last))
              (do (when (not (fixture-ref arena (. e file))) (set! ok false))
                  (set! last (. e file)))))
          ok)))

  (fn test-sriq-ref-limits ((arena Arena))
    (@intent "Fuel 1 ends on fuel; Λ = 0 creates no constant on O4, so Example 2's A ⊑ F, which needs Nom, is not reached; reversing O's clauses changes no answer")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((o4 (o4-clauses arena))
          (in4 (ref-in arena o4 7 6 4 4 1))
          (one (record-new RefConfig (strat 'st-cautious) (fuel 1) (lam -1) (ctxs 512) (cls 4000) (prod 1000000) (cnst 8)))
          (lam0 (record-new RefConfig (strat 'st-eager) (fuel 10000) (lam 0) (ctxs 512) (cls 4000) (prod 1000000) (cnst 8)))
          (r1 (ref-run arena in4 one))
          (r0 (ref-run arena in4 lam0))
          (rv (ref-run arena (ref-in arena (reversed-clauses arena o4) 7 6 4 4 1) (ref-cfg 'st-cautious)))
          (rf (ref-run arena in4 (ref-cfg 'st-cautious))))
      (and (want "fuel 1 ends on fuel, after one round" (and (== (. r1 status) 'rs-fuel) (== (. r1 rounds) 1)) true)
           (want "Λ = 0: no constant" (== (list-len (. (. (. r0 st) ord) consts)) 1) true)
           (want "Λ = 0: A ⊑ F needs Nom, so it is not reached" (q-holds arena (. r0 st) (cast U32 0) (cast U32 5)) false)
           (want "reversed clauses: the same answers" (same-bools (o4-answers arena (. rv st)) (o4-answers arena (. rf st))) true)
           (want "reversed clauses: the same rounds" (== (. rv rounds) (. rf rounds)) true))))

  (fn o4-answers ((arena Arena) (st Structure))
    (@intent "O4's raw answers over its 6 query classes")
    (@spec ((Arena Structure) -> (List Bool)))
    (@alloc arena)
    (let ((mut out (list-new arena Bool)) (mut b 0))
      (do (list-push out (q-inconsistent arena st))
          (while (< b 6)
            (let ((mut a 0))
              (do (list-push out (q-unsat arena st (cast U32 b)))
                  (while (< a 6) (do (list-push out (q-holds arena st (cast U32 b) (cast U32 a))) (set! a (+ a 1))))
                  (set! b (+ b 1)))))
          out)))

  (fn reversed-clauses ((arena Arena) (cs (List Clause)))
    (@intent "cs, last first")
    (@spec ((Arena (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)) (mut i (- (cast Int (list-len cs)) 1)))
      (do (while (>= i 0)
            (do (match (list-get cs i) ((some c) (list-push out c)) ((none) (set! i i)))
                (set! i (- i 1))))
          out)))

  ;; ------------------------------------------------------------
  ;; Slice 9a: the prototype of S6's rounds (sriqsat.slop) against the
  ;; reference, under all three strategies: the papers' rows, the root
  ;; rows and every fixture. Every complete run passes the reference's
  ;; checks (one more naive round changes nothing, so the prototype's
  ;; fixpoint is the reference's), gives the reference's answers, gives
  ;; them again with Δ permuted (R6), and answers monotonely at every cap
  ;; from 0 to its rounds (R7).
  ;; ------------------------------------------------------------

  (fn sat-cfg ((s Strategy) (perm Int))
    (@intent "The prototype under the reference's configuration, Δ permuted by perm, deferral asked for (R8: on in its scope)")
    (@spec ((Strategy Int) -> SatConfig))
    (sat-cfg-at s perm true))

  (fn sat-cfg-at ((s Strategy) (perm Int) (defer Bool))
    (@intent "sat-cfg, with deferral asked for or not")
    (@spec ((Strategy Int Bool) -> SatConfig))
    (record-new SatConfig (base (ref-cfg s)) (perm perm) (scan false) (defer defer) (views true) (check true) (cancel 0)))

  (fn sat-fuel ((s Strategy) (fuel Int))
    (@intent "The prototype capped at fuel rounds")
    (@spec ((Strategy Int) -> SatConfig))
    (record-new SatConfig (base (record-new RefConfig (strat s) (fuel fuel) (lam -1) (ctxs 512) (cls 4000) (prod 1000000) (cnst 8)))
                          (perm 0) (scan false) (defer true) (views true) (check true) (cancel 0)))

  (fn answers-of ((arena Arena) (st Structure) (n Int))
    (@intent "The raw answers over n query classes: inconsistent, then unsat(B) and holds(B, A) for each pair")
    (@spec ((Arena Structure Int) -> (List Bool)))
    (@alloc arena)
    (let ((mut out (list-new arena Bool)) (mut b 0))
      (do (list-push out (q-inconsistent arena st))
          (while (< b n)
            (let ((mut a 0))
              (do (list-push out (q-unsat arena st (cast U32 b)))
                  (while (< a n) (do (list-push out (q-holds arena st (cast U32 b) (cast U32 a))) (set! a (+ a 1))))
                  (set! b (+ b 1)))))
          out)))

  (fn implied ((a (List Bool)) (b (List Bool)))
    (@intent "Is every answer true in a true in b?")
    (@spec (((List Bool) (List Bool)) -> Bool))
    (let ((mut ok (== (list-len a) (list-len b))) (mut i 0))
      (do (for-each (x a)
            (do (match (list-get b i) ((some y) (when (and x (not y)) (set! ok false))) ((none) (set! ok false)))
                (set! i (+ i 1))))
          ok)))

  (fn proto-says ((arena Arena) (label String) (s Strategy) (ok Bool))
    (@intent "One check of the prototype; printed when it fails")
    (@spec ((Arena String Strategy Bool) -> Bool))
    (@alloc arena)
    (if ok true (do (print "  [sriq 9a] ") (print label) (print " under ") (println (strat-name s)) false)))

  (fn proto-agrees ((arena Arena) (label String) (in RefIn) (n Int) (s Strategy))
    (@intent "The prototype on one input under one strategy: n/a where the reference is; otherwise checked, with the reference's answers, unchanged under a permuted Δ, and monotone in the cap")
    (@spec ((Arena String RefIn Int Strategy) -> Bool))
    (@alloc arena)
    (let ((r (ref-run arena in (ref-cfg s)))
          (p (sat-run arena in (sat-cfg s 0))))
      (if (not (complete-run r))
        (proto-says arena (string-concat arena label ": n/a, as the reference is") s (not (complete-run (. p res))))
        (and (run-checks-with arena (string-concat arena label " (prototype, through M)") in s (as-m arena in (. p res))
                              (not (defer-on (sat-cfg s 0) in)))
             (proto-says arena (string-concat arena label ": deferred, saturated for its supported clauses (R8's P5)") s
                         (or (not (defer-on (sat-cfg s 0) in)) (== (. (. p res) status) 'rs-inconsistent)
                             (defer-stable arena in (sat-cfg s 0) p)))
             (proto-says arena (string-concat arena label ": the reference's stop (S4's early stop included)") s
                         (== (. (. p res) status) (. r status)))
             (proto-says arena (string-concat arena label ": the reference's answers") s
                         (same-bools (answers-of arena (. r st) n) (answers-of arena (. (. p res) st) n)))
             (proto-says arena (string-concat arena label ": the K-set index is k-sets, on every context and trigger") s
                         (and (kidx-agrees arena in (. r st)) (kidx-agrees arena in (. (. p res) st))))
             (proto-says arena (string-concat arena label ": the indexed Hyper is the reference's, on every context") s
                         (and (hyper-ix-agrees arena in (sat-cfg s 0) (. r st))
                              (hyper-ix-agrees arena in (sat-cfg s 0) (. (. p res) st))))
             (proto-perms arena label in n s p)
             (proto-caps arena label in n s p)))))

  (fn kidx-agrees ((arena Arena) (in RefIn) (st Structure))
    (@intent "On every context of st, for each maximal premise's successor term, the K-set index (k-index, k-query)
              gives k-sets' K₁ and K₂")
    (@spec ((Arena RefIn Structure) -> Bool))
    (@alloc arena)
    (let ((tr (build-triggers arena (. in onto) (. in nclass) (. in nrole) (. in nfn))) (mut ok true) (mut v 0))
      (do (for-each (s (. st sets))
            (do (when (not (kidx-one arena tr st (== v 0) (. s cs))) (set! ok false))
                (set! v (+ v 1))))
          ok)))

  (fn kidx-one ((arena Arena) (tr Triggers) (st Structure) (root Bool) (cs (List Clause)))
    (@intent "kidx-agrees on one context's set cs")
    (@spec ((Arena Triggers Structure Bool (List Clause)) -> Bool))
    (@alloc arena)
    (let ((kx (k-index arena (. st ord) tr cs))
          (kp (k-index-premises arena tr (premises-of arena (. st ord) cs)))
          (mut ok true))
      (do (for-each (c cs)
            (when (not (and (kidx-clause arena tr st root cs kx c) (kidx-clause arena tr st root cs kp c))) (set! ok false)))
          ok)))

  (fn kidx-clause ((arena Arena) (tr Triggers) (st Structure) (root Bool) (cs (List Clause)) (kx KIdx) (c Clause))
    (@intent "kidx-agrees for the successor term of each head literal of c, selected")
    (@spec ((Arena Triggers Structure Bool (List Clause) KIdx Clause) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut i 0))
      (do (while (< i (cast Int (list-len (. c head))))
            (do (match (succ-sig root (. (select arena (. st ord) c i) sel))
                  ((none) (set! i i))
                  ((some sg) (when (not (same-ksets (k-query arena tr kx sg) (k-sets arena (. st ord) tr sg cs)))
                               (set! ok false))))
                (set! i (+ i 1))))
          ok)))

  (fn same-ksets ((a KSets) (b KSets))
    (@intent "The same K₁ and the same K₂")
    (@spec ((KSets KSets) -> Bool))
    (and (lits-same-set (. a k1) (. b k1)) (lits-same-set (. a k2) (. b k2))))

  (fn as-m ((arena Arena) (in RefIn) (r RefResult))
    (@intent "The prototype's result with M, the structure its shared ground view stands for, in place of its own")
    (@spec ((Arena RefIn RefResult) -> RefResult))
    (@alloc arena)
    (record-new RefResult (status (. r status)) (rounds (. r rounds)) (st (sat-materialise arena in (. r st)))))

  (fn proto-perms ((arena Arena) (label String) (in RefIn) (n Int) (s Strategy) (p SatResult))
    (@intent "R6: Δ reversed, and Δ rotated, give the same answers in the same rounds")
    (@spec ((Arena String RefIn Int Strategy SatResult) -> Bool))
    (@alloc arena)
    (and (perm-same arena label in n s p 1) (perm-same arena label in n s p 2)))

  (fn perm-same ((arena Arena) (label String) (in RefIn) (n Int) (s Strategy) (p SatResult) (perm Int))
    (@intent "Δ permuted by perm gives p's answers in p's rounds")
    (@spec ((Arena String RefIn Int Strategy SatResult Int) -> Bool))
    (@alloc arena)
    (let ((q (sat-run arena in (sat-cfg s perm))))
      (proto-says arena (string-concat arena label ": a permuted Δ changes nothing (R6)") s
                  (and (== (. (. q res) rounds) (. (. p res) rounds))
                       (same-bools (answers-of arena (. (. p res) st) n) (answers-of arena (. (. q res) st) n))))))

  (fn proto-caps ((arena Arena) (label String) (in RefIn) (n Int) (s Strategy) (p SatResult))
    (@intent "R7: capped at k rounds for k from 0 to the run's, every answer true at k stays true at k + 1, and the last is the full run's")
    (@spec ((Arena String RefIn Int Strategy SatResult) -> Bool))
    (@alloc arena)
    (let ((full (answers-of arena (. (. p res) st) n))
          (mut prev (answers-of arena (. (. (sat-run arena in (sat-fuel s 0)) res) st) n))
          (mut ok true) (mut k 1))
      (do (while (<= k (. (. p res) rounds))
            (let ((cur (answers-of arena (. (. (sat-run arena in (sat-fuel s k)) res) st) n)))
              (do (when (not (implied prev cur)) (set! ok false))
                  (set! prev cur)
                  (set! k (+ k 1)))))
          (proto-says arena (string-concat arena label ": monotone in the cap (R7)") s (and ok (same-bools prev full))))))

  (fn rpred-late-clauses ((arena Arena))
    (@intent "r-Pred whose only new premise is its side premise. A(x) → S(x, o) (A ⊑ ∃S.{o} at clause level), N(o) and N ⊑ ∀S⁻.D give A ⊑ D; C ⊑ E ⊑ F ⊑ H ⊑ K with K(x) → S(x, o) gives C ⊑ D. No successor knows o, so only the root applies N ⊑ ∀S⁻.D, and r-Pred brings ⊤ → D(x) down. The root has S(y, o) → D(y) from v_A, and every context its edge to v_r for o (r-Succ on the ground N(o)), rounds before v_C reaches S(x, o). Classes A 0, B 1 (unused), C 2, D 3, E 4, F 5, N 6, G 7 (unused), H 8, K 9; S 0; o 0")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (o (at-u (cast U32 0))) (mut out (list-new arena Clause)))
      (do (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x o))))
          (list-push out (r-top arena (one-lit arena (r-atom 6 o))))
          (list-push out (r-clause arena (lits2-of arena (r-role 0 z1 x) (r-atom 6 x)) (one-lit arena (r-atom 3 z1))))
          (list-push out (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-atom 4 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 4 x)) (one-lit arena (r-atom 5 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 5 x)) (one-lit arena (r-atom 8 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 8 x)) (one-lit arena (r-atom 9 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 9 x)) (one-lit arena (r-role 0 x o))))
          out)))

  (fn test-sriq-rpred-late ((arena Arena))
    (@intent "The late r-Pred row's answers under the reference, every strategy: A ⊑ D and C ⊑ D")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do (for-each (s (strategies arena))
            (let ((r (ref-run arena (ref-in arena (rpred-late-clauses arena) 10 10 1 0 1) (ref-cfg s))))
              (when (not (and (run-checks arena "late r-Pred row" (ref-in arena (rpred-late-clauses arena) 10 10 1 0 1) s r)
                              (ref-says "late r-Pred row: A ⊑ D" s (q-holds arena (. r st) (cast U32 0) (cast U32 3)) true)
                              (ref-says "late r-Pred row: C ⊑ D" s (q-holds arena (. r st) (cast U32 2) (cast U32 3)) true)))
                (set! ok false))))
          ok)))

  (fn view-eq-clauses ((arena Arena))
    (@intent "The shared ground view's Eq. G holds S(a, a), S(b, b) and B(a), and gains a ≈ b late (K(a), K ⊑ L,
              L ⊑ {b}). v_C (C ⊑ {a}) holds S(x, a) and T(x, b) before it, and U(x, a) and U(x, b) after it (C ⊑ E ⊑
              F ⊑ H). So Eq runs from G's equality into v_C's clauses old and new, from v_C's x ≈ a into G, and
              between two members of G away from the root (one position, where the root rewrites both), whichever
              constant is the larger. M(a), M(b) and M ⊑ ∃R.P put f(a) and f(b) into the root, where Eq rewrites
              inside them. Expect C ⊑ B. Classes C 0, B 1, E 2, F 3, H 4, K 5, L 6, M 7, P 8; S 0, T 1, U 2, R 3; f 0;
              a 0, b 1")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (a (at-u (cast U32 0))) (b (at-u (cast U32 1))) (mut out (list-new arena Clause)))
      (do (list-push out (r-top arena (one-lit arena (r-role 0 a a))))
          (list-push out (r-top arena (one-lit arena (r-role 0 b b))))
          (list-push out (r-top arena (one-lit arena (r-atom 1 a))))
          (list-push out (r-top arena (one-lit arena (r-atom 5 a))))
          (list-push out (r-clause arena (one-lit arena (r-atom 5 x)) (one-lit arena (r-atom 6 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 6 x)) (one-lit arena (eq-lit x b))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (eq-lit x a))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x a))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 1 x b))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 2 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-atom 3 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 3 x)) (one-lit arena (r-atom 4 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 4 x)) (one-lit arena (r-role 2 x a))))
          (list-push out (r-clause arena (one-lit arena (r-atom 4 x)) (one-lit arena (r-role 2 x b))))
          (list-push out (r-top arena (one-lit arena (r-atom 7 a))))
          (list-push out (r-top arena (one-lit arena (r-atom 7 b))))
          (list-push out (r-clause arena (one-lit arena (r-atom 7 x)) (one-lit arena (r-role 3 x (r-fx 0)))))
          (list-push out (r-clause arena (one-lit arena (r-atom 7 x)) (one-lit arena (r-atom 8 (r-fx 0)))))
          out)))

  (fn root-hyper-clauses ((arena Arena))
    (@intent "Root Hyper grouped by σ(x): S(a, b), S(b, c), S(c, a), B(a), B(b), E(b), ∃S.B ⊑ C (S(z₁, x) ∧ B(x) →
              C(z₁)) and C ⊓ E ⊑ ⊥. The root must derive C(a) and C(c), each from premises about two individuals, and
              not C(b) (no B(c)), which would make the ABox inconsistent. Classes B 0, C 1, E 2; S 0; a 0, b 1, c 2")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (a (at-u (cast U32 0))) (b (at-u (cast U32 1))) (c (at-u (cast U32 2)))
          (mut out (list-new arena Clause)))
      (do (list-push out (r-top arena (one-lit arena (r-role 0 a b))))
          (list-push out (r-top arena (one-lit arena (r-role 0 b c))))
          (list-push out (r-top arena (one-lit arena (r-role 0 c a))))
          (list-push out (r-top arena (one-lit arena (r-atom 0 a))))
          (list-push out (r-top arena (one-lit arena (r-atom 0 b))))
          (list-push out (r-top arena (one-lit arena (r-atom 2 b))))
          (list-push out (r-clause arena (lits2-of arena (r-role 0 z1 x) (r-atom 0 x)) (one-lit arena (r-atom 1 z1))))
          (list-push out (r-clause arena (lits2-of arena (r-atom 1 x) (r-atom 2 x)) (no-lits arena)))
          out)))

  (fn view-join-clauses ((arena Arena))
    (@intent "The shared ground view's Join of a context's premise into G. v_A holds ⊤ → F(x) ∨ C(o) and
              ⊤ → G(x) ∨ E(o) directly (no x ≈ o, so nothing in v_A reaches C(o)'s or E(o)'s consequences
              otherwise). r-Succ puts C(o) → C(o) and E(o) → E(o) into the root, and the root derives G's members
              C(o) → D(o) (C ⊑ D) and C(o) ∧ E(o) → K(o) (C ⊓ E ⊑ K), whose sites v_A's premises join, the second
              at its second body literal. A ⊑ ∃S.{o} at clause level and ∃S.N ⊑ H with C ⊑ N carry C(o) into v_A
              by r-Pred: C(o) → H(x). v_P reaches ⊤ → Q(x) ∨ C(o) only after G holds C(o) → D(o) (P ⊑ P₁ ⊑ P₂ ⊑
              P₃ ⊑ Q ⊔ C(o)), so a new premise joins an old site. Classes A 0, C 1, F 2, D 3, N 4, H 5, E 6, G 7,
              K 8, P 9, P₁ 10, P₂ 11, P₃ 12, Q 13; S 0; o 0")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (z1 (at-z (cast U32 1))) (o (at-u (cast U32 0))) (mut out (list-new arena Clause)))
      (do (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (lits2-of arena (r-atom 2 x) (r-atom 1 o))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (lits2-of arena (r-atom 7 x) (r-atom 6 o))))
          (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 3 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 1 x)) (one-lit arena (r-atom 4 x))))
          (list-push out (r-clause arena (lits2-of arena (r-atom 1 x) (r-atom 6 x)) (one-lit arena (r-atom 8 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x o))))
          (list-push out (r-clause arena (lits2-of arena (r-role 0 z1 x) (r-atom 4 x)) (one-lit arena (r-atom 5 z1))))
          (list-push out (r-clause arena (one-lit arena (r-atom 9 x)) (one-lit arena (r-atom 10 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 10 x)) (one-lit arena (r-atom 11 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 11 x)) (one-lit arena (r-atom 12 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 12 x)) (lits2-of arena (r-atom 13 x) (r-atom 1 o))))
          out)))

  (fn view-units-clauses ((arena Arena))
    (@intent "The shared ground view's root A → A: a disjunctive fact ⊤ → E(a) ∨ H(a) of G, both atoms in Su(O),
              so every Succ trigger's K₂ would read them until the boundary puts E(a) → E(a) and H(a) → H(a) into
              the root. A ⊑ ∃R.B gives v_A a trigger; E ⊑ D and H ⊑ D give D(a). Classes A 0, B 1, E 2, H 3, D 4; R 0;
              f 0; a 0")
    (@spec ((Arena) -> (List Clause)))
    (@alloc arena)
    (let ((x (at-x)) (a (at-u (cast U32 0))) (mut out (list-new arena Clause)))
      (do (list-push out (r-top arena (lits2-of arena (r-atom 2 a) (r-atom 3 a))))
          (list-push out (r-clause arena (one-lit arena (r-atom 2 x)) (one-lit arena (r-atom 4 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 3 x)) (one-lit arena (r-atom 4 x))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-role 0 x (r-fx 0)))))
          (list-push out (r-clause arena (one-lit arena (r-atom 0 x)) (one-lit arena (r-atom 1 (r-fx 0)))))
          (list-push out (r-clause arena (lits2-of arena (r-atom 1 x) (r-atom 2 x)) (one-lit arena (r-atom 4 x))))
          out)))

  (fn test-sriq-view-eq ((arena Arena))
    (@intent "The view's Eq row under the reference, every strategy: C ⊑ B")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (in (ref-in arena (view-eq-clauses arena) 9 9 4 1 2)))
      (do (for-each (s (strategies arena))
            (let ((r (ref-run arena in (ref-cfg s))))
              (when (not (and (run-checks arena "view Eq row" in s r)
                              (ref-says "view Eq row: C ⊑ B" s
                                        (q-holds arena (. r st) (cast U32 0) (cast U32 1)) true)))
                (set! ok false))))
          ok)))

  (type ProtoCase (record (label String) (in RefIn) (n Int)))

  (fn proto-cases ((arena Arena))
    (@intent "The hand-built inputs: [TGH21]'s O1, O3 (fixed and as printed) and O4, 8c's root rows, and the late r-Pred rows")
    (@spec ((Arena) -> (List ProtoCase)))
    (@alloc arena)
    (let ((mut out (list-new arena ProtoCase)))
      (do (list-push out (record-new ProtoCase (label "O1") (in (ref-in arena (o1-clauses arena) 9 9 2 3 0)) (n 9)))
          (list-push out (record-new ProtoCase (label "O3") (in (ref-in arena (o3-fixed-clauses arena) 6 6 2 2 1)) (n 6)))
          (list-push out (record-new ProtoCase (label "O3 as printed") (in (ref-in arena (o3-clauses arena) 6 6 2 2 1)) (n 6)))
          (list-push out (record-new ProtoCase (label "O4") (in (ref-in arena (o4-clauses arena) 7 6 4 4 1)) (n 6)))
          (list-push out (record-new ProtoCase (label "E4 row") (in (ref-in arena (e4-clauses arena) 6 6 1 1 2)) (n 6)))
          (list-push out (record-new ProtoCase (label "core row") (in (ref-in arena (core-row-clauses arena) 4 4 1 1 2)) (n 4)))
          (list-push out (record-new ProtoCase (label "thing row") (in (ref-in arena (thing-row-clauses arena) 3 3 0 0 2)) (n 3)))
          (list-push out (record-new ProtoCase (label "r-Succ row") (in (ref-in arena (rsucc-row-clauses arena) 4 4 0 0 1)) (n 4)))
          (list-push out (record-new ProtoCase (label "not-DL4 row") (in (ref-in arena (not-dl4-clauses arena) 2 2 1 0 1)) (n 2)))
          (list-push out (record-new ProtoCase (label "late r-Pred row") (in (ref-in arena (rpred-late-clauses arena) 10 10 1 0 1)) (n 10)))
          (list-push out (record-new ProtoCase (label "view Eq row")
                                           (in (ref-in arena (view-eq-clauses arena) 9 9 4 1 2)) (n 9)))
          (list-push out (record-new ProtoCase (label "view units row")
                                           (in (ref-in arena (view-units-clauses arena) 5 5 1 1 1)) (n 5)))
          (list-push out (record-new ProtoCase (label "root Hyper row")
                                           (in (ref-in arena (root-hyper-clauses arena) 3 3 1 0 3)) (n 3)))
          (list-push out (record-new ProtoCase (label "view Join row")
                                           (in (ref-in arena (view-join-clauses arena) 14 14 1 0 1)) (n 14)))
          out)))

  (fn test-sriq-proto-rows ((arena Arena))
    (@intent "The prototype against the reference on the papers' rows and the root rows, under trivial, eager and cautious")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do (for-each (c (proto-cases arena))
            (for-each (s (strategies arena))
              (when (not (proto-agrees arena (. c label) (. c in) (. c n) s)) (set! ok false))))
          ok)))

  (fn test-sriq-proto-work ((arena Arena))
    (@intent "A pin on the prototype's work: O1 under cautious, in its rounds, candidates, Succ actions and commits, without deferral and with it (R8: one Succ evaluation per successor term, where S6 takes an action per trigger), and qualified-max's rounds. Answers cannot see an instance run twice, or one skipped and recovered later; this can. A change to the schedule updates it on purpose")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (o1-work arena false 11) (o1-work arena true 5) (qualified-max-rounds arena)))

  (fn o1-work ((arena Arena) (defer Bool) (succs Int))
    (@intent "O1 under cautious takes 11 rounds, 36 candidates, succs Succ actions and 33 commits")
    (@spec ((Arena Bool Int) -> Bool))
    (@alloc arena)
    (let ((p (sat-run arena (ref-in arena (o1-clauses arena) 9 9 2 3 0) (sat-cfg-at 'st-cautious 0 defer)))
          (c (. p counts)))
      (if (and (== (. (. p res) rounds) 11) (== (. c cands) 36) (== (. c succs) succs) (== (. c added) 33))
        true
        (do (print "  [sriq 9a] O1 cautious") (when defer (print " (deferred)")) (print ": rounds ")
            (print (int-to-string arena (. (. p res) rounds)))
            (print ", candidates ") (print (int-to-string arena (. c cands)))
            (print ", succ ") (print (int-to-string arena (. c succs)))
            (print ", committed ") (println (int-to-string arena (. c added)))
            false))))

  (fn qualified-max-rounds ((arena Arena))
    (@intent "The qualified-max fixture under cautious takes the prototype 14 rounds, one fewer than the reference: a new context's Core clauses join the candidates at create (S6 step 2), where the reference derives them the round after")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (fixture-sc arena (fixture-path arena "qualified-max"))
      ((none) (proto-says arena "qualified-max: no clauses" 'st-cautious false))
      ((some sc)
        (let ((p (sat-run arena (ref-input arena sc) (sat-cfg 'st-cautious 0))))
          (proto-says arena (string-concat arena "qualified-max: 14 rounds, not "
                                           (int-to-string arena (. (. p res) rounds))) 'st-cautious
                      (== (. (. p res) rounds) 14))))))

  (fn test-sriq-proto-fixtures ((arena Arena))
    (@intent "The prototype against the reference on every sriq fixture, under trivial, eager and cautious, every expectation met")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut last ""))
      (do (for-each (e (expects arena))
            (when (not (string-eq (. e file) last))
              (do (when (not (fixture-proto arena (. e file))) (set! ok false))
                  (set! last (. e file)))))
          ok)))

  (fn fixture-proto ((arena Arena) (name String))
    (@intent "One fixture through the prototype under each strategy: agreeing with the reference, and as expected")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (fixture-sc arena (fixture-path arena name))
      ((none) (do (print "  [sriq 9a] no clauses: ") (println name) false))
      ((some sc) (fixture-proto-sc arena name sc))))

  (fn fixture-proto-sc ((arena Arena) (name String) (sc SriqClauses))
    (@intent "fixture-proto on the fixture's clauses sc")
    (@spec ((Arena String SriqClauses) -> Bool))
    (@alloc arena)
    (let ((in (ref-input arena sc)) (mut ok true))
      (do (for-each (s (strategies arena))
            (let ((r (. (sat-run arena in (sat-cfg s 0)) res)))
              (when (not (and (proto-agrees arena name in (. (. sc ids) nclass) s)
                              (expects-met arena name (. sc ids) s r)
                              ;; The engine runs the ranked order (9g); the reference does not.
                              (== (. (. (. r st) ord) rank) (cast Int (. (. sc ids) nclass)))))
                (set! ok false))))
          ok)))

  ;; ------------------------------------------------------------
  ;; Slice 9b: the indexed commit (sriqindex.slop) against commit-min, set
  ;; by set, and the prototype through it against the prototype through
  ;; commit-min's scans.
  ;; ------------------------------------------------------------

  (fn same-list ((a (List Clause)) (b (List Clause)))
    (@intent "The same clauses in the same order")
    (@spec (((List Clause) (List Clause)) -> Bool))
    (let ((mut ok (== (list-len a) (list-len b))) (mut i 0))
      (do (for-each (x a)
            (do (match (list-get b i) ((some y) (when (not (clause-eq x y)) (set! ok false))) ((none) (set! ok false)))
                (set! i (+ i 1))))
          ok)))

  (fn commits-agree ((arena Arena) (ws (List Clause)) (cs (List Clause)))
    (@intent "commit-indexed and commit-min give the same set and the same additions, both in content order")
    (@spec ((Arena (List Clause) (List Clause)) -> Bool))
    (@alloc arena)
    (let ((a (commit-indexed arena ws cs)) (b (commit-min arena ws cs)))
      (and (same-list (. a set) (. b set)) (same-list (. a added) (. b added)))))

  (fn dropped-last ((arena Arena) (c Clause))
    (@intent "c without its last head literal, or else its last body literal: a clause that subsumes c")
    (@spec ((Arena Clause) -> Clause))
    (@alloc arena)
    (if (> (list-len (. c head)) 0)
      (make-clause arena (. c body) (but-last arena (. c head)))
      (make-clause arena (but-last arena (. c body)) (. c head))))

  (fn but-last ((arena Arena) (ls (List Lit)))
    (@intent "ls without its last literal")
    (@spec ((Arena (List Lit)) -> (List Lit)))
    (@alloc arena)
    (let ((mut out (list-new arena Lit)) (mut i 0) (n (- (cast Int (list-len ls)) 1)))
      (do (for-each (l ls) (do (when (< i n) (list-push out l)) (set! i (+ i 1)))) out)))

  (fn split-agrees ((arena Arena) (s (List Clause)))
    (@intent "On one set: W = min of its even members; C = its odd members, every member again, and each member with a literal dropped. The two commits agree")
    (@spec ((Arena (List Clause)) -> Bool))
    (@alloc arena)
    (let ((mut evens (list-new arena Clause)) (mut cs (list-new arena Clause)) (mut i 0))
      (do (for-each (c s)
            (do (if (== (% i 2) 0) (list-push evens c) (list-push cs c))
                (list-push cs c)
                (list-push cs (dropped-last arena c))
                (set! i (+ i 1))))
          (commits-agree arena (. (commit-min arena (list-new arena Clause) evens) set) cs))))

  (fn structure-agrees ((arena Arena) (st Structure))
    (@intent "split-agrees on every context's set")
    (@spec ((Arena Structure) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut v 0))
      (do (while (< v (cast Int (list-len (. st ctxs))))
            (do (when (not (split-agrees arena (ref-set arena st v))) (set! ok false))
                (set! v (+ v 1))))
          ok)))

  (fn commit-edge-row ((arena Arena))
    (@intent "The edge cases by hand: the empty clause, a tautology, duplicates, a chain A → B∨C∨D ⊒ A → B∨C ⊒ A → B, and candidates that delete members of W")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((x (at-x)) (a (r-atom 0 x)) (b (r-atom 1 x)) (c (r-atom 2 x)) (d (r-atom 3 x))
          (abcd (r-clause arena (one-lit arena a) (lits-of arena b c d)))
          (abc (r-clause arena (one-lit arena a) (lits2-of arena b c)))
          (ab (r-clause arena (one-lit arena a) (one-lit arena b)))
          (taut (r-clause arena (one-lit arena a) (one-lit arena (eq-lit x x))))
          (empty (r-clause arena (no-lits arena) (no-lits arena)))
          (mut w (list-new arena Clause)) (mut cs (list-new arena Clause)) (mut cs2 (list-new arena Clause)))
      (do (list-push w abcd)
          (list-push cs abc) (list-push cs abc) (list-push cs taut) (list-push cs ab) (list-push cs abcd)
          (list-push cs2 empty) (list-push cs2 ab)
          (and (commits-agree arena w cs)
               (commits-agree arena (list-new arena Clause) cs)
               (commits-agree arena w cs2)
               (commits-agree arena (. (commit-min arena (list-new arena Clause) cs) set) cs2)))))

  (fn scan-same ((arena Arena) (label String) (in RefIn) (n Int) (s Strategy))
    (@intent "The prototype through the index and through commit-min's scans: the same status, rounds, answers, candidates, commits and edges; and the index's commit agrees with commit-min on every final set")
    (@spec ((Arena String RefIn Int Strategy) -> Bool))
    (@alloc arena)
    (let ((p (sat-run arena in (sat-cfg s 0)))
          (q (sat-run arena in (record-new SatConfig (base (ref-cfg s)) (perm 0) (scan true) (defer true) (views true) (check true) (cancel 0)))))
      (proto-says arena (string-concat arena label ": the index commits as commit-min does (9b)") s
                  (and (== (. (. p res) status) (. (. q res) status))
                       (== (. (. p res) rounds) (. (. q res) rounds))
                       (same-bools (answers-of arena (. (. p res) st) n) (answers-of arena (. (. q res) st) n))
                       (== (. (. p counts) cands) (. (. q counts) cands))
                       (== (. (. p counts) added) (. (. q counts) added))
                       (same-edges (. (. (. p res) st) edges) (. (. (. q res) st) edges))
                       (structure-agrees arena (. (. p res) st))))))

  (fn same-edges ((a (List Edge)) (b (List Edge)))
    (@intent "The same edges in the same order (edges-added against add-edges's fold, 9f)")
    (@spec (((List Edge) (List Edge)) -> Bool))
    (@pure)
    (let ((mut ok (== (list-len a) (list-len b))) (mut i 0))
      (do (for-each (x a)
            (do (match (list-get b i)
                  ((some y) (when (not (and (== (. x from) (. y from)) (== (. x to) (. y to)) (== (. x lk) (. y lk))
                                            (== (. x label) (. y label))))
                              (set! ok false)))
                  ((none) (set! ok false)))
                (set! i (+ i 1))))
          ok)))

;; ------------------------------------------------------------
  ;; Slice 11a: sriq through the library (prepare-in-profile, reason),
  ;; before it is selectable. The test path's split run, with the same
  ;; configuration, is the yardstick, and S4's raw queries read its Run H.
  ;; ------------------------------------------------------------

  (fn test-nt-escape ((arena Arena))
    (@intent "A literal renders as N-Triples writes it: one line, its quotes, backslashes, newlines and returns escaped")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (string-eq (nt-escape arena "plain") "plain")
         (string-eq (nt-escape arena "a\"b") "a\\\"b")
         (string-eq (nt-escape arena "a\\b") "a\\\\b")
         (string-eq (nt-escape arena "a\nb\rc") "a\\nb\\rc")
         (string-eq (nt-escape arena "\\\"") "\\\\\\\"")))

  (fn test-sriq-wired ((arena Arena))
    (@intent "sriq through prepare-in-profile and reason: every fixture's verdict, termination, rounds and findings as the split run and S4's raw queries give them; the round budget shared; the clause budget; cancellation ahead of the cap; S1's guard omissions in the coverage")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut last ""))
      (do (for-each (e (expects arena))
            (when (not (string-eq (. e file) last))
              (do (when (not (wired-fixture arena (. e file))) (set! ok false))
                  (set! last (. e file)))))
          (and ok (wired-cap-rows arena) (wired-budget-row arena) (wired-cancel-row arena) (wired-omission-rows arena)
               (wired-abandon-scan arena "step-down-early-unsat" false) (wired-abandon-scan arena "tgh21-o1" false)
               (wired-abandon-scan arena "abox-mixed-component-ok" true)))))

  (fn wired-says ((arena Arena) (label String) (ok Bool))
    (@intent "One check of the wired path, printed when it fails")
    (@spec ((Arena String Bool) -> Bool))
    (@alloc arena)
    (if ok true (do (print "  [sriq 11a] ") (println label) false)))

  (fn wired-fixture ((arena Arena) (name String))
    (@intent "One fixture through the library against the split run")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (classify-fixture-in arena (fixture-path arena name) 'profile-sriq)
      ((none) (wired-says arena (string-concat arena name ": no outcome") false))
      ((some o)
        (match (split-load arena (fixture-path arena name))
          ((error m) (wired-says arena (string-concat arena name ": no split") false))
          ((ok in) (wired-agrees arena name o in))))))

  (fn wired-agrees ((arena Arena) (name String) (o Outcome) (in Inputs))
    (@intent "The outcome as the split run with the production configuration gives it")
    (@spec ((Arena String Outcome Inputs) -> Bool))
    (@alloc arena)
    (let ((sp (split-run arena in (sriq-config 1000 SRIQ_CLAUSE_BUDGET 0)))
          (f (. o findings))
          (st (. (. (. sp h) res) st))
          (classes (query-classes arena (. in ids))))
      (wired-says arena (string-concat arena name ": verdict, termination, rounds and findings as the split run's")
                  (and (== (. f inconsistent) (. sp inconsistent))
                       (== (is-fixpoint (. o termination)) (. sp finished))
                       (== (. o rounds) (. sp rounds))
                       (or (. f inconsistent)
                           (and (same-iri-lists (. f unsatisfiable) (raw-unsat arena st classes))
                                (same-pair-lists (. f subsumptions) (raw-pairs arena st classes))))))))

  (fn is-fixpoint ((t Termination))
    (@intent "Is t fixpoint?")
    (@spec ((Termination) -> Bool))
    (match t ((fixpoint) true) ((resource-limit _) false)))

  (fn query-classes ((arena Arena) (ids SriqIds))
    (@intent "The query classes' IRIs by id")
    (@spec ((Arena SriqIds) -> (List IRI)))
    (@alloc arena)
    (let ((mut out (list-new arena IRI)) (mut b 0))
      (do (for-each (n (. ids class-of))
            (do (when (< b (. ids nclass)) (match n ((dn-class i) (list-push out i)) ((dn-fresh _) (do))))
                (set! b (+ b 1))))
          out)))

  (fn raw-unsat ((arena Arena) (st Structure) (classes (List IRI)))
    (@intent "The query classes q-unsat holds of, sorted")
    (@spec ((Arena Structure (List IRI)) -> (List IRI)))
    (@alloc arena)
    (let ((mut out (list-new arena IRI)) (mut b 0))
      (do (for-each (i classes) (do (when (q-unsat arena st (cast U32 b)) (list-push out i)) (set! b (+ b 1))))
          (sort-iris arena out))))

  (fn raw-pairs ((arena Arena) (st Structure) (classes (List IRI)))
    (@intent "The taxonomy as S4's raw queries give it: owl:Thing's rows, then each class's, bottom-compressed, sorted, each once")
    (@spec ((Arena Structure (List IRI)) -> (List SubPair)))
    (@alloc arena)
    (let ((top (node-top)) (mut raw (list-new arena SubPair)) (mut a 0))
      (do (list-push raw (record-new SubPair (sub top) (super top)))
          (for-each (i classes)
            (do (when (q-thing arena st (cast U32 a)) (list-push raw (record-new SubPair (sub top) (super (union-new Node class-node i)))))
                (set! a (+ a 1))))
          (let ((mut b 0))
            (for-each (i classes)
              (do (for-each (p (raw-class-rows arena st classes b)) (list-push raw p))
                  (set! b (+ b 1)))))
          (distinct-sub-pairs arena (sort-sub-pairs arena raw)))))

  (fn raw-class-rows ((arena Arena) (st Structure) (classes (List IRI)) (b Int))
    (@intent "Class b's rows from q-unsat and q-holds")
    (@spec ((Arena Structure (List IRI) Int) -> (List SubPair)))
    (@alloc arena)
    (let ((me (match (list-get classes b) ((some i) (union-new Node class-node i)) ((none) (node-top))))
          (mut out (list-new arena SubPair)) (mut a 0))
      (do (if (q-unsat arena st (cast U32 b))
            (list-push out (record-new SubPair (sub me) (super (node-bottom))))
            (do (list-push out (record-new SubPair (sub me) (super (node-top))))
                (for-each (i classes)
                  (do (when (q-holds arena st (cast U32 b) (cast U32 a))
                        (list-push out (record-new SubPair (sub me) (super (union-new Node class-node i)))))
                      (set! a (+ a 1))))))
          out)))

  (fn distinct-sub-pairs ((arena Arena) (ps (List SubPair)))
    (@intent "ps (sorted) with each pair once")
    (@spec ((Arena (List SubPair)) -> (List SubPair)))
    (@alloc arena)
    (let ((mut out (list-new arena SubPair)))
      (do (for-each (p ps)
            (match (list-get out (- (cast Int (list-len out)) 1))
              ((some last) (when (!= (sub-pair-cmp last p) 0) (list-push out p)))
              ((none) (list-push out p))))
          out)))

  (fn same-iri-lists ((a (List IRI)) (b (List IRI)))
    (@intent "The same IRIs in the same order")
    (@spec (((List IRI) (List IRI)) -> Bool))
    (let ((mut ok (== (list-len a) (list-len b))) (mut i 0))
      (do (for-each (x a) (do (match (list-get b i) ((some y) (when (!= (iri-cmp x y) 0) (set! ok false))) ((none) (set! ok false)))
                              (set! i (+ i 1))))
          ok)))

  (fn same-pair-lists ((a (List SubPair)) (b (List SubPair)))
    (@intent "The same pairs in the same order")
    (@spec (((List SubPair) (List SubPair)) -> Bool))
    (let ((mut ok (== (list-len a) (list-len b))) (mut i 0))
      (do (for-each (x a) (do (match (list-get b i) ((some y) (when (!= (sub-pair-cmp x y) 0) (set! ok false))) ((none) (set! ok false)))
                              (set! i (+ i 1))))
          ok)))

  (fn sriq-run-cfg ((arena Arena) (name String) (cfg ReasonerConfig))
    (@intent "A fixture through prepare-in-profile and reason under sriq with cfg; an unreadable file is an input-error")
    (@spec ((Arena String ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    (match (parse-ttl-file arena (fixture-path arena name))
      ((ok g)
        (match (decode-owned arena (. g triples) (list-new arena IRI))
          ((ok d)
            (match (prepare-in-profile arena d cfg 'profile-sriq)
              ((ok p)    (reason arena p cfg))
              ((error f) (error f))))
          ((error f) (error f))))
      ((error _) (error (union-new Fault input-error "unreadable fixture")))))

  (fn with-rounds ((k Int))
    (@intent "The default configuration with max-iterations k")
    (@spec ((Int) -> ReasonerConfig))
    (let ((mut cfg (default-config))) (do (set! cfg max-iterations (cast (Int 0 .. 10000) k)) cfg)))

  (fn outcome-of ((r (Result Outcome Fault)))
    (@intent "The outcome, if there is one")
    (@spec (((Result Outcome Fault)) -> (Option Outcome)))
    (match r ((ok o) (some o)) ((error _) (none))))

  (fn h-rounds-of ((o Outcome))
    (@intent "Run H's rounds, from sriq's evidence; -1 for another calculus")
    (@spec ((Outcome) -> Int))
    (match (. o evidence) ((sriq-evidence e) (. e h-rounds)) (_ -1)))

  (fn wired-cap-rows ((arena Arena))
    (@intent "Cap 0 is resource-limit 0. One budget across both runs: the rounds are Run H's plus Run C's, and a cap at Run H's rounds leaves Run C none")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((z (outcome-of (sriq-run-cfg arena "abox-fold-type-ok" (with-rounds 0))))
          (full (outcome-of (sriq-run-cfg arena "abox-mixed-component-ok" (default-config)))))
      (and (wired-says arena "cap 0: resource-limit 0, 0 rounds"
                       (match z ((some o) (and (not (is-fixpoint (. o termination))) (== (. o rounds) 0))) ((none) false)))
           (match full
             ((none) (wired-says arena "abox-mixed-component-ok: no outcome" false))
             ((some o) (wired-shared-budget arena o))))))

  (fn wired-shared-budget ((arena Arena) (o Outcome))
    (@intent "The full run took Run H's rounds plus Run C's; capped at Run H's rounds, Run C has none and the run is resource-limit")
    (@spec ((Arena Outcome) -> Bool))
    (@alloc arena)
    (let ((h (h-rounds-of o))
          (capped (outcome-of (sriq-run-cfg arena "abox-mixed-component-ok" (with-rounds h)))))
      (wired-says arena "one round budget across Run H and Run C"
                  (and (is-fixpoint (. o termination)) (> (. o rounds) h)
                       (match capped
                         ((some c) (and (not (is-fixpoint (. c termination))) (== (. c rounds) h)))
                         ((none) false))))))

  (fn wired-budget-row ((arena Arena))
    (@intent "A clause budget of 5 stops a run at resource-limit (the store passes it at a round boundary)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (split-load arena (fixture-path arena "abox-fold-type-ok"))
      ((error m) (wired-says arena "budget row: no split" false))
      ((ok in)
        (let ((sp (split-run-of arena (. in h) (. in c) (. in has-c) false (sriq-config 1000 5 0))))
          (wired-says arena "a clause budget of 5: rs-clauses, not finished"
                      (and (not (. sp finished)) (== (. (. (. sp h) res) status) 'rs-clauses)))))))

  (fn wired-abandon-scan ((arena Arena) (name String) (run-c Bool))
    (@intent "Over budgets 1..300, Run H (or Run C, whose root holds the ABox's constants) stops where the clause
              budget's rule says: at the first round whose store plus that round's conclusions passes the budget,
              uncommitted (or at a boundary its store passes), and then reports exactly the run capped at its rounds;
              some budget stops it inside a round")
    (@spec ((Arena String Bool) -> Bool))
    (@alloc arena)
    (match (split-load arena (fixture-path arena name))
      ((error m) (wired-says arena (string-concat arena name ": no split") false))
      ((ok in)
        (let ((run (if run-c (. in c) (. in h)))
              (ps (round-profile arena run))
              (classes (query-classes arena (. in ids))) (mut ok true) (mut inside 0) (mut b 1))
          (do (while (<= b 300)
                (let ((k (abandon-at arena run classes ps b)))
                  (do (when (< k 0) (set! ok false)) (when (== k 2) (set! inside (+ inside 1))) (set! b (+ b 1)))))
              (wired-says arena (string-concat arena name ": Run H stops where the clause budget's rule says, as the run capped there; some stop inside a round")
                          (and ok (> inside 0))))))))

  ;; One finished run's profile, round by round: the store's view-total
  ;; after k rounds, and the conclusions round k + 1 derives.
  (type RoundAt (record (total Int) (next Int)))

  (fn round-profile ((arena Arena) (h RefIn))
    (@intent "For k = 0, 1, ... until the unbounded run ends: the view-total after k rounds and round k + 1's conclusions")
    (@spec ((Arena RefIn) -> (List RoundAt)))
    (@alloc arena)
    (let ((full (sat-run arena h (sriq-config 1000 SRIQ_CLAUSE_BUDGET 0)))
          (n (. (. full res) rounds))
          (mut out (list-new arena RoundAt)) (mut k 0))
      (do (while (< k n)
            (let ((a (sat-run arena h (sriq-config k SRIQ_CLAUSE_BUDGET 0)))
                  (b (sat-run arena h (sriq-config (+ k 1) SRIQ_CLAUSE_BUDGET 0))))
              (do (list-push out (record-new RoundAt (total (view-total (. (. a res) st)))
                                                     (next (- (. (. b counts) cands) (. (. a counts) cands)))))
                  (set! k (+ k 1)))))
          out)))

  (fn expected-stop ((ps (List RoundAt)) (b Int))
    (@intent "Where budget b stops the run: the first k past a boundary whose store passes b, or whose round k + 1
              passes it with its conclusions (k itself, uncommitted); -1 if none does")
    (@spec (((List RoundAt) Int) -> Int))
    (@pure)
    (let ((mut k 0) (mut at -1))
      (do (for-each (p ps)
            (do (when (and (< at 0) (or (and (> k 0) (> (. p total) b)) (> (+ (. p total) (. p next)) b)))
                  (set! at k))
                (set! k (+ k 1))))
          at)))

  (fn abandon-at ((arena Arena) (run RefIn) (classes (List IRI)) (ps (List RoundAt)) (b Int))
    (@intent "At budget b: -1 if Run H stops elsewhere than expected-stop says, or differs from the run capped at its
              rounds; else 2 if it stopped inside a round (its store within b), 1 if at a boundary, 0 if not at all")
    (@spec ((Arena RefIn (List IRI) (List RoundAt) Int) -> Int))
    (@alloc arena)
    (let ((h (. (sat-run arena run (sriq-config 1000 b 0)) res))
          (want (expected-stop ps b)))
      (cond ((!= (. h status) 'rs-clauses) (if (< want 0) 0 -1))
            ((!= (. h rounds) want) -1)
            (else
              (let ((hc (. (sat-run arena run (sriq-config (. h rounds) SRIQ_CLAUSE_BUDGET 0)) res)))
                (if (and (same-pair-lists (raw-pairs arena (. h st) classes) (raw-pairs arena (. hc st) classes))
                         (same-iri-lists (raw-unsat arena (. h st) classes) (raw-unsat arena (. hc st) classes)))
                  (if (<= (view-total (. h st)) b) 2 1)
                  -1))))))

  (fn wired-cancel-row ((arena Arena))
    (@intent "A set cancel flag gives Fault::cancelled, at the default cap and at cap 0 (read ahead of the cap)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut a (default-config)) (mut b (with-rounds 0)))
      (do (set! a cancel-ptr (cancel-flag-set))
          (set! b cancel-ptr (cancel-flag-set))
          (wired-says arena "a set cancel flag: Fault::cancelled at the default cap and at 0"
                      (and (is-cancelled (sriq-run-cfg arena "abox-fold-type-ok" a))
                           (is-cancelled (sriq-run-cfg arena "abox-fold-type-ok" b)))))))

  (fn is-cancelled ((r (Result Outcome Fault)))
    (@intent "Is r Fault::cancelled?")
    (@spec (((Result Outcome Fault)) -> Bool))
    (match r ((ok _) false) ((error f) (match f ((cancelled) true) (_ false)))))

  (fn wired-omission-rows ((arena Arena))
    (@intent "S1's guard tripped (bound 0) leaves its chain in the split's omitted list; the coverage lists a chain both runs set aside once")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (gate-ttl-in arena (string-concat arena (s0-prefix)
             ":r a owl:TransitiveProperty .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :B ] .")
             'profile-sriq)
      ((none) (wired-says arena "omission row: did not gate" false))
      ((some gr)
        (match (split-inputs-bounded arena gr 0)
          ((error m) (wired-says arena (string-concat arena "omission row: " m) false))
          ((ok in)
            (wired-says arena "the guard's chain is omitted, and listed once though both runs could set it aside"
                        (and (== (list-len (. in omitted)) 1)
                             (== (list-len (sriq-omissions arena (list-new arena Omission)
                                                           (twice arena (. in omitted)))) 1))))))))

  (fn twice ((arena Arena) (xs (List RawAxiom)))
    (@intent "xs, then xs again")
    (@spec ((Arena (List RawAxiom)) -> (List RawAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena RawAxiom)))
      (do (for-each (x xs) (list-push out x)) (for-each (x xs) (list-push out x)) out)))

  ;; ------------------------------------------------------------
  ;; Slice 9k: premise views kept with the store. Engine work only: every
  ;; run with them is the run without them, count for count, and the kept
  ;; flags equal a recomputation after every round.
  ;; ------------------------------------------------------------

  (fn test-sriq-views ((arena Arena))
    (@intent "Every sriq fixture and hand-built case (the root rows reach the root's re-commit at the boundary) under trivial, eager and cautious: with premise views kept, the same status, rounds, counts and answers as recomputing them every round, and no kept flag stale after any round")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut last ""))
      (do (for-each (e (expects arena))
            (when (not (string-eq (. e file) last))
              (do (when (not (fixture-views arena (. e file))) (set! ok false))
                  (set! last (. e file)))))
          (for-each (c (proto-cases arena))
            (for-each (s (strategies arena))
              (when (not (views-same arena (. c label) (. c in) (. c n) s)) (set! ok false))))
          ok)))

  (fn fixture-views ((arena Arena) (name String))
    (@intent "fixture's views check under each strategy")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (fixture-sc arena (fixture-path arena name))
      ((none) (do (print "  [sriq 9k] no clauses: ") (println name) false))
      ((some sc)
        (let ((in (ref-input arena sc)) (n (. (. sc ids) nclass)) (mut ok true))
          (do (for-each (s (strategies arena))
                (when (not (views-same arena name in n s)) (set! ok false)))
              ok)))))

  (fn views-says ((arena Arena) (label String) (s Strategy) (ok Bool))
    (@intent "One check of the kept views, printed when it fails")
    (@spec ((Arena String Strategy Bool) -> Bool))
    (@alloc arena)
    (if ok true (do (print "  [sriq 9k] ") (print label) (print " under ") (println (strat-name s)) false)))

  (fn views-same ((arena Arena) (name String) (in RefIn) (n Int) (s Strategy))
    (@intent "One fixture under s: views kept (and checked) against views recomputed")
    (@spec ((Arena String RefIn Int Strategy) -> Bool))
    (@alloc arena)
    (let ((p (sat-run arena in (sat-cfg s 0)))
          (q (sat-run arena in (record-new SatConfig (base (ref-cfg s)) (perm 0) (scan false) (defer true) (views false)
                                                     (check false) (cancel 0))))
          (a (. p counts)) (b (. q counts)))
      (and (views-says arena (string-concat arena name ": no kept flag stale") s (== (. a stale) 0))
           (views-says arena (string-concat arena name ": views kept, the same run as recomputed") s
                       (and (== (. (. p res) status) (. (. q res) status)) (== (. (. p res) rounds) (. (. q res) rounds))
                            (== (. a cands) (. b cands)) (== (. a rcands) (. b rcands)) (== (. a succs) (. b succs))
                            (== (. a rsuccs) (. b rsuccs)) (== (. a noms) (. b noms)) (== (. a added) (. b added))
                            (== (. a acts) (. b acts)) (== (. a hyper) (. b hyper))
                            (same-bools (answers-of arena (. (. p res) st) n) (answers-of arena (. (. q res) st) n)))))))

  ;; ------------------------------------------------------------
  ;; Slice 9j: the ABox split (SPEC §5.5 "The ABox split"). The reference
  ;; reads each fixture whole and unsplit, so it checks a split it never
  ;; made; it also reads Run H's own input, hidden classes included.
  ;; ------------------------------------------------------------

  (fn test-sriq-split-fixtures ((arena Arena))
    (@intent "Every sriq fixture through the ABox split under trivial, eager and cautious: the unsplit reference's verdict and answers where it completes, every expectation met, and the reference on Run H's input agreeing with the prototype's Run H")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut last ""))
      (do (for-each (e (expects arena))
            (when (not (string-eq (. e file) last))
              (do (when (not (fixture-split arena (. e file))) (set! ok false))
                  (set! last (. e file)))))
          ok)))

  (fn fixture-split ((arena Arena) (name String))
    (@intent "One fixture through the split under each strategy")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (fixture-sc arena (fixture-path arena name))
      ((none) (do (print "  [sriq 9j] no clauses: ") (println name) false))
      ((some sc)
        (match (split-load arena (fixture-path arena name))
          ((error m) (do (print "  [sriq 9j] no split: ") (print name) (print " ") (println m) false))
          ((ok in)
            (let ((mut ok true))
              (do (for-each (s (strategies arena))
                    (when (not (split-run-agrees arena name sc in s)) (set! ok false)))
                  ok)))))))

  (fn split-says ((arena Arena) (label String) (s Strategy) (ok Bool))
    (@intent "One check of the split, printed when it fails")
    (@spec ((Arena String Strategy Bool) -> Bool))
    (@alloc arena)
    (if ok true (do (print "  [sriq 9j] ") (print label) (print " under ") (println (strat-name s)) false)))

  (fn split-run-agrees ((arena Arena) (name String) (sc SriqClauses) (in Inputs) (s Strategy))
    (@intent "The split on one fixture under s: the unsplit reference's verdict, then its answers when consistent; the fixture's expectations; and Run H as the reference runs it")
    (@spec ((Arena String SriqClauses Inputs Strategy) -> Bool))
    (@alloc arena)
    (let ((r (ref-run arena (ref-input arena sc) (ref-cfg s)))
          (sp (split-run arena in (sat-cfg s 0)))
          (hst (. (. (. sp h) res) st))
          (n (. (. in ids) nclass)))
      (and (split-says arena (string-concat arena name ": the split's class table is the unsplit one's") s
                       (== n (. (. sc ids) nclass)))
           (split-says arena (string-concat arena name ": no kept flag stale in either run") s
                       (and (== (. (. (. sp h) counts) stale) 0) (== (. (. (. sp c) counts) stale) 0)))
           (split-says arena (string-concat arena name ": complete where the reference is") s
                       (or (not (complete-run r)) (. sp complete)))
           (split-says arena (string-concat arena name ": the reference's verdict") s
                       (or (not (complete-run r)) (== (. sp inconsistent) (q-inconsistent arena (. r st)))))
           (split-says arena (string-concat arena name ": the reference's answers") s
                       (or (not (complete-run r)) (. sp inconsistent)
                           (same-bools (answers-of arena hst n) (answers-of arena (. r st) n))))
           (split-expects arena name (. in ids) s sp)
           (split-h-as-ref arena name in s sp))))

  (fn split-expects ((arena Arena) (name String) (ids SriqIds) (s Strategy) (sp SplitRun))
    (@intent "Every expectation of the fixture holds of the split's verdict and Run H's answers")
    (@spec ((Arena String SriqIds Strategy SplitRun) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (st (. (. (. sp h) res) st)))
      (do (for-each (e (expects arena))
            (when (string-eq (. e file) name)
              (let ((got (cond ((== (. e kind) 3) (. sp inconsistent))
                               ((== (. e kind) 4) (not (. sp inconsistent)))
                               (else (expect-holds arena ids st e)))))
                (when (not (split-says arena (string-concat arena name (string-concat arena ": expected " (. e a))) s got))
                  (set! ok false)))))
          ok)))

  (fn test-sriq-split-rows ((arena Arena))
    (@intent "Two cases the fixtures cannot reach: an omission makes a consistent split run inconclusive and leaves an inconsistency standing; a DifferentIndividuals list with a member that is not an individual keeps all its members unfoldable")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (split-omitted-row arena "abox-fold-type-ok" false)
         (split-omitted-row arena "abox-fold-type-clash" true)
         (split-odd-list-row arena)))

  (fn split-omitted-row ((arena Arena) (name String) (incons Bool))
    (@intent "The fixture's split inputs marked as omitting an axiom: an answer only when inconsistent")
    (@spec ((Arena String Bool) -> Bool))
    (@alloc arena)
    (match (split-load arena (fixture-path arena name))
      ((error m) (split-says arena (string-concat arena name ": no split") 'st-cautious false))
      ((ok in) (split-omitted-in arena name incons in))))

  (fn split-omitted-in ((arena Arena) (name String) (incons Bool) (in Inputs))
    (@intent "split-omitted-row on the loaded inputs")
    (@spec ((Arena String Bool Inputs) -> Bool))
    (@alloc arena)
    (let ((mut one (list-new arena RawAxiom)))
      (do (list-push one (union-new RawAxiom ra-annotation))
          (let ((sp (split-run arena (record-new Inputs (ids (. in ids)) (h (. in h)) (c (. in c)) (has-c (. in has-c))
                                                        (omitted one))
                               (sat-cfg 'st-cautious 0))))
            (split-says arena (string-concat arena name ": with an omission, an answer only when inconsistent") 'st-cautious
                        (and (== (. sp inconsistent) incons) (== (. sp complete) incons)))))))

  (fn t-iri ((local String))
    (@intent "http://example.org/t#local, as an IRI")
    (@spec ((String) -> IRI))
    (record-new IRI (value local)))

  (fn split-odd-list-row ((arena Arena))
    (@intent "C(a) and DifferentIndividuals(a, class B): a stays unfoldable, Run H reads no assertion, and Run C keeps the list whole (S0 refuses it, as it refuses the unsplit input)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((a (union-new Node individual-node (t-iri "http://example.org/t#a")))
          (b (union-new Node class-node (t-iri "http://example.org/t#B")))
          (c (union-new RawConcept rc-name (union-new Node class-node (t-iri "http://example.org/t#C"))))
          (mut ns (list-new arena Node)) (mut axs (list-new arena RawAxiom)))
      (do (list-push ns a) (list-push ns b)
          (list-push axs (union-new RawAxiom ra-class-assertion (record-new RawClassAssertion (concept (boxed arena c)) (subject a))))
          (list-push axs (union-new RawAxiom ra-different-individuals ns))
          (let ((sp (abox-split arena (record-new GateResult (accepted axs) (omissions (list-new arena Omission))
                                                             (signature (make-signature arena))))))
            (split-says arena "a DifferentIndividuals list with a class member: kept whole for Run C, nothing folded" 'st-cautious
                        (and (. sp has-c) (== (list-len (. (. sp h) accepted)) 0) (== (list-len (. (. sp c) accepted)) 2)
                             (list-has-different (. (. sp c) accepted) 2)))))))

  (fn boxed ((arena Arena) (c RawConcept))
    (@intent "c, boxed in arena")
    (@spec ((Arena RawConcept) -> (Ptr RawConcept)))
    (@alloc arena)
    (let ((q (cast (Ptr RawConcept) (arena-alloc arena (sizeof RawConcept)))))
      (do (set! (deref q) c) q)))

  (fn list-has-different ((axs (List RawAxiom)) (n Int))
    (@intent "Does axs hold a DifferentIndividuals list of n members?")
    (@spec (((List RawAxiom) Int) -> Bool))
    (let ((mut found false))
      (do (for-each (ax axs)
            (match ax ((ra-different-individuals ns) (when (== (cast Int (list-len ns)) n) (set! found true))) (_ (do))))
          found)))

  (fn split-h-as-ref ((arena Arena) (name String) (in Inputs) (s Strategy) (sp SplitRun))
    (@intent "The reference on Run H's input, hidden classes included, gives the prototype's Run H its answers and its hidden verdict, where both complete")
    (@spec ((Arena String Inputs Strategy SplitRun) -> Bool))
    (@alloc arena)
    (let ((rh (ref-run arena (. in h) (ref-cfg s)))
          (h (. (. sp h) res))
          (nq (. (. in h) nquery))
          (hid (. (. in h) hidden)))
      (split-says arena (string-concat arena name ": Run H as the reference runs it") s
                  (or (not (complete-run rh)) (not (complete-run h))
                      (and (== (q-hidden-unsat arena (. rh st) nq hid) (q-hidden-unsat arena (. h st) nq hid))
                           (same-bools (answers-of arena (. rh st) nq) (answers-of arena (. h st) nq)))))))

  ;; ------------------------------------------------------------
  ;; Slice 9i: predecessor relevance (SPEC §5.5 S6 R8). The fixture rows
  ;; check both fixtures' answers under every strategy against the
  ;; reference; these check the work deferral does on them.
  ;; ------------------------------------------------------------

  (fn test-sriq-defer-rows ((arena Arena))
    (@intent "R8 on its fixtures: deferred-reactivation under trivial activates a stored clause; deferred-retarget under cautious holds the edge ⟨v_⊤, v_B, f⟩ that only target refresh adds")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (defer-activates arena) (defer-retargets arena)))

  (fn defer-activates ((arena Arena))
    (@intent "deferred-reactivation under trivial, deferred: some stored clause became supported and was activated")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (fixture-sc arena (fixture-path arena "deferred-reactivation"))
      ((none) (proto-says arena "deferred-reactivation: no clauses" 'st-trivial false))
      ((some sc)
        (let ((n (. (. (sat-run arena (ref-input arena sc) (sat-cfg 'st-trivial 0)) counts) acts)))
          (proto-says arena (string-concat arena "deferred-reactivation: activated " (int-to-string arena n)) 'st-trivial
                      (> n 0))))))

  (fn defer-retargets ((arena Arena))
    (@intent "deferred-retarget under cautious: the edge ⟨v_⊤, v_B, f⟩ with deferral (target refresh), and not without (the old target covers K₂)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (fixture-sc arena (fixture-path arena "deferred-retarget"))
      ((none) (proto-says arena "deferred-retarget: no clauses" 'st-cautious false))
      ((some sc)
        (let ((b (class-named arena (. sc ids) "B"))
              (on (sat-run arena (ref-input arena sc) (sat-cfg-at 'st-cautious 0 true)))
              (off (sat-run arena (ref-input arena sc) (sat-cfg-at 'st-cautious 0 false))))
          (and (proto-says arena "deferred-retarget: ⟨v_⊤, v_B, f⟩ with deferral" 'st-cautious
                           (top-edge-to arena (. (. on res) st) b))
               (proto-says arena "deferred-retarget: no ⟨v_⊤, v_B, f⟩ without deferral" 'st-cautious
                           (not (top-edge-to arena (. (. off res) st) b))))))))

  (fn top-edge-to ((arena Arena) (st Structure) (b U32))
    (@intent "Does st hold an f-edge from v_⊤ into the context with core {B(x)}, b being B?")
    (@spec ((Arena Structure U32) -> Bool))
    (@alloc arena)
    (let ((mut core (list-new arena Lit)) (mut found false))
      (do (list-push core (atom1 b (at-x)))
          (for-each (e (. st edges))
            (when (and (== (. e from) (cast U32 1)) (== (. e to) (ctx-by-core st core)) (== (. e lk) 'el-fn))
              (set! found true)))
          found)))

  (fn test-sriq-index ((arena Arena))
    (@intent "The indexed commit: commit-min's result on the edge row and on every final set, and the prototype through it exactly as through commit-min, on the hand rows and every fixture, under every strategy")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok (proto-says arena "the commit edge row" 'st-cautious (commit-edge-row arena))) (mut last ""))
      (do (for-each (c (proto-cases arena))
            (for-each (s (strategies arena))
              (when (not (scan-same arena (. c label) (. c in) (. c n) s)) (set! ok false))))
          (for-each (e (expects arena))
            (when (not (string-eq (. e file) last))
              (do (when (not (fixture-scan-same arena (. e file))) (set! ok false))
                  (set! last (. e file)))))
          ok)))

  (fn fixture-scan-same ((arena Arena) (name String))
    (@intent "scan-same on one fixture, under every strategy")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (fixture-sc arena (fixture-path arena name))
      ((none) false)
      ((some sc)
        (let ((in (ref-input arena sc)) (mut ok true))
          (do (for-each (s (strategies arena))
                (when (not (scan-same arena name in (. (. sc ids) nclass) s)) (set! ok false)))
              ok)))))

  ;; ------------------------------------------------------------
  ;; howl-test sriq-ref FILE [STRATEGY]: the reference's answers in the
  ;; oracle report grammar, for elimcheck's reference legs. Exit 4 when
  ;; the run is n/a (a cap, the fuel, or omissions): never an answer.
  ;; ------------------------------------------------------------

  (fn parse-strategy ((name String))
    (@intent "trivial, eager or cautious; anything else is none")
    (@spec ((String) -> (Option Strategy)))
    (cond ((string-eq name "trivial") (some 'st-trivial))
          ((string-eq name "eager") (some 'st-eager))
          ((string-eq name "cautious") (some 'st-cautious))
          (else (none))))

  (fn status-name ((s RefStatus))
    (@intent "Its name")
    (@spec ((RefStatus) -> String))
    (match s ('rs-fixpoint "fixpoint") ('rs-inconsistent "inconsistent") ('rs-fuel "fuel")
             ('rs-contexts "contexts") ('rs-clauses "clauses") ('rs-product "product") ('rs-constants "constants")))

  (fn print-ref-report ((arena Arena) (ids SriqIds) (st Structure) (who String) (s Strategy) (rounds Int))
    (@intent "The answers as an oracle report, from howl-sriq-<who>-<strategy>: each query class's subsumers, itself and owl:Thing included; an unsatisfiable one as owl:Nothing's; only inconsistent true when it is")
    (@spec ((Arena SriqIds Structure String Strategy Int) -> Int))
    (@alloc arena)
    (print-report-as arena ids st (q-inconsistent arena st) who s rounds))

  (fn print-report-as ((arena Arena) (ids SriqIds) (st Structure) (inconsistent Bool) (who String) (s Strategy) (rounds Int))
    (@intent "print-ref-report with the verdict given: the ABox split's comes from Run H's v_⊤, its hidden classes, and Run C")
    (@spec ((Arena SriqIds Structure Bool String Strategy Int) -> Int))
    (@alloc arena)
    (let ((thing "http://www.w3.org/2002/07/owl#Thing") (nothing "http://www.w3.org/2002/07/owl#Nothing")
          (n (. ids nclass)) (mut b 0))
      (do (println "oracle-report 1")
          (print "reasoner howl-sriq-") (print who) (print "-") (println (strat-name s))
          (print "rounds ") (println (int-to-string arena rounds))
          (if inconsistent
            (println "inconsistent true")
            (do (println "inconsistent false")
                (print "sub ") (print thing) (print " ") (println thing)
                (print-thing-rows arena ids st thing)
                (while (< b n)
                  (do (print-class-rows arena ids st (cast U32 b) thing nothing) (set! b (+ b 1))))))
          0)))

  (fn print-thing-rows ((arena Arena) (ids SriqIds) (st Structure) (thing String))
    (@intent "owl:Thing's rows past its own: sub owl:Thing A for each query class A with holds(owl:Thing, A)")
    (@spec ((Arena SriqIds Structure String) -> Int))
    (@alloc arena)
    (let ((n (. ids nclass)) (mut a 0))
      (do (while (< a n)
            (do (when (q-thing arena st (cast U32 a))
                  (do (print "sub ") (print thing) (print " ") (println (class-text arena ids (cast U32 a)))))
                (set! a (+ a 1))))
          0)))

  (fn print-class-rows ((arena Arena) (ids SriqIds) (st Structure) (b U32) (thing String) (nothing String))
    (@intent "One query class's rows")
    (@spec ((Arena SriqIds Structure U32 String String) -> Int))
    (@alloc arena)
    (let ((name (class-text arena ids b)) (n (. ids nclass)) (mut a 0))
      (do (if (q-unsat arena st b)
            (do (print "unsat ") (println name) (print "sub ") (print name) (print " ") (println nothing))
            (do (print "sub ") (print name) (print " ") (println thing)
                (print "sub ") (print name) (print " ") (println name)
                (while (< a n)
                  (do (when (and (!= (cast U32 a) b) (q-holds arena st b (cast U32 a)))
                        (do (print "sub ") (print name) (print " ") (println (class-text arena ids (cast U32 a)))))
                      (set! a (+ a 1))))))
          0)))

  (fn sriq-load ((arena Arena) (path String))
    (@intent "One file through the gate, the normaliser and the clause boundary; why not, when it is n/a")
    (@spec ((Arena String) -> (Result SriqClauses String)))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-sriq)
      ((none) (error "did not gate"))
      ((some gr)
        (if (> (list-len (. gr omissions)) 0)
          (error "omissions")
          (match (sriq-nf arena gr false false false)
            ((error m) (error m))
            ((ok n) (sriq-clauses arena n)))))))

  (fn sriq-ref ((arena Arena) (path String) (strat String) (proto Bool) (counts Bool))
    (@intent "The reference (or the prototype) on one file: gate, normalise, the clause boundary, then the run, printed as an oracle report; exit 4 when n/a")
    (@spec ((Arena String String Bool Bool) -> Int))
    (@alloc arena)
    (match (parse-strategy strat)
      ((none) (do (println "strategy: trivial, eager or cautious") 2))
      ((some s)
        (match (sriq-load arena path)
          ((error m) (do (print "n/a: ") (println m) 4))
          ((ok sc) (if proto (proto-report arena sc s counts 10000 true true) (ref-report arena sc s)))))))

  (fn sriq-proto ((arena Arena) (path String) (strat String) (counts Bool) (rounds Int) (defer Bool) (split Bool)
                  (views Bool))
    (@intent "The prototype on one file, at most rounds rounds, deferral asked for or not, through the ABox split or as one run: gate, normalise, the clause boundary, then the run(s), printed as an oracle report; exit 4 when n/a")
    (@spec ((Arena String String Bool Int Bool Bool Bool) -> Int))
    (@alloc arena)
    (match (parse-strategy strat)
      ((none) (do (println "strategy: trivial, eager or cautious") 2))
      ((some s)
        (if split
          (split-report arena path s counts rounds defer views)
          (match (sriq-load arena path)
            ((error m) (do (print "n/a: ") (println m) 4))
            ((ok sc) (proto-report arena sc s counts rounds defer views)))))))

  (fn split-load ((arena Arena) (path String))
    (@intent "One file through the gate, refusing omissions, then the ABox split's two inputs")
    (@spec ((Arena String) -> (Result Inputs String)))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-sriq)
      ((none) (error "did not gate"))
      ((some gr) (if (> (list-len (. gr omissions)) 0) (error "omissions") (split-inputs arena gr)))))

  (fn split-report ((arena Arena) (path String) (s Strategy) (counts Bool) (rounds Int) (defer Bool) (views Bool))
    (@intent "The prototype through the ABox split (SPEC 5.5): Run H, then Run C when it runs, the verdict printed as an oracle report from Run H's answers; with counts, each run's work, Run C's lines after `count run-c 1`")
    (@spec ((Arena String Strategy Bool Int Bool Bool) -> Int))
    (@alloc arena)
    (match (split-load arena path)
      ((error m) (do (print "n/a: ") (println m) 4))
      ((ok in)
        (let ((sp (split-run arena in (proto-cfg s rounds defer views))) (h (. (. sp h) res)))
          (do (when counts
                (do (print-counts arena (. sp h))
                    (count-line arena "hidden" (cast Int (list-len (. (. in h) hidden))))
                    (count-line arena "run-c" (if (. sp ran-c) 1 0))
                    (when (. sp ran-c) (print-counts arena (. sp c)))))
              (if (. sp complete)
                (print-report-as arena (. in ids) (. h st) (. sp inconsistent) "proto" s (. h rounds))
                (do (print "n/a: ") (println (split-na arena sp)) 4)))))))

  (fn split-na ((arena Arena) (sp SplitRun))
    (@intent "Why a split run gives no answer: the status of the run that stopped short, else an omission")
    (@spec ((Arena SplitRun) -> String))
    (@alloc arena)
    (cond ((not (finished-run (. (. sp h) res))) (status-name (. (. (. sp h) res) status)))
          ((and (. sp ran-c) (not (finished-run (. (. sp c) res)))) (status-name (. (. (. sp c) res) status)))
          (else "omissions")))

  (fn finished-run ((r RefResult))
    (@intent "Did r end at its fixpoint or at ⊤ → ⊥?")
    (@spec ((RefResult) -> Bool))
    (or (== (. r status) 'rs-fixpoint) (== (. r status) 'rs-inconsistent)))

  (fn ref-report ((arena Arena) (sc SriqClauses) (s Strategy))
    (@intent "Run the reference and print its report, or n/a")
    (@spec ((Arena SriqClauses Strategy) -> Int))
    (@alloc arena)
    (let ((r (ref-run arena (ref-input arena sc) (ref-cfg s))))
      (if (complete-run r)
        (print-ref-report arena (. sc ids) (. r st) "ref" s (. r rounds))
        (do (print "n/a: ") (println (status-name (. r status))) 4))))

  (fn proto-cfg ((s Strategy) (rounds Int) (defer Bool) (views Bool))
    (@intent "The prototype outside the tests: the round cap only (10,000 unless asked for fewer); no cap on contexts, clauses, choices or constants; premise views kept with the store unless views is false")
    (@spec ((Strategy Int Bool Bool) -> SatConfig))
    (record-new SatConfig (base (record-new RefConfig (strat s) (fuel rounds) (lam -1) (ctxs 2147483647) (cls 2147483647)
                                                      (prod 2147483647) (cnst 2147483647)))
                          (perm 0) (scan false) (defer defer) (views views) (check false) (cancel 0)))

  (fn proto-report ((arena Arena) (sc SriqClauses) (s Strategy) (counts Bool) (rounds Int) (defer Bool) (views Bool))
    (@intent "Run the prototype and print its report, or n/a; with counts, its work as `count` lines after the report")
    (@spec ((Arena SriqClauses Strategy Bool Int Bool Bool) -> Int))
    (@alloc arena)
    (let ((p (sat-run arena (ref-input arena sc) (proto-cfg s rounds defer views))) (r (. p res)))
      (do (when counts (print-counts arena p))
          (if (complete-run r)
            (print-ref-report arena (. sc ids) (. r st) "proto" s (. r rounds))
            (do (print "n/a: ") (println (status-name (. r status))) 4)))))

  (fn count-line ((arena Arena) (name String) (n Int))
    (@intent "count NAME N")
    (@spec ((Arena String Int) -> Int))
    (@alloc arena)
    (do (print "count ") (print name) (print " ") (println (int-to-string arena n)) 0))

  (fn root-kinds ((arena Arena) (st Structure))
    (@intent "The root's clauses by kind, as `count` lines: ground with no f(u) (the shared ground view's G), with an
              f(u), and the rest")
    (@spec ((Arena Structure) -> Int))
    (@alloc arena)
    (let ((mut g 0) (mut f 0) (mut other 0))
      (do (match (list-get (. st sets) 0)
            ((some r) (for-each (c (. r cs))
                        (cond ((ground-clause c) (set! g (+ g 1)))
                              ((clause-has-fterm c) (set! f (+ f 1)))
                              (else (set! other (+ other 1))))))
            ((none) (set! g 0)))
          (count-line arena "root-ground" g)
          (count-line arena "root-fu" f)
          (count-line arena "root-other" other))))

  (fn clause-has-fterm ((c Clause))
    (@intent "Does a literal of c mention a term f(u)?")
    (@spec ((Clause) -> Bool))
    (let ((mut found false))
      (do (for-each (l (. c body)) (when (has-fterm l) (set! found true)))
          (for-each (l (. c head)) (when (has-fterm l) (set! found true)))
          found)))

  (fn print-counts ((arena Arena) (p SatResult))
    (@intent "The prototype's work, one `count` line each, before the report (entdiff takes no such line: a reader strips them)")
    (@spec ((Arena SatResult) -> Int))
    (@alloc arena)
    (let ((c (. p counts)) (st (. (. p res) st)) (mut total 0) (mut root 0) (mut v 0))
      (do (for-each (x (. st sets))
            (do (set! total (+ total (cast Int (list-len (. x cs)))))
                (when (== v 0) (set! root (cast Int (list-len (. x cs)))))
                (set! v (+ v 1))))
          (count-line arena "rounds" (. (. p res) rounds))
          (count-line arena "contexts" (cast Int (list-len (. st ctxs))))
          (count-line arena "edges" (cast Int (list-len (. st edges))))
          (count-line arena "constants" (cast Int (list-len (. (. st ord) consts))))
          (count-line arena "clauses" total)
          (count-line arena "root-clauses" root)
          (root-kinds arena st)
          (count-line arena "candidates" (. c cands))
          (count-line arena "root-candidates" (. c rcands))
          (count-line arena "committed" (. c added))
          (count-line arena "activated" (. c acts))
          (count-line arena "succ" (. c succs))
          (count-line arena "rsucc" (. c rsuccs))
          (count-line arena "nom-children" (. c noms))
          (count-line arena "hyper-choices" (. c hyper)))))

  (fn test-sriq-gate-table ((arena Arena))
    (@intent "§5.5's language and gate conditions, row by row, against el and el++")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Each row is the omissions under el, el++ and sriq. sriq is not
    ;; wired (--profile sriq exits 3); its gate runs here only. The rows
    ;; are mirrored in corpus/test_project.py's SriqTest.
    (let ((mut ok true))
      (do
        (when (not
      (rungs3-omit arena "plain EL stays in every rung"
          ":C rdfs:subClassOf :D ." 0 0 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "InverseObjectProperties"
          ":r owl:inverseOf :s ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a restriction on an inverse"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :r ] ; owl:someValuesFrom :D ] ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "ObjectAllValuesFrom"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:allValuesFrom :D ] ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "ObjectUnionOf with a complement"
          ":C rdfs:subClassOf [ owl:unionOf ( :D [ owl:complementOf :D ] ) ] ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a complement on the left"
          "[ owl:complementOf :C ] rdfs:subClassOf :D ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a qualified cardinality, n = 16"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 16 ; owl:onClass :D ] ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a qualified cardinality, n = 17"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 17 ; owl:onClass :D ] ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "an unqualified exact cardinality"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:cardinality 2 ] ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a cardinality on a transitive role"
          ":r a owl:TransitiveProperty .
  :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxCardinality 1 ] ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a cardinality on the inverse of a transitive role"
          ":r a owl:TransitiveProperty .
  :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :r ] ; owl:maxCardinality 1 ] ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "FunctionalObjectProperty"
          ":r a owl:FunctionalProperty ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a functional transitive role"
          ":r a owl:TransitiveProperty , owl:FunctionalProperty ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "InverseFunctionalObjectProperty"
          ":r a owl:InverseFunctionalProperty ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "irreflexive and asymmetric"
          ":r a owl:IrreflexiveProperty , owl:AsymmetricProperty ." 2 2 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "Self on a simple role"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasSelf true ] ." 1 0 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "Self on a transitive role"
          ":r a owl:TransitiveProperty .
  :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasSelf true ] ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "symmetric and transitive: (R5) and (R4)"
          ":r a owl:SymmetricProperty , owl:TransitiveProperty ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "RO's part_of/has_part: regular only after the collapse"
          ":r a owl:TransitiveProperty . :s a owl:TransitiveProperty . :r owl:inverseOf :s ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "P and P- in one component"
          ":r owl:inverseOf :r . :r a owl:TransitiveProperty ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "R o R- [= R: R^c makes it cyclic, so the whole RBox goes"
          ":s rdfs:subPropertyOf :t .
  :r owl:propertyChainAxiom ( :r [ owl:inverseOf :r ] ) ." 1 1 2))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a cycle through a length-1 complex RIA"
          ":r owl:propertyChainAxiom ( :s :t ) . :r rdfs:subPropertyOf :s ." 2 2 2))
          (set! ok false))
        (when (not
      (rungs3-omit arena "DisjointObjectProperties"
          ":r owl:propertyDisjointWith :s ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "DisjointObjectProperties on a transitive role"
          ":r a owl:TransitiveProperty . :r owl:propertyDisjointWith :s ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "DisjointUnion"
          ":C owl:disjointUnionOf ( :D [ owl:complementOf :D ] ) ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "the top role as a super-role is a tautology"
          ":r rdfs:subPropertyOf owl:topObjectProperty ." 1 0 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "an inverse into the top role is a tautology under sriq"
          "[ owl:inverseOf :r ] rdfs:subPropertyOf owl:topObjectProperty ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "the top role elsewhere"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty owl:topObjectProperty ; owl:someValuesFrom :D ] ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "the bottom role"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty owl:bottomObjectProperty ; owl:someValuesFrom :D ] ." 1 0 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a cardinality on the bottom role"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty owl:bottomObjectProperty ; owl:maxCardinality 1 ] ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "ObjectHasValue: a class nominal"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasValue :a ] ." 1 0 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "ObjectOneOf: a class nominal"
          ":C rdfs:subClassOf [ owl:oneOf ( :a ) ] ." 1 0 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "an anonymous individual"
          "_:x :r :a ." 1 1 1))
          (set! ok false))
        (when (not
      (rungs3-omit arena "SameIndividual and DifferentIndividuals"
          ":a owl:sameAs :b . :a owl:differentFrom :b ." 2 0 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a negative object assertion"
          "[ a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ] ." 1 0 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "a class assertion with a union"
          ":a a [ owl:unionOf ( :C :D ) ] ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "no range condition under sriq"
          ":s rdfs:range :C . :t rdfs:range :D .
  :t owl:propertyChainAxiom ( :r :s ) ." 1 1 0))
          (set! ok false))
        (when (not
      (rungs3-omit arena "used data stays out"
          ":d a owl:DatatypeProperty . :a :d 1 ." 1 1 1))
          (set! ok false))
        ok)))

  (fn test-el-plus-plus-gate-table ((arena Arena))
    (@intent "Each el++ construct is omitted under el and accepted under el++, or omitted by both")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE TWO HALVES OF THE GATE, PER CONSTRUCT. The el++ column says what
    ;; §5.4 admits; the el column says el is unchanged by it. Self's rows
    ;; are the simple-role condition: a role that is transitive, above a
    ;; transitive one, or the super-role of a chain is not simple.
    (and
      (rungs-omit arena "hasValue"
        ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasValue :a ] ." 1 0)
      (rungs-omit arena "oneOf of one"
        ":C owl:equivalentClass [ a owl:Class ; owl:oneOf ( :a ) ] ." 2 0)
      (rungs-omit arena "hasSelf, simple role"
        ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasSelf true ] ." 1 0)
      (rungs-omit arena "reflexive role"
        ":r a owl:ReflexiveProperty ." 1 0)
      (rungs-omit arena "sameAs"
        ":a owl:sameAs :b ." 1 0)
      (rungs-omit arena "differentFrom"
        ":a owl:differentFrom :b ." 1 0)
      (rungs-omit arena "AllDifferent"
        "[] a owl:AllDifferent ; owl:members ( :a :b ) ." 1 0)
      (rungs-omit arena "negative assertion"
        "[] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ." 1 0)
      (rungs-omit arena "empty role"
        ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty owl:bottomObjectProperty ; owl:someValuesFrom owl:Thing ] ." 1 0)
      (rungs-omit arena "inclusion into the universal role"
        ":r rdfs:subPropertyOf owl:topObjectProperty ." 1 0)
      (rungs-omit arena "chain into the universal role"
        "owl:topObjectProperty owl:propertyChainAxiom ( :r :s ) ." 1 0)
      (rungs-omit arena "oneOf of two"
        ":C owl:equivalentClass [ a owl:Class ; owl:oneOf ( :a :b ) ] ." 2 2)
      (rungs-omit arena "hasSelf, transitive role"
        ":t a owl:TransitiveProperty . :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :t ; owl:hasSelf true ] ." 1 1)
      (rungs-omit arena "hasSelf, role above a transitive one"
        ":t a owl:TransitiveProperty . :t rdfs:subPropertyOf :s . :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s ; owl:hasSelf true ] ." 1 1)
      (rungs-omit arena "hasSelf, role above a chain"
        ":s owl:propertyChainAxiom ( :r :r ) . :C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s ; owl:hasSelf true ] ." 1 1)
      (rungs-omit arena "universal role in a restriction"
        ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty owl:topObjectProperty ; owl:someValuesFrom :D ] ." 1 1)
      (rungs-omit arena "universal role below another"
        ":t rdfs:subPropertyOf :r . owl:topObjectProperty rdfs:subPropertyOf :r ." 1 1)
      (rungs-omit arena "universal role as a chain step"
        ":s owl:propertyChainAxiom ( :r owl:topObjectProperty ) ." 1 1)
      (rungs-omit arena "empty role as a chain step"
        ":s owl:propertyChainAxiom ( :r owl:bottomObjectProperty ) ." 1 0)
      (rungs-omit arena "oneOf of a reserved IRI"
        ":C rdfs:subClassOf [ a owl:Class ; owl:oneOf ( owl:Thing ) ] ." 1 1)
      (rungs-omit arena "hasValue on a reserved IRI"
        ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasValue owl:Thing ] ." 1 1)
      (rungs-omit arena "AllDifferent with a reserved IRI"
        "[] a owl:AllDifferent ; owl:members ( :a owl:Thing ) ." 1 1)
      (rungs-omit arena "sameAs an XSD IRI"
        "@prefix xsd: <http://www.w3.org/2001/XMLSchema#> . :a owl:sameAs xsd:string ." 1 1)
      (rungs-omit arena "universal role into itself"
        "owl:topObjectProperty rdfs:subPropertyOf owl:topObjectProperty ." 1 0)
      (rungs-omit arena "functional role"
        ":r a owl:FunctionalProperty ." 1 1)
      (rungs-omit arena "hasValue, anonymous"
        ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasValue [] ] ." 1 1)))

  (fn test-top-role-tautology-is-dropped ((arena Arena))
    (@intent "Under el++, R ⊑ owl:topObjectProperty is neither accepted nor omitted")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A tautology is not a gap (K0), and it must not reach the
    ;; calculus either: owl:topObjectProperty is never a role el++ has.
    (match (gate-ttl-in arena (string-concat arena (rung-prefix)
             ":r rdfs:subPropertyOf owl:topObjectProperty .") 'profile-el-plus-plus)
      ((none) false)
      ((some gr)
        (and (== (cast Int (list-len (. gr accepted))) 0)
             (== (cast Int (list-len (. gr omissions))) 0)))))

  ;; ============================================================
  ;; el++'s normal form ([Krö10] Definition 1; SPEC §5.4 K0, K1)
  ;; ============================================================

  (fn ksc-form-of-ttl ((arena Arena) (ttl String))
    (@intent "Gate an inline document under el++ and render its normal form, one fact per line")
    (@spec ((Arena String) -> String))
    (@alloc arena)
    (match (gate-ttl-in arena (string-concat arena (rung-prefix) ttl) 'profile-el-plus-plus)
      ((none) "<did not gate>")
      ((some gr)
        (let ((no (normalize-ksc arena (. gr accepted)))
              (mut out ""))
          (do
            (for-each (ax (. no axioms))
              (set! out (string-concat arena out
                          (string-concat arena (render-ksc-axiom arena ax) "\n"))))
            out)))))

  (fn ksc-form-is ((arena Arena) (label String) (ttl String) (want String))
    (@intent "Does this document normalise to exactly these facts? Prints what it got when not")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (let ((got (ksc-form-of-ttl arena ttl)))
      (if (== (string-cmp got want) 0)
        true
        (do
          (println (string-concat arena (string-concat arena "  [ksc] " label) ":"))
          (print got)
          false))))

  ;; ============================================================
  ;; el++ engine (kscsat.slop) against the literal reference evaluator
  ;;
  ;; For every class of a fixture, the engine's answer - phase G, then the
  ;; class's run over G, rule (4) as a flag - must equal Theorem 2's Psc
  ;; slice for that class run naively from scratch with rule (4)
  ;; materialised. That is K2 and K3 checked, plus the index, the store,
  ;; the trigger table and the join combinator, whose completeness the
  ;; prover cannot state. Each fixture must gate whole under el++.
  ;; ============================================================

  (type KscFixture (record
    (axioms  (List KscAxiom))
    (classes (List KName))))

  (fn ksc-fixture ((arena Arena) (path String))
    (@intent "Gate a fixture file under el++, nothing omitted, and normalise it")
    (@spec ((Arena String) -> (Option KscFixture)))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-el-plus-plus)
      ((none) (none))
      ((some gr)
        (if (> (list-len (. gr omissions)) 0)
          (do
            (for-each (o (. gr omissions)) (println (string-concat arena "  [ksc omitted] " (render-omission arena o))))
            (none))
          (some (record-new KscFixture
                  (axioms  (. (normalize-ksc arena (. gr accepted)) axioms))
                  (classes (input-classes arena (. gr signature)))))))))

  (fn kname-label ((arena Arena) (n KName))
    (@intent "A class name, for a failure message")
    (@spec ((Arena KName) -> String))
    (@alloc arena)
    (match n
      ((k-class i) (. i value))
      ((k-fresh k) (string-concat arena "_:" (int-to-string arena k)))))

  (fn ksc-engine-matches-reference ((arena Arena) (label String) (ttl String))
    (@intent "Does the engine answer every holds(A, B) and unsat(A) as the reference does?")
    (@spec ((Arena String String) -> Bool))
    (@alloc arena)
    (match (ksc-fixture arena ttl)
      ((none) (do (println (string-concat arena "  [ksc differential] did not gate whole: " label)) false))
      ((some fx)
        (let ((res (ksc-run arena (. fx axioms) (. fx classes) (default-config)))
              (nothing (union-new KName k-class (record-new IRI (value OWL_NOTHING))))
              (thing   (union-new KName k-class (record-new IRI (value OWL_THING))))
              (mut ok true))
          (do
            (let ((tref (reference-closure arena (. fx axioms) (some thing) (. fx classes))))
              (when (not (== (. res inconsistent) (reference-answer tref thing nothing)))
                (do (println (string-concat arena "  [ksc differential] inconsistency differs: " label))
                    (set! ok false))))
            (for-each (a (. res answers))
              (let ((ref (reference-closure arena (. fx axioms) (some (. a cls)) (. fx classes)))
                    (ref-unsat (reference-answer ref (. a cls) nothing)))
                (do
                  (when (not (== (. a unsat) ref-unsat))
                    (do (println (string-concat arena "  [ksc differential] unsat differs: " label))
                        (println (string-concat arena "    for " (kname-label arena (. a cls))))
                        (set! ok false)))
                  (for-each (b (. fx classes))
                    (let ((eng (answer-holds a b))
                          (want (if ref-unsat true (reference-answer ref (. a cls) b))))
                      (when (not (== eng want))
                        (do (println (string-concat arena "  [ksc differential] holds differs: " label))
                            (println (string-concat arena "    "
                                       (string-concat arena (kname-label arena (. a cls))
                                         (string-concat arena " ⊑ " (kname-label arena b)))))
                            (set! ok false))))))))
            ok)))))

  (fn ksc-holds ((arena Arena) (ttl String) (a String) (b String))
    (@intent "The engine's entails-sub(A, B) on a fixture: 1 yes, 0 no, -1 did not gate")
    (@spec ((Arena String String String) -> Int))
    (@alloc arena)
    (match (ksc-fixture arena ttl)
      ((none) -1)
      ((some fx)
        (let ((res (ksc-run arena (. fx axioms) (. fx classes) (default-config)))
              (an (union-new KName k-class (record-new IRI (value a))))
              (bn (union-new KName k-class (record-new IRI (value b))))
              (mut out 0))
          (do
            (when (. res inconsistent) (set! out 1))
            (for-each (x (. res answers))
              (when (kname-eq (. x cls) an)
                (when (answer-holds x bn) (set! out 1))))
            out)))))

  (fn ksc-inconsistent ((arena Arena) (ttl String))
    (@intent "The engine's inconsistent on a fixture: 1 yes, 0 no, -1 did not gate")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (ksc-fixture arena ttl)
      ((none) -1)
      ((some fx) (if (. (ksc-run arena (. fx axioms) (. fx classes) (default-config)) inconsistent) 1 0))))

  (fn ksc-fixture-count ()
    (@intent "How many el++ fixtures there are")
    (@spec (() -> Int))
    (@pure)
    38)

  (fn ksc-fixture-at ((i Int))
    (@intent "el++ fixture i: §5.4's constructs, alone and combined, as a file under corpus/fixtures/el++")
    (@spec ((Int) -> String))
    (@pure)
    ;; Each file's header says what it tests and what follows. The files
    ;; are the one copy: the oracle differential reads them too.
    (match i
      (0 "corpus/fixtures/el++/ksc-00.ttl")
      (1 "corpus/fixtures/el++/ksc-01.ttl")
      (2 "corpus/fixtures/el++/ksc-02.ttl")
      (3 "corpus/fixtures/el++/ksc-03.ttl")
      (4 "corpus/fixtures/el++/ksc-04.ttl")
