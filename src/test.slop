          (do (println "  [ksc] K6: ⊤ ⊑ ∃r.{a} makes owl:Thing ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 18) "http://example.org/t#C" "http://example.org/t#E") 1))
          (do (println "  [ksc] K6: ⊤ ⊑ ∃r.{a} makes C ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 19) "http://example.org/t#Q2" "http://example.org/t#Q1") 0))
          (do (println "  [ksc] K6 does not merge: Q2 ⋢ Q1") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 19) "http://example.org/t#Q1" "http://example.org/t#Q2") 0))
          (do (println "  [ksc] K6 does not merge: Q1 ⋢ Q2") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 20) "http://example.org/t#Q2" "http://example.org/t#E") 0))
          (do (println "  [ksc] K6 does not merge through witnesses: Q2 ⋢ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 20) "http://example.org/t#Q1" "http://example.org/t#B") 0))
          (do (println "  [ksc] fixture 20: Q1 ⋢ B") (set! ok false)))
        ok)))

  ;; ============================================================
  ;; el against el++ (SPEC §5.4 K5) and sriq (§5.5 S4): on input inside
  ;; el, complete runs of the three rungs print the same report except for
  ;; `profile` and `rounds`. Every calculus is complete for the same theory
  ;; there, so a difference is a defect in one of them, or in K6. el++ and
  ;; sriq are incomparable; where both run complete and omit nothing, the
  ;; same holds of them.
  ;; ============================================================

  (fn classify-fixture-in ((arena Arena) (path String) (profile Profile))
    (@intent "The whole pipeline under a named rung, implemented or not")
    (@spec ((Arena String Profile) -> (Option Outcome)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (decode-owned arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok d)
            (match (prepare-in-profile arena d (default-config) profile)
              ((error _) (none))
              ((ok p)
                (match (reason arena p (default-config))
                  ((error _) (none))
                  ((ok o)    (some o))))))))))

  (fn rung-neutral-lines ((arena Arena) (o Outcome))
    (@intent "A report's lines without the two that name the rung's own accounting")
    (@spec ((Arena Outcome) -> (List String)))
    (@alloc arena)
    (let ((mut out (list-new arena String)))
      (do
        (for-each (l (report-lines arena o))
          (when (not (starts-with l "profile "))
            (when (not (starts-with l "rounds "))
              (list-push out l))))
        out)))

  (fn rungs-agree-on ((arena Arena) (path String))
    (@intent "Do el, el++ and sriq print the same report for this fixture, profile and rounds aside?")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (and (rung-pair-agrees arena path 'profile-el 'profile-el-plus-plus)
         (rung-pair-agrees arena path 'profile-el 'profile-sriq)))

  (fn rung-pair-agrees ((arena Arena) (path String) (x Profile) (y Profile))
    (@intent "Do rungs x and y print the same report for this fixture, profile and rounds aside?")
    (@spec ((Arena String Profile Profile) -> Bool))
    (@alloc arena)
    (let ((tag (string-concat arena "  [" (string-concat arena (profile-name x)
                 (string-concat arena " vs " (string-concat arena (profile-name y) "] "))))))
      (match (classify-fixture-in arena path x)
        ((none) (do (println (string-concat arena tag (string-concat arena "the first did not run: " path))) false))
        ((some a)
          (match (classify-fixture-in arena path y)
            ((none) (do (println (string-concat arena tag (string-concat arena "the second did not run: " path))) false))
            ((some b)
              (if (same-lines (rung-neutral-lines arena a) (rung-neutral-lines arena b))
                true
                (do
                  (println (string-concat arena tag (string-concat arena "reports differ: " path)))
                  (for-each (l (rung-neutral-lines arena a)) (println (string-concat arena "    < " l)))
                  (for-each (l (rung-neutral-lines arena b)) (println (string-concat arena "    > " l)))
                  false))))))))

  (fn test-el-plus-plus-and-sriq-agree ((arena Arena))
    (@intent "On every el++ fixture both el++ and sriq run complete and omit nothing on, they print the same report, profile and rounds aside")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; At least ten such fixtures, so the check cannot pass by vacuity.
    (let ((mut ok true) (mut compared 0) (mut i 0))
      (do (while (< i (ksc-fixture-count))
            (let ((c (pp-sriq-compare arena (ksc-fixture-at i))))
              (do (when (< c 0) (set! ok false))
                  (when (> c 0) (set! compared (+ compared 1)))
                  (set! i (+ i 1)))))
          (when (< compared 10) (println (string-concat arena "  [el++ vs sriq] compared only " (int-to-string arena compared))))
          (and ok (>= compared 10)))))

  (fn pp-sriq-compare ((arena Arena) (path String))
    (@intent "1 if el++ and sriq both ran complete on path and agree, 0 if either was incomplete, -1 on a failure")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (classify-fixture-in arena path 'profile-el-plus-plus)
      ((none) -1)
      ((some a)
        (match (classify-fixture-in arena path 'profile-sriq)
          ((none) -1)
          ((some b)
            (cond ((not (and (complete-outcome a) (complete-outcome b))) 0)
                  ((rung-pair-agrees arena path 'profile-el-plus-plus 'profile-sriq) 1)
                  (else -1)))))))

  (fn complete-outcome ((o Outcome))
    (@intent "A run at its fixpoint that omitted nothing")
    (@spec ((Outcome) -> Bool))
    (and (is-fixpoint (. o termination)) (== (list-len (. (. o coverage) omitted)) 0)))

  (fn test-el-and-el-plus-plus-agree ((arena Arena))
    (@intent "On every el fixture, el, el++ and sriq report the same findings (K5, §5.5 S4)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (mut ps (list-new arena String)))
      (do
        (list-push ps "corpus/fixtures/v0/abox-assertions.ttl")
        (list-push ps "corpus/fixtures/v0/disjoint-binary.ttl")
        (list-push ps "corpus/fixtures/v0/disjoint-nary.ttl")
        (list-push ps "corpus/fixtures/v0/domain.ttl")
        (list-push ps "corpus/fixtures/v0/equivalent-classes.ttl")
        (list-push ps "corpus/fixtures/v0/equivalent-properties.ttl")
        (list-push ps "corpus/fixtures/v0/exists-lhs.ttl")
        (list-push ps "corpus/fixtures/v0/exists-rhs.ttl")
        (list-push ps "corpus/fixtures/v0/intersection.ttl")
        (list-push ps "corpus/fixtures/v0/litmus.ttl")
        (list-push ps "corpus/fixtures/v0/negation-chain.ttl")
        (list-push ps "corpus/fixtures/v0/negation-domain-range.ttl")
        (list-push ps "corpus/fixtures/v0/negation-superclass.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain.ttl")
        (list-push ps "corpus/fixtures/v0/range.ttl")
        (list-push ps "corpus/fixtures/v0/subclass-atomic.ttl")
        (list-push ps "corpus/fixtures/v0/subproperty.ttl")
        (list-push ps "corpus/fixtures/v0/top-bottom.ttl")
        (list-push ps "corpus/fixtures/v0/transitive.ttl")
        (for-each (p ps) (when (not (rungs-agree-on arena p)) (set! ok false)))
        ok)))

  ;; ============================================================
  ;; el++'s engine: worker count and the cap (SPEC §5.4 "Rounds and the
  ;; cap", §6.8)
  ;; ============================================================

  (fn ksc-run ((arena Arena) (axioms (List KscAxiom)) (classes (List KName)) (config ReasonerConfig))
    (@intent "ksc-classify under a config that cannot cancel: its result (a Fault is reported and answers nothing)")
    (@spec ((Arena (List KscAxiom) (List KName) ReasonerConfig) -> KscResult))
    (@alloc arena)
    (match (ksc-classify arena axioms classes config)
      ((ok r) r)
      ((error _)
        (do
          (println "  [ksc] ksc-classify returned a Fault under a config that cannot cancel")
          (record-new KscResult
            (inconsistent false)
            (termination  (union-new Termination resource-limit 0))
            (rounds       0)
            (g-rounds     0)
            (g-facts      0)
            (w-rounds     0)
            (w-facts      0)
            (unsafe-count 0)
            (answers      (list-new arena ClassAnswer)))))))

  (fn cancel-flag-set ()
    (@intent "The address of a cancel flag that is already set, as cancel-ptr")
    (@spec (() -> I64))
    (let ((mut p 0))
      (do
        (c-inline "static uint32_t howl_test_cancel_flag = 1; p = (int64_t)(uintptr_t)&howl_test_cancel_flag;")
        (cast I64 p))))

  (fn test-ksc-cancelled ((arena Arena))
    (@intent "el++ honours cancel-ptr: a set flag gives Fault::cancelled and no result, whatever the cap (§5.4)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Cap 0 as well as the default: cancellation is read ahead of the cap,
    ;; so a run with work pending and no round to spend is still cancelled.
    (if (cancelled-under arena (default-config))
      (cancelled-under arena (ksc-config 1 0))
      false))

  (fn cancelled-under ((arena Arena) (base-cfg ReasonerConfig))
    (@intent "Does fixture 0, with a set cancel-ptr on this config, give Fault::cancelled?")
    (@spec ((Arena ReasonerConfig) -> Bool))
    (@alloc arena)
    (let ((mut cfg base-cfg))
      (do
        (set! cfg cancel-ptr (cancel-flag-set))
        (match (ksc-fixture arena (ksc-fixture-at 0))
          ((none) false)
          ((some fx)
            (match (ksc-classify arena (. fx axioms) (. fx classes) cfg)
              ((ok _) false)
              ((error f)
                (match f
                  ((cancelled)     true)
                  ((input-error _) false)
                  ((refused _)     false)
                  ((unavailable _) false)))))))))

  (fn ids-round-trip ((arena Arena) (axioms (List KscAxiom)) (classes (List KName)))
    (@intent "Does every fact of every class's reference closure decode back from its store encoding, distinct facts staying distinct?")
    (@spec ((Arena (List KscAxiom) (List KName)) -> Bool))
    (@alloc arena)
    (let ((ids (build-ksc-ids arena axioms classes (. (build-ksc-index arena axioms) individuals)))
          (thing (union-new KName k-class (record-new IRI (value OWL_THING))))
          (facts (set-new arena KFact))
          (codes (set-new arena CFact))
          (mut qs (list-new arena KName))
          (mut ok true))
      (do
        (list-push qs thing)
        (for-each (q classes) (list-push qs q))
        (for-each (q qs)
          (for-each (f (reference-closure arena axioms (some q) classes))
            (let ((c (encode-fact ids f)))
              (do
                (when (not (kfact-eq (decode-fact ids c) f)) (set! ok false))
                (set-put facts f)
                (set-put codes c)))))
        (if ok (== (set-len facts) (set-len codes)) false))))

  (fn test-ksc-ids-round-trip ((arena Arena))
    (@intent "The store's ids are a bijection on every fact Psc derives, on input names and on renamed ones")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Input names exercise the table (IRI classes, roles, individuals);
    ;; renamed ones the arithmetic ids the engine actually stores.
    (let ((mut ok true)
          (mut i 0))
      (do
        (while (< i (ksc-fixture-count))
          (do
            (match (ksc-fixture arena (ksc-fixture-at i))
              ((some fx)
                (let ((nm (build-ksc-names arena (. fx axioms) (. fx classes))))
                  (do
                    (when (not (ids-round-trip arena (. fx axioms) (. fx classes)))
                      (do (println (string-concat arena "  [ksc ids] input names, fixture " (int-to-string arena i)))
                          (set! ok false)))
                    (when (not (ids-round-trip arena (rename-ksc-axioms arena nm (. fx axioms))
                                 (rename-classes arena nm (. fx classes))))
                      (do (println (string-concat arena "  [ksc ids] renamed, fixture " (int-to-string arena i)))
                          (set! ok false))))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn holds-under ((idx KscIndex) (fs (List KFact)) (x KElem) (v RoleId) (y KElem))
    (@intent "Does fs hold triple(x, e, y) for some e in sub*(v): the K7 read of triple(x, v, y)?")
    (@spec ((KscIndex (List KFact) KElem RoleId KElem) -> Bool))
    (let ((mut found false))
      (do
        (for-each (f fs)
          (match f
            ((f-triple a e b)
              (when (if (kelem-eq a x) (if (kelem-eq b y) (role-under idx e v) false) false)
                (set! found true)))
            ((f-inst _ _) (do))
            ((f-self _ _) (do))))
        found)))

  (fn g-matches-reference ((arena Arena) (axioms (List KscAxiom)) (classes (List KName)))
    (@intent "Is the engine's G, decoded from its compact store, Psc's G read through K7?")
    (@spec ((Arena (List KscAxiom) (List KName)) -> Bool))
    (@alloc arena)
    ;; Every engine fact is a reference fact (a triple under its stored
    ;; role is one rule (13) also has), and every reference fact is read
    ;; by the engine: inst and self as stored, a triple through sub*. A G
    ;; that reaches ⊥ stops early by design (K3) and is not compared.
    (let ((idx (build-ksc-index arena axioms))
          (ids (build-ksc-ids arena axioms classes (. idx individuals)))
          (ref (reference-closure arena axioms (none) classes))
          (refset (set-new arena KFact))
          (mut seeds (list-new arena KFact))
          (mut eng (list-new arena KFact))
          (mut bottom false)
          (mut ok true))
      (do
        (for-each (f ref) (do (set-put refset f) (when (is-bottom-fact f) (set! bottom true))))
        (if bottom
          true
          (do
            (for-each (a (. idx individuals)) (list-push seeds (. (ksc-1 a) fact)))
            (let ((g (run-ksc arena idx ids (none) seeds false 10000 0 1 (list-new arena Arena)))
                  (engset (set-new arena KFact)))
              (do
                (for-each (c (store-facts arena (. g store)))
                  (let ((f (decode-fact ids c)))
                    (do
                      (list-push eng f)
                      (set-put engset f)
                      (when (not (set-has refset f)) (set! ok false)))))
                (for-each (f ref)
                  (match f
                    ((f-triple x v y) (when (not (holds-under idx eng x v y)) (set! ok false)))
                    ((f-inst _ _)     (when (not (set-has engset f)) (set! ok false)))
                    ((f-self _ _)     (when (not (set-has engset f)) (set! ok false)))))
                ok)))))))

  (fn test-ksc-g-matches-reference ((arena Arena))
    (@intent "On every el++ fixture the engine's stored G is Psc's G, fact for fact through K7")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (mut i 0))
      (do
        (while (< i (ksc-fixture-count))
          (do
            (match (ksc-fixture arena (ksc-fixture-at i))
              ((some fx)
                (when (not (g-matches-reference arena (. fx axioms) (. fx classes)))
                  (do (println (string-concat arena "  [ksc G] differs from the reference, fixture " (int-to-string arena i)))
                      (set! ok false))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn commit-agrees ((arena Arena) (axioms (List KscAxiom)) (classes (List KName)) (stop Bool) (with-classes Bool))
    (@intent "Does a run committing on four threads over four shards store and count what the serial one-shard run does?")
    (@spec ((Arena (List KscAxiom) (List KName) Bool Bool) -> Bool))
    (@alloc arena)
    ;; G's shape (individuals, stopping at ⊥, which exercises the serial
    ;; fallback), G's seeds never stopping (a ⊥ then raises K3's flag in
    ;; the parallel merge), or W's (every class seeded too, never stopping;
    ;; its flag is up from the seeds whenever owl:Nothing is a class).
    (let ((idx (build-ksc-index arena axioms))
          (ids (build-ksc-ids arena axioms classes (. idx individuals)))
          (cas (list-new arena Arena))
          (mut seeds (list-new arena KFact))
          (mut ok true))
      (do
        (for-each (a (. idx individuals)) (list-push seeds (. (ksc-1 a) fact)))
        (when with-classes
          (for-each (q classes) (list-push seeds (. (ksc-q q) fact))))
        (list-push cas (arena-new 4096))
        (list-push cas (arena-new 4096))
        (list-push cas (arena-new 4096))
        (list-push cas (arena-new 4096))
        (let ((one (run-ksc arena idx ids (none) seeds stop 10000 0 1 (list-new arena Arena)))
              (par (run-ksc arena idx ids (none) seeds stop 10000 0 4 cas)))
          (do
            (when (not (== (. one rounds) (. par rounds))) (set! ok false))
            (when (not (== (. one facts) (. par facts))) (set! ok false))
            (when (not (== (. one unsat) (. par unsat))) (set! ok false))
            (when (not (== (. one capped) (. par capped))) (set! ok false))
            (for-each (c (store-facts arena (. one store)))
              (when (not (store-holds (. par store) (none) (decode-fact ids c))) (set! ok false)))
            (for-each (c (store-facts arena (. par store)))
              (when (not (store-holds (. one store) (none) (decode-fact ids c))) (set! ok false)))
            (for-each (a cas) (arena-free a))
            ok)))))

  (fn commit-shapes-agree ((arena Arena) (fx KscFixture) (i Int))
    (@intent "Does fixture i commit on four threads what it does on one, in G's shape, unstopped G's and W's? Each shape that differs is printed")
    (@spec ((Arena KscFixture Int) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (when (not (commit-agrees arena (. fx axioms) (. fx classes) true false))
          (do (println (string-concat arena "  [ksc commit, G] W = 4 differs from W = 1, fixture " (int-to-string arena i)))
              (set! ok false)))
        (when (not (commit-agrees arena (. fx axioms) (. fx classes) false false))
          (do (println (string-concat arena "  [ksc commit, G unstopped] W = 4 differs from W = 1, fixture " (int-to-string arena i)))
              (set! ok false)))
        (when (not (commit-agrees arena (. fx axioms) (. fx classes) false true))
          (do (println (string-concat arena "  [ksc commit, W] W = 4 differs from W = 1, fixture " (int-to-string arena i)))
              (set! ok false)))
        ok)))

  (fn test-ksc-commit-identical ((arena Arena))
    (@intent "On every el++ fixture the parallel commit stores, counts and flags exactly what the serial one does, in G's shape, unstopped G's and W's")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (mut i 0))
      (do
        (while (< i (ksc-fixture-count))
          (do
            (match (ksc-fixture arena (ksc-fixture-at i))
              ((some fx) (when (not (commit-shapes-agree arena fx i)) (set! ok false)))
              ((none)    (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn ksc-config ((workers Int) (cap Int))
    (@intent "A config with a chosen worker count and round budget")
    (@spec ((Int Int) -> ReasonerConfig))
    (let ((mut cfg (default-config)))
      (do
        (set! cfg worker-count (cast (Int 1 .. 64) workers))
        (set! cfg max-iterations (cast (Int 0 .. 10000) cap))
        cfg)))

  (fn answers-equal ((a KscResult) (b KscResult))
    (@intent "Do two el++ results say the same: inconsistency, termination and every answer, in order?")
    (@spec ((KscResult KscResult) -> Bool))
    (if (not (== (. a inconsistent) (. b inconsistent)))
      false
      (if (not (== (list-len (. a answers)) (list-len (. b answers))))
        false
        (let ((mut ok true)
              (mut i 0))
          (do
            (for-each (x (. a answers))
              (do
                (match (list-get (. b answers) i)
                  ((some y)
                    (do
                      (when (not (kname-eq (. x cls) (. y cls))) (set! ok false))
                      (when (not (== (. x unsat) (. y unsat))) (set! ok false))
                      (when (not (== (list-len (. x subsumers)) (list-len (. y subsumers)))) (set! ok false))
                      (let ((mut j 0))
                        (for-each (n (. x subsumers))
                          (do
                            (match (list-get (. y subsumers) j)
                              ((some m) (when (not (kname-eq n m)) (set! ok false)))
                              ((none)   (set! ok false)))
                            (set! j (+ j 1)))))))
                  ((none) (set! ok false)))
                (set! i (+ i 1))))
            ok)))))

  (fn test-ksc-workers-agree ((arena Arena))
    (@intent "el++ answers every fixture the same at W = 1, 2, 4 and 8, at every round cap from 0 to R (§6.8)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Rounds are barriers (kscsat.slop, ksc-round), so a run cut at any
    ;; round must be the same at every worker count; R is the uncapped run's
    ;; rounds. Every fixture's rounds have at least one fact per worker
    ;; somewhere, so the parallel derive runs here, not only the serial one.
    (let ((mut ok true)
          (mut i 0))
      (do
        (while (< i (ksc-fixture-count))
          (do
            (match (ksc-fixture arena (ksc-fixture-at i))
              ((some fx)
                (let ((full (ksc-run arena (. fx axioms) (. fx classes) (ksc-config 1 1000)))
                      (mut cap 0))
                  (while (<= cap (+ (. full rounds) 1))
                    (let ((one (ksc-run arena (. fx axioms) (. fx classes) (ksc-config 1 cap))))
                      (do
                        (for-each (w (workers-under-test arena))
                          (when (not (same-run one (ksc-run arena (. fx axioms) (. fx classes) (ksc-config w cap))))
                            (do (println (string-concat arena
                                           (string-concat arena "  [ksc workers] fixture " (int-to-string arena i))
                                           (string-concat arena " differs at W="
                                             (string-concat arena (int-to-string arena w)
                                               (string-concat arena ", cap " (int-to-string arena cap))))))
                                (set! ok false))))
                        (set! cap (+ cap 1)))))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn same-run ((a KscResult) (b KscResult))
    (@intent "Every field two el++ results carry agrees: answers, termination, every count, every answer's own")
    (@spec ((KscResult KscResult) -> Bool))
    (let ((mut ok (answers-equal a b))
          (mut i 0))
      (do
        (when (not (== (. a rounds) (. b rounds))) (set! ok false))
        (when (not (== (. a g-rounds) (. b g-rounds))) (set! ok false))
        (when (not (== (. a g-facts) (. b g-facts))) (set! ok false))
        (when (not (== (. a w-rounds) (. b w-rounds))) (set! ok false))
        (when (not (== (. a w-facts) (. b w-facts))) (set! ok false))
        (when (not (== (. a unsafe-count) (. b unsafe-count))) (set! ok false))
        (when (not (match (. a termination)
                     ((fixpoint) (match (. b termination) ((fixpoint) true) ((resource-limit _) false)))
                     ((resource-limit x) (match (. b termination) ((fixpoint) false) ((resource-limit y) (== x y))))))
          (set! ok false))
        (for-each (x (. a answers))
          (do
            (match (list-get (. b answers) i)
              ((some y)
                (when (not (if (== (. x shared) (. y shared))
                             (if (== (. x complete) (. y complete))
                               (if (== (. x rounds) (. y rounds)) (== (. x facts) (. y facts)) false)
                               false)
                             false))
                  (set! ok false)))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn workers-under-test ((arena Arena))
    (@intent "The worker counts compared with W = 1")
    (@spec ((Arena) -> (List Int)))
    (@alloc arena)
    (let ((mut ws (list-new arena Int)))
      (do (list-push ws 2) (list-push ws 4) (list-push ws 8) ws)))

  (fn test-ksc-seed-unsat-counts-no-round ((arena Arena))
    (@intent "A class's run flagged by its seed adds no round and is not capped (Codex, slice 5b)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; owl:Nothing ⊑ {a} makes owl:Nothing unsafe; its run's seed is
    ;; inst(owl:Nothing, owl:Nothing), which raises the flag at once.
    (match (ksc-fixture arena (ksc-fixture-at 32))
      ((none) false)
      ((some fx)
        (let ((r  (ksc-run arena (. fx axioms) (. fx classes) (ksc-config 1 1000)))
              (r0 (ksc-run arena (. fx axioms) (. fx classes) (ksc-config 1 1000))))
          (and (match (. r termination) ((fixpoint) true) ((resource-limit _) false))
               (== (. r rounds) (+ (. r g-rounds) (+ (. r w-rounds) (max-run-rounds r))))
               (== (nothing-run-rounds r) 0)
               (not (. r0 inconsistent)))))))

  (fn nothing-run-rounds ((r KscResult))
    (@intent "The rounds owl:Nothing's own run took, or -1 if it had no answer")
    (@spec ((KscResult) -> Int))
    (let ((nothing (union-new KName k-class (record-new IRI (value OWL_NOTHING))))
          (mut out -1))
      (do
        (for-each (a (. r answers))
          (when (kname-eq (. a cls) nothing)
            (when (not (. a shared)) (set! out (. a rounds)))))
        out)))

  (fn max-run-rounds ((r KscResult))
    (@intent "The most rounds any class's own run took")
    (@spec ((KscResult) -> Int))
    (let ((mut m 0))
      (do
        (for-each (a (. r answers)) (when (> (. a rounds) m) (set! m (. a rounds))))
        m)))

  (fn test-ksc-cap ((arena Arena))
    (@intent "A cap that cuts a phase gives resource-limit and only sound answers (§5.4)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Fixture 0 (the litmus) has no individuals: G is empty at 0 rounds and
    ;; W needs several, so a cap of 1 cuts W and answers nothing. Fixture 16
    ;; has an unsafe class whose run needs rounds after G and W.
    (match (ksc-fixture arena (ksc-fixture-at 0))
      ((none) false)
      ((some fx)
        (let ((full   (ksc-run arena (. fx axioms) (. fx classes) (ksc-config 1 1000)))
              (capped (ksc-run arena (. fx axioms) (. fx classes) (ksc-config 1 1)))
              (zero   (ksc-run arena (. fx axioms) (. fx classes) (ksc-config 1 0))))
          (and (match (. full termination) ((fixpoint) true) ((resource-limit _) false))
               (match (. capped termination) ((fixpoint) false) ((resource-limit _) true))
               (== (list-len (. capped answers)) 0)
               (not (. capped inconsistent))
               (match (. zero termination) ((fixpoint) false) ((resource-limit _) true))
               (<= (. capped rounds) 1)
               (> (list-len (. full answers)) 0))))))

  (fn test-ksc-normal-form-rows ((arena Arena))
    (@intent "Each of §5.4's translation rows normalises to exactly its Definition 1 facts")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (when (not (ksc-form-is arena "hasValue on the right"
                     ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasValue :a ] ."
                     "subClass(_:0, {<http://example.org/t#a>})
supEx(<http://example.org/t#C>, <http://example.org/t#r>, _:0, _:1)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "hasValue on the left"
                     "[ a owl:Restriction ; owl:onProperty :r ; owl:hasValue :a ] rdfs:subClassOf :C ."
                     "subClass({<http://example.org/t#a>}, _:1)
subEx(<http://example.org/t#r>, _:1, _:0)
subClass(_:0, <http://example.org/t#C>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "nominal on the left"
                     "[ a owl:Class ; owl:oneOf ( :a ) ] rdfs:subClassOf :C ."
                     "subClass({<http://example.org/t#a>}, <http://example.org/t#C>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "nominal on the right"
                     ":C rdfs:subClassOf [ a owl:Class ; owl:oneOf ( :a ) ] ."
                     "subClass(<http://example.org/t#C>, {<http://example.org/t#a>})
"))
          (set! ok false))
        (when (not (ksc-form-is arena "Self on the right"
                     ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:hasSelf true ] ."
                     "supSelf(<http://example.org/t#C>, <http://example.org/t#r>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "Self on the left"
                     "[ a owl:Restriction ; owl:onProperty :r ; owl:hasSelf true ] rdfs:subClassOf :C ."
                     "subSelf(<http://example.org/t#r>, _:0)
subClass(_:0, <http://example.org/t#C>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "reflexive role"
                     ":r a owl:ReflexiveProperty ."
                     "supSelf(<http://www.w3.org/2002/07/owl#Thing>, _:r0)
subRole(_:r0, <http://example.org/t#r>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "sameAs"
                     ":a owl:sameAs :b ."
                     "subClass({<http://example.org/t#a>}, {<http://example.org/t#b>})
subClass({<http://example.org/t#b>}, {<http://example.org/t#a>})
"))
          (set! ok false))
        (when (not (ksc-form-is arena "differentFrom"
                     ":a owl:differentFrom :b ."
                     "subClass({<http://example.org/t#a>}, _:0)
subClass({<http://example.org/t#b>}, _:1)
subConj(_:0, _:1, <http://www.w3.org/2002/07/owl#Nothing>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "negative assertion"
                     "[] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ."
                     "subClass({<http://example.org/t#a>}, _:0)
subClass({<http://example.org/t#b>}, _:2)
subEx(<http://example.org/t#r>, _:2, _:1)
subConj(_:0, _:1, <http://www.w3.org/2002/07/owl#Nothing>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "range"
                     ":r rdfs:range :C ."
                     "supProd(<http://example.org/t#r>, ⊤, <http://example.org/t#C>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "domain"
                     ":r rdfs:domain :C ."
                     "subEx(<http://example.org/t#r>, <http://www.w3.org/2002/07/owl#Thing>, _:0)
subClass(_:0, <http://example.org/t#C>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "class assertion"
                     ":a a :C ."
                     "subClass({<http://example.org/t#a>}, <http://example.org/t#C>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "complex class assertion"
                     ":a a [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :C ] ."
                     "subClass({<http://example.org/t#a>}, _:0)
supEx(_:0, <http://example.org/t#r>, <http://example.org/t#C>, _:1)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "role assertion"
                     ":a :r :b ."
                     "supEx({<http://example.org/t#a>}, <http://example.org/t#r>, {<http://example.org/t#b>}, {<http://example.org/t#b>})
"))
          (set! ok false))
        (when (not (ksc-form-is arena "three-step chain"
                     ":t owl:propertyChainAxiom ( :r :s :r ) ."
                     "subRChain(<http://example.org/t#r>, <http://example.org/t#s>, _:r0)
subRChain(_:r0, <http://example.org/t#r>, <http://example.org/t#t>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "empty role"
                     ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty owl:bottomObjectProperty ; owl:someValuesFrom owl:Thing ] ."
                     "supEx(<http://example.org/t#C>, <http://www.w3.org/2002/07/owl#bottomObjectProperty>, <http://www.w3.org/2002/07/owl#Thing>, _:0)
subEx(<http://www.w3.org/2002/07/owl#bottomObjectProperty>, <http://www.w3.org/2002/07/owl#Thing>, <http://www.w3.org/2002/07/owl#Nothing>)
"))
          (set! ok false))
        (when (not (ksc-form-is arena "conjunction with a nominal"
                     "[ a owl:Class ; owl:intersectionOf ( :C [ a owl:Class ; owl:oneOf ( :a ) ] :D ) ] rdfs:subClassOf owl:Nothing ."
                     "subClass({<http://example.org/t#a>}, _:1)
subConj(<http://example.org/t#C>, _:1, _:0)
subConj(_:0, <http://example.org/t#D>, <http://www.w3.org/2002/07/owl#Nothing>)
"))
          (set! ok false))
        ok)))

  ;; ============================================================
  ;; Equality, inequality and negative assertions decode whole
  ;; (el++ slice 1; SPEC §5.4)
  ;; ============================================================

  (fn omissions-of-ttl ((arena Arena) (ttl String))
    (@intent "Gate an inline Turtle document; its omissions' renderings, one per line")
    (@spec ((Arena String) -> String))
    (@alloc arena)
    (match (gate-ttl arena ttl)
      ((none) "<did not gate>")
      ((some gr)
        (let ((mut out ""))
          (do
            (for-each (o (. gr omissions))
              (set! out (string-concat arena out
                          (string-concat arena (render-omission arena o) "\n"))))
            out)))))

  (fn omits-exactly ((arena Arena) (label String) (ttl String) (want String))
    (@intent "Does the gate omit exactly these renderings? Prints what it got when not")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (let ((got (omissions-of-ttl arena (string-concat arena (eq-prefix) ttl))))
      (if (== (string-cmp got want) 0)
        true
        (do
          (println (string-concat arena (string-concat arena "  [decode] " label) ": omitted"))
          (println got)
          false))))

  (fn eq-prefix ()
    (@intent "The shared prefix block for the equality-decode tests")
    (@spec (() -> String))
    (@pure)
    "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n:r a owl:ObjectProperty .\n:a a owl:NamedIndividual . :b a owl:NamedIndividual .\n")

  (fn test-equality-never-drops-an-operand ((arena Arena))
    (@intent "sameAs/differentFrom with a blank operand is an anonymous individual, not a one-member axiom")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A one-member SameIndividual is under-constrained: once el++ accepts
    ;; equality it would be accepted and mean nothing, a false coherent.
    (and
      (omits-exactly arena "sameAs, both named" ":a owl:sameAs :b ."
        "SameIndividual(http://example.org/t#a http://example.org/t#b)\n")
      (omits-exactly arena "sameAs, blank object" ":a owl:sameAs [] ."
        "AnonymousIndividual(<http://example.org/t#a> <http://www.w3.org/2002/07/owl#sameAs> _:b0 .)\n")
      (omits-exactly arena "differentFrom, blank subject" "[] owl:differentFrom :b ."
        "AnonymousIndividual(_:b0 <http://www.w3.org/2002/07/owl#differentFrom> <http://example.org/t#b> .)\n")
      (omits-exactly arena "sameAs, reserved IRI" ":a owl:sameAs owl:Nothing ."
        "ReservedVocabulary(<http://example.org/t#a> <http://www.w3.org/2002/07/owl#sameAs> <http://www.w3.org/2002/07/owl#Nothing> .)\n")
      ;; a literal is data, not an anonymous individual
      (omits-exactly arena "sameAs, literal" ":a owl:sameAs \"x\" ."
        "DataAxiom(<http://example.org/t#a> <http://www.w3.org/2002/07/owl#sameAs> \"x\" .)\n")
      (omits-exactly arena "AllDifferent, literal member" "[] a owl:AllDifferent ; owl:members ( :a \"x\" ) ."
        "DataAxiom(_:b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#AllDifferent> .)\n")))

  (fn test-anonymous-members-are-omissions-not-faults ((arena Arena))
    (@intent "An anonymous member of AllDifferent or oneOf is an omission; the document still decodes")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Both used to be input-errors that faulted the whole document, for a
    ;; construct that is well-formed OWL 2 and merely outside OWL 2 EL.
    ;; The omission TEXT is pinned, not just counted: dropping the
    ;; anonymous member instead leaves a one-member DifferentIndividuals
    ;; or oneOf, which `el` omits too — so a count cannot tell the two
    ;; apart — but which `el++` would accept and reason with.
    (let ((pre (eq-prefix)))
      (and
        (decodes-ok arena (string-concat arena pre "[] a owl:AllDifferent ; owl:members ( :a [] ) ."))
        (omits-exactly arena "AllDifferent, anonymous member"
          "[] a owl:AllDifferent ; owl:members ( :a [] ) ."
          "AnonymousIndividual(_:b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#AllDifferent> .)\n")
        (decodes-ok arena (string-concat arena pre
          ":C a owl:Class . :C owl:equivalentClass [ a owl:Class ; owl:oneOf ( :a [] ) ] ."))
        (omits-exactly arena "oneOf, anonymous member"
          ":C a owl:Class . :C owl:equivalentClass [ a owl:Class ; owl:oneOf ( :a [] ) ] ."
          "SubClassOf(AnonymousClass(owl:oneOf with an anonymous individual) http://example.org/t#C)\nSubClassOf(http://example.org/t#C AnonymousClass(owl:oneOf with an anonymous individual))\n"))))

  (fn test-negative-assertion-decodes-whole ((arena Arena))
    (@intent "NegativePropertyAssertion is read as ¬r(a, b) from its node, its parts consumed")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Before, the type triple was an opaque fragment and each part a
    ;; separate reserved-vocabulary omission: four lines for one axiom.
    (let ((pre (eq-prefix)))
      (and
        (omits-exactly arena "object form"
          "[] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ."
          "NegativeObjectPropertyAssertion(http://example.org/t#r http://example.org/t#a http://example.org/t#b)\n")
        ;; the DATA form is a data axiom, not a nominal
        (== (gate-omissions-of-ttl arena (string-concat arena pre
              ":d a owl:DatatypeProperty . [] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :d ; owl:targetValue \"x\" .")) 1)
        ;; an anonymous target is an anonymous individual
        (== (gate-omissions-of-ttl arena (string-concat arena pre
              "[] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual [] .")) 1)
        ;; a missing part is malformed input
        (not (decodes-ok arena (string-concat arena pre
               "[] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r .")))
        ;; EVERY PART IS VALIDATED FIRST: a target value alone is not a
        ;; data axiom, both targets are not one, two sources are not one
        (not (decodes-ok arena (string-concat arena pre
               "[] a owl:NegativePropertyAssertion ; owl:targetValue \"x\" .")))
        (not (decodes-ok arena (string-concat arena pre
               "[] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :r ; owl:targetIndividual :b ; owl:targetValue \"x\" .")))
        (not (decodes-ok arena (string-concat arena pre
               "[] a owl:NegativePropertyAssertion ; owl:sourceIndividual :a , :b ; owl:assertionProperty :r ; owl:targetIndividual :b .")))
        ;; A PART PREDICATE ON ANY OTHER SUBJECT IS NOT CONSUMED: it is
        ;; reported, never silently skipped
        (omits-exactly arena "stray part predicate"
          ":a owl:sourceIndividual :b ."
          "ReservedVocabulary(<http://example.org/t#a> <http://www.w3.org/2002/07/owl#sourceIndividual> <http://example.org/t#b> .)\n"))))

  (fn test-literal-has-value-is-data ((arena Arena))
    (@intent "owl:hasValue with a literal is DataHasValue, not an anonymous individual")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; On a data property it is read as the restriction it is, naming the
    ;; property and the value. On an object property a literal value is
    ;; still data, and still no anonymous individual.
    (and
      (omits-exactly arena "literal hasValue"
        ":C a owl:Class . :d a owl:DatatypeProperty . :C owl:equivalentClass [ a owl:Restriction ; owl:onProperty :d ; owl:hasValue \"x\" ] ."
        "SubClassOf(DataRange(DataHasValue(http://example.org/t#d \"x\")) http://example.org/t#C)\nSubClassOf(http://example.org/t#C DataRange(DataHasValue(http://example.org/t#d \"x\")))\n")
      (omits-exactly arena "literal hasValue on an object property"
        ":C a owl:Class . :r a owl:ObjectProperty . :C owl:equivalentClass [ a owl:Restriction ; owl:onProperty :r ; owl:hasValue \"x\" ] ."
        "SubClassOf(DataRange(owl:hasValue with a literal (DataHasValue)) http://example.org/t#C)\nSubClassOf(http://example.org/t#C DataRange(owl:hasValue with a literal (DataHasValue)))\n")))

  ;; ============================================================
  ;; Negation in positive positions (§5.2's rewrite; SPEC §5.3 L0)
  ;; ============================================================

  (fn neg-prefix ()
    (@intent "The shared prefix block for the negation-rewrite tests")
    (@spec (() -> String))
    (@pure)
    "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:A a owl:Class . :B a owl:Class . :C a owl:Class .\n:r a owl:ObjectProperty .\n")

  (fn accepts-exactly ((arena Arena) (label String) (ttl String) (want String))
    (@intent "Does the gate accept exactly these renderings? Prints what it got when not")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (let ((got (gate-accepted-of-ttl arena (string-concat arena (neg-prefix) ttl))))
      (if (== (string-cmp got want) 0)
        true
        (do
          (println (string-concat arena (string-concat arena "  [negation] " label) ": accepted"))
          (println got)
          false))))

  (fn test-negation-rewrites-to-bottom-gcis ((arena Arena))
    (@intent "Each positive-position ¬E becomes exactly its ⊥ GCI, beside the positive part")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; EXACT SETS, because the two wrong rewrites both look plausible:
    ;; dropping the ⊥ piece keeps every positive consequence, and giving
    ;; a range the DOMAIN form ∃r.⊤ ⊓ B ⊑ ⊥ is still a ⊥ GCI — it just
    ;; forbids r-edges FROM a B instead of INTO one.
    (and
      ;; ran(r) ⊑ A ⊓ ¬B  ⇒  ran(r) ⊑ A,  ∃r.B ⊑ ⊥
      (accepts-exactly arena "range"
        ":r rdfs:range [ owl:intersectionOf ( :A [ owl:complementOf :B ] ) ] ."
        "ObjectPropertyRange(http://example.org/t#r http://example.org/t#A)\nSubClassOf(ObjectSomeValuesFrom(http://example.org/t#r http://example.org/t#B) owl:Nothing)\n")
      ;; dom(r) ⊑ ¬B  ⇒  ∃r.⊤ ⊓ B ⊑ ⊥, and no domain axiom is left
      (accepts-exactly arena "domain"
        ":r rdfs:domain [ owl:complementOf :B ] ."
        "SubClassOf(ObjectIntersectionOf(ObjectSomeValuesFrom(http://example.org/t#r owl:Thing) http://example.org/t#B) owl:Nothing)\n")
      ;; C ⊑ A ⊓ ¬∃r.B ⊓ ¬B  ⇒  C ⊑ A,  C ⊓ ∃r.B ⊑ ⊥,  C ⊓ B ⊑ ⊥
      (accepts-exactly arena "superclass"
        ":C rdfs:subClassOf [ owl:intersectionOf ( :A [ owl:complementOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] ] [ owl:complementOf :B ] ) ] ."
        "SubClassOf(ObjectIntersectionOf(http://example.org/t#C ObjectSomeValuesFrom(http://example.org/t#r http://example.org/t#B)) owl:Nothing)\nSubClassOf(ObjectIntersectionOf(http://example.org/t#C http://example.org/t#B) owl:Nothing)\nSubClassOf(http://example.org/t#C http://example.org/t#A)\n")
      ;; a conjunction on the left is extended, not nested
      (accepts-exactly arena "conjunction on the left"
        "[ owl:intersectionOf ( :A :C ) ] rdfs:subClassOf [ owl:complementOf :B ] ."
        "SubClassOf(ObjectIntersectionOf(http://example.org/t#A http://example.org/t#C http://example.org/t#B) owl:Nothing)\n")))

  (fn test-negation-rewrites-whole-axioms-or-none ((arena Arena))
    (@intent "An axiom the rewrite cannot fully take is omitted as written, never split")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Splitting would accept ran(r) ⊑ A and report a ⊥ GCI the user
    ;; never wrote; the omission must be the user's own axiom.
    (let ((pre (neg-prefix)))
      (and
        ;; an out-of-profile E
        (accepts-exactly arena "E out of profile"
          ":r rdfs:range [ owl:intersectionOf ( :A [ owl:complementOf [ owl:unionOf ( :B :C ) ] ] ) ] ." "")
        (== (gate-omissions-of-ttl arena (string-concat arena pre
              ":r rdfs:range [ owl:intersectionOf ( :A [ owl:complementOf [ owl:unionOf ( :B :C ) ] ] ) ] .")) 1)
        ;; an out-of-profile subclass, omitted as the user wrote it: the
        ;; rewritten piece C ⊓ B ⊑ ⊥ would be omitted too, one for one
        (accepts-exactly arena "C out of profile"
          "[ owl:unionOf ( :A :C ) ] rdfs:subClassOf [ owl:complementOf :B ] ." "")
        (== (string-cmp (omissions-of-ttl arena (string-concat arena pre
                          "[ owl:unionOf ( :A :C ) ] rdfs:subClassOf [ owl:complementOf :B ] ."))
                        "SubClassOf(ObjectUnionOf(http://example.org/t#A http://example.org/t#C) ObjectComplementOf(http://example.org/t#B))\n")
            0)
        ;; ¬E under ∃ is not a positive position at all
        (accepts-exactly arena "under an existential"
          ":C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom [ owl:complementOf :B ] ] ." ""))))

  (fn test-negative-range-normalizes-to-bottom ((arena Arena))
    (@intent "ran(r) ⊑ ¬B normalizes to ∃r.B ⊑ X, X ⊑ ⊥ — negative on the left")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((b-cls (cls "http://example.org/t#B"))
          (r     (rol "http://example.org/t#r")))
      (match (normalize-fixture arena "corpus/fixtures/probes/complement-range.ttl")
        ((none) false)
        ((some no)
          (let ((ax (. no axioms))
                (mut target (Option Node) (none)))
            (do
              (for-each (a ax)
                (match a
                  ((sub-some-lhs rr c d)
                    (when (and (role-eq rr r) (node-eq c b-cls)) (set! target (some d))))
                  (_ (do))))
              (match target
                ((none) false)
                ((some x)
                  (and (match x ((fresh-node _) true) (_ false))
                       (norm-contains ax (union-new NormAxiom sub-name x (node-bottom))))))))))))

  ;; ============================================================
  ;; Front end — normalization (M0 slice 4)
  ;; ============================================================

  (fn norm-eq ((a NormAxiom) (b NormAxiom))
    (@intent "Structural equality on normal-form axioms")
    (@spec ((NormAxiom NormAxiom) -> Bool))
    (@pure)
    (match a
      ((sub-name x y)
        (match b ((sub-name p q) (and (node-eq x p) (node-eq y q))) (_ false)))
      ((sub-and x y z)
        (match b ((sub-and p q r)
                   (and (node-eq x p) (node-eq y q) (node-eq z r))) (_ false)))
      ((sub-some-rhs x r y)
        (match b ((sub-some-rhs p q z)
                   (and (node-eq x p) (role-eq r q) (node-eq y z))) (_ false)))
      ((sub-some-lhs r x y)
        (match b ((sub-some-lhs q p z)
                   (and (role-eq r q) (node-eq x p) (node-eq y z))) (_ false)))
      ((sub-role r s2)
        (match b ((sub-role q t2) (and (role-eq r q) (role-eq s2 t2))) (_ false)))
      ((role-chain r s2 t2)
        (match b ((role-chain q u v)
                   (and (role-eq r q) (role-eq s2 u) (role-eq t2 v))) (_ false)))))

  (fn norm-contains ((xs (List NormAxiom)) (a NormAxiom))
    (@intent "Is this axiom present?")
    (@spec (((List NormAxiom) NormAxiom) -> Bool))
    (@pure)
    (let ((mut found false))
      (do (for-each (x xs) (when (norm-eq x a) (set! found true))) found)))

  (fn normalize-fixture ((arena Arena) (path String))
    (@intent "The full front end as far as normalization")
    (@spec ((Arena String) -> (Option NormOutput)))
    (@alloc arena)
    (match (gate-fixture arena path)
      ((none) (none))
      ((some gr) (some (normalize-accepted arena (. gr accepted))))))

  (fn test-litmus-reproduces-the-m1-normal-form ((arena Arena))
    (@intent "§12: litmus.ttl normalizes to M1's canonical NormAxiom set, fresh ids included")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE SEAM TEST FOR THE WHOLE PROJECT. M1 derived Mother ⊑ Parent
    ;; from a HAND-BUILT NormAxiom fixture; this asserts the real front
    ;; end produces that same set from Turtle. If it does not, M1's
    ;; litmus proved something about a fixture rather than about HOWL.
    ;;
    ;; The load-bearing axiom is `∃hasChild.Person ⊑ X` — the NEGATIVE
    ;; direction. Emit `X ⊑ ∃hasChild.Person` instead and every other
    ;; axiom here is still right, the normal form still looks
    ;; plausible, and Mother ⊑ Parent is simply never derived.
    (let ((person (cls "http://example.org/t#Person"))
          (parent (cls "http://example.org/t#Parent"))
          (mother (cls "http://example.org/t#Mother"))
          (hc     (rol "http://example.org/t#hasChild"))
          (x      (union-new Node fresh-node 0)))
      (match (normalize-fixture arena "corpus/fixtures/v0/litmus.ttl")
        ((none) false)
        ((some no)
          (let ((ax (. no axioms)))
            (and (== (cast Int (list-len ax)) 6)
                 (== (. no fresh-count) 1)
                 (norm-contains ax (union-new NormAxiom sub-some-lhs hc person x))
                 (norm-contains ax (union-new NormAxiom sub-and person x parent))
                 (norm-contains ax (union-new NormAxiom sub-name parent person))
                 (norm-contains ax (union-new NormAxiom sub-some-rhs parent hc person))
                 (norm-contains ax (union-new NormAxiom sub-name mother person))
                 (norm-contains ax (union-new NormAxiom sub-some-rhs mother hc person))))))))

  (fn test-normalization-polarity-is-negative-on-the-left ((arena Arena))
    (@intent "The defining existential is normalized in the NEGATIVE direction")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Stated separately from the set equality above so the failure
    ;; message points at polarity rather than at "the set differs".
    (let ((person (cls "http://example.org/t#Person"))
          (hc     (rol "http://example.org/t#hasChild"))
          (x      (union-new Node fresh-node 0)))
      (match (normalize-fixture arena "corpus/fixtures/v0/litmus.ttl")
        ((none) false)
        ((some no)
          (and (norm-contains (. no axioms) (union-new NormAxiom sub-some-lhs hc person x))
               ;; and the WRONG direction is absent
               (not (norm-contains (. no axioms)
                      (union-new NormAxiom sub-some-rhs x hc person))))))))

  (fn test-range-elimination-introduces-a-shared-filler ((arena Arena))
    (@intent "B ⊑ ∃r.⊤ with range(r)=A becomes B ⊑ ∃r.X, X ⊑ ⊤, X ⊑ A")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Ranges are ELIMINATED, not given a completion rule. A draft added
    ;; "CR8" — (X,Y) ∈ R(r), range(r) ⊑ A ⟹ A ∈ S(Y) — derived from
    ;; first principles. Plausible, maybe even correct, but the
    ;; published extension of EL++ with ranges gets its tractability and
    ;; completeness by eliminating ranges through fresh concepts.
    ;; Shipping CR8 would claim completeness from a proof that does not
    ;; cover the calculus implemented.
    (let ((a-cls (cls "http://example.org/t#A"))
          (b-cls (cls "http://example.org/t#B"))
          (r     (rol "http://example.org/t#r")))
      (match (normalize-fixture arena "corpus/fixtures/v0/range.ttl")
        ((none) false)
        ((some no)
          (let ((ax (. no axioms))
                (mut filler (Option Node) (none)))
            (do
              ;; find the existential's target after rewriting
              (for-each (a ax)
                (match a
                  ((sub-some-rhs c rr d)
                    (when (and (node-eq c b-cls) (role-eq rr r)) (set! filler (some d))))
                  (_ (do))))
              (match filler
                ((none) false)
                ((some x)
                  ;; the target is FRESH, not owl:Thing, and it carries
                  ;; the inherited range A
                  (and (match x ((fresh-node _) true) (_ false))
                       (norm-contains ax (union-new NormAxiom sub-name x a-cls)))))))))))

  (fn test-asserted-edges-seed-their-range ((arena Arena))
    (@intent "THE MANDATORY IDENTITY FIXTURE's precondition: r(a,b) seeds ran_T(r) into S(b)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE EXTENSION THE PUBLISHED REWRITE DOES NOT GIVE YOU. That
    ;; transformation touches only existential GCIs; asserted edges are
    ;; installed directly, so nothing propagates a range onto their
    ;; target. Without these seeds, Disjoint(C,D), range(r)=C,
    ;; range(s)=D, r(a,b), s(c,b) reports COHERENT — the ranges are
    ;; dropped and no propagation rule is left to notice.
    (let ((c-cls (cls "http://example.org/t#C"))
          (d-cls (cls "http://example.org/t#D"))
          (b-ind (union-new Node individual-node
                   (record-new IRI (value "http://example.org/t#b")))))
      (match (normalize-fixture arena "corpus/fixtures/hazards/abox-disjoint-range.ttl")
        ((none) false)
        ((some no)
          (let ((mut saw-c false)
                (mut saw-d false)
                (mut edges (cast Int (list-len (. no edges)))))
            (do
              (for-each (sd (. no seeds))
                (when (node-eq (. sd to) b-ind)
                  (match (. sd what)
                    ((derived-sub x)
                      (do (when (node-eq x c-cls) (set! saw-c true))
                          (when (node-eq x d-cls) (set! saw-d true))))
                    (_ (do)))))
              ;; both edges installed, and BOTH ranges land on :b — which
              ;; is what makes the disjointness detectable at all
              (and (== edges 2) saw-c saw-d)))))))

  (fn test-range-complex-fillers-stay-apart ((arena Arena))
    (@intent "X_{r,D} is keyed by the whole filler: two complex fillers, two X")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A KEY THAT DROPS A PAYLOAD MERGES DISTINCT OBJECTS. Both fillers
    ;; here are complex, so each is a fresh node; rendering every fresh
    ;; node alike gave both one shared X, which inherited P and U —
    ;; disjoint — and made C1 and C2 unsatisfiable. That is how OBI
    ;; reported itself inconsistent. Every other range test uses a NAMED
    ;; filler, which is why none of them noticed.
    (let ((path "corpus/fixtures/hazards/range-complex-fillers.ttl"))
      (and (complex-range-fillers-distinct arena path)
        (match (classify-fixture arena path)
          ((none) false)
          ((some o)
            (and (== (cast Int (list-len (. (. o findings) unsatisfiable))) 0)
                 (match (verdict o) ('verdict-coherent true) (_ false))))))))

  (fn complex-range-fillers-distinct ((arena Arena) (path String))
    (@intent "Do C1's and C2's existentials on r target different nodes after elimination?")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    ;; A SEPARATE FUNCTION ON PURPOSE. Inlined as an operand of `and`,
    ;; this `match` sits in expression position, and before slop 0.4.0
    ;; the transpiler lowered `(sub-some-rhs c rr d)` by binding `c` to
    ;; the whole payload and never declaring `rr` or `d` — a C compile
    ;; error (slop#171, fixed). In statement position, as here, it
    ;; destructures all three fields on any slop.
    (let ((c1 (cls "http://example.org/t#C1"))
          (c2 (cls "http://example.org/t#C2"))
          (r  (rol "http://example.org/t#r")))
      (match (normalize-fixture arena path)
        ((none) false)
        ((some no)
          (let ((mut f1 (Option Node) (none))
                (mut f2 (Option Node) (none)))
            (do
              (for-each (a (. no axioms))
                (match a
                  ((sub-some-rhs c rr d)
                    (when (role-eq rr r)
                      (do (when (node-eq c c1) (set! f1 (some d)))
                          (when (node-eq c c2) (set! f2 (some d))))))
                  (_ (do))))
              (match f1
                ((none) false)
                ((some x1)
                  (match f2
                    ((none) false)
                    ((some x2) (not (node-eq x1 x2))))))))))))

  (fn test-inverse-expressions-are-omissions ((arena Arena))
    (@intent "ObjectInverseOf is out-of-profile: enumerated, never an input-error")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; RO writes ten property chains with an inverse step. Faulting on
    ;; them made a mainstream OBO ontology exit 3 — "could not run" — for
    ;; a construct that is well-formed OWL 2 and simply outside OWL 2 EL.
    (let ((path "corpus/fixtures/out-of-profile/inverse-expressions.ttl")
          (pre "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n:p a owl:ObjectProperty . :q a owl:ObjectProperty .\n"))
      (and
        ;; The chain and the inclusion decode as out-of-profile axioms.
        ;; The restriction decodes as an in-profile SubClassOf carrying an
        ;; out-of-profile operand, so the GATE omits it — hence 2 here and
        ;; 3 after classification.
        (>= (out-of-profile-count-of arena path) 2)
        (match (classify-fixture arena path)
          ((none) false)
          ((some o)
            (and (>= (cast Int (list-len (. (. o coverage) omitted))) 3)
                 (match (verdict o) ('verdict-inconclusive true) (_ false)))))
        ;; THE REJECTING HALF: a blank node naming no property at all is
        ;; malformed and must still fault, or the inverse check launders
        ;; every broken property axiom into a quiet omission.
        (decodes-ok arena (string-concat arena pre ":q rdfs:subPropertyOf [ owl:inverseOf :p ] ."))
        (not (decodes-ok arena (string-concat arena pre ":q rdfs:subPropertyOf [ ] ."))))))

  ;; ============================================================
  ;; SPEC §12's structural invariants and §6.8 order-independence
  ;;
  ;; Each helper that destructures a multi-payload variant is its own
  ;; function, so its `match` sits in statement position: inside an
  ;; `and`/`or` operand, slop before 0.4.0 dropped the extra pattern
  ;; bindings (slop#171).
  ;; ============================================================

  (fn m0-fixture-paths ((arena Arena))
    (@intent "Every v0 fixture, plus the hazards that exercise normalization hardest")
    (@spec ((Arena) -> (List String)))
    (@alloc arena)
    (let ((mut ps (list-new arena String)))
      (do
        (list-push ps "corpus/fixtures/v0/subclass-atomic.ttl")
        (list-push ps "corpus/fixtures/v0/intersection.ttl")
        (list-push ps "corpus/fixtures/v0/exists-lhs.ttl")
        (list-push ps "corpus/fixtures/v0/exists-rhs.ttl")
        (list-push ps "corpus/fixtures/v0/equivalent-classes.ttl")
        (list-push ps "corpus/fixtures/v0/equivalent-properties.ttl")
        (list-push ps "corpus/fixtures/v0/disjoint-binary.ttl")
        (list-push ps "corpus/fixtures/v0/disjoint-nary.ttl")
        (list-push ps "corpus/fixtures/v0/subproperty.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push ps "corpus/fixtures/v0/transitive.ttl")
        (list-push ps "corpus/fixtures/v0/domain.ttl")
        (list-push ps "corpus/fixtures/v0/range.ttl")
        (list-push ps "corpus/fixtures/v0/abox-assertions.ttl")
        (list-push ps "corpus/fixtures/v0/top-bottom.ttl")
        (list-push ps "corpus/fixtures/v0/litmus.ttl")
        (list-push ps "corpus/fixtures/v0/negation-superclass.ttl")
        (list-push ps "corpus/fixtures/v0/negation-domain-range.ttl")
        (list-push ps "corpus/fixtures/v0/negation-chain.ttl")
        (list-push ps "corpus/fixtures/hazards/range-complex-fillers.ttl")
        (list-push ps "corpus/fixtures/hazards/abox-disjoint-range.ttl")
        ps)))

  (fn accounting-exempt ((ax RawAxiom))
    (@intent "Accepted axioms a named elimination may consume without a trace")
    (@spec ((RawAxiom) -> Bool))
    (@pure)
    ;; A standalone range(r) ⊑ A legitimately vanishes when no existential
    ;; or asserted edge uses r (§12), and a declaration is consumed rather
    ;; than logical. Everything else must leave a NormAxiom, an edge or a
    ;; seed behind.
    ;; `C ⊑ ⊤` holds in every model, and normalize-gci drops it by name
    ;; ("C ⊑ ⊤ is vacuous") — a semantics-preserving elimination, not a loss.
    (match ax
      ((ra-object-property-range _ _) true)
      ((ra-declaration _)             true)
      ((ra-sub-class-of _ r)          (match (deref r) ((rc-thing) true) (_ false)))
      (_                              false)))

  (fn axiom-accounted ((arena Arena) (ax RawAxiom))
    (@intent "Does one accepted axiom, normalized alone, discharge itself?")
    (@spec ((Arena RawAxiom) -> Bool))
    (@alloc arena)
    (let ((mut one (list-new arena RawAxiom)))
      (do
        (list-push one ax)
        (let ((no (normalize-accepted arena one)))
          (or (accounting-exempt ax)
              (> (cast Int (list-len (. no axioms))) 0)
              (> (cast Int (list-len (. no edges))) 0)
              (> (cast Int (list-len (. no seeds))) 0))))))

  (fn test-accounting-holds ((arena Arena))
    (@intent "§12: every accepted logical axiom is discharged by NormAxioms, edges/seeds, or a named elimination")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; NOT "one normal form per axiom", which is unsatisfiable for correct
    ;; input. What this catches is an accepted axiom the normalizer
    ;; silently DROPS: counted as covered, contributing nothing, and
    ;; invisible to every coverage check because it was accepted.
    (let ((mut ok true))
      (do
        (for-each (p (m0-fixture-paths arena))
          (match (gate-fixture arena p)
            ((none) (do (print "  [accounting] did not gate: ") (println p) (set! ok false)))
            ((some gr)
              (for-each (ax (. gr accepted))
                (when (not (axiom-accounted arena ax))
                  (do (print "  [accounting] undischarged in ") (print p) (print ": ")
                      (println (render-axiom arena ax))
                      (set! ok false)))))))
        ok)))

  (fn same-rendering ((arena Arena) (xs (List RawAxiom)) (ys (List RawAxiom)))
    (@intent "The same axioms, as the same canonical text, in the same order")
    (@spec ((Arena (List RawAxiom) (List RawAxiom)) -> Bool))
    (@alloc arena)
    (let ((mut ok (== (list-len xs) (list-len ys)))
          (mut i 0)
          (n (cast Int (list-len xs))))
      (do
        (while (and ok (< i n))
          (do
            (match (list-get xs i)
              ((some x)
                (match (list-get ys i)
                  ((some y)
                    (when (not (string-eq (render-axiom arena x) (render-axiom arena y)))
                      (set! ok false)))
                  ((none) (set! ok false))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn test-canonicalization-is-idempotent ((arena Arena))
    (@intent "§12: gating the gate's own accepted output changes nothing, text or order")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; If canonical form were not a fixed point, the same ontology read
    ;; back from HOWL's own output would hash differently — the §6.8
    ;; failure, arriving one round trip later.
    (let ((mut ok true))
      (do
        (for-each (p (m0-fixture-paths arena))
          (match (gate-fixture arena p)
            ((none) (set! ok false))
            ((some gr)
              (let ((again (gate-axioms arena (. gr accepted) (. gr signature)
                             (list-new arena Omission) 'profile-el)))
                (when (not (same-rendering arena (. gr accepted) (. again accepted)))
                  (do (print "  [idempotence] regating changed ") (println p)
                      (set! ok false)))))))
        ok)))

  (fn norm-nodes ((arena Arena) (ax NormAxiom))
    (@intent "The concept-position nodes of a normal-form axiom")
    (@spec ((Arena NormAxiom) -> (List Node)))
    (@alloc arena)
    (let ((mut out (list-new arena Node)))
      (do
        (match ax
          ((sub-name a b)       (do (list-push out a) (list-push out b)))
          ((sub-and a b c)      (do (list-push out a) (list-push out b) (list-push out c)))
          ((sub-some-lhs r a b) (do (list-push out a) (list-push out b)))
          ((sub-some-rhs a r b) (do (list-push out a) (list-push out b)))
          ((sub-role r s)       (do))
          ((role-chain r s t)   (do)))
        out)))

  (fn fresh-ids-dense ((arena Arena) (no NormOutput))
    (@intent "Every fresh id is below fresh-count, and every id below it is used")
    (@spec ((Arena NormOutput) -> Bool))
    (@alloc arena)
    ;; Fresh nodes cannot COLLIDE with input names: `fresh-node` is its own
    ;; tag, compared tag-first. What can go wrong is the numbering — an id
    ;; past fresh-count addresses a context nobody initialized, and an
    ;; unused id below it means a symbol was minted and its definition lost.
    (let ((n (. no fresh-count))
          (mut seen (list-new arena Bool))
          (mut ok true)
          (mut i 0))
      (do
        (while (< i n) (do (list-push seen false) (set! i (+ i 1))))
        (for-each (ax (. no axioms))
          (for-each (nd (norm-nodes arena ax))
            (match nd
              ((fresh-node k)
                (do (when (< k n)  (list-set seen k true))
                    (when (>= k n) (set! ok false))))
              ((class-node _)      (do))
              ((individual-node _) (do)))))
        (for-each (b seen) (when (not b) (set! ok false)))
        ok)))

  (fn test-fresh-nodes-are-fresh ((arena Arena))
    (@intent "§12: fresh ids are bounded by fresh-count and dense below it")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (for-each (p (m0-fixture-paths arena))
          (match (normalize-fixture arena p)
            ((none) (set! ok false))
            ((some no)
              (when (not (fresh-ids-dense arena no))
                (do (print "  [freshness] ") (println p) (set! ok false))))))
        ok)))

  (fn reversed-triples ((arena Arena) (ts (List Triple)))
    (@intent "The same triples, last first")
    (@spec ((Arena (List Triple)) -> (List Triple)))
    (@alloc arena)
    (let ((mut out (list-new arena Triple))
          (mut k (- (cast Int (list-len ts)) 1)))
      (do
        (while (>= k 0)
          (do
            (match (list-get ts k)
              ((some t) (list-push out t))
              ((none)   (do)))
            (set! k (- k 1))))
        out)))

  (fn normalize-triples ((arena Arena) (ts (List Triple)))
    (@intent "The front end as far as normalization, over a triple list")
    (@spec ((Arena (List Triple)) -> (Option NormOutput)))
    (@alloc arena)
    (match (stage0-header arena ts (list-new arena IRI))
      ((error _) (none))
      ((ok s0)
        (match (decode-axioms arena (. s0 dict) (. s0 triples))
          ((error _) (none))
          ((ok s1)
            (some (normalize-accepted arena
                    (. (gate-axioms arena (. s1 axioms) (. s1 signature) (carried-of arena s0 s1) 'profile-el)
                       accepted))))))))

  (fn same-normal-form ((a NormOutput) (b NormOutput))
    (@intent "The same fresh-count, and the same normal-form axioms in the same order")
    (@spec ((NormOutput NormOutput) -> Bool))
    (@pure)
    (let ((mut ok (and (== (. a fresh-count) (. b fresh-count))
                       (== (list-len (. a axioms)) (list-len (. b axioms)))))
          (mut i 0)
          (n (cast Int (list-len (. a axioms)))))
      (do
        (while (and ok (< i n))
          (do
            (match (list-get (. a axioms) i)
              ((some x)
                (match (list-get (. b axioms) i)
                  ((some y) (when (not (norm-eq x y)) (set! ok false)))
                  ((none)   (set! ok false))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn same-report ((a Outcome) (b Outcome))
    (@intent "Identical subsumptions, unsatisfiable classes and omissions, in order")
    (@spec ((Outcome Outcome) -> Bool))
    (@pure)
    (let ((sa (. (. a findings) subsumptions))  (sb (. (. b findings) subsumptions))
          (ua (. (. a findings) unsatisfiable)) (ub (. (. b findings) unsatisfiable))
          (oa (. (. a coverage) omitted))       (ob (. (. b coverage) omitted))
          (mut ok true)
          (mut i 0))
      (do
        (when (or (!= (list-len sa) (list-len sb))
                  (!= (list-len ua) (list-len ub))
                  (!= (list-len oa) (list-len ob)))
          (set! ok false))
        (while (and ok (< i (cast Int (list-len sa))))
          (do
            (match (list-get sa i)
              ((some x)
                (match (list-get sb i)
                  ((some y) (when (!= (sub-pair-cmp x y) 0) (set! ok false)))
                  ((none)   (set! ok false))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        (set! i 0)
        (while (and ok (< i (cast Int (list-len ua))))
          (do
            (match (list-get ua i)
              ((some x)
                (match (list-get ub i)
                  ((some y) (when (!= (iri-cmp x y) 0) (set! ok false)))
                  ((none)   (set! ok false))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        (set! i 0)
        (while (and ok (< i (cast Int (list-len oa))))
          (do
            (match (list-get oa i)
              ((some x)
                (match (list-get ob i)
                  ((some y) (when (!= (omission-cmp x y) 0) (set! ok false)))
                  ((none)   (set! ok false))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn same-lines ((a (List String)) (b (List String)))
    (@intent "Two canonical reports, line for line and byte for byte")
    (@spec (((List String) (List String)) -> Bool))
    (@pure)
    ;; Shaped exactly like `same-report` — `ok` starts true and a length
    ;; mismatch clears it. Initialising `ok` from the length comparison
    ;; directly runs `slop verify`'s native parser out of arena (0.2.3).
    (let ((mut ok true)
          (mut i 0))
      (do
        (when (!= (list-len a) (list-len b))
          (set! ok false))
        (while (and ok (< i (cast Int (list-len a))))
          (do
            (match (list-get a i)
              ((some x)
                (match (list-get b i)
                  ((some y) (when (not (string-eq x y)) (set! ok false)))
                  ((none)   (set! ok false))))
              ((none) (set! ok false)))
            (set! i (+ i 1))))
        ok)))

  (fn encoded-agrees ((arena Arena) (path String) (selection ProfileSelection))
    (@intent "classify over the triples and classify-encoded over their encoding give the same report")
    (@spec ((Arena String ProfileSelection) -> Bool))
    (@alloc arena)
    (let ((mut cfg (default-config)))
      (do
        (set! cfg selection selection)
        (match (parse-ttl-file arena path)
          ((error _) false)
          ((ok g)
            (let ((doc (encode-triples arena (. g triples))))
              (match (classify arena (. g triples) (list-new arena IRI) cfg)
                ((error _) false)
                ((ok o1)
                  ;; Twice over the same encoding: classify-encoded only
                  ;; reads it, so a second run must see the same document.
                  (match (classify-encoded arena doc (list-new arena IRI) cfg)
                    ((error _) false)
                    ((ok o2)
                      (match (classify-encoded arena doc (list-new arena IRI) cfg)
                        ((error _) false)
                        ((ok o3)
                          (let ((l1 (report-lines arena o1)))
                            (if (and (same-lines l1 (report-lines arena o2))
                                     (same-lines l1 (report-lines arena o3)))
                              true
                              (do (print "  [encoded] report differs: ") (println path) false)))))))))))))))

  (fn test-classify-encoded-is-classify ((arena Arena))
    (@intent "The Rust crate's entry point reports exactly what classify does, on el and el++")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; classify-encoded is the crate's whole path (rust/csrc_shim.c). The
    ;; crate's own tests hold it to the CLI's goldens; this holds it to
    ;; `classify`, the port's entry point, without leaving SLOP.
    (let ((mut ok true)
          (el   (union-new ProfileSelection explicit 'profile-el))
          (elpp (union-new ProfileSelection explicit 'profile-el-plus-plus)))
      (do
        (for-each (p (m0-fixture-paths arena))
          (when (not (and (encoded-agrees arena p el) (encoded-agrees arena p elpp)))
            (set! ok false)))
        (when (not (encoded-agrees arena "corpus/fixtures/hazards/unattested-import.ttl" el))
          (set! ok false))
        ok)))

  (fn file-text ((arena Arena) (path String))
    (@intent "A file's whole text, or none")
    (@spec ((Arena String) -> (Option String)))
    (@alloc arena)
    (match (file-open path 'read)
      ((error _) (none))
      ((ok f)
        (let ((mut h f)
              (text (match (file-read-all arena (addr h)) ((ok t) (some t)) ((error _) (none)))))
          (do (file-close (addr h)) text)))))

  (fn api-lines ((arena Arena) (r Run))
    (@intent "A run's report lines, read through the public API's accessors")
    (@spec ((Arena Run) -> (List String)))
    (@alloc arena)
    (let ((mut out (list-new arena String))
          (mut i 0))
      (do
        (while (< i (run-report-len r))
          (do
            (list-push out (string-concat arena "" (run-report-line r i)))
            (set! i (+ i 1))))
        out)))

  (fn api-agrees ((arena Arena) (path String) (profile Profile))
    (@intent "The public API reports what classify does, for one fixture and profile")
    (@spec ((Arena String Profile) -> Bool))
    (@alloc arena)
    (match (file-text arena path)
      ((none) false)
      ((some text)
        (match (parse-ttl-file arena path)
          ((error _) false)
          ((ok g)
            (let ((mut cfg (default-config))
                  (mut o (default-options))
                  (in (input-new)))
              (do
                (set! cfg selection (union-new ProfileSelection explicit profile))
                (set! o profile profile)
                (input-add-turtle in text)
                (let ((r (run-classify in o))
                      (same (match (classify arena (. g triples) (list-new arena IRI) cfg)
                              ((error _) false)
                              ((ok want) (same-lines (report-lines arena want) (api-lines arena r))))))
                  (do
                    (run-free r)
                    (input-free in)
                    (when (not same) (do (print "  [api] report differs: ") (println path)))
                    same)))))))))

  (fn api-fault ((o Options))
    (@intent "What the public API reports for an empty input under o")
    (@spec ((Options) -> FaultKind))
    (let ((in (input-new))
          (r  (run-classify in o))
          (f  (run-fault r)))
      (do (run-free r) (input-free in) f)))

  (fn test-public-api ((arena Arena))
    (@intent "§8.4: the public C API reports what classify does, and refuses what it must")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The API is the `:c-name` section of howl.slop; slop generates
    ;; include/howl.h from it. examples/c/api_test.c drives it from C under
    ;; ASan and the crate's goldens hold it to every committed report; this
    ;; holds it to `classify` without leaving SLOP.
    (let ((mut ok true)
          (d (default-options)))
      (do
        (for-each (p (m0-fixture-paths arena))
          (when (not (and (api-agrees arena p 'profile-el) (api-agrees arena p 'profile-el-plus-plus)))
            (set! ok false)))
        ;; Out of range is refused by name, never narrowed into range.
        (let ((mut o d)) (do (set! o workers 0)
          (when (not (== (api-fault o) 'fault-invalid-options)) (set! ok false))))
        (let ((mut o d)) (do (set! o workers 65)
          (when (not (== (api-fault o) 'fault-invalid-options)) (set! ok false))))
        (let ((mut o d)) (do (set! o max-iterations 10001)
          (when (not (== (api-fault o) 'fault-invalid-options)) (set! ok false))))
        (let ((mut o d)) (do (set! o max-iterations -1)
          (when (not (== (api-fault o) 'fault-invalid-options)) (set! ok false))))
        ;; An unbuilt profile is refused, named, and never a pass.
        (let ((mut o d)
              (in (input-new)))
          (do
            (set! o profile 'profile-horn-sriq)
            (let ((r (run-classify in o)))
              (do
                (when (not (and (== (run-fault r) 'fault-unavailable)
                                (== (run-fault-profile r) 'profile-horn-sriq)
                                (string-eq (run-fault-message r)
                                           "profile horn-sriq was dropped; sriq covers its language")
                                (== (run-verdict r) 'verdict-inconclusive)
                                (not (run-ok r))))
                  (set! ok false))
                (run-free r)
                (input-free in)))))
        ;; The edges themselves run.
        (let ((mut o d)) (do (set! o workers 64) (set! o max-iterations 0)
          (when (not (== (api-fault o) 'fault-none)) (set! ok false))))
        ok)))

  ;; ------------------------------------------------------------
  ;; PROBE QUERIES (§8.5 A4, issue #68), through the public API.
  ;;
  ;; The answers are checked against the MAIN run's report, read the way
  ;; the differential reads it (report-entails), not against the code that
  ;; computes them: on every ordered pair of the report's classes, and
  ;; every class's unsatisfiability, a probe run that adds nothing answers
  ;; yes exactly where the report entails the inclusion, no where it does
  ;; not and the run was complete, and unknown otherwise. The main report's
  ;; lines are those of a run without probes, and the probe lines follow.
  ;; ------------------------------------------------------------

  (fn classify-in ((arena Arena) (path String) (profile Profile))
    (@intent "A fixture classified by the engine under one profile")
    (@spec ((Arena String Profile) -> (Option Outcome)))
    (@alloc arena)
    (let ((mut cfg (default-config)))
      (do
        (set! cfg selection (union-new ProfileSelection explicit profile))
        (match (parse-ttl-file arena path)
          ((error _) (none))
          ((ok g)
            (match (classify arena (. g triples) (list-new arena IRI) cfg)
              ((ok o)    (some o))
              ((error _) (none))))))))

  (fn report-classes ((arena Arena) (f Findings))
    (@intent "owl:Thing and every named class the report mentions, owl:Nothing aside, each once, in order")
    (@spec ((Arena Findings) -> (List IRI)))
    (@alloc arena)
    ;; owl:Thing always: an inconsistent run's lists are empty, and its
    ;; probe run must still be asked something.
    (let ((mut xs (list-new arena IRI)))
      (do
        (list-push xs (record-new IRI (value "http://www.w3.org/2002/07/owl#Thing")))
        (for-each (c (. f unsatisfiable)) (list-push xs c))
        (for-each (p (. f subsumptions))
          (do
            (match (. p sub)   ((class-node i) (list-push xs i)) (_ (do)))
            (match (. p super) ((class-node i) (list-push xs i)) (_ (do)))))
        (unique-classes arena (sort-iris arena xs)))))

  (fn unique-classes ((arena Arena) (sorted (List IRI)))
    (@intent "A sorted list's distinct IRIs, owl:Nothing dropped")
    (@spec ((Arena (List IRI)) -> (List IRI)))
    (@alloc arena)
    (let ((mut out (list-new arena IRI)))
      (do
        (for-each (i sorted)
          (let ((n (cast Int (list-len out))))
            (when (and (not (string-eq (. i value) "http://www.w3.org/2002/07/owl#Nothing"))
                       (or (== n 0) (!= (iri-cmp (iri-at out (- n 1)) i) 0)))
              (list-push out i))))
        out)))

  (fn expected-answer ((o Outcome) (a String) (b String))
    (@intent "What the main report says about A ⊑ B, as a probe answer")
    (@spec ((Outcome String String) -> ProbeAnswer))
    (if (report-entails (. o findings) (cls a) (cls b))
      'answer-yes
      (if (outcome-is-complete o) 'answer-no 'answer-unknown)))

  (fn probe-answer-is ((r Run) (i Int) (kind QueryKind) (a String) (b String) (want ProbeAnswer))
    (@intent "Is the run's i-th answer this query, answered this way?")
    (@spec ((Run Int QueryKind String String ProbeAnswer) -> Bool))
    (and (== (run-probe-kind r i) kind)
         (string-eq (run-probe-sub r i) a)
         (string-eq (run-probe-sup r i) b)
         (== (run-probe-answer r i) want)))

  (fn answers-agree ((r Run) (o Outcome) (cs (List IRI)))
    (@intent "Every unsatisfiability query, then every pair, in canonical order, each as the report says")
    (@spec ((Run Outcome (List IRI)) -> Bool))
    (let ((n (cast Int (list-len cs)))
          (mut ok (== (run-probe-len r) (+ n (* n n))))
          (mut i 0))
      (do
        (for-each (a cs)
          (do
            (when (not (probe-answer-is r i 'query-unsatisfiable (. a value) ""
                         (expected-answer o (. a value) "http://www.w3.org/2002/07/owl#Nothing")))
              (set! ok false))
            (set! i (+ i 1))))
        (for-each (a cs)
          (for-each (b cs)
            (do
              (when (not (probe-answer-is r i 'query-subsumed (. a value) (. b value)
                           (expected-answer o (. a value) (. b value))))
                (set! ok false))
              (set! i (+ i 1)))))
        ok)))

  (fn main-lines-unchanged ((arena Arena) (r Run) (want (List String)))
    (@intent "The run's lines are the main report's, then the probe lines")
    (@spec ((Arena Run (List String)) -> Bool))
    (@alloc arena)
    (let ((got (api-lines arena r))
          (n   (cast Int (list-len want)))
          (mut ok (> (cast Int (list-len got)) n))
          (mut i 0))
      (do
        (while (and ok (< i n))
          (do
            (when (not (string-eq (str-at got i) (str-at want i))) (set! ok false))
            (set! i (+ i 1))))
        (and ok (starts-with (str-at got n) "probes ")))))

  (fn probes-agree-with-report ((arena Arena) (path String) (profile Profile))
    (@intent "Probe answers equal the main report's on every class pair, and leave its lines alone")
    (@spec ((Arena String Profile) -> Bool))
    (@alloc arena)
    (match (file-text arena path)
      ((none) false)
      ((some text)
        (match (classify-in arena path profile)
          ((none)   false)
          ((some o) (probes-agree-on arena text o path profile))))))

  (fn probes-agree-on ((arena Arena) (text String) (o Outcome) (path String) (profile Profile))
    (@intent "Ask every pair of o's classes through the API, and hold the answers to o's report")
    (@spec ((Arena String Outcome String Profile) -> Bool))
    (@alloc arena)
    (let ((cs (report-classes arena (. o findings)))
          (in (input-new))
          (mut opts (default-options)))
      (do
        (set! opts profile profile)
        (input-add-turtle in text)
        (ask-every-pair in (reversed-iris arena cs) cs)
        (let ((r  (run-classify in opts))
              (ok (and (run-ok r)
                       (answers-agree r o cs)
                       (main-lines-unchanged arena r (report-lines arena o))
                       (== (run-probe-inconsistent r) (. (. o findings) inconsistent)))))
          (do
            (run-free r)
            (input-free in)
            (when (not ok)
              (do (print "  [probe] disagrees with the report: ") (print (profile-name profile))
                  (print " ") (println path)))
            ok)))))

  (fn ask-every-pair ((in Input) (subs (List IRI)) (cs (List IRI)))
    (@intent "Ask each sub's unsatisfiability, twice, and its subsumption under every class")
    (@spec ((Input (List IRI) (List IRI)) -> Unit))
    ;; Asked out of order, and twice: the answers come back in canonical
    ;; order, each once.
    (for-each (k subs)
      (do
        (input-ask-unsatisfiable in (. k value))
        (input-ask-unsatisfiable in (. k value))
        (for-each (b cs) (input-ask-subsumed in (. k value) (. b value))))))

  (fn reversed-iris ((arena Arena) (xs (List IRI)))
    (@intent "The list backwards")
    (@spec ((Arena (List IRI)) -> (List IRI)))
    (@alloc arena)
    (let ((mut out (list-new arena IRI))
          (mut i (- (cast Int (list-len xs)) 1)))
      (do
        (while (>= i 0)
          (do (list-push out (iri-at xs i)) (set! i (- i 1))))
        out)))

  (fn test-probes-agree-with-report ((arena Arena))
    (@intent "§8.5 A4: probe answers equal the main report's, under el and el++")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The fixtures entails-sub is held to (test-entails-sub-agrees-with-
    ;; report), for the same corners, under both profiles; and the el++
    ;; fixtures under el++, where nothing held ksc-entails-sub to the
    ;; report before.
    (let ((mut ok true)
          (paths (list String
                   "corpus/fixtures/v0/litmus.ttl"
                   "corpus/fixtures/v0/top-bottom.ttl"
                   "corpus/fixtures/hazards/unsatisfiable-consistent.ttl"
                   "corpus/fixtures/hazards/inconsistent-via-individual.ttl"
                   "corpus/fixtures/hazards/abox-disjoint-range.ttl"
                   "corpus/fixtures/hazards/cyclic-hierarchy.ttl"
                   "corpus/fixtures/hazards/punning.ttl"
                   "corpus/fixtures/hazards/owl-nothing-present.ttl"
                   "corpus/fixtures/hazards/declared-unused-class.ttl"
                   "corpus/fixtures/hazards/undeclared-property.ttl"
                   "corpus/fixtures/probes/some-unsat-filler.ttl"
                   "corpus/fixtures/probes/top-subsumes-everything.ttl"))
          (mut i 0))
      (do
        (for-each (p paths)
          (when (not (and (probes-agree-with-report arena p 'profile-el)
                          (probes-agree-with-report arena p 'profile-el-plus-plus)))
            (set! ok false)))
        (while (< i (ksc-fixture-count))
          (do
            (when (not (probes-agree-with-report arena (ksc-fixture-at i) 'profile-el-plus-plus))
              (set! ok false))
            (set! i (+ i 1))))
        ok)))

  ;; The answer run (howl_run_answer): the probe run alone. Constraint
  ;; 499c3842: wherever both modes answer, they agree. Here they always
  ;; answer the same, since it is the same probe run without the main run.

  (fn test-answer-equals-two-run ((arena Arena))
    (@intent "§8.4: the answer run keeps every yes and no of the two-run mode, on every class pair, under el, el++ and sriq")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (paths (list String
                   "corpus/fixtures/v0/litmus.ttl"
                   "corpus/fixtures/v0/top-bottom.ttl"
                   "corpus/fixtures/hazards/unsatisfiable-consistent.ttl"
                   "corpus/fixtures/hazards/inconsistent-via-individual.ttl"
                   "corpus/fixtures/hazards/abox-disjoint-range.ttl"
                   "corpus/fixtures/hazards/cyclic-hierarchy.ttl"
                   "corpus/fixtures/hazards/punning.ttl"
                   "corpus/fixtures/hazards/owl-nothing-present.ttl"
                   "corpus/fixtures/hazards/declared-unused-class.ttl"
                   "corpus/fixtures/hazards/undeclared-property.ttl"
                   "corpus/fixtures/probes/some-unsat-filler.ttl"
                   "corpus/fixtures/probes/top-subsumes-everything.ttl"))
          (mut i 0)
          (mut last ""))
      (do
        (for-each (p paths)
          (when (not (and (answer-equals-two-run arena p 'profile-el)
                          (answer-equals-two-run arena p 'profile-el-plus-plus)
                          (answer-equals-two-run arena p 'profile-sriq)))
            (set! ok false)))
        (while (< i (ksc-fixture-count))
          (do
            (when (not (answer-equals-two-run arena (ksc-fixture-at i) 'profile-el-plus-plus))
              (set! ok false))
            (set! i (+ i 1))))
        (for-each (e (expects arena))
          (when (not (string-eq (. e file) last))
            (do (when (not (answer-equals-two-run arena (fixture-path arena (. e file)) 'profile-sriq))
                  (set! ok false))
                (set! last (. e file)))))
        ok)))

  (fn answer-equals-two-run ((arena Arena) (path String) (profile Profile))
    (@intent "Ask every class pair of a fixture; does the answer run answer as the two-run mode does?")
    (@spec ((Arena String Profile) -> Bool))
    (@alloc arena)
    (match (file-text arena path)
      ((none) false)
      ((some text)
        (match (classify-in arena path profile)
          ((none)   true)   ; not classifiable under this profile: nothing to compare
          ((some o) (answer-equals-on arena text (report-classes arena (. o findings)) path profile))))))

  (fn answer-equals-on ((arena Arena) (text String) (cs (List IRI)) (path String) (profile Profile))
    (@intent "One input with every pair asked, run both ways: the same answers, and the answer run's shape")
    (@spec ((Arena String (List IRI) String Profile) -> Bool))
    (@alloc arena)
    (let ((in (input-new))
          (mut opts (default-options)))
      (do
        (set! opts profile profile)
        (input-add-turtle in text)
        (ask-every-pair in (reversed-iris arena cs) cs)
        (let ((r  (run-classify in opts))
              (a  (run-answer in opts))
              (ok (and (run-ok r) (run-ok a)
                       (answer-run-agrees r a)
                       (answer-run-shape arena a))))
          (do
            (run-free r) (run-free a) (input-free in)
            (when (not ok)
              (do (print "  [answer] differs from the two-run mode: ") (print (profile-name profile))
                  (print " ") (println path)))
            ok)))))

  (fn answer-run-shape ((arena Arena) (a Run))
    (@intent "An answer run has no outcome (no findings, verdict inconclusive) and its lines are `profile P` then its probe lines")
    (@spec ((Arena Run) -> Bool))
    (@alloc arena)
    (let ((ls (api-lines arena a)))
      (and (== (run-sub-len a) 0) (== (run-unsat-len a) 0) (== (run-omission-len a) 0)
           (== (run-verdict a) 'verdict-inconclusive) (== (run-rounds a) 0)
           (== (cast Int (list-len ls)) (+ 4 (+ (run-probe-len a) (run-probe-omission-len a))))
           (match (list-get ls 0)
             ((some l) (string-eq l (string-concat arena "profile " (profile-name (run-profile a)))))
             ((none)   false))
           (match (list-get ls 1)
             ((some l) (string-eq l (string-concat arena "probes " (int-to-string arena (run-probe-len a)))))
             ((none)   false)))))

  (fn answer-run-agrees ((r Run) (a Run))
    (@intent "The same queries in the same order; every yes and no of r's kept in a (Constraint 499c3842); an unknown in r may be anything in a")
    (@spec ((Run Run) -> Bool))
    (let ((mut ok (== (run-probe-len r) (run-probe-len a)))
          (mut i 0))
      (do
        (while (and ok (< i (run-probe-len r)))
          (do
            (when (not (and (== (run-probe-kind r i) (run-probe-kind a i))
                            (string-eq (run-probe-sub r i) (run-probe-sub a i))
                            (string-eq (run-probe-sup r i) (run-probe-sup a i))
                            (or (== (run-probe-answer r i) 'answer-unknown)
                                (== (run-probe-answer r i) (run-probe-answer a i)))))
              (set! ok false))
            (set! i (+ i 1))))
        ok)))

  (fn lines-text ((arena Arena) (r Run))
    (@intent "The run's lines, one per line")
    (@spec ((Arena Run) -> String))
    (@alloc arena)
    (let ((mut out ""))
      (do (for-each (l (api-lines arena r)) (set! out (string-concat arena out (string-concat arena l "\n"))))
          out)))

  (fn test-answer-run-edges ((arena Arena))
    (@intent "§8.4: an answer run that asks nothing runs nothing; a refused input or bad options are faults, as howl_run_classify's")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((empty (input-new))
          (bad   (input-new))
          (good  (input-new))
          (mut o (default-options)))
      (do
        (input-add-turtle empty (string-concat arena (probe-prefixes) (scenario-main)))
        (input-add-turtle bad (string-concat arena (probe-prefixes) (scenario-main)))
        (input-ask-unsatisfiable bad "")
        (input-add-turtle good (string-concat arena (probe-prefixes) (scenario-main)))
        (input-ask-unsatisfiable good "http://example.org/t#D")
        (let ((r0 (run-answer empty o))
              (rb (run-answer bad o))
              (ok1 (and (run-ok r0) (== (run-probe-len r0) 0)
                        (string-eq (lines-text arena r0) "probes 0\nprobe-inconsistent false\nprobe-omitted 0\n")
                        (not (run-ok rb)) (== (run-fault rb) 'fault-input-error))))
          (do
            (set! o max-iterations -1)
            (let ((ro (run-answer good o))
                  (ok2 (and (not (run-ok ro)) (== (run-fault ro) 'fault-invalid-options))))
              (do
                (run-free r0) (run-free rb) (run-free ro)
                (input-free empty) (input-free bad) (input-free good)
                (when (not ok1) (println "  [answer] an empty or refused input is not handled as classify handles it"))
                (when (not ok2) (println "  [answer] bad options are not refused"))
                (and ok1 ok2))))))))

  (fn du-run ((arena Arena) (text String))
    (@intent "An inline document classified under sriq through the public API")
    (@spec ((Arena String) -> Run))
    (@alloc arena)
    (let ((in (input-new))
          (mut o (default-options)))
      (do
        (set! o profile 'profile-sriq)
        (input-add-turtle in (string-concat arena (probe-prefixes) text))
        (let ((r (run-classify in o)))
          (do (input-free in) r)))))

  (fn test-disjoint-union-builtin-head ((arena Arena))
    (@intent "§5.5 S0: DisjointUnion(owl:Thing, P, Q) with P and Q empty is inconsistent; DisjointUnion(owl:Nothing, P, Q) makes P and Q unsatisfiable")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; owl:Thing as DisjointUnion's head reached the clause boundary as a
    ;; plain name, which has no id for it: a valid ontology faulted.
    (let ((thing   (du-run arena ":P a owl:Class . :Q a owl:Class . :P rdfs:subClassOf owl:Nothing . :Q rdfs:subClassOf owl:Nothing . owl:Thing owl:disjointUnionOf ( :P :Q ) .\n"))
          (nothing (du-run arena ":P a owl:Class . :Q a owl:Class . owl:Nothing owl:disjointUnionOf ( :P :Q ) .\n")))
      (let ((ok (and (run-ok thing) (run-inconsistent thing)
                     (run-ok nothing) (not (run-inconsistent nothing))
                     (== (run-unsat-len nothing) 2) (string-eq (run-unsat nothing 0) "http://example.org/t#P")
                     (string-eq (run-unsat nothing 1) "http://example.org/t#Q"))))
        (do
          (when (not ok)
            (do (print "  [du] owl:Thing head ok/inconsistent: ") (print (run-ok thing)) (print " ")
                (println (run-inconsistent thing))))
          (run-free thing) (run-free nothing)
          ok))))

  ;; The scenarios: a host's own probe documents.

  (fn probe-prefixes ()
    (@intent "The prefixes the probe scenarios share")
    (@spec (() -> String))
    (@pure)
    "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n")

  (fn probe-tail ((arena Arena) (r Run))
    (@intent "The run's probe lines, from `probes` on, one per line")
    (@spec ((Arena Run) -> String))
    (@alloc arena)
    (let ((mut out "")
          (mut on false))
      (do
        (for-each (l (api-lines arena r))
          (do
            (when (starts-with l "probes ") (set! on true))
            (when on (set! out (string-concat arena out (string-concat arena l "\n"))))))
        out)))

  (fn tail-is ((arena Arena) (label String) (r Run) (want String))
    (@intent "Are the run's probe lines exactly these? Prints what they were when not")
    (@spec ((Arena String Run String) -> Bool))
    (@alloc arena)
    (let ((got (probe-tail arena r)))
      (if (string-eq got want)
        true
        (do (print "  [probe] ") (print label) (println ": got") (print got) false))))

  (fn scenario-main ()
    (@intent "The main document of the probe scenarios: p must be empty, q need not be")
    (@spec (() -> String))
    (@pure)
    ":p a owl:ObjectProperty . :q a owl:ObjectProperty . :r a owl:ObjectProperty .\n:A a owl:Class . :B a owl:Class . :C a owl:Class . :D a owl:Class . :E a owl:Class .\n:D rdfs:subClassOf owl:Nothing . :p rdfs:domain :D .\n:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] .\n:B rdfs:subClassOf :C .\n")

  (fn scenario-probes ()
    (@intent "The probe document of the scenarios: issue #68's probe, and two complex classes")
    (@spec (() -> String))
    (@pure)
    "<urn:probe:p> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :p ; owl:someValuesFrom owl:Thing ] .\n<urn:probe:q> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :q ; owl:someValuesFrom owl:Thing ] .\n<urn:probe:rc> owl:equivalentClass [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :C ] .\n<urn:probe:re> owl:equivalentClass [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :E ] .\n")

  (fn scenario-input ((arena Arena) (extra String))
    (@intent "The scenario input, its probe document plus `extra`, and its queries")
    (@spec ((Arena String) -> Input))
    (@alloc arena)
    (let ((in (input-new)))
      (do
        (input-add-turtle in (string-concat arena (probe-prefixes) (scenario-main)))
        (input-add-probe-turtle in (string-concat arena (probe-prefixes)
                                     (string-concat arena (scenario-probes) extra)))
        (input-ask-unsatisfiable in "urn:probe:q")
        (input-ask-unsatisfiable in "urn:probe:p")
        (input-ask-subsumed in "http://example.org/t#A" "urn:probe:re")
        (input-ask-subsumed in "http://example.org/t#A" "urn:probe:rc")
        (input-ask-subsumed in "http://example.org/t#A" "urn:probe:rc")
        (input-ask-subsumed in "http://example.org/t#A" "http://example.org/t#A")
        ;; owl:Nothing is under everything and unsatisfiable in every
        ;; ontology, with or without a context of its own.
        (input-ask-subsumed in "http://www.w3.org/2002/07/owl#Nothing" "urn:probe:re")
        (input-ask-unsatisfiable in "http://www.w3.org/2002/07/owl#Nothing")
        in)))

  (fn scenario-tail ((arena Arena) (label String) (extra String) (profile Profile) (cap Int) (want String))
    (@intent "Run the scenario; are its probe lines these, and its main lines a run without probes'?")
    (@spec ((Arena String String Profile Int String) -> Bool))
    (@alloc arena)
    (let ((in    (scenario-input arena extra))
          (plain (input-new))
          (mut o (default-options)))
      (do
        (set! o profile profile)
        (set! o max-iterations cap)
        (input-add-turtle plain (string-concat arena (probe-prefixes) (scenario-main)))
        (let ((r  (run-classify in o))
              (r0 (run-classify plain o))
              (a  (run-answer in o))
              (ok (and (run-ok r)
                       (tail-is arena label r want)
                       (main-lines-unchanged arena r (api-lines arena r0))
                       (== (run-verdict r) (run-verdict r0))
                       ;; the answer run keeps every yes and no the two-run mode gives
                       (run-ok a) (answer-run-agrees r a) (answer-run-shape arena a))))
          (do
            (run-free r) (run-free r0) (run-free a) (input-free in) (input-free plain)
            ok)))))

  (fn test-probe-scenarios ((arena Arena))
    (@intent "§8.5 A4: issue #68's probe, a complex subsumption, and each way an answer is unknown")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The answers: urn:probe:p is unsatisfiable because p's domain is
    ;; empty (issue #68's case) and urn:probe:q is not; A ⊑ ∃r.C through
    ;; A ⊑ ∃r.B and B ⊑ C, and not A ⊑ ∃r.E. The main report has D
    ;; unsatisfiable and nothing of the probes'. Both documents name a
    ;; blank node first, so this also holds that the probe document's are
    ;; kept apart from the input's.
    (let ((answers (string-concat arena
                     "probe unsatisfiable http://www.w3.org/2002/07/owl#Nothing yes\nprobe unsatisfiable urn:probe:p yes\nprobe unsatisfiable urn:probe:q no\n"
                     "probe subsumed http://example.org/t#A http://example.org/t#A yes\nprobe subsumed http://example.org/t#A urn:probe:rc yes\nprobe subsumed http://example.org/t#A urn:probe:re no\nprobe subsumed http://www.w3.org/2002/07/owl#Nothing urn:probe:re yes\n")))
      (and
        (scenario-tail arena "el" "" 'profile-el 1000
          (string-concat arena "probes 7\nprobe-inconsistent false\nprobe-omitted 0\n" answers))
        (scenario-tail arena "el++" "" 'profile-el-plus-plus 1000
          (string-concat arena "probes 7\nprobe-inconsistent false\nprobe-omitted 0\n" answers))
        ;; An omission in the probe run turns every no into unknown, and
        ;; leaves every yes standing.
        (scenario-tail arena "probe omission"
          "<urn:probe:u> rdfs:subClassOf [ owl:unionOf ( :B :C ) ] .\n" 'profile-el 1000
          (string-concat arena "probes 7\nprobe-inconsistent false\nprobe-omitted 1\n"
            (string-concat arena "probe-omission SubClassOf(urn:probe:u ObjectUnionOf(http://example.org/t#B http://example.org/t#C))\n"
              "probe unsatisfiable http://www.w3.org/2002/07/owl#Nothing yes\nprobe unsatisfiable urn:probe:p yes\nprobe unsatisfiable urn:probe:q unknown\nprobe subsumed http://example.org/t#A http://example.org/t#A yes\nprobe subsumed http://example.org/t#A urn:probe:rc yes\nprobe subsumed http://example.org/t#A urn:probe:re unknown\nprobe subsumed http://www.w3.org/2002/07/owl#Nothing urn:probe:re yes\n")))
        ;; So does the round cap; at 0 rounds only what holds in every
        ;; ontology is yes.
        (scenario-tail arena "cap 0" "" 'profile-el 0
          (string-concat arena "probes 7\nprobe-inconsistent false\nprobe-omitted 0\n"
            "probe unsatisfiable http://www.w3.org/2002/07/owl#Nothing yes\nprobe unsatisfiable urn:probe:p unknown\nprobe unsatisfiable urn:probe:q unknown\nprobe subsumed http://example.org/t#A http://example.org/t#A yes\nprobe subsumed http://example.org/t#A urn:probe:rc unknown\nprobe subsumed http://example.org/t#A urn:probe:re unknown\nprobe subsumed http://www.w3.org/2002/07/owl#Nothing urn:probe:re yes\n"))
        ;; el++ capped before W completes keeps no answers at all.
        (scenario-tail arena "cap 0, el++" "" 'profile-el-plus-plus 0
          (string-concat arena "probes 7\nprobe-inconsistent false\nprobe-omitted 0\n"
            "probe unsatisfiable http://www.w3.org/2002/07/owl#Nothing yes\nprobe unsatisfiable urn:probe:p unknown\nprobe unsatisfiable urn:probe:q unknown\nprobe subsumed http://example.org/t#A http://example.org/t#A yes\nprobe subsumed http://example.org/t#A urn:probe:rc unknown\nprobe subsumed http://example.org/t#A urn:probe:re unknown\nprobe subsumed http://www.w3.org/2002/07/owl#Nothing urn:probe:re yes\n"))
        ;; An inconsistent probe run entails everything, and says so; the
        ;; main run never sees the assertion that made it so.
        (scenario-tail arena "inconsistent" ":x a owl:NamedIndividual , owl:Nothing .\n" 'profile-el 1000
          (string-concat arena "probes 7\nprobe-inconsistent true\nprobe-omitted 0\n"
            "probe unsatisfiable http://www.w3.org/2002/07/owl#Nothing yes\nprobe unsatisfiable urn:probe:p yes\nprobe unsatisfiable urn:probe:q yes\nprobe subsumed http://example.org/t#A http://example.org/t#A yes\nprobe subsumed http://example.org/t#A urn:probe:rc yes\nprobe subsumed http://example.org/t#A urn:probe:re yes\nprobe subsumed http://www.w3.org/2002/07/owl#Nothing urn:probe:re yes\n")))))

  (fn test-probe-refusals ((arena Arena))
    (@intent "An empty query IRI, an unparseable probe document, or a probe run's fault fails the run")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The third: a probe document HOWL parses but cannot decode faults the
    ;; probe run after the main run has finished, and takes the run with
    ;; it, named as the probe run's.
    (let ((a (input-new))
          (b (input-new))
          (c (input-new)))
      (do
        (input-ask-subsumed a "http://example.org/t#A" "")
        (input-add-probe-turtle b "<urn:x> <urn:y> .")
        (input-add-probe-turtle c (string-concat arena (probe-prefixes)
                                    "<urn:p> a owl:ObjectProperty , owl:AnnotationProperty ."))
        (input-ask-unsatisfiable c "urn:P")
        (let ((ra (run-classify a (default-options)))
              (rb (run-classify b (default-options)))
              (rc (run-classify c (default-options)))
              (ok (and (== (run-fault ra) 'fault-input-error)
                       (string-eq (run-fault-message ra) "a probe query names an empty IRI")
                       (== (run-fault rb) 'fault-input-error)
                       (starts-with (run-fault-message rb) "a Turtle document does not parse")
                       (== (run-fault rc) 'fault-input-error)
                       (starts-with (run-fault-message rc) "probe run: IRI declared under two disjoint")
                       (not (run-ok rc))
                       (== (run-report-len rc) 0)
                       (== (run-probe-len rc) 0))))
          (do
            (run-free ra) (run-free rb) (run-free rc)
            (input-free a) (input-free b) (input-free c)
            ok)))))

  (fn order-independent ((arena Arena) (path String))
    (@intent "The same document with its triples reversed: identical normal form and report")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) false)
      ((ok g)
        (let ((fwd (. g triples))
              (rev (reversed-triples arena (. g triples))))
          (match (normalize-triples arena fwd)
            ((none) false)
            ((some n1)
              (match (normalize-triples arena rev)
                ((none) false)
                ((some n2)
                  (if (not (same-normal-form n1 n2))
                    (do (print "  [order] normal form differs: ") (println path) false)
                    (match (classify arena fwd (list-new arena IRI) (default-config))
                      ((error _) false)
                      ((ok o1)
                        (match (classify arena rev (list-new arena IRI) (default-config))
                          ((error _) false)
                          ((ok o2)
                            ;; The structural comparison names WHICH list
                            ;; differs; the rendered one is the bytes the
                            ;; consumer hashes, rounds included.
                            (if (and (same-report o1 o2)
                                     (same-lines (report-lines arena o1) (report-lines arena o2)))
                              true
                              (do (print "  [order] report differs: ") (println path) false)))))))))))))))

  (fn test-triple-order-independence ((arena Arena))
    (@intent "§6.8: reversing a document's triples changes neither the normal form nor the report")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The consumer content-hashes the report. Serialization order is not
    ;; content, so two writings of one ontology must hash alike — fresh-node
    ;; ids included, since they are assigned by first occurrence and would
    ;; follow triple order the moment the canonical ordering slipped.
    (let ((mut ok true)
          (mut ps (list-new arena String)))
      (do
        (list-push ps "corpus/fixtures/v0/litmus.ttl")
        (list-push ps "corpus/fixtures/hazards/range-complex-fillers.ttl")
        (list-push ps "corpus/fixtures/hazards/abox-disjoint-range.ttl")
        (list-push ps "corpus/fixtures/hazards/rbox-regularity-reject.ttl")
        (list-push ps "corpus/fixtures/hazards/annotation-heavy.ttl")
        (list-push ps "corpus/fixtures/out-of-profile/inverse-expressions.ttl")
        (for-each (p ps) (when (not (order-independent arena p)) (set! ok false)))
        ok)))

  ;; ------------------------------------------------------------
  ;; The premise index against the full scan (M1 slice 1). The indexed
  ;; dispatcher offers each rule only the axioms whose premise matches
  ;; the incoming fact's key; the reference offers every axiom. They must
  ;; conclude the same things for EVERY fact in EVERY context — so each
  ;; fixture is saturated, and every stored fact of the final store (the
  ;; richest snapshot, where every rule has the most premises to join) is
  ;; replayed through both. A missing bucket, a key filed under the wrong
  ;; position, or CR2 filed under only one conjunct each show up as a
  ;; conclusion one side has and the other lacks.
  ;; ------------------------------------------------------------

  (fn addressed-subset ((xs (List Addressed)) (ys (List Addressed)))
    (@intent "Every message in xs also appears in ys")
    (@spec (((List Addressed) (List Addressed)) -> Bool))
    (@pure)
    (let ((mut ok true))
      (do
        (for-each (x xs)
          (let ((mut found false))
            (do
              (for-each (y ys) (when (addressed-eq x y) (set! found true)))
              (when (not found) (set! ok false)))))
        ok)))

  (fn same-conclusions ((arena Arena) (ctx Context) (d Derived) (idx RuleIndex) (axioms (List NormAxiom)))
    (@intent "The indexed and reference dispatchers conclude the same set for one fact")
    (@spec ((Arena Context Derived RuleIndex (List NormAxiom)) -> Bool))
    (@alloc arena)
    (let ((xs (apply-el-rules arena ctx d idx))
          (ys (apply-el-rules-reference arena ctx d axioms)))
      (if (addressed-subset xs ys) (addressed-subset ys xs) false)))

  (fn dispatch-agrees ((arena Arena) (path String))
    (@intent "On one fixture, both dispatchers agree on every stored fact")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) false)
      ((ok g)
        (match (prepare arena (. g triples) (list-new arena IRI) (default-config))
          ((error _) false)
          ((ok p)
            (let ((idx (. (prepared-el-work arena p) index))
                  (axioms (. (prepared-el-work arena p) axioms)))
              (match (reason arena p (default-config))
                ((error _) false)
                ((ok o)
                  (let ((mut ok true)
                        (mut facts 0))
                    (do
                      (for-each ((n ctx) (. (outcome-saturation arena o) contexts))
                        (do
                          (for-each (b (. ctx subsumers))
                            (do
                              (set! facts (+ facts 1))
                              (when (not (same-conclusions arena ctx
                                           (union-new Derived derived-sub b) idx axioms))
                                (set! ok false))))
                          (for-each ((r ys) (. ctx succs))
                            (for-each (y ys)
                              (when (not (same-conclusions arena ctx
                                           (union-new Derived derived-succ r y) idx axioms))
                                (set! ok false))))
                          (for-each ((r xs) (. ctx preds))
                            (for-each (x xs)
                              (when (not (same-conclusions arena ctx
                                           (union-new Derived derived-pred r x) idx axioms))
                                (set! ok false))))))
                      (when (not ok) (do (print "  [dispatch] indexed != reference: ") (println path)))
                      ;; A fixture that replayed nothing proves nothing.
                      (if (> facts 0) ok false)))))))))))

  (fn test-indexed-dispatch-matches-reference ((arena Arena))
    (@intent "The premise index offers each rule exactly the axioms it could fire on")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (mut ps (list-new arena String)))
      (do
        (list-push ps "corpus/fixtures/v0/litmus.ttl")
        (list-push ps "corpus/fixtures/v0/intersection.ttl")
        (list-push ps "corpus/fixtures/v0/exists-lhs.ttl")
        (list-push ps "corpus/fixtures/v0/exists-rhs.ttl")
        (list-push ps "corpus/fixtures/v0/domain.ttl")
        (list-push ps "corpus/fixtures/v0/range.ttl")
        (list-push ps "corpus/fixtures/v0/subproperty.ttl")
        (list-push ps "corpus/fixtures/v0/equivalent-properties.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain.ttl")
        (list-push ps "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push ps "corpus/fixtures/v0/disjoint-nary.ttl")
        (list-push ps "corpus/fixtures/v0/abox-assertions.ttl")
        (list-push ps "corpus/fixtures/v0/top-bottom.ttl")
        (list-push ps "corpus/fixtures/hazards/abox-disjoint-range.ttl")
        (list-push ps "corpus/fixtures/hazards/range-complex-fillers.ttl")
        (list-push ps "corpus/fixtures/hazards/rbox-regularity-accept.ttl")
        (list-push ps "corpus/fixtures/hazards/unsatisfiable-consistent.ttl")
        (list-push ps "corpus/fixtures/hazards/cyclic-hierarchy.ttl")
        (list-push ps "corpus/fixtures/hazards/smaller-side-join.ttl")
        ;; The fixtures where the role closure carries an edge:
        ;; subproperty.ttl and equivalent-properties.ttl declare the
        ;; hierarchy with nothing for it to act on.
        (list-push ps "corpus/fixtures/probes/subproperty-existential.ttl")
        (list-push ps "corpus/fixtures/hazards/role-hierarchy-deep.ttl")
        (for-each (p ps) (when (not (dispatch-agrees arena p)) (set! ok false)))
        ok)))

  ;; ------------------------------------------------------------
  ;; Stage 0 filters header subjects through a SET (GO reifies 131,783
  ;; axioms, and a list scan per triple never finished). A set compares a
  ;; quoted triple by POINTER while `term-eq` compares it structurally, so
  ;; the encoding gives structurally equal quoted triples one id. The case
  ;; is built directly, two separately allocated, structurally equal
  ;; quoted triples, one typed owl:Ontology - Turtle's `<<( )>>` reaches
  ;; it too. Both triples are header material, and stage 0 must consume
  ;; both.
  ;; ------------------------------------------------------------

  (fn test-quoted-triple-header-subjects ((arena Arena))
    (@intent "Stage 0 consumes every triple of a quoted-triple header node, compared structurally")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((s    (make-iri arena "http://example.org/t#s"))
          (p    (make-iri arena "http://example.org/t#p"))
          (o    (make-iri arena "http://example.org/t#o"))
          (q1   (make-triple-term arena (make-triple arena s p o)))
          (q2   (make-triple-term arena (make-triple arena s p o)))
          (tp   (make-iri arena RDF_TYPE))
          (ont  (make-iri arena OWL_ONTOLOGY))
          (prop (make-iri arena "http://example.org/t#undeclared"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena q1 tp ont))
        (list-push ts (make-triple arena q2 prop o))
        (match (stage0-header arena ts (list-new arena IRI))
          ((error _) false)
          ((ok s0) (== (cast Int (list-len (. s0 triples))) 0))))))

  (fn strict-outcome ((arena Arena) (path String))
    (@intent "Under strict-profile: 1 refused with omissions, 0 ran to an Outcome, -1 otherwise")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (let ((mut cfg (default-config)))
      (do
        (set! cfg strict-profile true)
        (match (parse-ttl-file arena path)
          ((error _) -1)
          ((ok g)
            (match (classify arena (. g triples) (list-new arena IRI) cfg)
              ((ok _) 0)
              ((error f)
                (match f
                  ((refused os)    (if (> (cast Int (list-len os)) 0) 1 -1))
                  ((cancelled)     -1)
                  ((input-error _) -1)
                  ((unavailable _) -1)))))))))

  ;; What a run under a selection did: ran under a rung, was refused as
  ;; unavailable naming one, or failed some other way (no test expects
  ;; that, so it fails whichever test asked).
  (type RunAs (union
    (ran     Profile)
    (refused Profile)
    (failed)))

  (fn profile-run ((arena Arena) (path String) (selection ProfileSelection))
    (@intent "Classify a fixture under a selection: the rung that ran, or the one refused as unavailable")
    (@spec ((Arena String ProfileSelection) -> RunAs))
    (@alloc arena)
    (let ((mut cfg (default-config)))
      (do
        (set! cfg selection selection)
        (match (parse-ttl-file arena path)
          ((error _) (union-new RunAs failed))
          ((ok g)
            (match (classify arena (. g triples) (list-new arena IRI) cfg)
              ((ok o) (union-new RunAs ran (. o profile)))
              ((error f)
                (match f
                  ((unavailable p) (union-new RunAs refused p))
                  ((refused _)     (union-new RunAs failed))
                  ((cancelled)     (union-new RunAs failed))
                  ((input-error _) (union-new RunAs failed))))))))))

  (fn ran-as ((r RunAs) (want Profile))
    (@intent "Whether a profile-run ran, under want")
    (@spec ((RunAs Profile) -> Bool))
    (@pure)
    (match r ((ran p) (== p want)) ((refused _) false) ((failed) false)))

  (fn refused-as ((r RunAs) (want Profile))
    (@intent "Whether a profile-run was refused as unavailable, naming want")
    (@spec ((RunAs Profile) -> Bool))
    (@pure)
    (match r ((ran _) false) ((refused p) (== p want)) ((failed) false)))

  (fn test-profile-selection ((arena Arena))
    (@intent "§5.1: the default runs el; el, el++ and sriq run as asked; the dropped rung is refused by name; auto picks by membership, then fewest omissions, ties to the earlier rung")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The refusal is the point: a library that ran `el` for an explicit
    ;; `horn-sriq` would classify another theory than asked for and report
    ;; it under the wrong name. auto's cases, with each rung's
    ;; out-of-profile count (el/el++/sriq): litmus 0/·/· → el (el first);
    ;; has-self 1/0/· → el++ (the one containing it); union 1/1/0 and
    ;; inverse 1/1/0 → sriq; nominals 2/1/1 → el++ (a tie, to the earlier).
    (let ((litmus "corpus/fixtures/v0/litmus.ttl")
          (auto (union-new ProfileSelection auto)))
      (and (ran-as (profile-run arena litmus (. (default-config) selection)) 'profile-el)
           (ran-as (profile-run arena litmus (union-new ProfileSelection explicit 'profile-el)) 'profile-el)
           (ran-as (profile-run arena litmus (union-new ProfileSelection explicit 'profile-el-plus-plus))
                   'profile-el-plus-plus)
           (refused-as (profile-run arena litmus (union-new ProfileSelection explicit 'profile-horn-sriq))
                       'profile-horn-sriq)
           (ran-as (profile-run arena litmus (union-new ProfileSelection explicit 'profile-sriq)) 'profile-sriq)
           (ran-as (profile-run arena litmus auto) 'profile-el)
           (ran-as (profile-run arena "corpus/fixtures/el++/has-self.ttl" auto) 'profile-el-plus-plus)
           (ran-as (profile-run arena "corpus/fixtures/out-of-profile/union.ttl" auto) 'profile-sriq)
           (ran-as (profile-run arena "corpus/fixtures/out-of-profile/inverse.ttl" auto) 'profile-sriq)
           (ran-as (profile-run arena "corpus/fixtures/out-of-profile/nominals.ttl" auto) 'profile-el-plus-plus))))

  ;; ------------------------------------------------------------
  ;; Slice 11b: auto's step-down (§5.1). auto keeps its rule, and when the
  ;; rung it chose is sriq and sriq's run passes the clause budget without
  ;; a definitive finding, the run that answers is the rung el and el++
  ;; alone would choose. The budget is lowered here to make it bind.
  ;; ------------------------------------------------------------

  (fn test-auto-step-down ((arena Arena))
    (@intent "auto steps down from sriq exactly when sriq's run passes the clause budget without a definitive finding; never under an explicit sriq, a round cap, or a cancel")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((union "corpus/fixtures/out-of-profile/union.ttl")
          (auto (union-new ProfileSelection auto))
          (sriq (union-new ProfileSelection explicit 'profile-sriq)))
      (and (step-says arena "default-config's clause budget is SRIQ_CLAUSE_BUDGET"
                      (== (cast Int (. (default-config) clause-budget)) SRIQ_CLAUSE_BUDGET))
           (step-says arena "union, auto: sriq answers, no step-down"
                      (answered-by (classify-cfg arena union (with-budget auto 1000 SRIQ_CLAUSE_BUDGET)) 'profile-sriq false))
           (step-says arena "union, auto, budget 1: el answers (el and el++ tie), stepped down"
                      (answered-by (classify-cfg arena union (with-budget auto 1000 1)) 'profile-el true))
           (step-says arena "union, explicit sriq, budget 1: sriq, resource-limit, no step-down"
                      (capped-sriq (classify-cfg arena union (with-budget sriq 1000 1))))
           (step-says arena "union, auto, cap 0: the cap is the caller's, no step-down"
                      (capped-sriq (classify-cfg arena union (with-budget auto 0 SRIQ_CLAUSE_BUDGET))))
           (step-says arena "union, auto, budget 1, cancelled: Fault::cancelled"
                      (is-cancelled (classify-cfg arena union (cancelled-cfg (with-budget auto 1000 1)))))
           (step-scan arena "corpus/fixtures/sriq/step-down-early-unsat.ttl"))))

  (fn test-choices-budget ((arena Arena))
    (@intent "The clause budget also caps one rule instance's choices: sriq-config sets the choices cap to the budget, and
              an ontology whose Pred products outgrow it stops there, explicit sriq at resource-limit, auto stepped down (at
              50,000, where a Pred job of round 14 passes it; the production 500,000 binds in round 15)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((path "corpus/fixtures/sriq-budget/pred-choices.ttl")
          (auto (union-new ProfileSelection auto))
          (sriq (union-new ProfileSelection explicit 'profile-sriq)))
      (and (step-says arena "sriq-config's choices cap is its clause budget"
                      (== (. (. (sriq-config 1000 7 0) base) prod) 7))
           (step-says arena "pred-choices: Run H stops at the choices cap, its store within the budget"
                      (choices-stopped arena path))
           (step-says arena "pred-choices, explicit sriq: resource-limit, no step-down"
                      (capped-sriq (classify-cfg arena path (with-budget sriq 1000 50000))))
           (step-says arena "pred-choices, auto: el answers, stepped down"
                      (answered-by (classify-cfg arena path (with-budget auto 1000 50000)) 'profile-el true)))))

  (fn choices-stopped ((arena Arena) (path String))
    (@intent "Does path's Run H stop at the choices cap (rs-product) under a budget of 50,000, its store within it?")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (split-load arena path)
      ((error m) false)
      ((ok in)
        (let ((h (. (. (split-run-of arena (. in h) (. in c) (. in has-c) false (sriq-config 1000 50000 0)) h)
                    res)))
          (and (== (. h status) 'rs-product) (<= (view-total (. h st)) 50000))))))

  (fn step-says ((arena Arena) (label String) (ok Bool))
    (@intent "One check of the step-down, printed when it fails")
    (@spec ((Arena String Bool) -> Bool))
    (@alloc arena)
    (if ok true (do (print "  [sriq 11b] ") (println label) false)))

  (fn with-budget ((sel ProfileSelection) (rounds Int) (budget Int))
    (@intent "The default configuration under sel, with max-iterations rounds and clause budget budget")
    (@spec ((ProfileSelection Int Int) -> ReasonerConfig))
    (let ((mut cfg (default-config)))
      (do (set! cfg selection sel)
          (set! cfg max-iterations (cast (Int 0 .. 10000) rounds))
          (set! cfg clause-budget (cast (Int 1 ..) budget))
          cfg)))

  (fn cancelled-cfg ((cfg ReasonerConfig))
    (@intent "cfg with a set cancel flag")
    (@spec ((ReasonerConfig) -> ReasonerConfig))
    (let ((mut c cfg)) (do (set! c cancel-ptr (cancel-flag-set)) c)))

  (fn classify-cfg ((arena Arena) (path String) (cfg ReasonerConfig))
    (@intent "A file through classify under cfg; an unreadable file is an input-error")
    (@spec ((Arena String ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((ok g)    (classify arena (. g triples) (list-new arena IRI) cfg))
      ((error _) (error (union-new Fault input-error "unreadable fixture")))))

  (fn answered-by ((r (Result Outcome Fault)) (p Profile) (stepped Bool))
    (@intent "Did rung p answer, stepped down or not as given?")
    (@spec (((Result Outcome Fault) Profile Bool) -> Bool))
    (match r ((ok o) (and (== (. o profile) p) (== (. o stepped-down) stepped))) ((error _) false)))

  (fn capped-sriq ((r (Result Outcome Fault)))
    (@intent "Did sriq answer at resource-limit, not stepped down?")
    (@spec (((Result Outcome Fault)) -> Bool))
    (match r
      ((ok o) (and (== (. o profile) 'profile-sriq) (not (. o stepped-down)) (not (is-fixpoint (. o termination)))))
      ((error _) false)))

  (fn step-scan ((arena Arena) (path String))
    (@intent "Over budgets 1..400 on a sriq-only incoherent fixture: auto steps down exactly when the explicit run stops at the budget with nothing definitive; both cases occur, and so does a budget-stopped run that found its unsat")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (let ((mut ok true) (mut stepped 0) (mut kept 0) (mut b 1))
      (do (while (<= b 400)
            (let ((k (step-at arena path b)))
              (do (when (< k 0) (set! ok false))
                  (when (== k 1) (set! stepped (+ stepped 1)))
                  (when (== k 2) (set! kept (+ kept 1)))
                  (set! b (+ b 1)))))
          (step-says arena (string-concat arena path ": step-down exactly at the budget with nothing definitive; both cases seen")
                     (and ok (> stepped 0) (> kept 0))))))

  (fn step-at ((arena Arena) (path String) (b Int))
    (@intent "At budget b: -1 if auto disagrees with the explicit run; else 1 if it stepped down, 2 if a budget-stopped run kept its definitive finding, 0 otherwise")
    (@spec ((Arena String Int) -> Int))
    (@alloc arena)
    (match (classify-cfg arena path (with-budget (union-new ProfileSelection explicit 'profile-sriq) 1000 b))
      ((error _) -1)
      ((ok eo)
        (let ((stopped (not (is-fixpoint (. eo termination))))
              (found   (findings-are-incoherent (. eo findings)))
              (want    (and stopped (not found))))
          (cond ((not (step-agrees (classify-cfg arena path (with-budget (union-new ProfileSelection auto) 1000 b)) want)) -1)
                (want 1)
                ((and stopped found) 2)
                (else 0))))))

  (fn step-agrees ((a (Result Outcome Fault)) (want Bool))
    (@intent "auto's run stepped down to a rung below sriq if want, else sriq answered unstepped")
    (@spec (((Result Outcome Fault) Bool) -> Bool))
    (match a
      ((ok o) (if want
                (and (. o stepped-down) (!= (. o profile) 'profile-sriq))
                (and (not (. o stepped-down)) (== (. o profile) 'profile-sriq))))
      ((error _) false)))

  (fn test-profile-names-round-trip ((arena Arena))
    (@intent "Every rung's name parses back to the rung, and nothing else parses")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and (name-round-trips 'profile-el) (name-round-trips 'profile-el-plus-plus)
         (name-round-trips 'profile-horn-sriq) (name-round-trips 'profile-sriq)
         (match (parse-profile "auto") ((some _) false) ((none) true))
         (match (parse-profile "EL") ((some _) false) ((none) true))
         (match (parse-profile "sroiq") ((some _) false) ((none) true))))

  (fn test-dropped-rung-refusal ((arena Arena))
    (@intent "§5: horn-sriq alone is dropped, and each refusal says why: dropped, or not built yet")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The two texts must not trade places: a dropped rung's refusal names
    ;; what replaces it, an unbuilt one's what is implemented.
    (and (profile-dropped 'profile-horn-sriq)
         (not (profile-dropped 'profile-el))
         (not (profile-dropped 'profile-el-plus-plus))
         (not (profile-dropped 'profile-sriq))
         ;; Every live rung is built (slice 11b), so only the dropped
         ;; rung's text is reachable.
         (string-eq (unavailable-message arena 'profile-horn-sriq)
                    "profile horn-sriq was dropped; sriq covers its language")))

  (fn name-round-trips ((p Profile))
    (@intent "Whether p's name parses back to p")
    (@spec ((Profile) -> Bool))
    (@pure)
    (match (parse-profile (profile-name p)) ((some q) (== q p)) ((none) false)))

  (fn test-strict-refuses-past-omissions ((arena Arena))
    (@intent "§10 item 12: strict yields refused carrying the omissions, and only when there are some")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Both halves matter. A refusal without the omissions tells the caller
    ;; nothing to fix; a refusal on a fully covered document makes strict
    ;; mode a CI gate that fails every ontology in existence.
    (and (== (strict-outcome arena "corpus/fixtures/out-of-profile/union.ttl") 1)
         (== (strict-outcome arena "corpus/fixtures/v0/litmus.ttl") 0)))

  (fn test-nary-chain-decomposes-left-associated ((arena Arena))
    (@intent "An n-ary chain becomes binary role-chain steps through fresh roles")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Decomposition runs AFTER the gates, so a fresh-role never appears
    ;; in a gate question — a fresh intermediate is unconstrained by any
    ;; ≺ the original chain had to respect, and decomposing first would
    ;; let a non-regular dependency split across two innocuous steps.
    (match (normalize-fixture arena "corpus/fixtures/v0/property-chain-nary.ttl")
      ((none) false)
      ((some no)
        (let ((mut chains 0))
          (do
            (for-each (a (. no axioms))
              (match a ((role-chain _ _ _) (set! chains (+ chains 1))) (_ (do))))
            ;; a 3-step chain becomes exactly 2 binary steps
            (== chains 2))))))

  (fn regularity-of ((arena Arena) (path String))
    (@intent "The regularity verdict for a fixture's expanded RBox")
    (@spec ((Arena String) -> (Option Bool)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)
            (match (decode-axioms arena (. s0 dict) (. s0 triples))
              ((error _) (none))
              ((ok s1)
                (match (check-regularity arena (expand-sugar arena (. s1 axioms)))
                  ((rbox-regular)     (some true))
                  ((rbox-irregular _) (some false))))))))))

  (fn test-regularity-rejects-mutual-recursion ((arena Arena))
    (@intent "r o s subseteq s with s o r subseteq r is non-regular")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The constraint graph holds r ≺ s and s ≺ r, whose closure
    ;; contains (r,r); ⊑* is reflexive, so r ⊑* r makes it a violation.
    ;; That is the `r ≺ r` self-edge the conventional "non-trivial SCC"
    ;; reading drops, leaving the most obvious violation with no
    ;; witness at all.
    (match (regularity-of arena "corpus/fixtures/hazards/rbox-regularity-reject.ttl")
      ((none) false)
      ((some regular) (not regular))))

  (fn test-regularity-accepts-equivalence-and-transitivity ((arena Arena))
    (@intent "THE FALSE-FAIL CASE: equivalent simple roles and r o r subseteq r are regular")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A GENERIC CYCLE DETECTOR OVER ROLE INCLUSIONS FAILS BOTH OF
    ;; THESE, and both failures refuse a correct ontology. `r ⊑ s` with
    ;; `s ⊑ r` is a non-trivial SCC in the INCLUSION graph while being
    ;; perfectly regular, and `t ∘ t ⊑ t` is a self-loop the normative
    ;; cases expressly permit. Neither generates a ≺ edge: simple
    ;; inclusions are never matched against the cases, and transitivity
    ;; is dominated by the case that constrains nothing. An earlier
    ;; draft of the spec specified exactly the naive graph.
    (match (regularity-of arena "corpus/fixtures/hazards/rbox-regularity-accept.ttl")
      ((none) false)
      ((some regular) regular)))

  (fn test-regularity-accepts-plain-subproperty ((arena Arena))
    (@intent "An ordinary rdfs:subPropertyOf is not matched against the chain cases")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Feeding simple inclusions into case matching makes "matches no
    ;; permitted form" reject every rdfs:subPropertyOf axiom in
    ;; existence — which an earlier spec draft did, contradicting its
    ;; own accepted-examples table two paragraphs later.
    (match (regularity-of arena "corpus/fixtures/v0/subproperty.ttl")
      ((none) false)
      ((some regular) regular)))

  (fn test-regularity-accepts-nary-chain ((arena Arena))
    (@intent "A well-founded n-ary chain is regular")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (regularity-of arena "corpus/fixtures/v0/property-chain-nary.ttl")
      ((none) false)
      ((some regular) regular)))

  (fn test-irregular-rbox-is-omitted-whole ((arena Arena))
    (@intent "A collective RBox failure omits the RBox, and accepts none of it")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; HOWL does not classify a projected RBox. Deleting a witness needs
    ;; a removal set, a witness is not one, and the choice is not local.
    (match (gate-fixture arena "corpus/fixtures/hazards/rbox-regularity-reject.ttl")
      ((none) false)
      ((some gr)
        (and (> (cast Int (list-len (. gr omissions))) 0)
             (== (count-variant-chain (. gr accepted)) 0)))))

  (fn gate-fixture ((arena Arena) (path String))
    (@intent "Parse, stage 0, decode, gate — the front end as far as it goes")
    (@spec ((Arena String) -> (Option GateResult)))
    (@alloc arena)
    (gate-fixture-in arena path 'profile-el))

  (fn gate-fixture-in ((arena Arena) (path String) (p Profile))
    (@intent "Parse, stage 0, decode, gate under a rung")
    (@spec ((Arena String Profile) -> (Option GateResult)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)
            (match (decode-axioms arena (. s0 dict) (. s0 triples))
              ((error _) (none))
              ((ok s1)
                (some (gate-axioms arena (. s1 axioms) (. s1 signature)
                        (carried-of arena s0 s1) p)))))))))

  (fn count-variant-chain ((axs (List RawAxiom)))
    (@intent "How many property-chain axioms survived the gate")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    (let ((mut n 0))
      (do (for-each (a axs) (match a ((ra-property-chain _) (set! n (+ n 1))) (_ (do)))) n)))

  (fn count-variant-disjoint ((axs (List RawAxiom)))
    (@intent "How many disjointness axioms survived the gate")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    (let ((mut n 0))
      (do (for-each (a axs) (match a ((ra-disjoint-classes _) (set! n (+ n 1))) (_ (do)))) n)))

  (fn count-variant-subclass ((axs (List RawAxiom)))
    (@intent "How many class inclusions survived the gate")
    (@spec (((List RawAxiom)) -> Int))
    (@pure)
    (let ((mut n 0))
      (do (for-each (a axs) (match a ((ra-sub-class-of _ _) (set! n (+ n 1))) (_ (do)))) n)))

  (fn test-gate-annotation-heavy-is-clean ((arena Arena))
    (@intent "M0 ACCEPTANCE (a): a versioned, annotated ontology gates CLEAN")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The whole acceptance criterion, end to end through the real gate:
    ;; no label, declaration or reification triple reaches
    ;; coverage.omitted. Get this wrong and NOTHING downstream ever
    ;; classifies — HOWL is correct and useless.
    (match (gate-fixture arena "corpus/fixtures/hazards/annotation-heavy.ttl")
      ((none) false)
      ((some gr)
        (and (== (cast Int (list-len (. gr omissions))) 0)
             ;; and the logical content survived, so an empty omission
             ;; list cannot be bought by dropping everything
             (> (count-variant-subclass (. gr accepted)) 0)))))

  (fn test-gate-carries-import-omissions ((arena Arena))
    (@intent "M0 ACCEPTANCE (b): a stage-0 omission survives into coverage")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Coverage is ONE list. An import shortfall raised before the gate
    ;; has to ride through it, or the gate silently launders a
    ;; dangling import into a clean verdict.
    (match (gate-fixture arena "corpus/fixtures/hazards/unattested-import.ttl")
      ((none) false)
      ((some gr) (== (cast Int (list-len (. gr omissions))) 1))))

  (fn test-sugar-transitivity-becomes-a-chain ((arena Arena))
    (@intent "TransitiveObjectProperty(r) is rewritten to r ∘ r ⊑ r before the gates")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The RBox gates read the told hierarchy and chains AS WRITTEN. If
    ;; transitivity is still sugar when regularity runs, the gate
    ;; answers a question about an RBox missing an axiom the document
    ;; states.
    (match (gate-fixture arena "corpus/fixtures/v0/transitive.ttl")
      ((none) false)
      ((some gr)
        (and (> (count-variant-chain (. gr accepted)) 0)
             (== (cast Int (list-len (. gr omissions))) 0)))))

  (fn test-sugar-nary-disjointness-becomes-pairs ((arena Arena))
    (@intent "DisjointClasses(C1 C2 C3) becomes exactly three pairs")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Three classes must give three pairs — not six (every ordered
    ;; pair) and not one (the n-ary axiom left whole, which normalizes
    ;; to a single binary conjunction and loses two disjointness facts).
    (match (gate-fixture arena "corpus/fixtures/v0/disjoint-nary.ttl")
      ((none) false)
      ((some gr) (== (count-variant-disjoint (. gr accepted)) 3))))

  (fn test-sugar-equivalence-is-a-star-not-all-pairs ((arena Arena))
    (@intent "EquivalentClasses gives 2(n−1) inclusions, not n(n−1)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; A star through the canonically least operand entails the same
    ;; closure by transitivity of ⊑ while staying linear. The naive
    ;; all-pairs reading is quadratic before saturation even begins.
    (match (gate-fixture arena "corpus/fixtures/v0/equivalent-classes.ttl")
      ((none) false)
      ((some gr)
        (and (> (count-variant-subclass (. gr accepted)) 0)
             (== (cast Int (list-len (. gr omissions))) 0)))))

  (fn gate-omission-count ((arena Arena) (path String))
    (@intent "Omissions for a fixture, or -1 if the front end refused it")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (gate-fixture arena path)
      ((none)    -1)
      ((some gr) (cast Int (list-len (. gr omissions))))))

  (fn test-gate-accepts-every-v0-fixture ((arena Arena))
    (@intent "All 20 v0 fixtures gate with EMPTY coverage.omitted")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE FALSE-FAIL HALF, and the one review habitually skips. A gate
    ;; is reviewed for what it lets through; over-rejection reads as
    ;; conservative and therefore safe. It is not: refusing a user's
    ;; correct ontology is its own failure, and a gate that rejects too
    ;; much also invalidates the completeness claim conditioned on it.
    (let ((mut paths (list-new arena String))
          (mut ok true))
      (do
        (list-push paths "corpus/fixtures/v0/subclass-atomic.ttl")
        (list-push paths "corpus/fixtures/v0/intersection.ttl")
        (list-push paths "corpus/fixtures/v0/exists-lhs.ttl")
        (list-push paths "corpus/fixtures/v0/exists-rhs.ttl")
        (list-push paths "corpus/fixtures/v0/equivalent-classes.ttl")
        (list-push paths "corpus/fixtures/v0/equivalent-properties.ttl")
        (list-push paths "corpus/fixtures/v0/disjoint-binary.ttl")
        (list-push paths "corpus/fixtures/v0/disjoint-nary.ttl")
        (list-push paths "corpus/fixtures/v0/subproperty.ttl")
        (list-push paths "corpus/fixtures/v0/property-chain.ttl")
        (list-push paths "corpus/fixtures/v0/property-chain-nary.ttl")
        (list-push paths "corpus/fixtures/v0/transitive.ttl")
        (list-push paths "corpus/fixtures/v0/domain.ttl")
        (list-push paths "corpus/fixtures/v0/range.ttl")
        (list-push paths "corpus/fixtures/v0/abox-assertions.ttl")
        (list-push paths "corpus/fixtures/v0/top-bottom.ttl")
        (list-push paths "corpus/fixtures/v0/litmus.ttl")
        (list-push paths "corpus/fixtures/v0/negation-superclass.ttl")
        (list-push paths "corpus/fixtures/v0/negation-domain-range.ttl")
        (list-push paths "corpus/fixtures/v0/negation-chain.ttl")
        (for-each (p paths)
          (when (!= (gate-omission-count arena p) 0)
            (do (print "  [gate] expected 0 omissions, got ")
                (print (int-to-string arena (gate-omission-count arena p)))
                (print " in ") (println p)
                (set! ok false))))
        ok)))

  (fn test-gate-rejects-every-out-of-profile-fixture ((arena Arena))
    (@intent "All 14 out-of-profile fixtures gate with NON-EMPTY coverage.omitted")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut paths (list-new arena String))
          (mut ok true))
      (do
        (list-push paths "corpus/fixtures/out-of-profile/union.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/complement.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/allvalues.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/nominals.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/cardinality.ttl")
        (list-push paths "corpus/fixtures/el++/has-self.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/inverse.ttl")
        (list-push paths "corpus/fixtures/el++/equality.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/property-characteristics.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/haskey-disjointunion.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/swrl-rule.ttl")
        (list-push paths "corpus/fixtures/el++/builtin-roles.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/anonymous-individual.ttl")
        (list-push paths "corpus/fixtures/out-of-profile/datatypes.ttl")
        (for-each (p paths)
          (when (< (gate-omission-count arena p) 1)
            (do (print "  [gate] expected >=1 omission, got ")
                (print (int-to-string arena (gate-omission-count arena p)))
                (print " in ") (println p)
                (set! ok false))))
        ok)))

  (fn signature-of-fixture ((arena Arena) (path String))
    (@intent "Parse, run stage 0, and build the signature — the common prefix")
    (@spec ((Arena String) -> (Option Signature)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (none))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) (none))
          ((ok s0)  (some (build-signature arena (. s0 dict) (. s0 triples))))))))

  (fn test-declared-unused-class-reaches-the-signature ((arena Arena))
    (@intent "M0 ACCEPTANCE (c): a declared, unmentioned class is in the signature")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The signature is what stage 4 initializes contexts FROM, so this
    ;; is where acceptance (c) is won or lost. Key initialization on
    ;; axiom occurrence instead and `:Unused` is a class HOWL silently
    ;; does not know exists — it cannot answer `Unused ⊑ ⊤`, cannot
    ;; list it, cannot serve a probe naming it. Not an error, an
    ;; absence, which is worse.
    (match (signature-of-fixture arena "corpus/fixtures/hazards/declared-unused-class.ttl")
      ((none) false)
      ((some sig)
        (and (signature-has-class sig (record-new IRI (value "http://example.org/t#Unused")))
             (signature-has-class sig (record-new IRI (value "http://example.org/t#A")))))))

  (fn test-builtins-are-declared ((arena Arena))
    (@intent "owl:Thing is never a missing declaration")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Without the built-ins pre-populated, every ontology that writes
    ;; `rdfs:subClassOf owl:Thing` collects a missing-declaration
    ;; omission for vocabulary the STANDARD declares — a correct
    ;; document gating dirty.
    (match (signature-of-fixture arena "corpus/fixtures/hazards/declared-unused-class.ttl")
      ((none) false)
      ((some sig)
        (and (signature-has-class sig (record-new IRI (value OWL_THING)))
             ;; rdfs:label must be a KNOWN annotation property, which is
             ;; what makes a label assertion inert rather than
             ;; unrecognized — acceptance (a) rests on this.
             (signature-has-annotation-property sig (record-new IRI (value RDFS_LABEL)))))))

  (fn test-custom-annotation-property-is-recognized ((arena Arena))
    (@intent "A user-declared annotation property is structural, not a hardcoded list")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; §5.2 requires Inert to be STRUCTURAL: any assertion whose
    ;; predicate is a declared annotation property is inert. A
    ;; whitelist of rdfs:label and friends would mark `:curatorNote`
    ;; out-of-profile and fail acceptance (a) on the very fixture
    ;; written to catch it.
    (match (signature-of-fixture arena "corpus/fixtures/hazards/annotation-heavy.ttl")
      ((none) false)
      ((some sig)
        (and (signature-has-annotation-property sig
               (record-new IRI (value "http://example.org/t#curatorNote")))
             (signature-has-class sig (record-new IRI (value "http://example.org/t#A")))
             ;; and it is NOT mistaken for a class
             (not (signature-has-class sig
                    (record-new IRI (value "http://example.org/t#curatorNote"))))))))

  (fn is-named-class ((c RawConcept) (iri String))
    (@intent "Is this concept exactly the named class with this IRI?")
    (@spec ((RawConcept String) -> Bool))
    (@pure)
    (match c
      ((rc-name nd)
        (match nd
          ((class-node i)      (== (string-cmp (. i value) iri) 0))
          ((individual-node _) false)
          ((fresh-node _)      false)))
      (_ false)))

  (fn is-some-person ((c RawConcept) (role-iri String) (filler-iri String))
    (@intent "Is this concept EXISTS role.filler, with both named?")
    (@spec ((RawConcept String String) -> Bool))
    (@pure)
    (match c
      ((rc-some r f)
        (and (match r
               ((named-role i)   (== (string-cmp (. i value) role-iri) 0))
               ((fresh-role _)   false)
               ((inverse-role _) false))
             (is-named-class (deref f) filler-iri)))
      (_ false)))

  (fn test-decode-litmus-class-expression ((arena Arena))
    (@intent "§3.1's defining expression decodes to rc-and[rc-name, rc-some]")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE STRUCTURE THE WHOLE PROJECT TURNS ON. `Parent ≡ Person ⊓
    ;; ∃hasChild.Person` is what lets `Mother ⊑ Parent` be derived
    ;; through the existential on the DEFINING side — the step a
    ;; materialization engine cannot take. If the decoder flattens the
    ;; restriction, loses a conjunct, or reads the filler as anonymous,
    ;; the litmus fails later for a reason that looks like a reasoning
    ;; bug rather than a parsing one. This pins it at the seam.
    (let ((person "http://example.org/t#Person")
          (has-child "http://example.org/t#hasChild"))
      (match (parse-ttl-file arena "corpus/fixtures/v0/litmus.ttl")
        ((error _) false)
        ((ok g)
          (match (stage0-header arena (. g triples) (list-new arena IRI))
            ((error _) false)
            ((ok s0)
              (let ((ig (graph-to-indexed arena (stage0-triples arena s0)))
                    (parent (make-iri arena "http://example.org/t#Parent"))
                    (eq-pred (make-iri arena OWL_EQUIVALENT_CLASS)))
                (match (one-object arena ig parent eq-pred)
                  ((error _) false)
                  ((ok defn)
                    (match (decode-concept arena ig defn CONCEPT_FUEL)
                      ((error _) false)
                      ((ok c)
                        (match c
                          ((rc-and cs)
                            (let ((mut n 0)
                                  (mut saw-person false)
                                  (mut saw-some false))
                              (do
                                (for-each (x cs)
                                  (do
                                    (set! n (+ n 1))
                                    (when (is-named-class x person) (set! saw-person true))
                                    (when (is-some-person x has-child person)
                                      (set! saw-some true))))
                                ;; BOTH conjuncts, and exactly two. A
                                ;; truncated RDF list would give n = 1
                                ;; and a strictly stronger axiom.
                                (and (== n 2) saw-person saw-some))))
                          (_ false)))))))))))))

  (fn test-decode-represents-out-of-profile-rather-than-failing ((arena Arena))
    (@intent "owl:unionOf decodes to rc-or — represented, not a parse error")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; DECODING IS NOT ACCEPTING. A union is out of profile, but it must
    ;; arrive at the gate as a named construct so the gate can report
    ;; it. If the decoder faulted here instead, an ontology with one
    ;; union anywhere would lose EVERY axiom rather than that one.
    (let ((b1 (make-blank arena 1))
          (c1 (make-blank arena 2))
          (c2 (make-blank arena 3))
          (nil-t (make-iri arena RDF_NIL))
          (f (make-iri arena RDF_FIRST))
          (r (make-iri arena RDF_REST))
          (u (make-iri arena "http://www.w3.org/2002/07/owl#unionOf"))
          (ea (ex-iri arena "A"))
          (eb (ex-iri arena "B"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 u c1))
        (list-push ts (make-triple arena c1 f ea))
        (list-push ts (make-triple arena c1 r c2))
        (list-push ts (make-triple arena c2 f eb))
        (list-push ts (make-triple arena c2 r nil-t))
        (match (decode-concept arena (graph-to-indexed arena ts) b1 CONCEPT_FUEL)
          ((error _) false)
          ((ok c)
            (match c
              ((rc-or cs) (== (cast Int (list-len cs)) 2))
              (_ false)))))))

  (fn test-decode-blank-node-cycle-is-bounded ((arena Arena))
    (@intent "A cyclic class expression faults rather than recursing forever")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; `_:x owl:complementOf _:x` is unbounded recursion in the front
    ;; end, BEFORE max-iterations bounds anything. The fuel bound is
    ;; what makes a hostile or corrupt document terminate.
    (let ((b1 (make-blank arena 1))
          (comp (make-iri arena "http://www.w3.org/2002/07/owl#complementOf"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 comp b1))
        (match (decode-concept arena (graph-to-indexed arena ts) b1 CONCEPT_FUEL)
          ((error _) true)
          ((ok _) false)))))

  (fn test-rdf-list-well-formed ((arena Arena))
    (@intent "A three-cell collection reads back in order, all elements present")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((b1 (make-blank arena 1))
          (b2 (make-blank arena 2))
          (b3 (make-blank arena 3))
          (nil-t (make-iri arena RDF_NIL))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (ea (ex-iri arena "A"))
          (eb (ex-iri arena "B"))
          (ec (ex-iri arena "C"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f ea))
        (list-push ts (make-triple arena b1 r b2))
        (list-push ts (make-triple arena b2 f eb))
        (list-push ts (make-triple arena b2 r b3))
        (list-push ts (make-triple arena b3 f ec))
        (list-push ts (make-triple arena b3 r nil-t))
        (match (rdf-list-checked arena (graph-to-indexed arena ts) b1)
          ((error _) false)
          ((ok els)
            (and (== (cast Int (list-len els)) 3)
                 (term-eq (term-at els 0) ea)
                 (term-eq (term-at els 1) eb)
                 (term-eq (term-at els 2) ec)))))))

  (fn test-rdf-list-truncation-is-a-fault ((arena Arena))
    (@intent "A cell with no rdf:first FAULTS — it must never yield a shorter list")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; THE HAZARD, DEMONSTRATED. slop-rdf's `rdf-list-elements-indexed`
    ;; skips a cell with no `rdf:first` and walks on, returning two
    ;; elements where the document wrote three. Under
    ;; `owl:intersectionOf` that silently turns `A ⊓ B ⊓ C ⊑ D` into
    ;; the STRICTLY STRONGER `A ⊓ B ⊑ D`, so HOWL would derive and
    ;; report subsumptions that do not hold. A shorter list is a wrong
    ;; answer in the shape of a right one, which is why this is a
    ;; Result rather than a best effort.
    (let ((b1 (make-blank arena 1))
          (b2 (make-blank arena 2))
          (b3 (make-blank arena 3))
          (nil-t (make-iri arena RDF_NIL))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (ea (ex-iri arena "A"))
          (ec (ex-iri arena "C"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f ea))
        (list-push ts (make-triple arena b1 r b2))
        ;; b2 carries rdf:rest but NO rdf:first — the silent-drop case
        (list-push ts (make-triple arena b2 r b3))
        (list-push ts (make-triple arena b3 f ec))
        (list-push ts (make-triple arena b3 r nil-t))
        (match (rdf-list-checked arena (graph-to-indexed arena ts) b1)
          ((ok _) false)
          ((error e)
            (match e
              ((list-truncated _) true)
              ((list-branching _) false)
              ((list-cyclic _)    false)))))))

  (fn test-rdf-list-cycle-terminates ((arena Arena))
    (@intent "An rdf:rest cycle faults rather than spinning in the front end")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; slop-rdf's walker has no visited set, so this input loops
    ;; forever pushing into the arena. That happens in the front end,
    ;; BEFORE max-iterations applies to anything, so the budget that
    ;; is supposed to bound a run does not bound this.
    (let ((b1 (make-blank arena 1))
          (b2 (make-blank arena 2))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (ea (ex-iri arena "A"))
          (eb (ex-iri arena "B"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f ea))
        (list-push ts (make-triple arena b1 r b2))
        (list-push ts (make-triple arena b2 f eb))
        (list-push ts (make-triple arena b2 r b1))
        (match (rdf-list-checked arena (graph-to-indexed arena ts) b1)
          ((ok _) false)
          ((error e)
            (match e
              ((list-cyclic _)    true)
              ((list-truncated _) false)
              ((list-branching _) false)))))))

  (fn test-rdf-list-branching-is-a-fault ((arena Arena))
    (@intent "Two rdf:first values on one cell have no determinate reading")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Determinism, not pedantry. slop-rdf takes `(list-get firsts 0)`,
    ;; and index order is HASH-BUCKET order — so which conjunct
    ;; survives depends on table layout, and adding an unrelated
    ;; triple elsewhere can rehash and change the answer. §6.8 forbids
    ;; exactly that.
    (let ((b1 (make-blank arena 1))
          (nil-t (make-iri arena RDF_NIL))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (ea (ex-iri arena "A"))
          (eb (ex-iri arena "B"))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f ea))
        (list-push ts (make-triple arena b1 f eb))
        (list-push ts (make-triple arena b1 r nil-t))
        (and (list-branches arena ts b1)
             ;; and two rdf:rest values, the same hazard one step on
             (list-branches arena (rest-forked arena) b1)))))

  (fn rest-forked ((arena Arena))
    (@intent "A list cell with one rdf:first and two rdf:rest values")
    (@spec ((Arena) -> (List Triple)))
    (@alloc arena)
    (let ((b1 (make-blank arena 1))
          (b2 (make-blank arena 2))
          (nil-t (make-iri arena RDF_NIL))
          (f  (make-iri arena RDF_FIRST))
          (r  (make-iri arena RDF_REST))
          (mut ts (list-new arena Triple)))
      (do
        (list-push ts (make-triple arena b1 f (ex-iri arena "A")))
        (list-push ts (make-triple arena b1 r nil-t))
        (list-push ts (make-triple arena b1 r b2))
        (list-push ts (make-triple arena b2 f (ex-iri arena "B")))
        (list-push ts (make-triple arena b2 r nil-t))
        ts)))

  (fn list-branches ((arena Arena) (ts (List Triple)) (head Term))
    (@intent "Does the list at head fault as branching?")
    (@spec ((Arena (List Triple) Term) -> Bool))
    (@alloc arena)
    (match (rdf-list-checked arena (graph-to-indexed arena ts) head)
      ((ok _) false)
      ((error e)
        (match e
          ((list-branching _) true)
          ((list-truncated _) false)
          ((list-cyclic _)    false)))))

  ;; ============================================================
  ;; Decode, row by row: what one triple (or one malformed set of
  ;; triples) decodes to, as text. These pin readings that no other test
  ;; or golden saw: mutants of decode's restructure survived them.
  ;; ============================================================

  (fn decode-prefix ()
    (@intent "The shared prefix block for the decode rows")
    (@spec (() -> String))
    (@pure)
    "@prefix : <http://example.org/t#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n:A a owl:Class . :r a owl:ObjectProperty . :s a owl:ObjectProperty .\n:d a owl:DatatypeProperty . :d2 a owl:DatatypeProperty .\n:a a owl:NamedIndividual . :b a owl:NamedIndividual .\n")

  (fn decoded-text ((arena Arena) (ttl String))
    (@intent "An inline document's decoded axioms but its declarations, one per line, or its fault")
    (@spec ((Arena String) -> String))
    (@alloc arena)
    (match (parse-ttl-string arena ttl)
      ((error _) "<did not parse>")
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error _) "<stage 0 faulted>")
          ((ok s0)
            (let ((mut out ""))
              (do
                (for-each (l (decode-rendered arena (decode-axioms arena (. s0 dict) (. s0 triples))))
                  (when (not (starts-with l "Declaration("))
                    (set! out (string-concat arena out (string-concat arena l "\n")))))
                out)))))))

  (fn decodes-exactly ((arena Arena) (label String) (ttl String) (want String))
    (@intent "Does the document decode to exactly these lines? Prints what it got when not")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (let ((got (decoded-text arena (string-concat arena (decode-prefix) ttl))))
      (if (string-eq got want)
        true
        (do
          (println (string-concat arena (string-concat arena "  [decode row] " label) ": decoded"))
          (println got)
          false))))

  (fn test-decode-rows ((arena Arena))
    (@intent "Each reading below decodes exactly as written")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (and
      ;; An n-ary data restriction names its properties in list order.
      (decodes-exactly arena "n-ary data restriction"
        ":A rdfs:subClassOf [ a owl:Restriction ; owl:onProperties ( :d :d2 ) ; owl:allValuesFrom xsd:string ] ."
        "ReservedVocabulary(_:b0 <http://www.w3.org/2002/07/owl#onProperties> _:b1 .)\nSubClassOf(http://example.org/t#A DataRange(DataAllValuesFrom(onProperties(http://example.org/t#d http://example.org/t#d2) http://www.w3.org/2001/XMLSchema#string)))\n")
      ;; Data members make an AllDisjointProperties data, never roles.
      (decodes-exactly arena "AllDisjointProperties over data properties"
        "[ a owl:AllDisjointProperties ; owl:members ( :d :d2 ) ] ."
        "DataAxiom(_:b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#AllDisjointProperties> .)\n")
      ;; A data property with an individual target is malformed data, never
      ;; a negative object assertion.
      (decodes-exactly arena "negative assertion on a data property, individual target"
        "[ a owl:NegativePropertyAssertion ; owl:sourceIndividual :a ; owl:assertionProperty :d ; owl:targetIndividual :b ] ."
        "DataAxiom(_:b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NegativePropertyAssertion> .)\n")
      ;; A chain on a blank node that is no inverse names no property.
      (decodes-exactly arena "chain on a blank subject"
        "_:p owl:propertyChainAxiom ( :r :s ) ."
        "owl:propertyChainAxiom on a non-IRI subject\n")
      ;; Reserved vocabulary as an assertion's SOURCE, as for its target.
      (decodes-exactly arena "reserved source of an assertion"
        "owl:Thing :r :b ."
        "ReservedVocabulary(<http://www.w3.org/2002/07/owl#Thing> <http://example.org/t#r> <http://example.org/t#b> .)\n")
      ;; Of several malformed triples, the LAST in document order is the
      ;; fault reported: a function of the document, and pinned.
      (decodes-exactly arena "the last fault wins"
        "_:p rdfs:domain :A . :r owl:inverseOf _:q ."
        "owl:inverseOf with a non-IRI object\n")
      ;; The data lemma (§5.2). A use climbs the told hierarchy to its top
      ;; however the document orders it: written top-down, it takes a
      ;; second pass, so d3 is used and its domain is no inert axiom.
      (decodes-exactly arena "a use climbs every level of the data hierarchy"
        ":d3 a owl:DatatypeProperty . :d2 rdfs:subPropertyOf :d3 . :d rdfs:subPropertyOf :d2 . :d3 rdfs:domain :A . :a :d \"x\" ."
        "DataAxiom(<http://example.org/t#d2> <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <http://example.org/t#d3> .)\nDataAxiom(<http://example.org/t#d> <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <http://example.org/t#d2> .)\nDataAxiom(<http://example.org/t#d3> <http://www.w3.org/2000/01/rdf-schema#domain> <http://example.org/t#A> .)\nDataAxiom(<http://example.org/t#a> <http://example.org/t#d> \"x\" .)\n")
      ;; An equivalence carries a use both ways.
      (decodes-exactly arena "an equivalence carries a use both ways"
        ":d owl:equivalentProperty :d2 . :d rdfs:domain :A . :a :d2 \"x\" ."
        "DataAxiom(<http://example.org/t#d> <http://www.w3.org/2002/07/owl#equivalentProperty> <http://example.org/t#d2> .)\nDataAxiom(<http://example.org/t#d> <http://www.w3.org/2000/01/rdf-schema#domain> <http://example.org/t#A> .)\nDataAxiom(<http://example.org/t#a> <http://example.org/t#d2> \"x\" .)\n")
      ;; owl:bottomDataProperty unused is idle: its domain is inert.
      (decodes-exactly arena "an unused bottom data property is idle"
        "owl:bottomDataProperty rdfs:domain :A ."
        "")))

  (fn test-sort-is-stable ((arena Arena))
    (@intent "Ties keep their input order — what §6.8 determinism rests on")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Stability is INVISIBLE through `sort-iris`: `iri-cmp` is a total
    ;; order, so two elements that tie are byte-identical and any
    ;; permutation of them looks correct. It is observable only through a
    ;; comparator that returns 0 for elements the test can still tell
    ;; apart, which is what the raw `sort-range` entry point allows.
    ;;
    ;; This is not a tidiness property. A comparator here may legitimately
    ;; tie two DISTINCT values — `missing-declaration-cmp` ties on equal
    ;; referring-lists, and an out-of-profile omission list can hold two
    ;; entries a comparator does not separate. If ties resolved by run
    ;; boundaries, their order would be a function of list LENGTH, and
    ;; §6.8 requires the report to be a function of content alone.
    ;;
    ;; The key descends in blocks of three, so a correct sort must move
    ;; every block and a stable answer is NOT the identity permutation:
    ;;   indices 0 1 2 -> key 2  |  3 4 5 -> key 1  |  6 7 8 -> key 0
    ;; Stable ascending order is therefore exactly 6 7 8 3 4 5 0 1 2; an
    ;; unstable sort still orders the blocks but scrambles within one.
    (let ((idx (sort-range arena 9
                 (fn ((a Int) (b Int))
                   (let ((ka (- 2 (/ a 3)))
                         (kb (- 2 (/ b 3))))
                     (cond ((< ka kb) -1)
                           ((> ka kb) 1)
                           (else 0))))))
          (mut expect (list-new arena Int))
          (mut ok true)
          (mut i 0))
      (do
        (list-push expect 6) (list-push expect 7) (list-push expect 8)
        (list-push expect 3) (list-push expect 4) (list-push expect 5)
        (list-push expect 0) (list-push expect 1) (list-push expect 2)
        (if (!= (cast Int (list-len idx)) 9) (set! ok false) (do))
        (while (< i 9)
          (do
            (if (!= (int-at idx i) (int-at expect i)) (set! ok false) (do))
            (set! i (+ i 1))))
        ok)))

  (fn test-sort-is-a-permutation ((arena Arena))
    (@intent "Sorting preserves length and multiset — nothing dropped, nothing invented")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; This is the obligation `sort-range` states but cannot prove: the
    ;; buffers are filled by `list-push` in a loop and then permuted by
    ;; `list-set`, and slop#124 withholds the provenance axioms for any
    ;; body that calls `list-set`. Duplicates are included deliberately —
    ;; a sort that silently deduplicated would still pass a
    ;; sortedness-only test while changing the report.
    (let ((mut xs (list-new arena IRI)))
      (do
        (list-push xs (mk-iri "b"))
        (list-push xs (mk-iri "a"))
        (list-push xs (mk-iri "b"))
        (list-push xs (mk-iri "c"))
        (list-push xs (mk-iri "a"))
        (let ((s (sort-iris arena xs))
              (mut ok true)
              (mut i 0)
              (n (cast Int (list-len xs))))
          (do
            (if (!= (cast Int (list-len s)) 5) (set! ok false) (do))
            ;; every input element occurs in the output
            (while (< i n)
              (let ((mut found false)
                    (mut j 0))
                (do
                  (while (< j 5)
                    (do
                      (if (== (iri-cmp (iri-at xs i) (iri-at s j)) 0)
                        (set! found true) (do))
                      (set! j (+ j 1))))
                  (if found (do) (set! ok false))
                  (set! i (+ i 1)))))
            ;; a a b b c
            (if (!= (iri-cmp (iri-at s 0) (mk-iri "a")) 0) (set! ok false) (do))
            (if (!= (iri-cmp (iri-at s 1) (mk-iri "a")) 0) (set! ok false) (do))
            (if (!= (iri-cmp (iri-at s 4) (mk-iri "c")) 0) (set! ok false) (do))
            ok)))))

  (fn print-test-result ((name String) (passed Bool))
    (@intent "Print a test result with a pass/fail indicator")
    (@spec ((String Bool) -> Unit))
    (if passed
      (do (print "[PASS] ") (println name))
      (do (print "[FAIL] ") (println name))))

  ;; ------------------------------------------------------------
  ;; sriq-dump: a normaliser stage as OWL 2 functional syntax, for the
  ;; normaliser differential (SPEC §10, corpus/elimcheck.py). It prints
  ;; one document to stdout; Python writes the file. With no arguments,
  ;; main runs the suite as before.
  ;; ------------------------------------------------------------

  (fn arg-text ((argv (Ptr (Ptr U8))) (i Int))
    (@intent "argv[i] as a String")
    (@spec (((Ptr (Ptr U8)) Int) -> String))
    (let ((ptr (@ argv i)))
      (String ptr (strlen ptr))))

  (fn dump-classes ((arena Arena) (sig Signature))
    (@intent "The input's class names but ⊤ and ⊥, sorted: every stage's document declares them")
    (@spec ((Arena Signature) -> (List IRI)))
    (@alloc arena)
    (let ((mut out (list-new arena IRI)))
      (do
        (for-each (c (set-elements (. sig classes)))
          (when (not (or (string-eq (. c value) OWL_THING) (string-eq (. c value) OWL_NOTHING)))
            (list-push out c)))
        (sort-iris arena out))))

  (fn print-lines ((ls (List String)))
    (@intent "Each line to stdout; 0")
    (@spec (((List String)) -> Int))
    (do (for-each (l ls) (println l)) 0))

  (fn dump-refused ((m String))
    (@intent "A stage that has no document, and why; 2")
    (@spec ((String) -> Int))
    (do (print "refused: ") (println m) 2))

  (fn dump-s1 ((arena Arena) (gr GateResult) (r (Result S0 String)) (bound Int))
    (@intent "S1's output, after S0's")
    (@spec ((Arena GateResult (Result S0 String) Int) -> Int))
    (@alloc arena)
    (match r
      ((error m) (dump-refused m))
      ((ok s0)
        (match (sriq-s1 arena s0 bound)
          ((error m) (dump-refused m))
          ((ok s1)   (print-lines (fss-axioms arena (dump-classes arena (. gr signature)) (. s1 axioms))))))))

  (fn dump-s1-invariants ((arena Arena) (gr GateResult) (bound Int))
    (@intent "S1's promises on this input: each failure printed; 0 when they all hold")
    (@spec ((Arena GateResult Int) -> Int))
    (@alloc arena)
    (match (sriq-s0 arena (. gr accepted))
      ((error m) (dump-refused m))
      ((ok s0)
        (match (sriq-s1 arena s0 bound)
          ((error m) (dump-refused m))
          ((ok s1)
            (let ((bad (sriq-s1-invariants arena (. s0 rbox) (. s0 axioms) s1)))
              (do (for-each (b bad) (println b))
                  (if (== (list-len bad) 0) (do (println "ok") 0) 1))))))))

  (fn s1-guarded ((arena Arena) (gr GateResult) (bound Int))
    (@intent "Did S1's size guard trip on this input?")
    (@spec ((Arena GateResult Int) -> Bool))
    (@alloc arena)
    (match (sriq-s0 arena (. gr accepted))
      ((error _) false)
      ((ok s0)
        (match (sriq-s1 arena s0 bound)
          ((error _) false)
          ((ok s1)   (> (list-len (. s1 omitted)) 0))))))

  (fn uses-reserved ((arena Arena) (sig Signature))
    (@intent "Does the input name anything under urn:howl:, which the dump uses for HOWL's own names?")
    (@spec ((Arena Signature) -> Bool))
    (@alloc arena)
    (let ((mut found false))
      (do
        (for-each (c (set-elements (. sig classes)))     (when (starts-with (. c value) "urn:howl:") (set! found true)))
        (for-each (r (set-elements (. sig obj-props)))   (when (starts-with (. r value) "urn:howl:") (set! found true)))
        (for-each (i (set-elements (. sig individuals))) (when (starts-with (. i value) "urn:howl:") (set! found true)))
        found)))

  (fn clauses-report ((arena Arena) (sc SriqClauses))
    (@intent "ok and the clause count, else each failure; 0 or 1")
    (@spec ((Arena SriqClauses) -> Int))
    (@alloc arena)
    (let ((bad (ids-dense arena sc))
          (mut shape 0))
      (do
        (for-each (c (. sc clauses)) (when (not (and (dl-clause-shape c) (clause-canonical c))) (set! shape (+ shape 1))))
        (for-each (b bad) (do (print "FAILED ") (println b)))
        (when (> shape 0) (do (print "FAILED not canonical DL-clauses: ") (println (int-to-string arena shape))))
        (if (and (== (list-len bad) 0) (== shape 0))
          (do (print "ok ") (println (int-to-string arena (cast Int (list-len (. sc clauses))))) 0)
          1))))

  (fn clauses-check ((arena Arena) (r (Result SriqNormal String)))
    (@intent "The clause boundary's promises on one document")
    (@spec ((Arena (Result SriqNormal String)) -> Int))
    (@alloc arena)
    (match r
      ((error m) (dump-refused m))
      ((ok n)
        (match (sriq-clauses arena n)
          ((error m) (do (print "FAILED ") (println m) 1))
          ((ok sc)   (clauses-report arena sc))))))

  (fn dump-stage ((arena Arena) (stage String) (gr GateResult) (bound Int))
    (@intent "One stage of a gated document: info, s0, s1 or s2, S1 under the bound")
    (@spec ((Arena String GateResult Int) -> Int))
    (@alloc arena)
    (cond
      ((and (not (string-eq stage "info")) (uses-reserved arena (. gr signature)))
        (dump-refused "reserved: the input names something under urn:howl:, which the dump uses for HOWL's own names"))
      ((string-eq stage "info")
        (do (print "omitted ") (println (int-to-string arena (cast Int (list-len (. gr omissions)))))
            (print "accepted ") (println (int-to-string arena (cast Int (list-len (. gr accepted)))))
            (when (s1-guarded arena gr bound) (println "s1-guarded yes"))
            (for-each (c (dump-classes arena (. gr signature))) (do (print "class ") (println (. c value))))
            0))
      ((string-eq stage "s0")
        (match (sriq-s0 arena (. gr accepted))
          ((error m) (dump-refused m))
          ((ok s0)   (print-lines (fss-axioms arena (dump-classes arena (. gr signature)) (. s0 axioms))))))
      ((string-eq stage "s1") (dump-s1 arena gr (sriq-s0 arena (. gr accepted)) bound))
      ((string-eq stage "s1-invariants") (dump-s1-invariants arena gr bound))
      ((string-eq stage "s2")
        (match (sriq-normalize-bounded arena (. gr accepted) (. gr signature) bound)
          ((error m) (dump-refused m))
          ((ok n)    (print-lines (fss-normal arena n)))))
      ((string-eq stage "clauses")
        (print-lines (clause-lines arena (sriq-normalize-bounded arena (. gr accepted) (. gr signature) bound))))
      ((string-eq stage "clauses-check")
        (clauses-check arena (sriq-normalize-bounded arena (. gr accepted) (. gr signature) bound)))
      (else (dump-refused "the stages are info, s0, s1, s1-invariants, s2, clauses and clauses-check"))))

  (fn sriq-dump ((arena Arena) (stage String) (path String) (bound Int))
    (@intent "A file, gated under sriq, then one stage of it")
    (@spec ((Arena String String Int) -> Int))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-sriq)
      ((none)    (dump-refused "the file did not parse or gate"))
      ((some gr) (dump-stage arena stage gr bound))))

  (fn bound-arg ((s String))
    (@intent "A whole number, or -1: 1–9 digits (parse-int alone accepts a prefix, and saturates on overflow)")
    (@spec ((String) -> Int))
    (let ((mut ok (and (> (string-len s) 0) (<= (string-len s) 9)))
          (mut i 0))
      (do
        (while (and ok (< i (string-len s)))
          (do (when (not (is-digit (char-at s i))) (set! ok false)) (set! i (+ i 1))))
        (if (not ok)
          -1
          (match (parse-int s) ((ok n) (cast Int n)) ((error _) -1))))))

  ;; ------------------------------------------------------------
  ;; front-dump: the front end on one file, stage by stage, each in its
  ;; own order: stage 0's triples and omissions, stage 1's axioms and
  ;; signature (or its fault), the regularity check, and under each rung
  ;; the gate's rewrites, accepted axioms, omissions and missing
  ;; declarations. The goldens see only sorted reports, never an order, a
  ;; fault's text or a rewrite, so a restructure of decode or the gate is
  ;; checked by this dump being byte-identical before and after, over
  ;; every fixture and the vendored corpus (graph Lesson 7309657b).
  ;; ------------------------------------------------------------

  (fn dump-tagged ((tag String) (text String))
    (@intent "One line: a tag, then the text; 0")
    (@spec ((String String) -> Int))
    (do (print tag) (println text) 0))

  (fn dump-axiom-list ((arena Arena) (tag String) (axs (List RawAxiom)))
    (@intent "Each axiom rendered on its own line, in the list's order")
    (@spec ((Arena String (List RawAxiom)) -> Int))
    (@alloc arena)
    (do (for-each (ax axs) (dump-tagged tag (render-axiom arena ax))) 0))

  (fn dump-axiom-ref ((tag String) (r AxiomRef))
    (@intent "A cited axiom's text, then its source ontology when it has one")
    (@spec ((String AxiomRef) -> Int))
    (match (. r source)
      ((some i) (do (dump-tagged tag (. r text)) (dump-tagged "  from " (. i value))))
      ((none)   (dump-tagged tag (. r text)))))

  (fn dump-cited ((tag String) (o Omission))
    (@intent "The axioms a missing declaration cites, in order: the report's line leaves them out")
    (@spec ((String Omission) -> Int))
    (match o
      ((missing-declaration md) (do (for-each (r (. md referring)) (dump-axiom-ref tag r)) 0))
      (_ 0)))

  (fn dump-omission-list ((arena Arena) (tag String) (os (List Omission)))
    (@intent "Each omission rendered on its own line, in the list's order, with what it cites")
    (@spec ((Arena String (List Omission)) -> Int))
    (@alloc arena)
    (let ((cites (string-concat arena tag "cites ")))
      (do
        (for-each (o os)
          (do (dump-tagged tag (render-omission arena o))
              (dump-cited cites o)))
        0)))

  (fn dump-fault ((arena Arena) (f Fault))
    (@intent "A fault as text; 1")
    (@spec ((Arena Fault) -> Int))
    (@alloc arena)
    (match f
      ((input-error m) (do (dump-tagged "fault input-error " m) 1))
      ((refused os)    (do (dump-omission-list arena "fault refused " os) 1))
      ((cancelled)     (do (println "fault cancelled") 1))
      ((unavailable _) (do (println "fault unavailable") 1))))

  (fn dump-signature ((arena Arena) (sig Signature))
    (@intent "The signature's sets, each in its own iteration order")
    (@spec ((Arena Signature) -> Int))
    (@alloc arena)
    (do
      (for-each (x (set-elements (. sig classes)))     (dump-tagged "sig class " (. x value)))
      (for-each (x (set-elements (. sig obj-props)))   (dump-tagged "sig obj-prop " (. x value)))
      (for-each (x (set-elements (. sig data-props)))  (dump-tagged "sig data-prop " (. x value)))
      (for-each (x (set-elements (. sig annot-props))) (dump-tagged "sig annot-prop " (. x value)))
      (for-each (x (set-elements (. sig individuals))) (dump-tagged "sig individual " (. x value)))
      (for-each (x (set-elements (. sig datatypes)))   (dump-tagged "sig datatype " (. x value)))
      0))

  (fn dump-triple ((arena Arena) (t IdTriple))
    (@intent "One stage-0 triple as its three term ids")
    (@spec ((Arena IdTriple) -> Int))
    (@alloc arena)
    (do (print "triple ") (print (int-to-string arena (. t s)))
        (print " ") (print (int-to-string arena (. t p)))
        (print " ") (println (int-to-string arena (. t o)))
        0))

  (fn dump-stage0 ((arena Arena) (s0 Stage0))
    (@intent "Stage 0's triples in order, its declared imports and its omissions")
    (@spec ((Arena Stage0) -> Int))
    (@alloc arena)
    (do
      (for-each (t (. s0 triples)) (dump-triple arena t))
      (for-each (i (. s0 imports-declared)) (dump-tagged "import " (. i value)))
      (dump-omission-list arena "stage0 omitted " (. s0 omissions))))

  (fn dump-regularity ((arena Arena) (axs (List RawAxiom)))
    (@intent "el's regularity check on the sugar-expanded axioms, as its own test reads it")
    (@spec ((Arena (List RawAxiom)) -> Int))
    (@alloc arena)
    (match (check-regularity arena (expand-sugar arena axs))
      ((rbox-regular)     (do (println "regularity regular") 0))
      ((rbox-irregular m) (dump-tagged "regularity irregular " m))))

  (fn dump-rung ((arena Arena) (s0 Stage0) (s1 Stage1) (p Profile) (tag String))
    (@intent "Under one rung: the gate's rewrites, accepted axioms, omissions and missing declarations")
    (@spec ((Arena Stage0 Stage1 Profile String) -> Int))
    (@alloc arena)
    (let ((expanded (drop-top-role-tautologies arena p
                      (expand-negation arena p (expand-sugar arena (. s1 axioms)))))
          (gr (gate-axioms arena (. s1 axioms) (. s1 signature) (. s0 omissions) p))
          (missing (missing-declarations arena (. s1 signature)
                     (collect-entity-refs arena (. gr accepted)))))
      (do
        (dump-axiom-list arena (string-concat arena tag " expanded ") expanded)
        (dump-axiom-list arena (string-concat arena tag " accepted ") (. gr accepted))
        (dump-omission-list arena (string-concat arena tag " omitted ") (. gr omissions))
        (dump-omission-list arena (string-concat arena tag " missing ") missing))))

  (fn dump-decoded ((arena Arena) (s0 Stage0) (s1 Stage1))
    (@intent "Stage 1's axioms, inert count and signature, then regularity and each rung")
    (@spec ((Arena Stage0 Stage1) -> Int))
    (@alloc arena)
    (do
      (dump-axiom-list arena "decoded " (. s1 axioms))
      (dump-tagged "inert " (int-to-string arena (. s1 inert)))
      (dump-signature arena (. s1 signature))
      (dump-regularity arena (. s1 axioms))
      (dump-rung arena s0 s1 'profile-el "el")
      (dump-rung arena s0 s1 'profile-el-plus-plus "el++")
      (dump-rung arena s0 s1 'profile-sriq "sriq")))

  (fn front-dump ((arena Arena) (path String))
    (@intent "The front end's stages on one file, for a restructure's before and after")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((error _) (do (println "parse error") 1))
      ((ok g)
        (match (stage0-header arena (. g triples) (list-new arena IRI))
          ((error f) (dump-fault arena f))
          ((ok s0)
            (do
              (dump-stage0 arena s0)
              (match (decode-axioms arena (. s0 dict) (. s0 triples))
                ((error f) (dump-fault arena f))
                ((ok s1)   (dump-decoded arena s0 s1)))))))))

  ;; ------------------------------------------------------------
  ;; ksc-dump: el++'s engine on one file, gated under el++ with its
  ;; omissions set aside, then normalised. At 1 and 4 workers: phase G's
  ;; and phase W's runs, each run's counters and then its store fact by
  ;; fact, and ksc-classify's result, every counter and every class's
  ;; answer, uncapped and under caps of 0 to 3 rounds. The goldens see only
  ;; the report, never a store, a phase's counters or a capped answer, so a
  ;; restructure of kscsat is checked by this dump being byte-identical
  ;; before and after (graph Lesson 7309657b).
  ;; ------------------------------------------------------------

  (fn yes-no ((b Bool))
    (@intent "A flag as yes or no")
    (@spec ((Bool) -> String))
    (@pure)
    (if b "yes" "no"))

  (fn dump-num ((arena Arena) (tag String) (n Int))
    (@intent "A tag, then a number, on the current line")
    (@spec ((Arena String Int) -> Int))
    (@alloc arena)
    (do (print tag) (print (int-to-string arena n)) 0))

  (fn dump-flag ((tag String) (b Bool))
    (@intent "A tag, then a flag, on the current line")
    (@spec ((String Bool) -> Int))
    (do (print tag) (print (yes-no b)) 0))

  (fn dump-cfact ((arena Arena) (c CFact))
    (@intent "One stored fact as its encoding: kind, then three ids")
    (@spec ((Arena CFact) -> Int))
    (@alloc arena)
    (do (dump-num arena "  fact " (cast Int (. c kind)))
        (dump-num arena " " (cast Int (. c a)))
        (dump-num arena " " (cast Int (. c b)))
        (dump-num arena " " (cast Int (. c c)))
        (println "")
        0))

  (fn dump-ksc-run ((arena Arena) (tag String) (r RunResult))
    (@intent "One phase's counters, then its store fact by fact")
    (@spec ((Arena String RunResult) -> Int))
    (@alloc arena)
    (do
      (print tag)
      (dump-num arena " rounds " (. r rounds))
      (dump-num arena " facts " (. r facts))
      (dump-flag " unsat " (. r unsat))
      (dump-flag " capped " (. r capped))
      (dump-flag " cancelled " (. r cancelled))
      (println "")
      (for-each (c (store-facts arena (. r store))) (dump-cfact arena c))
      0))

  (fn ksc-seeds ((arena Arena) (idx KscIndex) (classes (List KName)) (w-phase Bool))
    (@intent "Phase G's seeds, the individuals; phase W's add owl:Thing and every class, as classify-phases does")
    (@spec ((Arena KscIndex (List KName) Bool) -> (List KFact)))
    (@alloc arena)
    (let ((mut seeds (list-new arena KFact)))
      (do
        (for-each (a (. idx individuals)) (list-push seeds (. (ksc-1 a) fact)))
        (when w-phase
          (do
            (list-push seeds (. (ksc-q (union-new KName k-class (record-new IRI (value OWL_THING)))) fact))
            (for-each (q classes) (list-push seeds (. (ksc-q q) fact)))))
        seeds)))

  (fn dump-ksc-phases ((arena Arena) (idx KscIndex) (ids KscIds) (classes (List KName)) (w Int))
    (@intent "Phases G and W at w workers, uncapped, each with its store")
    (@spec ((Arena KscIndex KscIds (List KName) Int) -> Int))
    (@alloc arena)
    (let ((mut cas (list-new arena Arena))
          (mut k 0))
      (do
        (when (> w 1)
          (while (< k w) (do (list-push cas (arena-new 4096)) (set! k (+ k 1)))))
        (dump-ksc-run arena (string-concat arena "G w=" (int-to-string arena w))
          (run-ksc arena idx ids (none) (ksc-seeds arena idx classes false) true 10000 0 w cas))
        (dump-ksc-run arena (string-concat arena "W w=" (int-to-string arena w))
          (run-ksc arena idx ids (none) (ksc-seeds arena idx classes true) false 10000 0 w cas))
        (for-each (a cas) (arena-free a))
        0)))

  (fn dump-answer ((arena Arena) (a ClassAnswer))
    (@intent "One class's answer: its flags and counters, then its subsumers in order")
    (@spec ((Arena ClassAnswer) -> Int))
    (@alloc arena)
    (do
      (print "  answer ") (print (kname-label arena (. a cls)))
      (dump-flag " shared " (. a shared))
      (dump-flag " unsat " (. a unsat))
      (dump-flag " complete " (. a complete))
      (dump-num arena " rounds " (. a rounds))
      (dump-num arena " facts " (. a facts))
      (println "")
      (for-each (s (. a subsumers)) (do (print "    sub ") (println (kname-label arena s))))
      0))

  (fn dump-ksc-result ((arena Arena) (r KscResult))
    (@intent "ksc-classify's counters, its termination, then every answer in order")
    (@spec ((Arena KscResult) -> Int))
    (@alloc arena)
    (do
      (dump-flag "  inconsistent " (. r inconsistent))
      (dump-num arena " rounds " (. r rounds))
      (dump-num arena " g " (. r g-rounds))
      (dump-num arena "/" (. r g-facts))
      (dump-num arena " w " (. r w-rounds))
      (dump-num arena "/" (. r w-facts))
      (dump-num arena " unsafe " (. r unsafe-count))
      (match (. r termination)
        ((fixpoint)         (println " fixpoint"))
        ((resource-limit n) (do (dump-num arena " resource-limit " n) (println ""))))
      (for-each (a (. r answers)) (dump-answer arena a))
      0))

  (fn dump-ksc-classify ((arena Arena) (fx KscFixture) (w Int) (cap Int))
    (@intent "ksc-classify at w workers under a cap: every counter and every answer, or its fault")
    (@spec ((Arena KscFixture Int Int) -> Int))
    (@alloc arena)
    (let ((mut cfg (default-config)))
      (do
        (set! cfg worker-count (cast (Int 1 .. 64) w))
        (set! cfg max-iterations (cast (Int 0 .. 10000) cap))
        (dump-num arena "classify w=" w)
        (dump-num arena " cap " cap)
        (println "")
        (match (ksc-classify arena (. fx axioms) (. fx classes) cfg)
          ((error f) (dump-fault arena f))
          ((ok r)    (dump-ksc-result arena r))))))

  (fn dump-ksc-caps ((arena Arena) (fx KscFixture) (w Int))
    (@intent "ksc-classify at w workers, uncapped and under caps of 0 to 3 rounds")
    (@spec ((Arena KscFixture Int) -> Int))
    (@alloc arena)
    (do
      (dump-ksc-classify arena fx w 1000)
      (dump-ksc-classify arena fx w 0)
      (dump-ksc-classify arena fx w 1)
      (dump-ksc-classify arena fx w 2)
      (dump-ksc-classify arena fx w 3)))

  (fn ksc-dump ((arena Arena) (path String))
    (@intent "el++'s engine on one file, by phase and under caps, for a restructure's before and after")
    (@spec ((Arena String) -> Int))
    (@alloc arena)
    (match (gate-fixture-in arena path 'profile-el-plus-plus)
      ((none) (do (println "did not gate") 1))
      ((some gr)
        (let ((fx (record-new KscFixture
                    (axioms  (. (normalize-ksc arena (. gr accepted)) axioms))
                    (classes (input-classes arena (. gr signature)))))
              (idx (build-ksc-index arena (. fx axioms)))
              (ids (build-ksc-ids arena (. fx axioms) (. fx classes) (. idx individuals))))
          (do
            (dump-ksc-phases arena idx ids (. fx classes) 1)
            (dump-ksc-phases arena idx ids (. fx classes) 4)
            (dump-ksc-caps arena fx 1)
            (dump-ksc-caps arena fx 4))))))

  (fn main ((argc Int) (argv (Ptr (Ptr U8))))
    (@intent "Run the suite; or print a normaliser stage (`sriq-dump`, SPEC §10), the front end (`front-dump`), el++'s engine (`ksc-dump`) or sriq's reference evaluator (`sriq-ref`)")
    (@spec ((Int (Ptr (Ptr U8))) -> Int))
    :c-name "main"
    (cond
      ((== argc 1) (run-suite))
      ((and (== argc 4) (string-eq (arg-text argv 1) "sriq-dump"))
        (with-arena 4194304 (sriq-dump arena (arg-text argv 2) (arg-text argv 3) S1_BOUND)))
      ;; corpus/modules.py: HOWL's ⊥-module per seed line, against the OWL API's.
      ((and (== argc 4) (string-eq (arg-text argv 1) "module-dump"))
        (with-arena 4194304 (module-dump arena (arg-text argv 2) (arg-text argv 3))))
      ;; A bound for S1's guard, so the differential can check a guarded run.
      ((and (== argc 5) (string-eq (arg-text argv 1) "sriq-dump"))
        (let ((b (bound-arg (arg-text argv 4))))
          (if (< b 0)
            (do (println "the bound is a whole number") 2)
            (with-arena 4194304 (sriq-dump arena (arg-text argv 2) (arg-text argv 3) b)))))
      ((and (== argc 3) (string-eq (arg-text argv 1) "front-dump"))
        (with-arena 4194304 (front-dump arena (arg-text argv 2))))
      ((and (== argc 3) (string-eq (arg-text argv 1) "ksc-dump"))
        (with-arena 4194304 (ksc-dump arena (arg-text argv 2))))
      ((and (== argc 3) (string-eq (arg-text argv 1) "sriq-ref"))
        (with-arena 4194304 (sriq-ref arena (arg-text argv 2) "cautious" false false)))
      ((and (== argc 4) (string-eq (arg-text argv 1) "sriq-ref"))
        (with-arena 4194304 (sriq-ref arena (arg-text argv 2) (arg-text argv 3) false false)))
      ;; The prototype: howl-test sriq-run FILE [STRATEGY] [--counts].
      ((and (>= argc 3) (<= argc 10) (string-eq (arg-text argv 1) "sriq-run"))
        (with-arena 4194304 (sriq-run-args arena argc argv)))
      (else (do (println "usage: howl-test [sriq-dump STAGE FILE [BOUND] | front-dump FILE | ksc-dump FILE | sriq-ref FILE [STRATEGY] | sriq-run FILE [STRATEGY] [--counts] [--rounds N] [--no-defer] [--no-split] [--no-views]]") 2))))

  (fn sriq-run-args ((arena Arena) (argc Int) (argv (Ptr (Ptr U8))))
    (@intent "sriq-run FILE [STRATEGY] [--counts] [--rounds N] [--no-defer] [--no-split]: cautious unless a strategy is named; --rounds caps each run (n/a if it stops there), for probing a large input; --no-defer runs S6 without R8's deferral; --no-split runs the input as one run, without the ABox split; --no-views recomputes premise views every round (9k's baseline)")
    (@spec ((Arena Int (Ptr (Ptr U8))) -> Int))
    (@alloc arena)
    (let ((mut strat "cautious") (mut counts false) (mut rounds 10000) (mut defer true) (mut split true) (mut views true)
          (mut ok true) (mut i 3))
      (do (while (< i argc)
            (let ((a (arg-text argv i)))
              (cond ((string-eq a "--counts") (do (set! counts true) (set! i (+ i 1))))
                    ((string-eq a "--no-defer") (do (set! defer false) (set! i (+ i 1))))
                    ((string-eq a "--no-split") (do (set! split false) (set! i (+ i 1))))
                    ((string-eq a "--no-views") (do (set! views false) (set! i (+ i 1))))
                    ((string-eq a "--rounds")
                      (do (set! rounds (if (< (+ i 1) argc) (bound-arg (arg-text argv (+ i 1))) -1))
                          (when (< rounds 0) (set! ok false))
                          (set! i (+ i 2))))
                    (else (do (set! strat a) (set! i (+ i 1)))))))
          (if ok
            (sriq-proto arena (arg-text argv 2) strat counts rounds defer split views)
            (do (println "--rounds takes a whole number") 2)))))

  (fn run-suite ()
    (@intent "Run the verdict-discipline and structural-invariant tests")
    (@spec (() -> Int))
    (with-arena 4194304
      (let ((mut passed 0)
            (mut failed 0))
        (do
          (println "HOWL — verdict discipline & structural invariants")
          (println "========================================")

          (let ((r (test-coherent-requires-complete arena)))
            (print-test-result "verdict: complete + clean => coherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-omission-blocks-coherent arena)))
            (print-test-result "verdict: omission blocks coherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-cap-blocks-coherent arena)))
            (print-test-result "verdict: round cap blocks coherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-finding-beats-partial-coverage arena)))
            (print-test-result "verdict: finding beats partial coverage" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-consistent-but-incoherent arena)))
            (print-test-result "verdict: consistent-but-incoherent => incoherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-context-starts-with-empty-store arena)))
            (print-test-result "init: context store starts empty" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-emit-edge-addresses-both-halves arena)))
            (print-test-result "edges: emit-edge addresses both halves" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-litmus-end-to-end arena)))
            (print-test-result "§12 LITMUS: Turtle in, Mother subseteq Parent out, COHERENT" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-unattested-import-is-inconclusive arena)))
            (print-test-result "§12(b) e2e: a dangling import is INCONCLUSIVE, never coherent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-declared-unused-class-gets-a-context arena)))
            (print-test-result "§12(c) e2e: a declared, unused class has a context" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-abox-disjoint-range-is-incoherent arena)))
            (print-test-result "identity fixture: disjoint ranges on one target => INCOHERENT" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-worker-count-does-not-change-the-report arena)))
            (print-test-result "M1 (e): the same report at W = 1 and W = 4, complete and capped" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-names-round-trip arena)))
            (print-test-result "saturation names: renaming inverts, keeps ⊤ and ⊥, keeps punning apart" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-commit-dedups-across-deltas arena)))
            (print-test-result "barrier: facts two workers share are committed once and queued once" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-entails-sub-agrees-with-report arena)))
            (print-test-result "differential: entails-sub answers every pair as the report does" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-undeclared-individual-is-reasoned-over arena)))
            (print-test-result "W3C DisjointClasses-002: undeclared individual is reasoned over" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-anonymous-class-assertion-is-read arena)))
            (print-test-result "W3C WebOnt-Restriction-001: anonymous class assertion is read" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-annotation-on-annotation-is-consumed arena)))
            (print-test-result "W3C AnnotationAnnotations-001: owl:Annotation is header" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-repeated-disjoint-member-is-positional arena)))
            (print-test-result "ELK DisjointSelf: repeated disjoint member is positional" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-logical-triple-on-header-node-is-not-swallowed arena)))
            (print-test-result "stage 0: a logical triple on a header node is not swallowed" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-litmus arena)))
            (print-test-result "§3.1 LITMUS: derives Mother ⊑ Parent" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-polarity-guard arena)))
            (print-test-result "polarity: wrong-direction fresh definition loses the litmus" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-cyclic-hierarchy-terminates arena)))
            (print-test-result "termination: A ⊑ B, B ⊑ A reaches fixpoint" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

          (let ((r (test-same-round-co-arrival arena)))
            (print-test-result "CR4: same-round co-arrival still concludes" r)
            (if r (set! passed (+ passed 1)) (set! failed (+ failed 1))))

