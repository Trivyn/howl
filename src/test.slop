      (6 "corpus/fixtures/el++/ksc-06.ttl")
      (7 "corpus/fixtures/el++/ksc-07.ttl")
      (8 "corpus/fixtures/el++/ksc-08.ttl")
      (9 "corpus/fixtures/el++/ksc-09.ttl")
      (10 "corpus/fixtures/el++/ksc-10.ttl")
      (11 "corpus/fixtures/el++/ksc-11.ttl")
      (12 "corpus/fixtures/el++/ksc-12.ttl")
      (13 "corpus/fixtures/el++/ksc-13.ttl")
      (14 "corpus/fixtures/el++/ksc-14.ttl")
      (15 "corpus/fixtures/el++/ksc-15.ttl")
      (16 "corpus/fixtures/el++/ksc-16.ttl")
      (17 "corpus/fixtures/el++/ksc-17.ttl")
      (18 "corpus/fixtures/el++/ksc-18.ttl")
      (19 "corpus/fixtures/el++/ksc-19.ttl")
      (20 "corpus/fixtures/el++/ksc-20.ttl")
      (21 "corpus/fixtures/el++/ksc-21.ttl")
      (22 "corpus/fixtures/el++/ksc-22.ttl")
      (23 "corpus/fixtures/el++/ksc-23.ttl")
      (24 "corpus/fixtures/el++/ksc-24.ttl")
      (25 "corpus/fixtures/el++/ksc-25.ttl")
      (26 "corpus/fixtures/el++/ksc-26.ttl")
      (27 "corpus/fixtures/el++/ksc-27.ttl")
      (28 "corpus/fixtures/el++/ksc-28.ttl")
      (29 "corpus/fixtures/el++/ksc-29.ttl")
      (30 "corpus/fixtures/el++/ksc-30.ttl")
      (31 "corpus/fixtures/el++/ksc-31.ttl")
      (32 "corpus/fixtures/el++/ksc-32.ttl")
      (33 "corpus/fixtures/el++/ksc-33.ttl")
      (34 "corpus/fixtures/el++/ksc-34.ttl")
      (35 "corpus/fixtures/el++/ksc-35.ttl")
      (36 "corpus/fixtures/el++/ksc-36.ttl")
      (37 "corpus/fixtures/el++/ksc-37.ttl")
      (_ "")))

  ;; ------------------------------------------------------------
  ;; Two engine properties no differential sees: the reference has no
  ;; caps and no phases, and every worker count agrees on these.
  ;; ------------------------------------------------------------

  (fn cap-config ((cap Int))
    (@intent "The default configuration under a round cap")
    (@spec ((Int) -> ReasonerConfig))
    (let ((mut cfg (default-config)))
      (do (set! cfg max-iterations (cast (Int 0 .. 10000) cap)) cfg)))

  (fn incomplete-answers ((r KscResult))
    (@intent "How many of a result's answers the cap cut short")
    (@spec ((KscResult) -> Int))
    (let ((mut n 0))
      (do (for-each (a (. r answers)) (when (not (. a complete)) (set! n (+ n 1)))) n)))

  (fn says-resource-limit ((r KscResult))
    (@intent "Does the result report that the cap stopped it?")
    (@spec ((KscResult) -> Bool))
    (match (. r termination)
      ((resource-limit _) true)
      ((fixpoint)         false)))

  (fn capped-incomplete ((arena Arena) (fx KscFixture))
    (@intent "Over every cap up to the uncapped run's rounds: incomplete answers seen, or -1 if one came without resource-limit")
    (@spec ((Arena KscFixture) -> Int))
    (@alloc arena)
    (let ((full (ksc-run arena (. fx axioms) (. fx classes) (default-config)))
          (mut seen 0)
          (mut cap 0))
      (do
        (while (and (>= seen 0) (<= cap (. full rounds)))
          (let ((r (ksc-run arena (. fx axioms) (. fx classes) (cap-config cap)))
                (k (incomplete-answers r)))
            (do
              (if (and (> k 0) (not (says-resource-limit r)))
                (set! seen -1)
                (set! seen (+ seen k)))
              (set! cap (+ cap 1)))))
        seen)))

  (fn test-ksc-cut-runs-say-resource-limit ((arena Arena))
    (@intent "At every cap, an answer the cap cut short comes with resource-limit, and some cap cuts one")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Every worker count agrees on a capped report, so the determinism
    ;; suite cannot see a cut class run reported as a fixpoint; and the
    ;; uncapped goldens never cut one. This reads the flag directly.
    (let ((mut ok true)
          (mut seen 0)
          (mut i 0))
      (do
        (while (< i (ksc-fixture-count))
          (do
            (match (ksc-fixture arena (ksc-fixture-at i))
              ((none) (set! ok false))
              ((some fx)
                (let ((k (capped-incomplete arena fx)))
                  (if (< k 0) (set! ok false) (set! seen (+ seen k))))))
            (set! i (+ i 1))))
        (and ok (> seen 0)))))

  (fn ex-class-fact ((arena Arena) (ind String) (cls String))
    (@intent "inst(ind, cls) over two http://example.org/t# names")
    (@spec ((Arena String String) -> KFact))
    (@alloc arena)
    (union-new KFact f-inst
      (ind-elem (record-new IRI (value (string-concat arena "http://example.org/t#" ind))))
      (name-term (union-new KName k-class (record-new IRI (value (string-concat arena "http://example.org/t#" cls)))))))

  (fn test-ksc-g-stops-at-bottom ((arena Arena))
    (@intent "K3: phase G stops committing at a round's first ⊥: on ksc-37, inst(a, F) is stored and inst(a, G), after the ⊥, is not")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; The facts G stores reach no report, so only this sees a G that
    ;; commits past its ⊥.
    (match (ksc-fixture arena "corpus/fixtures/el++/ksc-37.ttl")
      ((none) false)
      ((some fx)
        (let ((idx (build-ksc-index arena (. fx axioms)))
              (ids (build-ksc-ids arena (. fx axioms) (. fx classes) (. idx individuals)))
              (g (run-ksc arena idx ids (none) (ksc-seeds arena idx (. fx classes) false) true 10000 0 1
                   (list-new arena Arena))))
          (and (. g unsat)
               (store-holds (. g store) (none) (ex-class-fact arena "a" "F"))
               (not (store-holds (. g store) (none) (ex-class-fact arena "a" "G"))))))))

  (fn test-ksc-engine-matches-reference ((arena Arena))
    (@intent "On every el++ fixture, the engine and the literal reference agree on every class")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true)
          (mut i 0))
      (do
        (while (< i (ksc-fixture-count))
          (do
            (when (not (ksc-engine-matches-reference arena
                         (string-concat arena "fixture " (int-to-string arena i)) (ksc-fixture-at i)))
              (set! ok false))
            (set! i (+ i 1))))
        ok)))

  (fn test-ksc-entailments ((arena Arena))
    (@intent "The el++ fixtures' pinned answers: §5.4's constructs reason as the Direct Semantics says")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((mut ok true))
      (do
        (when (not (== (ksc-holds arena (ksc-fixture-at 0) "http://example.org/t#Mother" "http://example.org/t#Parent") 1))
          (do (println "  [ksc] litmus: Mother ⊑ Parent") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 1) "http://example.org/t#A" "http://example.org/t#B") 1))
          (do (println "  [ksc] KKS12 Example 5: A ⊑ B") (set! ok false)))
        (when (not (== (ksc-inconsistent arena (ksc-fixture-at 2)) 1))
          (do (println "  [ksc] ⊤ ⊑ ⊥ with no individuals is inconsistent") (set! ok false)))
        (when (not (== (ksc-inconsistent arena (ksc-fixture-at 3)) 0))
          (do (println "  [ksc] K3 example is consistent") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 3) "http://example.org/t#Q" "http://www.w3.org/2002/07/owl#Nothing") 1))
          (do (println "  [ksc] K3 example: Q is unsatisfiable, ⊥ at a") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 3) "http://example.org/t#A" "http://www.w3.org/2002/07/owl#Nothing") 0))
          (do (println "  [ksc] K3 example: A is satisfiable") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 4) "http://example.org/t#C" "http://example.org/t#E") 1))
          (do (println "  [ksc] Self with a chain: C ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 5) "http://example.org/t#C" "http://example.org/t#D") 1))
          (do (println "  [ksc] reflexive: C ⊑ D") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 5) "http://example.org/t#X" "http://example.org/t#D") 1))
          (do (println "  [ksc] transitive: X ⊑ D") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 6) "http://example.org/t#Q" "http://example.org/t#C") 1))
          (do (println "  [ksc] sameAs: Q ⊑ C") (set! ok false)))
        (when (not (== (ksc-inconsistent arena (ksc-fixture-at 7)) 1))
          (do (println "  [ksc] sameAs with differentFrom is inconsistent") (set! ok false)))
        (when (not (== (ksc-inconsistent arena (ksc-fixture-at 8)) 1))
          (do (println "  [ksc] a negative assertion against its assertion is inconsistent") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 9) "http://example.org/t#C" "http://example.org/t#E") 1))
          (do (println "  [ksc] hasValue: C ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 10) "http://example.org/t#C" "http://example.org/t#E") 1))
          (do (println "  [ksc] range: C ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 11) "http://example.org/t#C" "http://www.w3.org/2002/07/owl#Nothing") 1))
          (do (println "  [ksc] empty role: C unsatisfiable") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 11) "http://example.org/t#D" "http://www.w3.org/2002/07/owl#Nothing") 0))
          (do (println "  [ksc] empty role: D satisfiable") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 12) "http://example.org/t#Q" "http://example.org/t#E") 1))
          (do (println "  [ksc] role assertion through a nominal: Q ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 13) "http://example.org/t#C" "http://example.org/t#D") 1))
          (do (println "  [ksc] Self on the left: C ⊑ D") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 13) "http://example.org/t#C" "http://example.org/t#E") 1))
          (do (println "  [ksc] Self under a role hierarchy: C ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 21) "http://example.org/t#C" "http://example.org/t#E") 1))
          (do (println "  [ksc] chain legs under sub-roles, first leg first: C ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 21) "http://example.org/t#C2" "http://example.org/t#E") 1))
          (do (println "  [ksc] chain legs under sub-roles, second leg first: C2 ⊑ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 21) "http://example.org/t#X" "http://example.org/t#E") 0))
          (do (println "  [ksc] chain legs under sub-roles: X ⋢ E") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 22) "http://example.org/t#Q" "http://example.org/t#D") 1))
          (do (println "  [ksc] Self on a sub-role reaches a super-role's range: Q ⊑ D") (set! ok false)))
        (when (not (== (ksc-holds arena (ksc-fixture-at 22) "http://example.org/t#Q" "http://example.org/t#F") 1))
          (do (println "  [ksc] Self on a sub-role through (14): Q ⊑ F") (set! ok false)))
