;; ============================================================
;; HOWL Core Types  —  SPEC.md §6.2 (Data model)
;;
;; Concept and role expressions, the normal form, context-owned
;; saturation state, and the result/fault types.
;;
;; Shared by every other module; declared here so the front end,
;; the rules, and the driver do not form a dependency cycle.
;; ============================================================

(module types
  (@doc "Core type definitions for the HOWL description-logic reasoner")

  (import rdf (IRI))
  (import vocab (OWL_THING OWL_NOTHING))

  (export
    ;; identity
    Node
    RoleId
    ;; expressions and normal form
    Concept
    NormAxiom
    KName KTerm KscAxiom
    KElem KFact
    ;; saturation
    Derived
    Addressed
    LogicalEdge
    Context
    Queue
    Saturation
    ;; coverage / reporting
    EntityKind
    EdgePair
    AxiomRef
    InputRef
    MissingDeclaration
    Omission
    Coverage
    Termination
    SubPair
    Findings
    Outcome
    Fault
    Names
    ;; configuration
    Profile
    ProfileSelection
    ReasonerConfig
    ;; helpers
    default-config
    node-top
    node-bottom
    node-eq
    role-eq
    kname-eq kterm-eq kelem-eq kfact-eq
    name-term nominal-term ind-elem aux-elem class-elem
    thing-term nothing-term
    derived-eq
    addressed-eq
    emit-edge
    make-context
    make-queue
    empty-names
    copy-iri
    copy-node
    copy-role
    copy-input-ref
    copy-omissions
    copy-fault
    intern-node
    intern-role
    renamed-node
    original-node
    original-role
    queue-is-active
    outcome-is-complete
    findings-are-incoherent)

  ;; ============================================================
  ;; Internal identity
  ;;
  ;; NOT a bare IRI. OWL permits punning, so one IRI can denote a
  ;; class AND an individual in the same ontology; §5.2's ABox
  ;; encoding would otherwise merge them, and a class `:x ⊑ ⊥`
  ;; would drag an unrelated individual `:x` into a FALSE
  ;; inconsistency. Tagging keeps the populations disjoint by
  ;; construction rather than by convention.
  ;;
  ;; `fresh-node` is a constructor, not a synthesized IRI: freshness
  ;; is then a type guarantee instead of a naming convention that an
  ;; adversarial or merely unlucky input can collide with.
  ;; ============================================================

  (type Node (union
    (class-node      IRI)
    (individual-node IRI)
    (fresh-node      (Int 0 ..))))

  ;; Roles need the same treatment for the same reason: decomposing
  ;; an n-ary property chain into binary steps introduces fresh
  ;; intermediate roles, and a synthesized role IRI could collide
  ;; with a real one. Role punning against a class or individual name
  ;; stays harmless — roles never share an index with nodes — so only
  ;; freshness needs representing here, not the class/individual split.
  (type RoleId (union
    (named-role IRI)
    (fresh-role (Int 0 ..))))

  ;; ============================================================
;; MULTI-PAYLOAD UNION VARIANTS: FIXED IN SLOP 0.2.1, AND WHY THE DESIGN
;; STILL DOES NOT DEPEND ON IT.
;;
;; Through slop 0.1.2 the transpiler registered only a variant's FIRST payload
;; type for generated eq/hash and emitted no multi-field branch, so for
;; `(derived-succ RoleId Node)` it produced
;;
;;     case types_Derived_derived_succ:
;;         return slop_eq_types_RoleId(&_a->data.derived_succ, ...);
;;
;; — comparing the role and NEVER the node. `(derived-succ r Y₁)` and
;; `(derived-succ r Y₂)` were equal to a `(Set Derived)`, so every filler after
;; the first was swallowed by a novelty test. It compiled clean and
;; under-derived in silence (slop-lang/slop#66, fixed in 0.2.1 and verified
;; here by direct test).
;;
;; The driver still keys its round delta on `Node`/`RoleId` only, and that is
;; no longer a workaround — it is the shape the commit-at-barrier design wants
;; anyway, since the delta mirrors `Context` field-for-field and commit is three
;; parallel loops with no translation step. Nothing was reverted because
;; nothing was bent out of shape to begin with.
;;
;; `derived-eq` / `addressed-eq` below likewise stay. Generated `==` is correct
;; again, but the explicit forms spell out the CROSS-VARIANT arms — that
;; `(derived-succ r y)` is not `(derived-pred r y)` — which is the part a reader
;; has to trust rather than read when it is generated.
;; ============================================================

;; ⊤ and ⊥ are reserved NODES, not reserved IRIs:
  ;;   ⊤ = (class-node owl:Thing)     ⊥ = (class-node owl:Nothing)
  ;; Both are class-tagged, and owl:Nothing can never name an
  ;; individual (OWL 2 reserves it), so ⊥ has no punning hazard.

  ;; ============================================================
  ;; Concept expressions (pre-normalization)
  ;;
  ;; Atoms carry a `Node`, not a bare IRI, so the tags assigned at
  ;; decode survive into normalization — otherwise the ABox encoding
  ;; cannot state `individual(a) ⊑ C` at all.
  ;; ============================================================

  ;; `exists` rather than the spec's `some`: `some` is Option's
  ;; built-in constructor, and shadowing it makes every `(some x)` in
  ;; this codebase ambiguous to a reader even where the compiler
  ;; disambiguates. Same constructor, unshadowed name.
  (type Concept (union
    (top)
    (bottom)
    (atom   Node)
    (and    (List Concept))
    (exists RoleId (Ptr Concept))))   ; ∃r.C

  ;; ============================================================
  ;; EL normal form — the output of normalization (§6.3)
  ;;
  ;; Operands are Node/RoleId rather than Concept/RoleId: eliminating
  ;; STRUCTURE is normalization's job, while preserving IDENTITY is
  ;; the tags' job. Flattening both at once reintroduces the punning
  ;; bug the tags exist to prevent. So `A ⊓ B ⊑ ⊥` is simply
  ;; (sub-and A B ⊥) with ⊥ the reserved node above — no special case
  ;; in rule code.
  ;;
  ;; No range constructor: ranges are ELIMINATED during normalization
  ;; by the published construction (§5.2), so they never reach normal
  ;; form. Domain needs none either — domain(r) ⊑ A desugars to
  ;; (sub-some-lhs r ⊤ A).
  ;; ============================================================

  (type NormAxiom (union
    (sub-name     Node Node)              ; A ⊑ B
    (sub-and      Node Node Node)         ; A₁ ⊓ A₂ ⊑ B
    (sub-some-rhs Node RoleId Node)       ; A ⊑ ∃r.B
    (sub-some-lhs RoleId Node Node)       ; ∃r.B ⊑ A
    (sub-role     RoleId RoleId)          ; r ⊑ s
    (role-chain   RoleId RoleId RoleId))) ; r ∘ s ⊑ t

  ;; ============================================================
  ;; el++ normal form — [Krö10] Definition 1, read as Fig. 2's EDB facts
  ;; (SPEC §5.4 K1)
  ;;
  ;; DEFINITION 1 IS ENFORCED BY THE TYPES, not checked after the fact.
  ;; Its only constraints are which positions may hold a nominal and that
  ;; a supEx witness is a fresh constant. So every position Definition 1
  ;; reserves for a class name (its A, B, C, D ∈ NC) takes a `KName`,
  ;; which cannot be an individual; only subClass takes a `KTerm`, which
  ;; can be the nominal {a}; a role assertion takes two individuals; and
  ;; a witness is a fresh id. An axiom outside the normal form cannot be
  ;; constructed, so the type checker discharges "in normal form" at
  ;; every place an axiom is built — the verifier could not: it checks
  ;; each function alone and does not check a callee's @pre at a call.
  ;;
  ;; ⊤ and ⊥ are the class names owl:Thing and owl:Nothing, with
  ;; top(owl:Thing) and bot(owl:Nothing) supplied by the engine, so
  ;; `⊤ ⊑ C`, `A ⊑ ⊥`, `C(a)`, `{a} ⊑ C`, `A ⊑ {c}` and `{a} ⊑ {c}` are
  ;; all `k-sub`. No role conjunction and no product on the left: OWL has
  ;; no syntax that reaches them here (§5.4), so neither has a variant.
  ;; ============================================================

  (type KName (union
    (k-class IRI)            ; a class name of the input, or owl:Thing / owl:Nothing
    (k-fresh (Int 0 ..))))   ; a definitional name the normaliser minted

  (type KTerm (union
    (k-name    KName)        ; A
    (k-nominal IRI)))        ; {a}

  (type KscAxiom (union
    (k-sub          KTerm KTerm)                   ; subClass   A ⊑ C, C(a), {a} ⊑ C, A ⊑ {c}, {a} ⊑ {c}
    (k-and          KName KName KName)             ; subConj    A ⊓ B ⊑ C
    (k-some-lhs     RoleId KName KName)            ; subEx      ∃R.A ⊑ C
    (k-some-rhs     KName RoleId KName (Int 0 ..)) ; supEx      A ⊑ ∃R.B, with its fresh witness
    (k-self-lhs     RoleId KName)                  ; subSelf    ∃R.Self ⊑ C
    (k-self-rhs     KName RoleId)                  ; supSelf    A ⊑ ∃R.Self
    (k-role         RoleId RoleId)                 ; subRole    R ⊑ T
    (k-chain        RoleId RoleId RoleId)          ; subRChain  R ∘ S ⊑ T
    (k-range        RoleId KName)                  ; supProd    R ⊑ ⊤ × D
    (k-role-assert  IRI RoleId IRI)))              ; R(a, b) ↦ supEx(a, R, b, b) — §5.4's Fig. 2 erratum

  ;; ============================================================
  ;; el++ facts — Kinst's IDB, [Krö10] Fig. 3 (SPEC §5.4)
  ;;
  ;; An ELEMENT is a constant in the first position of a fact: an
  ;; individual a (nom(a)), the witness constant aux of a supEx axiom, or
  ;; the test individual q of a run (Theorem 2's inst(q, q, q)). A class
  ;; name occurs there ONLY as its run's q (§5.4 K2 point 2), and the tag
  ;; keeps it apart from an individual of the same IRI.
  ;;
  ;; The class position of inst is a KTerm: a class name, or a nominal {a}
  ;; - inst(x, {a}) is "x = a", which rules (27)-(29) read.
  ;; ============================================================

  (type KElem (union
    (e-ind   IRI)              ; an individual a
    (e-aux   (Int 0 ..))       ; the witness of the supEx axiom that minted this id
    (e-class KName)))          ; the test individual q of q's run

  (type KFact (union
    (f-inst   KElem KTerm)          ; inst(x, y)
    (f-triple KElem RoleId KElem)   ; triple(x, v, x′)
    (f-self   KElem RoleId)))       ; self(x, v)

  ;; ============================================================
  ;; Saturation state — the DL analogue of GROWL's Delta
  ;;
  ;; ELK's decomposition makes the CONTEXT — one concept plus
  ;; everything derived about it — the unit of both storage and
  ;; parallel work. Per-concept facts therefore live in the context
  ;; that owns them; there are no global S(·)/R(·) maps to contend on.
  ;; ============================================================

  ;; A derived conclusion in transit, always addressed to exactly one
  ;; context. The destination rides in the envelope, so it is not
  ;; repeated in every payload.
  (type Derived (union
    (derived-sub  Node)            ; add this node to the target's S(·)
    (derived-succ RoleId Node)     ; target gains a successor:   (role, node)
    (derived-pred RoleId Node)))   ; target gains a predecessor: (role, node)

  (type Addressed (record
    (to   Node)
    (what Derived)))

  ;; ONE logical edge (X,Y) ∈ R(r), before the context decomposition
  ;; splits it in two.
  ;;
  ;; §6.4 requires the novelty test to run on the LOGICAL edge rather
  ;; than on either stored half — testing the halves separately lets a
  ;; half already present in one context re-enter because the other was
  ;; novel. Without a type for it, "the logical edge" existed only as
  ;; three loose positional arguments that vanished inside `emit-edge`,
  ;; so the driver had nothing to state that requirement about. Naming
  ;; it also makes normalizing a `derived-pred` half BACK to its edge a
  ;; total function rather than an argument swap someone can invert.
  (type LogicalEdge (record
    (from Node)
    (role RoleId)
    (to   Node)))

  ;; A logical edge (X,Y) ∈ R(r) is ONE fact that the context
  ;; decomposition stores as TWO halves — a successor at X and a
  ;; predecessor at Y — and `Derived` can address only one context at a
  ;; time. Deriving an edge is therefore never a single message.
  ;;
  ;; This is a RECORD rather than a list of two, so that "both halves"
  ;; is enforced by the type instead of by a contract: an EdgePair
  ;; cannot be constructed with a half missing. Emitting only the
  ;; successor is the tempting version of this bug precisely because it
  ;; looks complete from the deriving context and fails only in the
  ;; CONSUMING rules — CR4/CR5 read `preds`, CR7 reads both sides — so
  ;; the symptom is under-derivation with no error.
  ;;
  ;; It also makes the halves' destinations provable. A `(List
  ;; Addressed)` would need `list-get` to state which half went where,
  ;; and `list-get` is uninterpreted to the WP checker; named record
  ;; fields are not.
  (type EdgePair (record
    (succ-half Addressed)    ; (addressed X (derived-succ r Y))
    (pred-half Addressed)))  ; (addressed Y (derived-pred r X))

  ;; `preds` is not redundant bookkeeping. CR4/CR5 carry a premise
  ;; about Y (B ∈ S(Y)) to a conclusion about X (A ∈ S(X)), so a
  ;; context that learns a new subsumer must be able to notify its
  ;; predecessors. This is ELK's backward link, and it is why edges
  ;; are stored twice.
  ;;
  ;; EVERY FIELD IS A `slop_map*`, AND THAT UNIFORMITY IS DELIBERATE.
  ;; SPEC §6.2 also gave `Context` a `queue (List Derived)`; it lives in
  ;; `Saturation.queues` instead, because `(Set T)`/`(Map K V)` compile
  ;; to POINTERS while `(List T)` compiles to a VALUE STRUCT. In a
  ;; record stored in a `(Map Node Context)` that difference is a trap:
  ;; `set-put` through a `map-get` copy is visible in the map, while
  ;; `list-push` through the same copy updates only the copy's `len` —
  ;; and if `cap` allows, writes into the shared buffer past the stored
  ;; `len`. Four fields needing no write-back and one needing it, one
  ;; keystroke apart, failing silently as a dropped conclusion.
  ;;
  ;; With the list gone, "a Context read out of the map IS the one in
  ;; the map" holds without exception, and the write-back question
  ;; disappears for this type entirely. It also unwelds two lifetimes:
  ;; these three fields are the monotone result that survives into
  ;; `Outcome.saturation`, while a queue is per-round scratch — which is
  ;; what §6.4 already says by making the frontier a property of the
  ;; ROUND (`active := contexts with a non-empty Δₙ₊₁`), not of the
  ;; concept.
  (type Context (record
    (root      Node)                     ; the concept this context reasons about
    (subsumers (Set Node))               ; S(root)
    (succs     (Map RoleId (Set Node)))  ; outgoing role edges
    (preds     (Map RoleId (Set Node))))); incoming role edges

  ;; Δₙ for one context — its inbox for the round about to run.
  ;;
  ;; A record wrapping the list rather than a bare `(List Derived)` as
  ;; the map value: a bare list as a Map VALUE is unexercised in this
  ;; ecosystem (the transpiler keeps `(List T)` on the `__auto_type`
  ;; path precisely because it is a 24-byte struct rather than a
  ;; `void*`), while a record value is the well-trodden case.
  (type Queue (record
    (items (List Derived))))

  ;; The global state owns no per-concept facts — only the registry,
  ;; the current round's deltas, and run bookkeeping.
  (type Saturation (record
    (contexts     (Map Node Context))
    (queues       (Map Node Queue))      ; Δₙ, keyed by destination context
    (active       (Set Node))            ; contexts with a non-empty Δₙ — the frontier
    ;; Redundant with `active`, and earning it: `set-elements` is an
    ;; uninterpreted function to the WP checker AND allocates the whole
    ;; frontier array, so testing emptiness through it costs a proof and
    ;; a copy per round. An `(Int 0 ..)` is interpreted, which moves the
    ;; fixpoint test inside Z3's reach and lets `frontier-is-empty` be
    ;; `@pure` with no Arena — which in turn is what makes a store write
    ;; during the join phase a COMPILE error (§6.4, saturate.slop).
    ;; Both are written by the same loop at the barrier, and
    ;; `round-commit` carries a @post tying them together.
    (active-count (Int 0 ..))
    (iteration    (Int 0 ..))))

  ;; ============================================================
  ;; Coverage and reporting
  ;;
  ;; THREE INDEPENDENT AXES (§6.2). A run can be BOTH out-of-profile
  ;; (the input carried axioms outside §5.2) AND resource-limited (the
  ;; in-profile subset still blew the cap). Collapsing them into one
  ;; status union forces the report to lie about one of them.
  ;; ============================================================

  ;; Ordered: class < object-property < data-property
  ;;          < annotation-property < individual < datatype
  (type EntityKind (enum
    entity-class
    entity-object-property
    entity-data-property
    entity-annotation-property
    entity-individual
    entity-datatype))

  ;; The identity of an input axiom. Load-bearing: it is what
  ;; omissions name, what repairs remove, and what is hashed into the
  ;; consumer's verdict identity (§6.8).
  ;;
  ;;   source : the document the axiom was read from, so imports stay
  ;;            distinguishable. OPTIONAL, because the frozen port
  ;;            flattens every document into one unlabelled buffer and
  ;;            the information is simply not there (§8.5 A1). The CLI
  ;;            populates it; the port degrades to text-only identity.
  ;;   text   : canonical OWL functional syntax, canonicalization
  ;;            already applied and annotations stripped. Blank nodes
  ;;            are rendered by canonical position, never by
  ;;            parser-assigned label.
  (type AxiomRef (record
    (source (Option IRI))
    (text   String)))

  ;; What an omission can point AT. Not every out-of-profile input is
  ;; an OWL axiom: a triple decodable as neither a supported axiom nor
  ;; an annotation assertion has NO canonical functional syntax to put
  ;; in AxiomRef.text, and forcing it through would leave the front end
  ;; choosing between inventing nonconforming text, rejecting valid
  ;; input, and dropping it silently.
  (type InputRef (union
    (owl-axiom    AxiomRef)
    (rdf-fragment String)    ; canonical N-Triples of the offending triples, sorted
    (synthetic    String)))  ; the reserved forms below

  ;; A class/property used without the declaration OWL 2 DL requires.
  ;; NOT an out-of-profile AxiomRef: the missing declaration is by
  ;; definition not an input axiom, so there is nothing to reference.
  ;; Carries the entity and every referring axiom instead.
  ;;
  ;; A record rather than three inline union payloads, for two
  ;; reasons: the fields have a canonical sort order to implement
  ;; (kind, then IRI, then the referring list compared element-wise
  ;; after its own sort), and the transpiler does not register a
  ;; (List T) that appears only inside a multi-field union variant.
  (type MissingDeclaration (record
    (kind      EntityKind)
    (entity    IRI)
    (referring (List AxiomRef))))   ; canonically sorted

  (type Omission (union
    (out-of-profile      InputRef)
    (unresolved-import   IRI)       ; declared owl:imports the caller did not attest to
    (missing-declaration MissingDeclaration)))

  ;; EMPTY means full coverage; anything here means the run saw less
  ;; than the intended theory, whatever the reason.
  (type Coverage (record
    (omitted (List Omission))))

  ;; NOTE cancellation is NOT here. A cancelled run stops at a
  ;; scheduler-dependent point, so its partial state is not
  ;; reproducible (§6.8) and must never be serialized or hashed.
  ;; Modelling it as a Termination variant forced Outcome to carry
  ;; maybe-absent findings AND maybe-absent saturation, and still left
  ;; "are cancelled findings returned?" ambiguous. So cancellation
  ;; leaves the result type entirely, as a Fault on the error path.
  ;; Consequence: every Outcome that EXISTS is report-bearing and
  ;; fully populated.
  (type Termination (union
    (fixpoint)                     ; the frontier emptied — saturation is closed
    (resource-limit (Int 0 ..))))  ; max-iterations reached with a non-empty frontier

  (type SubPair (record
    (sub   Node)
    (super Node)))

  ;; Findings are separated from the raw saturation because they are
  ;; the part that stays meaningful under partial coverage:
  ;; monotonicity makes a derived ⊥ definitive even when axioms were
  ;; omitted (§6.7).
  (type Findings (record
    (inconsistent  Bool)
    (unsatisfiable (List IRI))      ; sorted; a LOWER BOUND unless complete
    (subsumptions  (List SubPair))  ; sorted; produced by EXTRACTION, not by reading S(·)
    (imports-seen  (List IRI))))    ; sorted; DIAGNOSTICS ONLY — the completeness
                                    ; effect travels via Coverage.omitted, because a
                                    ; field the consumer must remember to read is not
                                    ; a safety mechanism (§8.4)

  (type Outcome (record
    (profile     Profile)      ; the calculus that ran (§5.1); the report states it
    (coverage    Coverage)
    (termination Termination)
    (findings    Findings)     ; what WAS derived — always present, always meaningful
    (saturation  Saturation)   ; always present; PARTIAL unless the run was complete
    (names       Names)))      ; the saturation's nodes are RENAMED: map back through this

  ;; The error path. Distinct from an Outcome: these produce no result
  ;; to report on.
  (type Fault (union
    (cancelled)                 ; cancel-ptr observed at a round boundary — no payload
    (input-error String)        ; unparseable / structurally malformed input
    (refused (List Omission))   ; --strict: the gate found omissions and the caller
                                ; asked to refuse rather than run partially
    (unavailable Profile)))     ; an explicit request for a calculus not built yet:
                                ; refused, never quietly run as another (§5.1)

  ;; ============================================================
  ;; Configuration (§5.1)
  ;; ============================================================

  ;; The selectable unit, one per rung of §5.1's ladder. Each names
  ;; the logic its calculus is complete for — never a label wider than
  ;; that. Each profile supplies its own normalization and rule set; the
  ;; driver and I/O are shared across all of them. The declaration
  ;; order is the fixed tie-break order of §5.1.
  (type Profile (enum
    profile-el            ; ELH⊥R+ + domain/range + ABox, exactly §5.2 (implemented)
    profile-el-plus-plus  ; the OWL 2 EL object fragment: + nominals, Self, reflexive roles
    profile-horn-sriq     ; Horn-SRIQ: + inverses, functionality, ∀ on the right
    profile-sriq))        ; SRIQ object fragment (non-Horn); not OWL 2 DL

  ;; What the caller asks for. `auto` is NOT a Profile: it resolves to
  ;; one, per ontology. The DEFAULT is `explicit profile-el`, so a
  ;; default run's cost class (PTIME) and theory never change under an
  ;; upgrade; `auto` is an opt-in (§5.1).
  (type ProfileSelection (union
    (auto)
    (explicit Profile)))

  (type ReasonerConfig (record
    (worker-count    (Int 1 .. 64))
    (channel-buffer  (Int 64 .. 4096))
    ;; 0 is legal and meaningful: it performs no rounds and ALWAYS
    ;; yields resource-limit, since Δ₀ is never empty (§6.8).
    (max-iterations  (Int 0 .. 10000))
    (selection       ProfileSelection)
    ;; CLI-only affordance. The library path always runs non-strict:
    ;; out-of-profile is a report, not a refusal (§8.4).
    (strict-profile  Bool)
    (cancel-ptr      I64)
    (verbose         Bool)))

  (fn default-config ()
    (@intent "Create the default reasoner configuration")
    (@spec (() -> ReasonerConfig))
    (@pure)
    (@post {(. $result worker-count) == 4})
    (@post {(. $result channel-buffer) == 256})
    (@post {(. $result max-iterations) == 1000})
    (@post {(. $result cancel-ptr) == 0})
    (@post {(. $result verbose) == false})
    ;; The library path always runs NON-STRICT: out-of-profile is a
    ;; report, not a refusal, and the port always consumes it that way.
    ;; --strict is a CLI affordance layered on top, never the default.
    (@post {(. $result strict-profile) == false})
    ;; `el` by default, not `auto`: one inverse added to an ontology
    ;; must not silently move every default run to an ExpTime calculus.
    (@post (match (. $result selection)
             ((auto)       false)
             ((explicit p) {p == 'profile-el})))
    :c-name "howl_default_config"
    (record-new ReasonerConfig
      (worker-count 4)
      (channel-buffer 256)
      (max-iterations 1000)
      (selection (union-new ProfileSelection explicit 'profile-el))
      (strict-profile false)
      (cancel-ptr 0)
      (verbose false)))

  ;; ============================================================
  ;; Helpers
  ;; ============================================================

  ;; ⊤ and ⊥ as NODES. Both class-tagged: owl:Nothing can never name an
  ;; individual (OWL 2 reserves it), so ⊥ has no punning hazard.
  ;; Constructors rather than consts because a `Node` is a union value,
  ;; and because §6.3 step 4 pre-populates the signature with them —
  ;; the driver must be able to mint them without a front end.
  (fn node-top ()
    (@intent "⊤ = (class-node owl:Thing)")
    (@spec (() -> Node))
    (@pure)
    (union-new Node class-node (record-new IRI (value OWL_THING))))

  (fn node-bottom ()
    (@intent "⊥ = (class-node owl:Nothing)")
    (@spec (() -> Node))
    (@pure)
    (union-new Node class-node (record-new IRI (value OWL_NOTHING))))

  ;; Structural equality, written out rather than left to `==`, because
  ;; the CROSS-TAG arms are the point: OWL permits punning, so the same
  ;; IRI can denote a class and an individual, and `class-node(:x)` must
  ;; NOT equal `individual-node(:x)`. Spelling every arm makes that
  ;; disjointness reviewable instead of trusting generated equality.
  (fn node-eq ((a Node) (b Node))
    (@intent "Structural node equality — tag-sensitive, so punning stays disjoint")
    (@spec ((Node Node) -> Bool))
    (@pure)
    (match a
      ((class-node ai)
        (match b
          ((class-node bi)      (string-eq (. ai value) (. bi value)))
          ((individual-node _)  false)
          ((fresh-node _)       false)))
      ((individual-node ai)
        (match b
          ((individual-node bi) (string-eq (. ai value) (. bi value)))
          ((class-node _)       false)
          ((fresh-node _)       false)))
      ((fresh-node ai)
        (match b
          ((fresh-node bi)      (== ai bi))
          ((class-node _)       false)
          ((individual-node _)  false)))))

  (fn role-eq ((a RoleId) (b RoleId))
    (@intent "Structural role equality — a fresh role never equals a named one")
    (@spec ((RoleId RoleId) -> Bool))
    (@pure)
    (match a
      ((named-role ai)
        (match b
          ((named-role bi) (string-eq (. ai value) (. bi value)))
          ((fresh-role _)  false)))
      ((fresh-role ai)
        (match b
          ((fresh-role bi) (== ai bi))
          ((named-role _)  false)))))

  ;; ============================================================
  ;; el++ equality and the term constructors
  ;;
  ;; The rule contracts (rules/ksc.slop) name a conclusion's nested terms
  ;; through these constructors, the same calls the rule bodies make, so a
  ;; rule's head is written the same way in its body and its contract.
  ;; Each is the one-line injection its name says.
  ;; ============================================================

  (fn kname-eq ((a KName) (b KName))
    (@intent "Class-name equality — a fresh name never equals an input one")
    (@spec ((KName KName) -> Bool))
    (@pure)
    (match a
      ((k-class ai)
        (match b
          ((k-class bi) (string-eq (. ai value) (. bi value)))
          ((k-fresh _)  false)))
      ((k-fresh ai)
        (match b
          ((k-fresh bi) (== ai bi))
          ((k-class _)  false)))))

  (fn kterm-eq ((a KTerm) (b KTerm))
    (@intent "Term equality — a class name never equals a nominal, punned or not")
    (@spec ((KTerm KTerm) -> Bool))
    (@pure)
    (match a
      ((k-name ai)
        (match b
          ((k-name bi)    (kname-eq ai bi))
          ((k-nominal _)  false)))
      ((k-nominal ai)
        (match b
          ((k-nominal bi) (string-eq (. ai value) (. bi value)))
          ((k-name _)     false)))))

  (fn kelem-eq ((a KElem) (b KElem))
    (@intent "Element equality — tag-sensitive, so q never equals an individual of its IRI")
    (@spec ((KElem KElem) -> Bool))
    (@pure)
    (match a
      ((e-ind ai)
        (match b
          ((e-ind bi)   (string-eq (. ai value) (. bi value)))
          ((e-aux _)    false)
          ((e-class _)  false)))
      ((e-aux ai)
        (match b
          ((e-aux bi)   (== ai bi))
          ((e-ind _)    false)
          ((e-class _)  false)))
      ((e-class ai)
        (match b
          ((e-class bi) (kname-eq ai bi))
          ((e-ind _)    false)
          ((e-aux _)    false)))))

  (fn kfact-eq ((a KFact) (b KFact))
    (@intent "Fact equality, every position compared")
    (@spec ((KFact KFact) -> Bool))
    (@pure)
    (match a
      ((f-inst x y)
        (match b
          ((f-inst x2 y2)      (if (kelem-eq x x2) (kterm-eq y y2) false))
          ((f-triple _ _ _)    false)
          ((f-self _ _)        false)))
      ((f-triple x v z)
        (match b
          ((f-triple x2 v2 z2) (if (kelem-eq x x2) (if (role-eq v v2) (kelem-eq z z2) false) false))
          ((f-inst _ _)        false)
          ((f-self _ _)        false)))
      ((f-self x v)
        (match b
          ((f-self x2 v2)      (if (kelem-eq x x2) (role-eq v v2) false))
          ((f-inst _ _)        false)
          ((f-triple _ _ _)    false)))))

  (fn name-term ((n KName))
    (@intent "The class name n in a class position")
    (@spec ((KName) -> KTerm))
    (@pure)
    (union-new KTerm k-name n))

  (fn nominal-term ((a IRI))
    (@intent "The nominal {a} in a class position")
    (@spec ((IRI) -> KTerm))
    (@pure)
    (union-new KTerm k-nominal a))

  (fn ind-elem ((a IRI))
    (@intent "The individual a as an element")
    (@spec ((IRI) -> KElem))
    (@pure)
    (union-new KElem e-ind a))

  (fn aux-elem ((w (Int 0 ..)))
    (@intent "A supEx axiom's witness constant as an element")
    (@spec (((Int 0 ..)) -> KElem))
    (@pure)
    (union-new KElem e-aux w))

  (fn class-elem ((q KName))
    (@intent "q's test individual: the element of Theorem 2's inst(q, q, q)")
    (@spec ((KName) -> KElem))
    (@pure)
    (union-new KElem e-class q))

  (fn thing-term ()
    (@intent "owl:Thing in a class position: top(z) holds of exactly this z")
    (@spec (() -> KTerm))
    (@pure)
    (union-new KTerm k-name (union-new KName k-class (record-new IRI (value OWL_THING)))))

  (fn nothing-term ()
    (@intent "owl:Nothing in a class position: bot(z) holds of exactly this z")
    (@spec (() -> KTerm))
    (@pure)
    (union-new KTerm k-name (union-new KName k-class (record-new IRI (value OWL_NOTHING)))))

;; ============================================================
  ;; Saturation-local names  —  M1 slice 6b C2
  ;;
  ;; A class or individual node, and a named role, hash and compare as a
  ;; whole IRI string; a `fresh-node`/`fresh-role` hashes and compares one
  ;; Int. So every node and role ENTERING SATURATION is renamed to a dense
  ;; fresh id (`normalize-input` does it, once, at the boundary), and
  ;; extraction maps back through this table. Nothing in saturation looks
  ;; at a node's tag or IRI - only at equality, and at ⊤ and ⊥ - so the
  ;; rules, the premise index and the driver run unchanged on renamed
  ;; nodes. ⊤ and ⊥ are NEVER renamed: the rules build them as constants
  ;; (`node-top`, `node-bottom`), so a renamed one would never match.
  ;;
  ;; Both directions are Maps, which are pointers: a `Names` value can be
  ;; filled in place by the helpers below and shared by every copy. An
  ;; EMPTY table is the identity - a saturation over hand-built nodes
  ;; (tests) reads back as it was built.
  ;; ============================================================

  (type Names (record
    (node-ids (Map Node Int))      ; original -> id
    (nodes    (Map Int Node))      ; id -> original
    (role-ids (Map RoleId Int))
    (roles    (Map Int RoleId))))

  (fn empty-names ((arena Arena))
    (@intent "A name table with nothing renamed - the identity")
    (@spec ((Arena) -> Names))
    (@alloc arena)
    (record-new Names
      (node-ids (map-new arena Node Int))
      (nodes    (map-new arena Int Node))
      (role-ids (map-new arena RoleId Int))
      (roles    (map-new arena Int RoleId))))

  (fn intern-node ((arena Arena) (names Names) (n Node))
    (@intent "n's renamed form, minting the next id on first sight; ⊤ and ⊥ are kept")
    (@spec ((Arena Names Node) -> Node))
    (@alloc arena)
    (let ((top (node-top))
          (bottom (node-bottom)))
      ;; ⊤ and ⊥ come back as the static constants, never as `n`: `n`
      ;; may be the caller's, and a renamed node must not point into
      ;; memory the front end is about to free.
      (if (node-eq n top)
        top
        (if (node-eq n bottom)
          bottom
          (match (map-get (. names node-ids) n)
            ((some k) (union-new Node fresh-node k))
            ((none)
              ;; OWNED: the table keeps a copy in `arena`, as key and as
              ;; value, so it outlives the front end's arenas. A lookup
              ;; with the caller's node still finds it: keys compare by
              ;; content.
              (let ((k (cast Int (map-len (. names nodes))))
                    (c (copy-node arena n)))
                (do
                  (map-put (. names node-ids) c k)
                  (map-put (. names nodes) k c)
                  (union-new Node fresh-node k)))))))))

  (fn intern-role ((arena Arena) (names Names) (r RoleId))
    (@intent "r's renamed form, minting the next id on first sight")
    (@spec ((Arena Names RoleId) -> RoleId))
    (@alloc arena)
    (match (map-get (. names role-ids) r)
      ((some k) (union-new RoleId fresh-role k))
      ((none)
        ;; OWNED, as in `intern-node`.
        (let ((k (cast Int (map-len (. names roles))))
              (c (copy-role arena r)))
          (do
            (map-put (. names role-ids) c k)
            (map-put (. names roles) k c)
            (union-new RoleId fresh-role k))))))

  ;; ============================================================
  ;; Ownership copies
  ;;
  ;; The front end runs in arenas freed once `prepare` is done (the parse,
  ;; decode, gate and normalizer). Only two of its products outlive it:
  ;; the `Names` table's original nodes and roles, and the omissions. Their
  ;; strings point into the parser's or the gate's memory, so they are
  ;; copied into the long-lived arena here - `string-concat` always copies.
  ;; Nothing else crosses: the index and the saturation hold renamed Ints.
  ;; ============================================================

  (fn copy-string ((arena Arena) (s String))
    (@intent "s's bytes, copied into arena")
    (@spec ((Arena String) -> String))
    (@alloc arena)
    (string-concat arena s ""))

  (fn copy-iri ((arena Arena) (i IRI))
    (@intent "i, owning its string in arena")
    (@spec ((Arena IRI) -> IRI))
    (@alloc arena)
    (record-new IRI (value (copy-string arena (. i value)))))

  (fn copy-node ((arena Arena) (n Node))
    (@intent "n, owning its strings in arena")
    (@spec ((Arena Node) -> Node))
    (@alloc arena)
    (match n
      ((class-node i)      (union-new Node class-node (copy-iri arena i)))
      ((individual-node i) (union-new Node individual-node (copy-iri arena i)))
      ((fresh-node k)      (union-new Node fresh-node k))))

  (fn copy-role ((arena Arena) (r RoleId))
    (@intent "r, owning its string in arena")
    (@spec ((Arena RoleId) -> RoleId))
    (@alloc arena)
    (match r
      ((named-role i) (union-new RoleId named-role (copy-iri arena i)))
      ((fresh-role k) (union-new RoleId fresh-role k))))

  (fn copy-axiom-ref ((arena Arena) (a AxiomRef))
    (@intent "a, owning its strings in arena")
    (@spec ((Arena AxiomRef) -> AxiomRef))
    (@alloc arena)
    (record-new AxiomRef
      (source (match (. a source)
                ((some i) (some (copy-iri arena i)))
                ((none)   (none))))
      (text   (copy-string arena (. a text)))))

  (fn copy-input-ref ((arena Arena) (r InputRef))
    (@intent "r, owning its strings in arena")
    (@spec ((Arena InputRef) -> InputRef))
    (@alloc arena)
    (match r
      ((owl-axiom a)    (union-new InputRef owl-axiom (copy-axiom-ref arena a)))
      ((rdf-fragment s) (union-new InputRef rdf-fragment (copy-string arena s)))
      ((synthetic s)    (union-new InputRef synthetic (copy-string arena s)))))

  (fn copy-omission ((arena Arena) (o Omission))
    (@intent "o, owning its strings in arena")
    (@spec ((Arena Omission) -> Omission))
    (@alloc arena)
    (match o
      ((out-of-profile r)    (union-new Omission out-of-profile (copy-input-ref arena r)))
      ((unresolved-import i) (union-new Omission unresolved-import (copy-iri arena i)))
      ((missing-declaration m)
        (let ((mut refs (list-new arena AxiomRef)))
          (do
            (for-each (a (. m referring)) (list-push refs (copy-axiom-ref arena a)))
            (union-new Omission missing-declaration
              (record-new MissingDeclaration
                (kind      (. m kind))
                (entity    (copy-iri arena (. m entity)))
                (referring refs))))))))

  (fn copy-omissions ((arena Arena) (os (List Omission)))
    (@intent "Every omission, in order, owning its strings in arena")
    (@spec ((Arena (List Omission)) -> (List Omission)))
    (@alloc arena)
    (let ((mut out (list-new arena Omission)))
      (do
        (for-each (o os) (list-push out (copy-omission arena o)))
        out)))

  (fn copy-fault ((arena Arena) (f Fault))
    (@intent "f, owning its strings in arena")
    (@spec ((Arena Fault) -> Fault))
    (@alloc arena)
    (match f
      ((cancelled)       (union-new Fault cancelled))
      ((input-error m)   (union-new Fault input-error (copy-string arena m)))
      ((refused os)      (union-new Fault refused (copy-omissions arena os)))
      ((unavailable p)   (union-new Fault unavailable p))))

  (fn renamed-node ((names Names) (n Node))
    (@intent "n as saturation knows it, without minting; none if n cannot be in the saturation")
    (@spec ((Names Node) -> (Option Node)))
    ;; Unknown nodes, ⊤ and ⊥ are themselves - EXCEPT an unknown
    ;; `fresh-node k` under a non-empty table: `k` may be the id the table
    ;; gave some other node, and answering `fresh-node k` would read that
    ;; node's context (a false positive in `entails-sub`; Codex review of
    ;; C2). Such a node is in no saturation built through the table, so the
    ;; answer is none. Under an EMPTY table everything is itself.
    (match (map-get (. names node-ids) n)
      ((some k) (some (union-new Node fresh-node k)))
      ((none)
        (match n
          ((fresh-node _)
            (if (== (map-len (. names nodes)) 0) (some n) (none)))
          ((class-node _)      (some n))
          ((individual-node _) (some n))))))

  (fn original-node ((names Names) (n Node))
    (@intent "The node a renamed one stands for; anything not renamed is itself")
    (@spec ((Names Node) -> Node))
    (match n
      ((fresh-node k)
        (match (map-get (. names nodes) k)
          ((some o) o)
          ((none)   n)))
      ((class-node _)      n)
      ((individual-node _) n)))

  (fn original-role ((names Names) (r RoleId))
    (@intent "The role a renamed one stands for; anything not renamed is itself")
    (@spec ((Names RoleId) -> RoleId))
    (match r
      ((fresh-role k)
        (match (map-get (. names roles) k)
          ((some o) o)
          ((none)   r)))
      ((named-role _) r)))

    (fn make-context ((arena Arena) (root Node))
    (@intent "Create an empty context for a node, with S(root) initially EMPTY")
    (@spec ((Arena Node) -> Context))
    (@alloc arena)
    ;; The store starts empty and the seeds go in the DELTA (§5.2):
    ;; S₋₁(N) := ∅, Δ₀(N) := { derived-sub(N), derived-sub(⊤) }.
    ;; Writing the seeds into `subsumers` here would leave every queue
    ;; empty, so `active` would be empty at round 0, the driver would
    ;; report `fixpoint` before firing a single rule, and the run would
    ;; return an instant, empty, apparently-COMPLETE classification.
    ;; The seeds therefore go into `Saturation.queues` — see
    ;; `make-initial-saturation` in saturate.slop, which is §6.3 step 4's
    ;; initializer and the function normalization will call.
    (@post {(. $result root) == root})
    ;; The empty-store obligation is NOT stated as a @post, and the
    ;; reason is worth recording rather than quietly omitting.
    ;; `set-elements` is an uninterpreted function to the WP checker —
    ;; it has no theory connecting `set-new` to an empty element list —
    ;; so `(list-len (set-elements ...)) == 0` is unprovable and Z3
    ;; returns a counterexample where it is nonzero.
    ;;
    ;; §7 lists initialization among the STRUCTURAL, Z3-reachable
    ;; obligations. That is true of the obligation as a whole (contexts
    ;; built from the signature, seeds in the queue, membership in
    ;; `active`) but not of set emptiness through this builtin. So it is
    ;; discharged EMPIRICALLY for now, by
    ;; `test-context-starts-with-empty-store`, and stating an
    ;; unprovable @post would be exactly the error §7 warns about —
    ;; banking a verification claim on a postcondition that does not
    ;; establish it.
    (record-new Context
      (root      root)
      (subsumers (set-new arena Node))
      (succs     (map-new arena RoleId (Set Node)))
      (preds     (map-new arena RoleId (Set Node)))))

  (fn make-queue ((arena Arena))
    (@intent "An empty round delta for one context")
    (@spec ((Arena) -> Queue))
    (@alloc arena)
    (@post {(list-len (. $result items)) == 0})
    (record-new Queue (items (list-new arena Derived))))

  (fn queue-is-active ((q Queue))
    (@intent "A context is active exactly when its inbox is non-empty")
    (@spec ((Queue) -> Bool))
    (@pure)
    (@post {$result == ((list-len (. q items)) > 0)})
    ;; Both directions, because `active` is the driver's termination
    ;; test: a context wrongly reported inactive is silently dropped
    ;; from the frontier and its queued conclusions are never processed,
    ;; which ends the run early and reports `fixpoint` over an
    ;; incomplete derivation.
    (@property empty-queue-is-inactive
      (implies (== (list-len (. q items)) 0) (not $result)))
    (@property nonempty-queue-is-active
      (implies (> (list-len (. q items)) 0) $result))
    (> (list-len (. q items)) 0))

  ;; EQUALITY FOR THE MULTI-PAYLOAD UNIONS, WRITTEN OUT BY HAND.
  ;;
  ;; Written out rather than left to generated `==`, which is correct again as
  ;; of slop 0.2.1 (#66). The value of spelling them is the CROSS-VARIANT arms:
  ;; `(derived-succ r y)` must not equal `(derived-pred r y)`, and OWL punning
  ;; means `class-node(:x)` must not equal `individual-node(:x)`. Those are
  ;; exactly the cases a reader would otherwise have to take on trust.
  (fn derived-eq ((a Derived) (b Derived))
    (@intent "Structural equality over ALL payloads — `==` compares only the first")
    (@spec ((Derived Derived) -> Bool))
    (@pure)
    (match a
      ((derived-sub an)
        (match b
          ((derived-sub bn)    (node-eq an bn))
          ((derived-succ _ _)  false)
          ((derived-pred _ _)  false)))
      ((derived-succ ar an)
        (match b
          ((derived-succ br bn) (if (role-eq ar br) (node-eq an bn) false))
          ((derived-sub _)      false)
          ((derived-pred _ _)   false)))
      ((derived-pred ar an)
        (match b
          ((derived-pred br bn) (if (role-eq ar br) (node-eq an bn) false))
          ((derived-sub _)      false)
          ((derived-succ _ _)   false)))))

  (fn addressed-eq ((a Addressed) (b Addressed))
    (@intent "Structural equality on an addressed conclusion — destination AND payload")
    (@spec ((Addressed Addressed) -> Bool))
    (@pure)
    ;; Both halves. Comparing only the payload would call two conclusions equal
    ;; that go to different contexts, which is the whole content of an
    ;; `Addressed`; comparing only the destination is worse still.
    (if (node-eq (. a to) (. b to))
      (derived-eq (. a what) (. b what))
      false))

  ;; EDGE-PAIR INVARIANT. A logical edge (X,Y) ∈ R(r) is ONE fact, but
  ;; the context decomposition stores it twice — as a successor at X
  ;; and a predecessor at Y — and `Derived` can address only one
  ;; context at a time. So deriving an edge is never a single message.
  ;; Emitting only one half is a silent under-derivation: CR4/CR5 read
  ;; `preds` and CR7 reads both sides, so the edge simply does less
  ;; work than it should, with no error. Rules emit via this helper
  ;; rather than by hand.
  (fn emit-edge ((arena Arena) (e LogicalEdge))
    (@intent "Derive the logical edge (e.from, e.to) ∈ R(e.role) as its two stored halves")
    (@spec ((Arena LogicalEdge) -> EdgePair))
    (@alloc arena)
    ;; The destinations, not merely the count. A count-of-two is
    ;; satisfied by emitting the successor half twice; these are not.
    ;; Taking a `LogicalEdge` rather than three positional arguments is
    ;; what lets the driver state its novelty test against the same
    ;; thing this function expands (§6.4).
    (@post {(. (. $result succ-half) to) == (. e from)})
    (@post {(. (. $result pred-half) to) == (. e to)})
    ;; And WHAT each half says: the successor half is (role, to) at the
    ;; source, the predecessor half (role, from) at the target. With only
    ;; the destinations pinned, a rule emitting the right halves about the
    ;; wrong edge would satisfy every contract its callers can state.
    ;;
    ;; @property, not @post: a @post is also compiled into a runtime check
    ;; under SLOP_DEBUG, and the transpiler lowers a multi-payload match in
    ;; expression position incorrectly (slop-lang/slop#171) - the debug build
    ;; would not compile. A @property is verify-only, holds for every call,
    ;; and a caller's verifier reads it like a postcondition.
    (@property succ-says-edge
      (match (. (. $result succ-half) what)
        ((derived-succ r y) (and (== r (. e role)) (== y (. e to))))
        (_ false)))
    (@property pred-says-edge
      (match (. (. $result pred-half) what)
        ((derived-pred r x) (and (== r (. e role)) (== x (. e from))))
        (_ false)))
    ;; One helper for both edge-concluding rules (CR3, CR7), so the
    ;; invariant has a single site.
    (record-new EdgePair
      (succ-half (record-new Addressed
                   (to   (. e from))
                   (what (union-new Derived derived-succ (. e role) (. e to)))))
      (pred-half (record-new Addressed
                   (to   (. e to))
                   (what (union-new Derived derived-pred (. e role) (. e from)))))))

  ;; ============================================================
  ;; The verdict rule (§6.2), in code — stated ONCE
  ;;
  ;; §8.4's fault precedence and §9's exit codes are both this pair of
  ;; predicates in their own dialects. Neither may restate it.
  ;; ============================================================

  (fn outcome-is-complete ((o Outcome))
    (@intent "A run is COMPLETE exactly when coverage is full and it reached fixpoint")
    (@spec ((Outcome) -> Bool))
    (@pure)
    ;; That conjunction — not a status tag — is what licenses a
    ;; COHERENT verdict, a complete hierarchy, or a minimal repair.
    ;;
    ;; Two implications rather than one equality, because the
    ;; termination arm needs a match and the SAFETY direction is the one
    ;; that matters: an omission must be unable to survive into a
    ;; "complete" answer, since `complete` is what licenses a coherent
    ;; verdict.
    ;;
    ;; `@post` rather than `@property`: the latter is for quantified
    ;; forall/exists over collections and does not translate `implies`.
    (@post (implies $result {(list-len (. (. o coverage) omitted)) == 0}))
    (@post (implies {(list-len (. (. o coverage) omitted)) > 0}
                    {$result == false}))
    (and (== (list-len (. (. o coverage) omitted)) 0)
         (match (. o termination)
           ((fixpoint) true)
           ((resource-limit _) false))))

  (fn findings-are-incoherent ((f Findings))
    (@intent "incoherent := inconsistent ∨ unsatisfiable ≠ ∅")
    (@spec ((Findings) -> Bool))
    (@pure)
    ;; An unsatisfiable named class alone makes an ontology incoherent,
    ;; whether or not it is inconsistent. This is the arm a draft of the
    ;; spec omitted — it defined only `inconsistent`, and so under-reported
    ;; exactly the case the tool exists to catch.
    (@post (implies {(list-len (. f unsatisfiable)) > 0} {$result == true}))
    ;; The mirror arm: an inconsistency alone also implies incoherence.
    ;;
    ;; This is reachable only because the body below is an `if` rather
    ;; than a flat `or`. The blocker is not the boolean field — it is
    ;; that `or`/`and` IN A FUNCTION BODY make the return value opaque
    ;; to the WP checker, so an identical contract fails against an
    ;; `or`-bodied version of this same function and verifies against
    ;; the `if`-bodied one.
    (@post (implies {(. f inconsistent) == true} {$result == true}))
    ;; Coherence is the WEAKEST of the three conditions: an ontology
    ;; with an unsatisfiable named class is incoherent whether or not
    ;; it is inconsistent. A finding is DEFINITIVE whatever the
    ;; coverage, because inference is monotone — restoring an omitted
    ;; axiom can only add conclusions, never retract one. It is the
    ;; ABSENCE of a finding that carries no information.
    ;; Written as an `if` on the unsatisfiable-set size rather than a
    ;; flat `or`, so the Z3-reachable branch is syntactically explicit.
    ;; A flat `(or (. f inconsistent) (> ... 0))` makes the WHOLE
    ;; expression untranslatable, because one operand is an opaque bool
    ;; field — the checker cannot then discharge even the arm that is
    ;; about an integer. Semantically identical; verifiable rather than
    ;; not.
    (if (> (list-len (. f unsatisfiable)) 0)
      true
      (. f inconsistent))))
