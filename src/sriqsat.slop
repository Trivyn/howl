;; ============================================================
;; sriq's single-threaded prototype of S6's rounds  —  SPEC.md §5.5
;; S6, slice 9 (AD 00b7c42d D8)
;;
;; EACH ROUND is S6's four steps at one worker:
;;   1. DERIVE against the frozen Sₙ: every rule instance with at least
;;      one premise in Δₙ. For slots 1..k, slot i comes from Δₙ, the
;;      slots before it from Sₙ \ Δₙ and the slots after it from Sₙ, so an
;;      instance runs once per round. Edges are premises of Pred and
;;      r-Pred, the clauses that put an atom into K₂ are premises of Succ,
;;      and Nom's children, like U_H's constants, are premises of Nom and
;;      of the root's E4 instances. A new context runs every instance.
;;   2. CREATE, serially, in content order: Nom's constants, the new
;;      contexts by core, the edges. The new contexts' Core clauses and
;;      Succ's and r-Succ's A → A clauses join the candidates.
;;   3. COMMIT each context: min(Sₙ ∪ candidates) (commit-min, R1). What
;;      is inserted and survives is Δₙ₊₁, with the new edges, contexts
;;      and constants.
;;   4. BOUNDARY: an empty Δₙ₊₁ is the fixpoint; ⊤ → ⊥ ∈̂ S_{v_⊤} stops
;;      the run (S4); then the cap.
;;
;; Running an instance none of whose premises is new concludes nothing
;; new: it ran when its newest premise arrived, its conclusion is ∈̂ Sₙ
;; since (R2), and its actions were taken. So the anchoring may run more
;; than Δₙ needs, never less.
;;
;; The per-instance work is the reference's (sriqref): the same proved
;; steps, the same slot filters, the same round's-end code. Only the
;; schedule differs, and the commit deletes as it goes, where the
;; reference waits for the fixpoint (D5(a)). So the two are compared on
;; their answers, not their stores.
;;
;; DEFERRAL (R8, slice 9i): on a constant-free input under cautious or
;; trivial, derive reads in each context only the clauses an incoming
;; edge supports, and a stored clause that becomes supported joins the
;; next round's Δ. Every evaluation of Succ for (w, f) adds its K₂ to
;; trig(w, f), makes sure the edge to the strategy's current target
;; exists, and pushes A′ → A′ for all of trig(w, f) into every f-edge's
;; target. The store is committed as usual; only derive's view narrows.
;; ============================================================

(module sriqsat
  (@doc "sriq's single-threaded prototype of S6's rounds: derive over Δₙ against a frozen Sₙ, a serial create,
         commit-min per context, the boundary (SPEC 5.5 S6, D8)")

  (import types (Lit Clause LitForm ATerm at-x at-u atom1 aterm-eq lit-cmp))
  (import sriqclauses (clause-cmp make-clause lit-set))
  (import sriqsubsume (Committed commit-min in-hat))
  (import sriqindex (commit-indexed KIdx k-index k-index-premises k-query))
  (import sriqctx (Strategy Triggers EdgeLabel Edge Ctx CtxSet Structure build-triggers init-structure core-of
                    ctx-by-core strat-choice))
  (import canon (sort-range))
  (import saturate (reuse-arena))
  (import sriqorder (SriqOrder ranked max-flags))
  (import sriq (Premise RConcl HState PredView PSlot CSub SuccSig KSets
                hyper-start hyper-finish succ-sig k-sets covers succ-step pred-view rpred-view rpred-heads-ok body-at
                joinable csub-lit join-rule Pos subterm-at))
  (import sriqhyper (HIdx HCtx HOut h-index hyper-indexed))
  (import sriqground (Ground PIdx pidx-of pidx-find pick-ix ground-clause ground-of g-visible g-fresh
                             g-in-hat g-held
                             g-premise-at g-member-of
                      g-sel-range g-body-members g-member g-root-units view-total materialise))
  (import types (lit-eq cancel-requested))
  (import sriqref (RefStatus RefConfig RefResult RefIn Cand Env SuccAct RSuccAct NomAct Out Round Dl4 PJob Committing with-room copy-cand
                   set-of is-root core-at premises-of consts-of conclusion out-of round-of append-cands product
                   ref-core x-fits hyper-with hyper-choices eq-positions ref-ineq ref-factor ref-join
                   nom-first nom-second nom-pair ref-rsucc
                   pred-one away-job root-job slots-of rslots ctx-round
                   edge-is add-consts add-contexts add-edges action-cands unit-clause cand-at cand-cmp
                   copy-clauses copy-structure env-of ref-lambda ref-round ref-apply initial-queries init-of))

  (export SatConfig SatResult Counts Supply sat-run sat-materialise hyper-ix-agrees defer-on defer-stable)

  ;; perm: 0 runs Δₙ as committed; 1 reverses each Δ_v and the order
  ;; contexts are visited; 2 rotates both. R6: no report may change.
  ;; scan: commit through commit-min's scans, not the index, and add edges
  ;; through add-edges's fold, not edges-added (9b's and 9f's baseline,
  ;; which the tests diff the index and the sort against).
  ;; defer: predecessor relevance (R8), asked for; it is on only in its
  ;; scope (defer-on).
  ;; views: read each stored clause's maximal flags from the store (slice
  ;; 9k); false recomputes them every round, the baseline the tests diff.
  ;; check: compare the kept flags with a recomputation after every round,
  ;; counted in Counts' stale (a test's).
  (type SatConfig (record
    (base  RefConfig)
    (perm  Int)
    (scan  Bool)
    (defer Bool)
    (views  Bool)
    (check  Bool)
    (cancel I64)))   ; the host's cancel flag (ReasonerConfig's cancel-ptr), read at every round boundary; 0 for none

  ;; Work counted over the run (no clock is read under src/).
  (type Counts (record
    (cands  Int)      ; candidates derive and create produced
    (rcands Int)      ; of them, into v_r
    (succs  Int)      ; Succ actions
    (rsuccs Int)      ; r-Succ actions
    (noms   Int)      ; Nom's children asked for
    (added  Int)      ; clauses committed: the sum of every Δ
    (acts   Int)      ; stored clauses that became supported (R8)
    (hyper  Int)      ; Hyper's choices tried
    (stale  Int)))    ; with check: kept flags that differ from a recomputation

  (type SatResult (record
    (res       RefResult)
    (counts    Counts)
    (trig      (List Supply))   ; R8's trig at the end; empty without deferral
    (cancelled Bool)))          ; the host cancelled at a round boundary: no answer (Fault::cancelled)

  ;; Δₙ beside Sₙ: each context's new clauses and the rest, the new
  ;; edges, and where the new contexts and constants start.
  (type Delta (record
    (news  (List CtxSet))
    (olds  (List CtxSet))
    (edges (List Edge))
    (nctx  Int)
    (ncst  Int)))

  ;; trig(w, f) (R8): the atoms of K₂ that every evaluation of Succ for
  ;; (w, f) has read, as a set in lit-cmp's order. A run's trig is sorted
  ;; by (w, f), each pair once.
  (type Supply (record
    (from U32)
    (f    U32)
    (lits (List Lit))))

  ;; One context's premise views as the store keeps them (slice 9k): for
  ;; each clause of S_v, in S_v's content order, its head literals' maximal
  ;; flags. A clause's flags are a function of the clause and the run's one
  ;; order, which no round changes for a clause already stored (SPEC §5.5).
  (type Flags (record
    (fs (List (List Bool)))))

  ;; S_v beside its flags, for derive to find a clause's flags by content.
  (type View (record
    (cs (List Clause))
    (fs (List (List Bool)))))

  (type Step (record
    (st      Structure)
    (dl      Delta)
    (changed Bool)
    (trig    (List Supply))   ; R8's trig after the round; empty without deferral
    (acts    Int)             ; of Δₙ₊₁, the clauses activation added
    (flags   (List Flags))))  ; each context's flags, aligned with its new set

  ;; One context as derive reads it: S_v, Δ_v and S_v \ Δ_v, as clauses
  ;; and as premises, and G, which every context but the root reads beside
  ;; S_v (the shared ground view). A context new this round reads all of
  ;; S_v as new, and all of G as old (fresh).
  (type Here (record
    (v     U32)
    (root  Bool)
    (fresh Bool)
    (all   (List Clause))
    (news  (List Clause))
    (olds  (List Clause))
    (aps   (List Premise))
    (dps   (List Premise))
    (ops   (List Premise))
    (dix   PIdx)             ; dps, aps and ops, filed by selected literal (r-Pred's side premises)
    (aix   PIdx)
    (oix   PIdx)
    (hx    HIdx)             ; O's clauses, Hyper's (slice 9e)
    (ixs   (List CIdx))      ; every context's premises, filed (Pred reads its predecessor's)
    (gd    Ground)
    (rs    RSrcs)            ; the root clauses r-Pred can fire from, with their views (slice 9f)
    (dfr   Bool)             ; deferral (R8): Succ evaluates, and its covered test is not read
    (views Bool)             ; premise views from the store (9k): Succ's K-sets read the premises' flags
    (room  Int)))            ; conclusions this context may add before its pairing loops stop (11b)

  ;; The edges into and out of one context.
  (type Adj (record
    (ins  (List Edge))
    (outs (List Edge))))

  ;; One context's edges, at one end. A record: the C generator orders a
  ;; (List (List T)) before (List T) in the header.
  (type Bucket (record
    (es (List Edge))))

  ;; ============================================================
  ;; Δ
  ;; ============================================================

  (fn cs-at ((xs (List CtxSet)) (v Int) (nobody (List Clause)))
    (@intent "Element v's clauses, or nobody")
    (@spec (((List CtxSet) Int (List Clause)) -> (List Clause)))
    (@pure)
    (match (list-get xs v) ((some s) (. s cs)) ((none) nobody)))

  (fn permuted ((arena Arena) (xs (List Clause)) (perm Int))
    (@intent "xs as is (0), reversed (1), or rotated by half (2)")
    (@spec ((Arena (List Clause) Int) -> (List Clause)))
    (@alloc arena)
    (let ((n (cast Int (list-len xs))) (mut out (list-new arena Clause)) (mut i 0))
      (do (while (< i n)
            (let ((k (cond ((== perm 1) (- (- n 1) i)) ((== perm 2) (% (+ i (/ n 2)) n)) (else i))))
              (do (match (list-get xs k) ((some c) (list-push out c)) ((none) (set! i i)))
                  (set! i (+ i 1)))))
          out)))

  (fn ctx-order ((arena Arena) (n Int) (perm Int))
    (@intent "The context ids 0 to n - 1, as is, reversed, or rotated by half")
    (@spec ((Arena Int Int) -> (List Int)))
    (@alloc arena)
    (let ((mut out (list-new arena Int)) (mut i 0))
      (do (while (< i n)
            (do (list-push out (cond ((== perm 1) (- (- n 1) i)) ((== perm 2) (% (+ i (/ n 2)) n)) (else i)))
                (set! i (+ i 1))))
          out)))

  ;; Every context's premises, filed by selected literal once per round
  ;; (slice 9e): derive in v reads its own, and Pred over an edge from w
  ;; reads w's.
  (type CIdx (record
    (aps (List Premise))
    (dps (List Premise))
    (ops (List Premise))
    (aix PIdx)
    (dix PIdx)
    (oix PIdx)))

  (fn ctx-ix ((arena Arena) (env Env) (st Structure) (dl Delta) (v Int) (perm Int) (vw (List View)))
    (@intent "Context v's premises, all, of Δ_v and of the rest, each filed; a context new this round has all of S_v as
              Δ_v. With views (vw), each clause's flags come from the store; with none, premises-of computes them")
    (@spec ((Arena Env Structure Delta Int Int (List View)) -> CIdx))
    (@alloc arena)
    (let ((all (set-of env st v))
          (fresh (>= v (. dl nctx)))
          (news (permuted arena (if fresh all (cs-at (. dl news) v (. env nobody))) perm))
          (olds (if fresh (. env nobody) (cs-at (. dl olds) v (. env nobody))))
          (aps (premises-in arena st vw v all))
          (dps (premises-in arena st vw v news))
          (ops (premises-in arena st vw v olds)))
      (record-new CIdx (aps aps) (dps dps) (ops ops)
                       (aix (pidx-of arena aps)) (dix (pidx-of arena dps)) (oix (pidx-of arena ops)))))

  (fn all-ixs ((arena Arena) (env Env) (st Structure) (dl Delta) (perm Int) (vw (List View)))
    (@intent "ctx-ix for every context, by id")
    (@spec ((Arena Env Structure Delta Int (List View)) -> (List CIdx)))
    (@alloc arena)
    (let ((mut out (list-new arena CIdx)) (mut v 0))
      (do (for-each (c (. st ctxs)) (do (list-push out (ctx-ix arena env st dl v perm vw)) (set! v (+ v 1))))
          out)))

  (fn cix-at ((arena Arena) (ixs (List CIdx)) (v Int))
    (@intent "Context v's filed premises; none for a missing context")
    (@spec ((Arena (List CIdx) Int) -> CIdx))
    (@alloc arena)
    (match (list-get ixs v)
      ((some x) x)
      ((none) (let ((e (list-new arena Premise)))
                (record-new CIdx (aps e) (dps e) (ops e) (aix (pidx-of arena e)) (dix (pidx-of arena e))
                                 (oix (pidx-of arena e)))))))

  (fn here-of ((arena Arena) (env Env) (st Structure) (dl Delta) (gd Ground) (hx HIdx) (ixs (List CIdx)) (rs RSrcs)
               (v Int) (perm Int) (dfr Bool) (views Bool))
    (@intent "Context v as derive reads it; a context new this round reads all of S_v as new")
    (@spec ((Arena Env Structure Delta Ground HIdx (List CIdx) RSrcs Int Int Bool Bool) -> Here))
    (@alloc arena)
    (let ((all (set-of env st v))
          (fresh (>= v (. dl nctx)))
          (news (permuted arena (if fresh all (cs-at (. dl news) v (. env nobody))) perm))
          (olds (if fresh (. env nobody) (cs-at (. dl olds) v (. env nobody))))
          (x (cix-at arena ixs v)))
      (record-new Here (v (cast U32 v)) (root (is-root st v)) (fresh fresh) (all all) (news news) (olds olds)
                       (aps (. x aps)) (dps (. x dps)) (ops (. x ops)) (dix (. x dix)) (aix (. x aix)) (oix (. x oix))
                       (hx hx) (ixs ixs) (gd gd) (rs rs) (dfr dfr) (views views) (room ROOM_OFF))))

  (fn here-room ((h Here) (room Int))
    (@intent "h with its room set")
    (@spec ((Here Int) -> Here))
    (@pure)
    (record-new Here (v (. h v)) (root (. h root)) (fresh (. h fresh)) (all (. h all)) (news (. h news)) (olds (. h olds))
                     (aps (. h aps)) (dps (. h dps)) (ops (. h ops)) (dix (. h dix)) (aix (. h aix)) (oix (. h oix))
                     (hx (. h hx)) (ixs (. h ixs)) (gd (. h gd)) (rs (. h rs)) (dfr (. h dfr)) (views (. h views))
                     (room room)))

  (fn roomy ((out (List Cand)) (h Here))
    (@intent "Is out still within h's room?")
    (@spec (((List Cand) Here) -> Bool))
    (@pure)
    (<= (cast Int (list-len out)) (. h room)))

  (fn edge-new ((dl Delta) (e Edge))
    (@intent "Was e created this round?")
    (@spec ((Delta Edge) -> Bool))
    (@pure)
    (let ((mut found false))
      (do (for-each (x (. dl edges)) (when (edge-is x (. e from) (. e to) (. e lk) (. e label)) (set! found true)))
          found)))

  (fn consts-new ((st Structure) (dl Delta))
    (@intent "Did this round create a constant? (The first round creates them all: O's individuals.)")
    (@spec ((Structure Delta) -> Bool))
    (@pure)
    (> (consts-of st) (. dl ncst)))

  ;; ============================================================
  ;; Derive, Table 2, anchored on Δ_v
  ;; ============================================================

  (fn hyper-new-consts ((arena Arena) (st Structure) (dl Delta) (v U32) (oc Clause))
    (@intent "Hyper at the root on a bodiless ontology clause, for each constant this round created (E4)")
    (@spec ((Arena Structure Delta U32 Clause) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)) (mut u (. dl ncst)))
      (do (while (< u (consts-of st))
            (do (for-each (c (conclusion arena v (hyper-finish arena (hyper-start arena (at-u (cast U32 u)) true)
                                                               (. oc head))))
                  (list-push out c))
                (set! u (+ u 1))))
          out)))

  (fn hyper-bodiless ((arena Arena) (st Structure) (dl Delta) (h Here) (oc Clause))
    (@intent "Hyper on a bodiless ontology clause: at the root for each new constant (E4); in a new context x itself,
              except on DL10's ⊤ → B(o), which the root derives and the view brings to every context")
    (@spec ((Arena Structure Delta Here Clause) -> (List Cand)))
    (@alloc arena)
    (cond ((. h root) (hyper-new-consts arena st dl (. h v) oc))
          ((and (. h fresh) (not (dl10 oc))) (conclusion arena (. h v)
                                                         (hyper-finish arena (hyper-start arena (at-x) true)
                                                                                       (. oc head))))
          (else (list-new arena Cand))))

  (fn dl10 ((oc Clause))
    (@intent "Is oc a bodiless ground clause naming a constant (DL10's ⊤ → B(o))? DL1's ⊤ → ⊥ names none")
    (@spec ((Clause) -> Bool))
    (@pure)
    (and (== (list-len (. oc body)) 0) (> (list-len (. oc head)) 0) (ground-clause oc)))

  (fn hctx-of ((h Here))
    (@intent "h as Hyper reads it")
    (@spec ((Here) -> HCtx))
    (@pure)
    (record-new HCtx (v (. h v)) (root (. h root)) (dps (. h dps)) (aps (. h aps)) (dix (. h dix)) (oix (. h oix))
                     (aix (. h aix))))

  ;; No room limit: a test's runs, and the reference's comparisons.
  (const ROOM_OFF Int 2147483647)

  (fn sat-hyper ((arena Arena) (env Env) (st Structure) (dl Delta) (h Here) (room Int))
    (@intent "Hyper anchored on Δ_v (indexed); on the bodiless clauses, at the root for the new constants, and in a new
              context. Past room, what is left is skipped")
    (@spec ((Arena Env Structure Delta Here Int) -> HOut))
    (@alloc arena)
    (let ((hy (hyper-indexed arena env (. h hx) (hctx-of h) room)) (mut out (list-new arena Cand)))
      (do (for-each (oc (. (. h hx) bodiless))
            (when (<= (+ (list-len out) (list-len (. (. hy out) cands))) room)
              (for-each (c (hyper-bodiless arena st dl h oc)) (list-push out c))))
          (for-each (c (. (. hy out) cands)) (list-push out c))
          (record-new HOut (out (out-of out (. (. hy out) over))) (tried (. hy tried))))))

  (fn eq-pairs ((arena Arena) (st Structure) (h Here) (p1s (List Premise)) (p2s (List Premise)))
    (@intent "Eq from each maximal selected equality of p1s, either side, into each maximal premise of p2s")
    (@spec ((Arena Structure Here (List Premise) (List Premise)) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)))
      (do (for-each (p1 p1s)
            (when (and (roomy out h) (. p1 maxed) (== (. (. p1 sel) form) 'lf-eq))
              (for-each (p2 p2s)
                (when (. p2 maxed)
                  (do (for-each (c (eq-side arena st h p1 (cast U32 1) p2)) (list-push out c))
                      (for-each (c (eq-side arena st h p1 (cast U32 2) p2)) (list-push out c)))))))
          out)))

  ;; Eq fires only where p2's selected literal holds s₁ (eq-rule's sound
  ;; property, at-is), so a pair whose literal holds it at none of the four
  ;; positions is skipped before any conclusion is built. No conclusion
  ;; changes.

  (fn eq-side ((arena Arena) (st Structure) (h Here) (p1 Premise) (k1 U32) (p2 Premise))
    (@intent "Eq from side k1 of p1's equality into p2, if p2's selected literal holds that side at some position")
    (@spec ((Arena Structure Here Premise U32 Premise) -> (List Cand)))
    (@alloc arena)
    ;; A firing builds its conclusions in a scratch arena of its own, and
    ;; only they are copied out: kept for the round, the rewriting's
    ;; intermediate lists cost some 20 KB a conclusion, and a W3C pigeonhole
    ;; test's Eq passed 9 GB on them (slice 11b).
    (if (holds-term (. p2 sel) (if (== k1 (cast U32 1)) (. (. p1 sel) t1) (. (. p1 sel) t2)))
      (let ((tmp (arena-new 65536))
            (out (copy-cands arena (eq-positions tmp (. st ord) (. h v) (. h root) p1 k1 p2))))
        (do (arena-free tmp) out))
      (list-new arena Cand)))

  (fn join-kept ((arena Arena) (v U32) (p1 Premise) (c Clause) (j Int))
    (@intent "Join of p1 into body literal j of c, into v, built in a scratch arena and copied out")
    (@spec ((Arena U32 Premise Clause Int) -> (List Cand)))
    (@alloc arena)
    (let ((tmp (arena-new 16384))
          (out (copy-cands arena (conclusion tmp v (join-rule tmp p1 (body-at tmp c j))))))
      (do (arena-free tmp) out)))

  (fn copy-cands ((arena Arena) (cs (List Cand)))
    (@intent "cs, each conclusion copied into arena")
    (@spec ((Arena (List Cand)) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand))) (do (for-each (c cs) (list-push out (copy-cand arena c))) out)))

  (fn holds-term ((l Lit) (s ATerm))
    (@intent "Is s the subterm of l at one of Eq's four positions (either argument, outer or inner)?")
    (@spec ((Lit ATerm) -> Bool))
    (@pure)
    (or (term-at l (cast U32 1) false s) (term-at l (cast U32 1) true s)
        (term-at l (cast U32 2) false s) (term-at l (cast U32 2) true s)))

  (fn term-at ((l Lit) (a U32) (inner Bool) (s ATerm))
    (@intent "Is l|p s, for p = (a, inner)?")
    (@spec ((Lit U32 Bool ATerm) -> Bool))
    (@pure)
    (match (subterm-at l (record-new Pos (arg a) (inner inner))) ((some t) (aterm-eq t s)) ((none) false)))

  (fn sat-table2 ((arena Arena) (env Env) (st Structure) (dl Delta) (h Here) (room Int))
    (@intent "Table 2 but Nom, anchored on Δ_v: Core in a new context; Hyper; Eq with either premise new; Ineq and
              Factor on the new; Join with either side new; and, away from the root, Eq and Join with a premise from G.
              Once the conclusions pass room, the later steps are skipped")
    (@spec ((Arena Env Structure Delta Here Int) -> HOut))
    (@alloc arena)
    (let ((hy (sat-hyper arena env st dl h room))
          (mut out (list-new arena Cand)))
      (do (when (. h fresh) (for-each (c (ref-core arena (. h v) (core-at env st arena (cast Int (. h v)))))
                              (list-push out c)))
          (when (and (not (. h root)) (within out (. (. hy out) cands) room))
            (do (for-each (c (eq-ground arena st h)) (list-push out c))
                (when (within out (. (. hy out) cands) room)
                  (for-each (c (join-ground arena h)) (list-push out c)))))
          (for-each (c (. (. hy out) cands)) (list-push out c))
          (when (<= (cast Int (list-len out)) room) (set! out (t2-rest arena st h out room)))
          (record-new HOut (out (out-of out (. (. hy out) over))) (tried (. hy tried))))))

  (fn within ((a (List Cand)) (b (List Cand)) (room Int))
    (@intent "Are a and b together within room?")
    (@spec (((List Cand) (List Cand) Int) -> Bool))
    (@pure)
    (<= (+ (cast Int (list-len a)) (cast Int (list-len b))) room))

  (fn t2-rest ((arena Arena) (st Structure) (h Here) (sofar (List Cand)) (room Int))
    (@intent "sofar, then Eq, Ineq, Factor and Join, each while the list is within room")
    (@spec ((Arena Structure Here (List Cand) Int) -> (List Cand)))
    (@alloc arena)
    (let ((mut out sofar))
    (do (for-each (c (eq-pairs arena st h (. h dps) (. h aps))) (list-push out c))
        (when (<= (cast Int (list-len out)) room)
          (for-each (c (eq-pairs arena st h (. h ops) (. h dps))) (list-push out c)))
        (when (<= (cast Int (list-len out)) room)
          (for-each (c (ref-ineq arena (. h v) (. h dps))) (list-push out c)))
        (when (<= (cast Int (list-len out)) room)
          (for-each (c (ref-factor arena (. st ord) (. h v) (. h dps))) (list-push out c)))
        (when (<= (cast Int (list-len out)) room)
          (for-each (c (sat-join arena (. h v) (. h dps) (join-sites arena (. h all)) room)) (list-push out c)))
        (when (<= (cast Int (list-len out)) room)
          (for-each (c (sat-join arena (. h v) (. h ops) (join-sites arena (. h news)) room)) (list-push out c)))
        out)))

  ;; ============================================================
  ;; The shared ground view, in Table 2 (SPEC §5.5, slice 9d)
  ;;
  ;; Away from the root, Eq and Join read G beside S_v. Of the instances
  ;; whose premises all come from G, only Eq's are run: the root ran the
  ;; others on the same premises, with the same order. Hyper away from the
  ;; root takes no premise from G (every body atom has x), and Ineq and
  ;; Factor take one premise.
  ;; ============================================================

  (fn g-counts ((h Here) (i Int) (which Int))
    (@intent "Does member i of G count for which in h: 0 if visible, 1 if visible and new this round, 2 if visible and
              not new? A context new this round reads all of G as old")
    (@spec ((Here Int Int) -> Bool))
    (@pure)
    (let ((new (and (not (. h fresh)) (g-fresh (. h gd) i))))
      (and (g-visible (. h gd) (cast Int (. h v)) i)
           (cond ((== which 1) new) ((== which 2) (not new)) (else true)))))

  (fn g-picks ((h Here) (k Int) (which Int))
    (@intent "Does premise k of G count for which in h (g-counts, of its member)?")
    (@spec ((Here Int Int) -> Bool))
    (@pure)
    (g-counts h (g-member-of (. h gd) k) which))

  (fn g-prems ((arena Arena) (h Here) (which Int) (eqs Bool))
    (@intent "G's maximal premises that count for which in h; with eqs, only those selecting an equality")
    (@spec ((Arena Here Int Bool) -> (List Premise)))
    (@alloc arena)
    (let ((mut out (list-new arena Premise)) (mut k 0))
      (do (for-each (p (. (. h gd) ps))
            (do (when (and (. p maxed) (or (not eqs) (== (. (. p sel) form) 'lf-eq)) (g-picks h k which))
                  (list-push out p))
                (set! k (+ k 1))))
          out)))

  (fn join-into-g ((arena Arena) (h Here) (p1s (List Premise)) (which Int))
    (@intent "Join of each maximal premise of p1s with a joinable selected literal against the members of G that count
              for which and hold that literal in their body (found by it)")
    (@spec ((Arena Here (List Premise) Int) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)))
      (do (for-each (p1 p1s)
            (when (and (roomy out h) (. p1 maxed) (joinable (. p1 sel)))
              (for-each (i (g-body-members arena (. h gd) (. p1 sel)))
                (when (and (roomy out h) (g-counts h i which))
                  (for-each (c (join-into-member arena h p1 (g-member (. h gd) i (empty-clause arena))))
                    (list-push out c))))))
          out)))

  (fn join-into-member ((arena Arena) (h Here) (p1 Premise) (g Clause))
    (@intent "Join of p1 against each body literal of g equal to its selected literal")
    (@spec ((Arena Here Premise Clause) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)) (mut j 0))
      (do (for-each (l (. g body))
            (do (when (lit-eq l (. p1 sel))
                  (for-each (c (join-kept arena (. h v) p1 g j)) (list-push out c)))
                (set! j (+ j 1))))
          out)))

  (fn empty-clause ((arena Arena))
    (@intent "⊤ → ⊥, for a lookup that cannot miss")
    (@spec ((Arena) -> Clause))
    (@alloc arena)
    (record-new Clause (body (list-new arena Lit)) (head (list-new arena Lit))))

  (fn has-eq ((ps (List Premise)))
    (@intent "Does a maximal premise of ps select an equality?")
    (@spec (((List Premise)) -> Bool))
    (@pure)
    (let ((mut found false))
      (do (for-each (p ps) (when (and (. p maxed) (== (. (. p sel) form) 'lf-eq)) (set! found true))) found)))

  (fn eq-ground ((arena Arena) (st Structure) (h Here))
    (@intent "Eq with a premise from G, either way, anchored: S_v's equalities into G, G's into S_v, and G's into G
              (rewriting one position, where the root rewrites them all); in a new context every pair")
    (@spec ((Arena Structure Here) -> (List Cand)))
    (@alloc arena)
    (let ((gn (g-prems arena h 1 true)) (go (g-prems arena h 2 true)) (mut out (list-new arena Cand)))
      (do (when (has-eq (. h dps)) (for-each (c (eq-pairs arena st h (. h dps) (g-prems arena h 0 false)))
                                     (list-push out c)))
          (when (and (roomy out h) (has-eq (. h ops)))
            (for-each (c (eq-pairs arena st h (. h ops) (g-prems arena h 1 false))) (list-push out c)))
          (when (roomy out h) (for-each (c (eq-pairs arena st h gn (. h aps))) (list-push out c)))
          (when (roomy out h) (for-each (c (eq-pairs arena st h go (. h dps))) (list-push out c)))
          (when (and (roomy out h) (> (list-len gn) 0))
            (for-each (c (eq-pairs arena st h gn (g-prems arena h 0 false))) (list-push out c)))
          (when (and (roomy out h) (> (list-len go) 0))
            (for-each (c (eq-pairs arena st h go (g-prems arena h (if (. h fresh) 0 1) false))) (list-push out c)))
          out)))

  (fn join-ground ((arena Arena) (h Here))
    (@intent "Join with one premise from G, anchored: S_v's premises against G's sites, and G's premises against S_v's")
    (@spec ((Arena Here) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)))
      (do (for-each (c (join-into-g arena h (. h dps) 0)) (list-push out c))
          (when (roomy out h) (for-each (c (join-into-g arena h (. h ops) 1)) (list-push out c)))
          (when (roomy out h) (for-each (c (join-from-g arena h (join-sites arena (. h all)) 1)) (list-push out c)))
          (when (roomy out h) (for-each (c (join-from-g arena h (join-sites arena (. h news)) 2)) (list-push out c)))
          out)))

  (fn join-from-g ((arena Arena) (h Here) (sites (List JoinSite)) (which Int))
    (@intent "Join of each premise of G that counts for which, maximal and selecting a site's literal, against that
              site")
    (@spec ((Arena Here (List JoinSite) Int) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)))
      (do (for-each (s sites)
            (match (site-lit s)
              ((none) (set! out out))
              ((some l) (when (roomy out h) (for-each (c (join-site-g arena h s l which)) (list-push out c))))))
          out)))

  (fn join-site-g ((arena Arena) (h Here) (s JoinSite) (l Lit) (which Int))
    (@intent "Join against one site of each premise of G selecting its literal l that counts for which")
    (@spec ((Arena Here JoinSite Lit Int) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)))
      (do (for-each (k (g-sel-range arena (. h gd) l))
            (when (and (roomy out h) (g-picks h k which))
              (for-each (c (join-g-one arena h s (g-premise-at (. h gd) k (fallback-premise arena))))
                (list-push out c))))
          out)))

  (fn join-g-one ((arena Arena) (h Here) (s JoinSite) (p1 Premise))
    (@intent "Join of one premise of G, if maximal, against one site")
    (@spec ((Arena Here JoinSite Premise) -> (List Cand)))
    (@alloc arena)
    (if (. p1 maxed)
      (join-kept arena (. h v) p1 (. s c) (. s j))
      (list-new arena Cand)))

  (fn fallback-premise ((arena Arena))
    (@intent "A premise that is not maximal, for a lookup that cannot miss")
    (@spec ((Arena) -> Premise))
    (@alloc arena)
    (record-new Premise (body (list-new arena Lit)) (sel (atom1 (cast U32 0) (at-x))) (rest (list-new arena Lit))
                        (maxed false)))

  ;; Join fires only on a maximal premise whose selected literal is a body
  ;; literal and joinable (join-rule's sound property). So it is tried only
  ;; on the body literals that are joinable, and only where they equal the
  ;; premise's: the conditions the rule's own soundness requires, which
  ;; change no conclusion, without building a view of every other pair.
  (type JoinSite (record
    (c Clause)
    (j Int)))

  (fn join-sites ((arena Arena) (cs (List Clause)))
    (@intent "Each body literal of cs that Join could resolve: a joinable one, as its clause and position, sorted by
              literal")
    (@spec ((Arena (List Clause)) -> (List JoinSite)))
    (@alloc arena)
    (let ((mut raw (list-new arena JoinSite)))
      (do (for-each (c cs)
            (let ((mut j 0))
              (for-each (l (. c body))
                (do (when (joinable l) (list-push raw (record-new JoinSite (c c) (j j))))
                    (set! j (+ j 1))))))
          (match (list-get raw 0)
            ((none) raw)
            ((some s0) (sites-sorted arena raw s0))))))

  (fn sites-sorted ((arena Arena) (raw (List JoinSite)) (s0 JoinSite))
    (@intent "raw sorted by literal")
    (@spec ((Arena (List JoinSite) JoinSite) -> (List JoinSite)))
    (@alloc arena)
    (let ((idx (sort-range arena (cast Int (list-len raw))
                 (fn ((a Int) (b Int)) (lit-cmp (site-key (site-at raw a s0)) (site-key (site-at raw b s0))))))
          (mut out (list-new arena JoinSite)))
      (do (for-each (k idx) (list-push out (site-at raw k s0))) out)))

  (fn site-at ((ss (List JoinSite)) (k Int) (fallback JoinSite))
    (@intent "Element k")
    (@spec (((List JoinSite) Int JoinSite) -> JoinSite))
    (@pure)
    (match (list-get ss k) ((some x) x) ((none) fallback)))

  (fn site-key ((s JoinSite))
    (@intent "The site's body literal (every site has one)")
    (@spec ((JoinSite) -> Lit))
    (@pure)
    (match (site-lit s) ((some l) l) ((none) (atom1 (cast U32 0) (at-x)))))

  (fn site-lower ((ss (List JoinSite)) (l Lit) (fallback JoinSite))
    (@intent "The first position whose site's literal is not below l")
    (@spec (((List JoinSite) Lit JoinSite) -> Int))
    (@pure)
    (let ((mut lo 0) (mut hi (cast Int (list-len ss))))
      (do (while (< lo hi)
            (let ((mid (/ (+ lo hi) 2)))
              (if (< (lit-cmp (site-key (site-at ss mid fallback)) l) 0) (set! lo (+ mid 1)) (set! hi mid))))
          lo)))

  (fn site-lit ((s JoinSite))
    (@intent "The site's body literal")
    (@spec ((JoinSite) -> (Option Lit)))
    (@pure)
    (list-get (. (. s c) body) (. s j)))

  (fn sat-join ((arena Arena) (v U32) (p1s (List Premise)) (sites (List JoinSite)) (room Int))
    (@intent "Join of each maximal premise of p1s with a joinable selected literal against each site holding that
              literal")
    (@spec ((Arena U32 (List Premise) (List JoinSite) Int) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)))
      (do (for-each (p1 p1s)
            (when (and (<= (cast Int (list-len out)) room) (. p1 maxed) (joinable (. p1 sel)))
              (for-each (c (join-one arena v p1 sites)) (list-push out c))))
          out)))

  (fn join-one ((arena Arena) (v U32) (p1 Premise) (sites (List JoinSite)))
    (@intent "Join of one premise against each site holding its selected literal, found by it (sites are sorted)")
    (@spec ((Arena U32 Premise (List JoinSite)) -> (List Cand)))
    (@alloc arena)
    (match (list-get sites 0)
      ((none) (list-new arena Cand))
      ((some s0) (join-from arena v p1 sites (site-lower sites (. p1 sel) s0) s0))))

  (fn join-from ((arena Arena) (v U32) (p1 Premise) (sites (List JoinSite)) (k0 Int) (s0 JoinSite))
    (@intent "join-one over the sites from position k0 while they hold p1's selected literal")
    (@spec ((Arena U32 Premise (List JoinSite) Int JoinSite) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)) (mut k k0))
      (do (while (and (< k (cast Int (list-len sites))) (site-holds (site-at sites k s0) (. p1 sel)))
            (let ((s (site-at sites k s0)))
              (do (for-each (c (join-kept arena v p1 (. s c) (. s j)))
                    (list-push out c))
                  (set! k (+ k 1)))))
          out)))

  (fn site-holds ((s JoinSite) (l Lit))
    (@intent "Is the site's body literal l?")
    (@spec ((JoinSite Lit) -> Bool))
    (@pure)
    (match (site-lit s) ((some m) (lit-eq m l)) ((none) false)))

  (fn nom-pairs ((arena Arena) (env Env) (st Structure) (h Here) (d Dl4) (p1s (List Premise)) (p2s (List Premise)))
    (@intent "Nom on one DL4 clause, B₁(o) from p1s and S_{B₂}(o, x) from p2s")
    (@spec ((Arena Env Structure Here Dl4 (List Premise) (List Premise)) -> Round))
    (@alloc arena)
    (let ((mut cands (list-new arena Cand)) (mut noms (list-new arena NomAct)))
      (do (for-each (p1 p1s)
            (when (nom-first p1 d)
              (for-each (p2 p2s)
                (when (nom-second p2 d (. (. (. p1 sel) t1) cst))
                  (let ((r (nom-pair arena env (. st ord) (. h v) d p1 p2)))
                    (do (for-each (c (. r cands)) (list-push cands c))
                        (for-each (a (. r noms)) (list-push noms a))))))))
          (round-of cands (list-new arena SuccAct) (list-new arena RSuccAct) noms false))))

  (fn sat-nom ((arena Arena) (env Env) (st Structure) (dl Delta) (h Here))
    (@intent "Nom: every pair when constants are new (they are its children), else the pairs with a new premise; away
              from the root, also with B₁(o) from G")
    (@spec ((Arena Env Structure Delta Here) -> Round))
    (@alloc arena)
    (let ((all (consts-new st dl))
          (mine (nom-own arena env st h all))
          (mut cands (list-new arena Cand)) (mut noms (list-new arena NomAct)))
      (do (for-each (c (. mine cands)) (list-push cands c))
          (for-each (a (. mine noms)) (list-push noms a))
          (when (not (. h root))
            (for-each (d (. (. h hx) dl4s))
              (for-each (r (nom-ground arena env st h d all))
                (do (for-each (c (. r cands)) (list-push cands c))
                    (for-each (a (. r noms)) (list-push noms a))))))
          (round-of cands (list-new arena SuccAct) (list-new arena RSuccAct) noms false))))

  (fn nom-ground ((arena Arena) (env Env) (st Structure) (h Here) (d Dl4) (all Bool))
    (@intent "Nom on one clause, if it is DL4's at-most clause, with B₁(o) from G: every pair when constants are new
              (all), else the pairs with a new premise")
    (@spec ((Arena Env Structure Here Dl4 Bool) -> (List Round)))
    (@alloc arena)
    (cond ((not (. d ok)) (list-new arena Round))
          (all (one-round arena (nom-from-g arena env st h d (. h aps) 0)))
          (else (two-rounds arena (nom-from-g arena env st h d (. h aps) 1)
                            (nom-from-g arena env st h d (. h dps) 2)))))

  (fn nom-own ((arena Arena) (env Env) (st Structure) (h Here) (all Bool))
    (@intent "Nom on S_v's pairs over O's DL4 clauses (found once): every pair when constants are new (all), else the
              pairs with a new premise")
    (@spec ((Arena Env Structure Here Bool) -> Round))
    (@alloc arena)
    (let ((mut cands (list-new arena Cand)) (mut noms (list-new arena NomAct)))
      (do (for-each (d (. (. h hx) dl4s))
            (for-each (r (if all
                           (one-round arena (nom-pairs arena env st h d (. h aps) (. h aps)))
                           (two-rounds arena (nom-pairs arena env st h d (. h dps) (. h aps))
                                       (nom-pairs arena env st h d (. h ops) (. h dps)))))
              (do (for-each (c (. r cands)) (list-push cands c))
                  (for-each (a (. r noms)) (list-push noms a)))))
          (round-of cands (list-new arena SuccAct) (list-new arena RSuccAct) noms false))))

  (fn one-round ((arena Arena) (a Round))
    (@intent "[a]")
    (@spec ((Arena Round) -> (List Round)))
    (@alloc arena)
    (let ((mut out (list-new arena Round))) (do (list-push out a) out)))

  (fn nom-from-g ((arena Arena) (env Env) (st Structure) (h Here) (d Dl4) (p2s (List Premise)) (which Int))
    (@intent "Nom on one DL4 clause with B₁(o) from G (a premise that counts for which) and S_{B₂}(o, x) from p2s")
    (@spec ((Arena Env Structure Here Dl4 (List Premise) Int) -> Round))
    (@alloc arena)
    (let ((mut cands (list-new arena Cand)) (mut noms (list-new arena NomAct)))
      (do (for-each (p2 p2s)
            (when (and (. p2 maxed) (== (. (. p2 sel) form) 'lf-binary) (== (. (. (. p2 sel) t1) kind) 'ak-u))
              (let ((r (nom-g-one arena env st h d p2 (. (. (. p2 sel) t1) cst) which)))
                (do (for-each (c (. r cands)) (list-push cands c))
                    (for-each (a (. r noms)) (list-push noms a))))))
          (round-of cands (list-new arena SuccAct) (list-new arena RSuccAct) noms false))))

  (fn nom-g-one ((arena Arena) (env Env) (st Structure) (h Here) (d Dl4) (p2 Premise) (o U32) (which Int))
    (@intent "Nom with S_{B₂}(o, x) = p2 and B₁(o) from each premise of G selecting it (found by that literal) that
              counts for which")
    (@spec ((Arena Env Structure Here Dl4 Premise U32 Int) -> Round))
    (@alloc arena)
    (let ((mut cands (list-new arena Cand)) (mut noms (list-new arena NomAct)))
      (do (for-each (k (g-sel-range arena (. h gd) (atom1 (. d b1) (at-u o))))
            (let ((p1 (g-premise-at (. h gd) k (fallback-premise arena))))
              (when (and (g-picks h k which) (nom-first p1 d) (nom-second p2 d o))
                (let ((r (nom-pair arena env (. st ord) (. h v) d p1 p2)))
                  (do (for-each (c (. r cands)) (list-push cands c))
                      (for-each (a (. r noms)) (list-push noms a)))))))
          (round-of cands (list-new arena SuccAct) (list-new arena RSuccAct) noms false))))

  (fn two-rounds ((arena Arena) (a Round) (b Round))
    (@intent "[a, b]")
    (@spec ((Arena Round Round) -> (List Round)))
    (@alloc arena)
    (let ((mut out (list-new arena Round))) (do (list-push out a) (list-push out b) out)))

  ;; ============================================================
  ;; Derive, Table 3
  ;; ============================================================

  (fn k2-touched ((arena Arena) (env Env) (h Here) (kn KIdx) (p Premise))
    (@intent "Does a new clause of v put an atom into K₂ for p's successor term? Then p's Succ instance has a new
              premise. kn is the K-set index of Δ_v")
    (@spec ((Arena Env Here KIdx Premise) -> Bool))
    (@alloc arena)
    (match (succ-sig (. h root) (. p sel))
      ((none) false)
      ((some sg) (> (list-len (. (k-query arena (. env tr) kn sg) k2)) 0))))

  (fn succ-premises ((arena Arena) (env Env) (st Structure) (h Here))
    (@intent "The premises whose Succ instance has a new premise: the new ones, and the old ones whose K₂ a new clause
              of S_v touches (G adds nothing to K₂: see sat-succ)")
    (@spec ((Arena Env Structure Here) -> (List Premise)))
    (@alloc arena)
    (let ((kn (if (. h views) (k-index-premises arena (. env tr) (. h dps)) (k-index arena (. st ord) (. env tr) (. h news))))
          (gnew (> (list-len (. kn ground)) 0))
          (mut out (list-new arena Premise)))
      (do (for-each (p (. h dps)) (list-push out p))
          (when (or gnew (> (list-len (. kn fparts)) 0))
            (for-each (p (. h ops))
              (when (and (. p maxed) (or gnew (k2-touched-apart env h kn p))) (list-push out p))))
          out)))

  (fn k2-touched-apart ((env Env) (h Here) (kn KIdx) (p Premise))
    (@intent "k2-touched in a scratch arena of its own: only the answer outlives its K-set query")
    (@spec ((Env Here KIdx Premise) -> Bool))
    ;; One query per old premise, each sorting literal sets: kept in the
    ;; round's arena they filled memory (slice 11c's fuzzer, seed 367: 0.7 GB
    ;; to past 12 GB in one round).
    (let ((tmp (arena-new 65536)) (touched (k2-touched tmp env h kn p)))
      (do (arena-free tmp) touched)))

  ;; Succ through the view. G adds no atom to K₂: an atom it could add is a
  ;; maximal ground Su(O) atom of a visible member, so in Suʳ(O), and the
  ;; boundary has put its A → A into S_{v_r} (with-units). An atom A′ with
  ;; A′ → A′ ∈̂ G is dropped from K₂: every target reads G, so it covers A′,
  ;; and its A′ → A′ is ∈̂ there. At the root, K₂ reads S_{v_r}, which holds
  ;; G.

  ;; One Succ trigger: a maximal premise and its successor term.
  (type Trig (record
    (p  Premise)
    (sg SuccSig)))

  ;; K₁, K₂ through the view and the coverage check, for one successor term:
  ;; all that Succ reads besides the trigger itself.
  (type SuccView (record
    (ks      KSets)
    (covered Bool)))

  (fn sat-succ ((arena Arena) (env Env) (st Structure) (h Here) (ps (List Premise)))
    (@intent "Succ on each maximal premise of ps, with K₂ read through the view. S_v's K-sets are indexed once
              (k-index), the part of K₂ no successor term changes is taken once, and the rest once per successor
              term: triggers are taken in term order")
    (@spec ((Arena Env Structure Here (List Premise)) -> (List SuccAct)))
    (@alloc arena)
    (let ((kx (if (. h views) (k-index-premises arena (. env tr) (. h aps)) (k-index arena (. st ord) (. env tr) (. h all))))
          (base (unheld arena (. h gd) (. kx ground)))
          (bare (record-new KIdx (ground (list-new arena Lit)) (fparts (. kx fparts))))
          (ts (triggers-of arena h ps))
          (mut out (list-new arena SuccAct)))
      (match (list-get ts 0)
        ((none) out)
        ((some t0) (succ-trigs arena env st h bare base ts t0)))))

  (fn succ-trigs ((arena Arena) (env Env) (st Structure) (h Here) (bare KIdx) (base (List Lit)) (ts (List Trig))
                  (t0 Trig))
    (@intent "Succ on each trigger of ts, in term order, the term's K-sets and coverage taken once per term; with
              deferral, one evaluation per term")
    (@spec ((Arena Env Structure Here KIdx (List Lit) (List Trig) Trig) -> (List SuccAct)))
    (@alloc arena)
    (let ((mut sv (succ-view arena env st h bare base (. t0 sg))) (mut last (. t0 sg))
          (mut out (list-new arena SuccAct)))
      (do (when (. h dfr) (list-push out (succ-eval arena env h sv (. t0 sg))))
          (for-each (t ts)
            (do (when (!= (sg-cmp (. t sg) last) 0)
                  (do (set! sv (succ-view arena env st h bare base (. t sg))) (set! last (. t sg))
                      (when (. h dfr) (list-push out (succ-eval arena env h sv (. t sg))))))
                (when (not (. h dfr)) (for-each (a (succ-on arena env h sv t)) (list-push out a)))))
          out)))

  ;; With deferral (R8), every trigger of a term is one evaluation of Succ
  ;; for (v, f): its action names the strategy's target for K₁ (target
  ;; refresh: sat-apply makes sure the edge and the context exist) and
  ;; carries all of K₂, which sat-apply adds to trig(v, f) before pushing
  ;; it. Succ's covered test is not read: refresh and pushing do its work.
  (fn succ-eval ((arena Arena) (env Env) (h Here) (sv SuccView) (sg SuccSig))
    (@intent "One evaluation of Succ for (v, f) under deferral: the strategy's target for K₁, and K₂")
    (@spec ((Arena Env Here SuccView SuccSig) -> SuccAct))
    (@alloc arena)
    (let ((k1 (. (. sv ks) k1)))
      (record-new SuccAct (from (. h v)) (sg sg) (core (core-of arena (strat-choice (. env strat) (. env tr) (. sg f) k1) k1))
                          (adds (. (. sv ks) k2)))))

  (fn triggers-of ((arena Arena) (h Here) (ps (List Premise)))
    (@intent "The maximal premises of ps with a successor term, sorted by it")
    (@spec ((Arena Here (List Premise)) -> (List Trig)))
    (@alloc arena)
    (let ((mut raw (list-new arena Trig)))
      (do (for-each (p ps)
            (when (. p maxed)
              (match (succ-sig (. h root) (. p sel))
                ((none) (set! raw raw))
                ((some sg) (list-push raw (record-new Trig (p p) (sg sg)))))))
          (match (list-get raw 0)
            ((none) raw)
            ((some t0) (trigs-sorted arena raw t0))))))

  (fn trigs-sorted ((arena Arena) (raw (List Trig)) (t0 Trig))
    (@intent "raw sorted by successor term")
    (@spec ((Arena (List Trig) Trig) -> (List Trig)))
    (@alloc arena)
    (let ((idx (sort-range arena (cast Int (list-len raw))
                 (fn ((a Int) (b Int)) (sg-cmp (. (trig-at raw a t0) sg) (. (trig-at raw b t0) sg)))))
          (mut out (list-new arena Trig)))
      (do (for-each (k idx) (list-push out (trig-at raw k t0))) out)))

  (fn trig-at ((ts (List Trig)) (k Int) (fallback Trig))
    (@intent "Element k")
    (@spec (((List Trig) Int Trig) -> Trig))
    (@pure)
    (match (list-get ts k) ((some t) t) ((none) fallback)))

  (fn sg-cmp ((a SuccSig) (b SuccSig))
    (@intent "Successor terms by f, then u, then whether at the root")
    (@spec ((SuccSig SuccSig) -> Int))
    (@pure)
    (cond ((< (. a f) (. b f)) -1) ((> (. a f) (. b f)) 1)
          ((< (. a u) (. b u)) -1) ((> (. a u) (. b u)) 1)
          ((== (. a root) (. b root)) 0)
          ((. a root) 1)
          (else -1)))

  (fn succ-view ((arena Arena) (env Env) (st Structure) (h Here) (bare KIdx) (base (List Lit)) (sg SuccSig))
    (@intent "K₁ and K₂ through the view for successor term sg (base, and S_v's literals that mention sg's term), and
              whether an f-edge's target covers K₂")
    (@spec ((Arena Env Structure Here KIdx (List Lit) SuccSig) -> SuccView))
    (@alloc arena)
    (let ((ks (k-query arena (. env tr) bare sg))
          (k2 (merged-lits arena base (unheld arena (. h gd) (. ks k2)))))
      (record-new SuccView (ks (record-new KSets (k1 (. ks k1)) (k2 k2)))
                           (covered (and (not (. h dfr)) (covered-view arena env st (. h v) (. sg f) k2))))))

  (fn succ-on ((arena Arena) (env Env) (h Here) (sv SuccView) (t Trig))
    (@intent "Succ on one trigger, given its term's K-sets and coverage: the action if it fires")
    (@spec ((Arena Env Here SuccView Trig) -> (List SuccAct)))
    (@alloc arena)
    (let ((r (succ-step arena (. env strat) (. env tr) (. t sg) (. t p) (. sv ks) (. sv covered)))
          (mut out (list-new arena SuccAct)))
      (do (when (. r fires)
            (list-push out (record-new SuccAct (from (. h v)) (sg (. t sg))
                                       (core (core-of arena (. r choice) (. (. sv ks) k1)))
                                                 (adds (. r adds)))))
          out)))

  (fn merged-lits ((arena Arena) (a (List Lit)) (b (List Lit)))
    (@intent "a ∪ b, as a set")
    (@spec ((Arena (List Lit) (List Lit)) -> (List Lit)))
    (@alloc arena)
    (if (== (list-len b) 0)
      a
      (let ((mut xs (list-new arena Lit)))
        (do (for-each (l a) (list-push xs l)) (for-each (l b) (list-push xs l)) (lit-set arena xs)))))

  (fn unheld ((arena Arena) (gd Ground) (k2 (List Lit)))
    (@intent "The atoms A′ of k2 with A′ → A′ ∉̂ G")
    (@spec ((Arena Ground (List Lit)) -> (List Lit)))
    (@alloc arena)
    (let ((mut out (list-new arena Lit)))
      (do (for-each (a k2) (when (not (g-held arena gd a)) (list-push out a))) out)))

  (fn covered-view ((arena Arena) (env Env) (st Structure) (v U32) (f U32) (k2 (List Lit)))
    (@intent "Is there an f-edge ⟨v, w, f⟩ whose target covers K₂? (No atom of k2 is held by G, so S_w alone decides)")
    (@spec ((Arena Env Structure U32 U32 (List Lit)) -> Bool))
    (@alloc arena)
    (let ((mut found false))
      (do (for-each (e (. st edges))
            (when (and (== (. e from) v) (== (. e lk) 'el-fn) (== (. e label) f)
                       (covers k2 (core-at env st arena (cast Int (. e to))) (set-of env st (cast Int (. e to)))))
              (set! found true)))
          found)))

  (fn pred-anchored ((arena Arena) (env Env) (job PJob) (dix PIdx) (oix PIdx) (aix PIdx) (room Int))
    (@intent "One Pred or r-Pred job, once per side slot anchored in Δ_w; past room, the rest skipped")
    (@spec ((Arena Env PJob PIdx PIdx PIdx Int) -> Out))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)) (mut over false) (mut i 0))
      (do (while (and (< i (cast Int (list-len (. job slots)))) (<= (cast Int (list-len out)) room))
            (let ((o (pred-anchor arena env job dix oix aix i room)))
              (do (for-each (c (. o cands)) (list-push out c))
                  (when (. o over) (set! over true))
                  (set! i (+ i 1)))))
          (out-of out over))))

  (fn slot-ix ((arena Arena) (s CSub) (slot PSlot) (ix PIdx))
    (@intent "The premises pred-step can meet a slot with: maximal, selecting exactly Cᵢσ (pslot-cands' filter, by
              lookup)")
    (@spec ((Arena CSub PSlot PIdx) -> (List Premise)))
    (@alloc arena)
    (pidx-find arena ix (csub-lit s (. slot lit))))

  (fn pred-anchor ((arena Arena) (env Env) (job PJob) (dix PIdx) (oix PIdx) (aix PIdx) (i Int) (room Int))
    (@intent "One job with side slot i anchored in Δ_w: every choice, finished as pred-run finishes, while within
              room")
    (@spec ((Arena Env PJob PIdx PIdx PIdx Int Int) -> Out))
    (@alloc arena)
    (let ((mut cs (list-new arena (List Premise))) (mut j 0))
      (do (for-each (slot (. job slots))
            (do (list-push cs (slot-ix arena (. job s) slot (pick-ix j i dix oix aix))) (set! j (+ j 1))))
          (pred-choices arena env job cs (. aix ps) room))))

  (fn pred-run-ix ((arena Arena) (env Env) (job PJob) (aix PIdx) (room Int))
    (@intent "Every choice of side premises for one job, finished by pred-finish or rpred-finish (pred-run, with each
              slot's premises found by lookup), while within room")
    (@spec ((Arena Env PJob PIdx Int) -> Out))
    (@alloc arena)
    (let ((mut cs (list-new arena (List Premise))))
      (do (for-each (slot (. job slots)) (list-push cs (slot-ix arena (. job s) slot aix)))
          (pred-choices arena env job cs (. aix ps) room))))

  (fn pred-choices ((arena Arena) (env Env) (job PJob) (cs (List (List Premise))) (ps (List Premise)) (room Int))
    (@intent "Every choice of one premise per slot from cs, finished, until the conclusions pass room; over the choices
              cap, none, and over")
    (@spec ((Arena Env PJob (List (List Premise)) (List Premise) Int) -> Out))
    (@alloc arena)
    (let ((n (product cs (. env prod))) (mut out (list-new arena Cand)) (mut t 0))
      (if (> n (. env prod))
        (out-of out true)
        ;; Each choice in a scratch arena, its conclusion copied out, as
        ;; Hyper's and Eq's are (slice 11b): in the round's arena a generated
        ;; ontology's Pred kept some 18 KB a conclusion. One arena, emptied
        ;; after each choice: one per choice spent 40% of Pred's time in
        ;; malloc and free.
        (let ((tmp (arena-new 65536)))
          (do (while (and (< t n) (<= (cast Int (list-len out)) room))
                (do (for-each (c (pred-one tmp env job cs t ps)) (list-push out (copy-cand arena c)))
                    (reuse-arena tmp)
                    (set! t (+ t 1))))
              (arena-free tmp)
              (out-of out false))))))

  (fn w-ix ((arena Arena) (env Env) (st Structure) (h Here) (w Int) (cs (List Clause)) (which Int))
    (@intent "S_w's premises (which 0), Δ_w's (1) or the rest's (2), as filed for this round")
    (@spec ((Arena Env Structure Here Int (List Clause) Int) -> PIdx))
    (@alloc arena)
    (let ((x (cix-at arena (. h ixs) w)))
      (cond ((== which 1) (. x dix)) ((== which 2) (. x oix)) (else (. x aix)))))

  (fn pred-side ((arena Arena) (env Env) (st Structure) (dl Delta) (h Here) (e Edge))
    (@intent "Pred over ⟨w, v, f⟩ for the old clauses of S_v, with a side premise new in S_w; into v_r for each u ∈
              U_H")
    (@spec ((Arena Env Structure Delta Here Edge) -> Out))
    (@alloc arena)
    (let ((w (cast Int (. e from)))
          (toroot (is-root st (cast Int (. e from))))
          (aix (w-ix arena env st h w (set-of env st w) 0))
          (dix (w-ix arena env st h w (cs-at (. dl news) w (. env nobody)) 1))
          (oix (w-ix arena env st h w (cs-at (. dl olds) w (. env nobody)) 2))
          (core (core-at env st arena (cast Int (. h v))))
          (mut out (list-new arena Cand)) (mut over false))
      (do (for-each (c (. h olds))
            (let ((view (pred-view arena c core toroot)) (slots (slots-of arena (. view slots))))
              (for-each (job (side-jobs arena st view slots e toroot))
                (let ((o (if (roomy out h) (pred-anchored arena env job dix oix aix (. h room)) (no-out arena))))
                  (do (for-each (x (. o cands)) (list-push out x)) (when (. o over) (set! over true)))))))
          (out-of out over))))

  (fn pred-edge-ix ((arena Arena) (env Env) (st Structure) (h Here) (e Edge) (cs (List Clause)))
    (@intent "Pred over one edge ⟨w, v, f⟩ for each clause of cs: into w; into v_r, for each u ∈ U_H (E4). The
              reference's pred-edge, with S_w's premises filed")
    (@spec ((Arena Env Structure Here Edge (List Clause)) -> Out))
    (@alloc arena)
    (let ((w (cast Int (. e from)))
          (toroot (is-root st (cast Int (. e from))))
          (aix (w-ix arena env st h w (set-of env st w) 0))
          (core (core-at env st arena (cast Int (. h v))))
          (mut out (list-new arena Cand)) (mut over false))
      (do (for-each (c cs)
            (let ((view (pred-view arena c core toroot)) (slots (slots-of arena (. view slots))))
              (for-each (job (side-jobs arena st view slots e toroot))
                (let ((o (if (roomy out h) (pred-run-ix arena env job aix (. h room)) (no-out arena))))
                  (do (for-each (x (. o cands)) (list-push out x)) (when (. o over) (set! over true)))))))
          (out-of out over))))

  (fn side-jobs ((arena Arena) (st Structure) (view PredView) (slots (List PSlot)) (e Edge) (toroot Bool))
    (@intent "The Pred jobs over ⟨w, v, f⟩ for one clause: one away from the root; into v_r, one for each u ∈ U_H")
    (@spec ((Arena Structure PredView (List PSlot) Edge Bool) -> (List PJob)))
    (@alloc arena)
    (let ((mut out (list-new arena PJob)) (mut u 0))
      (do (if (not toroot)
            (list-push out (away-job view slots (. e label) (. e from)))
            (while (< u (consts-of st))
              (do (list-push out (root-job view slots (. e from) (. e label) (cast U32 u))) (set! u (+ u 1)))))
          out)))

  (fn no-out ((arena Arena))
    (@intent "No conclusions, not over: a step skipped past room")
    (@spec ((Arena) -> Out))
    (@alloc arena)
    (out-of (list-new arena Cand) false))

  (fn sat-pred ((arena Arena) (env Env) (st Structure) (dl Delta) (h Here) (ins (List Edge)))
    (@intent "Pred over every f-edge ⟨w, v, f⟩: all of it when the edge is new (or w is v_r and constants are new); else
              the new clauses of S_v, and the old ones with a new side premise in S_w. Past h's room the rest is skipped
              (the round is abandoned either way)")
    (@spec ((Arena Env Structure Delta Here (List Edge)) -> Out))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)) (mut over false))
      (do (for-each (e ins)
            (when (and (== (. e lk) 'el-fn) (roomy out h))
              (for-each (o (pred-over arena env st dl h e))
                (do (for-each (x (. o cands)) (list-push out x)) (when (. o over) (set! over true))))))
          (out-of out over))))

  (fn pred-over ((arena Arena) (env Env) (st Structure) (dl Delta) (h Here) (e Edge))
    (@intent "Pred over one f-edge into v, anchored")
    (@spec ((Arena Env Structure Delta Here Edge) -> (List Out)))
    (@alloc arena)
    (let ((mut out (list-new arena Out)) (w (cast Int (. e from))))
      (do (if (or (edge-new dl e) (and (is-root st w) (consts-new st dl)))
            (list-push out (pred-edge-ix arena env st h e (. h all)))
            (do (list-push out (pred-edge-ix arena env st h e (. h news)))
                (when (> (list-len (cs-at (. dl news) w (. env nobody))) 0)
                  (list-push out (pred-side arena env st dl h e)))))
          out)))

  (fn rpred-edge-new ((dl Delta) (v U32))
    (@intent "Was an edge ⟨v, v_r, u⟩ created this round?")
    (@spec ((Delta U32) -> Bool))
    (@pure)
    (let ((mut found false))
      (do (for-each (e (. dl edges))
            (when (and (== (. e from) v) (== (. e to) (cast U32 0)) (== (. e lk) 'el-const)) (set! found true)))
          found)))

  (fn sat-rpred ((arena Arena) (env Env) (st Structure) (dl Delta) (h Here))
    (@intent "r-Pred into v, never from a member of G (the view holds it): all of it when v is new or an edge ⟨v, v_r,
              u⟩ is; else the new root clauses, and the old ones with a new side premise in S_v")
    (@spec ((Arena Env Structure Delta Here) -> Out))
    (@alloc arena)
    (if (or (. h fresh) (rpred-edge-new dl (. h v)))
      (rpred-from arena env st h (. (. h rs) all) (. h aps) false)
      (let ((a (rpred-from arena env st h (. (. h rs) news) (. h aps) false))
            (b (if (> (list-len (. h news)) 0)
                 (rpred-from arena env st h (. (. h rs) olds) (. h aps) true)
                 (out-of (list-new arena Cand) false))))
        (out-of (append-cands arena (. a cands) (. b cands)) (or (. a over) (. b over))))))

  (fn rpred-from ((arena Arena) (env Env) (st Structure) (h Here) (rs (List RSrc)) (aps (List Premise))
                  (anchored Bool))
    (@intent "r-Pred into v from each source root clause: over every choice, or (anchored) with a side premise new in
              S_v; past h's room, the rest skipped")
    (@spec ((Arena Env Structure Here (List RSrc) (List Premise) Bool) -> Out))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)) (mut over false))
      (do (for-each (r rs)
            (let ((job (rsrc-job arena st (. h v) r))
                  (o (cond ((not (roomy out h)) (no-out arena))
                           (anchored (pred-anchored arena env job (. h dix) (. h oix) (. h aix) (. h room)))
                           (else (pred-run-ix arena env job (. h aix) (. h room))))))
              (do (for-each (x (. o cands)) (list-push out x)) (when (. o over) (set! over true)))))
          (out-of out over))))

  ;; r-Pred's sources for one round (slice 9f). r-Pred fires on a root
  ;; clause's view exactly when its side premises meet, the view is ok and
  ;; every Lᵢ is allowed (rpred-finish's proved `sound`). The last two
  ;; depend on the clause alone, never on the context or the choice. So a
  ;; root clause that fails them is set aside once per round, instead of
  ;; being viewed in every context and finished for every choice: on CCO,
  ;; r-Pred finished 19.5M choices in round 9, and none fired. Members of
  ;; G are set aside too; the view holds them.
  (type RSrc (record
    (c    Clause)
    (view PredView)))

  (type RSrcs (record
    (all  (List RSrc))     ; from S_{v_r}, for a context new or with a new edge to the root
    (news (List RSrc))     ; from Δ_{v_r}
    (olds (List RSrc))))   ; from S_{v_r} \ Δ_{v_r}

  (fn rpred-able ((tr Triggers) (v PredView))
    (@intent "Can r-Pred fire on some choice from a clause with view v? Only when v is ok and every Lᵢ is allowed")
    (@spec ((Triggers PredView) -> Bool))
    (@pure)
    (@post (== $result (and (. v ok) (rpred-heads-ok tr (. v head)))))
    (and (. v ok) (rpred-heads-ok tr (. v head))))

  (fn rsrcs-in ((arena Arena) (tr Triggers) (cs (List Clause)))
    (@intent "The clauses of cs outside G that r-Pred can fire from, each with its view, in cs's order")
    (@spec ((Arena Triggers (List Clause)) -> (List RSrc)))
    (@alloc arena)
    (let ((mut out (list-new arena RSrc)))
      (do (for-each (c cs)
            (when (not (ground-clause c))
              (let ((v (rpred-view arena tr c)))
                (when (rpred-able tr v) (list-push out (record-new RSrc (c c) (view v)))))))
          out)))

  (fn rsrcs-of ((arena Arena) (env Env) (st Structure) (dl Delta))
    (@intent "This round's r-Pred sources: from S_{v_r}, Δ_{v_r} and the rest")
    (@spec ((Arena Env Structure Delta) -> RSrcs))
    (@alloc arena)
    (record-new RSrcs (all (rsrcs-in arena (. env tr) (set-of env st 0)))
                      (news (rsrcs-in arena (. env tr) (cs-at (. dl news) 0 (. env nobody))))
                      (olds (rsrcs-in arena (. env tr) (cs-at (. dl olds) 0 (. env nobody))))))

  (fn rsrc-job ((arena Arena) (st Structure) (v U32) (r RSrc))
    (@intent "rpred-job from r's clause into v, its view already built: σ = {y ↦ x}")
    (@spec ((Arena Structure U32 RSrc) -> PJob))
    (@alloc arena)
    (record-new PJob (view (. r view)) (s (record-new CSub (x (at-x)) (y (at-x))))
                     (slots (rslots arena st v (. (. r view) slots))) (to v) (rpred true) (toroot false)))

  ;; ============================================================
  ;; One context, one round
  ;; ============================================================

  (fn local ((st Structure) (a Adj) (arena Arena))
    (@intent "st with only v's edges, which is all a rule in v reads of them")
    (@spec ((Structure Adj Arena) -> Structure))
    (@alloc arena)
    (let ((mut es (list-new arena Edge)))
      (do (for-each (e (. a outs)) (list-push es e))
          (for-each (e (. a ins)) (list-push es e))
          (record-new Structure (ctxs (. st ctxs)) (sets (. st sets)) (edges es) (ord (. st ord))))))

  (fn sat-ctx ((arena Arena) (env Env) (hx HIdx) (ixs (List CIdx)) (rs RSrcs) (st Structure) (dl Delta) (gd Ground)
               (a Adj) (v Int) (perm Int) (dfr Bool) (views Bool) (room Int))
    (@intent "Derive in context v: every instance when v is new (the root, in the first round, as the reference does),
              else those anchored on Δ")
    (@spec ((Arena Env HIdx (List CIdx) RSrcs Structure Delta Ground Adj Int Int Bool Bool Int) -> CRound))
    (@alloc arena)
    (let ((lst (local st a arena)))
      (if (and (>= v (. dl nctx)) (is-root st v))
        (let ((r (ctx-round arena (with-room env room) lst (cast U32 v))))
          (record-new CRound (r r) (tried 0) (big (> (cast Int (list-len (. r cands))) room))))
        (sat-old arena env lst dl (. a ins) (here-room (here-of arena env lst dl gd hx ixs rs v perm dfr views) room)
                 room))))

  (fn sat-old ((arena Arena) (env Env) (st Structure) (dl Delta) (ins (List Edge)) (h Here) (room Int))
    (@intent "Derive in one context, anchored on Δ, or every instance when it is new; past room, big, with the rest
              skipped")
    (@spec ((Arena Env Structure Delta (List Edge) Here Int) -> CRound))
    (@alloc arena)
    (let ((t2 (sat-table2 arena env st dl h room)))
      (if (> (cast Int (list-len (. (. t2 out) cands))) room)
        (record-new CRound (r (round-of (. (. t2 out) cands) (list-new arena SuccAct) (list-new arena RSuccAct)
                                        (list-new arena NomAct) (. (. t2 out) over)))
                           (tried (. t2 tried)) (big true))
        (sat-old-rest arena env st dl ins h room t2))))

  (fn sat-old-rest ((arena Arena) (env Env) (st Structure) (dl Delta) (ins (List Edge)) (h Here) (room Int) (t2 HOut))
    (@intent "sat-old after Table 2: Nom, Pred, r-Pred and the Succ actions; big when the conclusions pass room")
    (@spec ((Arena Env Structure Delta (List Edge) Here Int HOut) -> CRound))
    (@alloc arena)
    ;; Each step runs only while the conclusions so far are within room;
    ;; past it the round is abandoned, so the rest, Succ's actions included,
    ;; would be work thrown away.
    (let ((t2c (. (. t2 out) cands))
          (nom (sat-nom arena env st dl h))
          (skip (out-of (list-new arena Cand) false))
          (pr (if (or (. h root) (not (within t2c (. nom cands) room))) skip (sat-pred arena env st dl h ins)))
          (rp (if (or (. h root) (not (within t2c (append-cands arena (. nom cands) (. pr cands)) room))) skip
                (sat-rpred arena env st dl h)))
          (mut cands (list-new arena Cand)))
      (do (for-each (c t2c) (list-push cands c))
          (for-each (c (. nom cands)) (list-push cands c))
          (for-each (c (. pr cands)) (list-push cands c))
          (for-each (c (. rp cands)) (list-push cands c))
          (let ((big (> (cast Int (list-len cands)) room)))
            (record-new CRound
              (r (round-of cands
                           (if big (list-new arena SuccAct) (sat-succ arena env st h (succ-premises arena env st h)))
                           (if (or big (. h root)) (list-new arena RSuccAct) (ref-rsucc arena env st (. h v) (. h dps)))
                           (. nom noms)
                           (or (. (. t2 out) over) (. pr over) (. rp over))))
              (tried (. t2 tried))
              (big big))))))

  (fn edge-at ((es (List Edge)) (k Int) (fallback Edge))
    (@intent "Element k")
    (@spec (((List Edge) Int Edge) -> Edge))
    (@pure)
    (match (list-get es k) ((some e) e) ((none) fallback)))

  (fn adjacency ((arena Arena) (st Structure))
    (@intent "Each context's edges in and out, by context id, from the edges sorted once by target and once by source")
    (@spec ((Arena Structure) -> (List Adj)))
    (@alloc arena)
    (let ((es (. st edges))
          (n (cast Int (list-len (. st ctxs))))
          (e0 (record-new Edge (from (cast U32 0)) (to (cast U32 0)) (lk 'el-fn) (label (cast U32 0))))
          (by-to (sort-range arena (cast Int (list-len (. st edges)))
                   (fn ((i Int) (j Int)) (u32-cmp (. (edge-at es i e0) to) (. (edge-at es j e0) to)))))
          (by-from (sort-range arena (cast Int (list-len (. st edges)))
                     (fn ((i Int) (j Int)) (u32-cmp (. (edge-at es i e0) from) (. (edge-at es j e0) from)))))
          (ins (buckets arena es by-to n true e0))
          (outs (buckets arena es by-from n false e0))
          (mut out (list-new arena Adj)) (mut v 0))
      (do (while (< v n)
            (do (list-push out (record-new Adj (ins (edges-at arena ins v)) (outs (edges-at arena outs v))))
                (set! v (+ v 1))))
          out)))

  (fn edges-at ((arena Arena) (bs (List Bucket)) (v Int))
    (@intent "Bucket v's edges, or none")
    (@spec ((Arena (List Bucket) Int) -> (List Edge)))
    (@alloc arena)
    (match (list-get bs v) ((some b) (. b es)) ((none) (list-new arena Edge))))

  (fn u32-cmp ((a U32) (b U32))
    (@intent "-1, 0 or 1")
    (@spec ((U32 U32) -> Int))
    (@pure)
    (cond ((< a b) -1) ((> a b) 1) (else 0)))

  (type Cut (record
    (es (List Edge))
    (k  Int)))

  (fn cut-at ((arena Arena) (es (List Edge)) (idx (List Int)) (k Int) (v Int) (by-to Bool) (e0 Edge))
    (@intent "The edges at idx's positions from k on whose target (by-to) or source is v, and the position after them")
    (@spec ((Arena (List Edge) (List Int) Int Int Bool Edge) -> Cut))
    (@alloc arena)
    (let ((mut cur (list-new arena Edge)) (mut i k) (mut going true))
      (do (while (and going (< i (cast Int (list-len idx))))
            (let ((e (edge-at es (idx-at idx i) e0)))
              (if (== (cast Int (if by-to (. e to) (. e from))) v)
                (do (list-push cur e) (set! i (+ i 1)))
                (set! going false))))
          (record-new Cut (es cur) (k i)))))

  (fn buckets ((arena Arena) (es (List Edge)) (idx (List Int)) (n Int) (by-to Bool) (e0 Edge))
    (@intent "For each context 0 to n - 1, the edges whose target (by-to) or source it is, walking idx, sorted on that
              end, once")
    (@spec ((Arena (List Edge) (List Int) Int Bool Edge) -> (List Bucket)))
    (@alloc arena)
    (let ((mut out (list-new arena Bucket)) (mut k 0) (mut v 0))
      (do (while (< v n)
            (let ((c (cut-at arena es idx k v by-to e0)))
              (do (list-push out (record-new Bucket (es (. c es))))
                  (set! k (. c k))
                  (set! v (+ v 1)))))
          out)))

  (fn idx-at ((idx (List Int)) (k Int))
    (@intent "Element k")
    (@spec (((List Int) Int) -> Int))
    (@pure)
    (match (list-get idx k) ((some i) i) ((none) 0)))

  ;; A round's derive, or one context's, and the Hyper choices it tried.
  (type CRound (record
    (r     Round)
    (tried Int)
    (big   Bool)))   ; the round's conclusions passed the room the clause budget left: abandoned (sat-round)

  (fn passes ((cr CRound) (cands (List Cand)) (room Int))
    (@intent "Has the round passed its room: this context big, or the conclusions so far past room?")
    (@spec ((CRound (List Cand) Int) -> Bool))
    (@pure)
    (or (. cr big) (> (cast Int (list-len cands)) room)))

  (fn sat-round ((arena Arena) (env Env) (hx HIdx) (st Structure) (dl Delta) (gd Ground) (perm Int) (dfr Bool)
                  (vw (List View)) (room Int))
    (@intent "Derive over every context of the frozen structure, each but the root reading G beside its own set; with
              views (vw), each clause's premise flags come from the store. Once the round's conclusions pass room, the
              rest are skipped and the round is big")
    (@spec ((Arena Env HIdx Structure Delta Ground Int Bool (List View) Int) -> CRound))
    (@alloc arena)
    ;; THE CLAUSE BUDGET INSIDE A ROUND (SPEC §5.5, slice 11b). A round can
    ;; outgrow memory long before the store, read at its boundary, passes
    ;; the budget: OBI's seventh does, from 716k stored clauses. So the
    ;; count of conclusions is read after each context. It only grows, and a
    ;; round's conclusions depend only on the store it starts from, so
    ;; whether it passes room does not depend on the context order or the
    ;; worker count, only how soon that is seen.
    (let ((adj (adjacency arena st))
          (views (> (list-len vw) 0))
          (ixs (all-ixs arena env st dl perm vw))
          (rs (rsrcs-of arena env st dl))
          (mut cands (list-new arena Cand)) (mut succs (list-new arena SuccAct))
          (mut rsuccs (list-new arena RSuccAct)) (mut noms (list-new arena NomAct))
          (mut over false) (mut tried 0) (mut big false))
      (do (for-each (v (ctx-order arena (cast Int (list-len (. st ctxs))) perm))
            (match (list-get adj v)
              ((none) (set! over over))
              ((some a)
                (when (not big)
                  (let ((cr (sat-ctx arena env hx ixs rs st dl gd a v perm dfr views
                                     (- room (cast Int (list-len cands)))))
                        (r (. cr r)))
                    (do (set! tried (+ tried (. cr tried)))
                        (for-each (x (. r cands)) (list-push cands x))
                        (for-each (x (. r succs)) (list-push succs x))
                        (for-each (x (. r rsuccs)) (list-push rsuccs x))
                        (for-each (x (. r noms)) (list-push noms x))
                        (when (. r over) (set! over true))
                        (when (passes cr cands room) (set! big true))))))))
          (record-new CRound (r (round-of cands succs rsuccs noms over)) (tried tried) (big big)))))

  ;; ============================================================
  ;; Create and commit
  ;; ============================================================

  (fn new-cores ((arena Arena) (st Structure) (from Int))
    (@intent "Core's clauses of each context from `from` on: the new contexts")
    (@spec ((Arena Structure Int) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)) (mut v 0))
      (do (for-each (c (. st ctxs))
            (do (when (>= v from) (for-each (x (ref-core arena (cast U32 v) (. c core))) (list-push out x)))
                (set! v (+ v 1))))
          out)))

  (fn sat-apply ((arena Arena) (st Structure) (gd Ground) (r Round) (scan Bool) (dfr Bool) (trig (List Supply))
                  (fl (List Flags)))
    (@intent "Create, then commit: new constants, contexts and edges in content order; then each context's min over its
              candidates, less those ∈̂ G away from the root (the view holds them), which gives Δₙ₊₁. With deferral,
              trig grows by the round's evaluations, their units are pushed, and what becomes supported is activated.
              fl is st's kept flags; the step carries the new sets'")
    (@spec ((Arena Structure Ground Round Bool Bool (List Supply) (List Flags)) -> Step))
    (@alloc arena)
    (let ((sup (if dfr (supplied arena trig (. r succs))
                 (record-new Supplied (trig trig) (evals (list-new arena Supply)) (grew false))))
          (n0 (consts-of st))
          (c0 (cast Int (list-len (. st ctxs))))
          (e0 (cast Int (list-len (. st edges))))
          (s1 (record-new Structure (ctxs (. st ctxs)) (sets (. st sets)) (edges (. st edges))
                                    (ord (add-consts arena (. st ord) (. r noms)))))
          (s2 (add-contexts arena s1 (. r succs)))
          (s3 (if scan (add-edges arena s2 (. r succs) (. r rsuccs)) (edges-added arena s2 (. r succs) (. r rsuccs))))
          (cands (append-cands arena (append-cands arena (. r cands) (succ-cands arena s3 r sup dfr))
                                     (new-cores arena s3 c0)))
          (sp (commit-all arena s3 (outside-view arena s3 gd cands) c0 e0 n0 scan fl)))
      (if dfr (deferred-step arena sp e0 trig sup) sp)))

  (fn succ-cands ((arena Arena) (st Structure) (r Round) (sup Supplied) (dfr Bool))
    (@intent "Succ's A′ → A′ into its target and r-Succ's A → A into v_r; with deferral, pushing's units in place of
              Succ's")
    (@spec ((Arena Structure Round Supplied Bool) -> (List Cand)))
    (@alloc arena)
    (if dfr
      (append-cands arena (action-cands arena st (list-new arena SuccAct) (. r rsuccs)) (pushed arena st (. sup evals)))
      (action-cands arena st (. r succs) (. r rsuccs))))

  ;; add-edges (sriqref) folds with-edge over the actions, and with-edge
  ;; copies the whole edge list for every edge it adds: on CCO's round 9,
  ;; a quarter of the arena. Its result is the existing edges, then each
  ;; action's edges in action order, an edge only at its first occurrence
  ;; and only when it is not among the existing ones. edges-added builds
  ;; that list with one stable sort of the new edges and a binary search
  ;; of the existing ones (slice 9f); a test diffs the two on every round.

  (fn edges-added ((arena Arena) (st Structure) (succs (List SuccAct)) (rsuccs (List RSuccAct)))
    (@intent "add-edges, through a sort: st with Succ's ⟨v, w, f⟩ (and the root's ⟨v_r, w, u⟩) and r-Succ's ⟨v, v_r,
              u⟩, each once")
    (@spec ((Arena Structure (List SuccAct) (List RSuccAct)) -> Structure))
    (@alloc arena)
    (let ((news (action-edges arena st succs rsuccs))
          (mut es (list-new arena Edge)))
      (do (for-each (e (. st edges)) (list-push es e))
          (for-each (e (first-new arena (. st edges) news)) (list-push es e))
          (record-new Structure (ctxs (. st ctxs)) (sets (. st sets)) (edges es) (ord (. st ord))))))

  (fn action-edges ((arena Arena) (st Structure) (succs (List SuccAct)) (rsuccs (List RSuccAct)))
    (@intent "The edges the actions add, in the order add-edges folds them, repeats included")
    (@spec ((Arena Structure (List SuccAct) (List RSuccAct)) -> (List Edge)))
    (@alloc arena)
    (let ((mut out (list-new arena Edge)))
      (do (for-each (a succs)
            (let ((w (ctx-by-core st (. a core))))
              (do (list-push out (record-new Edge (from (. a from)) (to w) (lk 'el-fn) (label (. (. a sg) f))))
                  (when (. (. a sg) root)
                    (list-push out (record-new Edge (from (. a from)) (to w) (lk 'el-const) (label (. (. a sg) u))))))))
          (for-each (a rsuccs)
            (list-push out (record-new Edge (from (. a from)) (to (cast U32 0)) (lk 'el-const) (label (. a u)))))
          out)))

  (fn first-new ((arena Arena) (old (List Edge)) (news (List Edge)))
    (@intent "The edges of news at their first occurrence and not in old, in news's order")
    (@spec ((Arena (List Edge) (List Edge)) -> (List Edge)))
    (@alloc arena)
    (match (list-get news 0)
      ((none) (list-new arena Edge))
      ((some e0) (in-news-order arena news (kept-positions arena old news e0) e0))))

  (fn kept-positions ((arena Arena) (old (List Edge)) (news (List Edge)) (e0 Edge))
    (@intent "The positions in news first-new keeps, in key order")
    (@spec ((Arena (List Edge) (List Edge) Edge) -> (List Int)))
    (@alloc arena)
    ;; nidx is a stable sort, so the first of each run of equal edges is
    ;; the earliest occurrence.
    (let ((oidx (sort-range arena (cast Int (list-len old))
                  (fn ((i Int) (j Int)) (edge-cmp (edge-at old i e0) (edge-at old j e0)))))
          (nidx (sort-range arena (cast Int (list-len news))
                  (fn ((i Int) (j Int)) (edge-cmp (edge-at news i e0) (edge-at news j e0)))))
          (mut keep (list-new arena Int)) (mut prev -1))
      (do (for-each (k nidx)
            (do (when (run-first-new old oidx news prev k e0) (list-push keep k))
                (set! prev k)))
          keep)))

  (fn run-first-new ((old (List Edge)) (oidx (List Int)) (news (List Edge)) (prev Int) (k Int) (e0 Edge))
    (@intent "Is news's edge k the first of its run (prev is the one before it in key order, or -1) and not in old?")
    (@spec (((List Edge) (List Int) (List Edge) Int Int Edge) -> Bool))
    (@pure)
    (let ((e (edge-at news k e0)))
      (and (or (< prev 0) (!= (edge-cmp (edge-at news prev e0) e) 0))
           (not (edge-in old oidx e e0)))))

  (fn in-news-order ((arena Arena) (news (List Edge)) (keep (List Int)) (e0 Edge))
    (@intent "The edges of news at the positions keep holds, in news's order")
    (@spec ((Arena (List Edge) (List Int) Edge) -> (List Edge)))
    (@alloc arena)
    (let ((mut out (list-new arena Edge)))
      (do (for-each (k (sort-range arena (cast Int (list-len keep))
                         (fn ((i Int) (j Int)) (int-cmp (idx-at keep i) (idx-at keep j)))))
            (list-push out (edge-at news (idx-at keep k) e0)))
          out)))

  (fn edge-in ((es (List Edge)) (idx (List Int)) (e Edge) (e0 Edge))
    (@intent "Is e among es, whose order under edge-cmp is idx?")
    (@spec (((List Edge) (List Int) Edge Edge) -> Bool))
    (@pure)
    (let ((mut lo 0) (mut hi (cast Int (list-len idx))))
      (do (while (< lo hi)
            (let ((mid (/ (+ lo hi) 2)))
              (if (< (edge-cmp (edge-at es (idx-at idx mid) e0) e) 0) (set! lo (+ mid 1)) (set! hi mid))))
          (and (< lo (cast Int (list-len idx))) (== (edge-cmp (edge-at es (idx-at idx lo) e0) e) 0)))))

  (fn edge-cmp ((a Edge) (b Edge))
    (@intent "By from, to, kind, then label")
    (@spec ((Edge Edge) -> Int))
    (@pure)
    (cond ((!= (. a from) (. b from)) (u32-cmp (. a from) (. b from)))
          ((!= (. a to) (. b to)) (u32-cmp (. a to) (. b to)))
          ((!= (lk-rank (. a lk)) (lk-rank (. b lk))) (int-cmp (lk-rank (. a lk)) (lk-rank (. b lk))))
          (else (u32-cmp (. a label) (. b label)))))

  (fn lk-rank ((lk EdgeLabel))
    (@intent "el-fn before el-const")
    (@spec ((EdgeLabel) -> Int))
    (@pure)
    (match lk ('el-fn 0) ('el-const 1)))

  (fn int-cmp ((a Int) (b Int))
    (@intent "-1, 0 or 1 as a is below, at or above b")
    (@spec ((Int Int) -> Int))
    (@pure)
    (cond ((< a b) -1) ((> a b) 1) (else 0)))

  (fn outside-view ((arena Arena) (st Structure) (gd Ground) (cands (List Cand)))
    (@intent "The candidates not ∈̂ G, at the root all of them: a context but the root reads G already")
    (@spec ((Arena Structure Ground (List Cand)) -> (List Cand)))
    (@alloc arena)
    (let ((mut out (list-new arena Cand)))
      (do (for-each (c cands)
            (when (or (is-root st (cast Int (. c ctx))) (not (g-in-hat gd (. c c)))) (list-push out c)))
          out)))

  (fn commit-all ((arena Arena) (st Structure) (cands (List Cand)) (c0 Int) (e0 Int) (n0 Int) (scan Bool)
                   (fl (List Flags)))
    (@intent "Each context's set and Δ: candidates sorted by context and content, each context committed through
              commit-min over its own run of them; and each new set's flags, walked from fl (st's)")
    (@spec ((Arena Structure (List Cand) Int Int Int Bool (List Flags)) -> Step))
    (@alloc arena)
    (let ((none-such (record-new Cand (ctx (cast U32 0))
                                 (c (record-new Clause (body (list-new arena Lit)) (head (list-new arena Lit))))))
          (idx (sort-range arena (cast Int (list-len cands))
                 (fn ((i Int) (j Int)) (cand-cmp (cand-at cands i none-such) (cand-at cands j none-such)))))
          (mut sets (list-new arena CtxSet)) (mut news (list-new arena CtxSet)) (mut olds (list-new arena CtxSet))
          (mut nfl (list-new arena Flags)) (none-fs (list-new arena (List Bool)))
          (mut k 0) (mut v 0) (mut grew false))
      (do (for-each (s (. st sets))
            (let ((mine (run-of arena cands idx k (cast U32 v) none-such)))
              (let ((cm (commit-one arena (. s cs) mine scan)))
                (do (list-push sets (record-new CtxSet (cs (. cm set))))
                    (list-push nfl (record-new Flags (fs (new-flags arena (. st ord) (. s cs) (fs-at fl v none-fs) cm
                                                                    (list-len mine)))))
                    (list-push news (record-new CtxSet (cs (. cm added))))
                    (list-push olds (record-new CtxSet (cs (minus-sorted arena (. cm set) (. cm added)))))
                    (when (> (list-len (. cm added)) 0) (set! grew true))
                    (set! k (+ k (cast Int (list-len mine))))
                    (set! v (+ v 1))))))
          (record-new Step
            (st (record-new Structure (ctxs (. st ctxs)) (sets sets) (edges (. st edges)) (ord (. st ord))))
            (dl (record-new Delta (news news) (olds olds) (edges (edges-from arena (. st edges) e0)) (nctx c0)
                            (ncst n0)))
            (changed (or grew
                         (!= (cast Int (list-len (. st ctxs))) c0)
                         (!= (cast Int (list-len (. st edges))) e0)
                         (!= (consts-of st) n0)))
            (trig (list-new arena Supply))
            (acts 0)
            (flags nfl)))))

  (fn new-flags ((arena Arena) (ord SriqOrder) (ws (List Clause)) (wf (List (List Bool))) (cm Committed) (ncands Int))
    (@intent "The flags of a context's new set: its old flags when it had no candidate (the set is unchanged), else
              walked from the old set's")
    (@spec ((Arena SriqOrder (List Clause) (List (List Bool)) Committed Int) -> (List (List Bool))))
    (@alloc arena)
    (if (== ncands 0) wf (walked-flags arena ord ws wf (. cm set))))

  (fn run-of ((arena Arena) (cands (List Cand)) (idx (List Int)) (k Int) (v U32) (none-such Cand))
    (@intent "The clauses of the sorted candidates from position k on while their context is v")
    (@spec ((Arena (List Cand) (List Int) Int U32 Cand) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)) (mut i k) (mut going true))
      (do (while (and going (< i (cast Int (list-len idx))))
            (let ((x (cand-at cands (idx-at idx i) none-such)))
              (if (== (. x ctx) v)
                (do (list-push out (. x c)) (set! i (+ i 1)))
                (set! going false))))
          out)))

  (fn commit-one ((arena Arena) (ws (List Clause)) (cs (List Clause)) (scan Bool))
    (@intent "min(S_v ∪ candidates) when there are candidates, through the index or (scan) commit-min; else the set as
              it is, with nothing added")
    (@spec ((Arena (List Clause) (List Clause) Bool) -> Committed))
    (@alloc arena)
    (cond ((== (list-len cs) 0) (record-new Committed (set ws) (added (list-new arena Clause))))
          (scan (commit-min arena ws cs))
          (else (commit-indexed arena ws cs))))

  (fn minus-sorted ((arena Arena) (xs (List Clause)) (ys (List Clause)))
    (@intent "xs without ys, both in content order (ys ⊆ xs)")
    (@spec ((Arena (List Clause) (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((mut out (list-new arena Clause)) (mut j 0))
      (do (for-each (x xs)
            (match (list-get ys j)
              ((some y) (if (== (clause-cmp x y) 0) (set! j (+ j 1)) (list-push out x)))
              ((none) (list-push out x))))
          out)))

  (fn edges-from ((arena Arena) (es (List Edge)) (k Int))
    (@intent "The edges from position k on: those this round created")
    (@spec ((Arena (List Edge) Int) -> (List Edge)))
    (@alloc arena)
    (let ((mut out (list-new arena Edge)) (mut i 0))
      (do (for-each (e es) (do (when (>= i k) (list-push out e)) (set! i (+ i 1))))
          out)))

  ;; ============================================================
  ;; Premise views kept with the store (slice 9k)
  ;;
  ;; A premise's maxed flag is maximal-at of its clause's head, under the
  ;; run's one order. The order's rank is fixed at the start, and its
  ;; constants only grow, each added before any clause naming it commits.
  ;; So a stored clause's flags never change: they are computed once, when
  ;; the clause commits, and kept beside S_v in its content order.
  ;; ============================================================

  (fn views-of ((arena Arena) (st Structure) (fl (List Flags)))
    (@intent "Each context's set beside its kept flags, by id")
    (@spec ((Arena Structure (List Flags)) -> (List View)))
    (@alloc arena)
    (let ((mut out (list-new arena View)) (mut v 0) (none-fs (list-new arena (List Bool))))
      (do (for-each (x (. st sets))
            (do (list-push out (record-new View (cs (. x cs)) (fs (match (list-get fl v) ((some f) (. f fs)) ((none) none-fs)))))
                (set! v (+ v 1))))
          out)))

  (fn premises-in ((arena Arena) (st Structure) (vw (List View)) (v Int) (cs (List Clause)))
    (@intent "The premises of cs, clauses of context v: with views, each clause's flags found in v's view (premises-of's
              records, with no order work); with none, premises-of itself")
    (@spec ((Arena Structure (List View) Int (List Clause)) -> (List Premise)))
    (@alloc arena)
    (match (list-get vw v)
      ((none) (premises-of arena (. st ord) cs))
      ((some w)
        (let ((mut out (list-new arena Premise)))
          (do (for-each (c cs) (for-each (p (clause-premises arena c (flags-of arena (. st ord) w c))) (list-push out p)))
              out)))))

  (fn clause-premises ((arena Arena) (c Clause) (fs (List Bool)))
    (@intent "c's premises, one per head literal, as select builds them, maxed from c's flags fs")
    (@spec ((Arena Clause (List Bool)) -> (List Premise)))
    (@alloc arena)
    (let ((mut out (list-new arena Premise)) (mut i 0))
      (do (for-each (l (. c head))
            (do (list-push out (record-new Premise (body (. c body)) (sel l) (rest (head-without arena (. c head) i))
                                                   (maxed (flag-at fs i))))
                (set! i (+ i 1))))
          out)))

  (fn head-without ((arena Arena) (xs (List Lit)) (i Int))
    (@intent "xs without element i (select's rest)")
    (@spec ((Arena (List Lit) Int) -> (List Lit)))
    (@alloc arena)
    (let ((mut out (list-new arena Lit)) (mut k 0))
      (do (for-each (x xs) (do (when (!= k i) (list-push out x)) (set! k (+ k 1)))) out)))

  (fn flag-at ((fs (List Bool)) (i Int))
    (@intent "Flag i")
    (@spec (((List Bool) Int) -> Bool))
    (@pure)
    (match (list-get fs i) ((some b) b) ((none) false)))

  (fn flags-of ((arena Arena) (ord SriqOrder) (w View) (c Clause))
    (@intent "c's kept flags, found by content in the view; computed when c is not there (a clause derive reads is
              always stored, so a test counts that)")
    (@spec ((Arena SriqOrder View Clause) -> (List Bool)))
    (@alloc arena)
    (let ((k (clause-pos (. w cs) c)))
      (match (list-get (. w fs) k)
        ((some fs) (if (sorted-at (. w cs) k c) fs (max-flags arena ord (. c head))))
        ((none) (max-flags arena ord (. c head))))))

  (fn clause-pos ((cs (List Clause)) (c Clause))
    (@intent "The first position of cs, in content order, whose clause is not below c")
    (@spec (((List Clause) Clause) -> Int))
    (@pure)
    (let ((mut lo 0) (mut hi (cast Int (list-len cs))))
      (do (while (< lo hi)
            (let ((mid (/ (+ lo hi) 2)))
              (match (list-get cs mid)
                ((some x) (if (< (clause-cmp x c) 0) (set! lo (+ mid 1)) (set! hi mid)))
                ((none) (set! hi mid)))))
          lo)))

  (fn sorted-at ((cs (List Clause)) (k Int) (c Clause))
    (@intent "Is cs's clause k c?")
    (@spec (((List Clause) Int Clause) -> Bool))
    (@pure)
    (match (list-get cs k) ((some x) (== (clause-cmp x c) 0)) ((none) false)))

  (fn walked-flags ((arena Arena) (ord SriqOrder) (ws (List Clause)) (wf (List (List Bool))) (set (List Clause)))
    (@intent "The flags of set (content order) from those of ws (content order, aligned with wf): a clause kept from ws
              keeps its flags, a new one gets max-flags once")
    (@spec ((Arena SriqOrder (List Clause) (List (List Bool)) (List Clause)) -> (List (List Bool))))
    (@alloc arena)
    (let ((mut out (list-new arena (List Bool))) (mut j 0))
      (do (for-each (c set)
            (do (while (below-at ws j c) (set! j (+ j 1)))
                (list-push out (if (sorted-at ws j c)
                                 (match (list-get wf j) ((some f) f) ((none) (max-flags arena ord (. c head))))
                                 (max-flags arena ord (. c head))))))
          out)))

  (fn below-at ((cs (List Clause)) (j Int) (c Clause))
    (@intent "Is cs's clause j below c in content order?")
    (@spec (((List Clause) Int Clause) -> Bool))
    (@pure)
    (match (list-get cs j) ((some w) (< (clause-cmp w c) 0)) ((none) false)))

  (fn fs-at ((fl (List Flags)) (v Int) (none-fs (List (List Bool))))
    (@intent "Context v's flags, or none")
    (@spec (((List Flags) Int (List (List Bool))) -> (List (List Bool))))
    (@pure)
    (match (list-get fl v) ((some f) (. f fs)) ((none) none-fs)))

  (fn empty-flags ((arena Arena) (st Structure))
    (@intent "Flags for st's sets, which initialisation leaves empty: none, per context")
    (@spec ((Arena Structure) -> (List Flags)))
    (@alloc arena)
    (let ((mut out (list-new arena Flags)))
      (do (for-each (x (. st sets)) (list-push out (record-new Flags (fs (walked-flags arena (. st ord) (list-new arena Clause)
                                                                                        (list-new arena (List Bool)) (. x cs))))))
          out)))

  (fn copy-flags ((arena Arena) (fl (List Flags)))
    (@intent "fl, deep-copied into arena")
    (@spec ((Arena (List Flags)) -> (List Flags)))
    (@alloc arena)
    (let ((mut out (list-new arena Flags)))
      (do (for-each (f fl)
            (let ((mut fs (list-new arena (List Bool))))
              (do (for-each (x (. f fs))
                    (let ((mut b (list-new arena Bool))) (do (for-each (y x) (list-push b y)) (list-push fs b))))
                  (list-push out (record-new Flags (fs fs))))))
          out)))

  (fn stale-flags ((arena Arena) (st Structure) (fl (List Flags)))
    (@intent "How many clauses of st's sets have kept flags (or none) that differ from max-flags recomputed now: 0 when
              the store's views are right (a test's check)")
    (@spec ((Arena Structure (List Flags)) -> Int))
    (@alloc arena)
    (let ((mut n 0) (mut v 0) (none-fs (list-new arena (List Bool))))
      (do (for-each (x (. st sets))
            (do (set! n (+ n (stale-in arena (. st ord) (. x cs) (fs-at fl v none-fs))))
                (set! v (+ v 1))))
          n)))

  (fn stale-in ((arena Arena) (ord SriqOrder) (cs (List Clause)) (fs (List (List Bool))))
    (@intent "One context's stale count: 1 if its flags are not one per clause, plus each clause whose flags differ from
              max-flags now")
    (@spec ((Arena SriqOrder (List Clause) (List (List Bool))) -> Int))
    (@alloc arena)
    (let ((mut n (if (== (list-len fs) (list-len cs)) 0 1)) (mut k 0))
      (do (for-each (c cs)
            (do (when (not (same-flags (match (list-get fs k) ((some f) f) ((none) (list-new arena Bool)))
                                       (max-flags arena ord (. c head))))
                  (set! n (+ n 1)))
                (set! k (+ k 1))))
          n)))

  (fn same-flags ((a (List Bool)) (b (List Bool)))
    (@intent "The same flags")
    (@spec (((List Bool) (List Bool)) -> Bool))
    (@pure)
    (let ((mut ok (== (list-len a) (list-len b))) (mut i 0))
      (do (for-each (x a) (do (when (!= x (flag-at b i)) (set! ok false)) (set! i (+ i 1)))) ok)))

  ;; ============================================================
  ;; Deferral: predecessor relevance (SPEC §5.5 S6 R8, slice 9i)
  ;;
  ;; A clause c ∈ S_v is supported when its body lies in core_v, or in
  ;; core_v ∪ trig(w, f) for one f-edge ⟨w, v, f⟩. Derive reads only the
  ;; supported clauses of each context but the root (projected), and a
  ;; stored clause that this round's edges or trig make supported joins
  ;; Δₙ₊₁ (activated). The scope is R8's: no constant, so the root, Nom,
  ;; r-Succ, r-Pred and the shared ground view are inert.
  ;; ============================================================

  (fn defer-on ((cfg SatConfig) (in RefIn))
    (@intent "Is deferral on: asked for, on an input with no constant, under cautious or trivial (R8's scope)?")
    (@spec ((SatConfig RefIn) -> Bool))
    (@pure)
    (and (. cfg defer) (== (. in nconst) 0) (not (== (. (. cfg base) strat) 'st-eager))))

  (fn key-cmp ((w1 U32) (f1 U32) (w2 U32) (f2 U32))
    (@intent "(w, f) pairs by w, then f")
    (@spec ((U32 U32 U32 U32) -> Int))
    (@pure)
    (if (!= w1 w2) (u32-cmp w1 w2) (u32-cmp f1 f2)))

  (fn supply-cmp ((a Supply) (b Supply))
    (@intent "By (from, f)")
    (@spec ((Supply Supply) -> Int))
    (@pure)
    (key-cmp (. a from) (. a f) (. b from) (. b f)))

  (fn supply-at ((xs (List Supply)) (k Int) (fallback Supply))
    (@intent "Element k")
    (@spec (((List Supply) Int Supply) -> Supply))
    (@pure)
    (match (list-get xs k) ((some x) x) ((none) fallback)))

  (fn supply-of ((trig (List Supply)) (w U32) (f U32) (nolits (List Lit)))
    (@intent "trig(w, f), found by (w, f); nolits when Succ never evaluated for (w, f)")
    (@spec (((List Supply) U32 U32 (List Lit)) -> (List Lit)))
    (@pure)
    (let ((mut lo 0) (mut hi (cast Int (list-len trig))))
      (do (while (< lo hi)
            (let ((mid (/ (+ lo hi) 2)))
              (match (list-get trig mid)
                ((some x) (if (< (key-cmp (. x from) (. x f) w f) 0) (set! lo (+ mid 1)) (set! hi mid)))
                ((none) (set! hi mid)))))
          (match (list-get trig lo)
            ((some x) (if (== (key-cmp (. x from) (. x f) w f) 0) (. x lits) nolits))
            ((none) nolits)))))

  (fn lit-member ((ls (List Lit)) (l Lit))
    (@intent "Is l in ls, a set in lit-cmp's order (a core, or a trig)?")
    (@spec (((List Lit) Lit) -> Bool))
    (@pure)
    (let ((mut lo 0) (mut hi (cast Int (list-len ls))))
      (do (while (< lo hi)
            (let ((mid (/ (+ lo hi) 2)))
              (match (list-get ls mid)
                ((some x) (if (< (lit-cmp x l) 0) (set! lo (+ mid 1)) (set! hi mid)))
                ((none) (set! hi mid)))))
          (match (list-get ls lo) ((some x) (== (lit-cmp x l) 0)) ((none) false)))))

  (fn body-within ((c Clause) (core (List Lit)) (lits (List Lit)))
    (@intent "Is every body atom of c in core or in lits?")
    (@spec ((Clause (List Lit) (List Lit)) -> Bool))
    (@pure)
    (let ((mut ok true))
      (do (for-each (l (. c body)) (when (not (or (lit-member core l) (lit-member lits l))) (set! ok false)))
          ok)))

  (fn supported ((c Clause) (core (List Lit)) (ins (List Edge)) (trig (List Supply)) (nolits (List Lit)))
    (@intent "Is c supported in a context with this core and these edges in: its body inside the core, or inside
              core ∪ trig(w, f) for one f-edge ⟨w, v, f⟩?")
    (@spec ((Clause (List Lit) (List Edge) (List Supply) (List Lit)) -> Bool))
    (@pure)
    (let ((mut ok (body-within c core nolits)))
      (do (for-each (e ins)
            (when (and (not ok) (== (. e lk) 'el-fn) (body-within c core (supply-of trig (. e from) (. e label) nolits)))
              (set! ok true)))
          ok)))

  (fn ins-at ((arena Arena) (adj (List Adj)) (v Int))
    (@intent "The edges into v")
    (@spec ((Arena (List Adj) Int) -> (List Edge)))
    (@alloc arena)
    (match (list-get adj v) ((some a) (. a ins)) ((none) (list-new arena Edge))))

  ;; Derive's view under deferral.
  (type Seen (record
    (st Structure)
    (dl Delta)))

  (fn projected ((arena Arena) (st Structure) (dl Delta) (trig (List Supply)))
    (@intent "st and dl with every context but the root narrowed to its supported clauses, in S_v, Δ_v and the rest
              alike: derive's view under deferral")
    (@spec ((Arena Structure Delta (List Supply)) -> Seen))
    (@alloc arena)
    (let ((adj (adjacency arena st)) (nolits (list-new arena Lit)) (nobody (list-new arena Clause))
          (mut sets (list-new arena CtxSet)) (mut news (list-new arena CtxSet)) (mut olds (list-new arena CtxSet))
          (mut v 0))
      (do (for-each (c (. st ctxs))
            (let ((ins (ins-at arena adj v)))
              (do (list-push sets (narrowed arena (cs-at (. st sets) v nobody) c ins trig nolits))
                  (list-push news (narrowed arena (cs-at (. dl news) v nobody) c ins trig nolits))
                  (list-push olds (narrowed arena (cs-at (. dl olds) v nobody) c ins trig nolits))
                  (set! v (+ v 1)))))
          (record-new Seen
            (st (record-new Structure (ctxs (. st ctxs)) (sets sets) (edges (. st edges)) (ord (. st ord))))
            (dl (record-new Delta (news news) (olds olds) (edges (. dl edges)) (nctx (. dl nctx)) (ncst (. dl ncst))))))))

  (fn narrowed ((arena Arena) (cs (List Clause)) (c Ctx) (ins (List Edge)) (trig (List Supply)) (nolits (List Lit)))
    (@intent "cs's supported clauses, in its order, for a context with c's core and these edges in; at the root, all")
    (@spec ((Arena (List Clause) Ctx (List Edge) (List Supply) (List Lit)) -> CtxSet))
    (@alloc arena)
    (if (. c root)
      (record-new CtxSet (cs cs))
      (let ((mut out (list-new arena Clause)))
        (do (for-each (x cs) (when (supported x (. c core) ins trig nolits) (list-push out x)))
            (record-new CtxSet (cs out))))))

  ;; trig after one round, the pairs the round evaluated (with their new
  ;; trig, which pushing reads), and whether an atom was added.
  (type Supplied (record
    (trig  (List Supply))
    (evals (List Supply))
    (grew  Bool)))

  (fn supplied ((arena Arena) (trig (List Supply)) (succs (List SuccAct)))
    (@intent "trig with each evaluation's K₂ added to its (from, f)")
    (@spec ((Arena (List Supply) (List SuccAct)) -> Supplied))
    (@alloc arena)
    (let ((mut raw (list-new arena Supply)))
      (do (for-each (x trig) (list-push raw x))
          (for-each (a succs) (list-push raw (record-new Supply (from (. a from)) (f (. (. a sg) f)) (lits (. a adds)))))
          (match (list-get raw 0)
            ((none) (record-new Supplied (trig trig) (evals (list-new arena Supply)) (grew false)))
            ((some s0) (supplies-merged arena raw (cast Int (list-len trig)) s0))))))

  ;; One (w, f)'s run of entries, united.
  (type Group (record
    (s     Supply)
    (evald Bool)
    (grew  Bool)
    (next  Int)))

  (fn supplies-merged ((arena Arena) (raw (List Supply)) (nold Int) (s0 Supply))
    (@intent "raw's entries grouped by (from, f), each group's atoms united; the first nold are the old trig, one entry
              per pair, and the rest the round's evaluations")
    (@spec ((Arena (List Supply) Int Supply) -> Supplied))
    (@alloc arena)
    (let ((idx (sort-range arena (cast Int (list-len raw))
                 (fn ((i Int) (j Int)) (supply-cmp (supply-at raw i s0) (supply-at raw j s0)))))
          (mut trig (list-new arena Supply)) (mut evals (list-new arena Supply)) (mut grew false) (mut k 0))
      (do (while (< k (cast Int (list-len idx)))
            (let ((g (supply-group arena raw idx k nold s0)))
              (do (list-push trig (. g s))
                  (when (. g evald) (list-push evals (. g s)))
                  (when (. g grew) (set! grew true))
                  (set! k (. g next)))))
          (record-new Supplied (trig trig) (evals evals) (grew grew)))))

  (fn supply-group ((arena Arena) (raw (List Supply)) (idx (List Int)) (k Int) (nold Int) (s0 Supply))
    (@intent "The run of idx from position k on with one (from, f): its atoms united, whether the round evaluated it,
              whether that added an atom to the old entry, and the position after it")
    (@spec ((Arena (List Supply) (List Int) Int Int Supply) -> Group))
    (@alloc arena)
    (let ((first (supply-at raw (idx-at idx k) s0))
          (mut lits (list-new arena Lit)) (mut before 0) (mut evald false) (mut i k) (mut going true))
      (do (while (and going (< i (cast Int (list-len idx))))
            (let ((j (idx-at idx i)) (x (supply-at raw (idx-at idx i) s0)))
              (if (== (supply-cmp x first) 0)
                (do (for-each (l (. x lits)) (list-push lits l))
                    (if (< j nold) (set! before (cast Int (list-len (. x lits)))) (set! evald true))
                    (set! i (+ i 1)))
                (set! going false))))
          (let ((u (lit-set arena lits)))
            (record-new Group (s (record-new Supply (from (. first from)) (f (. first f)) (lits u)))
                              (evald evald) (grew (> (cast Int (list-len u)) before)) (next i))))))

  (fn ctx-core ((arena Arena) (st Structure) (v U32))
    (@intent "core_v")
    (@spec ((Arena Structure U32) -> (List Lit)))
    (@alloc arena)
    (match (list-get (. st ctxs) (cast Int v)) ((some c) (. c core)) ((none) (list-new arena Lit))))

  (fn pushed ((arena Arena) (st Structure) (evals (List Supply)))
    (@intent "Unit pushing: for each (w, f) evaluated this round, A′ → A′ for each A′ of trig(w, f) outside the target's
              core, into the target of every f-edge ⟨w, v, f⟩ of st (the refreshed one included)")
    (@spec ((Arena Structure (List Supply)) -> (List Cand)))
    (@alloc arena)
    (let ((nolits (list-new arena Lit)) (mut out (list-new arena Cand)))
      (do (for-each (e (. st edges))
            (when (== (. e lk) 'el-fn)
              (let ((core (ctx-core arena st (. e to))))
                (for-each (a (supply-of evals (. e from) (. e label) nolits))
                  (when (not (lit-member core a))
                    (list-push out (record-new Cand (ctx (. e to)) (c (unit-clause arena a)))))))))
          out)))

  (fn edges-before ((arena Arena) (es (List Edge)) (k Int))
    (@intent "The edges before position k: those older than this round")
    (@spec ((Arena (List Edge) Int) -> (List Edge)))
    (@alloc arena)
    (let ((mut out (list-new arena Edge)) (mut i 0))
      (do (for-each (e es) (do (when (< i k) (list-push out e)) (set! i (+ i 1))))
          out)))

  (fn deferred-step ((arena Arena) (sp Step) (e0 Int) (old (List Supply)) (sup Supplied))
    (@intent "sp with trig grown, and the stored clauses that this round's edges or trig make supported activated into
              Δₙ₊₁; a round that only grew trig has changed")
    (@spec ((Arena Step Int (List Supply) Supplied) -> Step))
    (@alloc arena)
    (let ((a (activated arena (. sp st) (. sp dl) e0 old (. sup trig))))
      (record-new Step (st (. sp st)) (dl (. a dl)) (changed (or (. sp changed) (. sup grew))) (trig (. sup trig))
                       (acts (. a n)) (flags (. sp flags)))))

  (type Acted (record
    (dl Delta)
    (n  Int)))

  ;; One context's Δ and rest after activation.
  (type Moved (record
    (news (List Clause))
    (olds (List Clause))
    (n    Int)))

  (fn activated ((arena Arena) (st Structure) (dl Delta) (e0 Int) (old (List Supply)) (trig (List Supply)))
    (@intent "dl with each stored clause that is supported now, and was not under the edges before e0 and the old trig,
              moved from the rest into Δ (activation is arrival); and how many moved")
    (@spec ((Arena Structure Delta Int (List Supply) (List Supply)) -> Acted))
    (@alloc arena)
    (let ((was (record-new Structure (ctxs (. st ctxs)) (sets (. st sets)) (edges (edges-before arena (. st edges) e0))
                                     (ord (. st ord))))
          (adj (adjacency arena st)) (adj0 (adjacency arena was))
          (nolits (list-new arena Lit)) (nobody (list-new arena Clause))
          (mut news (list-new arena CtxSet)) (mut olds (list-new arena CtxSet)) (mut n 0) (mut v 0))
      (do (for-each (c (. st ctxs))
            (let ((m (acted-in arena c (cs-at (. dl news) v nobody) (cs-at (. dl olds) v nobody) (ins-at arena adj v)
                               (ins-at arena adj0 v) old trig nolits)))
              (do (list-push news (record-new CtxSet (cs (. m news))))
                  (list-push olds (record-new CtxSet (cs (. m olds))))
                  (set! n (+ n (. m n)))
                  (set! v (+ v 1)))))
          (record-new Acted (dl (record-new Delta (news news) (olds olds) (edges (. dl edges)) (nctx (. dl nctx))
                                                  (ncst (. dl ncst))))
                            (n n)))))

  (fn acted-in ((arena Arena) (c Ctx) (news (List Clause)) (olds (List Clause)) (ins (List Edge)) (ins0 (List Edge))
                (old (List Supply)) (trig (List Supply)) (nolits (List Lit)))
    (@intent "One context's activation: of olds, those supported under ins and trig but not under ins0 and old join
              news, in content order. Only a context with a new edge in, or a grown trig on an edge in, can gain one")
    (@spec ((Arena Ctx (List Clause) (List Clause) (List Edge) (List Edge) (List Supply) (List Supply) (List Lit))
            -> Moved))
    (@alloc arena)
    (if (or (. c root) (not (ins-grew ins ins0 old trig nolits)))
      (record-new Moved (news news) (olds olds) (n 0))
      (let ((mut up (list-new arena Clause)) (mut rest (list-new arena Clause)))
        (do (for-each (x olds)
              (if (and (supported x (. c core) ins trig nolits) (not (supported x (. c core) ins0 old nolits)))
                (list-push up x)
                (list-push rest x)))
            (record-new Moved (news (merged-sorted arena news up)) (olds rest) (n (cast Int (list-len up))))))))

  (fn ins-grew ((ins (List Edge)) (ins0 (List Edge)) (old (List Supply)) (trig (List Supply)) (nolits (List Lit)))
    (@intent "Did a context gain an edge in, or did trig grow on one of its edges in?")
    (@spec (((List Edge) (List Edge) (List Supply) (List Supply) (List Lit)) -> Bool))
    (@pure)
    (let ((mut grew (!= (list-len ins) (list-len ins0))))
      (do (for-each (e ins)
            (when (> (list-len (supply-of trig (. e from) (. e label) nolits))
                     (list-len (supply-of old (. e from) (. e label) nolits)))
              (set! grew true)))
          grew)))

  (fn merged-sorted ((arena Arena) (xs (List Clause)) (ys (List Clause)))
    (@intent "xs ∪ ys in content order, both in content order and disjoint")
    (@spec ((Arena (List Clause) (List Clause)) -> (List Clause)))
    (@alloc arena)
    (let ((n (+ (cast Int (list-len xs)) (cast Int (list-len ys)))) (mut out (list-new arena Clause)) (mut i 0) (mut j 0))
      (do (while (< (+ i j) n)
            (if (y-first xs ys i j)
              (do (match (list-get ys j) ((some y) (list-push out y)) ((none) (set! j j))) (set! j (+ j 1)))
              (do (match (list-get xs i) ((some x) (list-push out x)) ((none) (set! i i))) (set! i (+ i 1)))))
          out)))

  (fn y-first ((xs (List Clause)) (ys (List Clause)) (i Int) (j Int))
    (@intent "Does the merge take ys's element j before xs's element i?")
    (@spec (((List Clause) (List Clause) Int Int) -> Bool))
    (@pure)
    (match (list-get ys j)
      ((none) false)
      ((some y) (match (list-get xs i) ((some x) (< (clause-cmp y x) 0)) ((none) true)))))

  (fn copy-trig ((arena Arena) (trig (List Supply)))
    (@intent "trig, deep-copied into arena")
    (@spec ((Arena (List Supply)) -> (List Supply)))
    (@alloc arena)
    (let ((mut out (list-new arena Supply)))
      (do (for-each (x trig)
            (let ((mut ls (list-new arena Lit)))
              (do (for-each (l (. x lits)) (list-push ls l))
                  (list-push out (record-new Supply (from (. x from)) (f (. x f)) (lits ls))))))
          out)))

  ;; ============================================================
  ;; The run
  ;; ============================================================

  (fn first-delta ((arena Arena) (st Structure))
    (@intent "Δ₀: every context and every constant new, nothing else")
    (@spec ((Arena Structure) -> Delta))
    (@alloc arena)
    (let ((mut news (list-new arena CtxSet)) (mut olds (list-new arena CtxSet)))
      (do (for-each (s (. st sets))
            (do (list-push news (record-new CtxSet (cs (list-new arena Clause))))
                (list-push olds (record-new CtxSet (cs (. s cs))))))
          (record-new Delta (news news) (olds olds) (edges (list-new arena Edge)) (nctx 0) (ncst 0)))))

  (fn copy-delta ((arena Arena) (dl Delta))
    (@intent "dl, deep-copied into arena")
    (@spec ((Arena Delta) -> Delta))
    (@alloc arena)
    (let ((mut news (list-new arena CtxSet)) (mut olds (list-new arena CtxSet)) (mut es (list-new arena Edge)))
      (do (for-each (s (. dl news)) (list-push news (record-new CtxSet (cs (copy-clauses arena (. s cs))))))
          (for-each (s (. dl olds)) (list-push olds (record-new CtxSet (cs (copy-clauses arena (. s cs))))))
          (for-each (e (. dl edges)) (list-push es e))
          (record-new Delta (news news) (olds olds) (edges es) (nctx (. dl nctx)) (ncst (. dl ncst))))))

  (fn into-v ((cs (List Cand)) (v U32))
    (@intent "How many of cs go into v")
    (@spec (((List Cand) U32) -> Int))
    (@pure)
    (let ((mut n 0)) (do (for-each (c cs) (when (== (. c ctx) v) (set! n (+ n 1)))) n)))

  (fn sum-added ((dl Delta))
    (@intent "Clauses committed this round, over every context")
    (@spec ((Delta) -> Int))
    (@pure)
    (let ((mut n 0)) (do (for-each (s (. dl news)) (set! n (+ n (cast Int (list-len (. s cs)))))) n)))

  ;; A run between rounds.
  (type Run (record
    (st     Structure)
    (dl     Delta)
    (status RefStatus)
    (rounds Int)
    (going  Bool)
    (trig   (List Supply))   ; R8's trig; empty without deferral
    (flags  (List Flags))    ; each context's premise flags, aligned with st's sets (9k)
    (counts Counts)))

  (fn tally ((c Counts) (r Round) (dl Delta) (tried Int) (acts Int) (stale Int))
    (@intent "c with one round's work added; acts of dl's new clauses were activated, not committed; stale is the
              check's count of kept flags that differ from a recomputation")
    (@spec ((Counts Round Delta Int Int Int) -> Counts))
    (@pure)
    (record-new Counts (cands (+ (. c cands) (cast Int (list-len (. r cands)))))
                       (rcands (+ (. c rcands) (into-v (. r cands) (cast U32 0))))
                       (succs (+ (. c succs) (cast Int (list-len (. r succs)))))
                       (rsuccs (+ (. c rsuccs) (cast Int (list-len (. r rsuccs)))))
                       (noms (+ (. c noms) (cast Int (list-len (. r noms)))))
                       (added (+ (. c added) (- (sum-added dl) acts)))
                       (acts (+ (. c acts) acts))
                       (hyper (+ (. c hyper) tried))
                       (stale (+ (. c stale) stale))))

  ;; r-Succ on the copies, at the boundary. A member of G that is visible
  ;; in some context has a copy there in the printed derivation, and r-Succ
  ;; on its maximal A ∈ Suʳ(O) puts A → A into S_{v_r}. The root takes those
  ;; A → A at the boundary itself, so Succ never reads an atom of G that
  ;; the root is about to hold (SPEC §5.5, the shared ground view).

  (fn with-units ((arena Arena) (tr Triggers) (sp Step))
    (@intent "sp with the root's A → A for r-Succ on the copies committed into S_{v_r}, and in Δ")
    (@spec ((Arena Triggers Step) -> Step))
    (@alloc arena)
    (let ((st (. sp st)) (dl (. sp dl)) (nobody (list-new arena Clause))
          (gd (ground-of arena tr st (cs-at (. dl news) 0 nobody)))
          (units (g-root-units arena tr gd)))
      (if (== (list-len units) 0)
        sp
        (let ((cm (commit-indexed arena (cs-at (. st sets) 0 nobody) units)))
          (if (== (list-len (. cm added)) 0)
            sp
            (record-new Step (st (with-root-set arena st (. cm set)))
                             (dl (with-root-news arena dl (. cm set) (. cm added) nobody))
                             (changed true) (trig (. sp trig)) (acts (. sp acts))
                             (flags (with-root-flags arena (. st ord) (cs-at (. st sets) 0 nobody) (. sp flags) (. cm set)))))))))

  (fn with-root-flags ((arena Arena) (ord SriqOrder) (ws (List Clause)) (fl (List Flags)) (set (List Clause)))
    (@intent "fl with the root's flags walked from its old set ws to its re-committed set")
    (@spec ((Arena SriqOrder (List Clause) (List Flags) (List Clause)) -> (List Flags)))
    (@alloc arena)
    (let ((none-fs (list-new arena (List Bool))) (mut out (list-new arena Flags)) (mut v 0))
      (do (for-each (f fl)
            (do (list-push out (if (== v 0) (record-new Flags (fs (walked-flags arena ord ws (fs-at fl 0 none-fs) set))) f))
                (set! v (+ v 1))))
          out)))

  (fn with-root-set ((arena Arena) (st Structure) (cs (List Clause)))
    (@intent "st with S_{v_r} = cs")
    (@spec ((Arena Structure (List Clause)) -> Structure))
    (@alloc arena)
    (let ((mut sets (list-new arena CtxSet)) (mut v 0))
      (do (for-each (s (. st sets))
            (do (list-push sets (if (== v 0) (record-new CtxSet (cs cs)) s)) (set! v (+ v 1))))
          (record-new Structure (ctxs (. st ctxs)) (sets sets) (edges (. st edges)) (ord (. st ord))))))

  (fn with-root-news ((arena Arena) (dl Delta) (set (List Clause)) (added (List Clause)) (nobody (List Clause)))
    (@intent "dl with the root's Δ and rest taken again from its new set: Δ is what was new or added and survives")
    (@spec ((Arena Delta (List Clause) (List Clause) (List Clause)) -> Delta))
    (@alloc arena)
    (let ((was (cs-at (. dl news) 0 nobody))
          (mut news (list-new arena Clause)) (mut olds (list-new arena Clause)))
      (do (for-each (c set)
            (if (or (sorted-in was c) (sorted-in added c)) (list-push news c) (list-push olds c)))
          (record-new Delta (news (with-first arena (. dl news) news)) (olds (with-first arena (. dl olds) olds))
                            (edges (. dl edges)) (nctx (. dl nctx)) (ncst (. dl ncst))))))

  (fn with-first ((arena Arena) (xs (List CtxSet)) (cs (List Clause)))
    (@intent "xs with element 0 replaced by cs")
    (@spec ((Arena (List CtxSet) (List Clause)) -> (List CtxSet)))
    (@alloc arena)
    (let ((mut out (list-new arena CtxSet)) (mut v 0))
      (do (for-each (x xs) (do (list-push out (if (== v 0) (record-new CtxSet (cs cs)) x)) (set! v (+ v 1))))
          out)))

  (fn sorted-in ((cs (List Clause)) (c Clause))
    (@intent "Is c in cs, which is in content order?")
    (@spec (((List Clause) Clause) -> Bool))
    (@pure)
    (let ((mut lo 0) (mut hi (cast Int (list-len cs))))
      (do (while (< lo hi)
            (let ((mid (/ (+ lo hi) 2)))
              (match (list-get cs mid)
                ((some x) (if (< (clause-cmp x c) 0) (set! lo (+ mid 1)) (set! hi mid)))
                ((none) (set! hi mid)))))
          (match (list-get cs lo) ((some x) (== (clause-cmp x c) 0)) ((none) false)))))

  (fn sat-stop ((arena Arena) (env Env) (st Structure) (changed Bool) (cfg RefConfig))
    (@intent "Why the run stops after this round, or rs-fuel to go on: the reference's stops, read through the view (⊤ →
              ⊥ in v_⊤ or at the root; the clause cap over what the view stands for)")
    (@spec ((Arena Env Structure Bool RefConfig) -> RefStatus))
    (@alloc arena)
    (cond ((not changed) 'rs-fixpoint)
          ((or (holds-bot arena st 1) (holds-bot arena st 0)) 'rs-inconsistent)
          ((> (cast Int (list-len (. st ctxs))) (. cfg ctxs)) 'rs-contexts)
          ((> (view-total st) (. cfg cls)) 'rs-clauses)
          ((> (- (consts-of st) (. env nconst)) (. cfg cnst)) 'rs-constants)
          (else 'rs-fuel)))

  (fn holds-bot ((arena Arena) (st Structure) (v Int))
    (@intent "⊤ → ⊥ ∈̂ S_v")
    (@spec ((Arena Structure Int) -> Bool))
    (@alloc arena)
    (match (list-get (. st sets) v)
      ((some s) (in-hat (make-clause arena (list-new arena Lit) (list-new arena Lit)) (. s cs)))
      ((none) false)))

  (fn sat-once ((next Arena) (scratch Arena) (env Env) (hx HIdx) (cfg SatConfig) (dfr Bool) (run Run))
    (@intent "One round: derive (with deferral, over the supported clauses) and create in scratch, and what the commit
              leaves copied into next; at the choices cap, the run as it was, stopped")
    (@spec ((Arena Arena Env HIdx SatConfig Bool Run) -> Run))
    (@alloc next)
    (let ((gd (ground-of scratch (. env tr) (. run st) (cs-at (. (. run dl) news) 0 (. env nobody))))
          (seen (if dfr (projected scratch (. run st) (. run dl) (. run trig))
                  (record-new Seen (st (. run st)) (dl (. run dl)))))
          (vw (if (. cfg views) (views-of scratch (. run st) (. run flags)) (list-new scratch View)))
          (sr (sat-round scratch env hx (. seen st) (. seen dl) gd (. cfg perm) dfr vw
                         (- (. (. cfg base) cls) (view-total (. run st)))))
          (r (. sr r)))
      ;; A round stopped by a cap inside it is not committed: the run is as
      ;; it was, and its round count unchanged (sat-run reads that).
      (if (or (. r over) (. sr big))
        (record-new Run (st (. run st)) (dl (. run dl)) (status (if (. sr big) 'rs-clauses 'rs-product))
                        (rounds (. run rounds)) (going false)
                        (trig (. run trig)) (flags (. run flags)) (counts (. run counts)))
        (let ((sp (with-units scratch (. env tr) (sat-apply scratch (. run st) gd r (. cfg scan) dfr (. run trig)
                                                            (. run flags))))
              (st (copy-structure next (. sp st)))
              (stale (if (. cfg check) (stale-flags scratch (. sp st) (. sp flags)) 0))
              (status (sat-stop scratch env st (. sp changed) (. cfg base))))
          (record-new Run (st st) (dl (copy-delta next (. sp dl))) (status status) (rounds (+ (. run rounds) 1))
                          (going (== status 'rs-fuel)) (trig (copy-trig next (. sp trig)))
                          (flags (copy-flags next (. sp flags)))
                          (counts (tally (. run counts) r (. sp dl) (. sr tried) (. sp acts) stale)))))))

  (fn read-view ((arena Arena) (st Structure))
    (@intent "st as the read-off reads it through the view: when the root holds ⊤ → ⊥, so does G, and every context
              reads it (M's sets are then {⊤ → ⊥}); else st itself. Through the view, G can make a raw query hold only
              by holding ⊤ → ⊥")
    (@spec ((Arena Structure) -> Structure))
    (@alloc arena)
    (if (not (holds-bot arena st 0))
      st
      (let ((mut sets (list-new arena CtxSet)) (mut v 0))
        (do (for-each (s (. st sets))
              (do (if (is-root st v)
                    (list-push sets s)
                    (let ((mut one (list-new arena Clause)))
                      (do (list-push one (make-clause arena (list-new arena Lit) (list-new arena Lit)))
                          (list-push sets (record-new CtxSet (cs one))))))
                  (set! v (+ v 1))))
            (record-new Structure (ctxs (. st ctxs)) (sets sets) (edges (. st edges)) (ord (. st ord)))))))

  (fn sat-materialise ((arena Arena) (in RefIn) (st Structure))
    (@intent "M for a finished run: min(S_v ∪ G) in each context but the root, and the edges r-Succ on the copies
              would add (E_G). The tests check M as they check the reference's structure")
    (@spec ((Arena RefIn Structure) -> Structure))
    (@alloc arena)
    (materialise arena (build-triggers arena (. in onto) (. in nclass) (. in nrole) (. in nfn)) st))

  ;; ============================================================
  ;; P5 (R8) on a finished deferred run (a test's)
  ;;
  ;; A deferred run's store is not saturated: its unsupported clauses are
  ;; premises of nothing. R8's P5 is what holds: every instance over
  ;; supported premises has its conclusion ∈̂ the store, and its Succ
  ;; actions taken. So one reference round over the supported clauses
  ;; must change nothing when applied to the whole store. And, P5's units
  ;; at the fixpoint, every f-edge's target holds A′ → A′ up to ∈̂ for each
  ;; A′ of trig(w, f) outside its core: no answer can show a missing one,
  ;; since the current target derives what a stale one would.
  ;; ============================================================

  (fn defer-stable ((arena Arena) (in RefIn) (cfg SatConfig) (p SatResult))
    (@intent "Does one reference round over the supported clauses of p's final structure change nothing in all of it:
              no clause outside it up to ∈̂, no context, no edge (R8's P5)?")
    (@spec ((Arena RefIn SatConfig SatResult) -> Bool))
    (@alloc arena)
    (let ((base (. cfg base))
          (tr (build-triggers arena (. in onto) (. in nclass) (. in nrole) (. in nfn)))
          (env (env-of arena in base tr (if (>= (. base lam) 0) (. base lam) (ref-lambda tr (. base strat) (initial-queries in)))))
          (st (. (. p res) st))
          (r (ref-round arena env (. (projected arena st (first-delta arena st) (. p trig)) st))))
      (and (not (. r over)) (not (. (ref-apply arena st r) changed)) (units-pushed arena st (. p trig)))))

  (fn units-pushed ((arena Arena) (st Structure) (trig (List Supply)))
    (@intent "For every f-edge ⟨w, v, f⟩ of st and every A′ of trig(w, f) outside core_v, is A′ → A′ ∈̂ S_v?")
    (@spec ((Arena Structure (List Supply)) -> Bool))
    (@alloc arena)
    (let ((nolits (list-new arena Lit)) (nobody (list-new arena Clause)) (mut ok true))
      (do (for-each (e (. st edges))
            (when (== (. e lk) 'el-fn)
              (let ((core (ctx-core arena st (. e to))) (cs (cs-at (. st sets) (cast Int (. e to)) nobody)))
                (for-each (a (supply-of trig (. e from) (. e label) nolits))
                  (when (not (or (lit-member core a) (in-hat (unit-clause arena a) cs))) (set! ok false))))))
          ok)))

  ;; ============================================================
  ;; The indexed Hyper against the reference's (a test's)
  ;; ============================================================

  (fn hyper-ix-agrees ((arena Arena) (in RefIn) (cfg SatConfig) (st Structure))
    (@intent "On every context of st, with all of S_v as Δ, the indexed Hyper concludes exactly what the reference's
              hyper-with does over S_v, clause by clause of O with a body (where neither passes the choices cap)")
    (@spec ((Arena RefIn SatConfig Structure) -> Bool))
    (@alloc arena)
    (let ((base (. cfg base))
          (tr (build-triggers arena (. in onto) (. in nclass) (. in nrole) (. in nfn)))
          (env (env-of arena in base tr (ref-lambda tr (. base strat) (initial-queries in))))
          (hx (h-index arena (. in onto)))
          (gd (ground-of arena tr st (. env nobody)))
          (dl (first-delta arena st))
          (ixs (all-ixs arena env st dl 0 (list-new arena View)))
          (rs (rsrcs-of arena env st dl))
          (mut ok true) (mut v 0))
      (do (for-each (c (. st ctxs))
            (do (when (not (hyper-ix-one arena env hx (here-of arena env st dl gd hx ixs rs v 0 false false))) (set! ok false))
                (set! v (+ v 1))))
          ok)))

  (fn hyper-ix-one ((arena Arena) (env Env) (hx HIdx) (h Here))
    (@intent "hyper-ix-agrees on one context")
    (@spec ((Arena Env HIdx Here) -> Bool))
    (@alloc arena)
    (let ((mine (hyper-indexed arena env hx (hctx-of h) ROOM_OFF))
          (start (hyper-start arena (at-x) (not (. h root))))
          (mut theirs (list-new arena Cand)) (mut over (. (. mine out) over)))
      (do (for-each (oc (. hx bodied))
            (let ((o (hyper-with arena env (. h v) (. h root) start oc (. h aps))))
              (do (for-each (c (. o cands)) (list-push theirs c)) (when (. o over) (set! over true)))))
          (or over (same-cands arena (. (. mine out) cands) theirs)))))

  (fn same-cands ((arena Arena) (a (List Cand)) (b (List Cand)))
    (@intent "The same clauses, as sets")
    (@spec ((Arena (List Cand) (List Cand)) -> Bool))
    (@alloc arena)
    (let ((x (distinct-clauses arena a)) (y (distinct-clauses arena b)) (mut ok true) (mut i 0))
      (do (when (!= (list-len x) (list-len y)) (set! ok false))
          (for-each (c x)
            (do (match (list-get y i) ((some d) (when (!= (clause-cmp c d) 0) (set! ok false)))
                       ((none) (set! ok false)))
                (set! i (+ i 1))))
          ok)))

  (fn distinct-clauses ((arena Arena) (cs (List Cand)))
    (@intent "cs's clauses in content order, each once")
    (@spec ((Arena (List Cand)) -> (List Clause)))
    (@alloc arena)
    (let ((mut raw (list-new arena Clause)))
      (do (for-each (c cs) (list-push raw (. c c)))
          (match (list-get raw 0)
            ((none) raw)
            ((some c0) (sorted-distinct arena raw c0))))))

  (fn sorted-distinct ((arena Arena) (raw (List Clause)) (c0 Clause))
    (@intent "raw in content order, each once")
    (@spec ((Arena (List Clause) Clause) -> (List Clause)))
    (@alloc arena)
    (let ((idx (sort-range arena (cast Int (list-len raw))
                 (fn ((a Int) (b Int)) (clause-cmp (clause-of-l raw a c0) (clause-of-l raw b c0)))))
          (mut out (list-new arena Clause)))
      (do (for-each (k idx)
            (let ((c (clause-of-l raw k c0)))
              (match (list-get out (- (cast Int (list-len out)) 1))
                ((some last) (when (!= (clause-cmp last c) 0) (list-push out c)))
                ((none) (list-push out c)))))
          out)))

  (fn clause-of-l ((cs (List Clause)) (k Int) (fallback Clause))
    (@intent "Element k")
    (@spec (((List Clause) Int Clause) -> Clause))
    (@pure)
    (match (list-get cs k) ((some c) c) ((none) fallback)))

  ;; The engine runs the ranked order (slice 9g, SPEC §5.5 S5): fresh class
  ;; names above the query classes, so a head of several fresh disjuncts has
  ;; one maximal literal among them. The reference runs Sequoia's order as
  ;; printed, and the tests require the same raw answers from both.
  (fn ranked-structure ((st Structure) (nquery Int))
    (@intent "st with its order ranked from nquery")
    (@spec ((Structure Int) -> Structure))
    (@pure)
    (@pre (>= nquery 0))
    (record-new Structure (ctxs (. st ctxs)) (sets (. st sets)) (edges (. st edges)) (ord (ranked (. st ord) nquery))))

  (fn sat-run ((arena Arena) (in RefIn) (cfg SatConfig))
    (@intent "Algorithm 1 under S6's schedule at one worker: initialise, then rounds of derive, create and commit to a
              stop. Each round runs in a scratch arena, and what it leaves is copied into an arena of its own")
    (@spec ((Arena RefIn SatConfig) -> SatResult))
    (@alloc arena)
    (let ((base (. cfg base))
          (tr (build-triggers arena (. in onto) (. in nclass) (. in nrole) (. in nfn)))
          (lam (if (>= (. base lam) 0) (. base lam) (ref-lambda tr (. base strat) (initial-queries in))))
          (env (env-of arena in base tr lam))
          (hx (h-index arena (. in onto)))
          (st0 (ranked-structure (init-of arena in) (. in nquery)))
          (dfr (defer-on cfg in))
          (mut held (arena-new 1048576))
          (mut cancelled false) (mut capped false)
          (mut run (record-new Run (st st0) (dl (first-delta arena st0)) (status 'rs-fuel) (rounds 0) (going true)
                                   (trig (list-new arena Supply)) (flags (empty-flags arena st0))
                                   (counts (record-new Counts (cands 0) (rcands 0) (succs 0) (rsuccs 0) (noms 0)
                                                       (added 0) (acts 0) (hyper 0) (stale 0))))))
      ;; Cancellation is read at every round boundary, before the cap, as
      ;; run-ksc reads it (SPEC §5.5 S6 step 4): a cancelled run has no answer.
      (do (while (and (. run going) (not cancelled) (not capped))
            (cond ((cancel-requested (. cfg cancel)) (set! cancelled true))
                  ((>= (. run rounds) (. base fuel)) (set! capped true))
                  (else
                    (let ((scratch (arena-new 1048576))
                          (next (arena-new 1048576))
                          (nr (sat-once next scratch env hx cfg dfr run)))
                      (do (if (== (. nr rounds) (. run rounds))
                            (arena-free next)
                            (do (arena-free held) (set! held next)))
                          (arena-free scratch)
                          (set! run nr))))))
          (let ((done (copy-structure arena (read-view arena (. run st)))) (trig (copy-trig arena (. run trig))))
            (do (arena-free held)
                (record-new SatResult
                  (res (record-new RefResult (status (. run status)) (rounds (. run rounds)) (st done)))
                  (counts (. run counts))
                  (trig trig)
                  (cancelled cancelled)))))))

)
