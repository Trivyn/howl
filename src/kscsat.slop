;; ============================================================
;; el++ saturation — Ksc by semi-naive evaluation: phase G, phase W,
;; then a run for each unsafe class (SPEC §5.4 K2, K3, K6)
;;
;; THE PHASES.
;;   G  Kinst from rule (1)'s seeds: what holds in every model. A ⊥ here
;;      is inconsistency, and nothing else runs.
;;   W  every queried class's seed inst(A, A), owl:Thing's included, and
;;      the individuals, under every rule but (4): K6's shared saturation.
;;      Two backward walks over its incoming triples then mark the unsafe
;;      elements (reaching an individual or a nominal-holder) and the
;;      ⊥-reaching ones.
;;   Q  a safe class is answered from W (K6.2); an unsafe one runs from
;;      inst(q, q) over the base G ∪ W_S (K6.3), in parallel across
;;      workers, each run in a scratch arena freed once its answers are
;;      copied out.
;; Classes and roles enter as dense ids (kscnames.slop) and leave under
;; the input's names.
;;
;; THE STORE. A run's facts, deduplicated by `seen`, and the same facts
;; filed by the element a join walks:
;;
;;   insts    x → inst(x, ·)               (6)-(8) partners; (27)
;;   noms     x → inst(x, {a})             (27), (29) on an arriving fact
;;   holders  a → inst(·, {a})             (28) on an arriving inst(a, ·)
;;   outs     x → v → triple(x, v, ·)      (15) first leg, (16)
;;   ins      x → v → triple(·, v, x)      (7), (15) second leg, (17);
;;                                         over every role, (29)
;;   noms-at, bots                         K6's taint and ⊥ marks
;;
;; A JOIN WALKS A SNAPSHOT: a `(List KFact)` is a value, so the list a
;; lookup returns keeps the length it had, whatever is committed while
;; the combinator walks it. A partner committed later is in a later
;; round's delta, and its own trigger meets this fact then.
;;
;; WHY COMMIT-ON-DERIVE IS COMPLETE. Every fact is committed before it
;; is processed, and processed exactly once. For two premises that join,
;; whichever is processed second finds the other already committed, so
;; every rule instance is tried at least once. Rule order within a round
;; changes when a fact is found, never whether.
;;
;; A RUN OVER A BASE. `holds` and every partner list read the base too,
;; and a run stores only facts not already in it (K2, K6.3). W is read
;; only where the fact's subject is safe: W's facts about an unsafe
;; element may merge class assumptions (K6, "What K6 does not claim").
;;
;; K3: rule (4) is a flag. Committing inst(u, owl:Nothing) for any u
;; sets `unsat`, and a class's run stops there: every answer about q is
;; then yes. Phase W does not stop; it marks.
;; ============================================================

(module kscsat
  (@doc "el++ saturation: Ksc semi-naive, phases G and W, then a run per unsafe class (SPEC §5.4)")

  (import rdf (IRI))
  (import vocab (OWL_THING OWL_NOTHING))
  (import types (RoleId KName KTerm KElem KFact KscAxiom ClassAnswer KscResult Termination ReasonerConfig Fault cancel-requested
                 role-eq kname-eq kterm-eq kelem-eq
                 name-term nominal-term ind-elem class-elem copy-iri nothing-term))
  (import ksc (Concl JoinRule is-name is-nominal is-individual term-elem
               ksc-1 ksc-q ksc-2 ksc-3 ksc-4 ksc-5 ksc-6 ksc-7 ksc-8
               ksc-9 ksc-9-assert ksc-10 ksc-10-assert ksc-11 ksc-12 ksc-13 ksc-14
               ksc-15 ksc-16 ksc-17 ksc-18 ksc-23 ksc-24 ksc-25 ksc-26
               ksc-join))
  (import kscpremise (KList KPartners KscIndex build-ksc-index term-bucket role-bucket and-partners ex-partners
                      role-sups role-subs role-under))
  (import owl2 (Signature))
  (import canon (sort-iris))
  (import saturate (reuse-arena))
  (import thread (spawn join))
  (import kscnormal (copy-kname))
  (import kscnames (KscNames build-ksc-names rename-ksc-axioms rename-classes unrename-answer))
  (import kscids (KscIds CFact build-ksc-ids elem-id role-id id-elem id-term id-role encode-fact
                  decode-fact inst-kind triple-kind))

  (export
    IdList RoleIds KStore Base RunResult
    new-store run-ksc ksc-classify input-classes answer-subsumers answer-holds store-holds is-bottom-fact store-facts)

  ;; THE STORE KEEPS IDS (kscids.slop). A fact is a 16-byte CFact in the
  ;; dedup set, and an index entry is the one id its key does not give:
  ;; the term of an inst, the other end of a triple. The rules, the deltas
  ;; and ksc-join see KFact; `commit` and `store-holds` encode, and the
  ;; partner readers below decode.
  (type IdList (record
    (items (List U32))))

  (type RoleIds (record
    (by-role (Map U32 IdList))))         ; a role id → the other ends under it

  ;; THE STORE IS SHARDED BY ELEMENT, so a round's commit can run on
  ;; several threads (ksc-round): a slop Map or Set may have one writer at
  ;; a time, and each shard has one per commit step. Every collection is
  ;; keyed by an element id, and the key picks the shard (`shard-at`):
  ;; `seen`, insts, noms, outs, noms-at and bots by the fact's subject,
  ;; ins by a triple's other end, holders by the nominal's element. The
  ;; shard count changes WHERE a fact is filed, never what is filed or in
  ;; what order under one key, so the store means the same at any count.
  (type Shard (record
    (seen    (Set CFact))
    (insts   (Map U32 IdList))           ; x → every y with inst(x, y)
    (noms    (Map U32 IdList))           ; x → every nominal {a} with inst(x, {a})
    (holders (Map U32 IdList))           ; a → every x with inst(x, {a})
    (outs    (Map U32 RoleIds))          ; x → v → every x′ with triple(x, v, x′)
    (ins     (Map U32 RoleIds))          ; x′ → v → every x with triple(x, v, x′)
    (noms-at (Set KElem))                ; the elements holding a nominal: K6's taint
    (bots    (Set KElem))))              ; the elements holding owl:Nothing

  (type KStore (record
    (ids     KscIds)                     ; shared by every store of one classification
    (home    Shard)                      ; shard 0, which `shard-at` falls back to
    (shards  (List Shard))))

  ;; K6: what a class's run reads besides its own facts. G whole; W only
  ;; where the facts' subject is safe - W's facts about an unsafe element
  ;; may merge class assumptions and are never read.
  (type Base (record
    (g        KStore)
    (w        KStore)
    (unsafe   (Set KElem))           ; every element whose W-cone holds a tainted one
    (botreach (Set KElem))))         ; every element whose W-cone holds owl:Nothing

  (type RunResult (record
    (store  KStore)
    (rounds Int)
    (unsat  Bool)
    (capped Bool)                    ; the budget ran out with facts still to process
    (cancelled Bool)                 ; cancel-ptr was seen at a round boundary (§5.4)
    (facts  Int)))

  ;; ============================================================
  ;; The store
  ;; ============================================================

  (fn new-shard ((arena Arena))
    (@intent "An empty shard")
    (@spec ((Arena) -> Shard))
    (@alloc arena)
    (record-new Shard
      (seen    (set-new arena CFact))
      (insts   (map-new arena U32 IdList))
      (noms    (map-new arena U32 IdList))
      (holders (map-new arena U32 IdList))
      (outs    (map-new arena U32 RoleIds))
      (ins     (map-new arena U32 RoleIds))
      (noms-at (set-new arena KElem))
      (bots    (set-new arena KElem))))

  (fn new-store ((arena Arena) (ids KscIds) (nshards Int))
    (@intent "An empty fact store over a classification's id tables, in nshards shards (at least one)")
    (@spec ((Arena KscIds Int) -> KStore))
    (@alloc arena)
    (let ((home (new-shard arena))
          (mut shards (list-new arena Shard))
          (mut k 1))
      (do
        (list-push shards home)
        (while (< k nshards)
          (do
            (list-push shards (new-shard arena))
            (set! k (+ k 1))))
        (record-new KStore (ids ids) (home home) (shards shards)))))

  (fn shard-count ((st KStore))
    (@intent "How many shards a store has")
    (@spec ((KStore) -> Int))
    (cast Int (list-len (. st shards))))

  (fn shard-index ((k U32) (n Int))
    (@intent "The shard an element id is filed in, of n")
    (@spec ((U32 Int) -> Int))
    (@pure)
    (if (<= n 1) 0 (% (cast Int k) n)))

  (fn shard-at ((st KStore) (k U32))
    (@intent "The shard element id k is filed in")
    (@spec ((KStore U32) -> Shard))
    ;; One shard (W = 1, and every phase-Q run) is the common case, read
    ;; on every lookup: no index to compute.
    (if (<= (shard-count st) 1)
      (. st home)
      (match (list-get (. st shards) (shard-index k (shard-count st)))
        ((some sh) sh)
        ((none)    (. st home)))))

  (fn store-bots ((arena Arena) (st KStore))
    (@intent "Every element holding owl:Nothing, shard by shard")
    (@spec ((Arena KStore) -> (List KElem)))
    (@alloc arena)
    (let ((mut out (list-new arena KElem)))
      (do
        (for-each (sh (. st shards))
          (for-each (x (set-elements (. sh bots))) (list-push out x)))
        out)))

  (fn store-facts ((arena Arena) (st KStore))
    (@intent "Every fact a store holds, encoded, shard by shard")
    (@spec ((Arena KStore) -> (List CFact)))
    (@alloc arena)
    (let ((mut out (list-new arena CFact)))
      (do
        (for-each (sh (. st shards))
          (for-each (c (set-elements (. sh seen))) (list-push out c)))
        out)))

  (fn il-push ((arena Arena) (m (Map U32 IdList)) (k U32) (i U32))
    (@intent "Append id i to the list filed under k")
    (@spec ((Arena (Map U32 IdList) U32 U32) -> Bool))
    (@alloc arena)
    ;; Read, push, write back: a List is a value, the Map holds the record.
    ;; Every put names `arena`, the committer's own: a shard's collections
    ;; were made in another arena, and a later round may give the shard to
    ;; another committer (slop #278: a collection grows in the arena it
    ;; was made in unless told otherwise).
    (let ((mut items (match (map-get m k)
                       ((some l) (. l items))
                       ((none)   (list-new arena U32)))))
      (do
        (list-push items i :arena arena)
        (map-put m k (record-new IdList (items items)) :arena arena)
        true)))

  (fn ri-push ((arena Arena) (m (Map U32 RoleIds)) (k U32) (v U32) (i U32))
    (@intent "Append id i to the list filed under k, then role v")
    (@spec ((Arena (Map U32 RoleIds) U32 U32 U32) -> Bool))
    (@alloc arena)
    (let ((rf (match (map-get m k)
                ((some r) r)
                ((none)   (let ((fresh (record-new RoleIds (by-role (map-new arena U32 IdList)))))
                            (do (map-put m k fresh :arena arena) fresh))))))
      (il-push arena (. rf by-role) v i)))

  (fn fact-subject ((f KFact))
    (@intent "The element a fact is about: its first argument")
    (@spec ((KFact) -> KElem))
    (@pure)
    (match f
      ((f-inst x _)     x)
      ((f-triple x _ _) x)
      ((f-self x _)     x)))

  (fn is-safe ((b Base) (x KElem))
    (@intent "K6: is x safe - does nothing x's W-cone reaches hold a nominal or is an individual?")
    (@spec ((Base KElem) -> Bool))
    (@pure)
    (not (set-has (. b unsafe) x)))

  (fn holds-coded ((st KStore) (c CFact))
    (@intent "Is the encoded fact c in this store?")
    (@spec ((KStore CFact) -> Bool))
    (set-has (. (shard-at st (. c a)) seen) c))

  (fn store-holds ((st KStore) (base (Option Base)) (f KFact))
    (@intent "Is f in this run, or in the base it runs over (G, and W where f's subject is safe)?")
    (@spec ((KStore (Option Base) KFact) -> Bool))
    (let ((c (encode-fact (. st ids) f)))
      (if (holds-coded st c)
        true
        (match base
          ((some b)
            (if (holds-coded (. b g) c)
              true
              (if (is-safe b (fact-subject f))
                (holds-coded (. b w) c)
                false)))
          ((none) false)))))

  (fn commit ((arena Arena) (st KStore) (base (Option Base)) (f KFact))
    (@intent "Store f if it is new to the run and its base; true iff it was")
    (@spec ((Arena KStore (Option Base) KFact) -> Bool))
    (@alloc arena)
    (if (store-holds st base f)
      false
      (file-new arena st f (encode-fact (. st ids) f))))

  (fn commit-coded ((arena Arena) (st KStore) (c CFact))
    (@intent "A round's commit of a conclusion its worker found absent from the frozen store: the fact if it is new, none if this round already stored it")
    (@spec ((Arena KStore CFact) -> (Option KFact)))
    (@alloc arena)
    ;; The worker checked c against the store as the round began, the base
    ;; included; the base never changes during a run, so only facts this
    ;; round committed can make it a duplicate now, and those are in `seen`.
    (if (holds-coded st c)
      (none)
      (let ((f (decode-fact (. st ids) c)))
        (do
          (file-new arena st f c)
          (some f)))))

  (fn file-new ((arena Arena) (st KStore) (f KFact) (c CFact))
    (@intent "Store a fact known to be new: the dedup set and every index it belongs in; true")
    (@spec ((Arena KStore KFact CFact) -> Bool))
    (@alloc arena)
    (do
      (file-subject arena (shard-at st (. c a)) f c)
      (match (other-end st f c)
        ((some h) (file-other arena st c h))
        ((none)   true))))

  (fn file-subject ((arena Arena) (sh Shard) (f KFact) (c CFact))
    (@intent "The subject's half of filing a new fact, all in its subject's shard: seen, insts, noms, outs, noms-at, bots")
    (@spec ((Arena Shard KFact CFact) -> Bool))
    (@alloc arena)
    (do
      (set-put (. sh seen) c :arena arena)
      (match f
        ((f-inst x y)
          (do
            (il-push arena (. sh insts) (. c a) (. c b))
            (when (ksc-4 x y) (set-put (. sh bots) x :arena arena))
            (when (is-nominal y)
              (do
                (set-put (. sh noms-at) x :arena arena)
                (il-push arena (. sh noms) (. c a) (. c b))))))
        ((f-triple _ _ _)
          (ri-push arena (. sh outs) (. c a) (. c b) (. c c)))
        ((f-self _ _) (do)))
      true))

  (fn other-end ((st KStore) (f KFact) (c CFact))
    (@intent "The element id a new fact is filed under besides its subject: a triple's x′, a nominal's {a}; none for the rest")
    (@spec ((KStore KFact CFact) -> (Option U32)))
    (match f
      ((f-inst _ y)
        (if (is-nominal y) (some (elem-id (. st ids) (term-elem y))) (none)))
      ((f-triple _ _ _) (some (. c c)))
      ((f-self _ _)     (none))))

  (fn file-other ((arena Arena) (st KStore) (c CFact) (h U32))
    (@intent "The other end's half of filing a new fact, in h's shard: ins for a triple, holders for a nominal inst")
    (@spec ((Arena KStore CFact U32) -> Bool))
    (@alloc arena)
    (let ((sh (shard-at st h)))
      (if (== (. c kind) (triple-kind))
        (ri-push arena (. sh ins) h (. c b) (. c a))
        (il-push arena (. sh holders) h (. c a)))))

  (fn id-items ((m (Map U32 IdList)) (k U32))
    (@intent "The ids filed under k, if any")
    (@spec (((Map U32 IdList) U32) -> (Option (List U32))))
    (match (map-get m k)
      ((some l) (some (. l items)))
      ((none)   (none))))

  ;; The partner lists of a run over a base: G's, W's where its facts'
  ;; subject is safe (K6.3), then the run's. Each is a snapshot; the base
  ;; is never written during a class's run.
  ;;
  ;; insts, noms and outs are filed under their facts' subject, so W's list
  ;; is read whole when the key is safe and not at all otherwise. holders,
  ;; holders and ins are filed under another element: every predecessor
  ;; of an unsafe element is unsafe (its cone contains the taint), so W's
  ;; list is skipped for an unsafe key and filtered fact by fact for a
  ;; safe one.

  (type Field (enum fd-insts fd-noms fd-holders))

  (fn field-map ((sh Shard) (fd Field))
    (@intent "The element-keyed map a Field names, in one shard")
    (@spec ((Shard Field) -> (Map U32 IdList)))
    (match fd
      ('fd-insts   (. sh insts))
      ('fd-noms    (. sh noms))
      ('fd-holders (. sh holders))))

  (fn keyed-by-subject ((fd Field))
    (@intent "Are a Field's lists filed under their facts' own subject?")
    (@spec ((Field) -> Bool))
    (@pure)
    (match fd
      ('fd-insts   true)
      ('fd-noms    true)
      ('fd-holders false)))

  (fn subject-items ((arena Arena) (ids KscIds) (k KElem) (is (List U32)))
    (@intent "inst(k, y) for each term id y filed under k")
    (@spec ((Arena KscIds KElem (List U32)) -> (List KFact)))
    (@alloc arena)
    (let ((mut out (list-new arena KFact)))
      (do
        (for-each (i is) (list-push out (union-new KFact f-inst k (id-term ids i))))
        out)))

  (fn holder-items ((arena Arena) (ids KscIds) (k KElem) (is (List U32)))
    (@intent "inst(x, {a}) for each holder id x filed under an individual a; nothing under any other key")
    (@spec ((Arena KscIds KElem (List U32)) -> (List KFact)))
    (@alloc arena)
    (let ((mut out (list-new arena KFact)))
      (do
        (match k
          ((e-ind a)
            (let ((y (nominal-term a)))
              (for-each (i is) (list-push out (union-new KFact f-inst (id-elem ids i) y)))))
          ((e-aux _)   (do))
          ((e-class _) (do)))
        out)))

  (fn field-items ((arena Arena) (st KStore) (fd Field) (k KElem))
    (@intent "The facts one store files under k in one field, decoded")
    (@spec ((Arena KStore Field KElem) -> (List KFact)))
    (@alloc arena)
    ;; insts and noms hold the terms y of inst(k, y); holders, keyed by an
    ;; individual a, hold the x of inst(x, {a}).
    (let ((ki (elem-id (. st ids) k)))
      (match (id-items (field-map (shard-at st ki) fd) ki)
        ((some is) (if (keyed-by-subject fd)
                     (subject-items arena (. st ids) k is)
                     (holder-items arena (. st ids) k is)))
        ((none)    (list-new arena KFact)))))

  (fn safe-facts ((arena Arena) (b Base) (xs (List KFact)))
    (@intent "The facts of a W list whose subject is safe")
    (@spec ((Arena Base (List KFact)) -> (List KFact)))
    (@alloc arena)
    (let ((mut out (list-new arena KFact)))
      (do
        (for-each (f xs)
          (when (is-safe b (fact-subject f)) (list-push out f)))
        out)))

  (fn w-items ((arena Arena) (b Base) (by-subject Bool) (k KElem) (xs (List KFact)))
    (@intent "The part of W's list under k that a class's run may read")
    (@spec ((Arena Base Bool KElem (List KFact)) -> (List KFact)))
    (@alloc arena)
    (if (is-safe b k)
      (if by-subject xs (safe-facts arena b xs))
      (list-new arena KFact)))

  (fn partners ((arena Arena) (st KStore) (base (Option Base)) (fd Field) (k KElem))
    (@intent "Every stored fact under k in one field: G, W's safe part, then the run")
    (@spec ((Arena KStore (Option Base) Field KElem) -> (List (List KFact))))
    (@alloc arena)
    (let ((mut out (list-new arena (List KFact))))
      (do
        (match base
          ((some b)
            (do
              (list-push out (field-items arena (. b g) fd k))
              (when (is-safe b k)
                (list-push out (w-items arena b (keyed-by-subject fd) k
                                 (field-items arena (. b w) fd k))))))
          ((none) (do)))
        (list-push out (field-items arena st fd k))
        out)))

  (fn leg-facts ((arena Arena) (ids KscIds) (outward Bool) (k KElem) (e U32) (is (List U32)))
    (@intent "Triples at k under stored role e, decoded: out of k if outward, into k if not")
    (@spec ((Arena KscIds Bool KElem U32 (List U32)) -> (List KFact)))
    (@alloc arena)
    (let ((mut out (list-new arena KFact))
          (r (id-role ids e)))
      (do
        (for-each (i is)
          (list-push out (if outward
                           (union-new KFact f-triple k r (id-elem ids i))
                           (union-new KFact f-triple (id-elem ids i) r k))))
        out)))

  (fn all-ins ((arena Arena) (st KStore) (base (Option Base)) (k KElem))
    (@intent "Every stored triple into k, over every role: G, W's safe part, then the run")
    (@spec ((Arena KStore (Option Base) KElem) -> (List (List KFact))))
    (@alloc arena)
    (let ((mut out (list-new arena (List KFact))))
      (do
        (match base
          ((some b)
            (do
              (for-each (lg (legs-in-store arena (. b g) false k (none)))
                (list-push out (. lg facts)))
              (when (is-safe b k)
                (for-each (lg (legs-in-store arena (. b w) false k (none)))
                  (list-push out (w-items arena b false k (. lg facts)))))))
          ((none) (do)))
        (for-each (lg (legs-in-store arena st false k (none)))
          (list-push out (. lg facts)))
        out)))

  ;; K7 (SPEC §5.4): the stored legs a premise triple(k, v, ·) (or
  ;; triple(·, v, k)) reads, each list with the role e ∈ sub*(v) it is
  ;; stored under, so the join can name e. The walk takes the smaller
  ;; side, as the partner maps do: the roles stored at k, kept when
  ;; under v, or sub*(v), looked up at k.
  (type RoleLegs (record
    (role  RoleId)
    (facts (List KFact))))

  ;; A role filter for legs-in-store: (some (v, sub*(v))) keeps the roles
  ;; under v; none keeps every role.
  (type Under (record
    (idx KscIndex)
    (v   RoleId)))

  (fn side-map ((sh Shard) (outward Bool))
    (@intent "A shard's out-edges if outward, its in-edges if not")
    (@spec ((Shard Bool) -> (Map U32 RoleIds)))
    (if outward (. sh outs) (. sh ins)))

  (fn legs-every-role ((arena Arena) (ids KscIds) (outward Bool) (k KElem) (rf RoleIds))
    (@intent "Every stored role's triples at k")
    (@spec ((Arena KscIds Bool KElem RoleIds) -> (List RoleLegs)))
    (@alloc arena)
    (let ((mut out (list-new arena RoleLegs)))
      (do
        (for-each ((e il) (. rf by-role))
          (list-push out (record-new RoleLegs (role (id-role ids e))
                           (facts (leg-facts arena ids outward k e (. il items))))))
        out)))

  (fn legs-stored-under ((arena Arena) (ids KscIds) (outward Bool) (k KElem) (rf RoleIds) (u Under))
    (@intent "The roles stored at k that are in sub*(v), walked from the stored side")
    (@spec ((Arena KscIds Bool KElem RoleIds Under) -> (List RoleLegs)))
    (@alloc arena)
    (let ((mut out (list-new arena RoleLegs)))
      (do
        (for-each ((e il) (. rf by-role))
          (let ((r (id-role ids e)))
            (when (role-under (. u idx) r (. u v))
              (list-push out (record-new RoleLegs (role r)
                               (facts (leg-facts arena ids outward k e (. il items))))))))
        out)))

  (fn legs-of-subs ((arena Arena) (ids KscIds) (outward Bool) (k KElem) (rf RoleIds) (subs (List RoleId)))
    (@intent "Each role of sub*(v), looked up at k")
    (@spec ((Arena KscIds Bool KElem RoleIds (List RoleId)) -> (List RoleLegs)))
    (@alloc arena)
    (let ((mut out (list-new arena RoleLegs)))
      (do
        (for-each (r subs)
          (let ((e (role-id ids r)))
            (match (map-get (. rf by-role) e)
              ((some il)
                (list-push out (record-new RoleLegs (role r)
                                 (facts (leg-facts arena ids outward k e (. il items))))))
              ((none) (do)))))
        out)))

  (fn legs-under ((arena Arena) (ids KscIds) (outward Bool) (k KElem) (rf RoleIds) (u Under))
    (@intent "The triples at k under sub*(v), walking whichever side is smaller")
    (@spec ((Arena KscIds Bool KElem RoleIds Under) -> (List RoleLegs)))
    (@alloc arena)
    (let ((subs (role-subs arena (. u idx) (. u v))))
      (if (<= (map-len (. rf by-role)) (list-len subs))
        (legs-stored-under arena ids outward k rf u)
        (legs-of-subs arena ids outward k rf subs))))

  (fn legs-in-store ((arena Arena) (st KStore) (outward Bool) (k KElem) (under (Option Under)))
    (@intent "One store's triples at k by stored role, every role or those in sub*(v), decoded")
    (@spec ((Arena KStore Bool KElem (Option Under)) -> (List RoleLegs)))
    (@alloc arena)
    (let ((ids (. st ids))
          (kid (elem-id ids k)))
      (match (map-get (side-map (shard-at st kid) outward) kid)
        ((none) (list-new arena RoleLegs))
        ((some rf)
          (match under
            ((none)   (legs-every-role arena ids outward k rf))
            ((some u) (legs-under arena ids outward k rf u)))))))

  (fn push-w-legs ((arena Arena) (out (List RoleLegs)) (b Base) (outward Bool) (k KElem) (u (Option Under)))
    (@intent "out, then W's triples at k under sub*(v), each cut to the part a class's run may read")
    (@spec ((Arena (List RoleLegs) Base Bool KElem (Option Under)) -> (List RoleLegs)))
    (@alloc arena)
    (let ((mut o out))
      (do
        (for-each (lg (legs-in-store arena (. b w) outward k u))
          (list-push o (record-new RoleLegs (role (. lg role))
                         (facts (w-items arena b outward k (. lg facts))))))
        o)))

  (fn role-legs ((arena Arena) (idx KscIndex) (st KStore) (base (Option Base)) (outward Bool) (k KElem) (v RoleId))
    (@intent "Every stored triple out of (or into) k under sub*(v), by stored role: G, W's safe part, then the run")
    (@spec ((Arena KscIndex KStore (Option Base) Bool KElem RoleId) -> (List RoleLegs)))
    (@alloc arena)
    (let ((mut out (list-new arena RoleLegs))
          (u (some (record-new Under (idx idx) (v v)))))
      (do
        (match base
          ((some b)
            (do
              (for-each (lg (legs-in-store arena (. b g) outward k u))
                (list-push out lg))
              (when (is-safe b k)
                (set! out (push-w-legs arena out b outward k u)))))
          ((none) (do)))
        (for-each (lg (legs-in-store arena st outward k u))
          (list-push out lg))
        out)))

  ;; ============================================================
  ;; The trigger table: every rule an arriving fact can be a premise of
  ;;
  ;;   arriving        rules (stored partner, if any)
  ;;   --------------- ------------------------------------------------
  ;;   inst(x, y)      3; 5; 6 (inst(x, other conjunct)); 7 (join over
  ;;                   ins(x, v)); 8 (self(x, v)); 9, 10; 12;
  ;;                   27 (join over insts(x) if nom(y), and over noms(x));
  ;;                   28 (join over insts(y) if nom(y), and over
  ;;                   holders(x) if x is an individual);
  ;;                   29 (join over every ins(x, ·) if nom(y))
  ;;   triple(x,v,x′)  2; 7 (inst(x′, y)); 13; 15 (join over outs(x′, ·)
  ;;                   as first leg, ins(x, ·) as second); 16 (self(x, u));
  ;;                   17 (self(x′, v)); 23, 25; 29 (join over noms(x′))
  ;;   self(x, v)      8 (inst(x, y)); 11; 14; 16 (join over outs(x, ·));
  ;;                   17 (join over ins(x, ·)); 18 (self(x, other)); 24, 26
  ;;
  ;; Every multi-premise rule is triggered from EACH of its IDB premises -
  ;; the semi-naive obligation §6.4 states for el.
  ;; ============================================================

  ;; A partner bucket met by an element's classes: the other term, and
  ;; the axioms filed under it.
  (type Match (record
    (other  KTerm)
    (axioms KList)))

  (fn inst-id-lists ((arena Arena) (st KStore) (base (Option Base)) (x KElem))
    (@intent "The term ids y of every stored inst(x, y): G, W where x is safe, then the run")
    (@spec ((Arena KStore (Option Base) KElem) -> (List (List U32))))
    (@alloc arena)
    ;; insts is filed under the fact's subject, so W's list is read whole
    ;; when x is safe and not at all otherwise (K6.3), as `partners` does.
    (let ((mut out (list-new arena (List U32)))
          (xi (elem-id (. st ids) x)))
      (do
        (match base
          ((some b)
            (do
              (match (id-items (. (shard-at (. b g) xi) insts) xi) ((some l) (list-push out l)) ((none) (do)))
              (when (is-safe b x)
                (match (id-items (. (shard-at (. b w) xi) insts) xi) ((some l) (list-push out l)) ((none) (do))))))
          ((none) (do)))
        (match (id-items (. (shard-at st xi) insts) xi) ((some l) (list-push out l)) ((none) (do)))
        out)))

  (fn partner-matches ((arena Arena) (st KStore) (base (Option Base)) (x KElem) (p KPartners))
    (@intent "The partner keys x holds, with their axioms: the smaller side of the intersection walked")
    (@spec ((Arena KStore (Option Base) KElem KPartners) -> (List Match)))
    (@alloc arena)
    ;; ELK's lazy intersection, as el's dispatcher does it (premise.slop):
    ;; when the bucket has fewer keys than x has classes, test each key
    ;; for inst(x, key); otherwise walk x's classes and look each up. x's
    ;; classes are read as term ids, so counting them decodes nothing.
    (let ((lists (inst-id-lists arena st base x))
          (mut nx 0)
          (mut out (list-new arena Match)))
      (do
        (for-each (l lists) (set! nx (+ nx (cast Int (list-len l)))))
        (if (<= (. p count) nx)
          (for-each ((other axl) (. p by-other))
            (when (store-holds st base (union-new KFact f-inst x other))
              (list-push out (record-new Match (other other) (axioms axl)))))
          (for-each (l lists)
            (for-each (i l)
              (let ((z (id-term (. st ids) i)))
                (match (map-get (. p by-other) z)
                  ((some axl) (list-push out (record-new Match (other z) (axioms axl))))
                  ((none) (do)))))))
        out)))

  ;; What derive reads, and what it has concluded so far: the frozen index,
  ;; the run's store and, in a class's run, the G/W base, which nothing
  ;; writes during a round; and the conclusions of the fact in hand, which
  ;; the per-rule helpers append to through the pointer. One per worker's
  ;; chunk, in its arena: passed by pointer, the stores are not copied for
  ;; every fact and helper, as they would be by value.
  (type Deriving (record
    (idx  KscIndex)
    (st   KStore)
    (base (Option Base))
    (out  (List KFact))))

  (fn emit-concl ((d (Ptr Deriving)) (c Concl))
    (@intent "Append c's head when c fires")
    (@spec (((Ptr Deriving) Concl) -> Bool))
    (do (when (. c fires) (list-push (. (deref d) out) (. c fact))) true))

  (fn emit-facts ((d (Ptr Deriving)) (xs (List KFact)))
    (@intent "Append xs in order")
    (@spec (((Ptr Deriving) (List KFact)) -> Bool))
    (do (for-each (g xs) (list-push (. (deref d) out) g)) true))

  (fn emit-joins ((arena Arena) (d (Ptr Deriving)) (j JoinRule) (f KFact) (pss (List (List KFact))) (ax KscAxiom))
    (@intent "Append f joined with each partner list in turn")
    (@spec ((Arena (Ptr Deriving) JoinRule KFact (List (List KFact)) KscAxiom) -> Bool))
    (@alloc arena)
    (do (for-each (ps pss) (emit-facts d (ksc-join arena j f ps ax))) true))

  (fn legs-at ((arena Arena) (d (Ptr Deriving)) (outward Bool) (k KElem) (v RoleId))
    (@intent "role-legs over what derive reads")
    (@spec ((Arena (Ptr Deriving) Bool KElem RoleId) -> (List RoleLegs)))
    (@alloc arena)
    (role-legs arena (. (deref d) idx) (. (deref d) st) (. (deref d) base) outward k v))

  (fn holds-now ((d (Ptr Deriving)) (f KFact))
    (@intent "store-holds over what derive reads")
    (@spec (((Ptr Deriving) KFact) -> Bool))
    (store-holds (. (deref d) st) (. (deref d) base) f))

  (fn partners-at ((arena Arena) (d (Ptr Deriving)) (fd Field) (k KElem))
    (@intent "partners over what derive reads")
    (@spec ((Arena (Ptr Deriving) Field KElem) -> (List (List KFact))))
    (@alloc arena)
    (partners arena (. (deref d) st) (. (deref d) base) fd k))

  (fn matches-at ((arena Arena) (d (Ptr Deriving)) (x KElem) (p KPartners))
    (@intent "partner-matches over what derive reads")
    (@spec ((Arena (Ptr Deriving) KElem KPartners) -> (List Match)))
    (@alloc arena)
    (partner-matches arena (. (deref d) st) (. (deref d) base) x p))

  (fn no-axiom ()
    (@intent "The axiom argument of the equality rules (27)-(29), which they do not read")
    (@spec (() -> KscAxiom))
    (union-new KscAxiom k-role (ksc-dummy-role) (ksc-dummy-role)))

  ;; ---- inst(x, y) ----

  (fn inst-some-lhs ((arena Arena) (d (Ptr Deriving)) (f KFact) (x KElem) (y KTerm) (v RoleId) (a KName) (z KName))
    (@intent "∃v.A ⊑ Z with inst(x, y) as its filler premise: the triples into x, then self(x, v)")
    (@spec ((Arena (Ptr Deriving) KFact KElem KTerm RoleId KName KName) -> Bool))
    (@alloc arena)
    (do
      ;; K7: the triples into x under every e ∈ sub*(v), with the axiom
      ;; rewritten to name e.
      (for-each (lg (legs-at arena d false x v))
        (emit-facts d (ksc-join arena 'j7-inst f (. lg facts)
                        (union-new KscAxiom k-some-lhs (. lg role) a z))))
      (when (holds-now d (union-new KFact f-self x v))
        (emit-concl d (ksc-8 v a z x v x y)))
      true))

  (fn inst-and-pairs ((arena Arena) (d (Ptr Deriving)) (x KElem) (y KTerm) (p KPartners))
    (@intent "Rule (6) through the two-level and-pairs: the conjunctions y is in whose other conjunct x holds")
    (@spec ((Arena (Ptr Deriving) KElem KTerm KPartners) -> Bool))
    (@alloc arena)
    (do
      (for-each (m (matches-at arena d x p))
        (for-each (ax (. (. m axioms) items))
          (match ax
            ((k-and a b z)
              (do
                (when (and (is-name y a) (kterm-eq (. m other) (name-term b)))
                  (emit-concl d (ksc-6 a b z x y x (. m other))))
                (when (and (is-name y b) (kterm-eq (. m other) (name-term a)))
                  (emit-concl d (ksc-6 a b z x (. m other) x y)))))
            ((k-sub _ _)            (do))
            ((k-some-lhs _ _ _)     (do))
            ((k-some-rhs _ _ _ _)   (do))
            ((k-self-lhs _ _)       (do))
            ((k-self-rhs _ _)       (do))
            ((k-role _ _)           (do))
            ((k-chain _ _ _)        (do))
            ((k-range _ _)          (do))
            ((k-role-assert _ _ _)  (do)))))
      true))

  (fn inst-equality ((arena Arena) (d (Ptr Deriving)) (f KFact) (x KElem) (y KTerm))
    (@intent "Equality, rules (27)-(29), on inst(x, y); the axiom argument is unused by these")
    (@spec ((Arena (Ptr Deriving) KFact KElem KTerm) -> Bool))
    (@alloc arena)
    (let ((noax (no-axiom)))
      (do
        (when (is-nominal y)
          (do
            (emit-joins arena d 'j27-nom f (partners-at arena d 'fd-insts x) noax)
            (emit-joins arena d 'j28-nom f (partners-at arena d 'fd-insts (term-elem y)) noax)
            (emit-joins arena d 'j29-nom f (all-ins arena (. (deref d) st) (. (deref d) base) x) noax)))
        (emit-joins arena d 'j27-other f (partners-at arena d 'fd-noms x) noax)
        (when (is-individual x)
          (emit-joins arena d 'j28-ind f (partners-at arena d 'fd-holders x) noax))
        true)))

  (fn derive-inst ((arena Arena) (d (Ptr Deriving)) (f KFact) (x KElem) (y KTerm))
    (@intent "Every conclusion with inst(x, y) as a premise")
    (@spec ((Arena (Ptr Deriving) KFact KElem KTerm) -> Bool))
    (@alloc arena)
    (do
      (emit-concl d (ksc-3 x y))
      (match (term-bucket (. (deref d) idx) y)
        ((some bucket)
          (for-each (ax (. bucket items))
            (match ax
              ((k-sub sy sz)          (emit-concl d (ksc-5 sy sz x y)))
              ((k-and _ _ _)          (do))   ; filed in and-pairs, below
              ((k-some-lhs v a z)     (inst-some-lhs arena d f x y v a z))
              ((k-some-rhs a v b w)   (do (emit-concl d (ksc-9 a v b w x y)) (emit-concl d (ksc-10 a v b w x y))))
              ((k-role-assert a v b)  (do (emit-concl d (ksc-9-assert a v b x y)) (emit-concl d (ksc-10-assert a v b x y))))
              ((k-self-rhs a v)       (emit-concl d (ksc-12 a v x y)))
              ((k-self-lhs _ _)       (do))
              ((k-role _ _)           (do))
              ((k-chain _ _ _)        (do))
              ((k-range _ _)          (do)))))
        ((none) (do)))
      ;; (6), through the two-level and-pairs: the conjunctions y is in
      ;; whose other conjunct x already holds.
      (match (and-partners (. (deref d) idx) y)
        ((some p) (inst-and-pairs arena d x y p))
        ((none)   true))
      (inst-equality arena d f x y)))

  ;; ---- triple(x, e, x1) ----

  (fn chain-first ((arena Arena) (d (Ptr Deriving)) (fv KFact) (x KElem) (v RoleId) (x1 KElem)
                   (u RoleId) (v2 RoleId) (w RoleId))
    (@intent "u ∘ v2 ⊑ w with fv = triple(x, v, x1) as its first leg, triple(x, u, x′)")
    (@spec ((Arena (Ptr Deriving) KFact KElem RoleId KElem RoleId RoleId RoleId) -> Bool))
    (@alloc arena)
    (do
      (for-each (lg (legs-at arena d true x1 v2))
        (emit-facts d (ksc-join arena 'j15-first fv (. lg facts)
                        (union-new KscAxiom k-chain u (. lg role) w))))
      (when (holds-now d (union-new KFact f-self x1 v2))
        (emit-concl d (ksc-17 u v2 w x v x1 x1 v2)))
      true))

  (fn chain-second ((arena Arena) (d (Ptr Deriving)) (fv KFact) (x KElem) (v RoleId) (x1 KElem)
                    (u RoleId) (v2 RoleId) (w RoleId))
    (@intent "u ∘ v2 ⊑ w with fv = triple(x, v, x1) as its second leg, triple(x′, v, x″)")
    (@spec ((Arena (Ptr Deriving) KFact KElem RoleId KElem RoleId RoleId RoleId) -> Bool))
    (@alloc arena)
    (do
      (for-each (lg (legs-at arena d false x u))
        (emit-facts d (ksc-join arena 'j15-second fv (. lg facts)
                        (union-new KscAxiom k-chain (. lg role) v2 w))))
      (when (holds-now d (union-new KFact f-self x u))
        (emit-concl d (ksc-16 u v2 w x u x v x1)))
      true))

  (fn triple-under ((arena Arena) (d (Ptr Deriving)) (x KElem) (v RoleId) (x1 KElem))
    (@intent "The read-through triple(x, v, x1): its role bucket's rules, then (7) through ex-by-role")
    (@spec ((Arena (Ptr Deriving) KElem RoleId KElem) -> Bool))
    (@alloc arena)
    (let ((fv (union-new KFact f-triple x v x1)))
      (do
        (match (role-bucket (. (deref d) idx) v)
          ((some bucket)
            (for-each (ax (. bucket items))
              (match ax
                ((k-some-lhs _ _ _)     (do))   ; filed in ex-by-role, below
                ((k-role _ _)           (do))   ; (13) is the read-through itself (K7)
                ((k-chain u v2 w)
                  ;; fv as the first leg, triple(x, u, x′); as the second, triple(x′, v, x″).
                  (do
                    (when (role-eq u v)  (chain-first arena d fv x v x1 u v2 w))
                    (when (role-eq v2 v) (chain-second arena d fv x v x1 u v2 w))))
                ((k-range v2 d2)        (do (emit-concl d (ksc-23 v2 d2 x v x1)) (emit-concl d (ksc-25 v2 d2 x v x1))))
                ((k-sub _ _)            (do))
                ((k-and _ _ _)          (do))
                ((k-some-rhs _ _ _ _)   (do))
                ((k-self-lhs _ _)       (do))
                ((k-self-rhs _ _)       (do))
                ((k-role-assert _ _ _)  (do)))))
          ((none) (do)))
        ;; (7) on the triple, through ex-by-role: the ∃v.A ⊑ C whose
        ;; filler A the successor x1 already holds.
        (match (ex-partners (. (deref d) idx) v)
          ((some p)
            (for-each (m (matches-at arena d x1 p))
              (for-each (ax (. (. m axioms) items))
                (match ax
                  ((k-some-lhs v2 a z)    (emit-concl d (ksc-7 v2 a z x v x1 x1 (. m other))))
                  ((k-sub _ _)            (do))
                  ((k-and _ _ _)          (do))
                  ((k-some-rhs _ _ _ _)   (do))
                  ((k-self-lhs _ _)       (do))
                  ((k-self-rhs _ _)       (do))
                  ((k-role _ _)           (do))
                  ((k-chain _ _ _)        (do))
                  ((k-range _ _)          (do))
                  ((k-role-assert _ _ _)  (do))))))
          ((none) (do)))
        true)))

  (fn derive-triple ((arena Arena) (d (Ptr Deriving)) (f KFact) (x KElem) (e RoleId) (x1 KElem))
    (@intent "Every conclusion with triple(x, e, x1) as a premise")
    (@spec ((Arena (Ptr Deriving) KFact KElem RoleId KElem) -> Bool))
    (@alloc arena)
    ;; K7: the triple is stored under e and read under every v ∈ sup*(e).
    ;; Rule (2) and rule (29) copy the stored role, so they apply at e
    ;; alone; every rule that names a role in an axiom is offered the
    ;; read-through instance triple(x, v, x1), and a stored leg is walked
    ;; under each e′ ∈ sub*(v) with the axiom rewritten to name e′.
    (do
      (emit-concl d (ksc-2 x e x1))
      (for-each (v (role-sups arena (. (deref d) idx) e))
        (triple-under arena d x v x1))
      (emit-joins arena d 'j29-triple f (partners-at arena d 'fd-noms x1) (no-axiom))))

  ;; ---- self(x, v) ----

  (fn self-chain-first ((arena Arena) (d (Ptr Deriving)) (f KFact) (x KElem) (v RoleId)
                        (u RoleId) (v2 RoleId) (w RoleId))
    (@intent "u ∘ v2 ⊑ w with f = self(x, u) as its first leg")
    (@spec ((Arena (Ptr Deriving) KFact KElem RoleId RoleId RoleId RoleId) -> Bool))
    (@alloc arena)
    (do
      (for-each (lg (legs-at arena d true x v2))
        (emit-facts d (ksc-join arena 'j16-self f (. lg facts)
                        (union-new KscAxiom k-chain u (. lg role) w))))
      (when (holds-now d (union-new KFact f-self x v2))
        (emit-concl d (ksc-18 u v2 w x v x v2)))
      true))

  (fn self-chain-second ((arena Arena) (d (Ptr Deriving)) (f KFact) (x KElem) (v RoleId)
                         (u RoleId) (v2 RoleId) (w RoleId))
    (@intent "u ∘ v2 ⊑ w with f = self(x′, v) as its second leg")
    (@spec ((Arena (Ptr Deriving) KFact KElem RoleId RoleId RoleId RoleId) -> Bool))
    (@alloc arena)
    (do
      (for-each (lg (legs-at arena d false x u))
        (emit-facts d (ksc-join arena 'j17-self f (. lg facts)
                        (union-new KscAxiom k-chain (. lg role) v2 w))))
      (when (holds-now d (union-new KFact f-self x u))
        (emit-concl d (ksc-18 u v2 w x u x v)))
      true))

  (fn derive-self ((arena Arena) (d (Ptr Deriving)) (f KFact) (x KElem) (v RoleId))
    (@intent "Every conclusion with self(x, v) as a premise")
    (@spec ((Arena (Ptr Deriving) KFact KElem RoleId) -> Bool))
    (@alloc arena)
    (do
      (match (role-bucket (. (deref d) idx) v)
        ((some bucket)
          (for-each (ax (. bucket items))
            (match ax
              ((k-some-lhs _ _ _)     (do))   ; filed in ex-by-role, below
              ((k-self-lhs v2 z)      (emit-concl d (ksc-11 v2 z x v)))
              ((k-role v2 w)          (emit-concl d (ksc-14 v2 w x v)))
              ((k-chain u v2 w)
                ;; f as self(x, u); f as self(x′, v).
                (do
                  (when (role-eq u v)  (self-chain-first arena d f x v u v2 w))
                  (when (role-eq v2 v) (self-chain-second arena d f x v u v2 w))))
              ((k-range v2 d2)        (do (emit-concl d (ksc-24 v2 d2 x v)) (emit-concl d (ksc-26 v2 d2 x v))))
              ((k-sub _ _)            (do))
              ((k-and _ _ _)          (do))
              ((k-some-rhs _ _ _ _)   (do))
              ((k-self-rhs _ _)       (do))
              ((k-role-assert _ _ _)  (do)))))
        ((none) (do)))
      ;; (8) on the self fact, through ex-by-role: the ∃v.A ⊑ C whose
      ;; filler A the same element already holds.
      (match (ex-partners (. (deref d) idx) v)
        ((some p)
          (for-each (m (matches-at arena d x p))
            (for-each (ax (. (. m axioms) items))
              (match ax
                ((k-some-lhs v2 a z)    (emit-concl d (ksc-8 v2 a z x v x (. m other))))
                ((k-sub _ _)            (do))
                ((k-and _ _ _)          (do))
                ((k-some-rhs _ _ _ _)   (do))
                ((k-self-lhs _ _)       (do))
                ((k-self-rhs _ _)       (do))
                ((k-role _ _)           (do))
                ((k-chain _ _ _)        (do))
                ((k-range _ _)          (do))
                ((k-role-assert _ _ _)  (do))))))
        ((none) (do)))
      true))

  (fn derive ((arena Arena) (d (Ptr Deriving)) (f KFact))
    (@intent "Every conclusion of every rule instance with f as one premise, in a fresh list in arena")
    (@spec ((Arena (Ptr Deriving) KFact) -> (List KFact)))
    (@alloc arena)
    ;; One helper per premise kind, each appending to the conclusions
    ;; through `d`, with a helper of its own for a rule that walks legs.
    ;; Every match over KscAxiom lists each variant, the inert ones as
    ;; `(do)`, so a new variant fails to compile (-Werror=switch) until it
    ;; is placed.
    (do
      (set! (. (deref d) out) (list-new arena KFact))
      (match f
        ((f-inst x y)      (derive-inst arena d f x y))
        ((f-triple x e x1) (derive-triple arena d f x e x1))
        ((f-self x v)      (derive-self arena d f x v)))
      (. (deref d) out)))

  (fn ksc-dummy-role ()
    (@intent "A role for the axiom slot rules (27)-(29) do not read")
    (@spec (() -> RoleId))
    (@pure)
    (union-new RoleId fresh-role 0))

  (fn is-bottom-fact ((f KFact))
    (@intent "K3: does f put bot(z) in the run, inst(u, owl:Nothing)?")
    (@spec ((KFact) -> Bool))
    (@pure)
    ;; K3's flag is raised by exactly the inst facts whose class is
    ;; owl:Nothing - bot(z) holds of that class and no other (K1).
    (@post (match f
             ((f-inst u z)     (== $result (ksc-4 u z)))
             ((f-triple _ _ _) (== $result false))
             ((f-self _ _)     (== $result false))))
    (match f
      ((f-inst u z)     (ksc-4 u z))
      ((f-triple _ _ _) false)
      ((f-self _ _)     false)))

  ;; ============================================================
  ;; The driver: semi-naive rounds to fixpoint, or to unsat
  ;;
  ;; K3: committing inst(u, owl:Nothing) sets `unsat`, and a run that is
  ;; asking about one class stops there. Phase W is not such a run: it
  ;; computes rule (4)-free facts for every class at once, so it records
  ;; where ⊥ arises (`bots`) and runs on. K6.3: a class's run over a base
  ;; also learns ⊥ when it commits a triple into a safe element whose
  ;; W-cone holds ⊥ - those facts are in the base, never committed.
  ;; ============================================================

  (fn reaches-bottom ((base (Option Base)) (f KFact))
    (@intent "K6.3: is f a triple into a safe element whose W-cone holds owl:Nothing?")
    (@spec (((Option Base) KFact) -> Bool))
    ;; Only a triple, only over a base, and only into a safe element: W's
    ;; ⊥-reach of an unsafe element says nothing under one class (K6).
    (@post (match f
             ((f-triple _ _ s)
               (match base
                 ((some b) (implies (== $result true) (is-safe b s)))
                 ((none)   (== $result false))))
             ((f-inst _ _) (== $result false))
             ((f-self _ _) (== $result false))))
    (match base
      ((some b)
        (match f
          ((f-triple _ _ s)
            (if (is-safe b s) (set-has (. b botreach) s) false))
          ((f-inst _ _) false)
          ((f-self _ _) false)))
      ((none) false)))

  ;; One round's outcome: the next delta, and whether ⊥ arose.
  (type RoundOut (record
    (next  (List KFact))
    (added Int)
    (unsat Bool)))

  ;; ============================================================
  ;; A ROUND IS A BARRIER (SPEC §5.4 "Rounds and the cap"), as el's
  ;; (§6.8, saturate.slop): Sₙ is frozen at the round's start, Δₙ
  ;; included; every fact of Δₙ is derived against the frozen Sₙ; then a
  ;; commit, in Δₙ's order, dedups the conclusions into Sₙ₊₁ and Δₙ₊₁ -
  ;; serially, or on several threads with the same result (THE PARALLEL
  ;; COMMIT, below). Nothing writes the store while anything derives.
  ;;
  ;; WHY THE ROUND IS THE SAME AT EVERY WORKER COUNT. A derivation reads
  ;; only the frozen store, so what it yields is a function of the fact
  ;; and Sₙ. Workers take contiguous chunks of Δₙ and keep, in order, the
  ;; conclusions Sₙ does not hold; the commit takes the chunks in order, so
  ;; it sees the very sequence W = 1 sees and commits, dedups and flags
  ;; identically - Δₙ₊₁, the count, K3's flag and the rounds with them.
  ;; (Under stop-at-bottom the commit stops at the first flagging fact,
  ;; which is therefore the same fact at every W.)
  ;; ============================================================

  ;; A record around a list, for KList's reason: a worker's conclusions,
  ;; handed back through a Map it alone writes.
  (type CFactList (record
    (items (List CFact))))

  (fn derive-chunk ((wa Arena) (ra Arena) (idx KscIndex) (st KStore) (base (Option Base)) (delta (List KFact))
                    (lo Int) (hi Int) (out (Map Int CFactList)))
    (@intent "One worker's share of a round: derive from delta[lo, hi) against the frozen store, keep what it lacks")
    (@spec ((Arena Arena KscIndex KStore (Option Base) (List KFact) Int Int (Map Int CFactList)) -> Int))
    (@alloc wa)
    ;; Returns an Int because a spawned function is called through
    ;; `int64_t(*)(void*)`. It only READS the store, the base, the index
    ;; and the id tables; it writes `wa`, its rule arena `ra` (emptied after
    ;; each fact, as before), and `out`, which no other thread sees. Its
    ;; list and `out` were made in `wa`, so they grow there (a collection
    ;; grows in the arena it was made in, slop #278). A conclusion is kept as
    ;; its 16-byte encoding.
    (let ((mut items (list-new wa CFact))
          (ids (. st ids))
          (d (cast (Ptr Deriving) (arena-alloc wa (sizeof Deriving))))
          (mut i lo))
      (do
        (set! (deref d) (record-new Deriving (idx idx) (st st) (base base) (out (list-new wa KFact))))
        (while (< i hi)
          (do
            (match (list-get delta i)
              ((some f)
                (do
                  (for-each (c (derive ra d f))
                    (when (not (store-holds st base c))
                      (list-push items (encode-fact ids c))))
                  (reuse-arena ra)))
              ((none) (do)))
            (set! i (+ i 1))))
        (map-put out 0 (record-new CFactList (items items)))
        0)))

  (fn round-workers ((workers Int) (n Int))
    (@intent "How many workers a round of n facts uses: up to `workers`, at most one per fact")
    (@spec ((Int Int) -> Int))
    (@pure)
    (@post {$result >= 1})
    ;; No floor for small rounds: the result is the same at any count, a
    ;; spawn costs microseconds, and the tests' small fixtures then take
    ;; the parallel path too.
    (worker-count-for workers n))

  ;; A round's derive half: the worker arenas to free once committed, and
  ;; the workers' results in chunk order.
  (type Derived (record
    (arenas (List Arena))
    (outs   (List (Map Int CFactList)))))

  (fn derive-round ((arena Arena) (idx KscIndex) (st KStore) (base (Option Base))
                    (delta (List KFact)) (workers Int))
    (@intent "Derive from every fact of the delta against the frozen store, on up to `workers` threads")
    (@spec ((Arena KscIndex KStore (Option Base) (List KFact) Int) -> Derived))
    (@alloc arena)
    ;; EVERYTHING THE ROUND KEEPS ONLY UNTIL ITS COMMIT LIVES IN `arena`,
    ;; ksc-round's scratch: the lists below (made there, so grown there),
    ;; the thread structs and the spawned closures' environments (`spawn`
    ;; allocates both in the arena it is given).
    (let ((n (cast Int (list-len delta)))
          (nw (round-workers workers (cast Int (list-len delta))))
          (per (/ (+ (cast Int (list-len delta)) (- (round-workers workers (cast Int (list-len delta))) 1))
                  (round-workers workers (cast Int (list-len delta)))))
          (mut was (list-new arena Arena))
          (mut outs (list-new arena (Map Int CFactList)))
          (mut threads (list-new arena (Ptr (Thread Int))))
          (mut k 0))
      (do
        (while (< k nw)
          (let ((wa (arena-new 1048576))
                (ra (arena-new 1048576))
                (out (map-new wa Int CFactList))
                (lo (* k per))
                (hi (if (< (* (+ k 1) per) n) (* (+ k 1) per) n)))
            (do
              (list-push was wa)
              (list-push was ra)
              (list-push outs out)
              ;; `wa`, `ra`, `out`, `lo` and `hi` are IMMUTABLE bindings,
              ;; captured by value (slop 0.4.0 rejects a `mut` capture in
              ;; spawn, slop#193).
              (if (<= nw 1)
                (do (derive-chunk wa ra idx st base delta lo hi out) (do))
                (list-push threads
                  (spawn arena (fn () (derive-chunk wa ra idx st base delta lo hi out)))))
              (set! k (+ k 1)))))
        (for-each (t threads) (join t))
        (record-new Derived (arenas was) (outs outs)))))

  (fn ksc-round ((arena Arena) (na Arena) (idx KscIndex) (st KStore) (base (Option Base))
                 (delta (List KFact)) (stop-at-bottom Bool) (unsat0 Bool) (workers Int) (cas (List Arena)))
    (@intent "One barrier round: derive from every fact of the delta against the frozen store, then commit what is new")
    (@spec ((Arena Arena KscIndex KStore (Option Base) (List KFact) Bool Bool Int (List Arena)) -> RoundOut))
    (@alloc arena)
    ;; The next delta grows in `na`; the derive half lives in `scratch` and
    ;; the workers' arenas, all freed here once the commit has read them.
    ;; The store grows in `arena` under the serial commit and in the
    ;; committers' own arenas `cas` under the parallel one.
    (let ((scratch (arena-new 65536))
          (d (derive-round scratch idx st base delta workers))
          (nc (round-workers (cast Int (list-len cas)) (conclusion-count d)))
          (ro (if (parallel-commit-ok st base d stop-at-bottom unsat0 nc)
                (commit-parallel scratch na st base d cas nc unsat0)
                (commit-serial arena na st base d stop-at-bottom unsat0))))
      (do
        (for-each (wa (. d arenas)) (arena-free wa))
        (arena-free scratch)
        ro)))

  (fn conclusion-count ((d Derived))
    (@intent "How many conclusions a round's workers kept, duplicates included")
    (@spec ((Derived) -> Int))
    (let ((mut n 0))
      (do
        (for-each (out (. d outs))
          (match (map-get out 0)
            ((some cl) (set! n (+ n (cast Int (list-len (. cl items))))))
            ((none) (do))))
        n)))

  (fn raises-unsat ((base (Option Base)) (f KFact))
    (@intent "K3: is a new fact ⊥, or does it reach ⊥?")
    (@spec (((Option Base) KFact) -> Bool))
    (or (is-bottom-fact f) (reaches-bottom base f)))

  ;; The serial commit's working state: what it reads and the round it
  ;; builds, written through the pointer so no per-conclusion step copies a
  ;; store.
  (type Committing (record
    (st    KStore)
    (base  (Option Base))
    (stop  Bool)                ; stop at ⊥
    (next  (List KFact))
    (added Int)
    (unsat Bool)))

  (fn serial-step ((arena Arena) (cm (Ptr Committing)) (c CFact))
    (@intent "One conclusion committed, unless the round has reached ⊥ and stops there")
    (@spec ((Arena (Ptr Committing) CFact) -> Bool))
    (@alloc arena)
    (if (and (. (deref cm) stop) (. (deref cm) unsat))
      true
      (match (commit-coded arena (. (deref cm) st) c)
        ((some f)
          (do
            (list-push (. (deref cm) next) f)
            (set! (. (deref cm) added) (+ (. (deref cm) added) 1))
            (when (raises-unsat (. (deref cm) base) f) (set! (. (deref cm) unsat) true))
            true))
        ((none) true))))

  (fn commit-serial ((arena Arena) (na Arena) (st KStore) (base (Option Base)) (d Derived)
                     (stop-at-bottom Bool) (unsat0 Bool))
    (@intent "The reference commit: every conclusion in Δₙ's order, on this thread, stopping at ⊥ if asked")
    (@spec ((Arena Arena KStore (Option Base) Derived Bool Bool) -> RoundOut))
    (@alloc arena)
    (let ((cm (cast (Ptr Committing) (arena-alloc arena (sizeof Committing)))))
      (do
        (set! (deref cm) (record-new Committing (st st) (base base) (stop stop-at-bottom)
                           (next (list-new na KFact)) (added 0) (unsat unsat0)))
        ;; Chunk by chunk, each in the order its worker derived.
        (for-each (out (. d outs))
          (match (map-get out 0)
            ((some cl) (for-each (c (. cl items)) (serial-step arena cm c)))
            ((none)    (do))))
        (record-new RoundOut (next (. (deref cm) next)) (added (. (deref cm) added)) (unsat (. (deref cm) unsat))))))

  ;; ============================================================
  ;; THE PARALLEL COMMIT (phases G and W, at W > 1): the serial commit's
  ;; result, on nc threads, over a store sharded by element.
  ;;
  ;;   subject pass  committer k walks every conclusion in Δₙ's order and
  ;;                 takes those whose subject's shard it owns (shard mod
  ;;                 nc == k): it dedups each against that shard's `seen`
  ;;                 and files the subject's half (file-subject), keeping
  ;;                 the new ones with their position;
  ;;   merge         serial: walks the conclusions again and, at each
  ;;                 position its owner kept, appends that fact to Δₙ₊₁,
  ;;                 counts it, raises K3's flag, and lists its other end;
  ;;   other pass    committer k files the other end's half (file-other)
  ;;                 of each listed fact whose other end's shard it owns.
  ;;
  ;; WHY IT IS THE SERIAL COMMIT. A fact has one subject, so it is deduped
  ;; in exactly one shard, by one committer, in Δₙ's order: the first
  ;; occurrence wins, as serially. Every collection is keyed by one
  ;; element and written by that element's committer in Δₙ's order, so
  ;; each key's list, and each key's role map, is built by the same puts
  ;; in the same order. The merge restores Δₙ's order for Δₙ₊₁. So the
  ;; store, Δₙ₊₁, the count and the flag are the serial commit's at every
  ;; W, and so is everything derived from them.
  ;;
  ;; The one thing it cannot do is stop at the first ⊥: under
  ;; stop-at-bottom the serial commit stores nothing after it. A round
  ;; that could raise the flag there commits serially (parallel-commit-ok);
  ;; such a fact ends the run, so that is at most one round of a run.
  ;;
  ;; Committer k writes only in cas[k], and only the shards it owns in the
  ;; pass it is in; nothing else writes the store while the passes run.
  ;; ============================================================

  (fn parallel-commit-ok ((st KStore) (base (Option Base)) (d Derived) (stop-at-bottom Bool) (unsat0 Bool) (nc Int))
    (@intent "May this round commit in parallel: more than one committer, and no ⊥ to stop at?")
    (@spec ((KStore (Option Base) Derived Bool Bool Int) -> Bool))
    (if (<= nc 1)
      false
      (if (not stop-at-bottom)
        true
        (if unsat0
          false
          (match base
            ;; Over a base, a triple can raise the flag too (K6.3).
            ((some _) false)
            ((none)   (not (any-bottom-coded st d))))))))

  (fn any-bottom-coded ((st KStore) (d Derived))
    (@intent "Is any conclusion of the round inst(u, owl:Nothing)?")
    (@spec ((KStore Derived) -> Bool))
    (let ((nothing (nothing-term))
          (mut found false))
      (do
        (for-each (out (. d outs))
          (match (map-get out 0)
            ((some cl)
              (for-each (c (. cl items))
                (when (== (. c kind) (inst-kind))
                  (when (kterm-eq (id-term (. st ids) (. c b)) nothing)
                    (set! found true)))))
            ((none) (do))))
        found)))

  ;; One committer's subject pass: the conclusions it found new, with
  ;; their positions in Δₙ's order. A record because a worker hands it
  ;; back through a Map it alone writes.
  (type Fresh (record
    (pos   (List Int))
    (facts (List KFact))))

  ;; A new fact's other half, for the other pass.
  (type Held (record
    (key U32)
    (c   CFact)))

  (fn committer-of ((st KStore) (k U32) (nc Int))
    (@intent "Which of nc committers owns element id k's shard")
    (@spec ((KStore U32 Int) -> Int))
    (% (shard-index k (shard-count st)) nc))

  ;; Committer k's subject pass, in its own arena: what it reads, the
  ;; positions and facts it keeps, and the position of the next conclusion
  ;; in Δₙ's order, written through the pointer.
  (type SubjectPass (record
    (ca    Arena)
    (st    KStore)
    (k     Int)
    (nc    Int)
    (pos   (List Int))
    (facts (List KFact))
    (p     Int)))

  (fn file-if-new ((ca Arena) (st KStore) (c CFact))
    (@intent "c's subject half filed in its shard unless the shard has seen c: the decoded fact when new")
    (@spec ((Arena KStore CFact) -> (Option KFact)))
    (@alloc ca)
    (let ((sh (shard-at st (. c a))))
      (if (set-has (. sh seen) c)
        (none)
        (let ((f (decode-fact (. st ids) c)))
          (do (file-subject ca sh f c) (some f))))))

  (fn subject-step ((sp (Ptr SubjectPass)) (c CFact))
    (@intent "One conclusion of the subject pass, kept when this committer owns it and it is new; the position moves on either way")
    (@spec (((Ptr SubjectPass) CFact) -> Bool))
    (do
      (when (== (committer-of (. (deref sp) st) (. c a) (. (deref sp) nc)) (. (deref sp) k))
        (match (file-if-new (. (deref sp) ca) (. (deref sp) st) c)
          ((some f) (do (list-push (. (deref sp) pos) (. (deref sp) p))
                        (list-push (. (deref sp) facts) f)))
          ((none)   (do))))
      (set! (. (deref sp) p) (+ (. (deref sp) p) 1))
      true))

  (fn commit-subjects ((ca Arena) (sa Arena) (st KStore) (d Derived) (k Int) (nc Int) (res (Map Int Fresh)))
    (@intent "Committer k's subject pass: dedup and file the subject's half of every conclusion its shards own, in Δₙ's order")
    (@spec ((Arena Arena KStore Derived Int Int (Map Int Fresh)) -> Int))
    (@alloc sa)
    ;; Returns an Int because a spawned function is called through
    ;; `int64_t(*)(void*)`. It reads the workers' outputs (frozen), writes
    ;; only the shards it owns (growing them in `ca`), and keeps its result
    ;; in `sa` and `res`, which no other thread sees. The position counts
    ;; EVERY conclusion, owned or not: merge-fresh reads it as Δₙ's order.
    (let ((sp (cast (Ptr SubjectPass) (arena-alloc sa (sizeof SubjectPass)))))
      (do
        (set! (deref sp) (record-new SubjectPass (ca ca) (st st) (k k) (nc nc)
                           (pos (list-new sa Int)) (facts (list-new sa KFact)) (p 0)))
        (for-each (out (. d outs))
          (match (map-get out 0)
            ((some cl) (for-each (c (. cl items)) (subject-step sp c)))
            ((none)    (do))))
        (map-put res 0 (record-new Fresh (pos (. (deref sp) pos)) (facts (. (deref sp) facts))))
        0)))

  (fn commit-others ((ca Arena) (st KStore) (held (List Held)) (k Int) (nc Int))
    (@intent "Committer k's other pass: file the other end's half of each new fact whose other end's shard it owns, in Δₙ's order")
    (@spec ((Arena KStore (List Held) Int Int) -> Int))
    (@alloc ca)
    (do
      (for-each (h held)
        (when (== (committer-of st (. h key) nc) k)
          (file-other ca st (. h c) (. h key))))
      0))

  (fn commit-parallel ((scratch Arena) (na Arena) (st KStore) (base (Option Base)) (d Derived)
                       (cas (List Arena)) (nc Int) (unsat0 Bool))
    (@intent "The commit on nc threads: subject pass, merge in Δₙ's order, other pass; the serial commit's result")
    (@spec ((Arena Arena KStore (Option Base) Derived (List Arena) Int Bool) -> RoundOut))
    (@alloc scratch)
    ;; The subject pass's results live in each committer's `sa`, freed once
    ;; merged; the merge's list and the thread structs in `scratch`.
    (let ((mut sas (list-new scratch Arena))
          (mut ress (list-new scratch (Map Int Fresh)))
          (mut threads (list-new scratch (Ptr (Thread Int))))
          (mut k 0))
      (do
        (while (< k nc)
          (let ((sa (arena-new 1048576))
                (ca (committer-arena cas k))
                (res (map-new sa Int Fresh))
                (kk k))
            (do
              (list-push sas sa)
              (list-push ress res)
              (list-push threads
                (spawn scratch (fn () (commit-subjects ca sa st d kk nc res))))
              (set! k (+ k 1)))))
        (for-each (t threads) (join t))
        (let ((merged (merge-fresh scratch na st base d ress nc unsat0))
              (mut others (list-new scratch (Ptr (Thread Int))))
              (mut j 0))
          (do
            (for-each (sa sas) (arena-free sa))
            (while (< j nc)
              (let ((ca (committer-arena cas j))
                    (held (. merged held))
                    (jj j))
                (do
                  (list-push others
                    (spawn scratch (fn () (commit-others ca st held jj nc))))
                  (set! j (+ j 1)))))
            (for-each (t others) (join t))
            (. merged out))))))

  (fn committer-arena ((cas (List Arena)) (k Int))
    (@intent "Committer k's arena")
    (@spec (((List Arena) Int) -> Arena))
    (match (list-get cas k)
      ((some a) a)
      ;; Unreachable: nc never exceeds the arenas a run was given.
      ((none) (match (list-get cas 0) ((some a) a) ((none) (arena-new 4096))))))

  ;; The merge's result: the round's outcome and the other halves to file.
  (type Merged (record
    (out  RoundOut)
    (held (List Held))))

  ;; The merge's working state, in scratch: what it reads (the store, the
  ;; base, each committer's new facts and its cursor) and what it builds,
  ;; written through the pointer so no per-conclusion step copies a store.
  (type Merging (record
    (st    KStore)
    (base  (Option Base))
    (nc    Int)
    (frs   (List Fresh))
    (cur   (List Int))
    (next  (List KFact))
    (held  (List Held))
    (added Int)
    (unsat Bool)
    (p     Int)))

  (fn kept-at ((m (Ptr Merging)) (k Int))
    (@intent "The fact committer k kept at the merge's position, when its cursor points there")
    (@spec (((Ptr Merging) Int) -> (Option KFact)))
    (match (list-get (. (deref m) frs) k)
      ((none) (none))
      ((some fr)
        (match (list-get (. (deref m) cur) k)
          ((none) (none))
          ((some i)
            (match (list-get (. fr pos) i)
              ((some q) (if (== q (. (deref m) p)) (list-get (. fr facts) i) (none)))
              ((none)   (none))))))))

  (fn cursor-at ((cur (List Int)) (k Int))
    (@intent "Committer k's cursor")
    (@spec (((List Int) Int) -> Int))
    (match (list-get cur k)
      ((some i) i)
      ((none)   0)))

  (fn take-fact ((m (Ptr Merging)) (f KFact) (c CFact))
    (@intent "A kept fact into Δₙ₊₁: counted, K3's flag, and its other end's half held for the other pass")
    (@spec (((Ptr Merging) KFact CFact) -> Bool))
    (do
      (list-push (. (deref m) next) f)
      (set! (. (deref m) added) (+ (. (deref m) added) 1))
      (when (raises-unsat (. (deref m) base) f) (set! (. (deref m) unsat) true))
      (match (other-end (. (deref m) st) f c)
        ((some h) (list-push (. (deref m) held) (record-new Held (key h) (c c))))
        ((none)   (do)))
      true))

  (fn merge-step ((m (Ptr Merging)) (c CFact))
    (@intent "The conclusion at the merge's position: kept by its owner, it joins Δₙ₊₁ and the owner's cursor moves on")
    (@spec (((Ptr Merging) CFact) -> Bool))
    ;; `cur` is written with list-set, which writes through the list's
    ;; buffer because it never reallocates.
    (let ((k (committer-of (. (deref m) st) (. c a) (. (deref m) nc))))
      (do
        (match (kept-at m k)
          ((some f)
            (do
              (take-fact m f c)
              (list-set (. (deref m) cur) k (+ (cursor-at (. (deref m) cur) k) 1))))
          ((none) (do)))
        (set! (. (deref m) p) (+ (. (deref m) p) 1))
        true)))

  (fn merge-fresh ((scratch Arena) (na Arena) (st KStore) (base (Option Base)) (d Derived)
                   (ress (List (Map Int Fresh))) (nc Int) (unsat0 Bool))
    (@intent "Δₙ₊₁ in Δₙ's order from the committers' new facts, with the count, K3's flag and the other halves")
    (@spec ((Arena Arena KStore (Option Base) Derived (List (Map Int Fresh)) Int Bool) -> Merged))
    (@alloc scratch)
    ;; Each committer's positions ascend, so a cursor per committer finds,
    ;; at each position, whether its owner kept that conclusion.
    (let ((m (cast (Ptr Merging) (arena-alloc scratch (sizeof Merging))))
          (mut frs (list-new scratch Fresh))
          (mut cur (list-new scratch Int)))
      (do
        (for-each (r ress)
          (match (map-get r 0)
            ((some fr) (do (list-push frs fr) (list-push cur 0)))
            ((none)    (do (list-push frs (record-new Fresh (pos (list-new scratch Int)) (facts (list-new scratch KFact))))
                           (list-push cur 0)))))
        (set! (deref m) (record-new Merging (st st) (base base) (nc nc) (frs frs) (cur cur)
                          (next (list-new na KFact)) (held (list-new scratch Held))
                          (added 0) (unsat unsat0) (p 0)))
        (for-each (out (. d outs))
          (match (map-get out 0)
            ((some cl) (for-each (c (. cl items)) (merge-step m c)))
            ((none)    (do))))
        (record-new Merged
          (out  (record-new RoundOut (next (. (deref m) next)) (added (. (deref m) added)) (unsat (. (deref m) unsat))))
          (held (. (deref m) held))))))

  (fn run-ksc ((arena Arena) (idx KscIndex) (ids KscIds) (base (Option Base)) (seeds (List KFact))
                (stop-at-bottom Bool) (budget Int) (cancel I64) (workers Int) (cas (List Arena)))
    (@intent "Saturate from seeds over a base for at most `budget` rounds; stop at the fixpoint, or when ⊥ arises if asked to")
    (@spec ((Arena KscIndex KscIds (Option Base) (List KFact) Bool Int I64 Int (List Arena)) -> RunResult))
    (@alloc arena)
    (@pre {budget >= 0})
    (@post {(. $result rounds) <= budget})
    ;; THE CAP: a run never takes more rounds than it was given (§5.4
    ;; "Rounds and the cap"): `going` admits a round only while
    ;; `rounds < budget`. Proved, through the loop invariant below; the
    ;; cancel read is `cancel-requested` and the result is built by
    ;; `run-result` so that slop's verifier can follow both (slop #280,
    ;; #279). test-ksc-cap checks it at run time as well.
    ;;
    ;; Each round's delta lives in an arena of its own, freed once the next
    ;; round's delta exists. `workers` derives each round on up to that many
    ;; threads, and `cas`, one arena per committer, commits it on as many
    ;; (ksc-round); none means a store of one shard and the serial commit.
    ;; The run is the same at every count.
    (let ((st (new-store arena ids (cast Int (list-len cas))))
          (seeded (seed-run arena st base seeds))
          (mut da (arena-new 1048576))
          (mut delta (. seeded next))
          (mut unsat (. seeded unsat))
          (mut facts (. seeded added))
          (mut rounds 0)
          (mut cancelled false)
          (mut going (> (list-len (. seeded next)) 0)))
      (do
        ;; A run flagged by its seeds is finished before its first round
        ;; (K3): no round is counted and nothing is left to process.
        (when (if stop-at-bottom unsat false)
          (do (set! delta (list-new da KFact)) (set! going false)))
        ;; Each pass is one round boundary (§5.4 "Rounds and the cap"):
        ;; while work is pending, cancel-ptr is read first, then the cap,
        ;; and only then does a round run, so a round starts only with one
        ;; left to spend.
        ;;
        ;; CANCELLATION (§5.4, as el's §6.8): a run that sees cancel-ptr
        ;; stops there and says so, ahead of the cap, as el's loop tests it
        ;; before its budget; its caller turns that into Fault::cancelled,
        ;; never a result.
        (while going
          (@loop-invariant {rounds <= budget})
          (do
            (when (cancel-requested cancel) (set! cancelled true))
            (if (if cancelled true (>= rounds budget))
              (set! going false)
              (let ((na (arena-new 1048576))
                    (ro (ksc-round arena na idx st base delta stop-at-bottom unsat workers cas)))
                (do
                  (set! rounds (+ rounds 1))
                  (set! facts (+ facts (. ro added)))
                  (set! unsat (. ro unsat))
                  (arena-free da)
                  (set! da na)
                  (set! delta (if (if stop-at-bottom unsat false) (list-new da KFact) (. ro next)))
                  (set! going (> (list-len delta) 0)))))))
        (let ((capped (> (list-len delta) 0)))
          (do
            (arena-free da)
            (run-result st rounds unsat capped cancelled facts))))))

  (fn run-result ((st KStore) (rounds Int) (unsat Bool) (capped Bool) (cancelled Bool) (facts Int))
    (@intent "A run's result, built from the values its loop ended with")
    (@spec ((KStore Int Bool Bool Bool Int) -> RunResult))
    (@pure)
    (@post {(. $result rounds) == rounds})
    ;; A constructor of its own only so run-ksc's cap proves: a record-new
    ;; that is a function's result loses any field read from a `set!`
    ;; variable in slop's verifier (slop #279), while a call's @post is
    ;; assumed with its arguments' final values.
    (record-new RunResult (store st) (rounds rounds) (unsat unsat) (capped capped)
      (cancelled cancelled) (facts facts)))

  (fn seed-run ((arena Arena) (st KStore) (base (Option Base)) (seeds (List KFact)))
    (@intent "Commit a run's seeds; the first delta")
    (@spec ((Arena KStore (Option Base) (List KFact)) -> RoundOut))
    (@alloc arena)
    (let ((mut next (list-new arena KFact))
          (mut unsat false)
          (mut added 0))
      (do
        (for-each (s seeds)
          (when (commit arena st base s)
            (do
              (list-push next s)
              (set! added (+ added 1))
              (when (is-bottom-fact s) (set! unsat true))
              (when (reaches-bottom base s) (set! unsat true)))))
        (record-new RoundOut (next next) (added added) (unsat unsat)))))

  ;; ============================================================
  ;; Classification: phase G, phase W, then a run for each unsafe class
  ;; (SPEC §5.4 K2, K6)
  ;; ============================================================

  (fn answer-subsumers ((arena Arena) (st KStore) (q KName))
    (@intent "The class names a store puts q's test individual in: inst(q, B)")
    (@spec ((Arena KStore KName) -> (List KName)))
    (@alloc arena)
    ;; A class element is never in G (K2 point 2): for a safe q this store
    ;; is W (K6.2), for an unsafe one it is q's run, which holds every inst
    ;; fact about q (K6.3: none is in the base).
    (let ((mut out (list-new arena KName)))
      (do
        (for-each (f (field-items arena st 'fd-insts (class-elem q)))
          (match f
            ((f-inst _ y)
              (match y
                ((k-name n)    (list-push out (copy-kname arena n)))
                ((k-nominal _) (do))))
            ((f-triple _ _ _) (do))
            ((f-self _ _)     (do))))
        out)))

  (fn queue-ins ((w KStore) (seen (Set U32)) (out (Set KElem)) (work (List U32)) (xi U32))
    (@intent "Mark and queue every element with a triple into xi not yet seen; the work list, grown")
    (@spec ((KStore (Set U32) (Set KElem) (List U32) U32) -> (List U32)))
    (let ((ids (. w ids))
          (mut wk work))
      (do
        (match (map-get (. (shard-at w xi) ins) xi)
          ((some rf)
            (for-each ((v il) (. rf by-role))
              (for-each (pi (. il items))
                (when (not (set-has seen pi))
                  (do
                    (set-put seen pi)
                    (set-put out (id-elem ids pi))
                    (list-push wk pi))))))
          ((none) (do)))
        wk)))

  (fn backward-closure ((arena Arena) (w KStore) (start (List KElem)))
    (@intent "Every element of W whose triples reach one of start, start included")
    (@spec ((Arena KStore (List KElem)) -> (Set KElem)))
    (@alloc arena)
    ;; Walks W's incoming triples (ins, every role) from each start element,
    ;; over ids; an element is queued once, so the walk ends on cycles.
    (let ((out (set-new arena KElem))
          (seen (set-new arena U32))
          (ids (. w ids))
          (mut work (list-new arena U32))
          (mut i 0))
      (do
        (for-each (x start)
          (do
            (set-put out x)
            (let ((xi (elem-id ids x)))
              (when (not (set-has seen xi))
                (do (set-put seen xi) (list-push work xi))))))
        (while (< i (cast Int (list-len work)))
          (do
            (match (list-get work i)
              ((some xi) (set! work (queue-ins w seen out work xi)))
              ((none)    (do)))
            (set! i (+ i 1))))
        out)))

  (fn class-run ((arena Arena) (idx KscIndex) (base Base) (g-unsat Bool) (budget Int) (cancel I64) (q KName))
    (@intent "An unsafe class's run over G ∪ W_S, in a scratch arena; its answers copied into arena, none if cancelled")
    (@spec ((Arena KscIndex Base Bool Int I64 KName) -> (Option ClassAnswer)))
    (@alloc arena)
    (let ((scratch (arena-new 1048576))
          (qseeds (list-new scratch KFact)))
      (do
        (list-push qseeds (. (ksc-q q) fact))
        ;; One worker: phase Q already runs its classes on separate threads
        ;; (run-chunk), and nesting would oversubscribe the machine.
        (let ((r (run-ksc scratch idx (. (. base g) ids) (some base) qseeds true budget cancel 1
                   (list-new scratch Arena)))
              (ans (record-new ClassAnswer
                     (cls       q)
                     (shared    false)
                     (unsat     (if g-unsat true (. r unsat)))
                     (subsumers (answer-subsumers arena (. r store) q))
                     ;; A run stopped by ⊥ is finished (K3), not capped.
                     (complete  (if (. r unsat) true (not (. r capped))))
                     (rounds    (. r rounds))
                     (facts     (. r facts)))))
          (do
            (arena-free scratch)
            (if (. r cancelled) (none) (some ans)))))))

  (fn shared-answer ((arena Arena) (base Base) (g-unsat Bool) (q KName))
    (@intent "K6.2: a safe class's answers, read from W")
    (@spec ((Arena Base Bool KName) -> ClassAnswer))
    (@alloc arena)
    (@post {(. $result shared) == true})
    (@post {(. $result complete) == true})
    (@post (implies {g-unsat == true} {(. $result unsat) == true}))
    ;; unsat(q) iff G holds ⊥, or some element of q's W-cone holds ⊥.
    (record-new ClassAnswer
      (cls       q)
      (shared    true)
      (unsat     (if g-unsat true (set-has (. base botreach) (class-elem q))))
      (subsumers (answer-subsumers arena (. base w) q))
      (complete  true)
      (rounds    0)
      (facts     0)))

  (fn class-answer ((arena Arena) (idx KscIndex) (base Base) (g-unsat Bool) (budget Int) (cancel I64) (q KName))
    (@intent "q's answers: from W if q is safe (K6.2), from a run of its own if not (K6.3); none if cancelled")
    (@spec ((Arena KscIndex Base Bool Int I64 KName) -> (Option ClassAnswer)))
    (@alloc arena)
    (if (is-safe base (class-elem q))
      (some (shared-answer arena base g-unsat q))
      (class-run arena idx base g-unsat budget cancel q)))

  (fn classify-renamed ((arena Arena) (axioms (List KscAxiom)) (classes (List KName)) (config ReasonerConfig))
    (@intent "Phase G, phase W, then a run for each unsafe class, over engine names")
    (@spec ((Arena (List KscAxiom) (List KName) ReasonerConfig) -> (Result KscResult Fault)))
    (@alloc arena)
    ;; G's and W's stores grow in one arena per committer (ksc-round). They
    ;; are read until every class is answered, and nothing returned points
    ;; into them - answers are copied into `arena` - so they are freed here.
    (let ((cas (ksc-commit-arenas arena (cast Int (. config worker-count))))
          (r (classify-phases arena axioms classes config cas)))
      (do
        (for-each (a cas) (arena-free a))
        r)))

  (fn ksc-commit-arenas ((arena Arena) (w Int))
    (@intent "One arena per committer at W > 1; none at W = 1, where the store has one shard and commits serially")
    (@spec ((Arena Int) -> (List Arena)))
    (@alloc arena)
    (let ((mut out (list-new arena Arena))
          (mut k 0))
      (do
        (when (> w 1)
          (while (< k w)
            (do
              (list-push out (arena-new 1048576))
              (set! k (+ k 1)))))
        out)))

  (fn w-capped ((arena Arena) (g RunResult) (w RunResult) (n Int))
    (@intent "A W the cap stopped answers no class: the findings are G's, and the run says resource-limit")
    (@spec ((Arena RunResult RunResult Int) -> KscResult))
    (@alloc arena)
    (record-new KscResult
      (inconsistent false)
      (termination  (union-new Termination resource-limit n))
      (rounds       (+ (. g rounds) (. w rounds)))
      (g-rounds     (. g rounds))
      (g-facts      (. g facts))
      (w-rounds     (. w rounds))
      (w-facts      (. w facts))
      (unsafe-count 0)
      (answers      (list-new arena ClassAnswer))))

  (fn phase-w ((arena Arena) (idx KscIndex) (ids KscIds) (g RunResult) (wseeds (List KFact))
               (tainted (List KElem)) (thing KName) (classes (List KName)) (config ReasonerConfig)
               (cas (List Arena)) (n Int))
    (@intent "With G complete and consistent: phase W on what the cap leaves, then phase Q over both")
    (@spec ((Arena KscIndex KscIds RunResult (List KFact) (List KElem) KName (List KName) ReasonerConfig
             (List Arena) Int) -> (Result KscResult Fault)))
    (@alloc arena)
    (let ((w (run-ksc arena idx ids (none) wseeds false (- n (. g rounds)) (. config cancel-ptr)
               (cast Int (. config worker-count)) cas)))
      (cond
        ((. w cancelled) (error (union-new Fault cancelled)))
        ((. w capped)    (ok (w-capped arena g w n)))
        (else
          (classify-over-w arena idx g w tainted thing classes
            (- n (+ (. g rounds) (. w rounds)))
            (cast Int (. config worker-count)) (. config cancel-ptr))))))

  (fn classify-phases ((arena Arena) (axioms (List KscAxiom)) (classes (List KName)) (config ReasonerConfig)
                       (cas (List Arena)))
    (@intent "Phase G, phase W, then a run for each unsafe class, G and W committing in cas")
    (@spec ((Arena (List KscAxiom) (List KName) ReasonerConfig (List Arena)) -> (Result KscResult Fault)))
    (@alloc arena)
    ;; K3: the ontology is inconsistent iff unsat(owl:Thing), so owl:Thing
    ;; is always seeded in W and always answered, listed or not. A ⊥ in G
    ;; flags every class, so then nothing else runs; with no individuals,
    ;; G is empty and only owl:Thing's answer can see ⊤ ⊑ ⊥.
    ;;
    ;; THE CAP (§5.4 "Rounds and the cap"): `max-iterations` bounds
    ;; rounds(G) + rounds(W) + the most rounds any unsafe class takes. G
    ;; gets all of it, W what G leaves, each class run what G and W leave.
    ;; A capped G or W answers no class (K6: safety is a property of the
    ;; complete W); the findings are then G's alone.
    (let ((idx (build-ksc-index arena axioms))
          (ids (build-ksc-ids arena axioms classes (. idx individuals)))
          (thing (union-new KName k-class (record-new IRI (value OWL_THING))))
          (n (. config max-iterations))
          (mut gseeds (list-new arena KFact))
          (mut wseeds (list-new arena KFact))
          (mut tainted (list-new arena KElem)))
      (do
        (for-each (a (. idx individuals))
          (do
            (list-push gseeds (. (ksc-1 a) fact))
            (list-push wseeds (. (ksc-1 a) fact))
            (list-push tainted (ind-elem a))))
        (list-push wseeds (. (ksc-q thing) fact))
        (for-each (q classes)
          (list-push wseeds (. (ksc-q q) fact)))
        (let ((g (run-ksc arena idx ids (none) gseeds true n (. config cancel-ptr)
                   (cast Int (. config worker-count)) cas)))
          (cond
            ((. g cancelled) (error (union-new Fault cancelled)))
            ((. g unsat)     (ok (g-only arena g true)))
            ((. g capped)    (ok (g-only arena g false)))
            (else (phase-w arena idx ids g wseeds tainted thing classes config cas n)))))))

  (fn ksc-classify ((arena Arena) (axioms (List KscAxiom)) (classes (List KName)) (config ReasonerConfig))
    (@intent "Classify an el++ normal form: rename to engine ids, run G, W and phase Q, map the answers back")
    (@spec ((Arena (List KscAxiom) (List KName) ReasonerConfig) -> (Result KscResult Fault)))
    (@alloc arena)
    ;; THE ENGINE BOUNDARY (kscnames.slop): classes and roles enter as
    ;; dense ids, so no fact the engine stores or finds hashes an IRI
    ;; string but owl:Thing's, owl:Nothing's and an individual's. The
    ;; answers leave under the input's names.
    (let ((nm (build-ksc-names arena axioms classes)))
      (match (classify-renamed arena (rename-ksc-axioms arena nm axioms)
               (rename-classes arena nm classes) config)
        ((error f) (error f))
        ((ok r)    (ok (unrename-result arena nm r))))))

  (fn unrename-result ((arena Arena) (nm KscNames) (r KscResult))
    (@intent "A result with every answer's names mapped back to the input's")
    (@spec ((Arena KscNames KscResult) -> KscResult))
    (@alloc arena)
    (let ((mut answers (list-new arena ClassAnswer)))
      (do
        (for-each (a (. r answers)) (list-push answers (unrename-answer arena nm a)))
        (record-new KscResult
          (inconsistent (. r inconsistent))
          (termination  (. r termination))
          (rounds       (. r rounds))
          (g-rounds     (. r g-rounds))
          (g-facts      (. r g-facts))
          (w-rounds     (. r w-rounds))
          (w-facts      (. r w-facts))
          (unsafe-count (. r unsafe-count))
          (answers      answers)))))

  (fn g-only ((arena Arena) (g RunResult) (inconsistent Bool))
    (@intent "The result when G decides alone: inconsistent, or capped before W could run")
    (@spec ((Arena RunResult Bool) -> KscResult))
    (@alloc arena)
    ;; A ⊥ in G: every class is unsat and the ontology inconsistent (K3), so
    ;; the findings are complete without W. A capped G: nothing is answered.
    (record-new KscResult
      (inconsistent inconsistent)
      (termination  (if inconsistent
                      (union-new Termination fixpoint)
                      (union-new Termination resource-limit (. g rounds))))
      (rounds       (. g rounds))
      (g-rounds     (. g rounds))
      (g-facts      (. g facts))
      (w-rounds     0)
      (w-facts      0)
      (unsafe-count 0)
      (answers      (list-new arena ClassAnswer))))

  (fn copy-answer ((arena Arena) (a ClassAnswer))
    (@intent "A class's answer, copied into arena with its strings")
    (@spec ((Arena ClassAnswer) -> ClassAnswer))
    (@alloc arena)
    (let ((mut subs (list-new arena KName)))
      (do
        (for-each (n (. a subsumers)) (list-push subs (copy-kname arena n)))
        (record-new ClassAnswer
          (cls       (copy-kname arena (. a cls)))
          (shared    (. a shared))
          (unsat     (. a unsat))
          (subsumers subs)
          (complete  (. a complete))
          (rounds    (. a rounds))
          (facts     (. a facts))))))

  (fn run-chunk ((wa Arena) (idx KscIndex) (base Base) (budget Int) (cancel I64)
                 (classes (List KName)) (todo (List Int)) (out (Map Int ClassAnswer)))
    (@intent "One worker's share of phase Q: the runs of the unsafe classes it was handed; 1 if cancelled, else 0")
    (@spec ((Arena KscIndex Base Int I64 (List KName) (List Int) (Map Int ClassAnswer)) -> Int))
    (@alloc wa)
    ;; Returns an Int because a spawned function is called through
    ;; `int64_t(*)(void*)`: 1 when cancel-ptr stopped the chunk, between
    ;; runs or inside one (run-ksc reads it at its round boundaries).
    ;; Everything it allocates is in `wa` or in each run's own scratch
    ;; arena; it only READS the base, which nothing writes once phase W
    ;; is done.
    (let ((mut cancelled false))
      (do
        (for-each (i todo)
          (do
            (when (cancel-requested cancel) (set! cancelled true))
            (when (not cancelled)
              (match (list-get classes i)
                ((some q)
                  (match (class-run wa idx base false budget cancel q)
                    ((some a) (map-put out i a))
                    ((none)   (set! cancelled true))))
                ((none) (do))))))
        (if cancelled 1 0))))

  (fn index-chunk ((arena Arena) (xs (List Int)) (lo Int) (hi Int))
    (@intent "The elements of xs at positions lo up to (not including) hi")
    (@spec ((Arena (List Int) Int Int) -> (List Int)))
    (@alloc arena)
    (let ((mut out (list-new arena Int))
          (mut j lo))
      (do
        (while (< j hi)
          (do
            (match (list-get xs j)
              ((some x) (list-push out x))
              ((none)   (do)))
            (set! j (+ j 1))))
        out)))

  (fn worker-count-for ((workers Int) (jobs Int))
    (@intent "How many workers phase Q uses: at least one, at most one per job")
    (@spec ((Int Int) -> Int))
    (@pure)
    (@post {$result >= 1})
    (@post (implies {jobs >= 1} {$result <= jobs}))
    (@post (implies {workers >= 1} {$result <= workers}))
    (if (< workers 1) 1 (if (> workers jobs) (if (> jobs 0) jobs 1) workers)))

  (fn over-w-base ((arena Arena) (g RunResult) (w RunResult) (tainted (List KElem)))
    (@intent "G and W, with W's elements that reach a tainted one (unsafe) and those that reach ⊥")
    (@spec ((Arena RunResult RunResult (List KElem)) -> Base))
    (@alloc arena)
    (let ((mut taint (list-new arena KElem)))
      (do
        (for-each (x tainted) (list-push taint x))
        (for-each (sh (. (. w store) shards))
          (for-each (x (set-elements (. sh noms-at)))
            (list-push taint x)))
        (record-new Base
          (g        (. g store))
          (w        (. w store))
          (unsafe   (backward-closure arena (. w store) taint))
          (botreach (backward-closure arena (. w store)
                      (store-bots arena (. w store))))))))

  (fn split-safe ((arena Arena) (base Base) (classes (List KName)) (shared (Map Int ClassAnswer)))
    (@intent "Each safe class answered from W into shared, by class position; the positions of the unsafe ones")
    (@spec ((Arena Base (List KName) (Map Int ClassAnswer)) -> (List Int)))
    (@alloc arena)
    (let ((mut todo (list-new arena Int))
          (mut i 0))
      (do
        (for-each (q classes)
          (do
            (if (is-safe base (class-elem q))
              (map-put shared i (shared-answer arena base false q))
              (list-push todo i))
            (set! i (+ i 1))))
        todo)))

  ;; Phase Q's unsafe runs: the worker arenas (freed once the answers are
  ;; copied out), each worker's answers by class position, and how many
  ;; runs were cancelled.
  (type QRuns (record
    (was       (List Arena))
    (outs      (List (Map Int ClassAnswer)))
    (cancelled Int)))

  (fn run-unsafe ((arena Arena) (idx KscIndex) (base Base) (budget Int) (cancel I64)
                  (classes (List KName)) (todo (List Int)) (workers Int))
    (@intent "The unsafe classes' runs in contiguous chunks of the class order, a thread each above one worker")
    (@spec ((Arena KscIndex Base Int I64 (List KName) (List Int) Int) -> QRuns))
    (@alloc arena)
    (let ((nw (worker-count-for workers (cast Int (list-len todo))))
          (per (/ (+ (cast Int (list-len todo)) (- nw 1)) nw))
          (mut was (list-new arena Arena))
          (mut outs (list-new arena (Map Int ClassAnswer)))
          (mut threads (list-new arena (Ptr (Thread Int))))
          (mut cancelled 0)
          (mut k 0))
      (do
        (while (< k nw)
          (let ((wa (arena-new 1048576))
                (out (map-new wa Int ClassAnswer))
                (chunk (index-chunk wa todo (* k per) (* (+ k 1) per))))
            (do
              (list-push was wa)
              (list-push outs out)
              ;; `wa`, `out` and `chunk` are IMMUTABLE bindings, captured
              ;; by value (slop 0.4.0 rejects a `mut` capture in spawn,
              ;; slop#193).
              (if (<= nw 1)
                (set! cancelled (+ cancelled (run-chunk wa idx base budget cancel classes chunk out)))
                (list-push threads
                  (spawn arena (fn () (run-chunk wa idx base budget cancel classes chunk out)))))
              (set! k (+ k 1)))))
        (for-each (t threads) (set! cancelled (+ cancelled (join t))))
        (record-new QRuns (was was) (outs outs) (cancelled cancelled)))))

  ;; Phase Q's answers in class order, and whether every run finished.
  (type QAnswers (record
    (answers  (List ClassAnswer))
    (complete Bool)))

  (fn copy-unsafe ((arena Arena) (qa QAnswers) (outs (List (Map Int ClassAnswer))) (i Int))
    (@intent "Class i's answer from the worker that ran it, copied into arena")
    (@spec ((Arena QAnswers (List (Map Int ClassAnswer)) Int) -> QAnswers))
    (@alloc arena)
    (let ((mut r qa))
      (do
        (for-each (out outs)
          (match (map-get out i)
            ((some a)
              (do
                (when (not (. a complete)) (set! (. r complete) false))
                (list-push (. r answers) (copy-answer arena a))))
            ((none) (do))))
        r)))

  (fn collect-answers ((arena Arena) (classes (List KName)) (shared (Map Int ClassAnswer))
                       (outs (List (Map Int ClassAnswer))) (complete0 Bool))
    (@intent "Every class's answer in class order, the unsafe ones copied out of their worker arenas")
    (@spec ((Arena (List KName) (Map Int ClassAnswer) (List (Map Int ClassAnswer)) Bool) -> QAnswers))
    (@alloc arena)
    (let ((mut qa (record-new QAnswers (answers (list-new arena ClassAnswer)) (complete complete0)))
          (mut i 0))
      (do
        (for-each (q classes)
          (do
            (match (map-get shared i)
              ((some a) (list-push (. qa answers) a))
              ((none)   (set! qa (copy-unsafe arena qa outs i))))
            (set! i (+ i 1))))
        qa)))

  (fn over-w-result ((g RunResult) (w RunResult) (thing-answer ClassAnswer) (qa QAnswers) (jobs Int))
    (@intent "Phase Q's KscResult: the rounds are G's, W's and the longest class run's")
    (@spec ((RunResult RunResult ClassAnswer QAnswers Int) -> KscResult))
    (let ((qrounds (if (> (. thing-answer rounds) (max-rounds (. qa answers)))
                     (. thing-answer rounds)
                     (max-rounds (. qa answers))))
          (total (+ (. g rounds) (+ (. w rounds) qrounds))))
      (record-new KscResult
        (inconsistent (. thing-answer unsat))
        (termination  (if (. qa complete)
                        (union-new Termination fixpoint)
                        (union-new Termination resource-limit total)))
        (rounds       total)
        (g-rounds     (. g rounds))
        (g-facts      (. g facts))
        (w-rounds     (. w rounds))
        (w-facts      (. w facts))
        (unsafe-count jobs)
        (answers      (. qa answers)))))

  (fn answer-over-w ((arena Arena) (idx KscIndex) (g RunResult) (w RunResult) (base Base)
                     (thing-answer ClassAnswer) (classes (List KName)) (budget Int) (workers Int) (cancel I64))
    (@intent "Every class answered over G ∪ W: the safe ones from W, the unsafe ones in runs of their own")
    (@spec ((Arena KscIndex RunResult RunResult Base ClassAnswer (List KName) Int Int I64) -> (Result KscResult Fault)))
    (@alloc arena)
    (let ((shared (map-new arena Int ClassAnswer))
          (todo (split-safe arena base classes shared))
          (runs (run-unsafe arena idx base budget cancel classes todo workers))
          (qa (collect-answers arena classes shared (. runs outs) (. thing-answer complete))))
      (do
        (for-each (wa (. runs was)) (arena-free wa))
        (if (> (. runs cancelled) 0)
          (error (union-new Fault cancelled))
          (ok (over-w-result g w thing-answer qa (cast Int (list-len todo))))))))

  (fn classify-over-w ((arena Arena) (idx KscIndex) (g RunResult) (w RunResult) (tainted (List KElem))
                       (thing KName) (classes (List KName)) (budget Int) (workers Int) (cancel I64))
    (@intent "With G and W complete: mark safety and ⊥-reach, then answer every class (K6); a Fault if cancelled")
    (@spec ((Arena KscIndex RunResult RunResult (List KElem) KName (List KName) Int Int I64) -> (Result KscResult Fault)))
    (@alloc arena)
    ;; PHASE Q IN PARALLEL. A safe class is answered from W here, inline:
    ;; it is a lookup. The unsafe ones are split into contiguous chunks of
    ;; the canonical class order, each run by one thread into an arena of
    ;; its own, and the answers are copied back in class order. Every run
    ;; is a deterministic set computation over a base no one writes, so
    ;; the report is the same at every worker count (§6.8).
    (let ((base (over-w-base arena g w tainted)))
      (match (class-answer arena idx base false budget cancel thing)
        ((none) (error (union-new Fault cancelled)))
        ((some thing-answer)
          (answer-over-w arena idx g w base thing-answer classes budget workers cancel)))))

  (fn max-rounds ((answers (List ClassAnswer)))
    (@intent "The most rounds any single class's run took")
    (@spec (((List ClassAnswer)) -> Int))
    (let ((mut m 0))
      (do
        (for-each (a answers) (when (> (. a rounds) m) (set! m (. a rounds))))
        m)))

  (fn answer-holds ((a ClassAnswer) (b KName))
    (@intent "K5's holds(A, B): unsat(A), or inst(A, B) in A's run")
    (@spec ((ClassAnswer KName) -> Bool))
    (if (. a unsat)
      true
      (let ((mut found false))
        (do
          (for-each (n (. a subsumers))
            (when (kname-eq n b) (set! found true)))
          found))))

  (fn input-classes ((arena Arena) (sig Signature))
    (@intent "The classes the report asks about: the input signature's, in canonical order")
    (@spec ((Arena Signature) -> (List KName)))
    (@alloc arena)
    (let ((mut out (list-new arena KName)))
      (do
        (for-each (c (sort-iris arena (set-elements (. sig classes))))
          (list-push out (union-new KName k-class c)))
        out)))
)
