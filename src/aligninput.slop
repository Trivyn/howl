;; Alignment inputs retain logical occurrence ownership before any rewriting.
;; The encoded dictionary must outlive AlignmentBase and its subset decodes.
(module aligninput
  (import rdf (IRI Triple))
  (import termstore (Encoded IdTriple triple-of))
  (import types (AxiomRef Fault Omission Node RoleId))
  (import owl2 (RawAxiom RawConcept RawClassAssertion RawDisjointUnion Signature
                render-axiom render-concept concept-cmp sort-concepts))
  (import decode (Stage0 Stage1 stage0-encoded decode-axioms-sourced decode-axioms-positioned alignment-scaffolds alignment-negative-roots box-concept term-iri-value))
  (import normalize (Decoded))
  (import vocab (OWL_SOURCE_INDIVIDUAL OWL_ASSERTION_PROPERTY OWL_TARGET_INDIVIDUAL OWL_TARGET_VALUE))
  (import canon (string-cmp iri-cmp axiom-ref-cmp sort-axiom-refs sort-nodes role-cmp sort-range))
  (export AlignmentBase alignment-base subset-decoded canonical-mapping-axiom source-iri-valid)
  (import strlib (char-at))
  (import types (copy-iri))

  (type AlignmentBase (record
    (stage Stage0)
    (signature Signature)
    (documents Int)
    (mappings (List AxiomRef))
    (anchors (Map Int Int)) ; stage-0 triple position -> canonical mapping index
    (scaffolds (List Bool))
    (negative-roots (Map Int Int))
    (negative-parts (List Bool))
    (owned (Set Int))))

  (fn int-at ((xs (List Int)) (i Int))
    (@spec (((List Int) Int) -> Int))
    (match (list-get xs i) ((some n) n) ((none) -1)))

  (fn bool-at ((xs (List Bool)) (i Int))
    (@spec (((List Bool) Int) -> Bool))
    (match (list-get xs i) ((some b) b) ((none) false)))

  (fn copy-axiom-ref ((arena Arena) (r AxiomRef))
    (@spec ((Arena AxiomRef) -> AxiomRef))
    (record-new AxiomRef
      (source (match (. r source) ((some s) (some (copy-iri arena s))) ((none) (none))))
      (text (string-concat arena "" (. r text)))))

  (fn ref-key ((arena Arena) (r AxiomRef))
    (@spec ((Arena AxiomRef) -> String))
    (string-concat arena (match (. r source) ((some s) (. s value)) ((none) ""))
      (string-concat arena "\n" (. r text))))

  (fn concept-usable ((c RawConcept))
    (@intent "Only fully decoded OWL expressions have a removable OWL axiom identity")
    (@spec ((RawConcept) -> Bool))
    (match c
      ((rc-data _) false) ((rc-anon _) false)
      ((rc-and cs) (concepts-usable cs)) ((rc-or cs) (concepts-usable cs))
      ((rc-not f) (concept-usable (deref f)))
      ((rc-some _ f) (concept-usable (deref f)))
      ((rc-all _ f) (concept-usable (deref f)))
      ((rc-qcard _ _ _ f) (concept-usable (deref f)))
      (_ true)))

  (fn concepts-usable ((cs (List RawConcept)))
    (@spec (((List RawConcept)) -> Bool))
    (let ((mut yes true))
      (do (for-each (c cs) (when (not (concept-usable c)) (set! yes false))) yes)))

  (fn canonical-concept ((arena Arena) (c RawConcept))
    (@spec ((Arena RawConcept) -> RawConcept))
    (match c
      ((rc-and cs) (union-new RawConcept rc-and (canonical-concepts arena cs true true)))
      ((rc-or cs) (union-new RawConcept rc-or (canonical-concepts arena cs true false)))
      ((rc-not f) (union-new RawConcept rc-not (box-concept arena (canonical-concept arena (deref f)))))
      ((rc-some r f) (union-new RawConcept rc-some r (box-concept arena (canonical-concept arena (deref f)))))
      ((rc-all r f) (union-new RawConcept rc-all r (box-concept arena (canonical-concept arena (deref f)))))
      ((rc-qcard k r n f) (union-new RawConcept rc-qcard k r n (box-concept arena (canonical-concept arena (deref f)))))
      ((rc-oneof ns) (union-new RawConcept rc-oneof (sort-nodes arena ns)))
      (_ c)))

  (fn append-operands ((arena Arena) (cs (List RawConcept)) (flatten Bool) (conjunction Bool))
    (@spec ((Arena (List RawConcept) Bool Bool) -> (List RawConcept)))
    (let ((out (list-new arena RawConcept)))
      (do
        (for-each (c cs)
          (match c
            ((rc-and inner)
              (if (and flatten conjunction)
                (for-each (v (append-operands arena inner flatten conjunction)) (list-push out v))
                (list-push out (canonical-concept arena c))))
            ((rc-or inner)
              (if (and flatten (not conjunction))
                (for-each (v (append-operands arena inner flatten conjunction)) (list-push out v))
                (list-push out (canonical-concept arena c))))
            (_ (list-push out (canonical-concept arena c)))))
        out)))

  (fn role-at ((rs (List RoleId)) (i Int))
    (@spec (((List RoleId) Int) -> RoleId))
    (match (list-get rs i) ((some r) r) ((none) (union-new RoleId fresh-role 0))))

  (fn sort-roles ((arena Arena) (rs (List RoleId)))
    (@spec ((Arena (List RoleId)) -> (List RoleId)))
    (let ((indices (sort-range arena (cast Int (list-len rs))
                    (fn ((i Int) (j Int)) (role-cmp (role-at rs i) (role-at rs j)))))
          (out (list-new arena RoleId)))
      (do (for-each (i indices) (list-push out (role-at rs i))) out)))

  (fn canonical-concepts ((arena Arena) (cs (List RawConcept)) (flatten Bool) (conjunction Bool))
    (@spec ((Arena (List RawConcept) Bool Bool) -> (List RawConcept)))
    (let ((parts (append-operands arena cs flatten conjunction)) (out (list-new arena RawConcept))
          (mut previous (Option RawConcept) (none)))
      (do
        (for-each (c (sort-concepts arena parts))
          (when (or (not flatten) (match previous ((none) true) ((some p) (!= (concept-cmp p c) 0))))
            (do (list-push out c) (set! previous (some c)))))
        out)))

  (fn canonical-mapping-axiom ((arena Arena) (ax RawAxiom))
    (@intent "An original logical axiom with canonical operands, or none for declarations and opaque RDF")
    (@spec ((Arena RawAxiom) -> (Option RawAxiom)))
    (match ax
      ((ra-sub-class-of l r)
        (if (and (concept-usable (deref l)) (concept-usable (deref r)))
          (some (union-new RawAxiom ra-sub-class-of (box-concept arena (canonical-concept arena (deref l)))
                                                     (box-concept arena (canonical-concept arena (deref r))))) (none)))
      ((ra-equivalent-classes cs)
        (if (concepts-usable cs) (some (union-new RawAxiom ra-equivalent-classes (canonical-concepts arena cs false false))) (none)))
      ((ra-disjoint-classes cs)
        (if (concepts-usable cs) (some (union-new RawAxiom ra-disjoint-classes (canonical-concepts arena cs false false))) (none)))
      ((ra-object-property-domain r c)
        (if (concept-usable (deref c)) (some (union-new RawAxiom ra-object-property-domain r (box-concept arena (canonical-concept arena (deref c))))) (none)))
      ((ra-object-property-range r c)
        (if (concept-usable (deref c)) (some (union-new RawAxiom ra-object-property-range r (box-concept arena (canonical-concept arena (deref c))))) (none)))
      ((ra-class-assertion ca)
        (if (concept-usable (deref (. ca concept)))
          (some (union-new RawAxiom ra-class-assertion (record-new RawClassAssertion
            (subject (. ca subject)) (concept (box-concept arena (canonical-concept arena (deref (. ca concept)))))))) (none)))
      ((ra-disjoint-union du)
        (if (concepts-usable (. du members))
          (some (union-new RawAxiom ra-disjoint-union (record-new RawDisjointUnion
            (class (. du class)) (members (canonical-concepts arena (. du members) false false))))) (none)))
      ((ra-equivalent-properties rs) (some (union-new RawAxiom ra-equivalent-properties (sort-roles arena rs))))
      ((ra-disjoint-properties rs) (some (union-new RawAxiom ra-disjoint-properties (sort-roles arena rs))))
      ((ra-same-individual ns) (some (union-new RawAxiom ra-same-individual (sort-nodes arena ns))))
      ((ra-different-individuals ns) (some (union-new RawAxiom ra-different-individuals (sort-nodes arena ns))))
      ((ra-inverse-properties a b)
        (let ((rs (sort-roles arena (list RoleId a b))))
          (some (union-new RawAxiom ra-inverse-properties
            (match (list-get rs 0) ((some r) r) ((none) a))
            (match (list-get rs 1) ((some r) r) ((none) b))))))
      ((ra-sub-object-property _ _) (some ax)) ((ra-property-chain _) (some ax))
      ((ra-transitive-property _) (some ax)) ((ra-object-property-assertion _) (some ax))
      ((ra-property-characteristic _ _) (some ax)) ((ra-negative-assertion _) (some ax))
      (_ (none))))

  (fn ascii-letter ((c Int))
    (@spec ((Int) -> Bool))
    (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))))

  (fn source-iri-valid ((s String))
    (@intent "An absolute source IRI: scheme syntax and no whitespace, controls or IRIREF delimiters")
    (@spec ((String) -> Bool))
    (let ((mut ok (> (string-len s) 0)) (mut colon false) (mut i 0))
      (do
        (while (< i (string-len s))
          (let ((c (cast Int (char-at s i))))
            (do
              (when (or (<= c 32) (== c 127) (== c 60) (== c 62) (== c 34)
                        (== c 123) (== c 125) (== c 124) (== c 92) (== c 94) (== c 96))
                (set! ok false))
              (when (not colon)
                (if (== c 58)
                  (do (when (== i 0) (set! ok false)) (set! colon true))
                  (when (not (or (ascii-letter c)
                                 (and (> i 0) (or (and (>= c 48) (<= c 57)) (== c 43) (== c 45) (== c 46)))))
                    (set! ok false))))
              (set! i (+ i 1)))))
        (and ok colon))))

  (fn metadata-problem ((sources (List IRI)) (mapping-docs (List Bool)) (documents Int))
    (@spec (((List IRI) (List Bool) Int) -> Bool))
    (let ((mut bad (or (!= (list-len sources) documents) (!= (list-len mapping-docs) documents)))
          (mut i 0))
      (do
        (for-each (s sources)
          (do
            (when (not (source-iri-valid (. s value))) (set! bad true))
            (let ((mut j 0))
              (for-each (t sources)
                (do (when (and (< j i) (== (iri-cmp s t) 0)) (set! bad true)) (set! j (+ j 1)))))
            (set! i (+ i 1))))
        bad)))

  (fn alignment-base ((arena Arena) (doc Encoded) (imports (List IRI))
                      (sources (List IRI)) (mapping-docs (List Bool)))
    (@spec ((Arena Encoded (List IRI) (List IRI) (List Bool)) -> (Result AlignmentBase Fault)))
    (if (metadata-problem sources mapping-docs (cast Int (list-len (. doc starts))))
      (error (union-new Fault input-error "Alignment documents need unique nonempty source IRIs and a role each"))
      (match (stage0-encoded arena doc imports)
        ((error f) (error f))
        ((ok stage)
          (match (decode-axioms-positioned arena (. stage dict) (. stage triples) (. stage docs))
            ((error f) (error f))
            ((ok decoded) (ok (inventory arena stage decoded sources mapping-docs))))))))

  (fn inventory ((arena Arena) (stage Stage0) (decoded Stage1) (sources (List IRI)) (mapping-docs (List Bool)))
    (@spec ((Arena Stage0 Stage1 (List IRI) (List Bool)) -> AlignmentBase))
    (let ((refs (list-new arena AxiomRef)) (positions (list-new arena Int))
          (by-key (map-new arena String Int)) (anchors (map-new arena Int Int))
          (mappings (list-new arena AxiomRef)) (negative-roots (alignment-negative-roots arena (. stage dict) (. stage triples))) (mut i 0))
      (do
        (for-each (ax (. decoded axioms))
          (let ((d (if (== (list-len sources) 1) 0 (int-at (. decoded axiom-docs) i))))
            (do
              (when (bool-at mapping-docs d)
                (match (canonical-mapping-axiom arena ax)
                  ((none) (do))
                  ((some ca)
                    (match (list-get sources d)
                      ((none) (do))
                      ((some source)
                        (do (list-push refs (record-new AxiomRef (source (some source)) (text (render-axiom arena ca))))
                            (list-push positions (int-at (. decoded axiom-positions) i))))))))
              (set! i (+ i 1)))))
        (for-each (r (sort-axiom-refs arena refs))
          (let ((key (ref-key arena r)))
            (when (not (map-has by-key key))
              (do (map-put by-key key (cast Int (list-len mappings))) (list-push mappings (copy-axiom-ref arena r))))))
        (set! i 0)
        (for-each (r refs)
          (do
            (match (map-get by-key (ref-key arena r))
              ((some k) (map-put anchors (int-at positions i) k)) ((none) (do)))
            (set! i (+ i 1))))
        (let ((scaffolds (alignment-scaffolds arena (. stage dict) (. stage triples)))
              (negative-parts (list-new arena Bool)))
          (do
            (for-each (t (. stage triples)) (list-push negative-parts (negative-part (triple-of (. stage dict) t))))
          (record-new AlignmentBase (stage stage) (signature (. decoded signature))
            (documents (cast Int (list-len sources))) (mappings mappings) (anchors anchors)
            (scaffolds scaffolds) (negative-roots negative-roots) (negative-parts negative-parts)
            (owned (reachable arena (. stage triples) scaffolds anchors (set-new arena Int)
                               negative-roots negative-parts))))))))

  (fn negative-part ((t Triple))
    (@spec ((Triple) -> Bool))
    (match (term-iri-value (. t predicate))
      ((none) false)
      ((some p) (or (== (string-cmp (. p value) OWL_SOURCE_INDIVIDUAL) 0)
                    (== (string-cmp (. p value) OWL_ASSERTION_PROPERTY) 0)
                    (== (string-cmp (. p value) OWL_TARGET_INDIVIDUAL) 0)
                    (== (string-cmp (. p value) OWL_TARGET_VALUE) 0)))))

  (fn live-negative ((arena Arena) (triples (List IdTriple)) (anchors (Map Int Int))
                      (removed (Set Int)) (roots (Map Int Int)))
    (@spec ((Arena (List IdTriple) (Map Int Int) (Set Int) (Map Int Int)) -> (Set Int)))
    (let ((out (set-new arena Int)) (mut i 0))
      (do
        (for-each (t triples)
          (do
            (when (not (match (map-get anchors i) ((some k) (set-has removed k)) ((none) false)))
              (match (map-get roots i) ((some n) (set-put out n)) ((none) (do))))
            (set! i (+ i 1))))
        out)))

  (fn reachable ((arena Arena) (triples (List IdTriple)) (scaffolds (List Bool))
                 (anchors (Map Int Int)) (removed (Set Int))
                 (negative-roots (Map Int Int)) (negative-parts (List Bool)))
    (@intent "Structural nodes referenced by surviving axiom roots, including fixed and opaque roots")
    (@spec ((Arena (List IdTriple) (List Bool) (Map Int Int) (Set Int) (Map Int Int) (List Bool)) -> (Set Int)))
    (let ((nodes (set-new arena Int))
          (negative-live (live-negative arena triples anchors removed negative-roots)) (mut i 0) (mut changed true))
      (do
        (for-each (t triples)
          (do
            (when (and (not (bool-at scaffolds i))
                       (not (match (map-get anchors i) ((some k) (set-has removed k)) ((none) false))))
              (do (set-put nodes (. t s)) (set-put nodes (. t o))))
            (set! i (+ i 1))))
        (while changed
          (do
            (set! changed false) (set! i 0)
            (for-each (t triples)
              (do
                (when (and (bool-at scaffolds i) (set-has nodes (. t s)) (not (set-has nodes (. t o)))
                           (or (not (bool-at negative-parts i)) (set-has negative-live (. t s))))
                  (do (set-put nodes (. t o)) (set! changed true)))
                (set! i (+ i 1))))))
        nodes)))

  (fn subset-decoded ((arena Arena) (base AlignmentBase) (removed (List Int)))
    (@spec ((Arena AlignmentBase (List Int)) -> (Result Decoded Fault)))
    (let ((gone (set-new arena Int)) (mut invalid false))
      (do
        (for-each (k removed)
          (if (or (< k 0) (>= k (list-len (. base mappings)))) (set! invalid true) (set-put gone k)))
        (if invalid (error (union-new Fault input-error "Alignment removal index outside mapping inventory"))
          (subset-with arena base gone)))))

  (fn subset-with ((arena Arena) (base AlignmentBase) (gone (Set Int)))
    (@spec ((Arena AlignmentBase (Set Int)) -> (Result Decoded Fault)))
    (let ((s0 (. base stage))
          (live (reachable arena (. s0 triples) (. base scaffolds) (. base anchors) gone
                           (. base negative-roots) (. base negative-parts)))
          (negative-live (live-negative arena (. s0 triples) (. base anchors) gone (. base negative-roots)))
          (triples (list-new arena IdTriple)) (docs (list-new arena Int)) (mut i 0))
      (do
        (for-each (t (. s0 triples))
          (do
            (when (and (not (match (map-get (. base anchors) i) ((some k) (set-has gone k)) ((none) false)))
                       (or (not (bool-at (. base scaffolds) i))
                           (and (or (not (bool-at (. base negative-parts) i)) (set-has negative-live (. t s)))
                                (or (not (set-has (. base owned) (. t s))) (set-has live (. t s))))))
              (do (list-push triples t)
                  (when (> (. base documents) 1) (list-push docs (int-at (. s0 docs) i)))))
            (set! i (+ i 1))))
        ;; Recompute the data lemma, declared-property decoding and omissions
        ;; over the subset. Every declaration and source import remains fixed.
        (match (decode-axioms-sourced arena (. s0 dict) triples docs)
          ((error f) (error f))
          ((ok d)
            (let ((oms (list-new arena Omission)) (origins (list-new arena Int)))
              (do
                (for-each (o (. s0 omissions)) (list-push oms o))
                (for-each (o (. d omitted)) (list-push oms o))
                (for-each (k (. s0 omission-docs)) (list-push origins k))
                (for-each (k (. d omission-docs)) (list-push origins k))
                (ok (record-new Decoded (axioms (. d axioms)) (signature (. base signature))
                  (omissions oms) (documents (. base documents))
                  (axiom-docs (. d axiom-docs)) (omission-docs origins))))))))))
)
