;; ============================================================
;; sriq's normaliser: S0, the collapse, and S1's hook  —  SPEC.md §5.5
;;
;; S0 translates the sriq gate's accepted axioms into the SROIQ working
;; form (sroiq.slop), row by row as §5.5's language table reads. Every
;; RawAxiom and RawConcept variant is named, with no catch-all: a variant
;; the gate does not admit under sriq is an error here, never a silent
;; drop.
;;
;; THE COLLAPSE (S0) replaces every role by its component's
;; representative, from the same RBox analysis the gate ran
;; (sriqrbox.slop), drops the `R ⊑ R` it leaves, and keeps one `P⁻ ⊑ P`
;; for a component that holds both P and P⁻.
;;
;; S1 IS SLICE 6. Until it is built, an input with a complex role
;; inclusion (transitivity included) is refused with that reason, rather
;; than normalised wrongly (§5.5's status note).
;; ============================================================

(module sriqnormal
  (@doc "sriq's normaliser: S0, the collapse, and S1's hook (SPEC 5.5)")

  (import rdf (IRI))
  (import vocab (OWL_BOTTOM_OBJECT_PROPERTY))
  (import types (RoleId Node DName DRole Dl1 Dl2 Dl4 DlClause))
  (import owl2 (RawAxiom RawConcept RawChain RawEdge RawClassAssertion RawDisjointUnion
                PropCharacteristic CardKind SRIQ_MAX_COUNT))
  (import canon (iri-cmp string-cmp sort-range))
  (import sroiq (SConcept SAxiom SRia sc-canon sc-cmp sort-saxioms dedupe-saxioms inv-role box-sc
                 render-saxiom render-sconcept sc-key))
  (import naming (Registry new-registry fresh-id fresh-role-id mark-neg mark-pos
                  neg-defined pos-defined))
  (import sriqrbox (SriqRbox sriq-rbox sriq-node node-role))

  (export S0 sriq-s0 sriq-s1 S2 sriq-s2 render-dl)

  ;; S0's output, with the RBox analysis S1 will need.
  (type S0 (record
    (axioms (List SAxiom))
    (rbox   SriqRbox)))

  ;; ============================================================
  ;; Concepts
  ;; ============================================================

  (fn sc ((arena Arena) (c SConcept))
    (@intent "c, boxed")
    (@spec ((Arena SConcept) -> (Ptr SConcept)))
    (@alloc arena)
    (box-sc arena c))

  (fn s0-concepts ((arena Arena) (cs (List RawConcept)))
    (@intent "S0 over a list of concepts")
    (@spec ((Arena (List RawConcept)) -> (Result (List SConcept) String)))
    (@alloc arena)
    (let ((mut out (list-new arena SConcept))
          (mut fault (Option String) (none)))
      (do
        (for-each (c cs)
          (match (s0-concept arena c)
            ((ok x)    (list-push out x))
            ((error m) (set! fault (some m)))))
        (match fault
          ((some m) (error m))
          ((none)   (ok out))))))

  (fn s0-filler ((arena Arena) (f (Ptr RawConcept)))
    (@intent "S0 of a boxed filler")
    (@spec ((Arena (Ptr RawConcept)) -> (Result SConcept String)))
    (@alloc arena)
    (s0-concept arena (deref f)))

  (fn s0-count ((arena Arena) (k CardKind) (r RoleId) (n (Int 0 ..)) (f SConcept))
    (@intent "A number restriction: ≥n, ≤n, or =n as ≥n ⊓ ≤n (§5.5 S2 choice 7)")
    (@spec ((Arena CardKind RoleId (Int 0 ..) SConcept) -> SConcept))
    (@alloc arena)
    (match k
      ('card-min   (union-new SConcept sc-atleast n r (sc arena f)))
      ('card-max   (union-new SConcept sc-atmost n r (sc arena f)))
      ('card-exact
        (let ((mut both (list-new arena SConcept)))
          (do
            (list-push both (union-new SConcept sc-atleast n r (sc arena f)))
            (list-push both (union-new SConcept sc-atmost n r (sc arena f)))
            (union-new SConcept sc-and both))))))

  (fn s0-concept ((arena Arena) (c RawConcept))
    (@intent "§5.5's language table, on a class expression the sriq gate admitted")
    (@spec ((Arena RawConcept) -> (Result SConcept String)))
    (@alloc arena)
    (match c
      ((rc-name n)
        (match n
          ((class-node i)      (ok (union-new SConcept sc-name i)))
          ((individual-node _) (error "an individual in a class position"))
          ((fresh-node _)      (error "a fresh node in a class position"))))
      ((rc-thing)   (ok (union-new SConcept sc-top)))
      ((rc-nothing) (ok (union-new SConcept sc-bottom)))
      ((rc-and cs)
        (match (s0-concepts arena cs)
          ((ok xs)   (ok (union-new SConcept sc-and xs)))
          ((error m) (error m))))
      ((rc-or cs)
        (match (s0-concepts arena cs)
          ((ok xs)   (ok (union-new SConcept sc-or xs)))
          ((error m) (error m))))
      ((rc-not f)
        (match (s0-filler arena f)
          ((ok x)    (ok (union-new SConcept sc-not (sc arena x))))
          ((error m) (error m))))
      ((rc-some r f)
        (match (s0-filler arena f)
          ((ok x)    (ok (union-new SConcept sc-some r (sc arena x))))
          ((error m) (error m))))
      ((rc-all r f)
        (match (s0-filler arena f)
          ((ok x)    (ok (union-new SConcept sc-all r (sc arena x))))
          ((error m) (error m))))
      ;; Unqualified is qualified by ⊤ (§5.5 S2 choice 7).
      ((rc-card k r n)    (ok (s0-count arena k r n (union-new SConcept sc-top))))
      ((rc-qcard k r n f)
        (match (s0-filler arena f)
          ((ok x)    (ok (s0-count arena k r n x)))
          ((error m) (error m))))
      ((rc-has-self r)    (ok (union-new SConcept sc-self r)))
      ;; Class nominals are sroiq's, data is a non-goal, and an anonymous
      ;; class is undecodable: the sriq gate admits none of them.
      ((rc-oneof _)       (error "ObjectOneOf, which the sriq gate does not admit"))
      ((rc-has-value _ _) (error "ObjectHasValue, which the sriq gate does not admit"))
      ((rc-data _)        (error "a data range, which the sriq gate does not admit"))
      ((rc-anon _)        (error "an undecodable class, which the sriq gate does not admit"))))

  ;; ============================================================
  ;; Axioms: §5.5's language table, row by row
  ;; ============================================================

  (fn gci ((arena Arena) (l SConcept) (r SConcept))
    (@intent "l ⊑ r")
    (@spec ((Arena SConcept SConcept) -> SAxiom))
    (@alloc arena)
    (union-new SAxiom sa-gci (sc arena l) (sc arena r)))

  (fn ria ((arena Arena) (w (List RoleId)) (s RoleId))
    (@intent "w ⊑ s")
    (@spec ((Arena (List RoleId) RoleId) -> SAxiom))
    (@alloc arena)
    (union-new SAxiom sa-ria (record-new SRia (word w) (super s))))

  (fn ria1 ((arena Arena) (r RoleId) (s RoleId))
    (@intent "r ⊑ s")
    (@spec ((Arena RoleId RoleId) -> SAxiom))
    (@alloc arena)
    (let ((mut w (list-new arena RoleId)))
      (do (list-push w r) (ria arena w s))))

  (fn nominal ((n Node))
    (@intent "{a} for an individual, else none")
    (@spec ((Node) -> (Option SConcept)))
    (@pure)
    (match n
      ((individual-node i) (some (union-new SConcept sc-nominal i)))
      ((class-node _)      (none))
      ((fresh-node _)      (none))))

  (fn least-individual ((ns (List Node)))
    (@intent "The canonically least individual of a list (§5.5 S2 choice 10)")
    (@spec (((List Node)) -> (Option IRI)))
    (@pure)
    (let ((mut best (Option IRI) (none)))
      (do
        (for-each (n ns)
          (match n
            ((individual-node i)
              (match best
                ((none)   (set! best (some i)))
                ((some b) (when (< (iri-cmp i b) 0) (set! best (some i))))))
            (_ (do))))
        best)))

  (fn top-sc ()
    (@intent "⊤")
    (@spec (() -> SConcept))
    (@pure)
    (union-new SConcept sc-top))

  ;; ------------------------------------------------------------
  ;; S0's rows. Each returns its own list, so no row pushes into a list
  ;; it was passed (which would grow a copy and lose it).
  ;; ------------------------------------------------------------

  (fn one-axiom ((arena Arena) (a SAxiom))
    (@intent "[a]")
    (@spec ((Arena SAxiom) -> (List SAxiom)))
    (@alloc arena)
    (let ((mut xs (list-new arena SAxiom))) (do (list-push xs a) xs)))

  (fn two-axioms ((arena Arena) (a SAxiom) (b SAxiom))
    (@intent "[a, b]")
    (@spec ((Arena SAxiom SAxiom) -> (List SAxiom)))
    (@alloc arena)
    (let ((mut xs (list-new arena SAxiom))) (do (list-push xs a) (list-push xs b) xs)))

  (fn meet-empty ((arena Arena) (a SConcept) (b SConcept))
    (@intent "a ⊓ b ⊑ ⊥")
    (@spec ((Arena SConcept SConcept) -> SAxiom))
    (@alloc arena)
    (let ((mut ab (list-new arena SConcept)))
      (do (list-push ab a)
          (list-push ab b)
          (gci arena (union-new SConcept sc-and ab) (union-new SConcept sc-bottom)))))

  (fn pairwise-disjoint ((arena Arena) (xs (List SConcept)))
    (@intent "Xᵢ ⊓ Xⱼ ⊑ ⊥ for each pair i < j")
    (@spec ((Arena (List SConcept)) -> (List SAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena SAxiom))
          (mut i 0))
      (do
        (for-each (a xs)
          (let ((mut j 0))
            (do
              (for-each (b xs)
                (do (when (< i j) (list-push out (meet-empty arena a b)))
                    (set! j (+ j 1))))
              (set! i (+ i 1)))))
        out)))

  (fn pairwise-dis ((arena Arena) (rs (List RoleId)))
    (@intent "Dis(Rᵢ, Rⱼ) for each pair i < j")
    (@spec ((Arena (List RoleId)) -> (List SAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena SAxiom))
          (mut i 0))
      (do
        (for-each (a rs)
          (let ((mut j 0))
            (do
              (for-each (b rs)
                (do (when (< i j) (list-push out (union-new SAxiom sa-dis a b)))
                    (set! j (+ j 1))))
              (set! i (+ i 1)))))
        out)))

  (fn mutual-gcis ((arena Arena) (xs (List SConcept)))
    (@intent "Xᵢ ⊑ Xⱼ for every ordered pair of distinct members")
    (@spec ((Arena (List SConcept)) -> (List SAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena SAxiom)))
      (do
        (for-each (a xs)
          (for-each (b xs)
            (when (!= (sc-cmp a b) 0) (list-push out (gci arena a b)))))
        out)))

  (fn mutual-rias ((arena Arena) (rs (List RoleId)))
    (@intent "Rᵢ ⊑ Rⱼ for every ordered pair")
    (@spec ((Arena (List RoleId)) -> (List SAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena SAxiom)))
      (do
        (for-each (a rs) (for-each (b rs) (list-push out (ria1 arena a b))))
        out)))

  (fn around-hub ((arena Arena) (hub SConcept) (xs (List SConcept)))
    (@intent "hub ⊑ x and x ⊑ hub for each member x but the hub itself")
    (@spec ((Arena SConcept (List SConcept)) -> (List SAxiom)))
    (@alloc arena)
    (let ((mut out (list-new arena SAxiom)))
      (do
        (for-each (x xs)
          (when (!= (sc-cmp x hub) 0)
            (do (list-push out (gci arena hub x))
                (list-push out (gci arena x hub)))))
        out)))

  (fn s0-nominals ((arena Arena) (ns (List Node)) (what String))
    (@intent "{a} for each member; an error naming the axiom if one is not an individual")
    (@spec ((Arena (List Node) String) -> (Result (List SConcept) String)))
    (@alloc arena)
    (let ((mut out (list-new arena SConcept))
          (mut fault (Option String) (none)))
      (do
        (for-each (n ns)
          (match (nominal n)
            ((some x) (list-push out x))
            ((none)   (set! fault (some (string-concat arena what " with a non-individual"))))))
        (match fault
          ((some m) (error m))
          ((none)   (ok out))))))

  (fn transitivity ((arena Arena) (r RoleId))
    (@intent "Trans(R): R ∘ R ⊑ R")
    (@spec ((Arena RoleId) -> SAxiom))
    (@alloc arena)
    (let ((mut w (list-new arena RoleId)))
      (do (list-push w r) (list-push w r) (ria arena w r))))

  (fn characteristic ((arena Arena) (c PropCharacteristic) (r RoleId))
    (@intent "A property characteristic as its one S0 axiom")
    (@spec ((Arena PropCharacteristic RoleId) -> SAxiom))
    (@alloc arena)
    (match c
      ;; ⊤ ⊑ ≤1 R.⊤, and ≤1 R⁻.⊤.
      ('prop-functional
        (gci arena (top-sc) (union-new SConcept sc-atmost 1 r (sc arena (top-sc)))))
      ('prop-inverse-functional
        (gci arena (top-sc) (union-new SConcept sc-atmost 1 (inv-role r) (sc arena (top-sc)))))
      ;; R⁻ ⊑ R.
      ('prop-symmetric   (ria1 arena (inv-role r) r))
      ;; Dis(R, R⁻).
      ('prop-asymmetric  (union-new SAxiom sa-dis r (inv-role r)))
      ('prop-reflexive   (union-new SAxiom sa-ref r))
      ('prop-irreflexive (union-new SAxiom sa-irr r))))

  (fn s0-sub-class ((arena Arena) (l (Ptr RawConcept)) (r (Ptr RawConcept)))
    (@intent "C ⊑ D")
    (@spec ((Arena (Ptr RawConcept) (Ptr RawConcept)) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (s0-filler arena l)
      ((error m) (error m))
      ((ok lx)
        (match (s0-filler arena r)
          ((error m) (error m))
          ((ok rx)   (ok (one-axiom arena (gci arena lx rx))))))))

  (fn s0-equivalent-classes ((arena Arena) (cs (List RawConcept)))
    (@intent "EquivalentClasses: each member below each other")
    (@spec ((Arena (List RawConcept)) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (s0-concepts arena cs)
      ((error m) (error m))
      ((ok xs)   (ok (mutual-gcis arena xs)))))

  (fn s0-disjoint-classes ((arena Arena) (cs (List RawConcept)))
    (@intent "DisjointClasses: each pair's meet is empty")
    (@spec ((Arena (List RawConcept)) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (s0-concepts arena cs)
      ((error m) (error m))
      ((ok xs)   (ok (pairwise-disjoint arena xs)))))

  (fn s0-domain ((arena Arena) (r RoleId) (c (Ptr RawConcept)))
    (@intent "Domain: ∃R.⊤ ⊑ C")
    (@spec ((Arena RoleId (Ptr RawConcept)) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (s0-filler arena c)
      ((error m) (error m))
      ((ok cx)
        (ok (one-axiom arena (gci arena (union-new SConcept sc-some r (sc arena (top-sc))) cx))))))

  (fn s0-range ((arena Arena) (r RoleId) (c (Ptr RawConcept)))
    (@intent "Range: ⊤ ⊑ ∀R.C")
    (@spec ((Arena RoleId (Ptr RawConcept)) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (s0-filler arena c)
      ((error m) (error m))
      ((ok cx)
        (ok (one-axiom arena (gci arena (top-sc) (union-new SConcept sc-all r (sc arena cx))))))))

  (fn s0-class-assertion ((arena Arena) (ca RawClassAssertion))
    (@intent "ClassAssertion(C a): {a} ⊑ C")
    (@spec ((Arena RawClassAssertion) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (nominal (. ca subject))
      ((none) (error "a class assertion on a non-individual"))
      ((some a)
        (match (s0-filler arena (. ca concept))
          ((error m) (error m))
          ((ok cx)   (ok (one-axiom arena (gci arena a cx))))))))

  (fn edge-filler ((arena Arena) (r RoleId) (b SConcept) (negative Bool))
    (@intent "∃R.{b}, or ∀R.¬{b} for a negative assertion")
    (@spec ((Arena RoleId SConcept Bool) -> SConcept))
    (@alloc arena)
    (if negative
      (union-new SConcept sc-all r (sc arena (union-new SConcept sc-not (sc arena b))))
      (union-new SConcept sc-some r (sc arena b))))

  (fn s0-assertion ((arena Arena) (e RawEdge) (what String) (negative Bool))
    (@intent "ObjectPropertyAssertion(R a b): {a} ⊑ ∃R.{b}; the negative one: {a} ⊑ ∀R.¬{b}")
    (@spec ((Arena RawEdge String Bool) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (nominal (. e from))
      ((none) (error (string-concat arena what " from a non-individual")))
      ((some a)
        (match (nominal (. e to))
          ((none)   (error (string-concat arena what " to a non-individual")))
          ((some b) (ok (one-axiom arena (gci arena a (edge-filler arena (. e role) b negative)))))))))

  (fn s0-same-individual ((arena Arena) (ns (List Node)))
    (@intent "SameIndividual: each member equal to the canonically least one (§5.5 S2 choice 10)")
    (@spec ((Arena (List Node)) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (least-individual ns)
      ((none) (error "SameIndividual without an individual"))
      ((some h)
        (match (s0-nominals arena ns "SameIndividual")
          ((error m) (error m))
          ((ok xs)   (ok (around-hub arena (union-new SConcept sc-nominal h) xs)))))))

  (fn s0-different-individuals ((arena Arena) (ns (List Node)))
    (@intent "DifferentIndividuals: {aᵢ} ⊓ {aⱼ} ⊑ ⊥ for each pair")
    (@spec ((Arena (List Node)) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (s0-nominals arena ns "DifferentIndividuals")
      ((error m) (error m))
      ((ok xs)   (ok (pairwise-disjoint arena xs)))))

  (fn s0-disjoint-union ((arena Arena) (du RawDisjointUnion))
    (@intent "DisjointUnion(C D₁ … Dₙ): C ≡ D₁ ⊔ … ⊔ Dₙ, the Dᵢ pairwise disjoint")
    (@spec ((Arena RawDisjointUnion) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match (s0-concepts arena (. du members))
      ((error m) (error m))
      ((ok xs)
        (let ((c   (union-new SConcept sc-name (. du class)))
              (uni (union-new SConcept sc-or xs))
              (mut out (list-new arena SAxiom)))
          (do
            (list-push out (gci arena c uni))
            (list-push out (gci arena uni c))
            (for-each (a (pairwise-disjoint arena xs)) (list-push out a))
            (ok out))))))

  (fn s0-axiom ((arena Arena) (ax RawAxiom))
    (@intent "One accepted axiom as S0's axioms: one row per variant, as §5.5's table")
    (@spec ((Arena RawAxiom) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (match ax
      ((ra-sub-class-of l r)            (s0-sub-class arena l r))
      ;; EquivalentClasses reaches here as its star, from the gate's
      ;; expand-sugar; this row covers it whole regardless.
      ((ra-equivalent-classes cs)       (s0-equivalent-classes arena cs))
      ((ra-disjoint-classes cs)         (s0-disjoint-classes arena cs))
      ((ra-sub-object-property a b)     (ok (one-axiom arena (ria1 arena a b))))
      ((ra-property-chain ch)           (ok (one-axiom arena (ria arena (. ch steps) (. ch super)))))
      ;; Kept whole only with an inverse member (gate.slop): every ordered
      ;; pair is an inclusion.
      ((ra-equivalent-properties rs)    (ok (mutual-rias arena rs)))
      ((ra-transitive-property r)       (ok (one-axiom arena (transitivity arena r))))
      ((ra-object-property-domain r c)  (s0-domain arena r c))
      ((ra-object-property-range r c)   (s0-range arena r c))
      ((ra-class-assertion ca)          (s0-class-assertion arena ca))
      ((ra-object-property-assertion e) (s0-assertion arena e "a property assertion" false))
      ((ra-negative-assertion e)        (s0-assertion arena e "a negative assertion" true))
      ;; InverseObjectProperties(R S): R ⊑ S⁻ and S⁻ ⊑ R.
      ((ra-inverse-properties a b)
        (ok (two-axioms arena (ria1 arena a (inv-role b)) (ria1 arena (inv-role b) a))))
      ((ra-property-characteristic c r) (ok (one-axiom arena (characteristic arena c r))))
      ((ra-disjoint-properties rs)      (ok (pairwise-dis arena rs)))
      ((ra-same-individual ns)          (s0-same-individual arena ns))
      ((ra-different-individuals ns)    (s0-different-individuals arena ns))
      ((ra-disjoint-union du)           (s0-disjoint-union arena du))
      ;; Never accepted under sriq: consumed, inert, or out of profile.
      ((ra-declaration _)            (error "a declaration reached the normaliser"))
      ((ra-annotation)               (error "an annotation reached the normaliser"))
      ((ra-inert-data)               (error "an inert data axiom reached the normaliser"))
      ((ra-has-key _)                (error "HasKey, which the sriq gate does not admit"))
      ((ra-data-axiom _)             (error "a data axiom, which the sriq gate does not admit"))
      ((ra-builtin-role _)           (error "a built-in role axiom, which the sriq gate does not admit"))
      ((ra-anonymous-individual _)   (error "an anonymous individual, which the sriq gate does not admit"))
      ((ra-reserved-vocabulary _)    (error "reserved vocabulary, which the sriq gate does not admit"))
      ((ra-swrl-rule _)              (error "a SWRL rule, which the sriq gate does not admit"))
      ((ra-unrecognized _)           (error "an unrecognized axiom, which the sriq gate does not admit"))))

  ;; ============================================================
  ;; The collapse (§5.5 S0)
  ;; ============================================================

  (fn rep-at ((rb SriqRbox) (n Int))
    (@intent "Node n's representative node")
    (@spec ((SriqRbox Int) -> Int))
    (@pure)
    (match (list-get (. rb rep) n)
      ((some v) v)
      ((none)   n)))

  (fn collapse-role ((rb SriqRbox) (r RoleId))
    (@intent "R's representative: the least property of its component, oriented as R occurs")
    (@spec ((SriqRbox RoleId) -> RoleId))
    (@pure)
    ;; A role in no inclusion is its own component.
    (let ((n (sriq-node (. rb props) r)))
      (if (< n 0) r (node-role (. rb props) (rep-at rb n)))))

  (fn collapse-word ((arena Arena) (rb SriqRbox) (w (List RoleId)))
    (@intent "Each role of a word, collapsed")
    (@spec ((Arena SriqRbox (List RoleId)) -> (List RoleId)))
    (@alloc arena)
    (let ((mut out (list-new arena RoleId)))
      (do (for-each (r w) (list-push out (collapse-role rb r))) out)))

  (fn collapse-concepts ((arena Arena) (rb SriqRbox) (cs (List SConcept)))
    (@intent "collapse-concept over a list")
    (@spec ((Arena SriqRbox (List SConcept)) -> (List SConcept)))
    (@alloc arena)
    (let ((mut out (list-new arena SConcept)))
      (do (for-each (c cs) (list-push out (collapse-concept arena rb c))) out)))

  (fn collapse-concept ((arena Arena) (rb SriqRbox) (c SConcept))
    (@intent "Every role in a concept, collapsed")
    (@spec ((Arena SriqRbox SConcept) -> SConcept))
    (@alloc arena)
    (match c
      ((sc-top)          c)
      ((sc-bottom)       c)
      ((sc-name _)       c)
      ((sc-nominal _)    c)
      ((sc-not f)        (union-new SConcept sc-not (sc arena (collapse-concept arena rb (deref f)))))
      ((sc-and xs)       (union-new SConcept sc-and (collapse-concepts arena rb xs)))
      ((sc-or xs)        (union-new SConcept sc-or (collapse-concepts arena rb xs)))
      ((sc-some r f)     (union-new SConcept sc-some (collapse-role rb r) (sc arena (collapse-concept arena rb (deref f)))))
      ((sc-all r f)      (union-new SConcept sc-all (collapse-role rb r) (sc arena (collapse-concept arena rb (deref f)))))
      ((sc-atleast n r f) (union-new SConcept sc-atleast n (collapse-role rb r) (sc arena (collapse-concept arena rb (deref f)))))
      ((sc-atmost n r f)  (union-new SConcept sc-atmost n (collapse-role rb r) (sc arena (collapse-concept arena rb (deref f)))))
      ((sc-self r)       (union-new SConcept sc-self (collapse-role rb r)))))

  (fn trivial-ria ((w (List RoleId)) (s RoleId))
    (@intent "Is this `R ⊑ R`, which the collapse leaves of an inclusion inside one component?")
    (@spec (((List RoleId) RoleId) -> Bool))
    (@pure)
    (and (== (list-len w) 1)
         (match (list-get w 0)
           ((some r) (role-eq-p r s))
           ((none)   false))))

  (fn role-eq-p ((a RoleId) (b RoleId))
    (@intent "Same role?")
    (@spec ((RoleId RoleId) -> Bool))
    (@pure)
    (match a
      ((named-role ia)
        (match b ((named-role ib) (== (string-cmp (. ia value) (. ib value)) 0)) (_ false)))
      ((inverse-role ia)
        (match b ((inverse-role ib) (== (string-cmp (. ia value) (. ib value)) 0)) (_ false)))
      ((fresh-role ka)
        (match b ((fresh-role kb) (== ka kb)) (_ false)))))

  (fn collapse-axiom ((arena Arena) (rb SriqRbox) (a SAxiom))
    (@intent "An axiom with every role collapsed and every concept canonical; none for `R ⊑ R`")
    (@spec ((Arena SriqRbox SAxiom) -> (Option SAxiom)))
    (@alloc arena)
    (match a
      ((sa-gci l r)
        (some (union-new SAxiom sa-gci
                (sc arena (sc-canon arena (collapse-concept arena rb (deref l))))
                (sc arena (sc-canon arena (collapse-concept arena rb (deref r)))))))
      ((sa-ria x)
        (let ((w (collapse-word arena rb (. x word)))
              (s (collapse-role rb (. x super))))
          (if (trivial-ria w s) (none) (some (ria arena w s)))))
      ((sa-ref r)   (some (union-new SAxiom sa-ref (collapse-role rb r))))
      ((sa-irr r)   (some (union-new SAxiom sa-irr (collapse-role rb r))))
      ((sa-dis r s) (some (union-new SAxiom sa-dis (collapse-role rb r) (collapse-role rb s))))))

  ;; ============================================================
  ;; The empty role
  ;; ============================================================

  (fn bottom-role ()
    (@intent "owl:bottomObjectProperty")
    (@spec (() -> RoleId))
    (@pure)
    (union-new RoleId named-role (record-new IRI (value OWL_BOTTOM_OBJECT_PROPERTY))))

  (fn is-bottom ((r RoleId))
    (@intent "Is this the empty role, or its inverse?")
    (@spec ((RoleId) -> Bool))
    (@pure)
    (match r
      ((named-role i)   (== (string-cmp (. i value) OWL_BOTTOM_OBJECT_PROPERTY) 0))
      ((inverse-role i) (== (string-cmp (. i value) OWL_BOTTOM_OBJECT_PROPERTY) 0))
      ((fresh-role _)   false)))

  (fn concept-bottom-p ((c SConcept))
    (@intent "Does this concept mention the empty role?")
    (@spec ((SConcept) -> Bool))
    (@pure)
    (match c
      ((sc-top)            false)
      ((sc-bottom)         false)
      ((sc-name _)         false)
      ((sc-nominal _)      false)
      ((sc-not f)          (concept-bottom-p (deref f)))
      ((sc-and xs)         (concepts-bottom-p xs))
      ((sc-or xs)          (concepts-bottom-p xs))
      ((sc-some r f)       (or (is-bottom r) (concept-bottom-p (deref f))))
      ((sc-all r f)        (or (is-bottom r) (concept-bottom-p (deref f))))
      ((sc-atleast _ r f)  (or (is-bottom r) (concept-bottom-p (deref f))))
      ((sc-atmost _ r f)   (or (is-bottom r) (concept-bottom-p (deref f))))
      ((sc-self r)         (is-bottom r))))

  (fn concepts-bottom-p ((cs (List SConcept)))
    (@intent "concept-bottom-p over a list")
    (@spec (((List SConcept)) -> Bool))
    (@pure)
    (let ((mut found false))
      (do (for-each (c cs) (when (concept-bottom-p c) (set! found true))) found)))

  (fn axiom-bottom-p ((a SAxiom))
    (@intent "Does this axiom mention the empty role?")
    (@spec ((SAxiom) -> Bool))
    (@pure)
    (match a
      ((sa-gci l r) (or (concept-bottom-p (deref l)) (concept-bottom-p (deref r))))
      ((sa-ria x)
        (let ((mut found (is-bottom (. x super))))
          (do (for-each (r (. x word)) (when (is-bottom r) (set! found true))) found)))
      ((sa-ref r)   (is-bottom r))
      ((sa-irr r)   (is-bottom r))
      ((sa-dis r s) (or (is-bottom r) (is-bottom s)))))

  ;; ============================================================
  ;; S0
  ;; ============================================================

  (fn sriq-s0 ((arena Arena) (accepted (List RawAxiom)))
    (@intent "§5.5 S0: the gate's accepted axioms in SROIQ, collapsed, canonical, sorted")
    (@spec ((Arena (List RawAxiom)) -> (Result S0 String)))
    (@alloc arena)
    ;; The RBox analysis is the gate's own, run on what it accepted: when
    ;; the RBox was regular those are the axioms it judged, and when it
    ;; was not, no role inclusion was accepted at all.
    (let ((rb (sriq-rbox arena accepted))
          (mut raw (list-new arena SAxiom))
          (mut out (list-new arena SAxiom))
          (mut bottom false)
          (mut fault (Option String) (none)))
      (do
        (for-each (ax accepted)
          (match (s0-axiom arena ax)
            ((error m) (set! fault (some m)))
            ((ok xs)   (for-each (x xs) (list-push raw x)))))
        (for-each (a raw)
          (do
            (when (axiom-bottom-p a) (set! bottom true))
            (match (collapse-axiom arena rb a)
              ((some c) (list-push out c))
              ((none)   (do)))))
        ;; A component holding both P and P⁻ keeps P⁻ ⊑ P: its
        ;; representative is P, and both were replaced by it.
        (let ((k (cast Int (list-len (. rb props))))
              (mut i 0))
          (while (< i k)
            (do
              (when (and (== (rep-at rb (* 2 i)) (* 2 i))
                         (== (rep-at rb (+ (* 2 i) 1)) (* 2 i)))
                (let ((p (node-role (. rb props) (* 2 i))))
                  (list-push out (ria1 arena (inv-role p) p))))
              (set! i (+ i 1)))))
        ;; The empty role: a role name N with ∃N.⊤ ⊑ ⊥ (§5.4 K0), once, for
        ;; its component's representative.
        (when bottom
          (list-push out
            (gci arena (union-new SConcept sc-some (collapse-role rb (bottom-role)) (sc arena (top-sc)))
                       (union-new SConcept sc-bottom))))
        (match fault
          ((some m) (error m))
          ((none)
            (ok (record-new S0 (axioms (dedupe-saxioms arena (sort-saxioms arena out)))
                               (rbox rb))))))))

  ;; ============================================================
  ;; S1's hook (S1 is slice 6)
  ;; ============================================================

  (fn ria-complex ((rb SriqRbox) (x SRia))
    (@intent "Is this a complex RIA: a chain, or one step into a non-simple role?")
    (@spec ((SriqRbox SRia) -> Bool))
    (@pure)
    (if (> (list-len (. x word)) 1)
      true
      (let ((n (sriq-node (. rb props) (. x super))))
        (if (< n 0)
          false
          (match (list-get (. rb nonsimple) n)
            ((some v) v)
            ((none)   false))))))

  (fn sriq-s1 ((arena Arena) (s0 S0))
    (@intent "§5.5 S1 until it is built: the identity without a complex RIA, a refusal with one")
    (@spec ((Arena S0) -> (Result (List SAxiom) String)))
    (@alloc arena)
    (let ((mut first (Option SAxiom) (none)))
      (do
        (for-each (a (. s0 axioms))
          (match a
            ((sa-ria x)
              (when (and (ria-complex (. s0 rbox) x)
                         (match first ((none) true) ((some _) false)))
                (set! first (some a))))
            (_ (do))))
        (match first
          ((none)   (ok (. s0 axioms)))
          ((some a)
            (error (string-concat arena
                     "complex role inclusions need chain elimination (SPEC 5.5 S1), not yet built; first: "
                     (render-saxiom arena a))))))))

  ;; ============================================================
  ;; S2 — the normal form (§5.5 S2, [TGH21] Table 1)
  ;;
  ;; Every GCI C ⊑ D becomes ⊤ ⊑ NNF(¬C ⊔ D); a top-level ⊓ is split
  ;; (choice 3); each disjunct that is not a name or a negated name gets a
  ;; fresh name A_E placed BELOW it (pos-name), and a filler whose
  ;; occurrence is negative a name placed ABOVE it (neg-name). One name per
  ;; concept, by its injective content key, whatever the polarity
  ;; (choice 5): the registry's bits record which definitions are emitted.
  ;; The shapes are then read off into DL1–DL11.
  ;;
  ;; The state is threaded by pointer, as kscnormal's is: a helper that
  ;; pushed into a passed-in list would grow its own copy and lose it.
  ;; ============================================================

  (type S2State (record
    (out      (List DlClause))
    (registry (Ptr Registry))
    (concepts (List SConcept))         ; A_E's concept, by fresh id
    (sroles   (List DRole))            ; S_{B₂}'s S, by id
    (sfills   (List (Option DName)))   ; S_{B₂}'s B₂ (none: ⊤), by id
    (bars     (List IRI))              ; the properties whose P̄ is used, first-use order
    (barset   (Set String))
    (fnkeys   (List String))           ; a function symbol's key, by id
    (fnindex  (Map String (Int 0 ..)))))

  ;; S2's output: the clauses, and what S5's ids from content read.
  (type S2 (record
    (clauses  (List DlClause))
    (concepts (List SConcept))
    (sroles   (List DRole))
    (sfills   (List (Option DName)))
    (bars     (List IRI))
    (fnkeys   (List String))))

  (fn new-s2 ((arena Arena))
    (@intent "An empty S2 state")
    (@spec ((Arena) -> (Ptr S2State)))
    (@alloc arena)
    (let ((p (cast (Ptr S2State) (arena-alloc arena (sizeof S2State)))))
      (do
        (set! (deref p) (record-new S2State
                          (out      (list-new arena DlClause))
                          (registry (new-registry arena))
                          (concepts (list-new arena SConcept))
                          (sroles   (list-new arena DRole))
                          (sfills   (list-new arena (Option DName)))
                          (bars     (list-new arena IRI))
                          (barset   (set-new arena String))
                          (fnkeys   (list-new arena String))
                          (fnindex  (map-new arena String (Int 0 ..)))))
        p)))

  (fn emit ((arena Arena) (p (Ptr S2State)) (c DlClause))
    (@intent "Append one clause")
    (@spec ((Arena (Ptr S2State) DlClause) -> Bool))
    (@alloc arena)
    (let ((mut s (deref p)))
      (do (list-push (. s out) c) (set! (deref p) s) true)))

  (fn fresh-name ((arena Arena) (p (Ptr S2State)) (c SConcept))
    (@intent "A_E's registry id for a concept, minting on first use")
    (@spec ((Arena (Ptr S2State) SConcept) -> (Int 0 ..)))
    (@alloc arena)
    (let ((id (fresh-id arena (. (deref p) registry) (sc-key arena c))))
      (do
        (when (== (cast Int id) (cast Int (list-len (. (deref p) concepts))))
          (let ((mut s (deref p)))
            (do (list-push (. s concepts) c) (set! (deref p) s))))
        id)))

  (fn concept-of ((p (Ptr S2State)) (k (Int 0 ..)))
    (@intent "The concept A_k names")
    (@spec (((Ptr S2State) (Int 0 ..)) -> SConcept))
    (match (list-get (. (deref p) concepts) k)
      ((some c) c)
      ((none)   (union-new SConcept sc-top))))

  (fn role-name ((arena Arena) (p (Ptr S2State)) (r RoleId))
    (@intent "A role as a Table 1 role name: P, or P̄ for P⁻ (noted as used)")
    (@spec ((Arena (Ptr S2State) RoleId) -> DRole))
    (@alloc arena)
    (match r
      ((named-role i) (union-new DRole dr-prop i))
      ((inverse-role i)
        (do
          (when (not (set-has (. (deref p) barset) (. i value)))
            (let ((mut s (deref p)))
              (do (set-put (. s barset) (. i value)) (list-push (. s bars) i) (set! (deref p) s))))
          (union-new DRole dr-bar i)))
      ;; Unreachable: S0 and S1 mint no fresh role.
      ((fresh-role k) (union-new DRole dr-sub k))))

  (fn dname-key ((arena Arena) (p (Ptr S2State)) (n DName))
    (@intent "A class name's content key")
    (@spec ((Arena (Ptr S2State) DName) -> String))
    (@alloc arena)
    (match n
      ((dn-class i) (string-concat arena "<" (string-concat arena (. i value) ">")))
      ((dn-fresh k) (string-concat arena "[" (string-concat arena (sc-key arena (concept-of p k)) "]")))))

  (fn filler-key ((arena Arena) (p (Ptr S2State)) (b (Option DName)))
    (@intent "A filler's content key, T for ⊤")
    (@spec ((Arena (Ptr S2State) (Option DName)) -> String))
    (@alloc arena)
    (match b ((some n) (dname-key arena p n)) ((none) "T")))

  (fn drole-key ((arena Arena) (p (Ptr S2State)) (r DRole))
    (@intent "A role name's content key")
    (@spec ((Arena (Ptr S2State) DRole) -> String))
    (@alloc arena)
    (match r
      ((dr-prop i) (string-concat arena "<" (string-concat arena (. i value) ">")))
      ((dr-bar i)  (string-concat arena "<" (string-concat arena (. i value) ">bar")))
      ((dr-sub k)
        (let ((s (match (list-get (. (deref p) sroles) k) ((some x) x) ((none) r)))
              (b (match (list-get (. (deref p) sfills) k) ((some x) x) ((none) (none)))))
          (string-concat arena "S(" (string-concat arena (drole-key arena p s)
            (string-concat arena "," (string-concat arena (filler-key arena p b) ")"))))))))

  (fn srole-of ((arena Arena) (p (Ptr S2State)) (s DRole) (b (Option DName)))
    (@intent "DL4's fresh S_{B₂}, one per (S, B₂)")
    (@spec ((Arena (Ptr S2State) DRole (Option DName)) -> DRole))
    (@alloc arena)
    (let ((key (string-concat arena "S(" (string-concat arena (drole-key arena p s)
                 (string-concat arena "," (string-concat arena (filler-key arena p b) ")")))))
          (id (fresh-role-id arena (. (deref p) registry) key)))
      (do
        (when (== (cast Int id) (cast Int (list-len (. (deref p) sroles))))
          (let ((mut st (deref p)))
            (do (list-push (. st sroles) s) (list-push (. st sfills) b) (set! (deref p) st))))
        (union-new DRole dr-sub id))))

  (fn fn-ids ((arena Arena) (p (Ptr S2State)) (axkey String) (n Int))
    (@intent "A DL2 axiom's n function symbols, keyed by the axiom and the position (S5)")
    (@spec ((Arena (Ptr S2State) String Int) -> (List (Int 0 ..))))
    (@alloc arena)
    (let ((mut out (list-new arena (Int 0 ..)))
          (mut i 1))
      (do
        (while (<= i n)
          (let ((key (string-concat arena axkey (string-concat arena "|" (int-to-string arena i)))))
            (do
              (match (map-get (. (deref p) fnindex) key)
                ((some id) (list-push out (cast (Int 0 ..) id)))
                ((none)
                  (let ((mut s (deref p))
                        (id (cast (Int 0 ..) (list-len (. (deref p) fnkeys)))))
                    (do
                      (list-push (. s fnkeys) key)
                      (map-put (. s fnindex) key id)
                      (set! (deref p) s)
                      (list-push out id)))))
              (set! i (+ i 1)))))
        out)))

  ;; ------------------------------------------------------------
  ;; NNF
  ;; ------------------------------------------------------------

  (fn nnf-list ((arena Arena) (xs (List SConcept)) (pos Bool))
    (@intent "nnf over a list")
    (@spec ((Arena (List SConcept) Bool) -> (List SConcept)))
    (@alloc arena)
    (let ((mut out (list-new arena SConcept)))
      (do (for-each (x xs) (list-push out (nnf arena x pos))) out)))

  (fn nnf ((arena Arena) (c SConcept) (pos Bool))
    (@intent "The negation normal form of c (pos) or of ¬c: negation on a name, a nominal or Self only")
    (@spec ((Arena SConcept Bool) -> SConcept))
    (@alloc arena)
    (if pos
      (match c
        ((sc-top)           c)
        ((sc-bottom)        c)
        ((sc-name _)        c)
        ((sc-nominal _)     c)
        ((sc-self _)        c)
        ((sc-not f)         (nnf arena (deref f) false))
        ((sc-and xs)        (union-new SConcept sc-and (nnf-list arena xs true)))
        ((sc-or xs)         (union-new SConcept sc-or (nnf-list arena xs true)))
        ((sc-some r f)      (union-new SConcept sc-some r (sc arena (nnf arena (deref f) true))))
        ((sc-all r f)       (union-new SConcept sc-all r (sc arena (nnf arena (deref f) true))))
        ((sc-atleast n r f) (union-new SConcept sc-atleast n r (sc arena (nnf arena (deref f) true))))
        ((sc-atmost n r f)  (union-new SConcept sc-atmost n r (sc arena (nnf arena (deref f) true)))))
      (match c
        ((sc-top)           (union-new SConcept sc-bottom))
        ((sc-bottom)        (union-new SConcept sc-top))
        ((sc-name _)        (union-new SConcept sc-not (sc arena c)))
        ((sc-nominal _)     (union-new SConcept sc-not (sc arena c)))
        ((sc-self _)        (union-new SConcept sc-not (sc arena c)))
        ((sc-not f)         (nnf arena (deref f) true))
        ((sc-and xs)        (union-new SConcept sc-or (nnf-list arena xs false)))
        ((sc-or xs)         (union-new SConcept sc-and (nnf-list arena xs false)))
        ((sc-some r f)      (union-new SConcept sc-all r (sc arena (nnf arena (deref f) false))))
        ((sc-all r f)       (union-new SConcept sc-some r (sc arena (nnf arena (deref f) false))))
        ;; ¬≥n R.C is ≤(n−1) R.C, and ¬≥0 R.C is ⊥; ¬≤n R.C is ≥(n+1) R.C.
        ((sc-atleast n r f)
          (if (== n 0)
            (union-new SConcept sc-bottom)
            (union-new SConcept sc-atmost (cast (Int 0 ..) (- n 1)) r (sc arena (nnf arena (deref f) true)))))
        ((sc-atmost n r f)
          (union-new SConcept sc-atleast (cast (Int 0 ..) (+ n 1)) r (sc arena (nnf arena (deref f) true)))))))

  ;; ------------------------------------------------------------
  ;; Naming
  ;; ------------------------------------------------------------

  (fn pos-name ((arena Arena) (p (Ptr S2State)) (c SConcept))
    (@intent "A name below c (A ⊑ c): c itself if a class name, none for ⊤")
    (@spec ((Arena (Ptr S2State) SConcept) -> (Option DName)))
    (@alloc arena)
    (match c
      ((sc-top)    (none))
      ((sc-name i) (some (union-new DName dn-class i)))
      (_
        (let ((key (sc-key arena c))
              (x (union-new DName dn-fresh (fresh-name arena p c))))
          (do
            (when (not (pos-defined (. (deref p) registry) key))
              (do
                (mark-pos arena (. (deref p) registry) key)
                (define-pos arena p x c)))
            (some x))))))

  (fn neg-name ((arena Arena) (p (Ptr S2State)) (c SConcept))
    (@intent "A name above c (c ⊑ X): c itself if a class name, none for ⊤")
    (@spec ((Arena (Ptr S2State) SConcept) -> (Option DName)))
    (@alloc arena)
    ;; {o} is named through DL10 and ∃R.Self through DL6 (§5.5 S2); any
    ;; other concept through the GCI c ⊑ X.
    (match c
      ((sc-top)    (none))
      ((sc-name i) (some (union-new DName dn-class i)))
      (_
        (let ((key (sc-key arena c))
              (x (union-new DName dn-fresh (fresh-name arena p c))))
          (do
            (when (not (neg-defined (. (deref p) registry) key))
              (do
                (mark-neg arena (. (deref p) registry) key)
                (match c
                  ((sc-nominal i) (emit arena p (union-new DlClause dl10 i x)))
                  ((sc-self r)    (emit arena p (union-new DlClause dl6 (role-name arena p r) x)))
                  (_
                    ;; c ⊑ X is ⊤ ⊑ NNF(¬c) ⊔ X.
                    (disjunction arena p (none) (some x) (sc-canon arena (nnf arena c false)))))))
            (some x))))))

  (fn neg-literal-name ((arena Arena) (p (Ptr S2State)) (lit SConcept))
    (@intent "The body name for a negated literal ¬L: L itself for a name, else the name above L")
    (@spec ((Arena (Ptr S2State) SConcept) -> (Option DName)))
    (@alloc arena)
    (neg-name arena p lit))

  ;; ------------------------------------------------------------
  ;; Reading off: DL1 from a disjunction
  ;; ------------------------------------------------------------

  (fn singleton-sc ((arena Arena) (c SConcept))
    (@intent "[c]")
    (@spec ((Arena SConcept) -> (List SConcept)))
    (@alloc arena)
    (let ((mut xs (list-new arena SConcept))) (do (list-push xs c) xs)))

  (fn disjunction ((arena Arena) (p (Ptr S2State)) (lhs (Option DName)) (extra (Option DName)) (e SConcept))
    (@intent "DL1 for lhs ⊑ e ⊔ extra: names and negated names in place, every other disjunct named")
    (@spec ((Arena (Ptr S2State) (Option DName) (Option DName) SConcept) -> Bool))
    (@alloc arena)
    ;; e is canonical NNF; lhs is the body name (none: ⊤), extra a head
    ;; name to add (neg-name's X). A ⊤ disjunct makes the clause a
    ;; tautology, and nothing is emitted; a ⊥ disjunct is dropped.
    (let ((ds (match e ((sc-or xs) xs) (_ (singleton-sc arena e))))
          (mut body (list-new arena DName))
          (mut head (list-new arena DName))
          (mut taut false))
      (do
        (match lhs ((some x) (list-push body x)) ((none) (do)))
        (match extra ((some x) (list-push head x)) ((none) (do)))
        (for-each (d ds)
          (match d
            ((sc-top)    (set! taut true))
            ((sc-bottom) (do))
            ((sc-name i) (list-push head (union-new DName dn-class i)))
            ;; A negated literal goes to the body: a name as it is, a
            ;; nominal or Self through the name above it (DL10, DL6).
            ((sc-not f)
              (match (neg-literal-name arena p (deref f))
                ((some n) (list-push body n))
                ;; ¬⊤ is ⊥ in NNF, so never here; dropped like ⊥.
                ((none)   (do))))
            (_
              (match (pos-name arena p d)
                ((some n) (list-push head n))
                ((none)   (set! taut true))))))
        (when (not taut)
          (emit arena p (union-new DlClause dl1 (record-new Dl1 (body body) (head head)))))
        true)))

  ;; ------------------------------------------------------------
  ;; Reading off: what A_E ⊑ E says, by E's shape
  ;; ------------------------------------------------------------

  (fn define-pos ((arena Arena) (p (Ptr S2State)) (x DName) (e SConcept))
    (@intent "The clauses for x ⊑ e, e canonical NNF (§5.5 S2's shape table)")
    (@spec ((Arena (Ptr S2State) DName SConcept) -> Bool))
    (@alloc arena)
    (match e
      ((sc-top)        true)
      ((sc-name _)     (disjunction arena p (some x) (none) e))
      ((sc-bottom)     (disjunction arena p (some x) (none) e))
      ((sc-not _)      (disjunction arena p (some x) (none) e))
      ((sc-or _)       (disjunction arena p (some x) (none) e))
      ((sc-nominal i)  (emit arena p (union-new DlClause dl11 x i)))
      ;; A ⊓ is split: x ⊑ Eᵢ for each conjunct (choice 3).
      ((sc-and xs)
        (do (for-each (c xs) (define-pos arena p x c)) true))
      ((sc-some r f)       (define-dl2 arena p x r 1 (deref f)))
      ((sc-atleast n r f)  (if (== n 0) true (define-dl2 arena p x r n (deref f))))
      ;; ∀R.F is DL3 over inv(R): ∃R⁻.x ⊑ B_F.
      ((sc-all r f)
        (match (pos-name arena p (deref f))
          ((none)   true)
          ((some b) (emit arena p (union-new DlClause dl3 (role-name arena p (inv-role r)) x b)))))
      ;; ≤n R.F: F's occurrence is negative, named through F ⊑ B.
      ((sc-atmost n r f)
        (let ((s (role-name arena p r))
              (b (neg-name arena p (deref f))))
          (emit arena p (union-new DlClause dl4
                          (record-new Dl4 (sub x) (role s) (count n) (filler b)
                                          (srole (srole-of arena p s b)))))))
      ((sc-self r)     (emit arena p (union-new DlClause dl5 x (role-name arena p r))))))

  (fn define-dl2 ((arena Arena) (p (Ptr S2State)) (x DName) (r RoleId) (n (Int 0 ..)) (f SConcept))
    (@intent "DL2: x ⊑ ≥n R.F, with its n function symbols")
    (@spec ((Arena (Ptr S2State) DName RoleId (Int 0 ..) SConcept) -> Bool))
    (@alloc arena)
    (let ((s (role-name arena p r))
          (b (pos-name arena p f))
          (axkey (string-concat arena "dl2(" (string-concat arena (dname-key arena p x)
                   (string-concat arena "," (string-concat arena (int-to-string arena n)
                     (string-concat arena "," (string-concat arena (drole-key arena p s)
                       (string-concat arena "," (string-concat arena (filler-key arena p b) ")"))))))))))
      (emit arena p (union-new DlClause dl2
                      (record-new Dl2 (sub x) (role s) (count (cast (Int 1 ..) n)) (filler b)
                                      (fns (fn-ids arena p axkey (cast Int n))))))))

  ;; ------------------------------------------------------------
  ;; The axioms
  ;; ------------------------------------------------------------

  (fn s2-gci ((arena Arena) (p (Ptr S2State)) (l SConcept) (r SConcept))
    (@intent "C ⊑ D as ⊤ ⊑ NNF(¬C ⊔ D), a top-level ⊓ split")
    (@spec ((Arena (Ptr S2State) SConcept SConcept) -> Bool))
    (@alloc arena)
    (let ((mut both (list-new arena SConcept)))
      (do
        (list-push both (union-new SConcept sc-not (sc arena l)))
        (list-push both r)
        (assert-top arena p (sc-canon arena (nnf arena (union-new SConcept sc-or both) true))))))

  (fn assert-top ((arena Arena) (p (Ptr S2State)) (e SConcept))
    (@intent "⊤ ⊑ e: each conjunct of a top-level ⊓ alone (choice 3), else one DL1")
    (@spec ((Arena (Ptr S2State) SConcept) -> Bool))
    (@alloc arena)
    (match e
      ((sc-and xs) (do (for-each (c xs) (assert-top arena p c)) true))
      (_           (disjunction arena p (none) (none) e))))

  (fn s2-ria ((arena Arena) (p (Ptr S2State)) (x SRia))
    (@intent "A simple RIA R ⊑ S as DL7 or DL8, over role names")
    (@spec ((Arena (Ptr S2State) SRia) -> (Result Bool String)))
    (@alloc arena)
    ;; P ⊑ Q and P⁻ ⊑ Q⁻ are DL7 P ⊑ Q; P ⊑ Q⁻ and P⁻ ⊑ Q are DL8 P ⊑ Q⁻.
    (if (!= (list-len (. x word)) 1)
      (error "a complex role inclusion reached S2: S1 must eliminate it first")
      (match (list-get (. x word) 0)
        ((none) (error "an empty role inclusion"))
        ((some r)
          (let ((s (. x super)))
            (match r
              ((named-role pi)
                (match s
                  ((named-role qi)   (do (emit arena p (union-new DlClause dl7 (union-new DRole dr-prop pi) (union-new DRole dr-prop qi))) (ok true)))
                  ((inverse-role qi) (do (emit arena p (union-new DlClause dl8 (union-new DRole dr-prop pi) (union-new DRole dr-prop qi))) (ok true)))
                  ((fresh-role _)    (error "a fresh role in S2"))))
              ((inverse-role pi)
                (match s
                  ((inverse-role qi) (do (emit arena p (union-new DlClause dl7 (union-new DRole dr-prop pi) (union-new DRole dr-prop qi))) (ok true)))
                  ((named-role qi)   (do (emit arena p (union-new DlClause dl8 (union-new DRole dr-prop pi) (union-new DRole dr-prop qi))) (ok true)))
                  ((fresh-role _)    (error "a fresh role in S2"))))
              ((fresh-role _) (error "a fresh role in S2"))))))))

  (fn s2-dis ((arena Arena) (p (Ptr S2State)) (r RoleId) (s RoleId))
    (@intent "Dis(R, S) as DL9 over role names: both inverses flip to Dis(P, Q)")
    (@spec ((Arena (Ptr S2State) RoleId RoleId) -> Bool))
    (@alloc arena)
    (match r
      ((inverse-role pi)
        (match s
          ((inverse-role qi)
            (emit arena p (union-new DlClause dl9 (union-new DRole dr-prop pi) (union-new DRole dr-prop qi))))
          (_ (emit arena p (union-new DlClause dl9 (role-name arena p r) (role-name arena p s))))))
      (_ (emit arena p (union-new DlClause dl9 (role-name arena p r) (role-name arena p s))))))

  (fn counts-ok ((c SConcept))
    (@intent "Is every number restriction in c within the sriq gate's bound?")
    (@spec ((SConcept) -> Bool))
    (@pure)
    (match c
      ((sc-top)           true)
      ((sc-bottom)        true)
      ((sc-name _)        true)
      ((sc-nominal _)     true)
      ((sc-self _)        true)
      ((sc-not f)         (counts-ok (deref f)))
      ((sc-and xs)        (counts-list-ok xs))
      ((sc-or xs)         (counts-list-ok xs))
      ((sc-some _ f)      (counts-ok (deref f)))
      ((sc-all _ f)       (counts-ok (deref f)))
      ((sc-atleast n _ f) (and (<= n SRIQ_MAX_COUNT) (counts-ok (deref f))))
      ((sc-atmost n _ f)  (and (<= n SRIQ_MAX_COUNT) (counts-ok (deref f))))))

  (fn counts-list-ok ((cs (List SConcept)))
    (@intent "counts-ok over a list")
    (@spec (((List SConcept)) -> Bool))
    (@pure)
    (let ((mut ok true))
      (do (for-each (c cs) (when (not (counts-ok c)) (set! ok false))) ok)))

  (fn sriq-s2 ((arena Arena) (axs (List SAxiom)))
    (@intent "§5.5 S2: S1's output in [TGH21] Table 1's forms")
    (@spec ((Arena (List SAxiom)) -> (Result S2 String)))
    (@alloc arena)
    ;; THE GATE'S COUNT BOUND IS AN INVARIANT HERE. NNF turns ¬(≤n R.C)
    ;; into ≥(n+1) R.C, which is exact only while n + 1 is representable;
    ;; the sriq gate admits n ≤ SRIQ_MAX_COUNT (§5.5), so S2 refuses
    ;; anything past it rather than rely on that silently.
    (let ((p (new-s2 arena))
          (mut fault (Option String) (none)))
      (do
        (for-each (a axs)
          (match a
            ((sa-gci l r)
              (when (not (and (counts-ok (deref l)) (counts-ok (deref r))))
                (set! fault (some "a number restriction above the sriq gate's bound of 16 reached S2"))))
            (_ (do))))
        (for-each (a axs)
          (match a
            ((sa-gci l r) (s2-gci arena p (deref l) (deref r)))
            ((sa-ria x)
              (match (s2-ria arena p x)
                ((ok _)    (do))
                ((error m) (set! fault (some m)))))
            ;; Ref(R) is ⊤ ⊑ ∃R.Self; Irr(R) is ∃R.Self ⊑ ⊥ (§5.5 S2).
            ((sa-ref r)
              (s2-gci arena p (union-new SConcept sc-top) (union-new SConcept sc-self r)))
            ((sa-irr r)
              (s2-gci arena p (union-new SConcept sc-self r) (union-new SConcept sc-bottom)))
            ((sa-dis r s) (s2-dis arena p r s))))
        ;; Each P̄ used: P ⊑ P̄⁻ and P̄ ⊑ P⁻ (DL8).
        (for-each (i (. (deref p) bars))
          (do
            (emit arena p (union-new DlClause dl8 (union-new DRole dr-prop i) (union-new DRole dr-bar i)))
            (emit arena p (union-new DlClause dl8 (union-new DRole dr-bar i) (union-new DRole dr-prop i)))))
        (match fault
          ((some m) (error m))
          ((none)
            (let ((s (deref p)))
              (ok (record-new S2
                    (clauses  (. s out))
                    (concepts (. s concepts))
                    (sroles   (. s sroles))
                    (sfills   (. s sfills))
                    (bars     (. s bars))
                    (fnkeys   (. s fnkeys))))))))))

  ;; ------------------------------------------------------------
  ;; Rendering, for the row tests: fresh names by what they name, so
  ;; they read the same before and after S5's ids from content
  ;; ------------------------------------------------------------

  (fn render-dname ((arena Arena) (s2 S2) (n DName))
    (@intent "A class name: its IRI, or A[the concept it names]")
    (@spec ((Arena S2 DName) -> String))
    (@alloc arena)
    (match n
      ((dn-class i) (. i value))
      ((dn-fresh k)
        (match (list-get (. s2 concepts) k)
          ((some c) (string-concat arena "A[" (string-concat arena (render-sconcept arena c) "]")))
          ((none)   "A[?]")))))

  (fn render-dfiller ((arena Arena) (s2 S2) (b (Option DName)))
    (@intent "A filler, ⊤ for none")
    (@spec ((Arena S2 (Option DName)) -> String))
    (@alloc arena)
    (match b ((some n) (render-dname arena s2 n)) ((none) "⊤")))

  (fn render-drole ((arena Arena) (s2 S2) (r DRole))
    (@intent "A role name: P, bar(P), or S_{S,B₂}")
    (@spec ((Arena S2 DRole) -> String))
    (@alloc arena)
    (match r
      ((dr-prop i) (. i value))
      ((dr-bar i)  (string-concat arena "bar(" (string-concat arena (. i value) ")")))
      ((dr-sub k)
        (let ((s (match (list-get (. s2 sroles) k) ((some x) x) ((none) r)))
              (b (match (list-get (. s2 sfills) k) ((some x) x) ((none) (none)))))
          (string-concat arena "S_{" (string-concat arena (render-drole arena s2 s)
            (string-concat arena "," (string-concat arena (render-dfiller arena s2 b) "}"))))))))

  (fn render-dnames ((arena Arena) (s2 S2) (ns (List DName)) (sep String) (empty String))
    (@intent "Names joined by sep, or empty")
    (@spec ((Arena S2 (List DName) String String) -> String))
    (@alloc arena)
    (if (== (list-len ns) 0)
      empty
      (let ((mut out "")
            (mut first true))
        (do
          (for-each (n ns)
            (do
              (when (not first) (set! out (string-concat arena out sep)))
              (set! out (string-concat arena out (render-dname arena s2 n)))
              (set! first false)))
          out))))

  (fn render-dl ((arena Arena) (s2 S2) (c DlClause))
    (@intent "A clause, labelled with its Table 1 form, in DL notation")
    (@spec ((Arena S2 DlClause) -> String))
    (@alloc arena)
    (match c
      ((dl1 d)
        (string-concat arena "DL1 " (string-concat arena (render-dnames arena s2 (. d body) " ⊓ " "⊤")
          (string-concat arena " ⊑ " (render-dnames arena s2 (. d head) " ⊔ " "⊥")))))
      ((dl2 d)
        (string-concat arena "DL2 " (string-concat arena (render-dname arena s2 (. d sub))
          (string-concat arena " ⊑ ≥" (string-concat arena (int-to-string arena (. d count))
            (string-concat arena " " (string-concat arena (render-drole arena s2 (. d role))
              (string-concat arena "." (render-dfiller arena s2 (. d filler))))))))))
      ((dl3 s b1 b2)
        (string-concat arena "DL3 ∃" (string-concat arena (render-drole arena s2 s)
          (string-concat arena "." (string-concat arena (render-dname arena s2 b1)
            (string-concat arena " ⊑ " (render-dname arena s2 b2)))))))
      ((dl4 d)
        (string-concat arena "DL4 " (string-concat arena (render-dname arena s2 (. d sub))
          (string-concat arena " ⊑ ≤" (string-concat arena (int-to-string arena (. d count))
            (string-concat arena " " (string-concat arena (render-drole arena s2 (. d role))
              (string-concat arena "." (string-concat arena (render-dfiller arena s2 (. d filler))
                (string-concat arena " via " (render-drole arena s2 (. d srole))))))))))))
      ((dl5 b s)
        (string-concat arena "DL5 " (string-concat arena (render-dname arena s2 b)
          (string-concat arena " ⊑ ∃" (string-concat arena (render-drole arena s2 s) ".Self")))))
      ((dl6 s b)
        (string-concat arena "DL6 ∃" (string-concat arena (render-drole arena s2 s)
          (string-concat arena ".Self ⊑ " (render-dname arena s2 b)))))
      ((dl7 a b)
        (string-concat arena "DL7 " (string-concat arena (render-drole arena s2 a)
          (string-concat arena " ⊑ " (render-drole arena s2 b)))))
      ((dl8 a b)
        (string-concat arena "DL8 " (string-concat arena (render-drole arena s2 a)
          (string-concat arena " ⊑ " (string-concat arena (render-drole arena s2 b) "⁻")))))
      ((dl9 a b)
        (string-concat arena "DL9 Disj(" (string-concat arena (render-drole arena s2 a)
          (string-concat arena ", " (string-concat arena (render-drole arena s2 b) ")")))))
      ((dl10 o b)
        (string-concat arena "DL10 {" (string-concat arena (. o value)
          (string-concat arena "} ⊑ " (render-dname arena s2 b)))))
      ((dl11 b o)
        (string-concat arena "DL11 " (string-concat arena (render-dname arena s2 b)
          (string-concat arena " ⊑ {" (string-concat arena (. o value) "}")))))))
)
