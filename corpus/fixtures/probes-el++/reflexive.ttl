# PROBE reflexive. r reflexive and ∃r.A ⊑ B entail A ⊑ B.
# construct: ReflexiveObjectProperty
# expect: sub :A :B
# expect-not: sub :B :A

@prefix :     <http://example.org/t#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/t> a owl:Ontology .
:A a owl:Class . :B a owl:Class .
:r a owl:ObjectProperty .
:r a owl:ReflexiveProperty .
[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :A ] rdfs:subClassOf :B .
