# PROBE inverse-functional. r is inverse-functional and r(a, c), r(b, c), so a = b; A(a), B(b) and A, B disjoint are inconsistent.
# construct: InverseFunctionalObjectProperty
# expect: inconsistent

@prefix :     <http://example.org/t#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/t> a owl:Ontology .
:A a owl:Class . :B a owl:Class .
:r a owl:ObjectProperty .
:r a owl:InverseFunctionalProperty .
:A owl:disjointWith :B .
:a a owl:NamedIndividual . :b a owl:NamedIndividual . :c a owl:NamedIndividual .
:a a :A .
:b a :B .
:a :r :c .
:b :r :c .
