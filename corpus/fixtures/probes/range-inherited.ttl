# PROBE range-inherited. r ⊑ s and range(s) = C give r-successors C too: A ⊑ ∃r.B and ∃r.C ⊑ D entail A ⊑ D.
# construct: ObjectPropertyRange
# expect: sub :A :D

@prefix :     <http://example.org/t#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/t> a owl:Ontology .
:A a owl:Class . :B a owl:Class . :C a owl:Class . :D a owl:Class .
:r a owl:ObjectProperty . :s a owl:ObjectProperty .
:r rdfs:subPropertyOf :s .
:s rdfs:range :C .
:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] .
[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :C ] rdfs:subClassOf :D .
