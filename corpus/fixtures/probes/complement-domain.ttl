# PROBE complement-domain. dom(r) ⊑ ¬B with B ⊑ ∃r.⊤ makes B unsatisfiable.
# construct: ObjectComplementOf (positive position)
# expect: unsat :B

@prefix :     <http://example.org/t#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/t> a owl:Ontology .
:B a owl:Class . :r a owl:ObjectProperty .
:B rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom owl:Thing ] .
:r rdfs:domain [ a owl:Class ; owl:complementOf :B ] .
