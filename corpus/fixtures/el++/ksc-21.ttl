# el++ engine fixture 21 (src/test.slop: ksc-fixture-at, test-ksc-entailments).
# 21. K7: chain legs stored under sub-roles, each arriving first in turn.
# r1 ⊑ r, s1 ⊑ s, r ∘ s ⊑ t, t ⊑ t2, ∃t2.D ⊑ E. C's first leg arrives
# first; C2's (three subsumptions down) arrives after X's second leg.
# Inside el++ whole: the engine must answer every class as the literal Psc
# reference does (test-ksc-engine-matches-reference).

@prefix : <http://example.org/t#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:r a owl:ObjectProperty . :s a owl:ObjectProperty . :t a owl:ObjectProperty .
:C a owl:Class . :D a owl:Class .
:a a owl:NamedIndividual . :b a owl:NamedIndividual .
:r1 a owl:ObjectProperty . :s1 a owl:ObjectProperty . :t2 a owl:ObjectProperty . :X a owl:Class . :C2 a owl:Class . :A1 a owl:Class . :A2 a owl:Class . :E a owl:Class .
:r1 rdfs:subPropertyOf :r . :s1 rdfs:subPropertyOf :s . :t rdfs:subPropertyOf :t2 .
:t owl:propertyChainAxiom ( :r :s ) .
:C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r1 ; owl:someValuesFrom :X ] .
:X rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s1 ; owl:someValuesFrom :D ] .
:C2 rdfs:subClassOf :A1 . :A1 rdfs:subClassOf :A2 . :A2 rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r1 ; owl:someValuesFrom :X ] .
[ a owl:Restriction ; owl:onProperty :t2 ; owl:someValuesFrom :D ] rdfs:subClassOf :E .
