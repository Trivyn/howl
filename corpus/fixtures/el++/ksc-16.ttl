# el++ engine fixture 16 (src/test.slop: ksc-fixture-at, test-ksc-entailments).
# 16. K6.3: ⊥ reaches an unsafe class only through a safe witness.
# Inside el++ whole: the engine must answer every class as the literal Psc
# reference does (test-ksc-engine-matches-reference).

@prefix : <http://example.org/t#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:r a owl:ObjectProperty . :s a owl:ObjectProperty . :t a owl:ObjectProperty .
:C a owl:Class . :D a owl:Class .
:a a owl:NamedIndividual . :b a owl:NamedIndividual .
:S a owl:Class . :U a owl:Class . :X a owl:Class . :B a owl:Class .
:X rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] .
:B rdfs:subClassOf owl:Nothing .
:S rdfs:subClassOf :X . :U rdfs:subClassOf :X .
:U rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s ; owl:hasValue :a ] .
