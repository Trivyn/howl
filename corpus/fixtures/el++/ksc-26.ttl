# el++ engine fixture 26 (src/test.slop: ksc-fixture-at, test-ksc-entailments).
# 26. K7 at K6's boundary: fixture 15 with every role a sub-role. The
# nominal reaches U through s1 ⊑ s, so U is unsafe and S is not:
# S ⊑ E, U ⊑ E, U ⊑ G (F(a), ∃s.F ⊑ G); S ⋢ G.
# Inside el++ whole: the engine must answer every class as the literal Psc
# reference does (test-ksc-engine-matches-reference).

@prefix : <http://example.org/t#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:r a owl:ObjectProperty . :s a owl:ObjectProperty . :t a owl:ObjectProperty .
:C a owl:Class . :D a owl:Class .
:a a owl:NamedIndividual . :b a owl:NamedIndividual .
:r1 a owl:ObjectProperty . :s1 a owl:ObjectProperty . :F a owl:Class . :S a owl:Class . :U a owl:Class . :X a owl:Class . :B a owl:Class . :E a owl:Class . :G a owl:Class .
:r1 rdfs:subPropertyOf :r . :s1 rdfs:subPropertyOf :s .
:X rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r1 ; owl:someValuesFrom :B ] .
:B rdfs:subClassOf :D .
:S rdfs:subClassOf :X . :U rdfs:subClassOf :X .
:U rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :s1 ; owl:hasValue :a ] .
:a a :F .
[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :D ] rdfs:subClassOf :E .
[ a owl:Restriction ; owl:onProperty :s ; owl:someValuesFrom :F ] rdfs:subClassOf :G .
