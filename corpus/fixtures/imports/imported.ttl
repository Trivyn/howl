# The document root.ttl imports (see there).
@prefix :     <http://example.org/t#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/imported> a owl:Ontology .
:C a owl:Class . :a a owl:NamedIndividual .
[ a owl:Restriction ; owl:onProperty :r ; owl:someValuesFrom :B ] rdfs:subClassOf :C .
_:x :r :a .
_:y a owl:Axiom ; owl:annotatedSource :C ; owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedTarget owl:Thing ; rdfs:comment "reified in the import" .
