# A generated ontology (abox_fuzz --sriq, seed 329, TBox only) whose Pred
# products outgrow the clause budget while its store stays small: under
# sriq the choices cap stops it (resource-limit), and auto steps down.
@prefix :     <http://example.org/fuzz#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/fuzz/329-tbox> a owl:Ontology .
:C0 a owl:Class .
:C1 a owl:Class .
:C2 a owl:Class .
:C3 a owl:Class .
:C4 a owl:Class .
:C5 a owl:Class .
:C6 a owl:Class .
:r0 a owl:ObjectProperty .
:r1 a owl:ObjectProperty .
:r2 a owl:ObjectProperty .
:r0 rdfs:subPropertyOf :r1 .
:r0 rdfs:subPropertyOf :r2 .
:r0 a owl:TransitiveProperty .
:r1 owl:propertyChainAxiom ( :r0 :r0 :r0 ) .
:r2 owl:propertyChainAxiom ( :r0 :r1 ) .
:r0 rdfs:range [ a owl:Class ; owl:unionOf ( :C6 :C0 ) ] .
:r1 rdfs:range :C1 .
[ a owl:Restriction ; owl:onProperty :r0 ; owl:allValuesFrom [ a owl:Class ; owl:unionOf ( :C3 :C0 ) ] ] rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( :C1 :C5 ) ] .
[ a owl:Restriction ; owl:onProperty :r1 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :C0 :C6 ) ] ] rdfs:subClassOf :C2 .
[ a owl:Restriction ; owl:onProperty :r0 ; owl:allValuesFrom :C1 ] rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r0 ; owl:someValuesFrom [ a owl:Class ; owl:unionOf ( :C6 :C0 ) ] ] .
[ a owl:Restriction ; owl:onProperty [ owl:inverseOf :r0 ] ; owl:someValuesFrom [ a owl:Restriction ; owl:onProperty :r0 ; owl:allValuesFrom :C1 ] ] rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty :r1 ; owl:allValuesFrom :C2 ] [ a owl:Class ; owl:unionOf ( :C5 :C1 ) ] ) ] .
[ a owl:Restriction ; owl:onProperty :r0 ; owl:allValuesFrom [ a owl:Class ; owl:unionOf ( :C4 :C2 ) ] ] rdfs:subClassOf :C2 .
:C5 rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r2 ; owl:someValuesFrom :C4 ] .
[ a owl:Class ; owl:intersectionOf ( :C0 :C1 ) ] rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r0 ; owl:someValuesFrom [ a owl:Restriction ; owl:onProperty :r1 ; owl:allValuesFrom :C0 ] ] .
:C2 owl:disjointWith :C0 .
