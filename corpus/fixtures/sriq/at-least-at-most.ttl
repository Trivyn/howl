# sriq: AT LEAST against AT MOST. A ⊑ ≥2 r.B and C ⊑ ≤1 r.B, so D ≡ A ⊓ C is
# unsatisfiable; and E ≡ ≥2 r.⊤ subsumes A. Swap the two and both are lost.
# Expect: D unsatisfiable, A ⊑ E.

@prefix :     <http://example.org/t#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/t> a owl:Ontology .
:A a owl:Class . :B a owl:Class . :C a owl:Class . :D a owl:Class . :E a owl:Class .
:r a owl:ObjectProperty .
:A rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:minQualifiedCardinality 2 ; owl:onClass :B ] .
:C rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :r ; owl:maxQualifiedCardinality 1 ; owl:onClass :B ] .
:D owl:equivalentClass [ owl:intersectionOf ( :A :C ) ] .
:E owl:equivalentClass [ a owl:Restriction ; owl:onProperty :r ; owl:minCardinality 2 ] .
