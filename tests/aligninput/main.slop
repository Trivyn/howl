(module aligninputtest
  (import rdf (IRI))
  (import ttl (parse-ttl-string))
  (import termstore (Encoded new-encoded encoded-add encoded-next-document))
  (import aligninput (AlignmentBase alignment-base subset-decoded source-iri-valid))
  (import owl2 (RawAxiom render-axiom))
  (import normalize (Decoded))
  (import types (Fault))

  (fn add ((a Arena) (e (Ptr Encoded)) (text String))
    (@spec ((Arena (Ptr Encoded) String) -> Bool))
    (match (parse-ttl-string a text)
      ((error _) false)
      ((ok g) (do (for-each (t (. g triples)) (encoded-add a e t)) true))))

  (fn prefixes ((a Arena) (body String))
    (@spec ((Arena String) -> String))
    (string-concat a "@prefix : <http://e/> . @prefix owl: <http://www.w3.org/2002/07/owl#> . @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> . @prefix xsd: <http://www.w3.org/2001/XMLSchema#> . " body))

  (fn base ((a Arena) (fixed String) (mapping String))
    (@spec ((Arena String String) -> (Result AlignmentBase Fault)))
    (let ((e (new-encoded a)))
      (do
        (add a e (prefixes a fixed))
        (encoded-next-document a e)
        (add a e (prefixes a mapping))
        (alignment-base a (deref e) (list-new a IRI)
          (list IRI (record-new IRI (value "urn:test:fixed")) (record-new IRI (value "urn:test:mapping")))
          (list Bool false true)))))

  (fn subclass-count ((d Decoded))
    (@spec ((Decoded) -> Int))
    (let ((mut n 0))
      (do (for-each (ax (. d axioms)) (match ax ((ra-sub-class-of _ _) (set! n (+ n 1))) (_ (do)))) n)))

  (fn data-count ((d Decoded))
    (@spec ((Decoded) -> Int))
    (let ((mut n 0))
      (do (for-each (ax (. d axioms)) (match ax ((ra-data-axiom _) (set! n (+ n 1))) (_ (do)))) n)))

  (fn duplicate ((a Arena) (reified-fixed Bool))
    (@spec ((Arena Bool) -> Bool))
    (let ((decl ":A a owl:Class . :B a owl:Class . ")
          (bare ":A rdfs:subClassOf :B .")
          (reified "[] a owl:Axiom; owl:annotatedSource :A; owl:annotatedProperty rdfs:subClassOf; owl:annotatedTarget :B ."))
      (match (base a (string-concat a decl (if reified-fixed reified bare)) (if reified-fixed bare reified))
        ((error _) false)
        ((ok b)
          (and (== (list-len (. b mappings)) 1)
            (match (subset-decoded a b (list Int 0))
              ((error _) false) ((ok d) (== (subclass-count d) 1))))))))

  (fn named-reification ((a Arena))
    (@spec ((Arena) -> Bool))
    (let ((reified ":ax a owl:Axiom; owl:annotatedSource :A; owl:annotatedProperty rdfs:subClassOf; owl:annotatedTarget :B ."))
      (match (base a (string-concat a ":A a owl:Class . :B a owl:Class . " reified) reified)
        ((error _) false)
        ((ok b) (and (== (list-len (. b mappings)) 1)
          (match (subset-decoded a b (list Int 0))
            ((error _) false) ((ok d) (== (subclass-count d) 1))))))))

  (fn annotated-collapse ((a Arena))
    (@spec ((Arena) -> Bool))
    (match (base a ":A a owl:Class . :B a owl:Class ."
      "[] a owl:Axiom; owl:annotatedSource :A; owl:annotatedProperty rdfs:subClassOf; owl:annotatedTarget :B; rdfs:label \"one\" . [] a owl:Axiom; owl:annotatedSource :A; owl:annotatedProperty rdfs:subClassOf; owl:annotatedTarget :B; rdfs:label \"two\" .")
      ((error _) false)
      ((ok b) (and (== (list-len (. b mappings)) 1)
        (match (subset-decoded a b (list Int 0))
          ((error _) false) ((ok d) (== (subclass-count d) 0)))))))

  (fn data-reevaluation ((a Arena))
    (@spec ((Arena) -> Bool))
    (match (base a ":p a owl:DatatypeProperty; rdfs:domain :A . :A a owl:Class ."
                       ":p rdfs:subClassOf :A .")
      ((error _) false)
      ((ok b) (and (== (list-len (. b mappings)) 1)
        (match (subset-decoded a b (list-new a Int)) ((error _) false) ((ok d) (== (data-count d) 1)))
        (match (subset-decoded a b (list Int 0)) ((error _) false) ((ok d) (== (data-count d) 0)))))))

  (fn negative-parts ((a Arena))
    (@spec ((Arena) -> Bool))
    (match (base a ":p a owl:ObjectProperty . :a a owl:NamedIndividual . :b a owl:NamedIndividual ."
                   "[] a owl:NegativePropertyAssertion; owl:sourceIndividual :a; owl:assertionProperty :p; owl:targetIndividual :b .")
      ((error _) false)
      ((ok b) (and (== (list-len (. b mappings)) 1)
        (match (subset-decoded a b (list Int 0))
          ((error _) false) ((ok d) (== (list-len (. d omissions)) 0)))))))

  (fn named-negative ((a Arena))
    (@spec ((Arena) -> Bool))
    (match (base a ":p a owl:ObjectProperty . :a a owl:NamedIndividual . :b a owl:NamedIndividual . :n a owl:NamedIndividual ."
                   ":n a owl:NegativePropertyAssertion; owl:sourceIndividual :a; owl:assertionProperty :p; owl:targetIndividual :b .")
      ((error _) false)
      ((ok b) (and (== (list-len (. b mappings)) 1)
        (match (subset-decoded a b (list Int 0))
          ((error _) false) ((ok d) (== (list-len (. d omissions)) 0)))))))

  (fn canonical-duplicates ((a Arena))
    (@spec ((Arena) -> Bool))
    (match (base a ":A a owl:Class . :B a owl:Class . :C a owl:Class ."
      ":A rdfs:subClassOf [owl:intersectionOf (:B :C)] . :A rdfs:subClassOf [owl:intersectionOf (:C :B)] .")
      ((error _) false)
      ((ok b) (and (== (list-len (. b mappings)) 1)
        (match (subset-decoded a b (list Int 0))
          ((error _) false) ((ok d) (== (subclass-count d) 0)))))))

  (fn unsupported-fixed ((a Arena))
    (@spec ((Arena) -> Bool))
    (match (base a ":p a owl:DatatypeProperty . :a a owl:NamedIndividual ." ":a :p \"hello\" .")
      ((error _) false)
      ((ok b) (and (== (list-len (. b mappings)) 0)
        (match (subset-decoded a b (list-new a Int))
          ((error _) false) ((ok d) (> (data-count d) 0)))))))

  (fn source-isolation ((a Arena))
    (@spec ((Arena) -> Bool))
    (let ((e (new-encoded a)))
      (do
        (add a e (prefixes a ":A a owl:Class . :B a owl:Class ."))
        (encoded-next-document a e) (add a e (prefixes a ":A rdfs:subClassOf :B ."))
        (encoded-next-document a e) (add a e (prefixes a ":A rdfs:subClassOf :B ."))
        (match (alignment-base a (deref e) (list-new a IRI)
                  (list IRI (record-new IRI (value "urn:fixed")) (record-new IRI (value "urn:m1")) (record-new IRI (value "urn:m2")))
                  (list Bool false true true))
          ((error _) false)
          ((ok b) (and (== (list-len (. b mappings)) 2)
            (match (subset-decoded a b (list Int 0)) ((error _) false) ((ok d) (== (subclass-count d) 1)))
            (match (subset-decoded a b (list Int 0 1)) ((error _) false) ((ok d) (== (subclass-count d) 0)))))))))

  (fn shared-structure ((a Arena))
    (@spec ((Arena) -> Bool))
    (match (base a ":A a owl:Class . :B a owl:Class . :C a owl:Class . :p a owl:ObjectProperty ."
                   ":A rdfs:subClassOf _:r . :B rdfs:subClassOf _:r . _:r a owl:Restriction; owl:onProperty :p; owl:someValuesFrom :C .")
      ((error _) false)
      ((ok b) (and (== (list-len (. b mappings)) 2)
        (match (subset-decoded a b (list Int 0)) ((error _) false)
          ((ok d) (and (== (subclass-count d) 1) (== (list-len (. d omissions)) 0))))))))

  (fn declarations-fixed ((a Arena))
    (@spec ((Arena) -> Bool))
    (match (base a "" ":A a owl:Class . :B a owl:Class . :A rdfs:subClassOf :B .")
      ((error _) false)
      ((ok b) (and (== (list-len (. b mappings)) 1)
        (match (subset-decoded a b (list Int 0)) ((error _) false)
          ((ok d) (and (== (list-len (. d axioms)) 2) (== (subclass-count d) 0))))))))

  (fn check ((label String) (ok Bool))
    (@spec ((String Bool) -> Int))
    (do (if ok (print "PASS ") (print "FAIL ")) (println label) (if ok 0 1)))

  (fn main ()
    (@spec (() -> Int))
    :c-name "main"
    (with-arena 16777216
      (+ (check "fixed reified, mapping asserted" (duplicate arena true))
         (check "fixed asserted, mapping reified" (duplicate arena false))
         (check "named reification per document" (named-reification arena))
         (check "annotated occurrences collapse" (annotated-collapse arena))
         (check "data lemma is recomputed" (data-reevaluation arena))
         (check "negative assertion scaffolding removed" (negative-parts arena))
         (check "named assertion parts are owned by assertion" (named-negative arena))
         (check "canonical conjunction identity" (canonical-duplicates arena))
         (check "unsupported RDF remains fixed" (unsupported-fixed arena))
         (check "source identities isolate duplicates" (source-isolation arena))
         (check "shared expression remains for live axiom" (shared-structure arena))
         (check "mapping declarations stay fixed" (declarations-fixed arena))
         (check "source IRIs" (and (source-iri-valid "urn:test:a") (source-iri-valid "https://x/y")
                                 (not (source-iri-valid "relative")) (not (source-iri-valid "urn:bad source"))
                                 (not (source-iri-valid "1urn:x")) (not (source-iri-valid "urn:<x>")))))))
)
