;; ============================================================
;; HOWL CLI  —  SPEC.md §9
;;
;; THE CLI IS A HARNESS, NOT THE PRODUCT. HOWL's first consumer calls
;; it through the FFI behind a reasoner port (§8.4); these commands are
;; for CI, differential testing, and standalone use. Where the two
;; disagree the PORT WINS — in particular the library path always runs
;; non-strict and returns a report, while --strict is a CLI-only
;; affordance. Every command stays a thin wrapper over the same library
;; entry point, so the CLI cannot drift into being a second
;; implementation with its own semantics.
;;
;;   howl validate    <ontology.ttl> [--profile P] [--strict] [--no-imports] [-I FILE]...
;;                    [--report] [--timings] [--max-iterations N] [--workers N]
;;   howl classify    <ontology.ttl> [--reduce] [--emit inferred.ttl]   (flags: M3)
;;   howl unsat       <ontology.ttl>                                    (not yet)
;;   howl align-check <o1.ttl> <o2.ttl> <mappings.ttl> [--repair]       (M4)
;;   howl explain     <ontology.ttl> --sub A B                          (post-M4)
;;
;; `-I` TAKES A FILE, NOT A DIRECTORY. It is the caller's attestation
;; that a document IS a declared import, so the caller names exactly
;; what it vouches for; a directory scan would attest whatever happens
;; to sit there, and would need a platform-specific `dirent` binding.
;;
;; EXIT CODES ARE §6.2'S VERDICT TABLE, VERBATIM. A CI gate must
;; distinguish "checked, fine" from "couldn't check", and must not
;; downgrade a real finding just because coverage was partial:
;;
;;   0  COHERENT      not incoherent, omitted empty, fixpoint reached
;;   1  INCOHERENT    inconsistent OR any unsatisfiable named class,
;;                    REGARDLESS of coverage or termination
;;   2  INCONCLUSIVE  not incoherent but omitted non-empty or no
;;                    fixpoint, OR Fault::cancelled, OR Fault::refused
;;   3  ERROR         Fault::input-error, Fault::unavailable (a profile
;;                    not built yet), or CLI usage failure
;;
;; The table is over `Result<Outcome, Fault>`, not over Outcome alone —
;; an earlier draft defined every code in terms of an Outcome, leaving
;; faults with no defined exit code even though the test plan asserts
;; them.
;;
;; `cancelled` and `refused` both map to 2 because both are precisely
;; inconclusive: the ontology may be perfectly coherent and no verdict
;; was reached. Both print no report body. `input-error` stays on 3
;; with usage failures, because a file that will not parse is a
;; different kind of problem from a theory that could not be decided.
;;
;; THE SUBTLE ROW IS 1. Monotonicity means a ⊥ derived from part of the
;; ontology is a ⊥ in all of it, so a finding under partial coverage is
;; a DEFINITIVE failure, not a provisional one. Reporting it as
;; inconclusive would discard a sound result. The reverse — treating
;; absence of findings under partial coverage as success — is the
;; hazard exit 2 exists for.
;;
;; So 2 must not be folded into either neighbour. Into 0 it gives CI a
;; false pass; into 1 it makes every ontology with an unsupported
;; construct look broken and trains users to ignore the gate. A CI
;; CONFIGURATION THAT TREATS 2 AS SUCCESS REINTRODUCES EXACTLY THE
;; HAZARD THE GATE EXISTS TO PREVENT — document 0 alone as the pass
;; condition.
;;
;; EXIT 1 IS KEYED TO INCOHERENCE, NOT INCONSISTENCY, which is what
;; `validate` advertises. An ontology with an unsatisfiable named class
;; exits 1 even though it may be perfectly consistent. This is a
;; deliberate divergence from the port, where `consistent` means
;; `!inconsistent` and unsatisfiable classes ride in their own field
;; for a consumer that distinguishes them downstream. A CLI gate has
;; one bit to spend and should spend it on the weaker, more useful
;; condition.
;; ============================================================

(module main
  (@doc "CLI harness for the HOWL description-logic reasoner")

  (import rdf (IRI Triple Term BlankNode make-blank make-triple make-triple-term
               term-eq make-iri))
  (import types (Outcome Fault Omission ReasonerConfig Profile ProfileSelection Verdict verdict default-config
                 copy-fault))
  (import owl2 (render-omission))
  (import howl (Decoded decode-from own-decoded Prepared prepare-decoded reason))
  (import termstore (Encoded new-encoded encoded-add encoded-next-document triple-of))
  (import report (report-lines))
  (import select (profile-name parse-profile))
  (import strlib (parse-int is-digit char-at))
  (import ttl (parse-ttl-file-for-each-triple))
  (import vocab (RDF_TYPE OWL_ONTOLOGY))
  (import canon (string-cmp))

  (ffi "string.h"
    (strlen ((s (Ptr U8))) U64))

  ;; For `peak-mb`'s getrusage. An ffi block emits only the #include; the
  ;; call itself is c-inline, since `struct rusage` has no SLOP type.
  (ffi "sys/resource.h"
    (getrusage ((who Int) (usage (Ptr U8))) Int))

  ;; ============================================================
  ;; Exit codes (§9) — the verdict table in the CLI's dialect
  ;; ============================================================

  (const EXIT_COHERENT     Int 0)
  (const EXIT_INCOHERENT   Int 1)
  (const EXIT_INCONCLUSIVE Int 2)
  (const EXIT_ERROR        Int 3)

  (fn exit-code-for ((r (Result Outcome Fault)))
    (@intent "Map a classify result to its CLI exit code — §6.2's table, in this dialect")
    (@spec (((Result Outcome Fault)) -> Int))
    ;; This function is the ONLY place the CLI decides a verdict. It
    ;; delegates the Outcome case to `verdict` rather than re-deriving
    ;; the rule, so the CLI cannot drift from the library.
    ;;
    ;; The exit code is the contract CI actually consumes, so pin it
    ;; here rather than trusting the match arms to stay aligned. The
    ;; codes are bounded and total, and NO FAULT MAY EVER YIELD 0 —
    ;; every route through the error path is either "could not check"
    ;; (2) or "could not run" (3), and a fault that exited 0 would be
    ;; the false pass arriving through the error path rather than the
    ;; reasoning path.
    (@post {$result >= 0})
    (@post {$result <= 3})
    (@post (match r
             ((ok o) {$result <= 2})
             ((error f) (match f
                          ((cancelled)     {$result == 2})
                          ((refused _)     {$result == 2})
                          ((input-error _) {$result == 3})
                          ((unavailable _) {$result == 3})))))
    ;; The arms below return INTEGER LITERALS rather than the EXIT_*
    ;; constants declared above, and that is not an oversight. `const`
    ;; bindings are opaque to the WP checker — with the named form the
    ;; postconditions fail on a counterexample of `$result = 4`, because
    ;; nothing tells the prover what EXIT_ERROR is. Literals here buy a
    ;; proof of the exact table CI depends on; the names survive in the
    ;; declarations above, in the header table, and in `main`.
    (match r
      ((ok o)
        (match (verdict o)
          ('verdict-coherent     0)
          ('verdict-incoherent   1)
          ('verdict-inconclusive 2)))
      ((error f)
        (match f
          ;; A cancelled run has no reproducible partial state to show,
          ;; and --strict's refusal reached no verdict. Both are
          ;; inconclusive; they differ only in the diagnostic line,
          ;; which is correct — the VERDICT is identical.
          ((cancelled)     2)
          ((refused _)     2)
          ((input-error _) 3)
          ;; Nothing ran: the caller asked for a calculus that is not
          ;; built. That is a usage failure, not an undecided theory.
          ((unavailable _) 3)))))


  ;; ============================================================
  ;; Loading: each document streamed into one encoded document
  ;;
  ;; A document is parsed with slop-rdf's streaming parser straight into
  ;; HOWL's encoded form (termstore.slop, Encoded): no list of slop-rdf
  ;; Triples is ever built, and the parser's memory - the file text and
  ;; every term's strings - is freed as soon as the parse returns, since
  ;; the encoding owns copies of what it keeps.
  ;;
  ;; BLANK NODES ARE STANDARDIZED APART PER DOCUMENT. The Turtle parser
  ;; restarts its blank counter at 0 for every parse, so two documents
  ;; both using `_:x` arrive with the same id, and merging them by
  ;; concatenation would WELD UNRELATED NODES TOGETHER; RDF merge renames
  ;; them apart. `encoded-next-document` begins each import with its blank
  ;; ids shifted past every id already encoded. This lives with loading
  ;; because `classify` receives one flat triple list and never sees
  ;; document boundaries (§8.5 A1); loading is the last place that knows.
  ;; ============================================================

  (fn parse-into ((arena Arena) (enc (Ptr Encoded)) (path String))
    (@intent "Stream one Turtle file into the encoded document; false when it cannot be parsed")
    (@spec ((Arena (Ptr Encoded) String) -> Bool))
    (@alloc arena)
    ;; The callback only calls `encoded-add`, and captures `arena` and
    ;; `enc` - both immutable, so both by value: a closure capturing a
    ;; `mut` local gets its address, and a push onto a captured list would
    ;; grow a copy of its header, silently (slop#193).
    (let ((parse (arena-new 16777216))
          (ok    (match (parse-ttl-file-for-each-triple parse path
                          (fn ((t Triple)) (encoded-add arena enc t)))
                   ((ok _)    true)
                   ((error _) false))))
      (do
        (arena-free parse)
        ok)))

  (fn ontology-iri-from ((e Encoded) (from Int))
    (@intent "The IRI asserted to be an owl:Ontology among the triples from index `from` on, if there is one")
    (@spec ((Encoded Int) -> (Option IRI)))
    ;; The LAST such IRI in document order, as always.
    (let ((mut found (Option IRI) (none))
          (mut k 0))
      (do
        (for-each (it (. e triples))
          (do
            (when (>= k from)
              (let ((t (triple-of (. e dict) it)))
                (match (. t predicate)
                  ((term-iri p)
                    (when (== (string-cmp (. p value) RDF_TYPE) 0)
                      (match (. t object)
                        ((term-iri o)
                          (when (== (string-cmp (. o value) OWL_ONTOLOGY) 0)
                            (match (. t subject)
                              ((term-iri sub) (set! found (some sub)))
                              (_ (do)))))
                        (_ (do)))))
                  (_ (do)))))
            (set! k (+ k 1))))
        found)))

  ;; ============================================================
  ;; Argument handling
  ;; ============================================================

  (fn argv-to-string ((argv (Ptr (Ptr U8))) (index Int))
    (@intent "Convert argv[index] to a SLOP String")
    (@spec (((Ptr (Ptr U8)) Int) -> String))
    (let ((ptr (@ argv index)))
      (String ptr (strlen ptr))))

  (fn print-usage ()
    (@intent "Print the command surface")
    (@spec (() -> Unit))
    (do
      (println "HOWL — a consequence-based description-logic reasoner")
      (println "")
      (println "USAGE:")
      (println "  howl validate    <ontology.ttl> [--profile P] [--strict] [--no-imports] [-I FILE]...")
      (println "  howl classify    <ontology.ttl>          (--reduce, --emit: not until M3)")
      (println "")
      (println "  -I FILE    attest FILE as a declared owl:Imports target; repeatable")
      (println "  --profile P  the calculus: el (default), el++, horn-sriq, sriq, or auto;")
      (println "               el and el++ are implemented, and horn-sriq and sriq exit 3;")
      (println "               auto runs el, or el++ when it omits fewer axioms")
      (println "  --strict   refuse to run past any omission (exit 2, no report)")
      (println "  --report   print the canonical report instead of the summary")
      (println "  --timings  print phase durations and peak memory on stderr (never part of a report)")
      (println "  --max-iterations N   the round budget, 0..10000 (default 1000)")
      (println "  --workers N          threads joining each round, 1..64 (default 4); never changes the report")
      (println "")
      (println "EXIT CODES:")
      (println "  0  coherent       checked, no incoherence found")
      (println "  1  incoherent     inconsistent, or an unsatisfiable named class")
      (println "  2  inconclusive   could not check completely — NOT a pass")
      (println "  3  error          usage, parse, or I/O failure")
      (println "")
      (println "Treat 0 alone as the pass condition. A CI job that accepts 2")
      (println "reintroduces the silent-false-pass hazard the gate exists to prevent.")))

  (fn eprint ((s String))
    (@intent "Write a string to stderr")
    (@spec ((String) -> Unit))
    ;; SLOP's `print` only reaches stdout, and stdout is where the
    ;; canonical report goes. Anything that is NOT a function of the
    ;; input — a timing above all — must never share that stream, or a
    ;; `--report | shasum` comparison across two correct runs differs.
    ;;
    ;; `c-inline` rather than an `ffi` binding of write(2): a function
    ;; named `write` resolves to std file's `FileMode` variant of the same
    ;; name and transpiles to an enum initializer, not a call. `s` is the
    ;; C parameter name, as `config` is in saturate.slop's cancel check.
    (c-inline "fwrite(s.data, 1, s.len, stderr);"))

  (fn print-timings ((arena Arena) (t0 Int) (t1 Int) (t2 Int) (t3 Int) (t4 Int))
    (@intent "Phase durations on stderr: parse, decode, rest of the front end, reasoning, total")
    (@spec ((Arena Int Int Int Int Int) -> Unit))
    (@alloc arena)
    ;; THE CLOCK IS READ IN THE CLI AND NOWHERE ELSE. HOWL never consults
    ;; a clock inside a reasoning call (§6.8); `make test` fails if one
    ;; appears under src/. `prepare_ms + reason_ms` - axioms in hand to
    ;; taxonomy - is the classification figure §12 M1 (c) compares against
    ;; ELK (bench/bench.py); `decode_ms` (encoded triples to axioms, owned
    ;; and the input's arena freed) is reported beside it. `parse_ms` includes encoding: the Turtle is
    ;; streamed straight into the encoded document. `total_ms` is parse
    ;; through reasoning: the clock stops before the report is rendered
    ;; and printed.
    (eprint
      (string-concat arena "timing parse_ms="
        (string-concat arena (int-to-string arena (- t1 t0))
          (string-concat arena " decode_ms="
            (string-concat arena (int-to-string arena (- t2 t1))
              (string-concat arena " prepare_ms="
                (string-concat arena (int-to-string arena (- t3 t2))
                  (string-concat arena " reason_ms="
                    (string-concat arena (int-to-string arena (- t4 t3))
                      (string-concat arena " total_ms="
                        (string-concat arena (int-to-string arena (- t4 t0)) "\n"))))))))))))

  (fn peak-mb ()
    (@intent "The process's peak resident set so far, in MB")
    (@spec (() -> Int))
    ;; A HIGH-WATER MARK (ru_maxrss), never current usage: freeing memory
    ;; does not lower it, so each figure in the memory line is the peak
    ;; reached by the end of that phase. ru_maxrss is bytes on macOS and
    ;; kilobytes on Linux.
    (let ((mut mb 0))
      (do
        (c-inline "{ struct rusage ru; getrusage(RUSAGE_SELF, &ru);\n#ifdef __APPLE__\n mb = (int64_t)(ru.ru_maxrss / 1048576);\n#else\n mb = (int64_t)(ru.ru_maxrss / 1024);\n#endif\n }")
        mb)))

  (fn print-memory ((arena Arena) (m1 Int) (m2 Int) (m3 Int) (m4 Int) (m5 Int))
    (@intent "Peak memory at the end of each phase on stderr: parse, decode, prepare, reasoning, report")
    (@spec ((Arena Int Int Int Int Int) -> Unit))
    (@alloc arena)
    ;; Read at the same points as the timing clock, plus once after the
    ;; report is written. Like the timings it is a CLI measurement and
    ;; never part of a report.
    (eprint
      (string-concat arena "memory parse_mb="
        (string-concat arena (int-to-string arena m1)
          (string-concat arena " decode_mb="
            (string-concat arena (int-to-string arena m2)
              (string-concat arena " prepare_mb="
                (string-concat arena (int-to-string arena m3)
                  (string-concat arena " reason_mb="
                    (string-concat arena (int-to-string arena m4)
                      (string-concat arena " report_mb="
                        (string-concat arena (int-to-string arena m5) "\n"))))))))))))

  (fn all-digits ((s String))
    (@intent "Non-empty, and every byte an ASCII digit — the only shape a budget may take")
    (@spec ((String) -> Bool))
    (@pure)
    ;; `parse-int` accepts a numeric PREFIX: "5garbage", "12abc" and "5 "
    ;; all parse, as 5, 12 and 5. A malformed budget would then run a
    ;; different capped classification than the caller wrote, and exit as
    ;; though the flag had been understood. So the whole argument is
    ;; checked here first, and a sign is refused as well: a budget is a
    ;; count, and the range check below starts at 0.
    (let ((mut ok (> (string-len s) 0))
          (mut i 0))
      (do
        (while (and ok (< i (string-len s)))
          (do
            (when (not (is-digit (char-at s i))) (set! ok false))
            (set! i (+ i 1))))
        ok)))

  (fn decode-held ((held Arena) (front Arena) (doc Encoded) (resolved (List IRI)))
    (@intent "Decode the encoded input into an owned copy in `held`, then free the input's arena")
    (@spec ((Arena Arena Encoded (List IRI)) -> (Result Decoded Fault)))
    (@alloc held)
    ;; This IS `howl.decode-owned`, split so the parse can stream into
    ;; `front` first. `front` holds the encoded documents and the decode's
    ;; working memory; nothing in the result points into it, so it is freed
    ;; here, before the gate starts.
    (let ((res (own-decoded held (decode-from front doc resolved))))
      (do
        (arena-free front)
        res)))

  (fn prepare-from ((arena Arena) (held Arena) (d (Result Decoded Fault)) (config ReasonerConfig))
    (@intent "Finish the front end over a decode, then free the decode's arena")
    (@spec ((Arena Arena (Result Decoded Fault) ReasonerConfig) -> (Result Prepared Fault)))
    (@alloc arena)
    ;; This IS the rest of `howl.prepare`, split so decode can be timed
    ;; apart. `held` holds the owned Decoded; nothing in the result points
    ;; into it (a Prepared owns its strings, and a decode fault is copied
    ;; out), so it is freed here, before reasoning starts.
    ;; The `ok` arm comes first: slop types a match's result from its first
    ;; arm, and an `error` arm first leaves the ok type void in the C.
    (let ((res (match d
                 ((ok dd)   (prepare-decoded arena dd config))
                 ((error f) (error (copy-fault arena f))))))
      (do
        (arena-free held)
        res)))

  (fn reason-prepared ((arena Arena) (p (Result Prepared Fault)) (config ReasonerConfig))
    (@intent "Reason over a successful front end; pass a front-end fault straight through")
    (@spec ((Arena (Result Prepared Fault) ReasonerConfig) -> (Result Outcome Fault)))
    (@alloc arena)
    ;; This IS `howl.classify`, split so the halves can be timed. With
    ;; `prepare-from` it adds nothing between them, so the timed path
    ;; cannot drift from the port's path.
    (match p
      ((error f) (error f))
      ((ok pp)   (reason arena pp config))))

  (fn print-omissions ((arena Arena) (os (List Omission)))
    (@intent "List every omission, one per line")
    (@spec ((Arena (List Omission)) -> Unit))
    (@alloc arena)
    (do
      (for-each (o os)
        (do (print "  omitted: ") (println (render-omission arena o))))))

  (fn main ((argc Int) (argv (Ptr (Ptr U8))))
    (@intent "CLI entry point: load, run the library, map the result to an exit code")
    (@spec ((Int (Ptr (Ptr U8))) -> Int))
    :c-name "main"
    ;; EVERY ARGUMENT IS UNDERSTOOD OR REFUSED. An ignored flag is a false
    ;; pass waiting to happen: a `validate --strict` that quietly ran
    ;; non-strict exits 2 on an out-of-profile ontology, and whoever wrote
    ;; the CI line believes the run refused. Unknown commands, unknown
    ;; arguments and unimplemented flags all exit 3.
    (with-arena 268435456
      (if (< argc 3)
        (do (print-usage) EXIT_ERROR)
        (let ((command (argv-to-string argv 1)))
          (if (not (or (string-eq command "validate") (string-eq command "classify")))
            (do (print "howl: unknown or unimplemented command: ") (println command)
                EXIT_ERROR)
            (let ((front        (arena-new 16777216))   ; the encoded input and its decode: freed after decode
                  (enc          (new-encoded front))
                  (mut resolved (list-new arena IRI))
                  (mut cfg      (default-config))
                  (mut failed   false)
                  (mut i 3)
                  (mut report-mode false)
                  (mut timings false)
                  (t-start (now-ms))
                  (input (argv-to-string argv 2)))
              (do
                ;; The root document.
                (when (not (parse-into front enc input))
                  (do (print "howl: cannot parse ") (println input) (set! failed true)))

                (while (< i argc)
                  (let ((arg (argv-to-string argv i))
                        (mut step 1)
                        (mut known false))
                    (do
                      ;; -I FILE: load an imported document and ATTEST it.
                      ;; The attestation is what turns a declared owl:imports
                      ;; from an omission into resolved coverage — HOWL never
                      ;; fetches anything itself, so an unattested import
                      ;; stays a coverage gap and the run stays inconclusive.
                      (when (string-eq arg "-I")
                        (do
                          (set! known true)
                          (set! step 2)
                          (when (>= (+ i 1) argc)
                            (do (println "howl: -I needs a FILE") (set! failed true)))
                          (when (< (+ i 1) argc)
                            (let ((path (argv-to-string argv (+ i 1)))
                                  (from (cast Int (list-len (. (deref enc) triples)))))
                              (do
                                (encoded-next-document front enc)
                                (if (not (parse-into front enc path))
                                  (do (print "howl: cannot parse import ") (println path)
                                      (set! failed true))
                                  (match (ontology-iri-from (deref enc) from)
                                    ;; A document naming no ontology attests
                                    ;; NOTHING, yet its triples would still be
                                    ;; merged — the import it was meant to
                                    ;; resolve stays an omission, and nobody
                                    ;; is told why. The run fails, so the
                                    ;; triples already encoded never decode.
                                    ((none)
                                      (do (print "howl: import declares no owl:Ontology IRI, so it attests nothing: ")
                                          (println path)
                                          (set! failed true)))
                                    ((some o) (list-push resolved o)))))))))

                      (when (string-eq arg "--strict")
                        (do (set! known true) (set! cfg strict-profile true)))

                      ;; §9: asserts DELIBERATE omission of imports. Unattested
                      ;; imports are already recorded as omitted, so this
                      ;; changes intent and nothing else — and in particular it
                      ;; can never turn an incomplete run into a coherent one.
                      (when (string-eq arg "--no-imports")
                        (set! known true))

                      (when (string-eq arg "--profile")
                        (do
                          (set! known true)
                          (set! step 2)
                          (when (>= (+ i 1) argc)
                            (do (println "howl: --profile needs a profile: auto, el, el++, horn-sriq or sriq")
                                (set! failed true)))
                          ;; Every rung's NAME is accepted here; whether it
                          ;; can run is the library's answer (Fault::unavailable),
                          ;; so the CLI and the port refuse the same requests.
                          (when (< (+ i 1) argc)
                            (let ((p (argv-to-string argv (+ i 1))))
                              (if (string-eq p "auto")
                                (set! cfg selection (union-new ProfileSelection auto))
                                (match (parse-profile p)
                                  ((some q) (set! cfg selection (union-new ProfileSelection explicit q)))
                                  ((none)
                                    (do (print "howl: unknown profile: ") (print p)
                                        (println " (expected auto, el, el++, horn-sriq or sriq)")
                                        (set! failed true)))))))))

                      (when (string-eq arg "--report")
                        (do (set! known true) (set! report-mode true)))

                      (when (string-eq arg "--timings")
                        (do (set! known true) (set! timings true)))

                      ;; The round budget (§6.8): `max-iterations = n` permits n
                      ;; completed rounds, and 0 always yields resource-limit.
                      ;; Out of range is refused rather than clamped — a clamped
                      ;; budget is a run the caller did not ask for.
                      (when (string-eq arg "--max-iterations")
                        (do
                          (set! known true)
                          (set! step 2)
                          (when (>= (+ i 1) argc)
                            (do (println "howl: --max-iterations needs N (0..10000)") (set! failed true)))
                          (when (< (+ i 1) argc)
                            (let ((v (argv-to-string argv (+ i 1))))
                              (if (not (all-digits v))
                                (do (println "howl: --max-iterations needs a whole number 0..10000") (set! failed true))
                                (match (parse-int v)
                                  ((ok n)
                                    (if (<= n 10000)
                                      (set! cfg max-iterations (cast Int n))
                                      (do (println "howl: --max-iterations must be 0..10000") (set! failed true))))
                                  ((error _)
                                    (do (println "howl: --max-iterations needs a whole number 0..10000") (set! failed true)))))))))

                      ;; Worker count (§6.8): how many threads join each round.
                      ;; It can change only speed, never the report — the
                      ;; round is the same at every W, capped runs included
                      ;; (M1 (e); `make determinism` checks it). Refused
                      ;; outside 1..64, never clamped, like the round budget.
                      (when (string-eq arg "--workers")
                        (do
                          (set! known true)
                          (set! step 2)
                          (when (>= (+ i 1) argc)
                            (do (println "howl: --workers needs N (1..64)") (set! failed true)))
                          (when (< (+ i 1) argc)
                            (let ((v (argv-to-string argv (+ i 1))))
                              (if (not (all-digits v))
                                (do (println "howl: --workers needs a whole number 1..64") (set! failed true))
                                (match (parse-int v)
                                  ((ok n)
                                    (if (and (>= n 1) (<= n 64))
                                      (set! cfg worker-count (cast Int n))
                                      (do (println "howl: --workers must be 1..64") (set! failed true))))
                                  ((error _)
                                    (do (println "howl: --workers needs a whole number 1..64") (set! failed true)))))))))

                      (when (or (string-eq arg "--emit") (string-eq arg "--reduce"))
                        (do
                          (set! known true)
                          (when (string-eq arg "--emit") (set! step 2))
                          (print "howl: ") (print arg) (println " is not implemented until M3")
                          (set! failed true)))

                      (when (not known)
                        (do (print "howl: unknown argument: ") (println arg) (set! failed true)))

                      (set! i (+ i step)))))

                (if failed
                  EXIT_ERROR
                  (let ((t-parsed   (now-ms))
                        (m-parsed   (peak-mb))
                        (held       (arena-new 16777216))   ; the owned Decoded: freed after prepare
                        (decoded    (decode-held held front (deref enc) resolved))
                        (t-decoded  (now-ms))
                        (m-decoded  (peak-mb))
                        (prepared   (prepare-from arena held decoded cfg))
                        (t-prepared (now-ms))
                        (m-prepared (peak-mb))
                        (result     (reason-prepared arena prepared cfg))
                        (t-reasoned (now-ms))
                        (m-reasoned (peak-mb)))
                    (do
                      (when timings
                        (print-timings arena t-start t-parsed t-decoded t-prepared t-reasoned))
                      (match result
                        ((ok o)
                          (if report-mode
                            (for-each (l (report-lines arena o)) (println l))
                          (do
                            (print "howl: ")
                            (print (int-to-string arena
                                     (cast Int (list-len (. (. o findings) subsumptions)))))
                            (print " subsumptions, ")
                            (print (int-to-string arena
                                     (cast Int (list-len (. (. o findings) unsatisfiable)))))
                            (print " unsatisfiable, ")
                            (print (int-to-string arena
                                     (cast Int (list-len (. (. o coverage) omitted)))))
                            (println " omitted")
                            (print-omissions arena (. (. o coverage) omitted))
                            (match (verdict o)
                              ('verdict-coherent     (println "howl: coherent"))
                              ('verdict-incoherent   (println "howl: INCOHERENT"))
                              ;; Spelled out, because 2 is the code a CI
                              ;; job is most tempted to accept as a pass.
                              ('verdict-inconclusive
                                (println "howl: INCONCLUSIVE — coverage gaps, this is NOT a pass"))))))
                        ((error f)
                          (match f
                            ((input-error msg) (do (print "howl: ") (println msg)))
                            ((cancelled)       (println "howl: cancelled"))
                            ((unavailable p)
                              (do (print "howl: profile ") (print (profile-name p))
                                  (println " is not implemented yet (implemented: el, el++)")))
                            ;; §9: the refused omissions are listed, and there
                            ;; is NO report body — no counts a reader could
                            ;; mistake for a partial result.
                            ((refused os)
                              (do (print "howl: refused (--strict), no report — ")
                                  (print (int-to-string arena (cast Int (list-len os))))
                                  (println " omitted")
                                  (print-omissions arena os))))))
                      (when timings
                        (print-memory arena m-parsed m-decoded m-prepared m-reasoned (peak-mb)))
                      (exit-code-for result))))))))))))
