;; The align-check harness delegates both classification and search to howl.align-encoded.
(module aligncli
  (import rdf (IRI Triple))
  (import types (Fault Outcome ProfileSelection verdict default-config))
  (import howl (AlignmentOutcome RepairOptions align-encoded default-repair-options release-outcome))
  (import alignmentreport (alignment-lines))
  (import aligninput (source-iri-valid))
  (import report (report-lines))
  (import termstore (Encoded new-encoded encoded-add encoded-next-document triple-of))
  (import select (parse-profile unavailable-message))
  (import strlib (parse-int is-digit char-at))
  (import ttl (parse-ttl-file-for-each-triple))
  (import vocab (RDF_TYPE OWL_ONTOLOGY))
  (import canon (string-cmp))
  (export align-main)

  (ffi "string.h" (strlen ((s (Ptr U8))) U64))
  (ffi "sys/resource.h" (getrusage ((who Int) (usage (Ptr U8))) Int))

  (fn peak-mb ()
    (@spec (() -> Int))
    (let ((mut mb 0))
      (do
        (c-inline "{ struct rusage ru; getrusage(RUSAGE_SELF, &ru);\n#ifdef __APPLE__\n mb = (int64_t)(ru.ru_maxrss / 1048576);\n#else\n mb = (int64_t)(ru.ru_maxrss / 1024);\n#endif\n }")
        mb)))

  (fn arg ((argv (Ptr (Ptr U8))) (i Int))
    (@spec (((Ptr (Ptr U8)) Int) -> String))
    (let ((p (@ argv i))) (String p (strlen p))))

  ;; `path` is an argv string and is therefore NUL terminated. Resolve it
  ;; once at the filesystem boundary; percent encoding makes the source an
  ;; absolute file IRI independent of the spelling used to reach the file.
  (fn file-source ((a Arena) (path String))
    (@spec ((Arena String) -> String))
    (@alloc a)
    (let ((mut out String ""))
      (do
        (c-inline "{\n#ifdef _WIN32\n char *abs = _fullpath(NULL, path.data, 0);\n#else\n char *abs = realpath(path.data, NULL);\n#endif\n if (abs) {\n   size_t n = strlen(abs), k = 0;\n   char *buf = (char*)slop_arena_alloc(a, 8 + 3*n + 1);\n   const char *prefix =\n#ifdef _WIN32\n     \"file:///\";\n#else\n     \"file://\";\n#endif\n   size_t pn = strlen(prefix); memcpy(buf, prefix, pn); k = pn;\n   for (size_t i = 0; i < n; i++) {\n     unsigned char c = (unsigned char)abs[i];\n     if (c == '\\\\') c = '/';\n     if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||\n         (c >= '0' && c <= '9') || c == '-' || c == '.' || c == '_' ||\n         c == '~' || c == '/' || c == ':') buf[k++] = (char)c;\n     else { static const char hex[] = \"0123456789ABCDEF\";\n            buf[k++] = '%'; buf[k++] = hex[c >> 4]; buf[k++] = hex[c & 15]; }\n   }\n   buf[k] = 0; out = (slop_string){k, buf}; free(abs);\n }\n}")
        out)))

  (fn parse-into ((arena Arena) (enc (Ptr Encoded)) (path String))
    (@spec ((Arena (Ptr Encoded) String) -> Bool))
    (@alloc arena)
    (let ((scratch (arena-new 16777216))
          (ok (match (parse-ttl-file-for-each-triple scratch path
                       (fn ((t Triple)) (encoded-add arena enc t)))
                ((ok _) true) ((error _) false))))
      (do (arena-free scratch) ok)))

  (fn ontology-iri-from ((e Encoded) (from Int))
    (@spec ((Encoded Int) -> (Option IRI)))
    (let ((mut found (Option IRI) (none)) (mut k 0))
      (do
        (for-each (it (. e triples))
          (do
            (when (>= k from)
              (let ((t (triple-of (. e dict) it)))
                (match (. t predicate)
                  ((term-iri p)
                    (when (== (string-cmp (. p value) RDF_TYPE) 0)
                      (match (. t object)
                        ((term-iri o)
                          (when (== (string-cmp (. o value) OWL_ONTOLOGY) 0)
                            (match (. t subject)
                              ((term-iri sub) (set! found (some sub)))
                              (_ (do)))))
                        (_ (do)))))
                  (_ (do)))))
            (set! k (+ k 1))))
        found)))

  (fn all-digits ((s String))
    (@spec ((String) -> Bool))
    (let ((mut yes (> (string-len s) 0)) (mut i 0))
      (do
        (while (and yes (< i (string-len s)))
          (do (when (not (is-digit (char-at s i))) (set! yes false)) (set! i (+ i 1))))
        yes)))

  (fn whole-number ((s String))
    (@spec ((String) -> (Option Int)))
    (if (not (all-digits s)) (none)
      (match (parse-int s)
        ((ok n) (if (>= n 0) (some n) (none)))
        ((error _) (none)))))

  (fn print-fault ((a Arena) (f Fault))
    (@spec ((Arena Fault) -> Unit))
    (match f
      ((cancelled) (println "howl: cancelled"))
      ((input-error m) (do (print "howl: ") (println m)))
      ((unavailable p) (do (print "howl: ") (println (unavailable-message a p))))
      ((refused os)
        (do (print "howl: refused (--strict), no report — ")
            (print (int-to-string a (cast Int (list-len os))))
            (println " omitted")))))

  (fn fault-exit ((f Fault))
    (@spec ((Fault) -> Int))
    (match f ((cancelled) 2) ((refused _) 2) ((input-error _) 3) ((unavailable _) 3)))

  (fn outcome-exit ((o Outcome))
    (@spec ((Outcome) -> Int))
    (match (verdict o)
      ('verdict-coherent 0) ('verdict-incoherent 1) ('verdict-inconclusive 2)))

  (fn source-of ((a Arena) (path String) (override String))
    (@spec ((Arena String String) -> String))
    (if (> (string-len override) 0) override (file-source a path)))

  (fn align-main ((argc Int) (argv (Ptr (Ptr U8))))
    (@intent "Load three named documents and call the shared alignment service")
    (@spec ((Int (Ptr (Ptr U8))) -> Int))
    (with-arena 268435456
      (if (< argc 5)
        (do (println "howl align-check: expected LEFT.ttl RIGHT.ttl MAPPINGS.ttl") 3)
        (let ((a (arena-new 16777216))
              (enc (new-encoded a))
              (left (arg argv 2)) (right (arg argv 3)) (mapping (arg argv 4))
              (mut left-source "") (mut right-source "") (mut mapping-source "")
              (mut imports (list-new arena String))
              (mut resolved (list-new arena IRI))
              (mut sources (list-new arena IRI))
              (mut mapping-docs (list-new arena Bool))
              (mut cfg (default-config))
              (mut limits (default-repair-options))
              (mut repair false) (mut report-mode false) (mut timings false)
              (mut failed false) (mut i 5) (mut k 0)
              (start (now-ms)))
          (do
            (while (< i argc)
              (let ((flag (arg argv i)) (mut step 1))
                (do
                  (cond
                    ((string-eq flag "--repair") (set! repair true))
                    ((string-eq flag "--report") (set! report-mode true))
                    ((string-eq flag "--strict") (set! cfg strict-profile true))
                    ((string-eq flag "--timings") (set! timings true))
                    ((or (string-eq flag "-I")
                         (string-eq flag "--left-source")
                         (string-eq flag "--right-source")
                         (string-eq flag "--mapping-source")
                         (string-eq flag "--profile")
                         (string-eq flag "--workers")
                         (string-eq flag "--max-iterations")
                         (string-eq flag "--conflict-calls")
                         (string-eq flag "--conflict-nodes")
                         (string-eq flag "--hitting-nodes")
                         (string-eq flag "--verification-calls"))
                      (do
                        (set! step 2)
                        (if (>= (+ i 1) argc)
                          (do (print "howl align-check: missing value for ") (println flag) (set! failed true))
                          (let ((value (arg argv (+ i 1))))
                            (cond
                              ((string-eq flag "-I") (list-push imports value))
                              ((string-eq flag "--left-source") (set! left-source value))
                              ((string-eq flag "--right-source") (set! right-source value))
                              ((string-eq flag "--mapping-source") (set! mapping-source value))
                              ((string-eq flag "--profile")
                                (if (string-eq value "auto")
                                  (set! cfg selection (union-new ProfileSelection auto))
                                  (match (parse-profile value)
                                    ((some p) (set! cfg selection (union-new ProfileSelection explicit p)))
                                    ((none) (do (println "howl align-check: unknown profile") (set! failed true))))))
                              (else
                                (match (whole-number value)
                                  ((none) (do (print "howl align-check: invalid number for ") (println flag) (set! failed true)))
                                  ((some n)
                                    (cond
                                      ((string-eq flag "--workers")
                                        (if (and (>= n 1) (<= n 64))
                                          (set! cfg worker-count (cast Int n))
                                          (do (println "howl align-check: --workers must be 1..64")
                                              (set! failed true))))
                                      ((string-eq flag "--max-iterations")
                                        (if (<= n 10000) (set! cfg max-iterations (cast Int n))
                                          (do (println "howl align-check: --max-iterations must be 0..10000")
                                              (set! failed true))))
                                      ((string-eq flag "--conflict-calls") (set! limits conflict-calls n))
                                      ((string-eq flag "--conflict-nodes") (set! limits conflict-nodes n))
                                      ((string-eq flag "--hitting-nodes") (set! limits hitting-nodes n))
                                      ((string-eq flag "--verification-calls") (set! limits verification-calls n)))))))))))
                    (else (do (print "howl align-check: unknown argument: ") (println flag) (set! failed true))))
                  (set! i (+ i step)))))

            (let ((ls (source-of arena left left-source))
                  (rs (source-of arena right right-source))
                  (ms (source-of arena mapping mapping-source)))
              (do
                (when (not (and (source-iri-valid ls)
                                (and (source-iri-valid rs) (source-iri-valid ms))))
                  (do (println "howl align-check: every document needs an absolute source IRI") (set! failed true)))
                (when (or (string-eq ls rs) (or (string-eq ls ms) (string-eq rs ms)))
                  (do (println "howl align-check: source IRIs must be distinct") (set! failed true)))
                (when (not failed)
                  (do
                    (when (not (parse-into a enc left))
                      (do (print "howl align-check: cannot parse ") (println left) (set! failed true)))
                    (list-push sources (record-new IRI (value ls)))
                    (list-push mapping-docs false)
                    (encoded-next-document a enc)
                    (when (not (parse-into a enc right))
                      (do (print "howl align-check: cannot parse ") (println right) (set! failed true)))
                    (list-push sources (record-new IRI (value rs)))
                    (list-push mapping-docs false)
                    (encoded-next-document a enc)
                    (when (not (parse-into a enc mapping))
                      (do (print "howl align-check: cannot parse ") (println mapping) (set! failed true)))
                    (list-push sources (record-new IRI (value ms)))
                    (list-push mapping-docs true)))
                (while (< k (list-len imports))
                  (do
                  (match (list-get imports k)
                  ((some path) (when (not failed)
                    (let ((source (file-source arena path))
                          (from (cast Int (list-len (. (deref enc) triples)))))
                      (do
                        (when (not (source-iri-valid source))
                          (do (print "howl align-check: cannot resolve import path ") (println path) (set! failed true)))
                        (for-each (other sources)
                          (when (string-eq (. other value) source)
                            (do (println "howl align-check: duplicate import source IRI") (set! failed true))))
                        (when (not failed)
                          (do
                            (encoded-next-document a enc)
                            (if (not (parse-into a enc path))
                              (do (print "howl align-check: cannot parse import ") (println path) (set! failed true))
                              (match (ontology-iri-from (deref enc) from)
                                ((none)
                                  (do (println "howl align-check: import declares no owl:Ontology IRI") (set! failed true)))
                                ((some iri) (list-push resolved iri))))
                            (list-push sources (record-new IRI (value source)))
                            (list-push mapping-docs false)))))))
                  ((none) (do)))
                  (set! k (+ k 1))))
                (if failed 3
                  (let ((parsed (now-ms))
                        (result (align-encoded arena (deref enc) resolved sources mapping-docs cfg repair limits))
                        (done (now-ms)))
                    (do
                      (when timings
                        (let ((peak (peak-mb)))
                          (c-inline "fprintf(stderr, \"howl align-check: parse_ms=%lld align_ms=%lld peak_mb=%lld\\n\", (long long)(parsed-start), (long long)(done-parsed), (long long)peak);")))
                      (match result
                        ((error f) (do (print-fault arena f) (fault-exit f)))
                        ((ok aligned)
                          (let ((out (. aligned outcome)) (code (outcome-exit (. aligned outcome))))
                            (do
                              (if report-mode
                                (for-each (line (report-lines arena out)) (println line))
                                (match (verdict out)
                                  ('verdict-coherent (println "howl align-check: coherent"))
                                  ('verdict-incoherent (println "howl align-check: INCOHERENT"))
                                  ('verdict-inconclusive (println "howl align-check: INCONCLUSIVE"))))
                              (match (. aligned repair)
                                ((some search)
                                  (for-each (line (alignment-lines arena (. aligned mappings) search)) (println line)))
                                ((none) (do)))
                              (release-outcome out)
                              code))))))))))))))
)
